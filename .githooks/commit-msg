#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Conventional Commits gate. Enable in a clone with:
#   git config core.hooksPath .githooks
set -euo pipefail

# The subject is the first line that is neither blank nor a git comment — the
# message file arrives with the commented template still attached.
#
# grep does its own first-match with -m1. Do NOT reintroduce `| head -1`: head
# closes the pipe after one line, grep dies of SIGPIPE, pipefail promotes 141 to
# the pipeline status, and set -e kills a commit-msg hook — which REJECTS a
# perfectly conforming commit with no explanation. It only opens up once grep's
# block buffer is full, so it is invisible on short messages and fires on long
# ones: 0/200 at 60 lines, 61/200 at 37KB.
#
# `|| rc=$?` rather than `|| true`: grep exits 1 for no-match but >1 for a real
# failure, and swallowing both would turn an unreadable message file into an
# empty subject and then into "subject is not a Conventional Commit" — a refusal
# that sounds true and is not. 1 is a message that is nothing but comments, and
# its empty subject falls through to the error below on purpose.
rc=0
subject="$(grep -m1 -vE '^[[:space:]]*(#|$)' -- "$1")" || rc=$?
if [ "$rc" -gt 1 ]; then
  echo "commit-msg: cannot read the message file ($1): grep exited $rc" >&2
  exit 1
fi

# git writes these itself during merge and interactive rebase; rejecting them
# would break those commands rather than improve the history they produce.
# `git revert` is not on this list: revert is a Conventional type, so its
# generated subject gets edited into one like any other commit.
case "$subject" in
  "Merge "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

types='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'
if printf '%s' "$subject" | grep -qE "^(${types})(\([a-z0-9._-]+\))?!?: .+"; then
  # `!` is a promise to callers, and the footer is the only part of it they can
  # act on. Advising the footer and accepting its absence published breaking
  # changes with nothing saying what to update, so the gate reads the body.
  # Both spellings the Conventional Commits specification accepts are taken.
  # A git comment line cannot carry it: the anchor rejects `# BREAKING CHANGE:`.
  printf '%s' "$subject" \
    | grep -qE "^(${types})(\([a-z0-9._-]+\))?!: " || exit 0
  frc=0
  grep -qE '^BREAKING[ -]CHANGE: .+' -- "$1" || frc=$?
  if [ "$frc" -gt 1 ]; then
    echo "commit-msg: cannot read the message file ($1): grep exited $frc" >&2
    exit 1
  fi
  [ "$frc" -eq 0 ] && exit 0
  cat >&2 <<EOF
commit-msg: a breaking subject carries no BREAKING CHANGE: footer

  ${subject}

The \`!\` tells callers this breaks them. Add the footer that tells them what
to do about it, on its own line in the body:

  BREAKING CHANGE: <what breaks and what callers must change>

Drop the \`!\` instead if the change is not breaking.
EOF
  exit 1
fi

cat >&2 <<EOF
commit-msg: subject is not a Conventional Commit

  ${subject}

Expected: <type>[(scope)][!]: <description>
  type   ${types//|/, }
  scope  optional, lowercase — a command or component
         (send, compact, up, down, collars, installer)
  !      breaking change; requires a BREAKING CHANGE: footer in the body

  fix(collars): refuse an occupied composer
  feat(down): tear the whole team down
  refactor!: rename executable and protocol from gl to gang
EOF
exit 1
