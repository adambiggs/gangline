#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#
# The fast push-triggered CI checks. Enable in a clone with:
#   git config core.hooksPath .githooks
set -euo pipefail

# The outer invocation runs repository checks after global delegation returns.
# A global hook calling back here must not start that chain a second time.
if [ "${_GANGLINE_PRE_PUSH_ACTIVE:-0}" = 1 ]; then
  exit 0
fi

root="$(git rev-parse --show-toplevel)"
cd "$root"

fail=0
n_ref=0
tmp="$(mktemp -d "${TMPDIR:-/tmp}/gangline-pre-push.XXXXXX")"
cleanup() {
  ( unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR GIT_PREFIX
    local w
    for w in "$tmp"/tree-*; do
      [ -d "$w" ] && git worktree remove --force "$w" 2>/dev/null
    done ) || true
  rm -rf -- "$tmp"
}
trap cleanup EXIT HUP INT TERM
cat > "$tmp/stdin"

# Repository checks supplement the user's global hook. Both receive the
# original remote arguments and complete ref stream, including deletions.
if global_hooks="$(git config --global --path --get core.hooksPath)"; then
  :
else
  rc=$?
  [ "$rc" -eq 1 ] || exit "$rc"
  global_hooks="${XDG_CONFIG_HOME:-$HOME/.config}/git/hooks"
fi
global_hook="$global_hooks/pre-push"
if [ "$global_hook" -ef "$0" ]; then
  echo "pre-push: global hook resolves to this repository hook; refusing recursive delegation." >&2
  exit 1
fi
if [ -x "$global_hook" ]; then
  _GANGLINE_PRE_PUSH_ACTIVE=1 "$global_hook" "$@" < "$tmp/stdin"
fi

unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR GIT_PREFIX

echo "pre-push: Go checks and private-tmux acceptance scenarios run here; CI repeats them on Linux and macOS." >&2

while read -r local_ref local_sha _remote_ref _remote_sha \
      || [ -n "${local_sha:-}" ]; do
  case "${local_sha:-0}" in *[!0]*) ;; *) continue ;; esac

  # Lint what is being PUSHED, not what is lying in the working tree. Those are
  # different trees whenever anything is uncommitted, and linting the wrong one
  # gives both false answers: a red hook over work-in-progress nobody is
  # sending, or a green one over a commit nobody read.
  n_ref=$((n_ref + 1))
  work="$tmp/tree-$n_ref"
  ( unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR GIT_PREFIX
    git worktree add --detach --quiet "$work" "$local_sha" ) || {
    echo "pre-push: cannot check out $local_sha into a worktree, so nothing was linted" >&2
    fail=1; continue
  }
  if [ -x "$work/test/go.sh" ]; then
    echo "pre-push: running pushed-tree Go checks for $local_ref." >&2
    ( unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR GIT_PREFIX
      cd "$work" && ./test/go.sh ) || fail=1
  else
    echo "pre-push: $local_sha does not carry the executable Go gate" >&2
    fail=1
  fi
  ( unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR GIT_PREFIX
    git worktree remove --force "$work" ) 2>/dev/null || true
done < "$tmp/stdin"

if [ "$fail" -ne 0 ]; then
  echo "pre-push: refusing — Go checks failed." >&2
  echo "          push anyway with: git push --no-verify" >&2
  exit 1
fi
