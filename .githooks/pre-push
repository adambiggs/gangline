#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#
# The fast push-triggered CI checks. Enable in a clone with:
#   git config core.hooksPath .githooks
#
# The repository-local path delegates outward first so it cannot shadow an
# operator's host-global contribution gate.
set -euo pipefail

unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR GIT_PREFIX

root="$(git rev-parse --show-toplevel)"
cd "$root"

fail=0
n_ref=0
tmp="$(mktemp -d "${TMPDIR:-/tmp}/gangline-pre-push.XXXXXX")"
cleanup() {
  ( unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR GIT_PREFIX
    local w
    for w in "$tmp"/tree-*; do
      [ -d "$w" ] && git worktree remove --force "$w" 2>/dev/null
    done ) || true
  rm -rf -- "$tmp"
}
trap cleanup EXIT HUP INT TERM
cat > "$tmp/stdin"

outer="$(git config --global --get core.hooksPath 2>/dev/null || true)"
if [ -n "$outer" ]; then
  case "$outer" in
    /*) outer_dir="$outer" ;;
    *) outer_dir="$root/$outer" ;;
  esac
  own_dir="$(cd .githooks && pwd -P)"
  resolved_outer=""
  if [ -d "$outer_dir" ]; then
    resolved_outer="$(cd "$outer_dir" && pwd -P)"
  fi
  if [ -n "$resolved_outer" ] && [ "$resolved_outer" = "$own_dir" ]; then
    echo "pre-push: global hook path resolves to this repository hook; suppressing outward delegation" >&2
  elif [ -n "$resolved_outer" ] \
       && [ -f "$outer_dir/pre-push" ] && [ -x "$outer_dir/pre-push" ]; then
    # The outer gate runs first so a failure here cannot skip it, and it writes
    # straight to the terminal: a host-global gate that spends minutes in
    # inference reports its progress while it runs, and holding that back until
    # the local gate finishes makes a live push look hung.
    outer_rc=0
    "$outer_dir/pre-push" "$@" < "$tmp/stdin" || outer_rc=$?
    if [ "$outer_rc" -ne 0 ]; then
      echo "pre-push: outer gate refused with status $outer_rc" >&2
      exit "$outer_rc"
    fi
  fi
fi

echo "pre-push: running lint and the fast smoke." >&2
echo "pre-push: skipping the full integration suite; CI runs it on pushes to main." >&2

is_zero_oid() {
  case "$1" in ''|*[!0]*) return 1 ;; *) return 0 ;; esac
}

dest="${2:-}"
excl=()
need_lsremote=0
oid_width=0
range_error=""
while read -r _local_ref local_sha _remote_ref remote_sha \
      || [ -n "${local_sha:-}${remote_sha:-}" ]; do
  [ -n "${local_sha:-}" ] || continue
  is_zero_oid "$local_sha" && continue
  oid_width=${#local_sha}
  if is_zero_oid "$remote_sha"; then
    need_lsremote=1
  elif git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    excl+=("$remote_sha")
  elif [ -z "$range_error" ]; then
    range_error="pre-push: remote base $remote_sha for $_local_ref is unavailable locally."
  fi
done < "$tmp/stdin"

if [ "$need_lsremote" -eq 1 ]; then
  lrc=0
  git ls-remote "$dest" > "$tmp/adv" 2>/dev/null || lrc=$?
  if [ "$lrc" -ne 0 ]; then
    range_error="pre-push: could not read the destination's refs (git ls-remote exited $lrc)."
  elif [ -s "$tmp/adv" ]; then
    adv_usable=1
    while read -r oid ref extra \
          || [ -n "${oid:-}${ref:-}${extra:-}" ]; do
      case "$oid" in
        ''|*[!0-9a-fA-F]*) adv_usable=0 ;;
        *) [ "${#oid}" -eq "$oid_width" ] || adv_usable=0 ;;
      esac
      case "$ref" in HEAD|refs/*) ;; *) adv_usable=0 ;; esac
      [ -z "${extra:-}" ] || adv_usable=0
    done < "$tmp/adv"
    if [ "$adv_usable" -eq 0 ]; then
      range_error="pre-push: could not read the destination's refs (git ls-remote returned unusable output)."
    else
      while read -r oid _ref || [ -n "${oid:-}" ]; do
        git cat-file -e "${oid}^{commit}" 2>/dev/null && excl+=("$oid")
      done < "$tmp/adv"
      if [ "${#excl[@]}" -eq 0 ]; then
        range_error="pre-push: none of the destination's advertised commits is available locally."
      fi
    fi
  fi
fi

if [ -n "$range_error" ]; then
  printf '%s\n' "$range_error" \
    "pre-push: refusing — the pushed commit range is indeterminate." >&2
  exit 1
fi

while read -r local_ref local_sha _remote_ref remote_sha \
      || [ -n "${local_sha:-}${remote_sha:-}" ]; do
  [ -n "${local_sha:-}" ] || continue
  is_zero_oid "$local_sha" && continue

  git rev-parse --verify --quiet "${local_sha}^{commit}" >/dev/null || {
    type="$(git cat-file -t "$local_sha" 2>/dev/null || echo 'unknown type')"
    echo "pre-push: refusing $local_ref: its object is a $type, not a commit." >&2
    echo "          A commit-range check would examine nothing and report clean." >&2
    fail=1
    continue
  }

  if ! is_zero_oid "$remote_sha" \
     && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    revs=("${remote_sha}..${local_sha}")
  elif [ "${#excl[@]}" -gt 0 ]; then
    revs=("$local_sha" --not "${excl[@]}")
  else
    revs=("$local_sha")
  fi

  # Lint what is being PUSHED, not what is lying in the working tree. Those are
  # different trees whenever anything is uncommitted, and linting the wrong one
  # gives both false answers: a red hook over work-in-progress nobody is
  # sending, or a green one over a commit nobody read.
  n_ref=$((n_ref + 1))
  work="$tmp/tree-$n_ref"
  ( unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR GIT_PREFIX
    git worktree add --detach --quiet "$work" "$local_sha" ) || {
    echo "pre-push: cannot check out $local_sha into a worktree, so nothing was linted" >&2
    fail=1; continue
  }
  if [ -x "$work/test/lint.sh" ] && [ -x "$work/test/smoke.sh" ]; then
    ( unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR GIT_PREFIX
      cd "$work" && ./test/lint.sh && ./test/smoke.sh ) || fail=1
  else
    echo "pre-push: $local_sha does not carry executable test/lint.sh and test/smoke.sh gates" >&2
    fail=1
  fi
  # The same conventional-commits gate CI runs over the same destination-bound
  # range, judged by the PUSHED hook rather than the one lying in the working
  # tree. Those are different gates whenever anything is uncommitted, exactly
  # as the lint tree is: a push that tightens the gate must be judged by the
  # gate it is sending, and an uncommitted edit must not decide the verdict.
  # A remote name is not destination identity when pushurl or a retarget is
  # involved, so no remote-tracking ref participates in this exclusion set.
  if [ -x "$work/.githooks/commit-msg" ]; then
    # `for sha in $(git rev-list ...)` reads a FAILED traversal as an empty
    # range: set -e does not apply to a failed command substitution in a for
    # word, so the loop simply runs zero times and the push passes clean. Take
    # the traversal's status at statement level and keep unknown out of pass.
    rl_rc=0
    git rev-list "${revs[@]}" > "$tmp/revs" 2> "$tmp/revs.err" || rl_rc=$?
    if [ "$rl_rc" -ne 0 ]; then
      echo "pre-push: refusing $local_ref: git rev-list exited $rl_rc, so the" >&2
      echo "          pushed commit range is unknown and nothing was checked." >&2
      sed 's/^/          /' < "$tmp/revs.err" >&2
      fail=1
    else
      n=0
      bad=0
      while read -r sha || [ -n "${sha:-}" ]; do
        [ -n "$sha" ] || continue
        n=$((n + 1))
        git log -1 --format=%B "$sha" > "$tmp/msg"
        "$work/.githooks/commit-msg" "$tmp/msg" || {
          echo "  ^ $(git log -1 --format='%h by %an' "$sha")" >&2
          bad=$((bad + 1))
        }
      done < "$tmp/revs"
      if [ "$bad" -ne 0 ]; then
        echo "pre-push: $bad of $n commit(s) do not conform" >&2
        fail=1
      fi
    fi
  else
    echo "pre-push: refusing $local_ref: $local_sha carries no executable" >&2
    echo "          .githooks/commit-msg, so no commit message was checked." >&2
    fail=1
  fi

  ( unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR GIT_PREFIX
    git worktree remove --force "$work" ) 2>/dev/null || true
done < "$tmp/stdin"

if [ "$fail" -ne 0 ]; then
  echo "pre-push: refusing — lint, smoke, or commit-message checks failed." >&2
  echo "          The full integration suite was skipped; CI runs it on pushes to main." >&2
  echo "          push anyway with: git push --no-verify" >&2
  exit 1
fi
