#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Read the exact Codex session id from one harness process's open files."""

from __future__ import annotations

import json
import os
import re
import sys


ID = r"[A-Za-z0-9._:-]+"
LOCK = re.compile(rf"/thread-writer-locks/({ID})\.lock$")
META_LIMIT = 1 << 20


def session_meta(path: str) -> dict | None:
    """The payload of a rollout's first record, or None when it is unreadable."""
    try:
        with open(path, "rb") as rollout:
            head = rollout.readline(META_LIMIT)
    except OSError:
        return None
    if not head.endswith(b"\n"):
        return None
    try:
        record = json.loads(head)
    except ValueError:
        return None
    if not isinstance(record, dict) or record.get("type") != "session_meta":
        return None
    payload = record.get("payload")
    return payload if isinstance(payload, dict) else None


def session_root(witnessed: dict[str, str]) -> str | None:
    """The one thread that every other witnessed thread descends from."""
    parents: dict[str, str | None] = {}
    sessions: dict[str, object] = {}
    for thread, path in witnessed.items():
        meta = session_meta(path)
        if meta is None or meta.get("id") != thread:
            return None
        parent = meta.get("parent_thread_id")
        if parent is not None and not isinstance(parent, str):
            return None
        parents[thread] = parent
        sessions[thread] = meta.get("session_id")
    roots = [thread for thread, parent in parents.items() if parent is None]
    if len(roots) != 1:
        return None
    root = roots[0]
    for thread in parents:
        # The root's session id is its own; a missing one matches nothing.
        if sessions[thread] != root:
            return None
        seen = {thread}
        cursor: str | None = thread
        while cursor != root:
            cursor = parents.get(cursor)
            if cursor is None or cursor in seen:
                return None
            seen.add(cursor)
    return root


def main() -> int:
    if len(sys.argv) != 2 or not sys.argv[1].isdigit():
        return 2

    fd_root = f"/proc/{sys.argv[1]}/fd"
    locks: set[str] = set()
    rollouts: dict[str, str] = {}
    try:
        entries = list(os.scandir(fd_root))
    except OSError:
        return 1

    for entry in entries:
        try:
            target = os.readlink(entry.path)
        except OSError:
            continue
        match = LOCK.search(target)
        if match:
            locks.add(match.group(1))
        if "/sessions/" in target and target.endswith(".jsonl"):
            rollouts.setdefault(os.path.basename(target), entry.path)

    witnessed = {
        session_id: path
        for session_id in locks
        for name, path in rollouts.items()
        if name.endswith(f"-{session_id}.jsonl")
    }
    # A SESSION BEFORE ITS FIRST TURN HAS ONLY ITS LOCK TO OFFER. Codex takes
    # the thread-writer lock as the session opens, but it creates the rollout
    # lazily on the first turn: an agent sitting at a composer nobody has
    # prompted yet holds the lock and no rollout at all -- not as an open fd,
    # not on disk. Observed on codex-cli 0.149.1. Demanding both witnesses
    # there is not strictness, it is a state no freshly hitched agent can leave
    # until someone talks to it, and hitch is when this is read most.
    #
    # Corroboration is still required wherever it can exist. A rollout naming
    # some other thread contradicts the lock rather than being merely absent,
    # and keeps refusing; several locks are settled only by the thread
    # metadata below. Only the case with no rollout evidence at all falls
    # back, and only when a single lock makes the answer unambiguous.
    if not witnessed and not rollouts and len(locks) == 1:
        print(next(iter(locks)))
        return 0
    if len(locks) == 1 and len(witnessed) == 1:
        print(next(iter(witnessed)))
        return 0
    # A SESSION'S OWN SUB-AGENTS ARE WITNESSES OF THE SAME SESSION. Codex
    # 0.151.0 runs each sub-agent as a thread of the same process, which holds
    # that thread's lock and rollout while the thread is live, and records the
    # spawning thread in the child's session_meta as parent_thread_id; the root
    # thread's session_id is its own id and every descendant carries it.
    # Counting pairs left a session that had sub-agents open unreadable. With
    # several locks held, the answer is the one parentless thread, and only
    # when every held lock has its rollout, every rollout's metadata names its
    # own thread and that root's session, and every thread reaches the root
    # through parents this process also holds. The held set changes as threads
    # open and close, so a lock whose rollout is not open -- a thread not yet
    # written, or a rollout being reopened -- leaves the reading unavailable
    # rather than promoting whichever pair remains. A second root, an unheld
    # parent, a cycle, or missing, empty, renamed or unreadable metadata refuse
    # the same way.
    if len(locks) < 2 or set(witnessed) != locks:
        return 1
    root = session_root(witnessed)
    if root is None:
        return 1
    print(root)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
