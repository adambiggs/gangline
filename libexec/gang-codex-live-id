#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Read the exact Codex session id from one harness process's open files."""

import os
import re
import sys


ID = r"[A-Za-z0-9._:-]+"
LOCK = re.compile(rf"/thread-writer-locks/({ID})\.lock$")


def main() -> int:
    if len(sys.argv) != 2 or not sys.argv[1].isdigit():
        return 2

    fd_root = f"/proc/{sys.argv[1]}/fd"
    locks: set[str] = set()
    rollouts: list[str] = []
    try:
        entries = list(os.scandir(fd_root))
    except OSError:
        return 1

    for entry in entries:
        try:
            target = os.readlink(entry.path)
        except OSError:
            continue
        match = LOCK.search(target)
        if match:
            locks.add(match.group(1))
        if "/sessions/" in target and target.endswith(".jsonl"):
            rollouts.append(os.path.basename(target))

    witnessed = {
        session_id
        for session_id in locks
        if any(name.endswith(f"-{session_id}.jsonl") for name in rollouts)
    }
    # A SESSION BEFORE ITS FIRST TURN HAS ONLY ITS LOCK TO OFFER. Codex takes
    # the thread-writer lock as the session opens, but it creates the rollout
    # lazily on the first turn: an agent sitting at a composer nobody has
    # prompted yet holds the lock and no rollout at all -- not as an open fd,
    # not on disk. Observed on codex-cli 0.149.1. Demanding both witnesses
    # there is not strictness, it is a state no freshly hitched agent can leave
    # until someone talks to it, and hitch is when this is read most.
    #
    # Corroboration is still required wherever it can exist. A rollout naming
    # some other thread contradicts the lock rather than being merely absent,
    # and one process holding two locks is ambiguous with nothing to break the
    # tie; both keep refusing. Only the case with no rollout evidence at all
    # falls back, and only when a single lock makes the answer unambiguous.
    if not witnessed and not rollouts and len(locks) == 1:
        witnessed = set(locks)
    if len(witnessed) != 1:
        return 1
    print(next(iter(witnessed)))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
