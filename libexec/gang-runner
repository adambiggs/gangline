#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Execute one durable Gangline run record; its service finalizer reports its result.
set -u
umask 077

mode=command
case "${1:-}" in
  --finalize) mode=finalize; shift ;;
esac
run_dir="${1:-}"
case "$run_dir" in
  /*) ;;
  *) printf 'gang-runner: expected one absolute run directory\n' >&2; exit 2 ;;
esac
[ "$#" -eq 1 ] || { printf 'gang-runner: expected exactly one run directory\n' >&2; exit 2; }
[ -d "$run_dir" ] && [ ! -L "$run_dir" ] || {
  printf 'gang-runner: no safe result directory at %s\n' "$run_dir" >&2
  exit 2
}

read_field() { # $1 fixed one-line record field
  local file="$run_dir/$1" value
  [ -f "$file" ] && [ ! -L "$file" ] || return 1
  IFS= read -r value < "$file" || return 1
  case "$value" in *$'\n'*) return 1 ;; esac
  printf '%s' "$value"
}

unit="$(read_field unit)" || { printf 'gang-runner: result record has no unit\n' >&2; exit 2; }
id="${run_dir##*/}"
output="$run_dir/output"
argv_file="$run_dir/argv"
gang="$(cd -P "$(dirname "$0")/.." && pwd)/bin/gang"

write_result_if_absent() { # $1 exit status, $2 start epoch; never alters an existing result
  local code="$1" started="$2" ended duration tmp
  ended="$(date +%s)" || ended="$started"
  duration=$((ended - started))
  [ "$duration" -ge 0 ] || duration=0
  tmp="$run_dir/.result-$$"
  printf '%s\t%s\t%s\n' "$code" "$duration" "$ended" > "$tmp" || {
    rm -f -- "$tmp"
    return 1
  }
  if ! ln -- "$tmp" "$run_dir/result"; then
    rm -f -- "$tmp"
    [ -f "$run_dir/result" ] && return 0 # another finalization made the immutable result
    return 1
  fi
  rm -f -- "$tmp"
}

exit_status_from_manager() { # systemd's ExecStopPost result -> a shell-like numeric exit
  local kind="${EXIT_CODE:-}" status="${EXIT_STATUS:-}" signal=""
  case "$status" in
    HUP) signal=1 ;; INT) signal=2 ;; QUIT) signal=3 ;; ILL) signal=4 ;;
    TRAP) signal=5 ;; ABRT) signal=6 ;; BUS) signal=7 ;; FPE) signal=8 ;;
    KILL) signal=9 ;; USR1) signal=10 ;; SEGV) signal=11 ;; USR2) signal=12 ;;
    PIPE) signal=13 ;; ALRM) signal=14 ;; TERM) signal=15 ;; STKFLT) signal=16 ;;
    CHLD) signal=17 ;; CONT) signal=18 ;; STOP) signal=19 ;; TSTP) signal=20 ;;
    TTIN) signal=21 ;; TTOU) signal=22 ;; URG) signal=23 ;; XCPU) signal=24 ;;
    XFSZ) signal=25 ;; VTALRM) signal=26 ;; PROF) signal=27 ;; WINCH) signal=28 ;;
    IO) signal=29 ;; PWR) signal=30 ;; SYS) signal=31 ;;
  esac
  case "$kind:$status" in
    exited:[0-9]|exited:[0-9][0-9]|exited:[0-9][0-9][0-9])
      [ "$status" -le 255 ] && { printf '%s' "$status"; return 0; }
      ;;
    killed:[0-9]|killed:[0-9][0-9]|killed:[0-9][0-9][0-9]|dumped:[0-9]|dumped:[0-9][0-9]|dumped:[0-9][0-9][0-9])
      [ "$status" -le 127 ] && { printf '%s' "$((128 + status))"; return 0; }
      ;;
  esac
  case "$kind:$signal" in
    killed:[0-9]|killed:[0-9][0-9]|dumped:[0-9]|dumped:[0-9][0-9])
      printf '%s' "$((128 + signal))"
      return 0
      ;;
  esac
  printf '1'
}

finalize() { # ExecStopPost runs after normal exit, cancellation, SIGKILL, or timeout
  local created status dispatch_rc=0
  if [ ! -f "$run_dir/result" ]; then
    created="$(read_field created)" || {
      rm -f -- "$run_dir/active"
      printf 'unconfirmed: completion finalizer could not read creation time; output retained\n' > "$run_dir/delivery"
      printf 'gang-runner: result record has no creation time\n' >&2
      return 1
    }
    case "$created" in
      *[!0-9]*|'')
        rm -f -- "$run_dir/active"
        printf 'unconfirmed: completion finalizer found invalid creation time; output retained\n' > "$run_dir/delivery"
        printf 'gang-runner: result record has an invalid creation time\n' >&2
        return 1
        ;;
    esac
    status="$(exit_status_from_manager)"
    write_result_if_absent "$status" "$created" || {
      rm -f -- "$run_dir/active"
      printf 'unconfirmed: completion finalizer could not write result; output retained\n' > "$run_dir/delivery"
      printf 'gang-runner: cannot write fallback completion record under %s\n' "$run_dir" >&2
      return 1
    }
  fi
  [ -x "$gang" ] || {
    rm -f -- "$run_dir/active"
    printf 'unconfirmed: Gangline completion command is unavailable; output retained\n' > "$run_dir/delivery"
    printf 'gang-runner: cannot execute gang at %s\n' "$gang" >&2
    return 1
  }
  GANG_RUN_TEAM_ROOT="${GANG_RUN_TEAM_ROOT:-}" \
    "$gang" run --finish "$id" --unit "$unit" > "$run_dir/dispatch" 2>&1 || dispatch_rc=$?
  if [ "$dispatch_rc" -ne 0 ]; then
    # A post-start failure must never spend a team concurrency slot forever.
    rm -f -- "$run_dir/active"
    [ -f "$run_dir/delivery" ] || \
      printf 'unconfirmed: completion transport failed; output retained\n' > "$run_dir/delivery"
    printf 'gang-runner: Gangline could not accept completion transport; see %s/dispatch\n' "$run_dir" >&2
    return "$dispatch_rc"
  fi
}

if [ "$mode" = finalize ]; then
  finalize
  exit $?
fi

[ -f "$argv_file" ] && [ ! -L "$argv_file" ] || {
  printf 'gang-runner: result record has no argv\n' >&2
  exit 2
}
mapfile -d '' -t argv < "$argv_file"
[ "${#argv[@]}" -gt 0 ] || { printf 'gang-runner: result record has an empty argv\n' >&2; exit 2; }

started="$(date +%s)" || { printf 'gang-runner: cannot read start time\n' >&2; exit 2; }
child=""
on_signal() { # KillMode=mixed stops the runner first; give its command TERM and wait for it
  local status=0
  trap - HUP INT TERM
  if [ -n "$child" ]; then
    kill -TERM "$child" 2>/dev/null || :
    wait "$child" || status=$?
  else
    status=143
  fi
  write_result_if_absent "$status" "$started" || {
    printf 'gang-runner: cannot write signal completion record under %s\n' "$run_dir" >&2
    exit 1
  }
  exit "$status"
}
trap on_signal HUP INT TERM
"${argv[@]}" > "$output" 2>&1 &
child=$!
status=0
wait "$child" || status=$?
write_result_if_absent "$status" "$started" || {
  printf 'gang-runner: cannot write completion record under %s\n' "$run_dir" >&2
  exit 1
}
exit "$status"
