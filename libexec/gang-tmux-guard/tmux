#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# THE GUARD ON THE ONE PROCESS WHOSE DEATH ENDS THE WHOLE TEAM. Inside a tmux
# pane $TMUX names the current server and silently outranks TMUX_TMPDIR, so
# `env TMUX_TMPDIR=<sandbox> tmux kill-server` — a command that reads as aimed
# at a sandbox — addresses the live server instead. On 2026-08-17 that took a
# whole team while the disposable server it meant to end survived.
#
# Gang cannot intercept every tmux invocation an agent might make, and this does
# not pretend to: it is a shim gang puts at the front of an agent's PATH, so it
# sees what that agent's shells run and nothing else. What it decides is one
# question — does the socket this teardown would reach carry a Gangline agent
# window? That fact lives on the tmux server itself. The team record remains a
# useful corroborating hint, but an agent testing Gangline has to override its
# GANG_SESSION and GANG_LOCK_DIR, so it must never be the only evidence that
# the guard uses to protect a server.
#
# A SERVER THAT ANSWERS BUT CANNOT BE CLASSIFIED FAILS CLOSED. An unreachable
# explicit private socket still reaches real tmux for its ordinary error. Every
# teardown verdict is written under the configured, launch-time team, and
# default roots when distinct, because a caller can redirect the configured
# root while testing and a verdict only there leaves no forensics behind.
set -u

guard_dir=$(CDPATH= cd -P "$(dirname "$0")" && pwd) || guard_dir=""

# EVERY GUARD ON PATH IS SKIPPED, NOT JUST THIS ONE. Excluding only its own
# directory made two shims select each other: an installed guard and a checkout
# guard both ahead of tmux left each one re-execing the other forever, and
# because the real tmux is resolved before the command is dispatched, an
# ordinary `tmux list-sessions` hung the same way a teardown did. A guard is
# recognised the way the integration suite already recognises one — a `#!`
# script rather than the tmux binary — narrowed to the directory name gang
# installs it under, so a fixture that legitimately puts a shell script called
# tmux on PATH is still the tmux this shim runs.
guard_is_guard() { # $1 candidate directory
  case "$1" in
    gang-tmux-guard|*/gang-tmux-guard) ;;
    *) return 1 ;;
  esac
  [ "$(head -c 2 "$1/tmux" 2>/dev/null)" = '#!' ]
}

real_tmux=""
saved_ifs=$IFS
IFS=:
for entry in $PATH; do
  [ -n "$entry" ] || entry=.
  case "$entry" in
    "$guard_dir") continue ;;
  esac
  if [ -x "$entry/tmux" ] && [ ! -d "$entry/tmux" ]; then
    guard_is_guard "$entry" && continue
    real_tmux="$entry/tmux"
    break
  fi
done
IFS=$saved_ifs

[ -n "$real_tmux" ] || {
  printf 'gang tmux guard: no tmux on PATH beyond this shim (%s)\n' "$guard_dir" >&2
  exit 127
}

run_real() { exec "$real_tmux" "$@"; }

# AN EXPLICIT OVERRIDE, NOT A SILENT ONE. Nothing here is a security boundary —
# an agent that means to end its own server can say so — but it has to say so,
# and saying so is recorded like a refusal.
default_guard_state="/tmp/gangline-$(id -u 2>/dev/null || echo 0)"
guard_state="${GANG_LOCK_DIR:-$default_guard_state}"
team_guard_state="${GANG_TMUX_GUARD_LOG_DIR:-$default_guard_state}"

note_append() { # $1 state, $2 verdict, rest = argv
  note_state=$1
  note_verdict=$2
  shift 2
  [ -d "$note_state" ] || return 0
  printf '%s\t%s\t%s\t%s\t%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown-time)" \
    "$note_verdict" "${GANG_SESSION:-unknown-session}" "${TMUX_PANE:-no-pane}" "tmux $*" \
    >> "$note_state/tmux-guard.log" 2>/dev/null || true
}

note() { # $1 verdict, rest = argv, appended where it outlives the pane
  verdict=$1
  shift
  note_append "$guard_state" "$verdict" "$@"
  [ "$team_guard_state" = "$guard_state" ] \
    || note_append "$team_guard_state" "$verdict" "$@"
  [ "$guard_state" = "$default_guard_state" ] \
    || [ "$team_guard_state" = "$default_guard_state" ] \
    || note_append "$default_guard_state" "$verdict" "$@"
}

[ "${GANG_TMUX_GUARD:-on}" = off ] && { note override "$@"; run_real "$@"; }

# RETAIN ONLY TMUX'S SOCKET SELECTORS. The actual target is asked of tmux below;
# duplicating tmux's path rules here is the defect this guard exists to avoid.
socket=""
label=""
seen_command=""
prev=""
for word in "$@"; do
  if [ -n "$prev" ]; then
    case "$prev" in
      -S) socket=$word ;;
      -L) label=$word ;;
      -f|-c) : ;;
    esac
    prev=""
    continue
  fi
  case "$word" in
    -S) prev=-S ;;
    -L) prev=-L ;;
    -f|-c) prev=$word ;;
    -S*) socket=${word#-S} ;;
    -L*) label=${word#-L} ;;
    -*) : ;;
    *) [ -n "$seen_command" ] || seen_command=$word ;;
  esac
done

missing_tmpdir=""
if [ -z "$socket" ] && [ -n "${TMUX_TMPDIR:-}" ] \
   && [ ! -d "$TMUX_TMPDIR" ]; then
  # $TMUX still wins when no command-line selector was supplied, so a missing
  # TMUX_TMPDIR is irrelevant in that case. -L selects through TMUX_TMPDIR and
  # therefore remains dangerous even inside a pane; -S was excluded above.
  if [ -n "$label" ] || [ -z "${TMUX:-}" ]; then
    missing_tmpdir=$TMUX_TMPDIR
  fi
fi

guard_refuse_missing_tmpdir() {
  note refused-missing-tmux-tmpdir "$@"
  if [ -n "$socket" ]; then
    printf 'gang tmux guard: REFUSED — TMUX_TMPDIR names a directory that does not exist: %s. tmux resolved this invocation to %s instead. Create the directory before using it, aim the command with -S, or set GANG_TMUX_GUARD=off for a deliberate override.\n' \
      "$missing_tmpdir" "$socket" >&2
  else
    printf 'gang tmux guard: REFUSED — TMUX_TMPDIR names a directory that does not exist: %s. tmux may silently use its default socket instead. Create the directory before using it, aim the command with -S, or set GANG_TMUX_GUARD=off for a deliberate override.\n' \
      "$missing_tmpdir" >&2
  fi
  exit 3
}

guard_refuse_unreadable_server() {
  note refused-unreadable-server "$@"
  printf 'gang tmux guard: REFUSED — Gangline could not read the window registrations on %s, so it will not tear down a server whose team state it cannot determine. Inspect the socket, or set GANG_TMUX_GUARD=off for a deliberate teardown.\n' \
    "$socket" >&2
  exit 3
}

# TMUX 3.2A'S QUIET WINDOW-OPTION READ DOES NOT EXPOSE ITS TARGET. Both an
# unset option on a readable window and the same read against a missing window
# exit zero with no output. `list-windows -t` does retain that observation, so
# take it immediately before an explicitly targeted quiet read and carry its
# nonzero status to the caller instead of spending absence as an unset option.
option_read_window=""
option_read_quiet=""
option_read_target=""
case "$seen_command" in
  show-options)
    option_read_command=""
    option_read_prev=""
    for word in "$@"; do
      if [ -z "$option_read_command" ]; then
        [ "$word" != "$seen_command" ] || option_read_command=1
        continue
      fi
      if [ -n "$option_read_prev" ]; then
        option_read_target=$word
        option_read_prev=""
        continue
      fi
      case "$word" in
        -t) option_read_prev=-t ;;
        -t*) option_read_target=${word#-t} ;;
        -*) option_read_flags=${word#-}
            case "$option_read_flags" in *w*) option_read_window=1 ;; esac
            case "$option_read_flags" in *q*) option_read_quiet=1 ;; esac ;;
      esac
    done ;;
esac

observe_option_window() { # $1 explicit target; return tmux's availability status
  if [ -n "$socket" ]; then
    "$real_tmux" -S "$socket" list-windows -t "$1" \
      -f 0 -F '#{window_id}' >/dev/null 2>&1
  elif [ -n "$label" ]; then
    "$real_tmux" -L "$label" list-windows -t "$1" \
      -f 0 -F '#{window_id}' >/dev/null 2>&1
  else
    "$real_tmux" list-windows -t "$1" \
      -f 0 -F '#{window_id}' >/dev/null 2>&1
  fi
}

observe_option_server() { # return whether the selected tmux server answers
  if [ -n "$socket" ]; then
    "$real_tmux" -S "$socket" display-message \
      -p '#{socket_path}' >/dev/null 2>&1
  elif [ -n "$label" ]; then
    "$real_tmux" -L "$label" display-message \
      -p '#{socket_path}' >/dev/null 2>&1
  else
    "$real_tmux" display-message -p '#{socket_path}' >/dev/null 2>&1
  fi
}

case "$seen_command" in
  kill-server|kill-session) ;;
  *) [ -z "$missing_tmpdir" ] || guard_refuse_missing_tmpdir "$@"
     if [ -n "$option_read_window" ] && [ -n "$option_read_quiet" ] \
        && [ -n "$option_read_target" ]; then
       option_read_rc=0
       observe_option_window "$option_read_target" || option_read_rc=$?
       if [ "$option_read_rc" -ne 0 ]; then
         if observe_option_server; then
           note unavailable-window-option "$@"
           printf 'gang tmux guard: window option target %s is unavailable; refusing to report an empty value because tmux cannot distinguish it from an unset option.\n' \
             "$option_read_target" >&2
           exit 1
         fi
         note unavailable-window-option-server "$@"
         printf 'gang tmux guard: the tmux server for window option target %s is unavailable, so its option record could not be read.\n' \
           "$option_read_target" >&2
         exit 2
       fi
     fi
     run_real "$@" ;;
esac

# ASK THE CLIENT THAT WILL RUN THE COMMAND. A successful display-message is
# tmux's own answer under -S, -L, $TMUX, TMUX_TMPDIR, and its fallback rules.
# An explicit socket remains in `socket` if nothing answers there, so the
# longstanding aimed-and-gone path can still reach tmux for its ordinary error.
resolved_socket=""
if [ -n "$socket" ]; then
  resolved_socket="$("$real_tmux" -S "$socket" display-message \
    -p '#{socket_path}' 2>/dev/null)" || resolved_socket=""
elif [ -n "$label" ]; then
  resolved_socket="$("$real_tmux" -L "$label" display-message \
    -p '#{socket_path}' 2>/dev/null)" || resolved_socket=""
else
  resolved_socket="$("$real_tmux" display-message \
    -p '#{socket_path}' 2>/dev/null)" || resolved_socket=""
fi
if [ -n "$resolved_socket" ]; then
  socket=$resolved_socket
elif [ -z "$socket" ] && [ -z "$label" ] && [ -n "${TMUX:-}" ]; then
  # With neither command-line selector, tmux could not answer about this pane's
  # own server. Preserve the only path known to be in play so the unreadable-
  # server branch fails closed. A failed -L probe still names its label, not
  # this pane's server, and takes the ordinary unreachable-target path below.
  socket=${TMUX%%,*}
fi
[ -z "$missing_tmpdir" ] || guard_refuse_missing_tmpdir "$@"

if [ -z "$resolved_socket" ]; then
  if [ -n "${TMUX:-}" ] && [ "$socket" = "${TMUX%%,*}" ]; then
    guard_refuse_unreadable_server "$@"
  fi
  note fall-open-unreachable-socket "$@"
  run_real "$@"
fi

# THE RECORD IS A HINT, NEVER AUTHORITY. A live server's window registrations
# below decide the guard. Keeping the record lets its usual team name enrich a
# verdict, but a sandbox override that makes it vanish cannot make a teardown
# safe.
recorded_team=""
session="${GANG_SESSION:-}"
case "$session" in
  ''|*/*|.|..) ;;
  *) team_record="$guard_state/teams/$session"
     if [ -f "$team_record" ]; then
       IFS= read -r team_socket < "$team_record" || team_socket=""
       [ "$team_socket" != "$socket" ] || recorded_team="$session"
     fi ;;
esac

# This is read through the real tmux, never the shim: an invocation only gains
# protection from a registration the server itself still has. Return 0 with
# protected_session set, 1 if no Gangline window is there, or 2 if the reading
# itself failed. The latter is not permission to tear down an unknown server.
protected_session=""
guard_tab="$(printf '\t')"
guard_format="#{session_name}${guard_tab}#{@gl_agent}"
guard_agent_on_socket() { # $1 socket, optional $2 session target
  guard_socket=$1
  guard_target=${2:-}
  if [ -n "$guard_target" ]; then
    guard_rows="$("$real_tmux" -S "$guard_socket" list-windows -t "$guard_target" \
      -F "$guard_format" 2>/dev/null)" || return 2
  else
    guard_rows="$("$real_tmux" -S "$guard_socket" list-windows -a \
      -F "$guard_format" 2>/dev/null)" || return 2
  fi
  protected_session=""
  while IFS="$guard_tab" read -r guard_session guard_agent; do
    [ -n "$guard_agent" ] || continue
    protected_session="$guard_session"
    return 0
  done <<EOF
$guard_rows
EOF
  return 1
}

guard_unreadable_server() {
  # Reaching this branch means display-message already proved a live server at
  # `socket`, but its registrations could not be read. That is unknown, not
  # evidence that teardown is safe. A socket with no answering server takes the
  # earlier fall-open path and lets tmux report its ordinary connection error.
  guard_refuse_unreadable_server "$@"
}

guard_team_name() {
  [ -n "$recorded_team" ] && [ "$recorded_team" = "$protected_session" ] \
    && { printf '%s' "$recorded_team"; return; }
  printf '%s' "$protected_session"
}

if [ "$seen_command" = kill-server ]; then
  guard_rc=0
  guard_agent_on_socket "$socket" || guard_rc=$?
  case "${guard_rc:-0}" in
    1) note fall-open-no-gangline-agent "$@"; run_real "$@" ;;
    2) guard_unreadable_server "$@" ;;
  esac
  team="$(guard_team_name)"
  note refused "$@"
  printf 'gang tmux guard: REFUSED — this kill-server would end %s, the tmux server holding team '\''%s'\'' and every agent in it.\n' \
    "$socket" "$team" >&2
  printf 'Inside a pane $TMUX names this server and outranks TMUX_TMPDIR, so a sandbox-looking command still lands here.\n' >&2
  printf 'Aim it: naming this socket changes nothing — kill-server is refused for any socket carrying an agent window. It opens once none does, so end them first (gang drop <name> per agent window) and the same command passes. To end the whole team on purpose, run gang down %s from a shell without this guard on its PATH.\n' \
    "$team" >&2
  printf 'GANG_TMUX_GUARD=off runs it anyway, and that use is recorded too.\n' >&2
  exit 3
fi

# KILL-SESSION IS DECIDED BY THE TARGET'S OWN WINDOWS. No -t is this pane's
# session, so any Gangline registration on the reached server is enough to
# refuse it. An explicit -t is allowed only when that target session itself has
# none; another disposable session sharing a server remains a valid teardown.
target=""
prev=""
for word in "$@"; do
  if [ -n "$prev" ]; then
    [ "$prev" != -t ] || target=$word
    prev=""
    continue
  fi
  case "$word" in
    -t) prev=-t ;;
    -t*) target=${word#-t} ;;
  esac
done

if [ -z "$target" ]; then
  guard_rc=0
  guard_agent_on_socket "$socket" || guard_rc=$?
  case "$guard_rc" in
    1) note fall-open-no-gangline-agent "$@"; run_real "$@" ;;
    2) guard_unreadable_server "$@" ;;
  esac
  team="$(guard_team_name)"
  note refused "$@"
  printf 'gang tmux guard: REFUSED — this kill-session names no target, so it ends the session this pane is in: team '\''%s'\'' on %s.\n' \
    "$team" "$socket" >&2
  printf 'Aim it: kill-session opens on a target session that carries no agent window; naming this one changes nothing while it does. End its agents first (gang drop <name> per agent window), or run gang down %s from a shell without this guard on its PATH to end the whole team on purpose.\n' \
    "$team" >&2
  printf 'GANG_TMUX_GUARD=off runs it anyway, and that use is recorded too.\n' >&2
  exit 3
fi

guard_rc=0
guard_agent_on_socket "$socket" "$target" || guard_rc=$?
case "$guard_rc" in
  0) team="$(guard_team_name)"
     note refused "$@"
     printf 'gang tmux guard: REFUSED — this kill-session targets team '\''%s'\'' itself, on %s.\n' \
       "$team" "$socket" >&2
     printf 'Aim it: kill-session opens on a target session that carries no agent window; naming this one changes nothing while it does. End its agents first (gang drop <name> per agent window), or run gang down %s from a shell without this guard on its PATH to end the whole team on purpose.\n' \
       "$team" >&2
     printf 'GANG_TMUX_GUARD=off runs it anyway, and that use is recorded too.\n' >&2
     exit 3 ;;
  2) guard_unreadable_server "$@" ;;
esac

# The target is verified free of Gangline windows. Read the whole server only
# to explain the normal, useful case where a disposable session shares it; a
# failure here does not erase the target-specific proof that made this safe.
guard_rc=0
guard_agent_on_socket "$socket" || guard_rc=$?
case "$guard_rc" in
  0) team="$(guard_team_name)"
     note allowed-on-team-server "$@"
     printf 'gang tmux guard: this kill-session is on %s, the same tmux server that holds team '\''%s'\''. Running it: it names another session.\n' \
       "$socket" "$team" >&2 ;;
  1) note fall-open-no-gangline-agent "$@" ;;
  2) note allowed-verified-target "$@" ;;
esac
run_real "$@"
