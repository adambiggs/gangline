#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Print one live Codex pane-root identity as PID<TAB>kernel-start-ticks."""

import os
import sys


def main() -> int:
    if len(sys.argv) != 2 or not sys.argv[1].isdigit() or sys.platform != "linux":
        return 1

    pid = sys.argv[1]
    try:
        with open(f"/proc/{pid}/comm", encoding="utf-8") as stream:
            command = stream.read().strip()
        with open(f"/proc/{pid}/stat", encoding="utf-8") as stream:
            stat = stream.read().strip()
    except FileNotFoundError:
        return 1
    except OSError:
        return 2

    try:
        _before, delimiter, after = stat.rpartition(")")
        if not delimiter:
            return 2
        fields = after.split()
        state = fields[0]
        start_ticks = fields[19]
    except (IndexError, ValueError):
        return 2
    if command != "codex" or state == "Z":
        return 1
    if not start_ticks.isdigit():
        return 2
    print(pid, start_ticks, sep="\t")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
