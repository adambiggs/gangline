#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Run one cooperative tick in its own process group with a hard deadline."""

import os
import signal
import subprocess
import sys


DEADLINE_SECONDS = 60


def main() -> int:
    if len(sys.argv) < 2:
        print("gang tick deadline: no worker command", file=sys.stderr)
        return 2

    worker = subprocess.Popen(
        sys.argv[1:],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        start_new_session=True,
    )
    try:
        stdout, stderr = worker.communicate(timeout=DEADLINE_SECONDS)
    except subprocess.TimeoutExpired:
        os.killpg(worker.pid, signal.SIGKILL)
        stdout, stderr = worker.communicate()
        sys.stdout.buffer.write(stdout)
        sys.stderr.buffer.write(stderr)
        print(
            f"gang tick: hard deadline of {DEADLINE_SECONDS}s expired; "
            "the one-shot worker process group was killed",
            file=sys.stderr,
        )
        return 124

    sys.stdout.buffer.write(stdout)
    sys.stderr.buffer.write(stderr)
    return worker.returncode


if __name__ == "__main__":
    raise SystemExit(main())
