#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Run one cooperative tick in its own process group with a hard deadline."""

import os
import signal
import subprocess
import sys


DEADLINE_SECONDS = 60
NANOSECONDS_PER_SECOND = 1_000_000_000
worker = None
received_signal = None


class ClockError(Exception):
    pass


def clock_helper(*arguments: str) -> subprocess.CompletedProcess:
    path = os.environ.get(
        "GANGLINE_CLOCK_HELPER",
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "gang-clock"),
    )
    try:
        return subprocess.run(
            [path, *arguments],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
    except OSError as exc:
        raise ClockError from exc


def clock_now_ns() -> int:
    result = clock_helper("now")
    value = result.stdout.strip()
    if result.returncode != 0 or not value.isascii() or not value.isdigit():
        raise ClockError
    return int(value, 10)


def clock_elapsed(started_ns: int, duration_ns: int) -> bool:
    result = clock_helper("elapsed", str(started_ns), str(duration_ns))
    if result.returncode == 0:
        return True
    if result.returncode == 1:
        return False
    raise ClockError


def kill_worker_group() -> None:
    child = worker
    if child is None:
        return
    # communicate() sets returncode only after it has reaped the direct child.
    # Reading the attribute does not reap: while it is None, an exited zombie
    # still reserves the worker's PID/PGID and the owned group is safe to name.
    # Once it is set, that numeric PGID can be reused and must not be signalled.
    if child.returncode is not None:
        return
    try:
        # Do not poll here. A direct child may already have exited while one of
        # its descendants still owns the captured pipes. Until communicate()
        # reaps that child, its zombie reserves this PID/PGID; kill the owned
        # group first, then let communicate() reap it and drain the pipes.
        os.killpg(child.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass


def handle_signal(signum, _frame) -> None:
    global received_signal
    if received_signal is None:
        received_signal = signum
    kill_worker_group()


def reraise(signum: int) -> int:
    signal.signal(signum, signal.SIG_DFL)
    os.kill(os.getpid(), signum)
    return 128 + signum


def main() -> int:
    global worker

    if len(sys.argv) < 2:
        print("gang tick deadline: no worker command", file=sys.stderr)
        return 2

    for caught in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM, signal.SIGALRM):
        signal.signal(caught, handle_signal)
    if received_signal is not None:
        return reraise(received_signal)

    try:
        started_ns = clock_now_ns()
    except ClockError:
        print("gang tick: cannot read the shared monotonic clock", file=sys.stderr)
        return 2

    worker = subprocess.Popen(
        sys.argv[1:],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        start_new_session=True,
        env={**os.environ, "GANG_TICK_DEADLINE_SECONDS": str(DEADLINE_SECONDS)},
    )
    child = worker
    if received_signal is not None:
        kill_worker_group()
    deadline_ns = DEADLINE_SECONDS * NANOSECONDS_PER_SECOND
    expired = False
    try:
        while True:
            if clock_elapsed(started_ns, deadline_ns):
                expired = True
                break
            current_ns = clock_now_ns()
            if current_ns < started_ns:
                raise ClockError
            remaining = (deadline_ns - (current_ns - started_ns)) / NANOSECONDS_PER_SECOND
            try:
                stdout, stderr = child.communicate(timeout=max(remaining, 0.001))
                break
            except subprocess.TimeoutExpired:
                continue
    except ClockError:
        kill_worker_group()
        stdout, stderr = child.communicate()
        worker = None
        sys.stdout.buffer.write(stdout)
        sys.stderr.buffer.write(stderr)
        if received_signal is not None:
            return reraise(received_signal)
        print("gang tick: cannot compare the shared monotonic deadline", file=sys.stderr)
        return 2

    if expired:
        kill_worker_group()
        stdout, stderr = child.communicate()
        worker = None
        sys.stdout.buffer.write(stdout)
        sys.stderr.buffer.write(stderr)
        if received_signal is not None:
            return reraise(received_signal)
        print(
            f"gang tick: hard deadline of {DEADLINE_SECONDS}s expired; "
            "the one-shot worker process group was killed",
            file=sys.stderr,
        )
        return 124

    worker = None
    sys.stdout.buffer.write(stdout)
    sys.stderr.buffer.write(stderr)
    if received_signal is not None:
        return reraise(received_signal)
    return child.returncode


if __name__ == "__main__":
    raise SystemExit(main())
