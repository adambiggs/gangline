#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Append and read Gangline's durable diagnostic event stream."""

import argparse
import fcntl
import json
import os
import subprocess
import sys


class EventError(Exception):
    pass


# Two complete generations put a fixed ceiling on diagnostic storage while a
# lock spans only one append and possible rename.  The reader takes the same
# lock, so it never calls an interleaved/partial JSON line evidence.
GENERATION_BYTES = 8 * 1024 * 1024
CLOCK_HELPER = os.path.join(os.path.dirname(os.path.abspath(__file__)), "gang-clock")


def whole(value, field):
    if not isinstance(value, int) or isinstance(value, bool) or value < 0:
        raise EventError(f"{field} must be a non-negative whole number")
    return value


def monotonic_ns():
    """Read the one shared clock seam instead of selecting a local domain."""
    try:
        result = subprocess.run(
            [CLOCK_HELPER, "now"],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
    except OSError as err:
        raise EventError(f"cannot read the shared monotonic clock: {err}") from err
    value = result.stdout.strip()
    if result.returncode != 0 or not value.isascii() or not value.isdigit():
        raise EventError("the shared monotonic clock is unreadable")
    return int(value, 10)


def facts(value):
    try:
        parsed = json.loads(value)
    except ValueError as err:
        raise EventError(f"facts are not JSON: {err}") from err
    if not isinstance(parsed, dict):
        raise EventError("facts must be a JSON object")
    return parsed


def prepared_event(args):
    if not args.team or not args.agent or not args.kind:
        raise EventError("team, agent, and kind are required")
    return {
        "v": 2,
        "monotonic_ns": monotonic_ns(),
        "team": args.team,
        "team_created": whole(args.team_created, "team_created"),
        "agent": args.agent,
        "kind": args.kind,
        "facts": facts(args.facts),
    }


def encoded(row):
    return (json.dumps(row, sort_keys=True, ensure_ascii=False, separators=(",", ":")) + "\n").encode()


def append_bytes(fd, data):
    remaining = memoryview(data)
    while remaining:
        written = os.write(fd, remaining)
        if written <= 0:
            raise OSError("append wrote no bytes")
        remaining = remaining[written:]


def write_record(events, data):
    """Append one complete record while retaining two bounded generations."""
    if len(data) > GENERATION_BYTES:
        raise EventError(f"event exceeds the {GENERATION_BYTES}-byte generation bound")
    try:
        os.makedirs(os.path.dirname(events), exist_ok=True)
        lock = os.open(events + ".lock", os.O_CREAT | os.O_RDWR, 0o600)
        try:
            fcntl.flock(lock, fcntl.LOCK_EX)
            if os.path.exists(events) and os.path.getsize(events) + len(data) > GENERATION_BYTES:
                os.replace(events, events + ".1")
            fd = os.open(events, os.O_APPEND | os.O_CREAT | os.O_WRONLY, 0o600)
            try:
                append_bytes(fd, data)
            finally:
                os.close(fd)
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)
            os.close(lock)
    except OSError as err:
        raise EventError(f"cannot append {events}: {err}") from err


def event(args):
    write_record(args.events, encoded(prepared_event(args)))


def prepare(args):
    print(encoded(prepared_event(args)).decode(), end="")


def recorded(raw):
    try:
        row = json.loads(raw)
    except ValueError as err:
        raise EventError(f"prepared event is not JSON: {err}") from err
    if not isinstance(row, dict) or row.get("v") != 2:
        raise EventError("prepared event is not a version 2 record")
    if not isinstance(row.get("team"), str) or not row["team"]:
        raise EventError("prepared event has no team")
    if not isinstance(row.get("agent"), str) or not row["agent"]:
        raise EventError("prepared event has no agent")
    if not isinstance(row.get("kind"), str) or not row["kind"]:
        raise EventError("prepared event has no kind")
    whole(row.get("team_created"), "prepared event team_created")
    whole(row.get("monotonic_ns"), "prepared event monotonic_ns")
    if not isinstance(row.get("facts"), dict):
        raise EventError("prepared event facts are not an object")
    return row


def append_record(args):
    raw = sys.stdin.read()
    if raw.count("\n") != 1 or not raw.endswith("\n"):
        raise EventError("prepared event must be one newline-terminated JSON line")
    write_record(args.events, encoded(recorded(raw)))


def matching(row, args):
    if row.get("team") != args.team:
        return False
    if args.team_created is not None and row.get("team_created") != args.team_created:
        return False
    if args.agent and row.get("agent") != args.agent:
        return False
    if args.kind and row.get("kind") != args.kind:
        return False
    if args.since is not None and row.get("monotonic_ns", -1) < args.since:
        return False
    return True


def read(args):
    try:
        lock = os.open(args.events + ".lock", os.O_CREAT | os.O_RDWR, 0o600)
        fcntl.flock(lock, fcntl.LOCK_SH)
    except OSError as err:
        raise EventError(f"cannot lock {args.events}: {err}") from err
    try:
        for path in (args.events + ".1", args.events):
            try:
                source = open(path, encoding="utf-8")
            except FileNotFoundError:
                continue
            except OSError as err:
                raise EventError(f"cannot read {path}: {err}") from err
            with source:
                for number, raw in enumerate(source, 1):
                    if not raw.strip():
                        continue
                    try:
                        row = json.loads(raw)
                    except ValueError as err:
                        print(f"gang-events: skipped malformed {path} line {number}: {err}", file=sys.stderr)
                        continue
                    if not isinstance(row, dict):
                        print(f"gang-events: skipped non-object {path} line {number}", file=sys.stderr)
                        continue
                    if row.get("v") != 2:
                        continue  # Legacy usage rows are intentionally read only by gang usage.
                    if matching(row, args):
                        print(json.dumps(row, sort_keys=True, ensure_ascii=False))
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN)
        os.close(lock)


def main():
    parser = argparse.ArgumentParser(prog="gang-events")
    commands = parser.add_subparsers(dest="command", required=True)
    for name in ("append", "prepare"):
        append = commands.add_parser(name)
        append.add_argument("--events", required=name == "append")
        append.add_argument("--team", required=True)
        append.add_argument("--team-created", type=int, required=True)
        append.add_argument("--agent", required=True)
        append.add_argument("--kind", required=True)
        append.add_argument("--facts", required=True)
    append_record_parser = commands.add_parser("append-record")
    append_record_parser.add_argument("--events", required=True)
    query = commands.add_parser("read")
    query.add_argument("--events", required=True)
    query.add_argument("--team", required=True)
    query.add_argument("--team-created", type=int)
    query.add_argument("--agent")
    query.add_argument("--kind")
    query.add_argument("--since", type=int)
    args = parser.parse_args()
    if args.command == "append":
        event(args)
    elif args.command == "prepare":
        prepare(args)
    elif args.command == "append-record":
        append_record(args)
    else:
        read(args)


if __name__ == "__main__":
    try:
        main()
    except EventError as err:
        print(f"gang-events: {err}", file=sys.stderr)
        raise SystemExit(1)
