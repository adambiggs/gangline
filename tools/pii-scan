#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#
# Scans for PII shapes in what this repo sends to public GitHub content:
# commit messages and patches over a range, or prose piped to --stdin (issue
# and PR bodies). One scanner, so the pre-push hook, CI, and the manual
# --stdin gate can never drift into checking different things. Scope is
# docs/DECISIONS.md, "PII prevention is prospective".
#
# Portable shell + POSIX ERE only: the macOS CI cell is bash 3.2 with BSD
# grep, so no GNU regex extensions (\d \s \w \b), no PCRE, no bash-4 syntax.
#
# Usage:
#   pii-scan --stdin              < body.txt
#   pii-scan --range <git-rev-list-args...>
#
# Every invocation self-tests its own patterns against fixtures before
# scanning anything real. A pattern that stops matching its fixture — or a
# grep that cannot run at all — reddens the gate instead of silently
# reporting a clean scan that never looked (constitution law 8).
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

DENYLIST=".pii-scan-denylist"

usage() {
  echo "usage: pii-scan --stdin" >&2
  echo "       pii-scan --range <git-rev-list-args...>" >&2
  exit 2
}

# A checked-in denylist would print the operator-specific strings it exists
# to protect straight into the public tree it is meant to keep them out of.
refuse_if_denylist_tracked() {
  if git ls-files --error-unmatch -- "$DENYLIST" >/dev/null 2>&1; then
    echo "pii-scan: $DENYLIST is tracked by git — refusing to run. A" \
         "committed denylist of operator-specific strings would itself be" \
         "the leak. Untrack it (git rm --cached $DENYLIST) and keep it" \
         "gitignored." >&2
    exit 1
  fi
}

# Resolving on PATH is not the ability to run — test/lint.sh's shellcheck
# guard is the model this follows. Prove the primitive every pattern below
# depends on actually executes before trusting any result it gives.
require_working_grep() {
  printf 'x' | grep -Eq 'x' 2>/dev/null || {
    echo "pii-scan: grep -E cannot run correctly here (missing, broken, or" \
         "a shim with nothing behind it) — refusing to scan rather than" \
         "report a clean pass that never looked" >&2
    exit 1
  }
}

CLASSES="home-path email ip credential-sk-ant credential-ghp credential-github-pat credential-akia credential-private-key"

class_regex() {
  case "$1" in
    home-path) printf '%s' '(/home/|/Users/)[A-Za-z0-9_.-]+' ;;
    email) printf '%s' '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}' ;;
    ip) printf '%s' '([0-9]{1,3}\.){3}[0-9]{1,3}' ;;
    credential-sk-ant) printf '%s' 'sk-ant-[A-Za-z0-9_-]{10,}' ;;
    credential-ghp) printf '%s' 'ghp_[A-Za-z0-9]{20,}' ;;
    credential-github-pat) printf '%s' 'github_pat_[A-Za-z0-9_]{20,}' ;;
    credential-akia) printf '%s' 'AKIA[A-Z0-9]{16}' ;;
    credential-private-key) printf '%s' 'PRIVATE KEY' ;;
  esac
}

# $1 = class, $2 = matched value. Exit 0 = allowed (skip it), 1 = flag it.
class_allowed() {
  case "$1" in
    home-path)
      return 1 ;;
    email)
      case "$2" in
        *noreply*) return 0 ;;
        *.example|*.test|*.invalid|*.localhost) return 0 ;;
        *@example.com|*@example.org|*@example.net) return 0 ;;
      esac
      local known
      for known in $KNOWN_AUTHOR_EMAILS; do
        [ "$2" = "$known" ] && return 0
      done
      return 1 ;;
    ip)
      case "$2" in
        127.*|0.0.0.0|192.0.2.*|198.51.100.*|203.0.113.*) return 0 ;;
      esac
      return 1 ;;
    *) return 1 ;;   # credential shapes and the denylist are never allowed
  esac
}

class_fixture() {
  case "$1" in
    home-path) printf '%s' '/home/alice/notes.txt' ;;
    email) printf '%s' 'alice.doe@personalmail.co' ;;
    ip) printf '%s' '8.8.8.8' ;;
    credential-sk-ant) printf '%s' 'sk-ant-abcdefghijklmnop' ;;
    credential-ghp) printf '%s' 'ghp_ABCDEFGHIJKLMNOPQRSTUVWXYZabcdef01234' ;;
    credential-github-pat) printf '%s' 'github_pat_11ABCDEFG0abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ' ;;
    credential-akia) printf '%s' 'AKIAABCDEFGHIJKLMNOP' ;;
    credential-private-key) printf '%s' '-----BEGIN RSA PRIVATE KEY-----' ;;
  esac
}

# Long values are redacted before they are ever printed: a CI log on a public
# repo is itself public GitHub content, so restating the PII in the message
# that reports it would be the same leak this tool exists to catch.
redact() {
  local s="$1"
  local len=${#s}
  if [ "$len" -le 6 ]; then
    printf '[redacted]'
  else
    printf '%s...%s (%d chars)' "${s:0:2}" "${s: -2}" "$len"
  fi
}

# $1 = label for messages, $2 = class, $3 = content to scan.
# Returns 1 (and prints redacted hits) if anything unallowed matched.
class_hits() {
  local label="$1" class="$2" content="$3" any=0
  local re
  re="$(class_regex "$class")"
  local hit
  while IFS= read -r hit; do
    [ -n "$hit" ] || continue
    class_allowed "$class" "$hit" && continue
    printf 'pii-scan: %s: [%s] %s\n' "$label" "$class" "$(redact "$hit")" >&2
    any=1
  done < <(printf '%s' "$content" | grep -oE "$re" 2>/dev/null || true)
  [ "$any" -eq 0 ]
}

# The local, untracked, operator-specific denylist: strings the built-in
# classes have no general pattern for (a hostname, a personal name). Each
# non-blank, non-comment line is its own ERE, always flagged, never allowed.
scan_denylist() {
  local label="$1" content="$2" fail=0
  [ -r "$DENYLIST" ] || return 0
  local pat
  while IFS= read -r pat; do
    case "$pat" in ''|'#'*) continue ;; esac
    if printf '%s' "$content" | grep -Eq "$pat" 2>/dev/null; then
      printf 'pii-scan: %s: [denylist] matched a locally-configured string (value withheld)\n' "$label" >&2
      fail=1
    fi
  done < "$DENYLIST"
  return "$fail"
}

scan_content() { # $1 = label, $2 = content
  local label="$1" content="$2" fail=0
  local class
  for class in $CLASSES; do
    class_hits "$label" "$class" "$content" || fail=1
  done
  scan_denylist "$label" "$content" || fail=1
  return "$fail"
}

# The vacuous-check refusal, applied prospectively: prove every pattern still
# catches its own fixture before trusting any of them against real content.
selftest() {
  local class fixture
  for class in $CLASSES; do
    fixture="$(class_fixture "$class")"
    if class_hits selftest "$class" "$fixture" >/dev/null 2>&1; then
      echo "pii-scan: self-test FAILED for class '$class' — its fixture was" \
           "not flagged, so the pattern no longer matches. Refusing to scan" \
           "until this is fixed." >&2
      exit 1
    fi
  done
}

main() {
  require_working_grep
  refuse_if_denylist_tracked

  # Computed before selftest: the email class's allowlist check reads this,
  # and self-test exercises that same check against its own fixture.
  KNOWN_AUTHOR_EMAILS="$(git log --format=%ae | sort -u)"

  selftest

  case "${1:-}" in
    --stdin)
      local content
      content="$(cat)"
      local fail=0
      scan_content stdin "$content" || fail=1
      exit "$fail"
      ;;
    --range)
      shift
      [ "$#" -gt 0 ] || usage
      local sha_list
      sha_list="$(git rev-list "$@")"
      local fail=0 sha content
      for sha in $sha_list; do
        # This tool's own source is excluded from diff content, not from the
        # commit message: it embeds every pattern's self-test fixture as a
        # literal string so selftest can prove each one still matches, and
        # those fixtures are synthetic values that satisfy their own class by
        # design. Scanning them here would flag this tool's own patch on
        # every commit that touches it. Nothing else in the repo gets this
        # carve-out — see docs/DECISIONS.md, "PII prevention is prospective".
        content="$(git show --no-color "$sha" -- . ':!tools/pii-scan')"
        scan_content "commit $sha" "$content" || fail=1
      done
      exit "$fail"
      ;;
    *) usage ;;
  esac
}

main "$@"
