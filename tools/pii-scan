#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#
# Gangline's self-contained CI backstop for PII shapes in commit messages and
# patches. Operator-side pre-push and prose scanning belong to Snubline.
# Scope is docs/DECISIONS.md, "PII prevention is prospective".
#
# Portable shell + POSIX ERE only: the macOS CI cell is bash 3.2 with BSD
# grep, so no GNU regex extensions (\d \s \w \b), no PCRE, no bash-4 syntax.
#
# Usage:
#   pii-scan --stdin              < body.txt
#   pii-scan --range <git-rev-list-args...>
#   pii-scan --tag <annotated-tag-object>
#   pii-scan --contract
#
# Every invocation self-tests its own patterns against fixtures before
# scanning anything real. A pattern that stops matching its fixture — or a
# grep that cannot run at all — reddens the gate instead of silently
# reporting a clean scan that never looked (constitution law 8).
set -euo pipefail

top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -z "$top" ] || cd "$top"

DENYLIST=".pii-scan-denylist"
GLOBAL_DENYLIST="${XDG_CONFIG_HOME:-$HOME/.config}/snubline/pii-scan-denylist"

usage() {
  echo "usage: pii-scan --stdin" >&2
  echo "       pii-scan --range <git-rev-list-args...>" >&2
  echo "       pii-scan --tag <annotated-tag-object>" >&2
  echo "       pii-scan --contract" >&2
  exit 2
}

refuse() {
  printf 'pii-scan: %s\n' "$1" >&2
  exit 1
}

# A checked-in denylist would print the operator-specific strings it exists
# to protect straight into the public tree it is meant to keep them out of.
refuse_if_denylist_tracked() {
  local path
  for path in "$GLOBAL_DENYLIST" "$DENYLIST"; do
    if git ls-files --error-unmatch -- "$path" >/dev/null 2>&1; then
      echo "pii-scan: $path is tracked by git — refusing to run. A" \
           "committed denylist of operator-specific strings would itself be" \
           "the leak. Untrack it (git rm --cached $path) and keep it" \
           "gitignored." >&2
      exit 1
    fi
  done
}

check_global_denylist_permissions() {
  [ -e "$GLOBAL_DENYLIST" ] || return 0
  [ -r "$GLOBAL_DENYLIST" ] || refuse \
    "$GLOBAL_DENYLIST exists but is not readable — refusing to scan"

  local prc=0 probe
  probe="$(find "$GLOBAL_DENYLIST" -print 2>/dev/null)" || prc=$?
  { [ "$prc" -eq 0 ] && [ "$probe" = "$GLOBAL_DENYLIST" ]; } || refuse \
    "find cannot run correctly here — refusing to scan rather than report a permissions check that never looked"

  local lrc=0 loose
  loose="$(find "$GLOBAL_DENYLIST" \( -perm -0040 -o -perm -0004 \) -print 2>/dev/null)" || lrc=$?
  [ "$lrc" -eq 0 ] || refuse \
    "find failed while checking permissions (status $lrc)"
  [ -z "$loose" ] || refuse \
    "$GLOBAL_DENYLIST is readable by group or other; chmod 600 it"
}

# Resolving on PATH is not the ability to run — test/lint.sh's shellcheck
# guard is the model this follows. Prove the primitive every pattern below
# depends on actually executes before trusting any result it gives.
require_working_grep() {
  printf 'x' | grep -Eq 'x' 2>/dev/null || {
    echo "pii-scan: grep -E cannot run correctly here (missing, broken, or" \
         "a shim with nothing behind it) — refusing to scan rather than" \
         "report a clean pass that never looked" >&2
    exit 1
  }
}

CLASSES="home-path email ip credential-sk-ant credential-ghp credential-github-pat credential-akia credential-private-key"

class_regex() {
  case "$1" in
    home-path) printf '%s' '(/home/|/Users/)[A-Za-z0-9_.-]+' ;;
    email) printf '%s' '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}(:[A-Za-z0-9._~/-]+)?' ;;
    ip) printf '%s' '([0-9]{1,3}\.){3}[0-9]{1,3}' ;;
    credential-sk-ant) printf '%s' 'sk-ant-[A-Za-z0-9_-]{10,}' ;;
    credential-ghp) printf '%s' 'ghp_[A-Za-z0-9]{20,}' ;;
    credential-github-pat) printf '%s' 'github_pat_[A-Za-z0-9_]{20,}' ;;
    credential-akia) printf '%s' 'AKIA[A-Z0-9]{16}' ;;
    credential-private-key) printf '%s' 'PRIVATE KEY' ;;
  esac
}

# $1 = class, $2 = matched value. Exit 0 = allowed (skip it), 1 = flag it.
class_allowed() {
  case "$1" in
    home-path)
      return 1 ;;
    email)
      local scp_path
      case "$2" in
        *:*)
          scp_path="${2#*:}"
          case "$scp_path" in
            */?*|*.git) return 0 ;;   # SCP-form git URL: user@host:path
          esac
          ;;
        *noreply*) return 0 ;;
        *.example|*.test|*.invalid|*.localhost) return 0 ;;
        *@example.com|*@example.org|*@example.net) return 0 ;;
      esac
      local known
      for known in $KNOWN_AUTHOR_EMAILS; do
        [ "$2" = "$known" ] && return 0
      done
      return 1 ;;
    ip)
      case "$2" in
        127.*|0.0.0.0|192.0.2.*|198.51.100.*|203.0.113.*) return 0 ;;
      esac
      return 1 ;;
    *) return 1 ;;   # credential shapes and the denylist are never allowed
  esac
}

class_fixture() {
  case "$1" in
    home-path) printf '%s' '/home/alice/notes.txt' ;;
    email) printf '%s' 'alice.doe@personalmail.co' ;;
    ip) printf '%s' '8.8.8.8' ;;
    credential-sk-ant) printf '%s' 'sk-ant-abcdefghijklmnop' ;;
    credential-ghp) printf '%s' 'ghp_ABCDEFGHIJKLMNOPQRSTUVWXYZabcdef01234' ;;
    credential-github-pat) printf '%s' 'github_pat_11ABCDEFG0abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ' ;;
    credential-akia) printf '%s' 'AKIAABCDEFGHIJKLMNOP' ;;
    credential-private-key) printf '%s' '-----BEGIN RSA PRIVATE KEY-----' ;;
  esac
}

# Long values are redacted before they are ever printed: a CI log on a public
# repo is itself public GitHub content, so restating the PII in the message
# that reports it would be the same leak this tool exists to catch.
redact() {
  local s="$1"
  local len=${#s}
  if [ "$len" -le 6 ]; then
    printf '[redacted]'
  else
    printf '%s...%s (%d chars)' "${s:0:2}" "${s: -2}" "$len"
  fi
}

# $1 = label for messages, $2 = class, $3 = content to scan.
# Returns 1 (and prints redacted hits) if anything unallowed matched.
class_hits() {
  local label="$1" class="$2" content="$3" any=0 rc=0 matches
  local re
  re="$(class_regex "$class")"
  local hit
  matches="$(printf '%s' "$content" | grep -oE "$re" 2>/dev/null)" || rc=$?
  case "$rc" in
    0|1) ;;
    *) refuse "grep failed while scanning class $class (status $rc)" ;;
  esac
  while IFS= read -r hit; do
    [ -n "$hit" ] || continue
    class_allowed "$class" "$hit" && continue
    printf 'pii-scan: %s: [%s] %s\n' "$label" "$class" "$(redact "$hit")" >&2
    any=1
  done <<< "$matches"
  [ "$any" -eq 0 ]
}

# The local, untracked, operator-specific denylist: strings the built-in
# classes have no general pattern for (a hostname, a personal name). Each
# non-blank, non-comment line is its own ERE, always flagged, never allowed.
scan_denylist() {
  local label="$1" content="$2" fail=0
  local path pat line vrc
  for path in "$GLOBAL_DENYLIST" "$DENYLIST"; do
    [ -e "$path" ] || continue
    [ -r "$path" ] || refuse "$path exists but is not readable — refusing to scan"
    line=0
    while IFS= read -r pat || [ -n "$pat" ]; do
      line=$((line + 1))
      case "$pat" in ''|'#'*) continue ;; esac
      vrc=0
      printf '' | grep -Eq "$pat" 2>/dev/null || vrc=$?
      [ "$vrc" -le 1 ] || refuse \
        "$path:$line is not a valid extended regular expression"
      if printf '%s' "$content" | grep -Eq "$pat" 2>/dev/null; then
        printf 'pii-scan: %s: [denylist] matched a locally-configured string (value withheld)\n' "$label" >&2
        fail=1
      fi
    done < "$path"
  done
  return "$fail"
}

scan_content() { # $1 = label, $2 = content
  local label="$1" content="$2" fail=0
  local class
  for class in $CLASSES; do
    class_hits "$label" "$class" "$content" || fail=1
  done
  scan_denylist "$label" "$content" || fail=1
  return "$fail"
}

# A LEADING +++ IS NOT ENOUGH TO CALL A RECORD A HEADER. Git renders an added
# line whose content starts with "++" as "+++...", so skipping every +++ record
# drops real content — and a credential on such a line reaches the remote
# through a gate that reported clean. Requiring the header's trailing space is
# not enough either: content of "++ x" renders as "+++ x".
#
# The framing git already emits is what decides it. A file header appears only
# in the block between "diff --" and the first hunk marker; inside a hunk every
# record beginning with + is content, whatever follows it. Outside a hunk the
# old prefix rule still stands, so input that carries no framing at all — the
# self-test's projections below — behaves as it always did rather than going
# silently empty.
added_lines() {
  awk '
    /^diff --/ { in_hunk = 0; next }
    /^@@/ { in_hunk = 1; next }
    !in_hunk && /^\+\+\+ / { next }
    /^\+/ { sub(/^\+/, ""); print }
  '
}

# The vacuous-check refusal, applied prospectively: prove every pattern still
# catches its own fixture before trusting any of them against real content.
selftest() {
  local class fixture projected scp_url colon_email
  for class in $CLASSES; do
    fixture="$(class_fixture "$class")"
    if class_hits selftest "$class" "$fixture" >/dev/null 2>&1; then
      echo "pii-scan: self-test FAILED for class '$class' — its fixture was" \
           "not flagged, so the pattern no longer matches. Refusing to scan" \
           "until this is fixed." >&2
      exit 1
    fi
  done

  scp_url='git@github.com:owner/project.git'
  class_hits selftest email "$scp_url" >/dev/null 2>&1 || {
    echo "pii-scan: self-test FAILED — an SCP-form git URL was flagged as an email" >&2
    exit 1
  }
  colon_email='alice.doe@personal'"mail.co:hunter2swordfish"
  class_hits selftest email "$colon_email" >/dev/null 2>&1 && {
    echo "pii-scan: self-test FAILED — an email followed by a colon token was allowed" >&2
    exit 1
  }

  projected="$(printf '%s\n' '--- a/file' '+++ b/file' \
    '-/home/alice/removed' '+safe' | added_lines)"
  [ "$projected" = safe ] || {
    echo "pii-scan: self-test FAILED — deleted diff content reached the prospective scanner" >&2
    exit 1
  }
  projected="$(printf '%s\n' '--- a/file' '+++ b/file' \
    '-safe' '+/home/alice/added' | added_lines)"
  [ "$projected" = /home/alice/added ] || {
    echo "pii-scan: self-test FAILED — added diff content did not reach the prospective scanner" >&2
    exit 1
  }
  # Both directions of the header/content discrimination, against the framing
  # git actually emits: content that renders as +++ must be scanned, and the
  # file header that renders the same way must not be.
  projected="$(printf '%s\n' 'diff --git a/file b/file' '--- a/file' \
    '+++ b/file' '@@ -1 +1 @@' '-safe' '+++ /home/alice/added' | added_lines)"
  [ "$projected" = '++ /home/alice/added' ] || {
    echo "pii-scan: self-test FAILED — an added line whose content starts with" \
         "'++' was dropped as if it were a file header" >&2
    exit 1
  }
  projected="$(printf '%s\n' 'diff --git a/home/alice/notes b/home/alice/notes' \
    '--- /dev/null' '+++ b/home/alice/notes' '@@ -0,0 +1 @@' '+safe' | added_lines)"
  [ "$projected" = safe ] || {
    echo "pii-scan: self-test FAILED — a +++ file header was read as added content" >&2
    exit 1
  }
}

main() {
  if [ "${1:-}" = --contract ]; then
    [ "$#" -eq 1 ] || usage
    local out="pii-scan-contract" class
    for class in $CLASSES; do out="$out class:$class"; done
    printf '%s feature:global-denylist feature:denylist-validated feature:range-authors feature:tag-message\n' "$out"
    exit 0
  fi

  require_working_grep
  refuse_if_denylist_tracked
  check_global_denylist_permissions

  # Self-test proves the email fixture against an empty allowlist. A scan mode
  # then admits only addresses its own input is already publishing.
  KNOWN_AUTHOR_EMAILS=""
  selftest

  case "${1:-}" in
    --stdin)
      KNOWN_AUTHOR_EMAILS="$(git log --format=%ae 2>/dev/null | sort -u || true)"
      local content
      content="$(cat)"
      local fail=0
      scan_content stdin "$content" || fail=1
      exit "$fail"
      ;;
    --range)
      shift
      [ "$#" -gt 0 ] || usage
      KNOWN_AUTHOR_EMAILS="$(git log --format='%ae%n%ce' "$@" 2>/dev/null | sort -u || true)"
      local sha_list
      sha_list="$(git rev-list "$@")"
      local fail=0 sha content message additions
      for sha in $sha_list; do
        # This tool's own source is excluded from diff content, not from the
        # commit message: it embeds every pattern's self-test fixture as a
        # literal string so selftest can prove each one still matches, and
        # those fixtures are synthetic values that satisfy their own class by
        # design. Scanning them here would flag this tool's own patch on
        # every commit that touches it. Nothing else in the repo gets this
        # carve-out — see docs/DECISIONS.md, "PII prevention is prospective".
        message="$(git log -1 --format=%B "$sha")"
        # Force a textual prospective diff even when an attribute says -diff or
        # Git's NUL heuristic classifies a blob as binary. NUL cannot survive a
        # shell variable, so translate it before projecting the added lines.
        additions="$(git show --format= --no-color --unified=0 --text \
          --no-ext-diff --no-textconv "$sha" -- . ':!tools/pii-scan' \
          | LC_ALL=C tr '\000' '\n' | added_lines)"
        content="$message
$additions"
        scan_content "commit $sha" "$content" || fail=1
      done
      exit "$fail"
      ;;
    --tag)
      shift
      [ "$#" -eq 1 ] || usage
      [ "$(git cat-file -t "$1" 2>/dev/null || true)" = tag ] || usage
      KNOWN_AUTHOR_EMAILS="$( {
        git cat-file tag "$1" | sed -n 's/^tagger .*<\(.*\)>.*/\1/p'
        git log -1 --format='%ae%n%ce' "$1^{commit}" 2>/dev/null
      } | sort -u || true)"
      local content
      content="$(git cat-file tag "$1" | sed '1,/^$/d')"
      scan_content "tag $1" "$content" || exit 1
      exit 0
      ;;
    *) usage ;;
  esac
}

main "$@"
