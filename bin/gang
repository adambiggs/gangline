#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# gang — gangline: drive a team of CLI agents as tmux windows.
# Laws: CONSTITUTION.md. Transport decision: docs/adr/0001-tmux-is-the-substrate.md
set -euo pipefail

SESSION="${GANG_SESSION:-gangline}"

# Every marker gang matches is a glyph a TUI painted: spinners, progress-bar
# segments, menu cursors. Matching them means nothing outside a UTF-8 locale —
# under LC_ALL=C a bracket expression matches single BYTES and `[^ ]` eats one
# third of a spinner glyph, so "✽ Generating…" stops matching the busy pattern
# written for it and a live turn reads idle. cron runs in C. Rather than harden
# every regex in every profile against byte semantics, gang states the
# requirement it always had and satisfies it here, once. An environment that
# already names a UTF-8 locale is left exactly as it is.
utf8_locale() {
  case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
    *[Uu][Tt][Ff]8*|*[Uu][Tt][Ff]-8*) return 0 ;;
  esac
  local avail l
  avail="$(locale -a 2>/dev/null)" || return 1
  for l in C.UTF-8 C.utf8 en_US.UTF-8 en_US.utf8; do
    case "$avail" in *"$l"*) export LC_ALL="$l"; return 0 ;; esac
  done
  return 1
}
# Non-fatal: a host with no UTF-8 locale can still hitch, send, and drop — it is
# only marker matching that degrades, and gang vet reports the degradation
# rather than every command refusing to run.
utf8_locale || true

die() {
  # stderr gets its own terminal test. `gang roster 2>/dev/null | grep ...` is the
  # ordinary shape in a script, and there stdout is a pipe while stderr is still a
  # terminal — one test for both fds would drop the colour from the one line that
  # most wants it.
  if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
    printf '\033[31mgang:\033[0m %s\n' "$*" >&2
  else
    printf 'gang: %s\n' "$*" >&2
  fi
  exit 1
}

gang_root() { # $1 = path to this script; the install tree it lives in
  # Plain readlink in a loop, not `readlink -f`: the -f form is GNU-only and a
  # stock macOS rejects it. When it failed the substitution came back empty,
  # dirname read that as ".", and ROOT silently became the parent of whatever
  # directory the CALLER happened to be in — so gang ran with no profiles and no
  # roles while install.sh reported success. Law 8: a tool that cannot find its
  # own tree says so rather than running half-configured.
  local src="$1" dir
  while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")/.." && pwd
}
ROOT="$(gang_root "${BASH_SOURCE[0]}")"
# Both, because list_roles skips a directory that is not there and returns 0 --
# so a tree missing roles/ answered `gang roles` with silence and a clean exit,
# and every caller read that as "this install has no roles" rather than "this
# install is broken". Same shape as an unresolvable ROOT: fail where it is wrong,
# not where it is noticed.
for _d in profiles roles; do
  [ -d "$ROOT/$_d" ] \
    || die "no $_d/ beside $ROOT — this is not a gangline tree. Reinstall, or run bin/gang from a checkout."
done
unset _d
# Every rung absolute, because context rot tracks absolute length, not how full
# the window happens to be: a 300k context is degraded whether the window is 200k
# or 1M. A proportional rung scales the wrong way — 90% of 1M asserts that 900k is
# a fine place to sit. The ladder stops at 350000 because past four ignored
# warnings another one is noise, not advice.
BANDS="${GANG_CONTEXT_BANDS:-120000,180000,250000,350000}"

# One wait with two users: pane_stable asks it of a single pane and churn_batch
# asks it of a whole team, and the suite asserts the two agree about the same
# pane. Tuned in one place only, because tuning one and not the other would make
# the batched roster column and the per-agent read quietly start disagreeing —
# and a silent disagreement between two answers to one question is the drift this
# file has had to chase in several other costumes.
GANG_CHURN_WAIT="${GANG_CHURN_WAIT:-0.5}"

# One number with two users, and they ask the same physical question: how long
# after `/compact` is typed can that compaction still credibly be in flight.
# compaction_pending asks it to decide when patrol may go back to nudging a pane;
# resume_after_compaction asks it to decide when to stop waiting for proof of the
# context drop. One question, so one number — but the two do not FAIL alike, and
# whoever moves it is moving both. Overrunning it in patrol resumes nudging, so a
# message arrives late into a compaction: noisy. Overrunning it in the resume
# abandons the proof and drops back to the settle path, which can hand the message
# to a turn still running: corrupting. Lower is the dangerous direction at both.
#
# It also has a ceiling it does not state locally: raised past GANG_RESUME_TIMEOUT
# it deletes the resume's checked fallback outright, leaving only the timeout's
# unconditional inject. Both defaults are here rather than written out at each use,
# because a default spelled twice is how the churn wait above came to disagree with
# itself.
GANG_COMPACT_GRACE="${GANG_COMPACT_GRACE:-300}"

usage() {
  cat <<'EOF'
gang — drive a team of CLI agents as tmux windows

  gang up [name] [-p <prof>] [-r <role>] [-d <dir>] [-m <model>]
                                              the whole setup, no arguments needed:
                                              hitches "lead" here on GANG_PROFILE
                                              with the lead role, and puts you in it
  gang hitch <name> [-p <prof>] [-r <role>] [-d <dir>] [-m <model>]
                                              hitch an agent into the team (window name =
                                              identity); -r briefs it with a role from
                                              roles/; -m launches it on a specific model,
                                              spelled the harness's own way (codex:
                                              gpt-5.6-sol, opencode/pi: provider/model);
                                              alias: spawn
  gang adopt <name> -p <profile>              register an existing window as an agent
  gang send  <name> --from <sender> <msg...>  verified send; delivered mid-turn if the
                                              harness takes input during one (--wait to
                                              block for idle instead)
  gang compact <name> [--resume <msg>]        trigger the harness's own context compaction;
                                              --resume fires once compaction settles.
                                              Naming yourself is allowed and is the
                                              self-compaction path (--from/GANG_FROM required)
  gang status <name>                          busy (tight tug) | idle (slack tug) |
                                              gated (hook set: a modal owns the input
                                              box — a permission prompt, a picker, or
                                              anything else only the operator can clear;
                                              sends cannot land)
  gang context <name>                         context-window usage (profile-declared readout)
  gang wait  <name> [timeout_s]               block until idle (default 300)
  gang capture <name> [lines]                 tail of the agent's pane (default 40)
  gang roster                                 all agents with profile, state, context
  gang patrol                                 sweep the roster; nudge any agent past a
                                              context band (GANG_CONTEXT_BANDS ladder);
                                              holds if the agent's input box has content;
                                              reports any agent gated behind a modal
  gang vet [--file-issue]                     strategy-rot check: installed harness version
                                              vs each profile's verified pins; exits nonzero
                                              on drift; --file-issue files a deduped rot
                                              issue on this repo (needs gh); alias: doctor
  gang attach                                 attach to the team session
  gang drop  <name>                           release the agent — its window and
                                              state go with it
  gang down                                   end the whole session (every agent)
  gang profiles                               list available profiles (harnesses)
  gang roles                                  list available roles (briefs)
  gang context-hook                           harness hook mode: warn the agent in-turn when
                                              it crosses a context band (see README)

Env: GANG_PROFILE (default harness: claude-code), GANG_ROLE (role gang up briefs
     the lead with: lead), GANG_FROM (sender identity for send),
     GANG_SESSION (default: gangline),
     GANG_CONTEXT_BANDS (warning ladder; tokens or %, default 120000,180000,250000,350000),
     GANG_ROLES / GANG_PROFILES (your own dirs, searched before the shipped ones),
     GANG_BOOT_TIMEOUT (seconds to wait for a hitched harness to take input: 30)
EOF
}

usage_die() { usage >&2; exit 1; }

# --- profiles ---------------------------------------------------------------
#
# A profile says how to talk to one harness: how to launch it, how to tell it is
# mid-turn, how its modals read, how to read its context, how to see its input
# box. GANG_PROFILES
# points at your own directory, which is searched before the shipped one, so a
# new harness — or a fix to a shipped profile whose TUI has moved on — costs a
# file, never a patch to the installed tree.

# Profiles that exist to exercise gang's own mechanics rather than to drive a
# harness. They ship, because the suite needs them and a test dependency that is
# not installed is not tested — but they are not OFFERED. `gang profiles` is what
# the installer prints and what an operator picks from, and a shell sitting in
# that list reads as a fifth harness gangline supports: the operator asks which
# agent to run on it, and the honest answer is none. The suite opts back in.
TEST_ONLY_PROFILES="bash"

test_only_profile() { # $1 = profile name; exit 0 if it is a stand-in, not a harness
  [ "${GANG_TEST_PROFILES:-}" = 1 ] && return 1
  case " $TEST_ONLY_PROFILES " in *" $1 "*) ;; *) return 1 ;; esac
  # Only the SHIPPED stand-in is withheld. Somebody whose own GANG_PROFILES holds
  # a bash.sh means it, and shadowing is the documented way to override anything
  # gang ships — withholding their file too would make the override silently
  # useless for one name and nobody would guess which.
  [ "$(profile_file "$1" 2>/dev/null)" = "$ROOT/profiles/$1.sh" ]
}

# Every profile INSTALLED, whether or not it is offered: both dirs, deduped by
# name, because a name present in each is one profile with the shipped copy
# shadowed. The two callers want different sets and the difference is the whole
# point of splitting this out — `gang profiles` offers, `gang vet` diagnoses, and
# a rot check that only walked what is offered would quietly stop walking the
# stand-in it is shipped beside.
all_profiles() {
  local d p
  for d in ${GANG_PROFILES:+"$GANG_PROFILES"} "$ROOT/profiles"; do
    [ -d "$d" ] || continue
    for p in "$d"/*.sh; do
      [ -f "$p" ] || continue
      basename "$p" .sh
    done
  done | sort -u
}

list_profiles() { # what an operator may pick from
  # Built whole and written ONCE, which is load-bearing and not tidiness. Callers
  # pipe this into `grep -q`, and a reader that exits at its match closes the pipe
  # while a line-at-a-time writer still has lines to write: the writer takes
  # SIGPIPE, and under the caller's pipefail the whole pipeline reads as a MISS —
  # a name that is in the list reported as absent. Measured at exactly that, one
  # run in five, and a one-in-five miss is the failure that gets called flaky and
  # closed rather than fixed. A single write lands in the pipe buffer before any
  # reader can have matched anything, which is the property the pipe through
  # `sort` used to provide by accident; here it is on purpose.
  local n out=""
  while read -r n; do
    [ -n "$n" ] || continue
    test_only_profile "$n" && continue
    out="$out$n
"
  done <<EOF
$(all_profiles)
EOF
  printf '%s' "$out"
}

profile_file() { # $1 = profile name -> path on stdout; yours wins over the shipped one
  local d
  for d in ${GANG_PROFILES:+"$GANG_PROFILES"} "$ROOT/profiles"; do
    [ -f "$d/$1.sh" ] && { printf '%s' "$d/$1.sh"; return 0; }
  done
  return 1
}

load_profile() { # $1 = profile name; sets the GANG_* strategy surface
  local f
  f="$(profile_file "$1")" \
    || die "unknown profile '$1' (have: $(list_profiles | tr '\n' ' '))"
  GANG_LAUNCH="" GANG_BUSY_REGEX="" GANG_COMPACT_CMD="" GANG_MIDTURN_INPUT=""
  GANG_COMPACTING_REGEX="" GANG_GATED_REGEX="" GANG_SESSION_KEY=""
  GANG_VERSION_CMD="" GANG_VERIFIED_VERSIONS="" GANG_MODEL_OPT=""
  # no stale functions across profiles
  unset -f profile_context profile_input profile_vet 2>/dev/null || true
  # shellcheck source=/dev/null
  . "$f"
  [ -n "$GANG_LAUNCH" ] || die "profile '$1' sets no GANG_LAUNCH"
}

# --- roles ------------------------------------------------------------------
#
# A profile says how to talk to a harness; a role says what an agent is for.
# Both are the same kind of extension point, and neither is code: a role is a
# markdown brief injected as the agent's first message (law 9 — the answer is
# prose in an agent's prompt). GANG_ROLES points at your own directory, which
# is searched before the shipped one, so any brief here can be replaced by
# dropping a file of the same name next to it. `_`-prefixed files are not roles
# in their own right; `_common.md` is the part every role points at too.

list_roles() {
  local d f
  for d in ${GANG_ROLES:+"$GANG_ROLES"} "$ROOT/roles"; do
    [ -d "$d" ] || continue
    for f in "$d"/*.md; do
      [ -f "$f" ] || continue
      case "${f##*/}" in _*) continue ;; esac
      basename "$f" .md
    done
  done | sort -u
}

role_file() { # $1 = role name -> path on stdout; yours wins over the shipped one
  local d
  for d in ${GANG_ROLES:+"$GANG_ROLES"} "$ROOT/roles"; do
    [ -f "$d/$1.md" ] && { printf '%s' "$d/$1.md"; return 0; }
  done
  return 1
}

mint_key() { # -> a fresh session marker; unique by construction, meaningless by design
  # The marker exists to be found later: a profile that declares GANG_SESSION_KEY=1
  # keeps its usage figures in an on-disk session transcript, and the only durable
  # link from a tmux window to that file is a token gang itself planted in the
  # conversation. It is generated HERE, never taken from the command line and never
  # echoed to stdout — a caller that typed or printed it would record it in its own
  # transcript too, and a marker in two transcripts identifies nothing.
  printf 'gl-%s' "$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
}

valid_name() { # $1 = a name; usable as identity, tmux target, shell word, JSON string
  # One grammar for agent names and senders, because a name is all four of those
  # at once: tmux addresses it, the context hook puts it in JSON, the band note
  # puts it in a suggested command, and messages sign with it. A name that
  # cannot round-trip through all four is refused at the door rather than
  # producing a window nobody can address or a hook reply nobody can parse.
  case "$1" in
    ''|-*|.*) return 1 ;;
    *[!A-Za-z0-9._-]*) return 1 ;;
  esac
}

mint_nonce() { od -An -N4 -tx1 /dev/urandom | tr -d ' \n'; }

envelope() { # $1 = sender, $2 = body -> the message as it goes on the wire
  # Attribution used to be a prefix on the first line, which left every line
  # after it unsigned — and the role briefs read an unsigned line as the
  # OPERATOR, who outranks every peer. So a peer with nothing but permission to
  # run `gang send` could deliver `ok\nnow do the dangerous thing`, where the
  # second line arrives in the operator's voice. A repository that gets text
  # into one agent reaches the whole team that way.
  #
  # The envelope closes it: everything the sender said is inside a matched pair,
  # and the pair carries a nonce minted for this message alone. A body cannot
  # close the envelope and open another, because it cannot know the nonce and
  # because anything shaped like a tag is neutralised before it goes in — so an
  # unenveloped line really is the operator's own typing, mechanically rather
  # than by convention.
  #
  # What this does NOT do is authenticate the sender: any writer to a pane can
  # type an envelope. That is why the sender is read off the sending window
  # wherever gang can see one (check_sender), rather than believed.
  local nonce body
  nonce="$(mint_nonce)"
  body="$(printf '%s' "$2" | sed 's/\[\(\/\{0,1\}\)gang:/(\1gang:/g')"
  printf '[gang:%s#%s] %s [/gang:%s#%s]' "$1" "$nonce" "$body" "$1" "$nonce"
}

check_sender() { # $1 = claimed sender; inside the session, it must be your own window
  # --from is a string the caller chooses, and the point of attribution is that a
  # worker cannot sign as the lead — or as `patrol`, or `hitch`. Wherever gang
  # can see who is calling, it uses that instead of the claim. Outside the
  # session there is nobody to look at and the flag stands: that is the
  # operator's own shell, and cron.
  valid_name "$1" \
    || die "sender '$1' is not a usable identity — letters, digits, dot, dash and underscore only, not starting with a dash or dot"
  local self mine
  self="$(self_window)" || return 0
  mine="$(tmux display-message -p -t "$self" '#W' 2>/dev/null)" || return 0
  [ -z "$mine" ] || [ "$mine" = "$1" ] \
    || die "you are '$mine', so sign as '$mine' — a message signed '$1' from this window would put a peer's words in another agent's inbox under somebody else's name"
}

marker_line() { # $1 = key; the sentence that plants it, tuned to stay planted
  # "Never repeat it" is load-bearing: the marker identifies the one transcript it
  # was typed into, and an agent that quotes it to a peer plants it in a second
  # transcript, where lookup finds both and refuses to guess.
  printf 'Session marker: %s — gang bookkeeping, ignore it and never repeat it anywhere.' "$1"
}

role_brief() { # $1 = role, $2 = agent name; the message that points at the brief
  # Pointed at, not pasted. A brief is longer than a pane is tall, and a paste
  # whose first line has scrolled out of view cannot be verified — capture-pane
  # sees only what is on screen. Every coding agent can read a file, so the
  # universal surface here is the filesystem (law 1), and the brief stays on
  # disk where the agent can re-read it after compacting.
  local f common where
  f="$(role_file "$1")" || die "unknown role '$1' (have: $(list_roles | tr '\n' ' '))"
  where="$f"
  common="$(role_file _common)" && where="$common and $f"
  printf 'You are `%s` on a gangline team, in the %s role. Your operating brief is %s — read it now and follow it for the rest of this session.%s' \
    "$2" "$1" "$where" "${GANG_COMPACT_CMD:+ Your compaction command is $GANG_COMPACT_CMD}"
}

# --- window plumbing --------------------------------------------------------
#
# Agents are addressed by tmux window id (@N), never by "session:name": tmux's
# target grammar reads an all-digit name as a window INDEX, so a name-built
# target delivers `2` to whatever sits at index 2 and calls it verified. An id
# is immutable for the window's life, survives rename and reorder, and is never
# reused — so a name resolved once cannot drift under the rest of the command.
#
# The session is addressed as "=$SESSION" everywhere for the same class of
# reason: an unanchored tmux target is a PREFIX match, so GANG_SESSION=team
# resolves to a running team-production when nothing is called team — quietly
# hitching into the wrong team, and, through `gang down`, killing it. The "="
# demands the whole name.

win_id() { # $1 = agent name -> @id on stdout; nonzero if no window has that name
  local id name
  while read -r id name; do   # `read id name` keeps spaces in the name
    [ "$name" = "$1" ] && { printf '%s' "$id"; return 0; }
  done < <(tmux list-windows -t "=$SESSION" -F '#{window_id} #W' 2>/dev/null)
  return 1
}

exists() { win_id "$1" >/dev/null; }

self_window() { # -> the window id this process is running in; nonzero if not in one
  # tmux exports $TMUX_PANE into every pane it starts, so it names the caller
  # exactly — unlike the attached-client list, which names whoever is LOOKING at
  # the session, not who is running inside it. It can also be stale: a process
  # that outlived its pane, or one that inherited the variable across an ssh or
  # mosh hop, still carries a pane id for a pane that is gone. So the id is
  # checked against the live session rather than trusted; a stale one matches
  # nothing and the caller is simply not-self, which is the safe answer.
  [ -n "${TMUX_PANE:-}" ] || return 1
  local pid wid
  while read -r pid wid; do
    [ "$pid" = "$TMUX_PANE" ] && { printf '%s' "$wid"; return 0; }
  done < <(tmux list-panes -s -t "=$SESSION" -F '#{pane_id} #{window_id}' 2>/dev/null)
  return 1
}

# resolve() sets these two for the command that follows; the only name->agent lookup.
AGENT_ID="" AGENT_PROFILE=""

resolve() { # $1 = agent name; sets AGENT_ID + AGENT_PROFILE and loads the profile
  AGENT_ID="$(win_id "$1")" || die "no agent '$1' (see: gang roster)"
  AGENT_PROFILE="$(tmux show-options -wqv -t "$AGENT_ID" @gl_profile)"
  [ -n "$AGENT_PROFILE" ] \
    || die "window '$1' exists but is not a gang agent (gang adopt $1 -p <profile>)"
  load_profile "$AGENT_PROFILE"
}

session_live() { # exit 0 if the team's session is running
  # has-session fails identically for "there is no such session" and "the tmux
  # server cannot be reached at all", and discarding its stderr made the second
  # wear the first's clothes: inside a sandbox that denies connect() on the tmux
  # socket, `gang roster` printed "no team (session gangline not running)". The
  # operator read a message about the session, reasoned about $TMUX, and filed a
  # bug against the wrong subsystem. The message cost more than the fault did.
  #
  # Recognised phrasings of "not there" are treated as absence. Anything else is
  # surfaced verbatim rather than guessed at, because the set of ways a server
  # can be unreachable is not one gang can enumerate, and an unexpected message
  # reported as itself is the safe direction.
  #
  # The empty case is the exception, and it is a GUESS named as one. A nonzero
  # exit with nothing on stderr says nothing at all, and it is resolved toward
  # absence deliberately: a silent failure here is far more often a session that
  # is not running than a server that cannot be reached, and dying with "cannot
  # reach the tmux server — " and nothing after the dash is a worse answer than
  # "no team" for what is almost certainly a missing team. It is the one branch
  # that resolves ambiguity toward the direction which caused the original bug.
  local err
  err="$(tmux has-session -t "=$SESSION" 2>&1)" && return 0
  case "$err" in
    ""|*"can't find session"*|*"session not found"*|*"no such session"*) return 1 ;;
    *) die "cannot reach the tmux server — $err" ;;
  esac
}

# No -e, deliberately, and this is the first thing anyone proposes on being told
# a marker might be a colour rather than a character. Nearly every marker
# gangline scrapes is anchored to the START of a line, which is exactly where an
# escape sequence sits: claude-code's busy branch matches its own captured
# thinking line with escapes stripped and does not match it with them present,
# because the anchor eats the ESC. The same anchoring carries codex's gate
# (^› [0-9]+\.), pi's (^→), claude-code's own (^ +❯|Esc to) and opencode's badge
# and box parsing. Passing -e here would blind gate detection on three harnesses
# the day it landed.
capture() { tmux capture-pane -p -t "$1"; }

# -J joins pane-width-wrapped lines so matching never breaks on a wrap boundary.
capture_joined() { tmux capture-pane -pJ -t "$1"; }

capture_status() { # $1 = window id; the bottom rows, where a TUI paints its state
  # A dialog, a spinner and a progress bar are drawn at the bottom of the screen,
  # above the composer, and they move up and out as the transcript grows. The
  # transcript itself is where an agent QUOTES those same words — reading a
  # profile, pasting a capture, reviewing this repo. Matching the whole pane
  # cannot tell the two apart, so state reads from the region a TUI actually
  # paints state into. Trailing blank rows are dropped first: a half-empty pane
  # would otherwise spend its whole allowance on blank lines.
  capture_joined "$1" \
    | awk 'NF{last=NR} {line[NR]=$0} END{for(i=1;i<=last;i++) print line[i]}' \
    | tail -n "${GANG_STATUS_ROWS:-20}"
}

composer_live() { # $1 = window id; the harness's own input box is on screen NOW
  # Nonzero for a profile with no input hook, which is the honest answer: gang
  # cannot see a box it was never taught to find, so callers fall back to
  # whatever they did before one existed.
  declare -F profile_input >/dev/null || return 1
  profile_input "$1" >/dev/null 2>&1
}

busy_painted() { # $1 = window id, profile loaded; exit 0 if a turn is visibly in flight
  # The pane question, unconditioned: is this harness painting its busy marker?
  # Captured into a variable, not piped: a capture that FAILS must not read as
  # "idle" and wave an injection into a pane nobody looked at.
  [ -n "$GANG_BUSY_REGEX" ] || return 1
  local pane
  pane="$(capture_joined "$1")" || die "cannot read pane $1 — refusing to guess busy/idle"
  printf '%s\n' "$pane" | grep -qE -- "$GANG_BUSY_REGEX"
}

busy() { # $1 = window id, profile loaded; exit 0 if busy
  # The transport question — "will a send land at a sane boundary?" — which is
  # the same as the pane question everywhere except one case.
  #
  # An agent parked in gang's own `gang wait` is inside a harness turn, so it
  # paints the busy marker while being the most available agent on the team: it
  # is doing nothing but waiting, and the wait ends the moment its target moves.
  # Reporting that as busy makes the roster lie in the direction that costs the
  # most — a lead skips the one worker that could take the task.
  #
  # Gated on mid-turn input on purpose, and this is the narrow scope: where the
  # harness refuses input during a turn, a parked agent genuinely CANNOT be
  # handed anything until its wait returns, so busy stays true and stays honest.
  # Parked only overrides the answer where the paste would actually land.
  if [ "${GANG_MIDTURN_INPUT:-}" = 1 ] && parked "$1"; then return 1; fi
  busy_painted "$1" && return 0
  # A missing marker is not a missing turn, and there is nothing to widen a
  # branch onto. claude-code marks THINKING and leaves the rest bare: of 220
  # samples with the pane demonstrably changing, 19 carried any branch of the
  # busy regex, and the longest unbroken run of live-but-unmarked samples was 64
  # — about 16 seconds. Compared over the whole pane, a mid-stream screen is
  # transcript text, rule, empty composer, rule, context beacon, permissions
  # line: the idle screen exactly, with no line present in one and absent from
  # the other. So this is not a scan-depth problem and not a pattern problem.
  #
  # The only difference is that it keeps changing, which is not a question a
  # single frame can be asked. Markers demote to a fast path — a marked pane
  # never pays for the second capture — and churn answers for everything they
  # miss. The check scrapes nothing, so unlike a marker it cannot rot, and gang
  # already trusts it to mean "quietly idle" where a resume and a nudge are held.
  #
  # Churn is content-blind, so on its own it would call a pane parked in `gang
  # wait` busy — the false busy the parked branch above exists to kill. That
  # collision does not arise, because the exclusion is by state gang OWNS
  # (@gl_waiting, holding the waiter's pid) rather than by matching the screen.
  #
  # $2 is that same answer resolved ahead of time for a whole team at once, so a
  # roster pays one sleep rather than one per agent. Absent, this asks for itself.
  case "${2:-}" in
    churning) return 0 ;;
    still)    return 1 ;;
  esac
  ! pane_stable "$1"
}

# Churn costs two captures separated by a wait, and asking each agent in turn
# makes a roster O(agents) in wall clock — the most-used command, growing with
# the size of the team it exists to show. So the question is asked for everyone
# at once: probe each pane, keep only the ones no marker and no owned state has
# already answered, wait ONCE, and re-read that set. A marked pane never reaches
# the second capture, so it is cheaper here than it was before churn existed.
#
# This makes the per-pane interval VARIABLE — the wait plus however long the
# batch itself takes — where a lone busy() uses a fixed one. It can never be
# SHORTER than the wait, and a longer interval only makes movement easier to
# catch, so the error moves toward calling a live pane busy. Safe direction.
#
# Skipping an agent here is always safe: whatever is not resolved falls through
# to the per-agent path in busy(), which is what every caller did before.
CHURN_MAP=""

map_get() { # $1 = "k=v k=v ...", $2 = key -> value on stdout
  local pair
  for pair in $1; do
    case "$pair" in "$2="*) printf '%s' "${pair#*=}"; return 0 ;; esac
  done
  return 1
}

churn_verdict() { # $1 = window id -> "churning" | "still" | "" if it was not sampled
  map_get "$CHURN_MAP" "$1" || true
}

churn_batch() { # $@ = window ids; resolve the churn question for all of them at once
  local id prof pending="" first="" sum was
  CHURN_MAP=""
  for id in "$@"; do
    prof="$(tmux show-options -wqv -t "$id" @gl_profile)" || continue
    [ -n "$prof" ] || continue
    profile_file "$prof" >/dev/null 2>&1 || continue
    # Subshelled for two reasons. A pane gang cannot read costs this agent its
    # batching rather than costing the whole roster its state column; and
    # load_profile is per agent, so without the subshell the profile read last
    # would leak into every state read after it.
    #
    # cksum rather than the screen itself, because holding a team's worth of
    # captures means arrays this file does not use. Its byte count is the second
    # field, so a false match needs a collision at identical length — but the
    # cost of being wrong matters more than the odds of it: a false match reads
    # as unchanged, which reads as not churning, which reads as IDLE. That is the
    # false-idle direction, the one this whole state path exists to close.
    #
    # It is also the single place gang trades exactness for cost. pane_stable
    # compares full screen text; this compares 32 bits. They are not the same
    # test, and what holds them to the same answer is the suite asserting the
    # batched column against the per-agent read on one pane.
    sum="$( ( load_profile "$prof"
              if [ "${GANG_MIDTURN_INPUT:-}" = 1 ] && parked "$id"; then exit 1; fi
              busy_painted "$id" && exit 1
              capture "$id" | cksum | tr ' ' '-' ) 2>/dev/null )" || continue
    [ -n "$sum" ] || continue
    pending="$pending $id"
    first="$first $id=$sum"
  done
  [ -n "$pending" ] || return 0
  sleep "$GANG_CHURN_WAIT"
  for id in $pending; do
    sum="$( capture "$id" 2>/dev/null | cksum | tr ' ' '-' )" || continue
    was="$(map_get "$first" "$id")" || continue
    if [ "$sum" = "$was" ]; then CHURN_MAP="$CHURN_MAP $id=still"
    else CHURN_MAP="$CHURN_MAP $id=churning"; fi
  done
}

compacting() { # $1 = window id, profile loaded; exit 0 if the harness is visibly compacting
  # A narrower question than busy, asked for one reason: a compaction is the one
  # turn a message can be handed to safely. Busy says a turn is in flight, and a
  # turn in flight is exactly what eats a resume. Compaction is a turn that reads
  # no input, so text typed into it can only wait — which makes "compaction is
  # running" the earliest moment a resume is safe, and the pane shows it plainly.
  # Unset is a real answer, not a hole: a profile whose compaction nobody has
  # watched live gets the settle path, which scrapes no marker at all.
  [ -n "${GANG_COMPACTING_REGEX:-}" ] || return 1
  local pane
  pane="$(capture_status "$1")" || die "cannot read pane $1 — refusing to guess compaction state"
  printf '%s\n' "$pane" | grep -qE -- "$GANG_COMPACTING_REGEX" || return 1
  # Claude Code's marker is a single bar glyph, and this repo's own profiles are
  # full of them: an agent reading profiles/claude-code.sh puts ▰ on its screen.
  # Believing that is worse than missing a real compaction, because the resume
  # then goes into the turn it was supposed to follow — the exact overtaking the
  # waiter exists to prevent. Compaction reads no input and leaves the box drawn
  # and empty (watched frame by frame), so an occupied box says this is an
  # ordinary turn with the glyph somewhere in it, and the waiter keeps waiting.
  input_clear "$1"
}

# Gang types the compaction itself — cmd_compact injects GANG_COMPACT_CMD, and an
# agent compacting itself is told to go through `gang compact <self>` — so gang
# KNOWS one is in flight without looking for it. That fact is recorded on the
# window instead of inferred from the pane, because an owned signal cannot rot,
# and rot is the whole disease here: three declared markers went dead in one
# session, each a different way, and every one of them passed `gang vet`.
#
# It answers exactly ONE question: may patrol inject into this pane. It is
# deliberately NOT wired into compacting(), which answers a different one.
# resume_after_compaction breaks the instant compacting() is true and needs that
# to mean "the turn that could have eaten this resume is OVER"; this mark is set
# while the compaction is still QUEUED BEHIND that very turn, so handing it to
# that caller would rebuild the overtaking the waiter exists to prevent. One
# signal answering two questions is how the bar glyphs came to carry both busy
# and compacting, and it is not being rebuilt here.
#
# It covers gang-issued compaction only. A harness auto-compacting at its own
# threshold is invisible to this, and that is exactly when patrol is sweeping,
# because patrol nudges at a high context band and a harness auto-compacts at
# one. The split is deliberate rather than overlooked, because the two differ in
# severity: a gang-issued compaction has a queued resume in flight, so a nudge
# there is precisely the overtaking the waiter exists to prevent, while an
# auto-compaction has no pending resume, so a nudge is queued, delivered late,
# and burns a band — noisy, not corrupting. The dangerous case is covered.
compaction_mark() { # $1 = window id, profile loaded; record that WE issued one
  local at=0 ctx tw tokens window
  if declare -F profile_context >/dev/null \
     && ctx="$(profile_context "$1" 2>/dev/null)" \
     && tw="$(ctx_tokens "${ctx%%$'\n'*}")"; then
    read -r tokens window <<<"$tw"; at="$tokens"
  fi
  tmux set-option -w -t "$1" @gl_compacting "$(date +%s) $at" 2>/dev/null || true
}

compaction_clear() { tmux set-option -uw -t "$1" @gl_compacting 2>/dev/null || true; }

compaction_pending() { # $1 = window id, $2 = tokens in context NOW (optional)
  # Two ways out, because each covers a case the other cannot see.
  local v issued at_issue now
  v="$(tmux show-options -wqv -t "$1" @gl_compacting 2>/dev/null)" || return 1
  [ -n "$v" ] || return 1
  read -r issued at_issue <<<"$v"
  [[ "$issued" =~ ^[0-9]+$ ]] || { compaction_clear "$1"; return 1; }
  # The context drop is the positive one: a compaction that HAPPENED shows it,
  # and unlike the momentary zero the readout flashes on its way through, the
  # drop is monotone — it stays low — so no poll interval can step over it.
  #
  # Half is a CHOICE, not a threshold anybody measured a harness against. Every
  # compaction watched here reclaimed far more (246k to 48k, 161k to 44k), and a
  # harness that reclaims less simply rides the clock out instead: late, never
  # wrong, and late is the safe direction because the cost is a held nudge rather
  # than one delivered into a live compaction. An unexamined constant is the same
  # disease as an unexamined marker, so it is named here rather than left to look
  # like a measurement.
  if [ -n "${2:-}" ] && [[ "$2" =~ ^[0-9]+$ ]] \
     && [[ "$at_issue" =~ ^[0-9]+$ ]] && [ "$at_issue" -gt 0 ] \
     && [ "$2" -lt $(( at_issue / 2 )) ]; then
    compaction_clear "$1"; return 1
  fi
  # And the clock, because a compaction that never happened shows nothing at all:
  # `/compact` under a harness's own threshold leaves the context exactly where it
  # was (measured on a 30k pane — the command ran, the readout never moved), so a
  # mark trusted until the drop would hold patrol off that pane for good.
  now="$(date +%s)"
  # Shared with resume_after_compaction, which uses the same number to decide when
  # to give up waiting for the drop; overrunning it there is corrupting, not noisy.
  [ $(( now - issued )) -lt "$GANG_COMPACT_GRACE" ] || { compaction_clear "$1"; return 1; }
  return 0
}

gated() { # $1 = window id, profile loaded; exit 0 if a modal owns the input box
  # The third state, and the one that must not pass for the other two: a harness
  # stopped at a modal is not working and not reachable — keystrokes sent to it
  # land IN the dialog, where they ANSWER it. Every gate watched live
  # (claude-code, codex, opencode) also drops its busy hint and its input box
  # while the dialog is up, so an unmarked gate reads idle: patrol holds a nudge
  # on a box it cannot find, sends die "not taking input", and nothing on any
  # surface says a dialog is what the whole team is stalled on. Lived it: three
  # agents sat gated for minutes and the only diagnostic was capturing panes one
  # by one.
  #
  # There are two ways in, because enumerating modal chrome will always miss one.
  local pane
  if [ -n "${GANG_GATED_REGEX:-}" ]; then
    # The declared marker: the dialogs somebody has watched live, named in the
    # profile. Unset is a real answer — a profile whose gate nobody has watched
    # declares nothing and reaches this state only through the fallback below.
    #
    # The WHOLE pane, not the bottom rows. A dialog is drawn above the composer,
    # but it is drawn as tall as it needs to be, and its distinguishing wording is
    # not always in its last twenty rows: opencode's model picker paints its own
    # declared branch on the full pane and on NOTHING inside the status window, so
    # that branch was alive in the TUI and dead in the region gang read it from.
    # Nothing catches that by auditing markers for liveness — the marker is not
    # dead, only unreachable — so the scan is what has to widen.
    pane="$(capture_joined "$1")" || die "cannot read pane $1 — refusing to guess gated state"
    if printf '%s\n' "$pane" | grep -qE -- "$GANG_GATED_REGEX"; then
      # The wording alone is not the gate. Every dialog watched live OWNS the
      # screen while it is up: the composer is gone, which is why an unmarked gate
      # read idle in the first place. So a match beside a live input box is the
      # harness talking ABOUT a prompt, not stopped at one — an agent reviewing
      # this repo, quoting a capture, or reading these very profiles. Lived it:
      # reviewers quoting the dialog wording froze their own lead and had their
      # reports refused, which is a denial of the whole control plane out of
      # ordinary prose.
      #
      # This check, not the scan depth, is what makes matching the whole pane
      # safe — and the pairing does not transfer. busy() and compacting() ask for
      # no box, so widening either of them the same way would believe any agent
      # that quotes a marker: measured on this team, compacting() would have read
      # true for three minutes off a reviewer's own grep output. Narrowing them to
      # the status window is not a defence either, it is luck — prose-quoted
      # markers landed inside the bottom twenty rows in 49 samples and outside it
      # in the rest. Anyone widening those two needs their own argument.
      composer_live "$1" || return 0
    fi
  fi
  # The fallback: a state gang cannot positively determine is gated, not idle.
  # No busy hint, no marker, and no input box to be found is not evidence of an
  # agent waiting for work — it is evidence that something gang was never taught
  # to recognise is holding the screen (Claude Code's /model picker reads exactly
  # this way). Idle MEANS "go ahead and send", so calling the unknown idle loses
  # the message, and `gang wait` cannot rescue it either: the waiter keys on
  # BECOMING idle and the pane already reads idle. Gated costs a delay instead.
  #
  # The box is asked about first because it is the cheap question and the common
  # answer: a box gang can find is not a box a modal has taken. It is also where
  # a profile that declares no input hook stops — gang cannot claim a box is
  # missing when it was never taught to find one, so such a profile keeps exactly
  # the busy/idle reading it always had.
  if input_painted "$1"; then return 1; fi
  # No box, then. That is a modal unless a turn in flight explains it: several
  # harnesses stop painting their composer while one runs. The PANE question,
  # not the transport one — an agent parked in `gang wait` has a turn in flight
  # and is not behind a modal, so asking busy() here would call it gated the
  # moment its composer went missing for any other reason.
  ! busy_painted "$1"
}

pane_stable() { # $1 = window id; screen byte-identical across two captures ≈ quietly idle
  # Marker regexes are snapshots of a screen that may be actively redrawing —
  # at a turn boundary or during compaction, one capture can miss the spinner
  # and the next can miss the input-box content, and every guard reads a
  # different frame (lived it: patrol nudged mid-compaction and the note
  # jumped the harness's own input queue). A quietly idle TUI paints a static
  # screen; streaming, spinners and timers all churn. Scrapes no marker, so it
  # cannot rot.
  #
  # What it cannot do is tell a finished turn from a silent one, and the gap is
  # measured rather than supposed: a claude-code compaction paints nothing at
  # all and holds the screen byte-identical — 633 consecutive captures over 158
  # seconds, no marker of any kind on any of them — so this answers "stable"
  # straight through one. Any long silent stretch reads the same way: a test
  # run, a fetch, a large read. Stable means the PANE has stopped moving, which
  # is not the same claim as the agent having stopped working.
  local a b
  a="$(capture "$1")" || die "cannot read pane $1"
  sleep "$GANG_CHURN_WAIT"
  b="$(capture "$1")" || die "cannot read pane $1"
  [ "$a" = "$b" ]
}

# A harness that declares an input box tells gang two things no generic screen
# scrape can: that the TUI is up at all, and that a paste would not land on top
# of something already typed. Profiles without one keep the generic path.
input_painted() { # $1 = window id; the harness has drawn an input box
  declare -F profile_input >/dev/null || return 0
  profile_input "$1" >/dev/null
}

input_clear() { # $1 = window id; that box holds no draft, ghost text, or queued hint
  declare -F profile_input >/dev/null || return 0
  local box
  box="$(profile_input "$1")" || return 1
  ! printf '%s' "$box" | grep -q '[^[:space:]]'
}

wait_ready() { # $1 = window id, $2 = timeout seconds; harness booted and quiet
  # Two conditions, because a booting harness passes either one alone.
  #
  # Quiet is not enough: for the first seconds the pane is EMPTY, and an empty
  # screen is a perfectly stable screen. Quiet alone therefore says "ready"
  # before the harness has read a byte of stdin, and the brief pastes into a
  # process that is not listening (lived it: `gang up` hitched a manager and
  # then failed to verify a brief that had gone nowhere). A painted input box
  # is the direct evidence that the TUI is up and taking input.
  #
  # The box's CONTENT is deliberately not tested. A fresh TUI paints ghost text
  # into its empty box (Claude Code: 'Try "fix typecheck errors"'), which
  # input_clear reads as content — right for patrol, which must never type over
  # a human's draft; wrong for an agent two seconds old, where waiting on it
  # never returns at all.
  # Exit 2 is the settled-but-not-an-input-box case, worth telling apart because
  # it is nearly always a first-run modal a human has to answer — Claude Code's
  # "Do you trust the files in this folder?". Its menu cursor is a "❯" too, but
  # indented, so no input box is found and gang refuses to paste a brief into a
  # security prompt.
  local t=0
  while [ "$t" -lt "$2" ]; do
    input_painted "$1" && pane_stable "$1" && return 0
    sleep 1; t=$((t + 1))
  done
  pane_stable "$1" && return 2
  return 1
}

# --- parked in gang's own wait ----------------------------------------------
# A window option, like every other piece of gang's state, so it dies with the
# window and `tmux show-options -w` is its whole debugger. The holder's pid goes
# inside for the same reason lock_pane keeps one: an option outlives the process
# that set it, so a waiter killed mid-wait would otherwise leave its agent
# reading available forever.
PARKED=0

unpark() { # drop OUR marker, never somebody else's
  [ "$PARKED" = 1 ] || return 0
  PARKED=0
  local w
  w="$(self_window)" || return 0
  [ "$(tmux show-options -wqv -t "$w" @gl_waiting 2>/dev/null)" = "$$" ] || return 0
  tmux set-option -uw -t "$w" @gl_waiting 2>/dev/null || true
}

# One EXIT trap for both, because bash keeps only the last one installed and
# lock_pane and park_self can be reached in either order (`send --wait` waits
# first and locks second; `send` locks without ever waiting).
on_exit() { lock_release; unpark; }

park_self() { # mark this window as blocked in gang's own wait
  # Not being in a pane is normal, not an error: gang runs from the operator's
  # own shell and from cron, and neither has an agent to mark.
  local w
  w="$(self_window)" || return 0
  tmux set-option -w -t "$w" @gl_waiting "$$" 2>/dev/null || return 0
  PARKED=1
  trap 'on_exit' EXIT
}

parked() { # $1 = window id; exit 0 if a live gang wait is parked in that window
  local holder
  holder="$(tmux show-options -wqv -t "$1" @gl_waiting 2>/dev/null)" || return 1
  [ -n "$holder" ] || return 1
  kill -0 "$holder" 2>/dev/null && return 0
  tmux set-option -uw -t "$1" @gl_waiting 2>/dev/null || true  # waiter died; reclaim
  return 1
}

wait_idle() { # $1 = window id, $2 = name, $3 = timeout seconds
  # Idle must hold for two consecutive polls: a just-submitted turn shows no
  # busy marker for a beat, and a single-shot check falls through that gap
  # (observed live — a send landed mid-turn and got queued). A gate is a dead
  # end, not a wait: only the operator clears it, so blocking on it is blocking
  # on a human nobody has told — and worse, a gate drops the busy hint, so a
  # waiter that cannot see it would read the dialog as idle and paste into it.
  local t=0 timeout="${3:-300}" streak=0
  # Marked for the whole wait, so a teammate reading this agent's state while it
  # blocks here sees available rather than busy. Set before the first poll: the
  # window this closes is exactly the one somebody else is looking in.
  park_self
  while :; do
    if gated "$1"; then
      die "'$2' is gated (hook set) — stopped at a modal only the operator can clear (gang attach)"
    fi
    if busy "$1"; then streak=0; else
      streak=$((streak + 1)); [ "$streak" -ge 2 ] && { unpark; return 0; }
    fi
    [ "$t" -ge "$timeout" ] && die "'$2' still busy after ${timeout}s"
    sleep 2; t=$((t + 2))
  done
}

# --- delivery ---------------------------------------------------------------

landing_zone() { # $1 = window id; the input box, or the whole pane if none is declared
  if declare -F profile_input >/dev/null; then profile_input "$1"
  else capture_joined "$1"; fi
}

# One pane, one writer. A delivery is read-the-box, paste, read-it-again, Enter —
# four steps against a screen anyone else can also write to. Two of them
# interleaved put both messages in the box and submit them as one, with both
# senders told they succeeded; the same collision happens between a send and the
# operator's own hands. Lived it, twice in one afternoon: a patrol nudge merged
# with a lead's send, and an inbound send merged mid-word with what the operator
# was typing.
#
# mkdir, not flock(1): flock is util-linux and a stock macOS ships none, while
# mkdir is atomic on every filesystem worth running on. The holder's pid goes
# inside so a crashed writer's lock is reclaimed instead of blocking the pane
# until someone notices.
LOCK_PATH=""
lock_release() { [ -z "$LOCK_PATH" ] || rm -rf "$LOCK_PATH"; LOCK_PATH=""; }

lock_pane() { # $1 = window id; held until lock_release or this process exits
  local base holder t=0 path err
  base="${GANG_LOCK_DIR:-${XDG_RUNTIME_DIR:-/tmp}/gangline-$(id -u)}"
  err="$(mkdir -p "$base" 2>&1)" \
    || die "cannot create a lock directory at $base — ${err:-unknown error}. Every gang process delivering to a pane must agree on this path, so gang will not quietly pick another: point GANG_LOCK_DIR (or XDG_RUNTIME_DIR) at somewhere writable by ALL of them."
  path="$base/$(printf '%s' "$1" | tr -c 'A-Za-z0-9' '_').lock"
  while :; do
    err="$(mkdir "$path" 2>&1)" && break
    # An existing directory is the ONLY failure that means contention. Anything
    # else — a read-only mount, a denied path — is permanent, and retrying it
    # turns a hard failure into a thirty-second wait that then blames a process
    # which does not exist. Measured: a sandbox mounting /run/user/<uid> read
    # only made every send report contention against an empty lock directory,
    # and a permanent failure wearing a transient message makes the caller retry
    # forever. Asked of the filesystem rather than by matching errno text, which
    # is localised and varies between platforms.
    [ -d "$path" ] \
      || die "cannot take the delivery lock at $path — ${err:-unknown error}. Nothing holds this lock; the path cannot be created at all, so retrying will not help. Point GANG_LOCK_DIR (or XDG_RUNTIME_DIR) at somewhere writable by every gang process that delivers to this pane."
    holder="$(cat "$path/pid" 2>/dev/null)" || holder=""
    if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then
      rm -rf "$path"; continue          # the writer died mid-delivery
    fi
    t=$((t + 1))
    [ "$t" -lt "${GANG_LOCK_WAIT:-150}" ] \
      || die "another gang process has been delivering to $1 for 30s and has not finished — look at it with gang capture before retrying"
    sleep 0.2
  done
  printf '%s' "$$" > "$path/pid"
  LOCK_PATH="$path"
  trap 'on_exit' EXIT
}

composer_settled() { # $1 = window id; nobody is typing into the box right now
  # A static box may hold a draft, ghost text, or nothing, and appending to any
  # of those is safe — inject verifies the change it makes. A box whose contents
  # are MOVING is a human at the keyboard, and a paste into that interleaves
  # mid-word with what they are writing. Two looks, because typing is continuous
  # and a single sample cannot tell a draft from a hand.
  declare -F profile_input >/dev/null || return 0
  local a b
  a="$(profile_input "$1")" || return 0   # no box: other guards own that case
  sleep 0.3
  b="$(profile_input "$1")" || return 0
  [ "$a" = "$b" ]
}

# --- a paste that was never submitted ----------------------------------------
#
# A delivery that fails after the paste has landed leaves its text where the
# paste went: in the target's input box, unsent. That is not a clean failure.
# The next thing that agent types is submitted with somebody else's message
# prepended to it — confirmed in the field, a full envelope sat in an agent's
# prompt waiting for exactly that.
#
# The obvious repair is a trap. Clearing the box means sending a keystroke, and
# the paths that strand text are mostly the paths where a modal owns the box —
# where a keystroke is an ANSWER to the dialog, which is precisely what the
# withheld Enter refused to send. So gang clears only where it can prove both
# halves: the composer is live and settled, and the box still holds exactly what
# gang put there. Everywhere else the paste is RECORDED on the target window,
# read out by status, roster and patrol, and cleared by the first delivery or
# sweep that can see the box again.
#
# The record is a window option, so it is exactly as long-lived as the agent it
# describes and tmux is the one that deletes it (Law 1, Law 6) — and it has a
# deletion path that does not need a modal to lift, because a box that reads back
# empty proves the text is gone whoever removed it.

staged_note() { # $1 = window id -> what gang knows about an unsubmitted paste there
  tmux show-options -wqv -t "$1" @gl_staged
}

stage_record() { # $1 = window id, $2 = the note, $3 = box rendering to match (may be empty)
  # Only for a profile that declares an input box: without one "the box" is the
  # whole pane, nothing about it can be matched or cleared, and a record nobody
  # can act on is noise on every roster from here on.
  declare -F profile_input >/dev/null || return 0
  tmux set-option -w -t "$1" @gl_staged "$2"
  if [ -n "$3" ]; then tmux set-option -w -t "$1" @gl_staged_box "$3"
  else tmux set-option -uw -t "$1" @gl_staged_box 2>/dev/null || true; fi
}

stage_forget() { # $1 = window id
  tmux set-option -uw -t "$1" @gl_staged 2>/dev/null || true
  tmux set-option -uw -t "$1" @gl_staged_box 2>/dev/null || true
}

clear_box() { # $1 = window id; erase the input box, and prove it is erased
  # C-u is the line kill every readline-shaped composer honours, and a hardcoded
  # default whose outcome is verified beats an extension point no profile sets.
  # Sent only where the composer is provably live — into a modal this keystroke
  # is an answer — and the box is read back afterwards, because a harness that
  # ignores it must not be reported as cleared. The day one turns up, the key
  # becomes a profile declaration (Law 4); the read-back is what will say so.
  declare -F profile_input >/dev/null || return 1
  tmux send-keys -t "$1" C-u
  sleep 0.4
  input_clear "$1"
}

stage_clear() { # $1 = window id; drop a recorded paste once it is provably ours and reachable
  local note box want
  note="$(staged_note "$1")"
  [ -n "$note" ] || return 0
  if gated "$1"; then return 0; fi          # a keystroke here would answer the dialog
  composer_settled "$1" || return 0         # somebody is typing: not gang's box to touch
  box="$(landing_zone "$1")" || return 0    # cannot see it: the record stands
  if ! printf '%s' "$box" | grep -q '[^[:space:]]'; then
    stage_forget "$1"; return 0             # empty box: whoever cleared it, it is gone
  fi
  want="$(tmux show-options -wqv -t "$1" @gl_staged_box)"
  # Matched, not merely present: by the time the modal lifts the box may hold the
  # operator's own draft, and wiping that to tidy up gang's mess is a worse bug
  # than the one being fixed. A path that never read the box records no rendering
  # and is therefore reported until a human deals with it.
  [ -n "$want" ] && [ "$box" = "$want" ] || return 0
  clear_box "$1" || return 0
  stage_forget "$1"
}

inject() { # $1 = window id, $2 = text; bracketed-paste, verify in pane, submit. Law 3.
  local buf="gang-$$" frag before after
  frag="$(printf '%s' "$2" | head -1 | cut -c1-40)"
  # The one delivery no before/after verification can make safe: while a modal
  # owns the input box, keystrokes are ANSWERS. Checked here at the chokepoint —
  # immediately before the paste — so every path in (send, compact, patrol,
  # hitch, resume) hits it, including a modal that painted after the caller's own
  # earlier check.
  # Taken before the gate check, and held past the Enter: everything below reads
  # the pane and then acts on what it read, so another writer between any two of
  # those steps invalidates the rest.
  lock_pane "$1"
  ! gated "$1" \
    || die "refusing to deliver '$frag': $1 is gated (hook set) — a modal owns its input box, so the paste would land in the dialog instead (gang attach)"
  composer_settled "$1" \
    || die "refusing to deliver '$frag': somebody is typing into $1 right now — the paste would interleave with their draft mid-word (try again in a moment)"
  # Before anything is read or pasted: an earlier delivery that could not be
  # verified may have left its text in this box, and appending to that would
  # submit both as one message. This is the moment the modal that stranded it has
  # demonstrably lifted — the gate check above just passed — so it is also the
  # first moment gang may type into the pane at all.
  stage_clear "$1"
  # Verified = the paste changed the input box, which is where a paste lands.
  # Reading the box asks the profile (Law 4) instead of teaching gang how each
  # TUI draws a collapsed paste, and those renderings agree on nothing: Claude
  # Code writes "[Pasted text #1 +10 lines]", counting lines BEYOND the first,
  # and collapses a long single-line paste to "[Pasted text #2]" with no count
  # at all; Pi writes "[paste #N +13 lines]", counting every line. A short
  # paste stays literal in both. Every one of them is a box that differs from
  # the box before the paste.
  #
  # A CHANGE, not "the box is non-empty": the box may legitimately hold a draft
  # already, and appending to a draft still changes it. Comparing against the
  # box captured BEFORE this paste is also what keeps an identical earlier send
  # sitting in the transcript from vouching for a paste that never landed.
  before="$(landing_zone "$1")" \
    || die "cannot read the input box of $1 — the harness is not taking input"
  # Buffer name is per-process: patrol runs on cron, and a concurrent send would
  # otherwise overwrite the buffer between load-buffer and paste-buffer.
  printf '%s' "$2" | tmux load-buffer -b "$buf" -
  tmux paste-buffer -p -d -b "$buf" -t "$1"
  sleep 0.4
  # The box went unreadable with the paste already in flight, so where the text
  # ended up is genuinely unknown: in the box behind whatever took the screen, or
  # in that thing's own field. Gang cannot see it, so it cannot clear it — it says
  # what it does not know and leaves a record no rendering can be matched against,
  # which is what keeps this one being reported until a human deals with it.
  after="$(landing_zone "$1")" || {
    stage_record "$1" "'$frag' was pasted into this box and the box could not be read afterwards — it may be sitting there unsent" ""
    die "cannot read the input box of $1 after pasting '$frag' — nothing was submitted, and the paste may be sitting unsent in that box (gang capture $1)"
  }
  [ "$after" != "$before" ] \
    || die "delivery NOT verified: pasting '$frag' left the input box unchanged — nothing was submitted"
  # Enter goes as its own keystroke, and then gets checked, because the failure
  # it guards against is silent and reads exactly like success. Batch the text
  # and the Enter into one send-keys and Claude Code takes the burst for a paste
  # and the trailing newline for part of it: the message stays in the box as an
  # unsent draft that scrollback renders identically to a sent one. Submitting
  # empties the box — or, mid-turn, replaces it with the harness's queued-message
  # hint — so a box still holding what we just pasted was never submitted.
  # The gate is checked again here, and this is the check that matters most: the
  # earlier one guards the paste, but Enter is the keystroke that ANSWERS a
  # dialog. A modal can paint in the moment between the paste and this line —
  # that is the whole hazard, an asynchronous dialog against a four-step
  # delivery — and an Enter aimed at a composer that is no longer there selects
  # whatever the dialog has highlighted. Nothing is submitted, and the paste stays
  # in the box behind the modal: not a clean failure, a loaded one. The box was
  # read a line ago, so this is the path that can hand a rendering to the record —
  # the next send or patrol after the modal lifts clears it on that evidence.
  if gated "$1"; then
    stage_record "$1" "'$frag' is staged unsent in this box — a modal took the screen before the Enter could be sent" "$after"
    die "refusing to submit '$frag': a modal took the screen of $1 while the paste was landing — the Enter that would have answered it was not sent, so the paste is staged unsent in that box (gang attach; gang clears it on the next send or patrol once the modal is gone)"
  fi
  tmux send-keys -t "$1" Enter
  # An unreadable box in the moments after Enter is not a failed submit — it is
  # the submit in flight. opencode's box is only "readable" while the hardware
  # cursor sits in it, and the cursor leaves while the accepted message is
  # repainted into the transcript: the check that confirms submission fails
  # precisely BECAUSE submission is happening. One bad sample is therefore not a
  # verdict, it just buys another look.
  #
  # The two failures stay on separate counters because they are different
  # accusations. A box that reads back unchanged is positive evidence the text
  # never went — it keeps the five looks it has always had, so nothing about
  # that verdict loosens here. Unreadable is an absence of evidence, and only
  # the wider budget running out escalates it to "I could not tell".
  local unchanged=0 looks=0 posted
  while :; do
    sleep 0.4
    if posted="$(landing_zone "$1")"; then
      [ "$posted" = "$after" ] || break
      unchanged=$((unchanged + 1))
      if [ "$unchanged" -ge 5 ]; then
        # The one path where both halves are provable without waiting for
        # anything: the box reads back, which is only true while the composer
        # owns the screen, and it reads back as exactly what gang pasted. So the
        # text goes out the way it came in rather than being left for whatever
        # this agent types next. The clear is verified too — a harness that
        # ignores the keystroke is told about, not reported as tidy.
        if clear_box "$1"; then
          die "submit NOT verified: '$frag' was pasted into the input box of $1 and never sent — the paste has been cleared back out of that box"
        fi
        stage_record "$1" "'$frag' is staged unsent in this box — it was pasted, never sent, and would not clear" "$posted"
        die "submit NOT verified: '$frag' was pasted into the input box of $1, never sent, and would not clear — it is staged there now and has to be cleared by hand (gang attach)"
      fi
    fi
    looks=$((looks + 1))
    if [ "$looks" -ge 15 ]; then
      # Unlike the branch above this is an absence of evidence both ways: the
      # Enter went, and a box that never reads back cannot say whether it took.
      # opencode's box reads this way precisely BECAUSE a submit is happening, so
      # the record is worded as the doubt it is — and it costs nothing when the
      # send did land, because the first sweep that finds the box empty drops it.
      stage_record "$1" "'$frag' was pasted here and Enter sent, but the box never read back — it may be sitting there unsent" ""
      die "cannot read the input box of $1 after Enter — submission unverifiable (15 looks over 6s); if the Enter never took, the paste is sitting unsent in that box (gang capture $1)"
    fi
  done
  lock_release
}

resume_after_compaction() { # $1 = window id, $2 = text; deliver where it cannot overtake
  # A resume cannot ride the input queue behind its own compaction. Both are typed
  # from inside a live turn, and a harness does not treat the two alike: a queued
  # slash command waits for the turn to genuinely end, while queued text can be
  # handed straight to the turn already running. The text overtakes the command,
  # gets eaten by the very turn that was about to be compacted, and the agent wakes
  # up afterwards with nothing to pick up. Lived it. So the resume goes in later,
  # delivered by the only thing still around to do it.
  #
  # Later has two moments and the earlier one is better. Once compaction is visibly
  # RUNNING, the turn that could have eaten the resume is over and the turn now in
  # flight reads no input: the message can only wait, which is all it ever needed
  # to do. So it goes in immediately and sits in the queue the compaction drains on
  # its way out — the agent picks it up the instant it has a context to pick it up
  # into, instead of after a waiter has finished convincing itself the screen has
  # stopped moving.
  #
  # A profile that has not had its compaction watched live declares no marker and
  # waits for quiet instead. There the floor matters as much as the streak: between
  # a turn ending and the compact command starting to paint there is a sub-second
  # window where the pane is neither busy nor compacting, and a waiter that fires
  # in it queues the resume AHEAD of the compaction it exists to follow — the same
  # inversion, rebuilt. Three quiet polls plus a screen that stops moving costs six
  # seconds; no compaction finishes that fast and no flush gap lasts that long.
  #
  # The two are a race with no losing branch. A compaction briefer than a poll
  # interval is simply missed, and quiet then means what it has always meant.
  #
  # The settle path alone is weaker than it reads. Its streak resets on
  # busy_painted, which is false for most of a turn, so it is a one-time FLOOR
  # rather than sustained quiet: after about sixteen seconds it fires at the
  # first still frame. Streaming is not the exposure, because streaming moves the
  # screen — SILENCE is, and a test run, a fetch or a large read is exactly that.
  # The resume then rides ahead of the queued compaction and is eaten by the turn
  # it was supposed to follow.
  #
  # So where gang issued the compaction itself it waits for proof instead: the
  # context DROPPING below where it stood when the command was typed. That is
  # later than visibly-running and still safe, because a compaction reads no
  # input, and unlike a still screen it cannot be true of a turn that is merely
  # quiet.
  local t=0 streak=0 timeout="${GANG_RESUME_TIMEOUT:-900}"
  local at_issue="" mark ctx tw tokens window
  # Read ONCE, here. compaction_pending CLEARS the mark the moment it sees the
  # drop and patrol polls it too, so whichever poller gets there first takes the
  # value away from the other. This must not depend on the mark still existing
  # when it looks, so it keeps its own copy and polls the context itself.
  mark="$(tmux show-options -wqv -t "$1" @gl_compacting 2>/dev/null)" || mark=""
  case "$mark" in
    *' '*) at_issue="${mark##* }" ;;
  esac
  [[ "$at_issue" =~ ^[0-9]+$ ]] && [ "$at_issue" -gt 0 ] || at_issue=""
  declare -F profile_context >/dev/null || at_issue=""
  while [ "$t" -lt "$timeout" ]; do
    sleep 2; t=$((t + 2))
    compacting "$1" && break
    if [ -n "$at_issue" ]; then
      if [ "$t" -ge "$GANG_COMPACT_GRACE" ]; then
        # The drop never came, so the compaction never happened: `/compact` under
        # a harness's own threshold runs and leaves the context exactly where it
        # was (measured). Fall back rather than hold the resume for the whole
        # timeout over a compaction that was never going to occur.
        #
        # The residual is named rather than left for a reader to wonder about,
        # because the settle path's weakness two paragraphs up does not stop
        # applying here: a turn that has been SILENT since the mark was set can
        # still take this resume. Five minutes is not a long turn on this
        # hardware — the suite in this repo runs near four.
        #
        # It is still the better end of the trade, and not because the exposure
        # is small. Without this branch the same message reaches the same silent
        # turn at the timeout anyway, injected with NO checking at all; this path
        # demands three non-busy polls and a still screen first. It moves the
        # moment earlier and makes the attempt better-behaved, and it buys the
        # measured under-threshold case, which otherwise holds for the full
        # fifteen minutes over a compaction that never happened.
        at_issue=""
      else
        if ctx="$(profile_context "$1" 2>/dev/null)" \
           && tw="$(ctx_tokens "${ctx%%$'\n'*}")"; then
          read -r tokens window <<<"$tw"
          if [ "$tokens" -lt $(( at_issue / 2 )) ]; then break; fi
        fi
        continue
      fi
    fi
    [ "$t" -ge 10 ] || continue
    # The pane question: this loop is waiting for a turn to STOP, and it pairs
    # with pane_stable below. Availability is a different thing and not what a
    # resume is allowed to overtake.
    if busy_painted "$1"; then streak=0; continue; fi
    streak=$((streak + 1))
    [ "$streak" -ge 3 ] && pane_stable "$1" && break
  done
  # Out of time still means try, not give up: inject verifies its own delivery, so
  # the attempt either lands or fails, and a failure leaves the agent sitting idle
  # where anyone can see it rather than passing for resumed.
  inject "$1" "$2"
}

# --- context bands ----------------------------------------------------------

ctx_tokens() { # $1 = "<used>k/<win>k (<pct>%)" -> "<used> <window>" in tokens
  [[ "$1" =~ ^([0-9]+)k/([0-9]+)k ]] || return 1
  printf '%s %s' "$(( BASH_REMATCH[1] * 1000 ))" "$(( BASH_REMATCH[2] * 1000 ))"
}

ladder() { # $1 = tokens in context, $2 = window size -> "<bands crossed> <highest>"
  # One evaluator for both warning legs. Two copies of a ladder is two ladders.
  local band=0 crossed=0 part n t
  for part in ${BANDS//,/ }; do
    case "$part" in
      *%) n="${part%\%}"
          [[ "$n" =~ ^[0-9]+$ ]] || die "invalid GANG_CONTEXT_BANDS '$BANDS' — fix the ladder"
          # Floored to 1k, the resolution every context readout reports in: a
          # finer threshold would sit between what the two legs can measure.
          t=$(( n * $2 / 100000 * 1000 )) ;;
      *)  [[ "$part" =~ ^[0-9]+$ ]] || die "invalid GANG_CONTEXT_BANDS '$BANDS' — fix the ladder"
          t="$part" ;;
    esac
    [ "$t" -gt 0 ] || die "invalid GANG_CONTEXT_BANDS '$BANDS' — fix the ladder"
    if [ "$1" -ge "$t" ]; then
      band=$((band + 1))
      [ "$t" -gt "$crossed" ] && crossed="$t"
    fi
  done
  printf '%s %s' "$band" "$crossed"
}

band_note() { # $1 = readout, $2 = crossed threshold, $3 = agent name; one text, both legs
  # The exact command, not "compact soon", because the part an agent gets wrong
  # is the resume — typed in behind the compaction it overtakes it and is eaten
  # by the turn about to be compacted, and the agent wakes with nothing to do.
  printf "[context-usage] %s in context — crossed the %s-token band. At the next checkpoint (arc boundary), run: gang compact %s --from %s --resume '<where you are, what is next>' — it queues behind the turn you are in, and the resume is delivered once compaction settles." \
    "$1" "$2" "$3" "$3"
}

# --- colour -----------------------------------------------------------------
#
# Colour marks state and outcome, never decoration. A roster is scanned rather
# than read, and the four things the eye is looking for are: which agent needs a
# human (red), which is working (amber), which did the thing you asked (green),
# and which line is detail it can skip (dim). Anything that is not one of those
# four stays plain — a tool that colours everything has told you nothing.
#
# Basic 3-bit codes deliberately: they resolve through the terminal's own palette,
# so gang inherits whatever theme the operator already reads comfortably.
#
# Off unless stdout is a terminal, and off whenever NO_COLOR is set
# (https://no-color.org). Every pipe, capture, and test therefore sees the same
# plain text — including gang's own callers, since an agent greps the roster it
# just asked for.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_OK=$'\033[32m' C_WORK=$'\033[33m' C_BAD=$'\033[31m' C_DIM=$'\033[2m' C_OFF=$'\033[0m'
else
  C_OK="" C_WORK="" C_BAD="" C_DIM="" C_OFF=""
fi

colour() { # $1 = colour, $2 = text — already padded to its column width
  # Pad first, colour second, always. printf's %-18s counts bytes, and an escape
  # sequence is nine of them, so colouring before padding eats nine characters of
  # the field and the roster stops lining up.
  printf '%s%s%s' "$1" "$2" "$C_OFF"
}

# --- commands ---------------------------------------------------------------

cmd_hitch() {
  # Profile defaults so the common case needs no flags; GANG_PROFILE moves it.
  local name="" prof="${GANG_PROFILE:-claude-code}" role="" dir="$PWD" model="" id
  name="${1:-}"; case "$name" in ''|-*) usage_die ;; esac; shift
  valid_name "$name" \
    || die "hitch: '$name' is not a usable agent name — letters, digits, dot, dash and underscore only, not starting with a dash or dot. A name is also a tmux target, a JSON string in the context hook's reply, and a word in the compaction command gang suggests"
  while [ $# -gt 0 ]; do case "$1" in
    -p|--profile) [ $# -ge 2 ] || die "hitch: $1 needs a value"; prof="$2"; shift 2 ;;
    -r|--role)    [ $# -ge 2 ] || die "hitch: $1 needs a value"; role="$2"; shift 2 ;;
    -d|--dir)     [ $# -ge 2 ] || die "hitch: $1 needs a value"; dir="$2";  shift 2 ;;
    -m|--model)   [ $# -ge 2 ] || die "hitch: $1 needs a value"; model="$2"; shift 2 ;;
    *) die "hitch: unknown argument '$1'" ;;
  esac; done
  # Resolved before anything is hitched: a typo in the role should not leave a
  # live unbriefed agent behind.
  [ -z "$role" ] || role_file "$role" >/dev/null \
    || die "hitch: unknown role '$role' (have: $(list_roles | tr '\n' ' '))"
  [ -d "$dir" ] || die "hitch: no such directory '$dir'"
  ! test_only_profile "$prof" \
    || die "hitch: '$prof' is a stand-in for gangline's own suite, not a harness to run an agent on (GANG_TEST_PROFILES=1 if you are testing gang itself)"
  load_profile "$prof"
  # A model is one concept every harness spells differently; the profile owns the
  # spelling (GANG_MODEL_OPT), hitch carries the intent. A profile that declares
  # no spelling refuses rather than guessing a flag the harness may not have.
  if [ -n "$model" ]; then
    [ -n "$GANG_MODEL_OPT" ] || die "hitch: profile '$prof' declares no GANG_MODEL_OPT, so it cannot take -m"
    # GANG_LAUNCH is handed to sh by tmux; anything outside this charset would
    # need quoting there, and a model id never does — refuse instead.
    case "$model" in *[!A-Za-z0-9._:/@-]*) die "hitch: model '$model' has characters gang will not paste into a launch line" ;; esac
    GANG_LAUNCH="$GANG_LAUNCH $GANG_MODEL_OPT $model"
  fi

  if ! session_live; then
    id="$(tmux new-session -d -P -F '#{window_id}' -s "$SESSION" -n "$name" -c "$dir" "$GANG_LAUNCH")" \
      || die "could not start session '$SESSION' for '$name'"
  else
    exists "$name" && die "agent '$name' already exists"
    id="$(tmux new-window -d -P -F '#{window_id}' -t "=$SESSION" -n "$name" -c "$dir" "$GANG_LAUNCH")" \
      || die "could not open a window for '$name' in session '$SESSION'"
  fi
  # The id comes from the command that created the window, not from looking the
  # name up afterwards. A lookup that missed left the window running and
  # unregistered — a live agent nobody could address, reported as a failed
  # hitch — and it missed for names tmux and `read` disagree about, like one
  # with a leading space.
  [ -n "$id" ] || die "'$name' never appeared in session '$SESSION'"
  # Window name IS the identity — the app must not rename it out from under us.
  tmux set-option -w -t "$id" automatic-rename off
  tmux set-option -w -t "$id" allow-rename off
  tmux set-option -w -t "$id" @gl_profile "$prof"
  sleep 0.5
  exists "$name" || die "'$name' died at launch (cmd: $GANG_LAUNCH)"
  # A keyed profile gets its marker on EVERY hitch, role or not: the marker is
  # what makes the agent's context readable, and an unreadable agent is invisible
  # to patrol. Minted after the window exists so a failed launch mints nothing.
  local key="" msg=""
  if [ "${GANG_SESSION_KEY:-}" = 1 ]; then
    key="$(mint_key)"
    tmux set-option -w -t "$id" @gl_key "$key"
  fi
  if [ -n "$role" ]; then
    msg="$(role_brief "$role" "$name")"
    [ -n "$key" ] && msg="$msg $(marker_line "$key")"
  elif [ -n "$key" ]; then
    msg="$(marker_line "$key")"
  fi
  echo "$(colour "$C_OK" "hitched $name") ($prof) in $dir $(colour "$C_DIM" "— watch: gang attach")"
  # Readiness is checked whether or not there is a brief to deliver. A role-less
  # hitch used to return right here, reporting success while a first-run dialog
  # owned the screen — and no later surface said so either: a dialog drops the
  # busy hint and the input box, so the agent read idle, sends died on the
  # missing box, and the team stalled on a security prompt nobody was told
  # about. Gang never answers a dialog; what it owes the operator is the loud
  # report that one is up, and the profile's own words for the way past it.
  [ -z "$msg" ] || printf '%s\n' "$(colour "$C_WORK" "waiting for $name to finish booting before briefing it...")"
  # `|| ready=$?` keeps this in a tested context: a bare call would trip errexit
  # on the very return codes the case below exists to report.
  local ready=0
  wait_ready "$id" "${GANG_BOOT_TIMEOUT:-30}" || ready=$?
  case "$ready" in
    0) ;;
    2) # Settled screen, no input box: nearly always a dialog only a human may
       # answer. With a brief pending that is a failed hitch — the brief went
       # nowhere. Without one the hitch itself is done, so the same discovery is
       # a warning: the window is real, registered, and waiting on the operator.
       if [ -n "$msg" ]; then
         die "'$name' is up but is showing something other than its input box, so its hitch message was not delivered — most likely a first-run prompt waiting on you. Answer it with 'gang attach', then 'gang drop $name' and hitch again."
       fi
       printf '%s\n' "$(colour "$C_BAD" "hitched, but a dialog owns ${name}'s screen — answer it with 'gang attach'; deliveries are refused until you do")"
       return 0 ;;
    *) if [ -n "$msg" ]; then
         die "'$name' is running but never went quiet, so its hitch message was not delivered — look at it with 'gang attach' or 'gang capture $name'"
       fi
       printf '%s\n' "$(colour "$C_BAD" "hitched, but $name never went quiet — look at it with 'gang capture $name'")"
       return 0 ;;
  esac
  [ -n "$msg" ] || return 0
  inject "$id" "$(envelope hitch "$msg")"
  # Delivered is not actionable. A brief tells the agent to DO something — read
  # its role file, look at a directory — and doing it can trip a permission gate
  # the harness raises as a modal. The pane then holds a dialog only the operator
  # can answer, the work never starts, and the caller was told it was briefed.
  # That cost a review team its whole scope once: three agents briefed, three
  # successes reported, no reviews.
  #
  # It is a RACE and not a proof — the agent has to reach the tool call before
  # this looks — so the two directions are not symmetric. Gated shortly after
  # briefing is evidence the brief cannot be acted on. NOT gated is no evidence
  # that it can, which is why the success line claims delivery and the quiet
  # window, and nothing beyond them.
  local settle="${GANG_BRIEF_GATE_WAIT:-3}"
  if [ -n "${GANG_GATED_REGEX:-}" ] || declare -F profile_input >/dev/null; then
    sleep "$settle"
    if gated "$id"; then
      # The exit code is the point. A caller scripting a fan-out reads $?, not
      # prose, so however this is worded it must not exit 0.
      printf '%s\n' "$(colour "$C_BAD" "briefed $name, but a dialog owns its screen within ${settle}s — the brief was delivered and cannot be acted on. Answer it with 'gang attach'")" >&2
      return 1
    fi
  fi
  if [ -n "$role" ]; then
    printf '%s\n' "$(colour "$C_OK" "briefed $name as $role") $(colour "$C_DIM" "(delivered; no gate within ${settle}s — not proof it can act on it)")"
  else printf '%s\n' "$(colour "$C_OK" "delivered session marker to $name")"; fi
}

cmd_up() { # bare `gang up` is the whole setup: a briefed lead, and you in it
  local name="lead" id a role_given=0
  case "${1:-}" in ''|-*) ;; *) name="$1"; shift ;; esac
  for a in "$@"; do case "$a" in -r|--role) role_given=1 ;; esac; done
  if [ "$role_given" -eq 1 ]; then
    cmd_hitch "$name" "$@"
  else
    cmd_hitch "$name" -r "${GANG_ROLE:-lead}" "$@"
  fi
  id="$(win_id "$name")" || die "up: '$name' vanished between hitch and attach"
  # Inside tmux, switch the client instead of refusing: needing to detach first
  # is friction for the one command that is supposed to need nothing.
  if [ -n "${TMUX:-}" ]; then
    exec tmux switch-client -t "=$SESSION" \; select-window -t "$id"
  fi
  exec tmux attach -t "=$SESSION" \; select-window -t "$id"
}

cmd_send() {
  local name="" from="${GANG_FROM:-}" wait=0 timeout=300
  name="${1:-}"; [ -n "$name" ] || usage_die; shift
  while [ $# -gt 0 ]; do case "$1" in
    --from)    [ $# -ge 2 ] || die "send: $1 needs a value"; from="$2"; shift 2 ;;
    --timeout) [ $# -ge 2 ] || die "send: $1 needs a value"
               # An unchecked value turned the bound into an unbounded loop: the
               # comparison sits inside an && condition, so its "integer
               # expression expected" never trips errexit and the deadline is
               # never reached.
               case "$2" in ''|*[!0-9]*) die "send: --timeout takes whole seconds, got '$2'" ;; esac
               timeout="$2"; shift 2 ;;
    -w|--wait) wait=1; shift ;;
    *) break ;;
  esac; done
  [ $# -gt 0 ] || die "send: empty message"
  [ -n "$from" ] || die "send: identity required (--from <sender> or GANG_FROM) — unattributed injection is how the last harness died"
  check_sender "$from"
  resolve "$name"

  # Gated beats busy: a gate paints mid-turn, and the mid-turn refusal below
  # would point at --wait, which cannot end a state only the operator can end.
  ! gated "$AGENT_ID" \
    || die "'$name' is gated (hook set) — a modal owns its input box and only the operator can clear it; a send would answer the dialog instead of landing (gang attach)"

  # Busy is not, by itself, a reason to refuse. The question a send has to answer
  # is "will this message be delivered?", and gang measures that directly, in the
  # pane, before and after — a state guess is a worse answer than a measurement.
  # What busy genuinely decides is where the keystrokes LAND: a harness that takes
  # input during a turn puts the paste in its input box, while one that does not
  # hands it to whatever that turn is running. So the profile declares which it is
  # and only the second case is refused. Refusing the first is what made a busy
  # lead a black hole and made --wait burn a worker's whole turn waiting on one
  # that never went idle.
  local midturn=0
  if busy "$AGENT_ID"; then
    if [ "$wait" -eq 1 ]; then
      wait_idle "$AGENT_ID" "$name" "$timeout"
    elif [ "${GANG_MIDTURN_INPUT:-}" = 1 ]; then
      midturn=1
    else
      die "'$name' is mid-turn and profile '$AGENT_PROFILE' does not declare mid-turn input — the paste would land in whatever it is running (gang send $name --wait ... to block until idle)"
    fi
  elif [ "${GANG_MIDTURN_INPUT:-}" = 1 ] && parked "$AGENT_ID"; then
    # Parked in gang's own wait. busy() just called it available, and for the
    # refusal above that is the right answer — but the harness is still inside a
    # turn, so the paste queues in its box exactly as it would for an agent doing
    # work. Report what the pane did, not what availability implies; these two
    # answers diverge here and nowhere else.
    midturn=1
  fi
  inject "$AGENT_ID" "$(envelope "$from" "$*")"
  if [ "$midturn" -eq 1 ]; then
    # "accepted", not "queued": the box shows a queued-message hint either way,
    # but what the harness does next is its own call — Claude Code hands queued
    # text to the turn already running as often as it holds it for the boundary.
    echo "$(colour "$C_OK" "delivered to $name as [gang:$from]") $(colour "$C_DIM" "(verified in pane, accepted mid-turn)")"
  else
    echo "$(colour "$C_OK" "delivered to $name as [gang:$from]") $(colour "$C_DIM" "(verified in pane, submitted)")"
  fi
}

cmd_compact() { # trigger the harness's own compaction, via its own command
  local name="" from="${GANG_FROM:-}" resume=""
  name="${1:-}"; [ -n "$name" ] || usage_die; shift || true
  while [ $# -gt 0 ]; do case "$1" in
    --resume) [ $# -ge 2 ] || die "compact: $1 needs a value"; resume="$2"; shift 2 ;;
    --from)   [ $# -ge 2 ] || die "compact: $1 needs a value"; from="$2";   shift 2 ;;
    *) die "compact: unknown argument '$1'" ;;
  esac; done
  resolve "$name"
  [ -n "${GANG_COMPACT_CMD:-}" ] || die "profile '$AGENT_PROFILE' declares no compact command"
  if [ -n "$resume" ] && [ -z "$from" ]; then
    die "compact: --resume needs identity (--from <sender> or GANG_FROM) — an unattributed message is an error"
  fi
  [ -z "$resume" ] || check_sender "$from"
  ! gated "$AGENT_ID" \
    || die "'$name' is gated (hook set) — stopped at a modal only the operator can clear (gang attach)"
  # Busy is refused for a peer and expected for yourself. Cutting somebody else's
  # live turn throws away work they are in the middle of — that refusal is about
  # what compaction MEANS, not about whether keystrokes can be delivered, so it
  # stays. The turn standing in your own way is the one that ends the moment this
  # command returns, and an agent is busy by definition while it is deciding to
  # compact: refusing there closed the only path self-compaction has.
  local self=""
  self="$(self_window)" || self=""
  local mine=0; [ -n "$self" ] && [ "$self" = "$AGENT_ID" ] && mine=1
  [ "$mine" -eq 1 ] || ! busy "$AGENT_ID" \
    || die "'$name' is mid-turn; compacting now would cut a live turn (gang wait $name first)"

  inject "$AGENT_ID" "$GANG_COMPACT_CMD"
  # Recorded only after the command verified in the pane: a mark for a compaction
  # that was never typed would hold patrol off a working agent for the whole
  # grace window, which is the failure this is supposed to prevent, aimed the
  # wrong way.
  compaction_mark "$AGENT_ID"
  local where="triggered on $name"
  [ "$mine" -eq 1 ] && where="queued behind your own turn"
  if [ -n "$resume" ]; then
    # The resume is delivered later by a process nobody is watching, and inject
    # can still refuse it: a gate that painted, a window that went away, a paste
    # that would not verify. Both streams went to /dev/null, so that failure was
    # unobservable while the caller had already been told the resume was on its
    # way — an agent woke with nothing to pick up and nothing said why. The
    # verdict is recorded on the window, where status and patrol read it out.
    tmux set-option -uw -t "$AGENT_ID" @gl_resume_failed 2>/dev/null || true
    ( trap '' HUP INT TERM
      err="$(resume_after_compaction "$AGENT_ID" "$(envelope "$from" "$resume")" 2>&1)" \
        || tmux set-option -w -t "$AGENT_ID" @gl_resume_failed "${err##*$'\n'}"
    ) </dev/null >/dev/null 2>&1 &
    disown
    echo "$(colour "$C_OK" "compaction $where") $(colour "$C_DIM" "($GANG_COMPACT_CMD, verified in pane); resume queued as [gang:$from] for when compaction settles — gang status $name says so if it never lands")"
  else
    echo "$(colour "$C_OK" "compaction $where") $(colour "$C_DIM" "($GANG_COMPACT_CMD, verified in pane)")"
  fi
}

state_now() { # $1 = window id, profile loaded -> the state, in words
  # One namer for `status` and the roster column, so the two cannot answer the
  # same question differently — and renaming a state is one edit, not two. $2 is
  # a churn verdict a batch already resolved; the vocabulary stays here either
  # way, so batching changes what it costs to answer and never what it says.
  if gated "$1"; then echo "gated (hook set)"
  elif busy "$1" "${2:-}"; then echo "busy (tight tug)"
  else echo "idle (slack tug)"; fi
}

paint_state() { # $1 = a state phrase, padding and all
  # Matches on the phrase state_now just built, so the two live side by side:
  # renaming a state means seeing this. The fallback is idle's green, which makes
  # a missed rename a wrong colour rather than a wrong state.
  case "$1" in
    gated*) colour "$C_BAD"  "$1" ;;
    busy*)  colour "$C_WORK" "$1" ;;
    *)      colour "$C_OK"   "$1" ;;
  esac
}

cmd_status() {
  resolve "$1"
  # Named into a variable first, not nested inside the printf argument. A pane gang
  # cannot read makes state_now die, and the exit status of a substitution that sits
  # in an argument list is thrown away — printf would succeed, print a blank line,
  # and report exit 0 for a state nobody ever established. An assignment carries the
  # failure, so errexit still ends the command (law 8).
  local state failed staged
  state="$(state_now "$AGENT_ID")"
  printf '%s\n' "$(paint_state "$state")"
  # A resume that never landed is the one thing about an agent that its screen
  # cannot show: it is the absence of a message. Scripts keep matching the state
  # prefix on line one.
  failed="$(tmux show-options -wqv -t "$AGENT_ID" @gl_resume_failed)"
  [ -z "$failed" ] \
    || printf '%s\n' "$(colour "$C_BAD" "resume NOT delivered after compaction: $failed")"
  # A staged paste IS on the screen, but it reads as a message this agent is
  # about to send rather than one somebody else abandoned in its box, and the
  # damage is done by whoever types next.
  staged="$(staged_note "$AGENT_ID")"
  [ -z "$staged" ] \
    || printf '%s\n' "$(colour "$C_BAD" "undelivered paste in the input box: $staged")"
}

cmd_context() { # context-window usage via the profile's own introspection
  local name="${1:-}"; [ -n "$name" ] || usage_die
  resolve "$name"
  declare -F profile_context >/dev/null \
    || die "profile '$AGENT_PROFILE' declares no context introspection"
  profile_context "$AGENT_ID"
}

cmd_roster() {
  session_live \
    || { printf '%s\n' "$(colour "$C_DIM" "no team (session '$SESSION' not running)")"; return; }
  local id name wins
  wins="$(tmux list-windows -t "=$SESSION" -F '#{window_id} #W')"
  # One wait for the whole team rather than one per agent.
  churn_batch $(printf '%s\n' "$wins" | awk '{print $1}')
  while read -r id name; do
    [ -n "$id" ] || continue
    ( roster_row "$id" "$name" "$(churn_verdict "$id")" ) || true   # one sick agent must not blank the roster
  done <<EOF
$wins
EOF
}

roster_row() { # $1 = window id, $2 = name, $3 = churn verdict if a batch resolved it;
               # subshell — a death here costs one row
  local prof state ctx="-"
  prof="$(tmux show-options -wqv -t "$1" @gl_profile)"
  [ -n "$prof" ] || { printf '%-16s %-12s %-18s %s\n' "$2" "-" "-" \
                        "$(colour "$C_DIM" "unadopted")"; return; }
  # A profile gang cannot resolve is reported, never dropped: patrol runs from
  # cron, where the GANG_PROFILES that hitched this agent is not in the
  # environment, and an agent missing from the roster reads as no agent at all.
  profile_file "$prof" >/dev/null \
    || { printf '%-16s %-12s %-18s %s\n' "$2" "$prof" "-" \
           "$(colour "$C_BAD" "profile not found (GANG_PROFILES?)")"; return; }
  load_profile "$prof"
  state="$(state_now "$1" "${3:-}")"
  # context column is best-effort observation; the dedicated command dies loud
  if declare -F profile_context >/dev/null; then
    ctx="$(profile_context "$1" 2>/dev/null)" || ctx="-"
  fi
  ctx="${ctx%%$'\n'*}"
  # The roster is the surface a lead scans, so an abandoned paste sitting in
  # somebody's box belongs on it — three words, because the sentence explaining
  # it is what gang status is for.
  [ -z "$(staged_note "$1")" ] || ctx="$ctx $(colour "$C_BAD" "undelivered paste")"
  printf '%-16s %-12s %s %s\n' "$2" "$prof" \
    "$(paint_state "$(printf '%-18s' "$state")")" "$ctx"
}

say() { # $1 = name, $2 = context readout, $3 = verdict, $4 = colour (default: dim)
  # Dim by default because most of a sweep is "nothing to do here"; a caller with
  # something worth an operator's eye passes the colour that says so.
  printf '%-16s %-18s %s\n' "$1" "$2" "$(colour "${4:-$C_DIM}" "$3")"
}

cmd_patrol() { # ambient warning leg: nudge any agent past a context band
  # context-hook covers harnesses whose hook system can call gang in-turn;
  # patrol covers the rest (Pi's model never sees its own status bar). Both
  # read the same profile readout, run the same ladder, and share the same
  # @gl_band memory, so whichever notices a crossing first advances the band
  # and the other reports steady — one note per band, never two.
  #
  # Band memory is a window option: exactly as long-lived as the agent, so a
  # re-hitched name starts clean and tmux is the one that deletes it (Law 1,
  # Law 6 — no cleanup code, no state outliving its subject). Warn, don't act —
  # compaction timing is the agent's judgment (gang compact exists to force it).
  session_live \
    || { printf '%s\n' "$(colour "$C_DIM" "no team (session '$SESSION' not running)")"; return; }
  ladder 0 200000 >/dev/null   # one loud complaint about a bad ladder, not one per agent
  local id name
  while read -r id name; do
    ( patrol_one "$id" "$name" ) || true
  done < <(tmux list-windows -t "=$SESSION" -F '#{window_id} #W')
}

patrol_one() { # $1 = window id, $2 = name; subshell — a death here skips this agent,
               # not the sweep, and advances no state, so the next sweep retries.
  local prof ctx tw tokens window band crossed prev failed
  failed="$(tmux show-options -wqv -t "$1" @gl_resume_failed)"
  [ -z "$failed" ] \
    || say "$2" "-" "RESUME NOT DELIVERED after compaction — $failed" "$C_BAD"
  prof="$(tmux show-options -wqv -t "$1" @gl_profile)"
  [ -n "$prof" ] || { say "$2" "" "unadopted — not patrolled"; return; }
  profile_file "$prof" >/dev/null \
    || { say "$2" "" "profile '$prof' not found (GANG_PROFILES?) — not patrolled" "$C_BAD"; return; }
  load_profile "$prof"
  # The sweep is the other half of the staged-paste record: a send may never come
  # for this agent, and patrol is what runs anyway. Clearing is attempted first —
  # it refuses on its own account if the modal is still up — so the report below
  # is about what actually survived, not what was true a second ago.
  if [ -n "$(staged_note "$1")" ]; then
    stage_clear "$1"
    if [ -n "$(staged_note "$1")" ]; then
      say "$2" "-" "UNDELIVERED PASTE — $(staged_note "$1") (gang attach)" "$C_BAD"
    else
      say "$2" "-" "cleared an undelivered paste out of the input box" "$C_OK"
    fi
  fi
  if gated "$1"; then
    # Only the operator clears a gate, so this is a report, not a nudge — and it
    # comes before the context checks so a gated agent whose readout is missing
    # still reads loud rather than skipped.
    say "$2" "-" "GATED (hook set) — a modal owns the input box and is waiting on the operator (gang attach)" \
      "$C_BAD"
    return
  fi
  declare -F profile_context >/dev/null \
    || { say "$2" "" "profile declares no context readout — not patrolled"; return; }
  ctx="$(profile_context "$1" 2>/dev/null)" \
    || { say "$2" "" "no context readout — not patrolled (beacon missing?)" "$C_BAD"; return; }
  ctx="${ctx%%$'\n'*}"
  tw="$(ctx_tokens "$ctx")" \
    || { say "$2" "$ctx" "unparseable readout — not patrolled" "$C_BAD"; return; }
  read -r tokens window <<<"$tw"
  read -r band crossed <<<"$(ladder "$tokens" "$window")"
  prev="$(tmux show-options -wqv -t "$1" @gl_band)" || prev=0
  [[ "$prev" =~ ^[0-9]+$ ]] || prev=0

  # Injecting into a pane that is not quietly idle corrupts it, so every guard
  # below skips rather than risks it — and a skip never burns state.
  if [ "$band" -lt "$prev" ]; then
    tmux set-option -w -t "$1" @gl_band "$band"
    say "$2" "$ctx" "re-armed (usage dropped)"
  elif [ "$band" -eq "$prev" ]; then
    say "$2" "$ctx" "steady (band $band)"
  elif compaction_pending "$1" "$tokens"; then
    # Asked before the scraped guards because it is the one signal here that
    # cannot rot, and because the pane it protects reads perfectly idle: a
    # compacting claude-code pane paints no marker and holds a still screen, so
    # busy_painted and pane_stable both wave a nudge straight through it.
    say "$2" "$ctx" "past the ${crossed}-token band — compaction gang issued is in flight, holding nudge" "$C_WORK"
  elif busy_painted "$1"; then
    # Also the pane question, for the same reason as the guards around it: this
    # chain decides whether an injection is SAFE, and a parked agent is inside a
    # live turn however available it is. Holding costs one sweep.
    say "$2" "$ctx" "past the ${crossed}-token band — busy, retrying next patrol" "$C_WORK"
  elif ! pane_stable "$1"; then
    say "$2" "$ctx" "past the ${crossed}-token band — pane churning (mid-render or compacting), holding nudge" "$C_WORK"
  elif ! input_clear "$1"; then
    # A human draft, ghost-text suggestion, or queued-message hint is in the
    # input box; an injection would interleave with it. Holding costs one sweep.
    say "$2" "$ctx" "past the ${crossed}-token band — input box has content, holding nudge" "$C_WORK"
  else
    inject "$1" "$(envelope patrol "$(band_note "$ctx" "$crossed" "$2")")"
    tmux set-option -w -t "$1" @gl_band "$band"
    say "$2" "$ctx" "NUDGED (crossed the ${crossed}-token band)" "$C_OK"
  fi
}

cmd_context_hook() { # in-turn warning leg: a harness hook calls this from the agent's pane
  # Wire in Claude Code's hooks config as:
  #   {"type": "command", "command": "gang context-hook"}
  # on UserPromptSubmit and PostToolUse. Measures with the same profile readout
  # patrol uses and shares patrol's @gl_band memory, so the two legs cannot both
  # warn about one crossing. Emits one additionalContext note per band. Never
  # blocks a turn: anything it cannot determine is a silent exit 0.
  local event prof ctx tw tokens window band crossed prev
  # The payload is on stdin; the event name is the only field this needs, and it
  # goes straight back out in the reply.
  event="$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("hook_event_name",""))' \
    2>/dev/null)" || exit 0
  [ -n "$event" ] || exit 0
  # TMUX_PANE is inherited by everything the harness spawns inside its pane; no
  # pane means this harness is not a gangline agent and has no band to track.
  [ -n "${TMUX_PANE:-}" ] || exit 0
  prof="$(tmux show-options -wqv -t "$TMUX_PANE" @gl_profile 2>/dev/null)" || exit 0
  [ -n "$prof" ] || exit 0
  load_profile "$prof"
  declare -F profile_context >/dev/null || exit 0
  ctx="$(profile_context "$TMUX_PANE" 2>/dev/null)" || exit 0
  ctx="${ctx%%$'\n'*}"
  tw="$(ctx_tokens "$ctx")" || exit 0
  read -r tokens window <<<"$tw"
  read -r band crossed <<<"$(ladder "$tokens" "$window")"
  prev="$(tmux show-options -wqv -t "$TMUX_PANE" @gl_band)" || prev=0
  [[ "$prev" =~ ^[0-9]+$ ]] || prev=0
  [ "$band" -ne "$prev" ] && tmux set-option -w -t "$TMUX_PANE" @gl_band "$band"
  if [ "$band" -gt "$prev" ]; then
    # Encoded, not interpolated. The note carries an agent name and a context
    # readout, and a printf template that assumes neither ever holds a quote or
    # a backslash emits invalid JSON the moment one does — silently, because the
    # band was advanced above and nothing retries a warning the harness could
    # not parse. python3 is a hard dependency of this command already.
    python3 -c 'import json,sys; print(json.dumps({"hookSpecificOutput":{"hookEventName":sys.argv[1],"additionalContext":sys.argv[2]}}))' \
      "$event" "$(band_note "$ctx" "$crossed" "$(tmux display-message -p -t "$TMUX_PANE" '#W')")"
  fi
  exit 0
}

# --- diagnostics ------------------------------------------------------------

file_rot_issue() { # $1 = profile, $2 = installed version line; dedup by exact title
  command -v gh >/dev/null || die "vet --file-issue: gh CLI not installed"
  local title="strategy rot: $1 markers unverified against $2"
  # Dedup via the plain list endpoint, not --search: the search index is
  # eventually-consistent and misses issues filed seconds ago (observed live —
  # a rerun filed a duplicate).
  if (cd "$ROOT" && gh issue list --state open -L 200 --json title --jq '.[].title') | grep -qxF "$title"; then
    echo "  issue already open: '$title' — not duplicating"
    return 0
  fi
  (cd "$ROOT" && gh issue create --title "$title" --body "\
gang vet detected strategy rot.

- profile: \`profiles/$1.sh\`
- installed harness version: \`$2\`
- verified against: \`$GANG_VERIFIED_VERSIONS\`

The profile's scraped TUI markers (busy regex, context readout, input-box
shape) were verified against the versions listed above, not the installed
one. Re-verify each marker live against the installed TUI, fix what rotted,
and append the new version to GANG_VERIFIED_VERSIONS.")
  echo "  filed rot issue: '$title'"
}

cmd_vet() { # strategy-rot check: installed harness version vs each profile's pins
  # Scraped TUI markers rot silently when a harness updates (lived it: a
  # Claude Code build stopped painting 'esc to interrupt' and busy() false-
  # negatived). Each profile pins the versions its markers were verified
  # against; vet compares and exits nonzero on drift. This is a reactive
  # diagnostic, not a cron job: agents run it when scraping misbehaves
  # (false busy/idle, missing beacon, failed injection verify).
  local file_issue=0
  [ "${1:-}" = "--file-issue" ] && file_issue=1
  local f prof installed v match out drift=0
  # Every profile installed, not just the shipped ones. A profile in GANG_PROFILES
  # is the one whose pins are LEAST likely to be maintained — nobody ships it, so
  # nobody bumps it when a harness updates — and walking $ROOT/profiles alone meant
  # a user's own harness was the single file never checked. Where a name exists in
  # both dirs it appears once and the loaded file is theirs, which is what has been
  # vetted all along: this loop only ever took the NAME from the path, and
  # load_profile has always re-resolved.
  #
  # Deliberately all_profiles and not list_profiles, which hides the test-only
  # stand-ins: that list answers "what may an operator pick", and vet asks "what is
  # installed here that can rot". Routing it through the offered list would have
  # silently stopped vetting bash — a guard lost with nothing printed to say so.
  # Read on fd 3 so a version command or a profile_vet that touches stdin cannot
  # eat the rest of the list.
  while read -r prof <&3; do
    [ -n "$prof" ] || continue
    load_profile "$prof"
    if [ "$GANG_VERIFIED_VERSIONS" = "any" ]; then
      printf '%-12s %-26s %s\n' "$prof" "-" \
        "$(colour "$C_DIM" "version-independent (no scraped markers)")"
    elif [ -z "$GANG_VERSION_CMD" ] || [ -z "$GANG_VERIFIED_VERSIONS" ]; then
      printf '%-12s %-26s %s\n' "$prof" "?" \
        "$(colour "$C_BAD" "UNPINNED — declare GANG_VERSION_CMD + GANG_VERIFIED_VERSIONS")"
      drift=1
    elif ! installed="$($GANG_VERSION_CMD 2>/dev/null | head -1)" || [ -z "$installed" ]; then
      printf '%-12s %-26s %s\n' "$prof" "?" \
        "$(colour "$C_BAD" "version command failed: $GANG_VERSION_CMD")"
      drift=1
    else
      # Matched as a whole word anywhere in the line, not as a prefix: harnesses
      # do not agree on where the number goes. Claude Code leads with it ("2.1.220
      # (Claude Code)"), Codex trails it ("codex-cli 0.144.5"), and a pin cannot
      # carry the name to make a prefix work — GANG_VERIFIED_VERSIONS is
      # space-separated so it can list several. Word boundaries also make the
      # comparison stricter than the prefix it replaces: 0.144.5 no longer matches
      # a hypothetical 0.144.50, and a build suffix has to be pinned to pass.
      match=0
      for v in $GANG_VERIFIED_VERSIONS; do
        case " $installed " in *" $v "*) match=1 ;; esac
      done
      if [ "$match" -eq 1 ]; then
        printf '%-12s %-26s %s\n' "$prof" "$installed" \
          "$(colour "$C_OK" "OK (verified: $GANG_VERIFIED_VERSIONS)")"
      else
        printf '%-12s %-26s %s\n' "$prof" "$installed" \
          "$(colour "$C_BAD" "ROT RISK — markers verified against: $GANG_VERIFIED_VERSIONS")"
        drift=1
        [ "$file_issue" -eq 1 ] && file_rot_issue "$prof" "$installed"
      fi
    fi
    # Which file answered, but only when it is not the obvious one, so the common
    # report does not grow a column of paths that are all the same. vet is what you
    # run when scraping misbehaves, and its own clean-bill hint tells you to shadow
    # the profile via GANG_PROFILES and re-verify — advice you cannot act on if the
    # report will not say whether your shadow was the file it read.
    f="$(profile_file "$prof")"
    if [ "$f" != "$ROOT/profiles/$prof.sh" ]; then
      if [ -f "$ROOT/profiles/$prof.sh" ]; then
        printf '%-12s %-26s %s\n' '' '' "$(colour "$C_DIM" "from $f (shadowing the shipped profile)")"
      else
        printf '%-12s %-26s %s\n' '' '' "$(colour "$C_DIM" "from $f")"
      fi
    fi
    # A profile that reads harness files instead of the screen rots on a schema
    # change, not a TUI change — same disease, different tissue. The profile owns
    # the check (law 4); vet just runs it and counts a failure as drift.
    # Unconditionally: the version probe and the format gate are independent
    # diagnostics, and a host without the harness binary can still hold session
    # files worth gating (lived it: CI has no codex, and the gate silently never
    # ran there).
    if declare -F profile_vet >/dev/null; then
      if out="$(profile_vet 2>&1)"; then
        printf '%-12s %-26s %s\n' '' '' "$(colour "$C_DIM" "file format: $out")"
      else
        printf '%-12s %-26s %s\n' '' '' "$(colour "$C_BAD" "file format: DRIFT — $out")"
        drift=1
      fi
    fi
  done 3<<EOF
$(all_profiles)
EOF
  # Markers are glyphs, and glyphs only match in a UTF-8 locale. gang selects one
  # at startup; a host that offers none scrapes in byte semantics, where a
  # spinner or a progress bar silently stops matching. That is strategy rot with
  # no version change behind it, so it belongs in the same report.
  if ! utf8_locale; then
    printf '%-12s %-26s %s\n' 'locale' "${LC_ALL:-${LC_CTYPE:-${LANG:-C}}}" \
      "$(colour "$C_BAD" "no UTF-8 locale available — multibyte markers cannot match")"
    drift=1
  fi
  # Only on a clean bill, because that is when it is the remaining hypothesis:
  # vet is run when scraping already misbehaves, and pins watch harness
  # versions, which UI mods never move — a theme, a replacement statusline, or a
  # TUI-drawing extension relocates a marker with every row above reading OK.
  [ "$drift" -ne 0 ] \
    || printf '%s\n' "$(colour "$C_DIM" "all pins verified — but pins watch harness versions, which UI mods never move. Scraping misbehaving anyway? A theme, statusline, or TUI extension may have moved a marker: shadow the profile via GANG_PROFILES and re-verify against the TUI as you actually run it (README: Strategy rot).")"
  return "$drift"
}

cmd_capture() { # trailing blank pane rows are dead space, not content
  local id
  id="$(win_id "$1")" || die "no window '$1' in session '$SESSION'"
  capture "$id" | awk 'NF{last=NR} {line[NR]=$0} END{for(i=1;i<=last;i++) print line[i]}' | tail -n "${2:-40}"
}

cmd_adopt() { # register an EXISTING tmux window as a gang agent
  local name="" prof="" id
  name="${1:-}"; case "$name" in ''|-*) usage_die ;; esac; shift
  valid_name "$name" \
    || die "adopt: '$name' is not a usable agent name — letters, digits, dot, dash and underscore only. Rename the window first (tmux rename-window)"
  while [ $# -gt 0 ]; do case "$1" in
    -p|--profile) [ $# -ge 2 ] || die "adopt: $1 needs a value"; prof="$2"; shift 2 ;;
    *) die "adopt: unknown argument '$1'" ;;
  esac; done
  [ -n "$prof" ] || die "adopt: -p <profile> is required"
  ! test_only_profile "$prof" \
    || die "adopt: '$prof' is a stand-in for gangline's own suite, not a harness to run an agent on (GANG_TEST_PROFILES=1 if you are testing gang itself)"
  load_profile "$prof"
  id="$(win_id "$name")" || die "no window '$name' in session '$SESSION' to adopt"
  tmux set-option -w -t "$id" automatic-rename off
  tmux set-option -w -t "$id" allow-rename off
  tmux set-option -w -t "$id" @gl_profile "$prof"
  printf '%s\n' "$(colour "$C_OK" "adopted $name as a $prof agent")"
}

cmd_drop() {
  local id
  id="$(win_id "$1")" || die "no agent '$1'"
  tmux kill-window -t "$id"
  printf '%s\n' "$(colour "$C_OK" "dropped $1")"
}

cmd_down() { # inverse of up: end the whole team's session
  # No state to sweep: band memory is a window option, so tmux deletes it along
  # with the windows it belongs to.
  session_live || die "no session '$SESSION' running"
  echo "$(colour "$C_OK" "ending '$SESSION':") $(colour "$C_DIM" "$(tmux list-windows -t "=$SESSION" -F '#W' | tr '\n' ' ')")"
  tmux kill-session -t "=$SESSION"
}

cmd_attach() { exec tmux attach -t "=$SESSION"; }

cmd_profiles() { list_profiles; }

# --- dispatch ---------------------------------------------------------------

cmd="${1:-}"; [ -n "$cmd" ] || usage_die; shift || true
case "$cmd" in
  up)       cmd_up "$@" ;;
  hitch|spawn) cmd_hitch "$@" ;;
  adopt)    cmd_adopt "$@" ;;
  send)     cmd_send "$@" ;;
  compact)  cmd_compact "$@" ;;
  status)   [ $# -ge 1 ] || usage_die; cmd_status "$1" ;;
  context)  cmd_context "$@" ;;
  context-hook) cmd_context_hook ;;
  wait)     [ $# -ge 1 ] || usage_die
            case "${2:-300}" in ''|*[!0-9]*) die "wait: timeout takes whole seconds, got '${2:-}'" ;; esac
            resolve "$1"; wait_idle "$AGENT_ID" "$1" "${2:-300}"; echo "idle (slack tug)" ;;
  capture)  [ $# -ge 1 ] || usage_die; cmd_capture "$@" ;;
  roster)   cmd_roster ;;
  patrol)   cmd_patrol ;;
  vet|doctor) cmd_vet "$@" ;;
  attach)   cmd_attach ;;
  drop)     [ $# -ge 1 ] || usage_die; cmd_drop "$1" ;;
  down)     cmd_down ;;
  profiles) cmd_profiles ;;
  roles)    list_roles ;;
  -h|--help|help) usage ;;
  *) die "unknown command '$cmd' (gang --help for usage)" ;;
esac
