#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# gang — gangline: drive a team of CLI agents as tmux windows.
# Laws: CONSTITUTION.md. Transport decision: docs/adr/0001-tmux-is-the-substrate.md
set -euo pipefail

# Named rather than written inline, because the crontab reader below has to work
# out which session an entry sweeps and an entry that names none sweeps this one.
# A default spelled in two places is a default that eventually disagrees.
DEFAULT_SESSION=gangline
SESSION="${GANG_SESSION:-$DEFAULT_SESSION}"

# Every marker gang matches is a glyph a TUI painted: spinners, progress-bar
# segments, menu cursors. Matching them means nothing outside a UTF-8 locale —
# under LC_ALL=C a bracket expression matches single BYTES and `[^ ]` eats one
# third of a spinner glyph, so "✽ Generating…" stops matching the busy pattern
# written for it and a live turn reads idle. cron runs in C. Rather than harden
# every regex in every profile against byte semantics, gang states the
# requirement it always had and satisfies it here, once. An environment that
# already names a UTF-8 locale is left exactly as it is.
utf8_locale() {
  case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
    *[Uu][Tt][Ff]8*|*[Uu][Tt][Ff]-8*) return 0 ;;
  esac
  local avail l
  avail="$(locale -a 2>/dev/null)" || return 1
  for l in C.UTF-8 C.utf8 en_US.UTF-8 en_US.utf8; do
    case "$avail" in *"$l"*) export LC_ALL="$l"; return 0 ;; esac
  done
  return 1
}
# Non-fatal: a host with no UTF-8 locale can still hitch, send, and drop — it is
# only marker matching that degrades, and gang vet reports the degradation
# rather than every command refusing to run.
utf8_locale || true

die() { fail 1 "$@"; }

# A refusal that typed NOTHING into the pane, exiting 3 so a caller can tell it
# from a failure that may have left keystrokes behind. That distinction is the
# only safe basis for retrying a delivery: "the wording sounds transient" is a
# guess about prose, while "nothing was typed" is a property of the code path,
# and re-running a delivery that got as far as the paste can submit the same
# message twice. So this is for the checks BEFORE the first keystroke only —
# everything downstream of `paste-buffer` dies on 1 however recoverable it reads.
#
# The implication runs ONE WAY and the asymmetry is deliberate. 3 always means
# nothing was typed; 1 does not mean something was. Plenty of refusals that never
# reach a pane still exit 1 — cmd_send refuses an occupied target itself rather
# than leaving it to a delivery, so an ordinary send to an occupied agent is a 1
# for a keystroke that was never sent, whether that occupancy was found before the
# delivery or handed back by one. Converting those would make the converse true
# and buys nothing: the consumers are the delivery waiters, which call inject
# directly, and a retry rule needs "safe to repeat" to be provable, not
# exhaustive. Reading 1 as proof that something was typed is the mistake this
# paragraph exists to prevent.
refuse() { fail 3 "$@"; }

fail() { # $1 = exit status, rest = message
  local code="$1"; shift
  # stderr gets its own terminal test. `gang roster 2>/dev/null | grep ...` is the
  # ordinary shape in a script, and there stdout is a pipe while stderr is still a
  # terminal — one test for both fds would drop the colour from the one line that
  # most wants it.
  if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
    printf '\033[31mgang:\033[0m %s\n' "$*" >&2
  else
    printf 'gang: %s\n' "$*" >&2
  fi
  exit "$code"
}

# Every numeric knob in this file is read from an environment gang does not own,
# and a value that is not a number does not fail alike everywhere it lands.
#
# `[ "$t" -lt "$timeout" ]` against a non-numeric bound writes "integer expression
# expected" and exits 2 — and a FAILING condition on a `while` does not trip
# errexit, so the loop never runs and execution continues past it as though the
# wait were over. Most of these then merely lie: a lock refusal claims thirty
# seconds of contention that never happened, a boot timeout reports a dialog
# nobody saw. GANG_RESUME_TIMEOUT is the one that lands somewhere corrupting —
# skipping that loop delivers the resume instantly, which is the overtaking the
# whole function exists to prevent, and the agent wakes with nothing to pick up.
#
# Checked AT EACH READ rather than once at startup. A profile is sourced after
# these defaults are taken and can export any of them, so a startup sweep would
# pass and the value actually in force would be the one it never saw.
require_whole() { # $1 = name to blame, $2 = value, $3 = the unit for the message
  case "$2" in
    ''|*[!0-9]*) die "$1 must be a whole number of $3, got '$2'" ;;
  esac
}
require_interval() { # $1 = name to blame, $2 = value; reaches sleep, so fractions are fine
  # A bare `.`, a second dot, and anything signed are all rejected: sleep takes
  # none of them, and a leading dash would be read as an option rather than a
  # number besides.
  case "$2" in
    ''|.|*[!0-9.]*|*.*.*) die "$1 must be a non-negative number of seconds, got '$2'" ;;
  esac
}

gang_root() { # $1 = path to this script; the install tree it lives in
  # Plain readlink in a loop, not `readlink -f`: the -f form is GNU-only and a
  # stock macOS rejects it. When it failed the substitution came back empty,
  # dirname read that as ".", and ROOT silently became the parent of whatever
  # directory the CALLER happened to be in — so gang ran with no profiles and no
  # roles while install.sh reported success. Law 8: a tool that cannot find its
  # own tree says so rather than running half-configured.
  local src="$1" dir
  while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")/.." && pwd
}
ROOT="$(gang_root "${BASH_SOURCE[0]}")"
# Both, because list_roles skips a directory that is not there and returns 0 --
# so a tree missing roles/ answered `gang roles` with silence and a clean exit,
# and every caller read that as "this install has no roles" rather than "this
# install is broken". Same shape as an unresolvable ROOT: fail where it is wrong,
# not where it is noticed.
for _d in profiles roles; do
  [ -d "$ROOT/$_d" ] \
    || die "no $_d/ beside $ROOT — this is not a gangline tree. Reinstall, or run bin/gang from a checkout."
done
unset _d
# The ladder runs from an absolute floor to an absolute cap, and only the spacing
# between them fits the window. Both bounds are token counts because both answer the
# same question rot asks: how long is this context. Rot does not care how full the
# window is — a 300k context is degraded whether the window is 258k or 1M — so every
# agent's first warning lands at the same absolute count, and no agent goes unwarned
# past the cap. A bigger window is a reason to warn on the same schedule, not a
# licence to fill it. A ladder made entirely of window fractions inverts that exactly
# where it costs most: 85% of 1M is 850k tokens, warning the biggest contexts last.
# It has been proposed and refused three times; docs/adr/0005-context-bands-are-
# absolute.md exists so a fourth proposal reads it instead of re-deriving it.
#
# Between the two bounds the hazard is a different one — running out of room to
# finish the turn — and that is relative to the window by nature, so the rungs there
# scale. docs/adr/0006-the-band-ladder-spans-absolute-bounds.md carries both halves.
#
# A profile may export either bound to set it for its own harness: load_profile runs
# before the ladder in both nudge legs. An explicit GANG_CONTEXT_BANDS CSV bypasses
# the derivation entirely and is read exactly as written.
BANDS="${GANG_CONTEXT_BANDS:-auto}"

# One wait with two users: pane_stable asks it of a single pane and churn_batch
# asks it of a whole team, and the suite asserts the two agree about the same
# pane. Tuned in one place only, because tuning one and not the other would make
# the batched roster column and the per-agent read quietly start disagreeing —
# and a silent disagreement between two answers to one question is the drift this
# file has had to chase in several other costumes.
GANG_CHURN_WAIT="${GANG_CHURN_WAIT:-0.5}"

# How long after tmux last stamped output on a window that window still counts as
# working. Five, and the two failure directions are not symmetric — which is what
# makes a slightly wrong number safe here and an arbitrary one not.
#
# TOO SMALL reproduces the bug this exists to close: a live turn read as idle,
# and the worst kind, because gang's own traffic is what causes it. A message
# long enough to fill the pane pushes the working indicator off a full-screen TUI,
# capture-pane returns a byte-identical frame, and the natural next move — send
# again — makes the pane longer and the blindness more certain. TOO LARGE reports
# busy for a few seconds after an agent finishes: a wait returns late, a send
# queues instead of landing instantly. Nothing is delivered wrongly. In doubt,
# too large.
#
# Five and not three, and the three is the measured number: the longest unbroken
# silence in the blind state was 3s, across a turn that was producing output. A
# turn blocked 60s inside a tool call producing NOTHING ticked every second it
# had, longest gap 1.35s — so the tail this has to clear is the one measured with
# output, not without. Three is the floor of what is known and this is not it.
GANG_ACTIVITY_WINDOW="${GANG_ACTIVITY_WINDOW:-5}"

# How long recent pty activity may be the ONLY evidence keeping an agent busy.
# Five minutes is policy, not a measurement: the field failure ran for about
# forty minutes, and any bound in this range would have stopped it. Five is long
# enough to bridge generous gaps between the busy markers every declaring
# profile also paints, while short enough that a finished agent cannot stall a
# team indefinitely. An operator with different harness evidence can move it
# without patching gang.
GANG_ACTIVITY_LIMIT="${GANG_ACTIVITY_LIMIT:-300}"

# How long an OPEN turn bracket alone may witness busy. The bracket is the event
# tier for that predicate (ADR-0008) and it is refreshed on every tool call, so
# what this bound has to clear is the longest stretch of one turn that calls no
# tool: thinking, then streaming an answer.
#
# Policy, not a measurement, and the same number as the bound above because it is
# the same question — how long may ONE signal hold an agent busy on its own. The
# two directions are not symmetric here either. TOO LARGE is the hazard that put
# the bound here at all: `Stop` is silent on an Esc interrupt and on a crash, so
# an interrupted turn leaves a bracket nobody will ever close, and without a bound
# that agent reads busy for the life of its window. TOO SMALL costs much less than
# it looks like it should, because expiry does not fall through to idle — it falls
# through to the tiers below, where a live turn on a quiet-at-rest harness is still
# positively witnessed by the pty arm. So the error direction that survives is a
# long tool-less turn reported could-not-determine while it is in fact working,
# which refuses a send rather than misdelivering one.
GANG_TURN_LIMIT="${GANG_TURN_LIMIT:-300}"

# One number with two users, and they ask the same physical question: how long
# after `/compact` is typed can that compaction still credibly be in flight.
# compaction_pending asks it to decide when a pending mark becomes an UNPROVED
# one; resume_after_compaction asks it to decide when to stop waiting for proof of
# the context drop. One question, so one number — but the two do not FAIL alike,
# and whoever moves it is moving both. Overrunning it in patrol turns a held nudge
# into a held-and-flagged one: noisy. Overrunning it in the resume abandons the
# proof and drops back to the settle path, which can hand the message to a turn
# still running: corrupting. Lower is the dangerous direction at both.
#
# The field record does not justify 300 as a safe ceiling. It holds a handful of
# gang-requested drops with independent proof, and every timing in it is a polling
# latency rather than a native duration — each one says when gang next looked, not
# when the compaction finished. The longest ran close enough to this bound to
# leave very little margin under it. Expiry therefore establishes
# only that the clock ran out, which is why patrol spends it as an unknown worth
# reporting rather than as clearance to inject; this constant remains policy, not
# an observed safety boundary.
#
# It also has a ceiling it does not state locally: raised past GANG_RESUME_TIMEOUT
# it deletes the resume's checked fallback outright, leaving only the timeout's
# unconditional inject. Both defaults are here rather than written out at each use,
# because a default spelled twice is how the churn wait above came to disagree with
# itself.
GANG_COMPACT_GRACE="${GANG_COMPACT_GRACE:-300}"

# How long an OPEN compaction bracket stays credible. A different question from
# the grace above, which asks how long a compaction gang TYPED could still be in
# flight; this one bounds a compaction the harness said had STARTED, and only the
# open side of it — a closed bracket is a finished compaction, and a finished
# compaction does not become unfinished with age.
#
# It is deliberately not derived from the one measurement there is. A manual
# compaction is over in seconds, and a bound near that would be the tightest
# thing in this file; auto-compaction on a large window is unobserved (gh #57),
# and it is the case this tier exists to cover, so the bound is set for the case
# nobody has measured rather than the one somebody did. Overrunning it costs a
# held nudge, which is noisy; undershooting it drops a genuinely compacting pane
# back to a tier that reads it idle, and patrol then injects into the compaction
# — corrupting. So the error direction is chosen and the number is policy, not an
# observation.
GANG_COMPACTION_LIMIT="${GANG_COMPACTION_LIMIT:-300}"

# How long a raised occupancy stays credible, and it is the longest bound in this
# file on purpose. The others bound a fact that something keeps refreshing; this
# one bounds a fact NOTHING refreshes, because a harness sitting at a permission
# dialog fires one event and then goes completely silent — no heartbeat, no
# second event, nothing on dismissal. So this number is the whole reach of the
# fact rather than a gap between two of them, and it has to cover a dialog an
# operator walks away from.
#
# The two directions do not cost alike, which is what sets it. Overrunning holds
# sends off a pane whose dialog is already gone: noisy, and self-healing besides,
# since the reader clears the raise the moment it can see a composer again — the
# common case never reaches this bound at all. Undershooting drops a pane with a
# LIVE dialog back to a scrape that reads it idle, and every keystroke sent there
# lands IN the dialog, where it ACTS on it: an answer to a permission question
# nobody meant to answer. Corrupting, unrecoverable, and silent. So the bound is
# set long and the error direction is chosen rather than balanced.
GANG_OCCUPIED_LIMIT="${GANG_OCCUPIED_LIMIT:-900}"

# How long a written context figure stays credible, and it is the SHORTEST bound
# in this file for the same reason the one above is the longest. The others bound
# a fact whose fallback is worse than it is; this one does not. The statusline
# writes this record and paints the beacon in the same breath, from the same
# numbers, so falling through costs a capture-pane and returns what the fact would
# have said. Being early is close to free.
#
# Being late is not, and the asymmetry is what sets the number. Within a turn the
# figure only climbs, so a stale one reads LOW, and patrol spends it as evidence
# that an agent has not reached a band it is already past. The nudge then arrives
# late — and a nudge to compact is worth what it is worth precisely because it
# comes before the thread is lost, so lateness does not merely delay the warning,
# it spends the thing the warning was protecting. Short, therefore, and the
# fallback does the work wherever there is any doubt.
#
# What expiry means here is not "this figure is wrong" but "nothing is refreshing
# it" — which describes an agent that is not working, whose beacon says exactly
# what the record says. That is why a bound this short does not make the tier
# pointless: the reads that matter are taken while an agent is moving, and a
# moving agent repaints.
GANG_CONTEXT_FACT_LIMIT="${GANG_CONTEXT_FACT_LIMIT:-60}"

# Where a non-interactive sweep records what it found. gang owns this rather than
# leaving it to a shell pipeline in a crontab line, and the reason is a five-hour
# outage: that pipeline filtered by an ALLOWLIST of verdict phrases, so the one
# verdict that named a real failure — a phrase added long after the line was
# pasted — was dropped at the pipe every two minutes and never reached the file.
# A filter that only passes outcomes somebody already thought of cannot report a
# new one, and nobody re-pastes a crontab line when the tool changes.
#
# So the decision about what is routine belongs next to the code that decides
# everything else about a sweep, and the timestamps belong here too: a crontab
# line cannot carry `date +%F` without escaping, because cron reads an unescaped
# % as a newline. Set it empty to write no log at all.
GANG_PATROL_LOG="${GANG_PATROL_LOG-${XDG_STATE_HOME:-$HOME/.local/state}/gangline/patrol.log}"
# One roll, not a rotation scheme. An append-forever file on somebody's disk is a
# defect however slowly it grows, and keeping exactly one previous generation is
# the smallest thing that is not one.
GANG_PATROL_LOG_MAX="${GANG_PATROL_LOG_MAX:-1048576}"

usage() {
  cat <<'EOF'
gang — drive a team of CLI agents as tmux windows

  gang up [name] [<hitch's flags>]            the whole setup, no arguments needed:
                                              hitches "lead" here on GANG_PROFILE
                                              with the lead role, and puts you in it.
                                              Every flag is handed to gang hitch
                                              untouched, so whatever hitch takes, up
                                              takes — and gang hitch is where they are
                                              listed. A second list here would be one
                                              release away from disagreeing with it
  gang hitch <name> [-p <prof>] [-r <role>] [-d <dir>] [-m <model>] [--resume]
                    [--cutoff <duration|clock>]
                                              hitch an agent into the team (window name =
                                              identity); -r briefs it with a role from
                                              roles/; -m launches it on a specific model,
                                              spelled the harness's own way (codex:
                                              gpt-5.6-sol, opencode/pi: provider/model);
                                              --resume picks up the harness's own last
                                              conversation in <dir> instead of starting a
                                              fresh one, for rebuilding a team after the
                                              tmux server died; --cutoff declares the
                                              whole team's cutoff and re-spans it from
                                              now, as gang cutoff does; alias: spawn
  gang adopt <name> -p <profile>              register an existing window as an agent
  gang send  <name> --from <sender> --stdin   verified send; reads the body from stdin and
                                              delivers mid-turn if the harness takes input
                                              during one (--wait to block for idle instead)
  gang compact <name> [--resume-stdin]        trigger the harness's own context compaction;
                                              a resume read from stdin fires once it settles.
                                              Naming yourself is allowed and is the
                                              self-compaction path (--from/GANG_FROM required)
  gang status <name>                          busy (tight tug) | idle (slack tug) |
                                              parked (waiting on <agent>) |
                                              expired (<the evidence that ran out>:
                                              neither busy nor idle, and never
                                              last-known-good) |
                                              occupied (authority unknown: a UI owns
                                              the input box — a permission prompt, a
                                              picker, or anything else Gangline was not
                                              taught to classify; sends cannot land)
  gang context <name>                         context-window usage (profile-declared readout)
  gang wait  <name> [timeout_s]               wait for idle (default 300); parked and
                                              expired also end it, so read what it printed
  gang capture <name> [lines]                 tail of the agent's pane (default 40)
  gang roster                                 all agents with profile, state, context
  gang cutoff [<duration|clock>|clear]        declare the team's wall-clock cutoff — a
                                              duration (90m, 2h, 1h30m) or the next
                                              occurrence of a clock time (17:30). One team,
                                              one cutoff: declaring again re-spans it from
                                              now. No argument shows it; clear ends it
  gang patrol                                 sweep the roster; nudge any agent past a
                                              context band (GANG_CONTEXT_BANDS ladder),
                                              and again past a rung of the team's budget
                                              once a cutoff is declared; holds either
                                              nudge if the input box has content; reports
                                              occupied boxes and refused inbound
  gang cron [--install|--refresh]             print the crontab entry that runs patrol for
                                              this install: this gang's path, and the GANG_*
                                              overrides exported here so a sweep agrees with
                                              the team. --install writes it, replacing an
                                              existing entry for this session in place;
                                              --refresh replaces one only if it is already
                                              there, which is what updating an install does
  gang vet [--file-issue] [--probe [name]]    strategy-rot check: installed harness version
                                              vs each profile's verified pins; exits nonzero
                                              on drift; --file-issue files a deduped rot
                                              issue on this repo (needs gh); --probe also
                                              LAUNCHES each installed harness on a private
                                              tmux socket and watches its declared busy
                                              marker and context readout across a real turn;
                                              a declared mid-turn action gets an asymmetric
                                              filesystem-ordering turn too — it spends tokens
                                              and takes as long as those turns take;
                                              alias: doctor
  gang attach                                 attach to the team session
  gang drop  <name>                           release the agent — its window and
                                              state go with it
  gang down                                   end the whole session (every agent)
  gang profiles                               list available profiles (harnesses)
  gang roles                                  list available roles (briefs)
  gang hook                                   harness hook mode: the one verb every wired
                                              event fires, reading its payload on stdin.
                                              Records the turn bracket that busy() reads,
                                              and warns the agent in-turn when it crosses a
                                              context band (see README)

Env: GANG_PROFILE (default harness: claude-code), GANG_ROLE (role gang up briefs
     the lead with: lead), GANG_FROM (sender identity for send),
     GANG_SESSION (default: gangline),
     GANG_CONTEXT_FLOOR (first rung, absolute tokens; default 120000),
     GANG_CONTEXT_CAP (last rung's ceiling, absolute tokens; default 350000 — five
       rungs are derived across [floor, min(90% of window, cap)], so both ends are
       token counts and only the spacing fits the window: ADR-0006),
     GANG_CONTEXT_BANDS (explicit ladder, bypassing that derivation; % of the
       window is an escape hatch, never a default: ADR-0005),
     GANG_TIME_RESERVE (banking room held back from the end of a declared cutoff,
       so the last time rung fires where banking has to start; a whole percentage
       below 100, or a duration like 15m; default 10%),
     GANG_LOCK_DIR (delivery locks; default /tmp/gangline-<uid>, created 0700 and
       reachable from a sandbox — they die at reboot, not at logout),
     GANG_ROLES / GANG_PROFILES (your own dirs, searched before the shipped ones),
     GANG_BOOT_TIMEOUT (seconds to wait for a hitched harness to take input: 30)
EOF
}

usage_die() { usage >&2; exit 1; }

# --- profiles ---------------------------------------------------------------
#
# A profile says how to talk to one harness: how to launch it, how to tell it is
# mid-turn, how its modals read, how to read its context, how to see its input
# box. GANG_PROFILES
# points at your own directory, which is searched before the shipped one, so a
# new harness — or a fix to a shipped profile whose TUI has moved on — costs a
# file, never a patch to the installed tree.

# Profiles that exist to exercise gang's own mechanics rather than to drive a
# harness. They ship, because the suite needs them and a test dependency that is
# not installed is not tested — but they are not OFFERED. `gang profiles` is what
# the installer prints and what an operator picks from, and a shell sitting in
# that list reads as a fifth harness gangline supports: the operator asks which
# agent to run on it, and the honest answer is none. The suite opts back in.
TEST_ONLY_PROFILES="bash"

test_only_profile() { # $1 = profile name; exit 0 if it is a stand-in, not a harness
  [ "${GANG_TEST_PROFILES:-}" = 1 ] && return 1
  case " $TEST_ONLY_PROFILES " in *" $1 "*) ;; *) return 1 ;; esac
  # Only the SHIPPED stand-in is withheld. Somebody whose own GANG_PROFILES holds
  # a bash.sh means it, and shadowing is the documented way to override anything
  # gang ships — withholding their file too would make the override silently
  # useless for one name and nobody would guess which.
  [ "$(profile_file "$1" 2>/dev/null)" = "$ROOT/profiles/$1.sh" ]
}

# Every profile INSTALLED, whether or not it is offered: both dirs, deduped by
# name, because a name present in each is one profile with the shipped copy
# shadowed. The two callers want different sets and the difference is the whole
# point of splitting this out — `gang profiles` offers, `gang vet` diagnoses, and
# a rot check that only walked what is offered would quietly stop walking the
# stand-in it is shipped beside.
all_profiles() {
  local d p
  for d in ${GANG_PROFILES:+"$GANG_PROFILES"} "$ROOT/profiles"; do
    [ -d "$d" ] || continue
    for p in "$d"/*.sh; do
      [ -f "$p" ] || continue
      # Stripped with parameter expansion rather than basename, and that is not
      # micro-optimisation. A fork that fails — and under real load on this box
      # they do — drops that ONE name from the list and reports nothing: the
      # profile silently stops being offered by `gang profiles` and silently stops
      # being VETTED, which is a guard lost with nothing printed to say so. It is
      # the same class this function's own comment was written about. Demonstrated
      # with a basename shim failing on one file: codex disappeared from `gang
      # profiles` and the exit status stayed 0. An expansion cannot fail that way.
      p="${p##*/}"
      printf '%s\n' "${p%.sh}"
    done
  done | sort -u
}

list_profiles() { # what an operator may pick from
  # Built whole rather than a line at a time, which helps and saves nobody. The
  # hazard is real: a caller piping this into `grep -q` gets a reader that exits
  # at its match while the writer still has lines to write, the writer takes
  # SIGPIPE, and under the caller's pipefail the pipeline reads as a MISS — a
  # name that IS in the list reported absent, one run in five.
  #
  # What this comment used to claim, and what is false: that one printf of one
  # variable is ONE write, so the payload lands in the pipe buffer before any
  # reader can have matched. bash line-buffers stdout, so printf emits one write
  # PER LINE and the payload size never enters into it. Measured on this tree:
  # `gang profiles | grep -q bash` fails 155 times in 1000, PIPESTATUS 141,0,
  # against exactly this function — while the same payload with the match on the
  # LAST line fails 0 in 500, because there the reader must consume everything
  # before it can exit. Attributed by sigpipe under GDB (issue #6): five writes,
  # one per profile name.
  #
  # So this function cannot make a piping caller safe and nothing it does will.
  # The rule lives at the CONSUMER: capture first, match off a here-string. That
  # is structural — no pipe is left to raise a signal — and it is what this tree
  # now does everywhere, including the eight predicates in this file.
  local n out=""
  while read -r n; do
    [ -n "$n" ] || continue
    test_only_profile "$n" && continue
    out="$out$n
"
  done <<EOF
$(all_profiles)
EOF
  printf '%s' "$out"
}

profile_file() { # $1 = profile name -> path on stdout; yours wins over the shipped one
  local d
  for d in ${GANG_PROFILES:+"$GANG_PROFILES"} "$ROOT/profiles"; do
    [ -f "$d/$1.sh" ] && { printf '%s' "$d/$1.sh"; return 0; }
  done
  return 1
}

marker_named() { # $1 = profile name -> WHERE its busy marker is declared, never the pattern
  # THE FILE, NOT THE PATTERN, decided in one place because every row that names a
  # busy marker has the same problem. gang's own output lands in the panes gang
  # scrapes, and busy_painted() reads the WHOLE pane — so a row reproducing a
  # profile's busy regex verbatim leaves whoever ran the command reading BUSY while
  # perfectly idle: every send refused, every wait timed out, for as long as the
  # line stays on screen. This repo has already had compacting() true for three
  # minutes off a reviewer's own grep output, and the suite once caught gang
  # printing a shipped regex into the pane of a probe that was measuring exactly
  # this.
  #
  # Rendering the pattern harmless instead was measured and abandoned. A busy regex
  # is allowed to be a bare single character — two of claude-code's alternatives
  # are exactly that — and any text that merely quotes one matches it, so no
  # transform that preserves the characters can be general.
  #
  # The path is also the better answer to what naming the pattern was for. The
  # declaration is the thing an operator has to edit, and it arrives with the
  # comment block saying what that pattern was verified against; the pattern itself
  # still travels in the issues vet files, which are read somewhere other than a
  # pane.
  local f
  f="$(profile_file "$1" 2>/dev/null)" || f="the $1 profile"
  printf 'the busy marker declared in %s' "$f"
}

load_profile() { # $1 = profile name; sets the GANG_* strategy surface
  local f
  f="$(profile_file "$1")" \
    || die "unknown profile '$1' (have: $(list_profiles | tr '\n' ' '))"
  GANG_LAUNCH="" GANG_RESUME_LAUNCH="" GANG_BUSY_REGEX="" GANG_COMPACT_CMD="" GANG_MIDTURN_INPUT=""
  GANG_MIDTURN_ACTS="" GANG_PROBE_FACTS=""
  GANG_COMPACTING_REGEX="" GANG_OCCUPIED_REGEX="" GANG_SESSION_KEY="" GANG_QUIET_AT_REST=""
  # Cleared alongside it so a value left by a PREVIOUS profile cannot make the
  # next one look like it declared the retired name.
  GANG_GATED_REGEX=""
  GANG_VERSION_CMD="" GANG_VERIFIED_VERSIONS="" GANG_MODEL_OPT=""
  # Kept, not discarded with the rest of the local, so that a failure reading
  # anything this file declares can name the file to go and open. GANG_PROFILES
  # points wherever the operator said — which can be a directory nobody
  # remembers setting — and a complaint about a variable with no path attached
  # starts a hunt through every profile that might be the one loaded.
  GANG_PROFILE_FILE="$f"
  # no stale functions across profiles
  unset -f profile_context profile_input profile_vet 2>/dev/null || true
  # shellcheck source=/dev/null
  . "$f"
  [ -n "$GANG_LAUNCH" ] || die "profile '$1' sets no GANG_LAUNCH"
  # The retired name is recognised ONLY in order to refuse it, which is what makes
  # this a deletion path (law 6) rather than a compatibility shim. Accepting both
  # is the alias ADR-0004 forbids, and it would keep the retired word alive in the
  # contract for good.
  #
  # It has to be loud because the quiet version is a silent downgrade of a safety
  # boundary. A profile still setting the old name declares NOTHING to the new
  # reader, so occupied() falls through to the composer-absence fallback — which
  # catches a UI that hides the composer and misses every declared marker that
  # does not. Nothing errors. The operator sees an agent reading idle where it
  # used to read correctly, and the only symptom is a message landing in a dialog.
  # A profile that cannot declare its occupancy marker cannot be trusted to route
  # messages, so it does not get to load at all.
  [ -z "${GANG_GATED_REGEX:-}" ] \
    || die "profile '$1' ($GANG_PROFILE_FILE) sets GANG_GATED_REGEX, which gang no longer reads — rename it to GANG_OCCUPIED_REGEX. The state it declares is 'occupied' (ADR-0004); leaving the old name would silently demote this profile to composer-absence detection and read a gated agent as idle"
  [ "${GANG_MIDTURN_ACTS:-}" != 1 ] || [ "${GANG_MIDTURN_INPUT:-}" = 1 ] \
    || die "profile '$1' declares GANG_MIDTURN_ACTS without GANG_MIDTURN_INPUT — acting on text cannot make an unsafe mid-turn paste safe"
}

# --- roles ------------------------------------------------------------------
#
# A profile says how to talk to a harness; a role says what an agent is for.
# Both are the same kind of extension point, and neither is code: a role is a
# markdown brief injected as the agent's first message (law 9 — the answer is
# prose in an agent's prompt). GANG_ROLES points at your own directory, which
# is searched before the shipped one, so any brief here can be replaced by
# dropping a file of the same name next to it. `_`-prefixed files are not roles
# in their own right; `_common.md` is the part every role points at too.

list_roles() {
  local d f
  for d in ${GANG_ROLES:+"$GANG_ROLES"} "$ROOT/roles"; do
    [ -d "$d" ] || continue
    for f in "$d"/*.md; do
      [ -f "$f" ] || continue
      case "${f##*/}" in _*) continue ;; esac
      # Expansion, not basename, and this one fails HARDER than the profile list
      # it mirrors. There the fork was consumed in a substitution, so a failure
      # dropped one name at exit 0; here it is a bare command, so set -e ends the
      # loop's subshell and the list is empty from that file onward. Both die()
      # sites that print "have: <roles>" then hand somebody who has already
      # mistyped a role an empty list of what they may pick instead. The line
      # above already strips the same variable this way.
      f="${f##*/}"
      printf '%s\n' "${f%.md}"
    done
  done | sort -u
}

role_file() { # $1 = role name -> path on stdout; yours wins over the shipped one
  local d
  for d in ${GANG_ROLES:+"$GANG_ROLES"} "$ROOT/roles"; do
    [ -f "$d/$1.md" ] && { printf '%s' "$d/$1.md"; return 0; }
  done
  return 1
}

mint_key() { # -> a fresh session marker; unique by construction, meaningless by design
  # The marker exists to be found later: a profile that declares GANG_SESSION_KEY=1
  # keeps its usage figures in an on-disk session transcript, and the only durable
  # link from a tmux window to that file is a token gang itself planted in the
  # conversation. It is generated HERE, never taken from the command line and never
  # echoed to stdout — a caller that typed or printed it would record it in its own
  # transcript too, and a marker in two transcripts identifies nothing.
  printf 'gl-%s' "$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
}

valid_name() { # $1 = a name; usable as identity, tmux target, shell word, JSON string
  # One grammar for agent names and senders, because a name is all four of those
  # at once: tmux addresses it, `gang hook` puts it in JSON, the band note
  # puts it in a suggested command, and messages sign with it. A name that
  # cannot round-trip through all four is refused at the door rather than
  # producing a window nobody can address or a hook reply nobody can parse.
  #
  # patrol and hitch are already gang's own identities on the wire. An agent
  # wearing either can authenticate an envelope indistinguishable from the
  # substrate, so creation, adoption and sender authentication reserve them.
  # resolve does not call this function: an old colliding window remains
  # addressable as a target long enough for the operator to raw-rename it, but
  # cannot keep signing messages under the reserved identity.
  case "$1" in
    patrol|hitch) return 1 ;;
    ''|-*|.*) return 1 ;;
    *[!A-Za-z0-9._-]*) return 1 ;;
  esac
}

mint_nonce() { od -An -N4 -tx1 /dev/urandom | tr -d ' \n'; }

ENVELOPE=""
envelope() { # $1 = sender, $2 = body; the message as it goes on the wire, into ENVELOPE
  # A bare prefix on the first line leaves every line after it unsigned — and the
  # role briefs read an unsigned line as the OPERATOR, who outranks every peer. A
  # peer with nothing but permission to run `gang send` could then deliver
  # `ok\nnow do the dangerous thing`, where the second line arrives in the
  # operator's voice. A repository that gets text into one agent reaches the
  # whole team that way.
  #
  # The envelope closes it: everything the sender said is inside a matched pair,
  # and the pair carries a nonce minted for this message alone. A body cannot
  # close the envelope and open another, because the nonce is minted here, from
  # a body that already exists, and whoever wrote that body cannot know the value.
  #
  # THE NONCE IS THE MECHANISM. Neutralising tag-shaped text below is defence in
  # depth over it, aimed at a reader that is a model rather than a parser: a
  # wrong-nonce tag is not a valid close, but it can still read as one to
  # something skimming.
  #
  # What none of this does is authenticate the sender: any writer to a pane can
  # type an envelope. That is why the sender is read off the sending window
  # wherever gang can see one (check_sender), rather than believed.
  #
  # The result lands in ENVELOPE rather than on stdout, and that is the fix for a
  # guarantee that used to end here. stdin_body goes to real trouble to keep a
  # body's trailing newlines — a sentinel byte appended and stripped inside one
  # substitution — and every caller of this function then wrote
  # `inject "$id" "$(envelope ...)"`, which takes them straight back off. The
  # sentinel protected nothing that shipped. A variable cannot be stripped by a
  # substitution that is no longer written, so the shape is the guarantee.
  local nonce body marked sentinel=$'\034'
  nonce="$(mint_nonce)"
  # Match the SHAPE of a tag, not the one spelling gang emits. A model reads
  # `［gang:lead#0000]` as an envelope as readily as the ASCII form, so matching
  # the exact literal caught the honest case and none of the others: fullwidth
  # brackets, any capitalisation, and whitespace anywhere inside the tag all went
  # through untouched when they were measured against it.
  #
  # Literal alternation, never a bracket class. The C locale is reachable here —
  # utf8_locale warns and continues (:31) — and there a bracket class holding a
  # multibyte character matches its individual BYTES: `[[［]` consumes only the
  # last byte of ［ and leaves the other two behind as mojibake, corrupting the
  # body instead of neutralising the tag. Measured, on this expression. The ASCII
  # class over `gang` is safe for the reason it looks redundant — every member is
  # one byte.
  #
  # This widens the net; it does not close it. Homoglyphs are unbounded and no
  # enumeration of them terminates, so what is here is a speed bump in front of
  # the nonce rather than a parser guarantee, and no document may promise more.
  #
  # Comma delimiter so the `/` of a closing tag needs no escape: whether `\/` is
  # defined inside an ERE group is a question worth not asking on a CI matrix
  # that includes BSD sed.
  #
  # The neutralisation still needs a substitution, so it carries the sentinel too.
  # A sed that appends a newline to a final line lacking one — BSD does, GNU does
  # not — is absorbed rather than guarded against: the substitution strips that
  # newline back off, and the sentinel is what stops it from continuing into the
  # body's own.
  marked="$(printf '%s\034' "$2" \
    | sed -E 's,(\[|［|〔|【)([[:space:]]*/?[[:space:]]*)([Gg][Aa][Nn][Gg])([[:space:]]*:),(\2\3\4,g')"
  case "$marked" in
    *"$sentinel") body="${marked%"$sentinel"}" ;;
    *) die "internal: the envelope sentinel was lost while neutralising tag-shaped text" ;;
  esac
  ENVELOPE="[gang:$1#$nonce] $body [/gang:$1#$nonce]"
}

STDIN_BODY=""
stdin_body() { # $1 = command/option label; read all text from stdin into STDIN_BODY
  # Message prose does not belong in argv. The caller's shell expands argv before
  # gang exists: backticks and $() run commands, variables expand, and globs turn
  # into filenames. Delivery verification then correctly vouches for text the
  # sender never wrote. Reading stdin makes the body data rather than shell syntax.
  #
  # A plain `body="$(cat)"` strips every trailing newline. Append a non-newline
  # sentinel inside the same substitution, then remove exactly that final byte,
  # so stdin keeps the shape the caller supplied. Guard cat explicitly: otherwise
  # the trailing printf would replace a read error with its own success.
  local marked sentinel=$'\034'
  if marked="$(
    cat || { rc=$?; exit "$rc"; }
    printf '\034'
  )"; then
    :
  else
    die "$1: cannot read the body from stdin"
  fi
  case "$marked" in
    *"$sentinel") STDIN_BODY="${marked%"$sentinel"}" ;;
    *) die "internal: $1 stdin sentinel was lost while reading the body" ;;
  esac
  [ -n "$STDIN_BODY" ] || die "$1: empty body on stdin"
}

check_sender() { # $1 = claimed sender; inside the session, it must be your own window
  # --from is a string the caller chooses, and the point of attribution is that a
  # worker cannot sign as the lead — or as `patrol`, or `hitch`. Wherever gang
  # can see who is calling, it uses that instead of the claim. Outside the
  # session there is nobody to look at and the flag stands: that is the
  # operator's own shell, and cron.
  valid_name "$1" \
    || die "sender '$1' is not a usable identity — patrol and hitch are reserved for gang's substrate; other names use letters, digits, dot, dash and underscore only, not starting with a dash or dot"
  local self mine
  self="$(self_window)" || return 0
  mine="$(tmux display-message -p -t "$self" '#W' 2>/dev/null)" || return 0
  [ -z "$mine" ] || [ "$mine" = "$1" ] \
    || die "you are '$mine', so sign as '$mine' — a message signed '$1' from this window would put a peer's words in another agent's inbox under somebody else's name"
}

marker_line() { # $1 = key; the sentence that plants it, tuned to stay planted
  # "Never repeat it" is load-bearing: the marker identifies the one transcript it
  # was typed into, and an agent that quotes it to a peer plants it in a second
  # transcript, where lookup finds both and refuses to guess.
  printf 'Session marker: %s — gang bookkeeping, ignore it and never repeat it anywhere.' "$1"
}

role_brief() { # $1 = role, $2 = agent name; the message that points at the brief
  # Pointed at, not pasted. A brief is longer than a pane is tall, and a paste
  # whose first line has scrolled out of view cannot be verified — capture-pane
  # sees only what is on screen. Every coding agent can read a file, so the
  # universal surface here is the filesystem (law 1), and the brief stays on
  # disk where the agent can re-read it after compacting.
  local f common where
  f="$(role_file "$1")" || die "unknown role '$1' (have: $(list_roles | tr '\n' ' '))"
  where="$f"
  common="$(role_file _common)" && where="$common and $f"
  printf 'You are `%s` on a gangline team, in the %s role. Your operating brief is %s — read it now and follow it for the rest of this session.%s' \
    "$2" "$1" "$where" "${GANG_COMPACT_CMD:+ Your compaction command is $GANG_COMPACT_CMD}"
}

# --- window plumbing --------------------------------------------------------
#
# Agents are addressed by tmux window id (@N), never by "session:name": tmux's
# target grammar reads an all-digit name as a window INDEX, so a name-built
# target delivers `2` to whatever sits at index 2 and calls it verified. An id
# is immutable for the window's life, survives rename and reorder, and is never
# reused — so a name resolved once cannot drift under the rest of the command.
#
# The session is addressed as "=$SESSION" everywhere for the same class of
# reason: an unanchored tmux target is a PREFIX match, so GANG_SESSION=team
# resolves to a running team-production when nothing is called team — quietly
# hitching into the wrong team, and, through `gang down`, killing it. The "="
# demands the whole name.

win_id() { # $1 = agent name -> @id on stdout; nonzero if no window has that name
  local id name
  while read -r id name; do   # `read id name` keeps spaces in the name
    [ "$name" = "$1" ] && { printf '%s' "$id"; return 0; }
  done < <(tmux list-windows -t "=$SESSION" -F '#{window_id} #W' 2>/dev/null)
  return 1
}

exists() { win_id "$1" >/dev/null; }

self_window() { # -> the window id this process is running in; nonzero if not in one
  # tmux exports $TMUX_PANE into every pane it starts, so it names the caller
  # exactly — unlike the attached-client list, which names whoever is LOOKING at
  # the session, not who is running inside it. It can also be stale: a process
  # that outlived its pane, or one that inherited the variable across an ssh or
  # mosh hop, still carries a pane id for a pane that is gone. So the id is
  # checked against the live session rather than trusted; a stale one matches
  # nothing and the caller is simply not-self, which is the safe answer.
  [ -n "${TMUX_PANE:-}" ] || return 1
  local pid wid
  while read -r pid wid; do
    [ "$pid" = "$TMUX_PANE" ] && { printf '%s' "$wid"; return 0; }
  done < <(tmux list-panes -s -t "=$SESSION" -F '#{pane_id} #{window_id}' 2>/dev/null)
  return 1
}

# resolve() sets these two for the command that follows; the only name->agent lookup.
AGENT_ID="" AGENT_PROFILE=""

resolve() { # $1 = agent name; sets AGENT_ID + AGENT_PROFILE and loads the profile
  AGENT_ID="$(win_id "$1")" || die "no agent '$1' (see: gang roster)"
  AGENT_PROFILE="$(tmux show-options -wqv -t "$AGENT_ID" @gl_profile)"
  [ -n "$AGENT_PROFILE" ] \
    || die "window '$1' exists but is not a gang agent (gang adopt $1 -p <profile>)"
  load_profile "$AGENT_PROFILE"
}

session_live() { # exit 0 if the team's session is running
  # has-session fails identically for "there is no such session" and "the tmux
  # server cannot be reached at all", and discarding its stderr made the second
  # wear the first's clothes: inside a sandbox that denies connect() on the tmux
  # socket, `gang roster` printed "no team (session gangline not running)". The
  # operator read a message about the session, reasoned about $TMUX, and filed a
  # bug against the wrong subsystem. The message cost more than the fault did.
  #
  # Recognised phrasings of "not there" are treated as absence. Anything else is
  # surfaced verbatim rather than guessed at, because the set of ways a server
  # can be unreachable is not one gang can enumerate, and an unexpected message
  # reported as itself is the safe direction.
  #
  # The empty case is the exception, and it is a GUESS named as one. A nonzero
  # exit with nothing on stderr says nothing at all, and it is resolved toward
  # absence deliberately: a silent failure here is far more often a session that
  # is not running than a server that cannot be reached, and dying with "cannot
  # reach the tmux server — " and nothing after the dash is a worse answer than
  # "no team" for what is almost certainly a missing team. It is the one branch
  # that resolves ambiguity toward the direction which caused the original bug.
  local err
  err="$(tmux has-session -t "=$SESSION" 2>&1)" && return 0
  case "$err" in
    ""|*"can't find session"*|*"session not found"*|*"no such session"*) return 1 ;;
    # A server that was never started is not a server that cannot be reached.
    # tmux says so two ways depending on how it was asked, and both mean nothing
    # is running here yet — which is the ordinary cold start on a machine with no
    # tmux, the state every `gang up` and the whole test suite begin from. These
    # resolve toward absence so the caller goes on to create the session.
    #
    # This does not give back what the branch below is for. A connect() that is
    # actually refused — the sandbox case, where the socket exists and the kernel
    # says no — reports "Permission denied", matches neither of these, and still
    # dies with its own message. The distinction is the socket's existence, which
    # is the thing the two situations genuinely differ on.
    *"no server running"*) return 1 ;;
    *"error connecting to"*"No such file or directory"*) return 1 ;;
    *) die "cannot reach the tmux server — $err" ;;
  esac
}

# No -e, deliberately, and this is the first thing anyone proposes on being told
# a marker might be a colour rather than a character. Nearly every marker
# gangline scrapes is anchored to the START of a line, which is exactly where an
# escape sequence sits: claude-code's busy branch matches its own captured
# thinking line with escapes stripped and does not match it with them present,
# because the anchor eats the ESC. The same anchoring carries codex's gate
# (^› [0-9]+\.), pi's (^→), claude-code's own (^ +❯|Esc to) and opencode's badge
# and box parsing. Passing -e here would blind gate detection on three harnesses
# the day it landed.
capture() { tmux capture-pane -p -t "$1"; }

# -J joins pane-width-wrapped lines so matching never breaks on a wrap boundary.
capture_joined() { tmux capture-pane -pJ -t "$1"; }

capture_status() { # $1 = window id; the bottom rows, where a TUI paints its state
  # ONE caller: compacting(). busy_painted() and occupied() read the whole pane and
  # are position-blind; the narrow window is for the one predicate that cannot
  # be. A compaction marker is a glyph this repo's own profiles are full of, and
  # an agent QUOTES those words constantly — reading a profile, pasting a
  # capture, reviewing this repo — so matching over the whole pane believes any
  # of them: compacting() would have read true for three minutes off a
  # reviewer's own grep output. State reads from the region a TUI actually
  # paints state into. Trailing blank rows are dropped first: a half-empty pane
  # would otherwise spend its whole allowance on blank lines.
  #
  # One shipped profile reaches it. compacting() returns at its first line unless
  # GANG_COMPACTING_REGEX is set; pi declares one, and claude-code, codex and
  # opencode deliberately do not, each saying why. So this bound is live on pi,
  # where it is what stands between a resume queueing behind the compaction and
  # falling back to the settle path.
  #
  # What every declarer owns: the offset this bounds is
  # NOT fixed. claude-code renders unconsumed queued messages BETWEEN the state
  # line and the composer, so the distance up from the bottom grows by whatever
  # is queued — measured, a spinner at row 40 of 55 with a six-row envelope
  # under it, four rows inside twenty. A longer queue puts it outside, and the
  # cost lands on resume_after_compaction, which drops to the settle path when
  # compacting() reads false. Twenty is not a number to inherit.
  local rows="${GANG_STATUS_ROWS:-20}"
  require_whole GANG_STATUS_ROWS "$rows" rows
  capture_joined "$1" \
    | awk 'NF{last=NR} {line[NR]=$0} END{for(i=1;i<=last;i++) print line[i]}' \
    | tail -n "$rows"
}

re_match() { # $1 = the profile variable NAME holding an ERE, $2 = text; 0 hit, 1 miss
  # grep answers three things, not two: 0 it matched, 1 it did not, and >=2 it
  # could not tell. Consumed as a boolean the third collapses into the second,
  # and that collapse only ever runs one way — a marker that cannot be EVALUATED
  # reads as a marker that is ABSENT. So a working agent reads idle, a modal
  # reads clear, and resume_after_compaction counts a not-busy sample against a
  # turn it never established had ended. Every fabricated-status defect found in
  # this file is that same distinction being dropped: DETERMINED FALSE and COULD
  # NOT DETERMINE are different answers, and only the first may be spent as false.
  #
  # Reachable rather than theoretical. These regexes come from profiles, profiles
  # are edited by hand, and GANG_PROFILES points at whatever directory an operator
  # names. Measured against the grep gang actually runs (GNU 3.7, from a script,
  # not an interactive shell): '[', '(', '[z-a]' and a trailing backslash each
  # exit 2. Which patterns error is grep's business and varies between builds —
  # that the class exists is what this handles.
  #
  # Taking the NAME rather than the value is what keeps the report honest: the
  # message names the variable an operator has to go and fix, and that name
  # cannot drift from the pattern it describes, because it is where the pattern
  # was read from. Paired with the file load_profile kept, that is both halves of
  # the answer — which setting, in which file — so the report ends the search
  # instead of starting one.
  local re="${!1:-}" rc=0
  grep -qE -- "$re" <<<"$2" || rc=$?
  [ "$rc" -le 1 ] \
    || die "$1 in ${GANG_PROFILE_FILE:-<no profile loaded>} is not an ERE this grep can evaluate (grep exit $rc): '$re' — refusing to read an unevaluable marker as an absent one"
  return "$rc"
}

composer_live() { # $1 = window id; the harness's own input box is on screen NOW
  # Nonzero for a profile with no input hook, which is the honest answer: gang
  # cannot see a box it was never taught to find, so callers fall back to
  # whatever they did before one existed.
  declare -F profile_input >/dev/null || return 1
  profile_input "$1" >/dev/null 2>&1
}

busy_painted() { # $1 = window id, profile loaded; exit 0 if a turn is visibly in flight
  # The pane question, unconditioned: is this harness painting its busy marker?
  # Captured into a variable, not piped: a capture that FAILS must not read as
  # "idle" and wave an injection into a pane nobody looked at.
  #
  # Unconditioned includes unguarded about PROVENANCE, and that is settled rather
  # than overlooked. An agent that displays a profile, quotes a capture, or
  # reviews this repo puts the marker on its own screen and reads busy off its
  # own source, and the people that lands on are almost exclusively the people
  # working on gangline. What was looked for is the thing occupied() has: a
  # structural fact separating "the harness is painting its marker" from "the
  # pane holds that text for another reason". Every dialog watched live OWNS the
  # screen, so a composer that is still there proves the words are talk ABOUT a
  # prompt. Busy has no such companion. The composer is painted through a turn on
  # some harnesses and dropped on others, so neither its presence nor its absence
  # says anything here. Position is not it: prose-quoted markers were measured
  # inside the bottom twenty rows in 49 samples and outside it in the rest, which
  # is why capture_status is one predicate's window and not a general defence.
  # And tmux hands over cells, not provenance — capture-pane cannot say who wrote
  # one, while styling would mean -e, which blinds the anchored gate regexes and
  # marks up quoted text anyway.
  #
  # What is left is excluding prose by pattern, and prose is not a thing to
  # pattern-match. So what guards this is the failure DIRECTION — stated as
  # MEASURED, because the reasoned version of it was written here and was wrong.
  # Contamination is one-way: pane text can only ADD matches, so a contaminated
  # pane makes an idle agent read busy — sends queue or are refused, `gang wait`
  # runs to its timeout — and it cannot subtract the match a real turn paints.
  #
  # What does NOT follow, and was claimed here anyway, is that a busy agent can
  # therefore never read idle. It can, by two mechanisms, neither of them
  # contamination. This predicate's own pipeline was one: `printf | grep -q` with
  # the marker on an early line lost the race 3 times in 500 and returned
  # not-busy on a working pane, which is why the match is now taken off a
  # here-string with no pipe in it to raise a signal. The other was busy()'s old
  # override for every parked harness that accepted mid-turn input — measured
  # live on opencode 1.18.8 at twenty consecutive false idles while the marker
  # stayed painted. state_now now names that owned state PARKED, and busy() only
  # overrides it for the narrower, witnessed ACTS declaration. This function is
  # therefore still not the whole answer to "what can this agent do now?".
  #
  # The two signals that CAN tell a live turn from static text — recently_active
  # and churn — are ORed into busy() and have to stay that way. Conjoined into a
  # guard here they invert that direction: both are unavailable by default,
  # GANG_QUIET_AT_REST is declared per harness with each profile saying why, and
  # an AND with an unavailable signal reads every busy agent as idle. That trades
  # a bounded cost for the unbounded one.
  [ -n "$GANG_BUSY_REGEX" ] || return 1
  local pane
  pane="$(capture_joined "$1")" || die "cannot read pane $1 — refusing to guess busy/idle"
  re_match GANG_BUSY_REGEX "$pane"
}

activity_hold_clear() { # $1 = window id; end any activity-only busy episode
  tmux set-option -uw -t "$1" @gl_activity_only_since 2>/dev/null \
    || die "cannot clear the activity-only bound on pane $1 — refusing to fabricate its state"
}

recently_active() { # $1 = window id; 0 = active, 1 = inactive, 2 = hold expired
  # The pty question, which is neither of the other two. busy_painted asks what
  # the pane SAYS and churn asks whether the pane CHANGED; this asks whether the
  # harness WROTE, and that is the only one of the three a full-screen TUI cannot
  # hide from. A live claude-code turn runs a render loop that parks the cursor
  # into the composer rows on every frame — `\e[34;1H` and `\e[31;3H`, 748 of 748
  # frames — and a cursor move changes no cell. So bytes flow while cksum stays
  # flat, and 44 of 47 byte-identical pairs in the blind state had ticked.
  #
  # Declared per harness and OFF by default. window_activity ticks on any output
  # at all, so a TUI that repaints anything at rest — a clock, a cursor blink, a
  # late-settling counter — can otherwise hold busy forever. That happened in the
  # field for about forty minutes after a Pi agent had finished, despite an empty
  # composer and a byte-identical capture. Pi no longer declares the signal, but
  # finite quiet-at-rest observations cannot prove the other declarations forever
  # either. @gl_activity_only_since bounds the time gang will trust this signal
  # ALONE; it dies with the window, and genuine quiet or independent busy evidence
  # clears it sooner. tmux exposes the LAST write, not when a repeating episode
  # began, so the bound starts when gang first has to rely on the signal. It
  # bounds how long a query/send/wait is held, not unobserved time before anyone
  # asked.
  #
  # No second capture and no sleep: tmux maintains this timestamp already, so
  # unlike churn it is read once and compared against now.
  if [ "${GANG_QUIET_AT_REST:-}" != 1 ]; then
    activity_hold_clear "$1"
    return 1
  fi
  require_whole GANG_ACTIVITY_WINDOW "$GANG_ACTIVITY_WINDOW" seconds
  require_whole GANG_ACTIVITY_LIMIT "$GANG_ACTIVITY_LIMIT" seconds
  local stamped now since
  stamped="$(tmux display-message -p -t "$1" '#{window_activity}' 2>/dev/null)" \
    || die "cannot read pty activity for pane $1 — refusing to consume unknown as inactive"
  # A malformed stamp is not quiet. Naming the third answer here keeps busy()
  # from feeding it to the churn fallback as though tmux had determined false.
  case "$stamped" in
    ''|*[!0-9]*) die "tmux returned an unreadable activity stamp for pane $1: '$stamped'" ;;
  esac
  now="$(date +%s)"
  [ "$stamped" -le "$now" ] \
    || die "tmux returned a future activity stamp for pane $1: $stamped > $now"
  if [ $(( now - stamped )) -ge "$GANG_ACTIVITY_WINDOW" ]; then
    activity_hold_clear "$1"
    return 1
  fi

  since="$(tmux show-options -wqv -t "$1" @gl_activity_only_since 2>/dev/null)" \
    || die "cannot read the activity-only bound for pane $1 — refusing to guess"
  # Absent, unreadable, and later than now are ONE fact — no usable bound is
  # recorded — and they get one answer, because gang wrote this option and an
  # option gang wrote is gang's to rebuild rather than gang's to refuse over.
  # Refusing spent a single bad value as a permanent kill of status, roster,
  # wait, send and patrol for the life of the window, over a cache whose only job
  # is to remember when the bound started. Nothing downstream would ever rewrite
  # it, so the refusal could not end: exactly how a @gl_band this reader had
  # stopped understanding silenced patrol for five hours. Writing it is what the
  # absent case already did three lines up; the other two were the same case
  # wearing a different value.
  case "$since" in
    ''|*[!0-9]*) since="" ;;
    *) [ "$since" -le "$now" ] || since="" ;;
  esac
  if [ -z "$since" ]; then
    # This one stays fatal, and the difference is whose failure it is: above,
    # gang could not read what gang wrote; here tmux will not accept a write.
    # An unbounded busy state is the hazard the whole bound exists to prevent.
    tmux set-option -w -t "$1" @gl_activity_only_since "$now" 2>/dev/null \
      || die "cannot record the activity-only bound for pane $1 — refusing an unbounded busy state"
    since="$now"
  fi
  [ $(( now - since )) -lt "$GANG_ACTIVITY_LIMIT" ] && return 0
  return 2
}

# ===[ turn-bracket ]=========================================================
#
# The harness's own account of whether a turn is running: the event tier for
# busy/idle (ADR-0008). The harness fires `gang hook` at named
# moments and the verb writes one window option: UserPromptSubmit opens the
# bracket, Stop closes it, PostToolUse refreshes the open one. Every scrape in
# this file sits below it, and the pane stays the only witness for everything the
# events cannot see — boot, death, and a dialog nobody dismissed.
#
# Shape is @gl_compacting's, because a fact with an epoch already exists here and
# a second convention is a second thing to get wrong: one space-separated string,
# named fields out of `read -r`, timestamp trailing the value it stamps.
#
# THE EPOCH IS NOT DECORATION. `Stop` is silent on an Esc interrupt and silent on
# a crash — verified against the vendor's own docs, ADR-0008 — so an open bracket
# with nobody left to close it is the ordinary end of an interrupted turn, not an
# exotic failure. The bound is the only thing that covers those two, and without
# it the fact this file trusts most is also the one that can never be wrong.
TURN_STATE=""
TURN_AT=0
turn_state_read() { # $1 = window id; populate TURN_STATE/TURN_AT; 1 = absent, 2 = malformed
  local raw
  raw="$(tmux show-options -wqv -t "$1" @gl_turn 2>/dev/null)" || raw=""
  TURN_STATE=""; TURN_AT=0
  [ -n "$raw" ] || return 1
  read -r TURN_STATE TURN_AT _ <<<"$raw"
  # Both halves are checked before either is believed. A value carrying a state
  # this reader does not know is not a bracket in some other shape — it is a
  # value gang cannot interpret, and interpreting it anyway is how a fact layer
  # starts inventing answers.
  case "$TURN_STATE" in
    open|closed) ;;
    *) TURN_STATE=""; return 2 ;;
  esac
  [[ "$TURN_AT" =~ ^[0-9]+$ ]] || { TURN_STATE=""; return 2; }
}

turn_state_write() { # $1 = window id, $2 = open|closed; the fact, stamped now
  # Never fatal, and that is the ADR's answer rather than a lapse from law 8. A
  # translator that can fail its harness's own turn is the self-management loop
  # law 7 forbids wearing a new coat, so a hook writes its fact and steps aside.
  # A fact that cannot be written simply does not arrive, the reader falls to the
  # tier below, and the loudness lives one level up: an expected fact that stops
  # arriving surfaces as expiry, which is a state an operator can see.
  tmux set-option -w -t "$1" @gl_turn "$2 $(date +%s)" 2>/dev/null || true
}

turn_state_clear() { tmux set-option -uw -t "$1" @gl_turn 2>/dev/null || true; }

agent_name_of() { # $1 = window id; the name a log row is filed under
  tmux display-message -p -t "$1" '#W' 2>/dev/null || printf 'COULD-NOT-DETERMINE'
}

turn_mark() { # $1 = window id, $2 = open|closed; write the fact, log the transitions
  local prev=""
  turn_state_read "$1" && prev="$TURN_STATE"
  turn_state_write "$1" "$2"
  # Transitions log and heartbeats do not (ADR-0008). PostToolUse fires once per
  # tool call, so a row apiece would bury the two rows a postmortem actually
  # reads under a transcript gang already refuses to keep a second copy of.
  #
  # The test is the STATE, not the event that carried it: an open following an
  # open is a heartbeat whatever fired it, and what rows is a close, an open after
  # a close or after nothing at all, or a write following a value the reader threw
  # away.
  #
  # An expiry is NOT in that list, and the omission is deliberate. A bracket past
  # its bound still stores `open`, so the next open matches it and writes no row —
  # the expiry was a reading, and it left no mark here to compare against. Closing
  # that would mean deciding freshness at write time, which is exactly the
  # smartness ADR-0008 keeps out of the write path; the log loses one row for a
  # turn that resumed after a long silence, and the reader still reports it
  # correctly.
  [ "$prev" != "$2" ] || return 0
  patrol_log "$(agent_name_of "$1")" turn-bracket "bracket $2"
}

turn_pane_still_writing() { # $1 = window id; 0 = the pty is being written to now
  # NOT recently_active, and the difference is what each is FOR. That one asks
  # whether pty activity may carry a busy verdict on its own, so it owns the
  # activity-only episode bound that stops it carrying one forever. This asks a
  # narrower question with no verdict attached — is something writing to this
  # pane right now — and starting an episode bound from a path that claims
  # nothing would put a fact somewhere its consumer is not (law 5).
  #
  # The same declaration gates both, for the same reason. A harness that repaints
  # at rest writes bytes on a pane where nothing is happening, so there this
  # question has no answer rather than a false one, and the caller keeps the
  # bracket it already had.
  [ "${GANG_QUIET_AT_REST:-}" = 1 ] || return 1
  require_whole GANG_ACTIVITY_WINDOW "$GANG_ACTIVITY_WINDOW" seconds
  local stamped now
  # Refuses rather than guesses, the way busy_painted already does on this same
  # path — consuming an unreadable stamp as "nothing is writing" is exactly the
  # silent inversion the caller below exists to stop making.
  stamped="$(tmux display-message -p -t "$1" '#{window_activity}' 2>/dev/null)" \
    || die "cannot read pty activity for pane $1 — refusing to consume unknown as a quiet pane"
  case "$stamped" in
    ''|*[!0-9]*) die "tmux returned an unreadable activity stamp for pane $1: '$stamped'" ;;
  esac
  now="$(date +%s)"
  [ "$stamped" -le "$now" ] || die "tmux returned a future activity stamp for pane $1: $stamped > $now"
  [ $(( now - stamped )) -lt "$GANG_ACTIVITY_WINDOW" ]
}

turn_witness() { # $1 = window id; 0 busy, 1 idle, 2 could-not-determine, 3 no event tier
  local rc=0 now
  turn_state_read "$1" || rc=$?
  case "$rc" in
    0) ;;
    1) return 3 ;;
    2) # gang wrote this value and gang cannot read it back. @gl_band's precedent
       # is rebuild rather than refuse, and there is nothing here to rebuild —
       # whether a turn is open is exactly what was lost — so the mark is
       # discarded the way an unreadable @gl_waiting is, leaving the next event
       # to heal it. What this read must NOT do is spend an unparseable fact as
       # "no turn open": that inverts a fact it could not read into the one
       # answer that lets a send land in a live turn.
       turn_state_clear "$1"
       BUSY_EXPIRED_WHAT="turn-bracket value unreadable"
       return 2 ;;
    *) die "internal: turn_state_read returned unknown verdict $rc" ;;
  esac
  require_whole GANG_TURN_LIMIT "$GANG_TURN_LIMIT" seconds
  now="$(date +%s)"
  # A closed bracket does not expire ON AGE, and the asymmetry is the point rather
  # than an oversight. An OPEN bracket claims a turn is running, and turns end, so
  # the claim decays with nothing to renew it. A CLOSED bracket claims no turn is
  # open, and on this harness only an event can open one — so age alone adds no
  # doubt to it, and bounding it on age alone would report every genuinely idle
  # agent as could-not-determine within minutes, which is the tool not working.
  #
  # What age buys is the right to LOOK. The residual this used to name and leave
  # standing: if the hooks stop firing altogether while the bracket reads closed,
  # the fact that would have expired is the one that never arrived, so the bracket
  # witnesses idle over a working agent forever — silent, permanent, and in the
  # one direction that lets a send land in a live turn.
  #
  # So the bracket keeps the verdict until it is older than the bound an OPEN one
  # gets, and past that it keeps the verdict only while nothing contradicts it.
  # GANG_TURN_LIMIT rather than a number of this branch's own, because it is the
  # same question asked of the other state word — how long is this bracket's claim
  # good for without renewal — and a second bound is a second thing to tune wrong.
  # It also has to clear the tail of the turn that just ended: Stop fires while the
  # harness is still drawing its last frame, and a grace shorter than that would
  # report an agent expired seconds after every turn it finished.
  #
  # THE PTY AND NOT THE PAINT, which is why turn_vets_paint below still only
  # records. A painted marker carries no timestamp, so a rotted regex matching
  # static transcript text would pin an idle agent at the wrong answer with
  # nothing to age it out. The pty signal carries tmux's own stamp, so a
  # disagreement built on it is bounded by construction and heals the moment the
  # writing stops. Measured rather than assumed: an idle claude-code pane wrote
  # nothing at all after Stop — one distinct window_activity stamp across 40
  # samples spanning 172 seconds, equal to the second the bracket closed — while
  # two working agents in the same session ticked on nearly every sample.
  #
  # The bracket loses the power to say idle without gaining the power to say busy.
  # This returns the third answer and the tiers below answer on their own merits,
  # exactly as they already do for an expired OPEN bracket — so a pane genuinely
  # working reads busy off the pty, and one merely touched falls through to churn
  # like any other. The pty usually answering next is a lower tier winning on its
  # own evidence, not this branch voting with it.
  #
  # WHAT IS LEFT, named rather than argued away. The exposure is bounded, not
  # closed: for the first GANG_TURN_LIMIT after a close, a working agent whose
  # hooks have died still reads idle. Closing that means bounding a closed bracket
  # on age alone, which is the paragraph above. And a harness that does not declare
  # quiet-at-rest offers no signal to look at, so there the residual stands in
  # full — every harness carrying an event tier today declares it.
  #
  # One benign firing, kept deliberately: an operator typing into the composer of
  # an agent idle longer than the bound reads could-not-determine until they stop.
  # That is close enough to true to leave standing — a send landing there would
  # interleave with what they are typing — and it heals in GANG_ACTIVITY_WINDOW.
  if [ "$TURN_STATE" != open ]; then
    [ $(( now - TURN_AT )) -ge "$GANG_TURN_LIMIT" ] || return 1
    turn_pane_still_writing "$1" || return 1
    BUSY_EXPIRED_WHAT="turn-bracket closed while the pane kept being written to"
    return 2
  fi
  # A stamp from the future has no freshness left to test, so it reads the same
  # could-not-determine an unparseable one does — but it is NOT discarded the way
  # that one is, and the asymmetry is the point. A malformed value can never be
  # true, so clearing it loses nothing and restores an honest "no event tier". A
  # future stamp can be true: a backward clock step makes a genuinely open bracket
  # written seconds ago read as future, and clearing that would throw away a
  # correct fact and drop a live turn to the scrape tier. So it stands and reads
  # could-not-determine until any event overwrites it — one heartbeat away on a
  # live turn, and never on a dead one, which is the direction law 8 wants.
  #
  # Its own qualifier, by this file's own rule that two different exhausted
  # signals under one wording is a fabricated status. They are not fixed the same
  # way: one says the clock moved, the other says something wrote a value gang
  # cannot read.
  [ "$TURN_AT" -le "$now" ] \
    || { BUSY_EXPIRED_WHAT="turn-bracket stamped in the future"; return 2; }
  # WHAT THIS BOUND IS ACTUALLY CLOSING, measured rather than imagined: a turn
  # whose permission dialog is Esc-dismissed or explicitly denied ends in the pane
  # — the composer comes back — and fires NO Stop. Watched twice, ending at +12s
  # and +15s with the event counts frozen. So a dismissed dialog leaves a bracket
  # that nothing will ever close, and expiry is its only closer. That is why the
  # answer here is could-not-determine and not idle: the pane is idle-SHAPED in
  # exactly this case, and reading the shape would be the assumption this whole
  # tier exists to stop making.
  #
  # THE OCCUPANCY RAISE DOES NOT BELONG HERE, and working out why is worth more
  # than the branch would have been. A turn paused at a permission dialog outlives
  # any bound this can safely carry — nothing heartbeats while a dialog is up — so
  # a fresh raise looks like exactly the fact that should explain a stale bracket
  # and keep it from expiring into noise.
  #
  # It cannot, because occupancy strictly DOMINATES busy. occupied() consults the
  # same raise as its own first tier and answers on it, every caller of busy() asks
  # occupied() first and returns on that answer, and a raise the pane has retired is
  # cleared by that call before this one could read it. So the state where this
  # branch would fire is the state nobody reaches: the operator is told `occupied`,
  # which is both truer and more actionable than a busy they cannot send into. A
  # branch here would be a second reader of one fact that can never disagree with
  # the first — dead by construction rather than by oversight (law 5).
  #
  # What is left uncovered is the window AFTER the dialog is answered and before
  # the harness fires its next event, where this bracket can read expired with the
  # raise already retired. Closing that needs a fact that outlives the dialog, and
  # a lingering raise is precisely what would let a crashed turn borrow a dialog's
  # alibi — so it is named here rather than reached for.
  [ $(( now - TURN_AT )) -lt "$GANG_TURN_LIMIT" ] \
    || { BUSY_EXPIRED_WHAT="turn-bracket bound reached"; return 2; }
  return 0
}

turn_vets_paint() { # $1 = window id; the event tier vetting the scrape tier, for free
  # Tiers pick witnesses; they do not vote (ADR-0008). So when the bracket says
  # closed and the pane paints a busy marker, this does not average them and does
  # not switch verdicts — the higher tier still wins, and the disagreement is
  # recorded as a FINDING. An event saying idle under a pane still painting a
  # spinner means the scrape regex has almost certainly rotted, which is a thing
  # about gang rather than about the agent.
  #
  # Written down on every read it is detected on, not once per episode. A standing
  # disagreement therefore writes a row per sweep, which is the loud direction and
  # the rotated log bounds what it costs; the alternative is a second window
  # option nothing reads until vet grows the surface, and a fact nobody reads the
  # day it merges does not merge (law 5).
  busy_painted "$1" || return 0
  # A DIFFERENT PREDICATE'S OWNED EVENT CAN ACCOUNT FOR THE PAINT, and when one
  # does the row still prints — as an explanation instead of a finding. Dropping
  # it would make the surface an operator reads to watch scraping misbehave go
  # quiet on the one state that most resembles it, and a guard that leaves no
  # trace cannot be told apart from a reader that stopped running.
  if compaction_explains_paint "$1"; then
    patrol_log "$(agent_name_of "$1")" turn-bracket \
      "paint explained: the bracket closed and the busy marker is painted, and @gl_compact_bracket is open and fresh ($COMPACT_TRIGGER) — a compaction paints the same marker and opens no turn, so this is not a rotted scrape"
    return 0
  fi
  patrol_log "$(agent_name_of "$1")" turn-bracket \
    "TIER DISAGREEMENT: bracket closed but the busy marker is painted — scrape regex suspect"
}

# Which evidence ran out, so the third answer can name itself. busy() sets this
# whenever it returns 2 and every phrase an operator reads is built from it: two
# different exhausted signals reported under one wording is a fabricated status
# (law 8), and the two are not fixed the same way.
BUSY_EXPIRED_WHAT="pty activity bound reached"
# ===[ /turn-bracket ]========================================================

busy() { # $1 = window id; 0 = busy, 1 = not busy, 2 = could not determine
  # The transport question — "will a send land at a sane boundary?" — which is
  # the same as the pane question everywhere except one case.
  #
  # An agent parked in gang's own `gang wait` is inside a harness turn. Accepting
  # a mid-turn paste is not enough to make it available: opencode and the other
  # queueing harnesses submit that paste only after the running turn — the wait —
  # ends. Only a profile witnessed ACTING on ordinary text inside the current
  # turn may override busy here. state_now still reports every waiter as PARKED,
  # because available and idle are different claims.
  #
  if [ "${GANG_MIDTURN_ACTS:-}" = 1 ] && parked "$1"; then
    activity_hold_clear "$1"
    return 1
  fi
  # The highest tier that is still fresh answers, and nothing below it is
  # consulted (ADR-0008): a fresh bracket beats paint, and paint beats pty. No
  # blending and no scoring — a witness is chosen, and the ones underneath it are
  # evidence about GANG when they disagree, not evidence about the agent.
  #
  # Expiry is the one case that does not short-circuit, and it behaves exactly as
  # the pty arm's expiry already does below: an exhausted fact loses its power to
  # SAY busy without gaining the power to say idle. Positive evidence from a lower
  # tier still wins on its own merits; what the expired fact forbids is concluding
  # idle from silence, which would be reading it as last-known-good inverted.
  local turn_rc=0 undetermined=0
  # Reset per call: a roster asks this of every agent in one process, and a
  # reason left over from the previous one would name the wrong exhausted signal
  # on the next.
  BUSY_EXPIRED_WHAT="pty activity bound reached"
  turn_witness "$1" || turn_rc=$?
  case "$turn_rc" in
    0) activity_hold_clear "$1"; return 0 ;;
    1) turn_vets_paint "$1"; activity_hold_clear "$1"; return 1 ;;
    2) undetermined=1 ;;
    3) ;;
    *) die "internal: turn_witness returned unknown verdict $turn_rc" ;;
  esac
  if busy_painted "$1"; then
    activity_hold_clear "$1"
    return 0
  fi
  # ORed with churn below rather than replacing it, and the redundancy is
  # deliberate. Every pair churn calls moving is one this also calls moving — a
  # cksum cannot change without bytes — so as sets of detected-busy states this
  # SUBSUMES churn and the disjunct looks like it can never contribute a case.
  # That is true only while this signal behaves as measured. Keeping churn costs
  # nothing when it does and degrades to exactly today's behaviour if it ever
  # stops: a tmux that does not stamp it, a harness that starves it, a mechanism
  # that goes away in a release. That is a fallback for the signal being
  # UNAVAILABLE, which is a different thing from the disjunction that once made a
  # probe unable to fail — and the difference is that the suite asserts this arm
  # on its own, so it can still be caught being wrong.
  local activity_rc=0
  recently_active "$1" || activity_rc=$?
  case "$activity_rc" in
    0) return 0 ;;
    1) ;;
    2) undetermined=1 ;;
    *) die "internal: recently_active returned unknown verdict $activity_rc" ;;
  esac
  # A missing marker is not a missing turn, and there is nothing to widen a
  # branch onto. claude-code marks THINKING and leaves the rest bare: of 220
  # samples with the pane demonstrably changing, 19 carried any branch of the
  # busy regex, and the longest unbroken run of live-but-unmarked samples was 64
  # — about 16 seconds. Compared over the whole pane, a mid-stream screen is
  # transcript text, rule, empty composer, rule, context beacon, permissions
  # line: the idle screen exactly, with no line present in one and absent from
  # the other. So this is not a scan-depth problem and not a pattern problem.
  #
  # The only difference is that it keeps changing, which is not a question a
  # single frame can be asked. Markers demote to a fast path — a marked pane
  # never pays for the second capture — and churn answers for everything they
  # miss. The check scrapes nothing, so unlike a marker it cannot rot, and gang
  # already trusts it to mean "quietly idle" where a resume and a nudge are held.
  #
  # Churn is content-blind, so on its own it would call a pane parked in `gang
  # wait` busy — the false busy the parked branch above exists to kill. That
  # collision does not arise, because the exclusion is by state gang OWNS
  # (@gl_waiting, holding the waiter's pid) rather than by matching the screen.
  #
  # $2 is that same answer resolved ahead of time for a whole team at once, so a
  # roster pays one sleep rather than one per agent. Absent, this asks for itself.
  case "${2:-}" in
    churning) activity_hold_clear "$1"; return 0 ;;
    still)    [ "$undetermined" -eq 1 ] && return 2; return 1 ;;
  esac
  if pane_stable "$1"; then
    [ "$undetermined" -eq 1 ] && return 2
    return 1
  fi
  activity_hold_clear "$1"
  return 0
}

# Churn costs two captures separated by a wait, and asking each agent in turn
# makes a roster O(agents) in wall clock — the most-used command, growing with
# the size of the team it exists to show. So the question is asked for everyone
# at once: probe each pane, keep only the ones no marker and no owned state has
# already answered, wait ONCE, and re-read that set. A marked pane never reaches
# the second capture, so it is cheaper here than it was before churn existed.
#
# This makes the per-pane interval VARIABLE — the wait plus however long the
# batch itself takes — where a lone busy() uses a fixed one. It can never be
# SHORTER than the wait, and a longer interval only makes movement easier to
# catch, so the error moves toward calling a live pane busy. Safe direction.
#
# Skipping an agent here is always safe: whatever is not resolved falls through
# to the per-agent path in busy(), which is what every caller did before.
CHURN_MAP=""

map_get() { # $1 = "k=v k=v ...", $2 = key -> value on stdout
  local pair
  for pair in $1; do
    case "$pair" in "$2="*) printf '%s' "${pair#*=}"; return 0 ;; esac
  done
  return 1
}

churn_verdict() { # $1 = window id -> "churning" | "still" | "" if it was not sampled
  map_get "$CHURN_MAP" "$1" || true
}

churn_first_sample() { # $1 = window id, $2 = profile -> first pane checksum
  # Kept outside the command substitution that consumes it. Bash 3.2 scans that
  # substitution with a parser that can treat an apostrophe in a comment as an
  # opening quote; putting the logic in a function leaves only one plain call in
  # that fragile lexical context.
  load_profile "$2"
  # state_now names every live waiter before asking busy(), so no parked pane
  # needs a churn verdict regardless of ACTS/QUEUES.
  if parked "$1"; then activity_hold_clear "$1"; return 1; fi
  if busy_painted "$1"; then activity_hold_clear "$1"; return 1; fi
  local activity_rc=0
  recently_active "$1" || activity_rc=$?
  # Fresh activity is the fast path. Expired activity MUST reach the churn
  # sample: movement can still prove busy independently, while a still pane
  # preserves the third verdict from busy() for state_now.
  [ "$activity_rc" -eq 0 ] && return 1
  capture "$1" | cksum | tr ' ' '-'
}

churn_batch() { # $@ = window ids; resolve the churn question for all of them at once
  local id prof pending="" first="" sum was
  CHURN_MAP=""
  for id in "$@"; do
    prof="$(tmux show-options -wqv -t "$id" @gl_profile)" || continue
    [ -n "$prof" ] || continue
    profile_file "$prof" >/dev/null 2>&1 || continue
    # Subshelled for two reasons. A pane gang cannot read costs this agent its
    # batching rather than costing the whole roster its state column; and
    # load_profile is per agent, so without the subshell the profile read last
    # would leak into every state read after it.
    #
    # cksum rather than the screen itself, because holding a team's worth of
    # captures means arrays this file does not use. Its byte count is the second
    # field, so a false match needs a collision at identical length — but the
    # cost of being wrong matters more than the odds of it: a false match reads
    # as unchanged, which reads as not churning, which reads as IDLE. That is the
    # false-idle direction, the one this whole state path exists to close.
    #
    # It is also the single place gang trades exactness for cost. pane_stable
    # compares full screen text; this compares 32 bits. They are not the same
    # test, and what holds them to the same answer is the suite asserting the
    # batched column against the per-agent read on one pane.
    sum="$(churn_first_sample "$id" "$prof" 2>/dev/null)" || continue
    [ -n "$sum" ] || continue
    pending="$pending $id"
    first="$first $id=$sum"
  done
  [ -n "$pending" ] || return 0
  require_interval GANG_CHURN_WAIT "$GANG_CHURN_WAIT"
  sleep "$GANG_CHURN_WAIT"
  for id in $pending; do
    sum="$( capture "$id" 2>/dev/null | cksum | tr ' ' '-' )" || continue
    was="$(map_get "$first" "$id")" || continue
    if [ "$sum" = "$was" ]; then CHURN_MAP="$CHURN_MAP $id=still"
    else CHURN_MAP="$CHURN_MAP $id=churning"; fi
  done
}

compacting() { # $1 = window id, profile loaded; exit 0 if the harness is visibly compacting
  # A narrower question than busy, asked for one reason: a compaction is the one
  # turn a message can be handed to safely. Busy says a turn is in flight, and a
  # turn in flight is exactly what eats a resume. Compaction is a turn that reads
  # no input, so text typed into it can only wait — which makes "compaction is
  # running" the earliest moment a resume is safe, and the pane shows it plainly.
  # Unset is a real answer, not a hole: a profile whose compaction nobody has
  # watched live gets the settle path, which scrapes no marker at all.
  [ -n "${GANG_COMPACTING_REGEX:-}" ] || return 1
  local pane
  pane="$(capture_status "$1")" || die "cannot read pane $1 — refusing to guess compaction state"
  re_match GANG_COMPACTING_REGEX "$pane" || return 1
  # Claude Code's marker is a single bar glyph, and this repo's own profiles are
  # full of them: an agent reading profiles/claude-code.sh puts ▰ on its screen.
  # Believing that is worse than missing a real compaction, because the resume
  # then goes into the turn it was supposed to follow — the exact overtaking the
  # waiter exists to prevent. Compaction reads no input and leaves the box drawn
  # and empty (watched frame by frame), so an occupied box says this is an
  # ordinary turn with the glyph somewhere in it, and the waiter keeps waiting.
  input_clear "$1"
}

# Gang types the compaction itself — cmd_compact injects GANG_COMPACT_CMD, and an
# agent compacting itself is told to go through `gang compact <self>` — so gang
# KNOWS one is in flight without looking for it. That fact is recorded on the
# window instead of inferred from the pane, because an owned signal cannot rot,
# and rot is the whole disease here: three declared markers went dead in one
# session, each a different way, and every one of them passed `gang vet`.
#
# It answers exactly ONE question: may patrol's context nudge inject into this
# pane. It is deliberately NOT wired into compacting(), which answers a different
# one. patrol's budget nudge does not ask it and says at its own site why the
# argument for asking does not reach that axis.
# resume_after_compaction breaks the instant compacting() is true and needs that
# to mean "the turn that could have eaten this resume is OVER"; this mark is set
# while the compaction is still QUEUED BEHIND that very turn, so handing it to
# that caller would rebuild the overtaking the waiter exists to prevent. One
# signal answering two questions is how the bar glyphs came to carry both busy
# and compacting, and it is not being rebuilt here.
#
# It covers gang-issued compaction only. A harness auto-compacting at its own
# threshold is invisible to this, and that is exactly when patrol is sweeping,
# because patrol nudges at a high context band and a harness auto-compacts at
# one. The split is deliberate rather than overlooked, because the two differ in
# severity: a gang-issued compaction has a queued resume in flight, so a nudge
# there is precisely the overtaking the waiter exists to prevent, while an
# auto-compaction has no pending resume, so a nudge is queued, delivered late,
# and burns a band — noisy, not corrupting. The dangerous case is covered.
compaction_mark() { # $1 = target; record that WE issued one, with the tokens at issue
  # Two fields, and the second is the whole point: resume_after_compaction proves
  # a compaction happened by watching the context fall BELOW where it stood when
  # the command was typed. A zero means no readable context at issue, and the
  # waiter falls back to its own clock rather than to a number it never had.
  local at=0 ctx tw tokens window now
  now="$(date +%s)"
  if declare -F profile_context >/dev/null \
     && ctx="$(context_now "$1" 2>/dev/null)" \
     && tw="$(ctx_tokens "${ctx%%$'\n'*}")"; then
    read -r tokens window <<<"$tw"; at="$tokens"
  fi
  tmux set-option -w -t "$1" @gl_compacting "$now $at" 2>/dev/null || true
}

compaction_clear() { tmux set-option -uw -t "$1" @gl_compacting 2>/dev/null || true; }

# ===[ compaction-bracket ]===================================================
#
# The harness's own account of a compaction: the event tier for the compaction
# predicate (ADR-0008), sitting above both the mark below it and the pane scrape
# below that. PreCompact opens the bracket, PostCompact closes it, and `gang hook`
# is the one verb that writes it — the same shape as @gl_turn, deliberately, since
# a second convention for a stamped fact is a second thing to get wrong.
#
# WHAT IT ANSWERS THAT THE MARK CANNOT, which is the whole reason it exists. The
# mark above is gang-issued-only and is written while the compaction is still
# QUEUED behind the current turn — so it says a compaction was ASKED FOR, and it
# says nothing at all about a harness compacting at its own threshold. This fires
# when a compaction ACTUALLY STARTS, whoever started it. Auto-compaction was the
# hole the mark's own comment names, and this is the thing that sees it.
#
# THE TRIGGER IS STORED BECAUSE THE TWO CASES ARE NOT THE SAME EVENT. Both
# payloads carry `trigger`, values manual and auto, and an operator reading a held
# nudge needs to know which one held it: a manual compaction has a resume in
# flight behind it, an auto one has nothing behind it at all. Anything else the
# payloads carry is dropped — compact_summary alone is most of a PostCompact
# body, and gang keeps no second copy of a transcript.
#
# NOT WIRED INTO compacting(). That reader breaks the instant it is true and hands
# resume_after_compaction a "the dangerous turn is over" it must not be given
# early — and unlike the mark, this fact would be RIGHT to give it, since the
# bracket opens when compaction is genuinely underway. It is left unwired because
# nothing in this arc consumes it there (law 5) and the failure mode of getting
# that timing wrong is a resume overtaking the turn it was meant to follow. The
# opportunity is named here rather than taken.
COMPACT_STATE=""
COMPACT_AT=0
COMPACT_TRIGGER=""
compaction_trigger_of() { # $1 = whatever the payload said; the fact vocabulary, closed
  # Three values and no others, so the stored fact can never carry a space or a
  # newline into a space-separated record, and so an absent field reads as the
  # unknown it is instead of defaulting to the commoner of the two — which would
  # be gang telling an operator which kind of compaction this was on no evidence.
  case "$1" in manual|auto) printf '%s' "$1" ;; *) printf 'unknown' ;; esac
}

compaction_bracket_read() { # $1 = window id; sets COMPACT_*; 1 = absent, 2 = malformed
  local raw
  raw="$(tmux show-options -wqv -t "$1" @gl_compact_bracket 2>/dev/null)" || raw=""
  COMPACT_STATE=""; COMPACT_AT=0; COMPACT_TRIGGER=""
  [ -n "$raw" ] || return 1
  read -r COMPACT_STATE COMPACT_AT COMPACT_TRIGGER _ <<<"$raw"
  # All three fields before any of them, @gl_turn's rule: a record gang cannot
  # fully interpret is not a bracket in some looser shape, and reading the part it
  # recognises out of one it does not is how a fact layer starts inventing.
  case "$COMPACT_STATE" in
    open|closed) ;;
    *) COMPACT_STATE=""; return 2 ;;
  esac
  [[ "$COMPACT_AT" =~ ^[0-9]+$ ]] || { COMPACT_STATE=""; COMPACT_AT=0; return 2; }
  case "$COMPACT_TRIGGER" in
    manual|auto|unknown) ;;
    *) COMPACT_STATE=""; COMPACT_AT=0; COMPACT_TRIGGER=""; return 2 ;;
  esac
}

compaction_bracket_write() { # $1 = window id, $2 = open|closed, $3 = trigger
  # Never fatal, for @gl_turn's reason: a hook that can fail its harness's own
  # turn is the self-management loop law 7 forbids. A fact that cannot be written
  # does not arrive, the reader falls to the tier below, and the loudness lives
  # one level up where an expected fact that stops arriving surfaces as expiry.
  tmux set-option -w -t "$1" @gl_compact_bracket \
    "$2 $(date +%s) $(compaction_trigger_of "$3")" 2>/dev/null || true
}

compaction_bracket_clear() { tmux set-option -uw -t "$1" @gl_compact_bracket 2>/dev/null || true; }

compaction_bracket_mark() { # $1 = window id, $2 = open|closed, $3 = trigger
  local prev=""
  compaction_bracket_read "$1" && prev="$COMPACT_STATE"
  compaction_bracket_write "$1" "$2" "$3"
  # Transitions row and heartbeats do not, @gl_turn's rule again. Nothing
  # heartbeats a compaction bracket today — the two events fire once each — so
  # this is not yet load-bearing the way turn_mark's is; it is written the same
  # way anyway, because the day a harness fires PreCompact twice is not the day
  # anybody wants to discover that a log family grew a heartbeat.
  [ "$prev" != "$2" ] || return 0
  patrol_log "$(agent_name_of "$1")" compaction-bracket \
    "compaction $2 ($(compaction_trigger_of "$3"))"
}

compaction_explains_paint() { # $1 = window id; 0 = a live compaction accounts for the paint
  # THE PAINT HAS A SECOND LAWFUL AUTHOR, and it is not the agent's turn. A
  # compaction repaints the same progress bar a working turn does, and a shipped
  # profile's GANG_BUSY_REGEX matches that bar BY DESIGN — patrol and every send
  # want a compacting pane to read busy, and claude-code's declaration says so
  # where the pattern is written. A compaction also opens no turn, so @gl_turn is
  # legitimately CLOSED throughout. Closed bracket over painted marker is exactly
  # the fixture the busy-tier disagreement is built to report, and here nothing is
  # wrong with anything: for the length of every compaction a perfectly healthy
  # agent was reported as a rotted scrape, on both surfaces, and under
  # --file-issue it would open a GitHub issue about it.
  #
  # ASKING THIS IS WITNESS SELECTION, NOT VOTING (ADR-0008). Neither busy-tier
  # witness is overruled and nothing is averaged: the bracket still answers idle,
  # the paint is still on the pane, and busy() returns what it returned before.
  # What changes is the CLAIM MADE ABOUT THE DISAGREEMENT — the row does not
  # report a state, it reports a diagnosis, that gang's own scrape has rotted —
  # and a different predicate's owned event says something else painted that
  # marker. An alternative explanation for the evidence is not a third vote on the
  # verdict.
  #
  # THE MARK TIER IS DELIBERATELY NOT CONSULTED, and that is the line between this
  # and gang excusing itself. @gl_compacting records that gang TYPED /compact with
  # no proof it ran; letting gang's own record retire a disagreement between two
  # witnesses is the self-serving shape this function exists to avoid. Only the
  # harness's own event explains paint. It costs nothing: the bracket sees a
  # compaction the harness started at its own threshold, which the mark is blind
  # to by construction, and it correctly fails to see one asked for and never run.
  #
  # OPEN AND FRESH, BOTH, and the freshness half is the load-bearing one. A stale
  # open bracket is a compaction that never closed, and a stuck compaction is
  # worth a row rather than an excuse for one — so a single write can never buy
  # permanent silence on an agent. A CLOSED bracket explains nothing here even
  # though it stays valid at any age in compaction_pending: a close is a completed
  # event, and a compaction that has finished is not painting anything now.
  #
  # A READ, NEVER A WRITE. The malformed arm does not clear the option the way
  # compaction_pending's does. The bracket is that predicate's fact and this is a
  # borrowing reader; discarding it here would change what the owner is entitled
  # to find on its next read, and the owner already knows how to.
  local now rc=0
  compaction_bracket_read "$1" || rc=$?
  [ "$rc" -eq 0 ] && [ "$COMPACT_STATE" = open ] || return 1
  require_whole GANG_COMPACTION_LIMIT "$GANG_COMPACTION_LIMIT" seconds
  now="$(date +%s)"
  # A stamp from the future has no freshness left to test, compaction_pending's
  # rule: it does not answer here, and it is not cleared there.
  [ "$COMPACT_AT" -le "$now" ] || return 1
  [ $(( now - COMPACT_AT )) -lt "$GANG_COMPACTION_LIMIT" ] || return 1
  # COMPACT_TRIGGER is left set for the caller to name, and it is worth naming:
  # manual and auto are different events to an operator reading an exemption.
  return 0
}

# Which tier answered a pending verdict, so verdict 0 can name itself. Two
# different facts reported under one wording is a fabricated status (law 8), and
# these two really do differ: one says gang typed a command and has no proof it
# ran, the other says the harness announced a compaction that is running now.
COMPACTION_PENDING_WHAT="compaction gang issued, unconfirmed"

compaction_pending() { # $1 = window id, $2 = tokens NOW (optional)
  # 0 pending, 1 nothing pending, 2 issued but unproved past the grace. Two ways
  # out and a third answer, because each covers a case the others cannot see.
  local v issued at_issue now rc=0 closed_at=0
  now="$(date +%s)"
  COMPACTION_PENDING_WHAT="compaction gang issued, unconfirmed"

  # THE EVENT TIER, ahead of everything below it (ADR-0008): the harness saying a
  # compaction is running outranks gang's own record of having asked for one, and
  # it answers for the auto-compaction the mark below is blind to by construction.
  compaction_bracket_read "$1" || rc=$?
  case "$rc" in
    0) ;;
    1) ;;  # no bracket: a harness that fires no compaction events, or none yet
    2) # gang wrote this and gang cannot read it back. Discarded rather than
       # interpreted, @gl_turn's precedent — there is nothing to rebuild, since
       # whether a compaction is running is exactly what was lost — and the read
       # falls to the tier below instead of spending an unreadable fact as an
       # answer in either direction.
       compaction_bracket_clear "$1" ;;
    *) die "internal: compaction_bracket_read returned unknown verdict $rc" ;;
  esac
  if [ "$rc" -eq 0 ] && [ "$COMPACT_STATE" = open ]; then
    require_whole GANG_COMPACTION_LIMIT "$GANG_COMPACTION_LIMIT" seconds
    # A stamp from the future has no freshness left to test, so it does not answer
    # here — and it is NOT cleared, because a backward clock step can make a
    # genuinely open bracket read future and discarding it would throw away a true
    # fact. It stands until PostCompact overwrites it.
    #
    # Expiry falls THROUGH to the mark and scrape tiers rather than returning an
    # answer of its own. That is the ADR's shape for a spent fact: the tier stops
    # witnessing and the next one down is asked, which is precisely the state this
    # arc found the function in. A crash mid-compaction therefore costs the tier
    # it earned and nothing that was already there.
    if [ "$COMPACT_AT" -le "$now" ] && [ $(( now - COMPACT_AT )) -lt "$GANG_COMPACTION_LIMIT" ]; then
      COMPACTION_PENDING_WHAT="harness compaction in flight ($COMPACT_TRIGGER)"
      return 0
    fi
  elif [ "$rc" -eq 0 ] && [ "$COMPACT_AT" -le "$now" ]; then
    # A CLOSED bracket does not expire, and the asymmetry is the same one @gl_turn
    # draws. An open bracket claims something is happening, and claims like that
    # decay; a close is a completed event, and a completed compaction does not
    # become incomplete with age. So its epoch is carried down to the mark tier at
    # any age — but only as an ORDERING fact, because what it proves is bounded:
    # it settles a compaction issued before it ran, and says nothing whatever
    # about one typed after it finished.
    closed_at="$COMPACT_AT"
  fi

  v="$(tmux show-options -wqv -t "$1" @gl_compacting 2>/dev/null)" || return 1
  [ -n "$v" ] || return 1
  read -r issued at_issue <<<"$v"
  [[ "$issued" =~ ^[0-9]+$ ]] || { compaction_clear "$1"; return 1; }
  # The strongest proof this function can get, and it arrives before the guesses
  # below: the harness said a compaction finished, and it finished no earlier than
  # the moment gang typed the command. The context-drop check under this is the
  # same conclusion inferred from a number moving, and the clock under that is not
  # evidence at all. Ordered, not merged — a close BEFORE the issue is a different
  # compaction and proves nothing about this one, so it is left to fall through.
  if [ "$closed_at" -gt 0 ] && [ "$issued" -le "$closed_at" ]; then
    compaction_clear "$1"; return 1
  fi
  # The context drop is the positive one: a compaction that HAPPENED shows it,
  # and unlike the momentary zero the readout flashes on its way through, the
  # drop is monotone — it stays low — so no poll interval can step over it.
  #
  # Half is a CHOICE, not a threshold anybody measured a harness against. Every
  # compaction watched here reclaimed far more (246k to 48k, 161k to 44k), and a
  # harness that reclaims less simply rides the clock out instead: late, never
  # wrong, and late is the safe direction because the cost is a held nudge rather
  # than one delivered into a live compaction. An unexamined constant is the same
  # disease as an unexamined marker, so it is named here rather than left to look
  # like a measurement.
  if [ -n "${2:-}" ] && [[ "$2" =~ ^[0-9]+$ ]] \
     && [[ "$at_issue" =~ ^[0-9]+$ ]] && [ "$at_issue" -gt 0 ] \
     && [ "$2" -lt $(( at_issue / 2 )) ]; then
    compaction_clear "$1"; return 1
  fi
  # And the clock, because a compaction that never happened shows nothing at all:
  # `/compact` under a harness's own threshold leaves the context exactly where it
  # was (measured on a 30k pane — the command ran, the readout never moved), so a
  # mark trusted until the drop would hold patrol off that pane for good.
  #
  # `now` is the one read at the top, shared with the bracket tier above: two
  # `date` calls inside one verdict can straddle a second boundary and make this
  # function answer about two different instants.
  # Shared with resume_after_compaction, which uses the same number to decide when
  # to give up waiting for the drop; overrunning it there is corrupting, not noisy.
  #
  # Running the clock out is the THIRD answer and never the first, because it
  # establishes that gang waited and never that compaction ended. Verdict 2 says
  # exactly that and nothing more. What a caller may do with it is the caller's
  # question: the waiter treats it as time to stop waiting, and patrol treats it
  # as a mark that has stopped carrying information — reporting it once, clearing
  # it, and resuming. Neither reads it as proof a compaction happened.
  #
  # This function does not clear the mark here, so a caller that wants the fact
  # can still see it; the drop check above clears it on the positive evidence, and
  # a fresh request overwrites it.
  require_whole GANG_COMPACT_GRACE "$GANG_COMPACT_GRACE" seconds
  [ $(( now - issued )) -lt "$GANG_COMPACT_GRACE" ] || return 2
  return 0
}

# ===[ occupied-bracket ]=====================================================
#
# The harness's own account of a permission dialog: the event tier for the
# occupied predicate (ADR-0008), sitting above the two pane scrapes below it.
# PermissionRequest raises it, `gang hook` is the one verb that writes it, and the
# shape is the compaction bracket's — a stamped fact, every field validated before
# any of them is believed, written by a writer that can never be fatal.
#
# IT ONLY EVER RAISES, and that is forced rather than chosen. Verified against the
# vendor's own docs: PermissionRequest fires just before the dialog is presented,
# and NOTHING fires when it goes away — Esc, an explicit No, and the harness's own
# dismissal are all silent, and no Stop fires for it either. PermissionDenied is
# not the missing closer despite the name: it fires only for auto-mode classifier
# denials, which are decided with no dialog on screen at all, so wiring it would
# raise occupancy for a prompt nobody was ever shown.
#
# The record still carries a state word rather than a bare epoch, because a lone
# number is not self-describing: a foreign value landing in this option could not
# be told from a stamp, and the read below has to be able to refuse one.
#
# WHAT RETIRES A RAISE IS THE PANE, and that is not the scrape outvoting the event
# tier — tiers pick witnesses, they do not vote (ADR-0008). It is this fact
# reaching its end and the pane being able to prove it, the same shape as the
# compaction mark settling on an observed context drop. Expiry is the only other
# closer, and it costs the tier rather than answering with it.
#
# NOTHING IS READ OUT OF THE PAYLOAD. The dialog's tool name is the obvious field
# to keep and is deliberately dropped: no predicate consumes it (law 5), a tool
# name is an open vocabulary where `trigger` was a closed one, and an unbounded
# string has no business in a space-separated record.
OCCUPY_STATE=""
OCCUPY_AT=0

occupied_raise_read() { # $1 = window id; sets OCCUPY_*; 1 = absent, 2 = malformed
  local raw
  raw="$(tmux show-options -wqv -t "$1" @gl_occupied 2>/dev/null)" || raw=""
  OCCUPY_STATE=""; OCCUPY_AT=0
  [ -n "$raw" ] || return 1
  read -r OCCUPY_STATE OCCUPY_AT _ <<<"$raw"
  # Both fields before either of them, @gl_turn's rule. One state word is the whole
  # vocabulary here, so anything else is a record gang did not write.
  [ "$OCCUPY_STATE" = open ] || { OCCUPY_STATE=""; return 2; }
  [[ "$OCCUPY_AT" =~ ^[0-9]+$ ]] || { OCCUPY_STATE=""; OCCUPY_AT=0; return 2; }
}

occupied_raise_write() { # $1 = window id; never fatal (law 7)
  tmux set-option -w -t "$1" @gl_occupied "open $(date +%s)" 2>/dev/null || true
}

occupied_raise_clear() { tmux set-option -uw -t "$1" @gl_occupied 2>/dev/null || true; }

occupied_raise_mark() { # $1 = window id; the hook's writer
  local prev=""
  occupied_raise_read "$1" && prev="$OCCUPY_STATE"
  occupied_raise_write "$1"
  # A dialog raised while one is already up is a heartbeat and gets no row. The
  # stamp still moves, so a dialog answered and immediately re-raised carries its
  # own full bound instead of aging out on the first one's clock.
  [ "$prev" != open ] || return 0
  patrol_log "$(agent_name_of "$1")" occupied-bracket "permission dialog raised"
}

occupied_witness() { # $1 = window id; 0 = the event tier answers occupied
  local now rc=0
  occupied_raise_read "$1" || rc=$?
  case "$rc" in
    0) ;;
    1) return 1 ;;
    2) occupied_raise_clear "$1"; return 1 ;;
    *) die "internal: occupied_raise_read returned unknown verdict $rc" ;;
  esac
  require_whole GANG_OCCUPIED_LIMIT "$GANG_OCCUPIED_LIMIT" seconds
  now="$(date +%s)"
  # A future stamp is not discarded, for the turn bracket's reason: a backward
  # clock step makes a true raise read future, and clearing it would throw away a
  # live dialog and hand the pane to scrapes that may not have a name for it.
  [ "$OCCUPY_AT" -le "$now" ] || return 1
  [ $(( now - OCCUPY_AT )) -lt "$GANG_OCCUPIED_LIMIT" ] || return 1
  # THE CLEAR. A composer back on screen is the dialog gone: every dialog watched
  # live owns the screen while it is up, which is the same structural companion the
  # declared marker below leans on. Cleared rather than left to age out, so no
  # later reader is still answering off a dialog somebody dismissed minutes ago.
  if composer_live "$1"; then
    occupied_raise_clear "$1"
    return 1
  fi
  return 0
}
# ===[ /occupied-bracket ]====================================================

occupied() { # $1 = window id, profile loaded; exit 0 if a UI owns the input box
  # The third state, and the one that must not pass for the other two: a harness
  # whose own UI has displaced the composer is not working and not reachable —
  # keystrokes sent to it land IN that UI, where they ACT on it. Every occupied
  # pane watched live (claude-code, codex, opencode) also drops its busy hint and
  # its input box while the UI is up, so an undeclared one reads idle: patrol
  # holds a nudge on a box it cannot find, sends die "not taking input", and
  # nothing on any surface says a dialog is what the whole team is stalled on.
  # Lived it: three agents sat occupied for minutes and the only diagnostic was
  # capturing panes one by one.
  #
  # Occupancy is the whole of what this establishes. Who may clear the UI, and
  # whether it clears itself, is a different question with a different answer,
  # and no caller may read one off the other (ADR-0004).
  #
  # There are three ways in, because enumerating modal chrome will always miss
  # one — and the first of them does not read the pane for the answer at all. The
  # harness says a dialog went up, so nothing has to be recognised for this to be
  # true, which is exactly what the two scrapes below cannot manage: one needs a
  # marker somebody watched live, and the other infers occupancy from failing to
  # find a composer.
  if occupied_witness "$1"; then return 0; fi
  local pane
  if [ -n "${GANG_OCCUPIED_REGEX:-}" ]; then
    # The declared marker: the dialogs somebody has watched live, named in the
    # profile. Unset is a real answer — a profile whose gate nobody has watched
    # declares nothing and reaches this state only through the fallback below.
    #
    # The WHOLE pane, not the bottom rows. A dialog is drawn above the composer,
    # but it is drawn as tall as it needs to be, and its distinguishing wording is
    # not always in its last twenty rows: opencode's model picker paints its own
    # declared branch on the full pane and on NOTHING inside the status window, so
    # that branch was alive in the TUI and dead in the region gang read it from.
    # Nothing catches that by auditing markers for liveness — the marker is not
    # dead, only unreachable — so the scan is what has to widen.
    pane="$(capture_joined "$1")" || die "cannot read pane $1 — refusing to guess occupancy"
    if re_match GANG_OCCUPIED_REGEX "$pane"; then
      # The wording alone is not the gate. Every dialog watched live OWNS the
      # screen while it is up: the composer is gone, which is why an unmarked gate
      # read idle in the first place. So a match beside a live input box is the
      # harness talking ABOUT a prompt, not stopped at one — an agent reviewing
      # this repo, quoting a capture, or reading these very profiles. Lived it:
      # reviewers quoting the dialog wording froze their own lead and had their
      # reports refused, which is a denial of the whole control plane out of
      # ordinary prose.
      #
      # This check, not the scan depth, is what makes matching the whole pane
      # safe — and the pairing does not transfer. busy() and compacting() ask for
      # no box, so widening either of them the same way would believe any agent
      # that quotes a marker: measured on this team, compacting() would have read
      # true for three minutes off a reviewer's own grep output. Narrowing them to
      # the status window is not a defence either, it is luck — prose-quoted
      # markers landed inside the bottom twenty rows in 49 samples and outside it
      # in the rest. Anyone widening those two needs their own argument.
      composer_live "$1" || return 0
    fi
  fi
  # The fallback: a state gang cannot positively determine is occupied, not idle.
  # No busy hint, no marker, and no input box to be found is not evidence of an
  # agent waiting for work — it is evidence that something gang was never taught
  # to recognise is holding the screen (Claude Code's /model picker reads exactly
  # this way). Idle MEANS "go ahead and send", so calling the unknown idle loses
  # the message, and `gang wait` cannot rescue it either: the waiter keys on
  # BECOMING idle and the pane already reads idle. Occupancy costs a delay
  # instead, and reaching this branch is exactly the authority-unknown case:
  # gang cannot name a UI it was never taught to recognise.
  #
  # The box is asked about first because it is the cheap question and the common
  # answer: a box gang can find is not a box a modal has taken. It is also where
  # a profile that declares no input hook stops — gang cannot claim a box is
  # missing when it was never taught to find one, so such a profile keeps exactly
  # the busy/idle reading it always had.
  if input_painted "$1"; then return 1; fi
  # No box, then. That is a UI unless a turn in flight explains it: several
  # harnesses stop painting their composer while one runs. The PANE question,
  # not the transport one — an agent parked in `gang wait` has a turn in flight
  # and is not behind a UI, so asking busy() here would call it occupied the
  # moment its composer went missing for any other reason.
  ! busy_painted "$1"
}

pane_stable() { # $1 = window id; screen byte-identical across two captures ≈ quietly idle
  # Marker regexes are snapshots of a screen that may be actively redrawing —
  # at a turn boundary or during compaction, one capture can miss the spinner
  # and the next can miss the input-box content, and every guard reads a
  # different frame (lived it: patrol nudged mid-compaction and the note
  # jumped the harness's own input queue). A quietly idle TUI paints a static
  # screen; streaming, spinners and timers all churn. Scrapes no marker, so it
  # cannot rot.
  #
  # What it cannot do is tell a finished turn from a silent one, and the gap is
  # measured rather than supposed: a claude-code compaction paints nothing at
  # all and holds the screen byte-identical — 633 consecutive captures over 158
  # seconds, no marker of any kind on any of them — so this answers "stable"
  # straight through one. Any long silent stretch reads the same way: a test
  # run, a fetch, a large read. Stable means the PANE has stopped moving, which
  # is not the same claim as the agent having stopped working.
  local a b
  require_interval GANG_CHURN_WAIT "$GANG_CHURN_WAIT"
  a="$(capture "$1")" || die "cannot read pane $1"
  sleep "$GANG_CHURN_WAIT"
  b="$(capture "$1")" || die "cannot read pane $1"
  [ "$a" = "$b" ]
}

# A harness that declares an input box tells gang two things no generic screen
# scrape can: that the TUI is up at all, and that a paste would not land on top
# of something already typed. Profiles without one keep the generic path.
input_painted() { # $1 = window id; the harness has drawn an input box
  declare -F profile_input >/dev/null || return 0
  profile_input "$1" >/dev/null
}

input_clear() { # $1 = window id; nothing a person typed is sitting in that box
  # What counts as content is the PROFILE's answer, not this function's. A
  # profile that can tell suggestion text from typed text hands back only what
  # was typed, and an empty-looking box reads clear here even while the harness
  # is painting a placeholder into it; a profile that cannot tell hands back
  # everything, and its ghost text reads as a draft and holds. Both are correct
  # for the harness they describe (Law 4), and the difference is invisible here.
  declare -F profile_input >/dev/null || return 0
  local box
  box="$(profile_input "$1")" || return 1
  ! grep -q '[^[:space:]]' <<<"$box"
}

wait_ready() { # $1 = window id, $2 = timeout seconds; harness booted and quiet
  # Two conditions, because a booting harness passes either one alone.
  #
  # Quiet is not enough: for the first seconds the pane is EMPTY, and an empty
  # screen is a perfectly stable screen. Quiet alone therefore says "ready"
  # before the harness has read a byte of stdin, and the brief pastes into a
  # process that is not listening (lived it: `gang up` hitched a manager and
  # then failed to verify a brief that had gone nowhere). A painted input box
  # is the direct evidence that the TUI is up and taking input.
  #
  # The box's CONTENT is deliberately not tested, and paintedness is not a weaker
  # version of the same question. A fresh TUI paints a placeholder into its empty
  # box, and whether that reads as content depends on whether the profile can
  # tell suggestion text from typed text — so a content test would gate booting
  # on a per-harness capability that has nothing to do with whether the TUI is
  # up. On a profile that cannot tell, waiting for an empty box never returns at
  # all. Paintedness answers the question actually being asked here.
  # Exit 2 is the settled-but-not-an-input-box case, worth telling apart because
  # it is nearly always a first-run modal a human has to answer — Claude Code's
  # "Do you trust the files in this folder?". Its menu cursor is a "❯" too, but
  # indented, so no input box is found and gang refuses to paste a brief into a
  # security prompt.
  local t=0
  while [ "$t" -lt "$2" ]; do
    input_painted "$1" && pane_stable "$1" && return 0
    sleep 1; t=$((t + 1))
  done
  pane_stable "$1" && return 2
  return 1
}

# --- parked in gang's own wait ----------------------------------------------
# A window option, like every other piece of gang's state, so it dies with the
# window and `tmux show-options -w` is its whole debugger. The holder's pid goes
# inside for the same reason lock_pane keeps one: an option outlives the process
# that set it, so a waiter killed mid-wait would otherwise leave its agent
# reading available forever. The target name rides beside it so the state says
# what the wait is waiting ON instead of making the operator inspect the pane.
PARKED=0
PARKED_WAIT_TARGET=""
WAIT_STATE=""

unpark() { # drop OUR marker, never somebody else's
  [ "$PARKED" = 1 ] || return 0
  PARKED=0
  local w held
  w="$(self_window)" || return 0
  held="$(tmux show-options -wqv -t "$w" @gl_waiting 2>/dev/null)" || return 0
  [ "${held%% *}" = "$$" ] || return 0
  tmux set-option -uw -t "$w" @gl_waiting 2>/dev/null || true
}

# One EXIT trap for all three, because bash keeps only the last one installed and
# lock_pane, park_self and probe_start can be reached in either order (`send
# --wait` waits first and locks second; `send` locks without ever waiting).
#
# probe_teardown runs FIRST, and the order is load-bearing rather than tidy.
# unpark calls tmux, and while a probe is up the PATH shim is still installed, so
# running it before the shim comes off aims it at the PROBE server — precisely
# what the shim exists to prevent. probe_teardown restores PATH, so everything
# after it is aimed at the real one.
#
# Calling it unconditionally is safe by construction: it returns at its first
# line when no probe is running, and it clears its own state, so twice costs the
# same as once. That matters because cmd_vet also calls it on the success path.
on_exit() { probe_teardown; lock_release; unpark; }

park_self() { # $1 = target name; mark this window as blocked in gang's own wait
  # Not being in a pane is normal, not an error: gang runs from the operator's
  # own shell and from cron, and neither has an agent to mark.
  local w
  w="$(self_window)" || return 0
  tmux set-option -w -t "$w" @gl_waiting "$$ $1" 2>/dev/null || return 0
  PARKED=1
  trap 'on_exit' EXIT
}

parked() { # $1 = window id; exit 0 if a live gang wait is parked in that window
  local held holder
  PARKED_WAIT_TARGET=""
  held="$(tmux show-options -wqv -t "$1" @gl_waiting 2>/dev/null)" \
    || die "cannot read gang-wait state for pane $1 — refusing to guess parked/idle"
  [ -n "$held" ] || return 1
  holder="${held%% *}"
  case "$holder" in
    ''|*[!0-9]*)
      # Same rule as the activity bound, and the stakes are higher here: parked()
      # is on the path for status, roster, patrol AND send, so refusing over one
      # unreadable value took message delivery down for the whole life of the
      # window — not just a warning leg. It also never needed to guess. The
      # question is "is a live gang wait parked here", and a holder that is not a
      # pid names no live process, so the answer is no on the evidence rather
      # than by assumption. Discarding it is the same reclaim the dead-waiter
      # path below performs, for a mark that is dead in a different way.
      printf 'gang: discarded an unreadable gang-wait mark on pane %s: %s\n' "$1" "$held" >&2
      tmux set-option -uw -t "$1" @gl_waiting 2>/dev/null || true
      return 1 ;;
  esac
  case "$held" in
    *' '*) PARKED_WAIT_TARGET="${held#* }" ;;
  esac
  kill -0 "$holder" 2>/dev/null && return 0
  tmux set-option -uw -t "$1" @gl_waiting 2>/dev/null || true  # waiter died; reclaim
  PARKED_WAIT_TARGET=""
  return 1
}

wait_idle() { # $1 = window id, $2 = name, $3 = timeout seconds
  # Idle must hold for two consecutive polls: a just-submitted turn shows no
  # busy marker for a beat, and a single-shot check falls through that gap
  # (observed live — a send landed mid-turn and got queued). A gate is a dead
  # end, not a wait: only the operator clears it, so blocking on it is blocking
  # on a human nobody has told — and worse, a gate drops the busy hint, so a
  # waiter that cannot see it would read the dialog as idle and paste into it.
  local t=0 timeout="${3:-300}" streak=0 busy_rc=0
  WAIT_STATE=""
  # Marked for the whole wait, so a teammate reading this agent's state while it
  # blocks here sees available rather than busy. Set before the first poll: the
  # window this closes is exactly the one somebody else is looking in.
  park_self "$2"
  while :; do
    if occupied "$1"; then
      die "'$2' is occupied (authority unknown) — a UI owns its input box and gang cannot establish who may clear it (gang attach)"
    fi
    if [ "${GANG_MIDTURN_ACTS:-}" = 1 ] && parked "$1"; then
      if [ -n "$PARKED_WAIT_TARGET" ]; then
        WAIT_STATE="parked (waiting on $PARKED_WAIT_TARGET)"
      else
        WAIT_STATE="parked (gang wait in progress)"
      fi
      unpark
      return 0
    fi
    busy_rc=0
    busy "$1" || busy_rc=$?
    case "$busy_rc" in
      0) streak=0 ;;
      1) streak=$((streak + 1))
         if [ "$streak" -ge 2 ]; then
           WAIT_STATE="idle (slack tug)"
           unpark
           return 0
         fi ;;
      2) # An arm has spent its whole allowance — which one is in the phrase,
         # because a bracket nobody closed and a pty signal that ran out are not
         # the same fault and are not fixed the same way. Waiting longer would
         # turn a bounded policy into the permanent fabricated busy it bounds.
         WAIT_STATE="expired ($BUSY_EXPIRED_WHAT)"
         unpark
         return 0 ;;
      *) die "internal: busy returned unknown verdict $busy_rc" ;;
    esac
    [ "$t" -ge "$timeout" ] && die "'$2' still busy after ${timeout}s"
    sleep 2; t=$((t + 2))
  done
}

# --- delivery ---------------------------------------------------------------

landing_zone() { # $1 = window id; the input box, or the whole pane if none is declared
  if declare -F profile_input >/dev/null; then profile_input "$1"
  else capture_joined "$1"; fi
}

# One pane, one writer. A delivery is read-the-box, paste, read-it-again, Enter —
# four steps against a screen anyone else can also write to. Two of them
# interleaved put both messages in the box and submit them as one, with both
# senders told they succeeded; the same collision happens between a send and the
# operator's own hands. Lived it, twice in one afternoon: a patrol nudge merged
# with a lead's send, and an inbound send merged mid-word with what the operator
# was typing.
#
# mkdir, not flock(1): flock is util-linux and a stock macOS ships none, while
# mkdir is atomic on every filesystem worth running on. The holder's pid goes
# inside so a crashed writer's lock is reclaimed instead of blocking the pane
# until someone notices.
LOCK_PATH=""
lock_release() { [ -z "$LOCK_PATH" ] || rm -rf "$LOCK_PATH"; LOCK_PATH=""; }

# The lock root is /tmp, not XDG_RUNTIME_DIR, and deliberately not a choice
# between them. Every process delivering to a pane must AGREE on this path, and
# XDG_RUNTIME_DIR is set by the login session — so one default resolved two ways:
# /run/user/<uid> from a pane, which inherits it, and /tmp from anything not
# carrying that environment. Measured: it is in the tmux server's GLOBAL
# environment, and `env -i bash -lc` has it unset. Two writable roots, both
# creations succeeding, neither excluding the other, and no error anywhere — the
# lock does not fail there, it stops being a lock. /tmp is also reachable from a
# workspace-write sandbox, which XDG_RUNTIME_DIR is not, and that sandbox is the
# Codex setup this project's own README recommends.
#
# Law 6, where these die: at reboot or on the distro's tmpfiles sweep, not at
# logout. They are empty between deliveries, so what outlives a session is an
# empty directory; a lock left behind by a killed writer is reclaimed by the pid
# check in the wait below.
#
# What /tmp costs is that it is world-writable, which is what lock_base is for.
lock_base() { # $1 = the lock root; returns with it established as ours, or refuses
  local err
  # Intermediate components get mkdir -p: a nested GANG_LOCK_DIR needs them, and
  # everything guaranteed below is about the FINAL component, whose contents are
  # the locks. A hostile ANCESTOR is outside what a shell can
  # check at all — that needs openat/O_NOFOLLOW — so the checked scope is stated
  # rather than implied.
  mkdir -p "$(dirname "$1")" 2>/dev/null || :
  # NOT mkdir -p on the root itself. -p maps "I created it", "it existed and is
  # mine", "it existed and is someone ELSE's", and "it is a symlink pointing
  # anywhere at all" onto a single exit 0 — measured: -p on a symlink to a
  # directory succeeds and writes THROUGH the link, so on a shared /tmp another
  # user's directory, or their symlink, is adopted in silence. That is this
  # release's own collapse sitting inside a POSIX utility. Plain mkdir returns
  # EEXIST instead, which makes SUCCESS here proof by construction: mkdir(2) never
  # follows a final symlink and never adopts an existing directory, and -m sets the
  # mode in that same call rather than leaving a window open before a chmod.
  err="$(mkdir -m 700 "$1" 2>&1)" && return 0
  # A failed create is rc=1 for EEXIST, EACCES, EROFS, ENOSPC and ENAMETOOLONG
  # alike and the shell cannot see which, so reading it AS "the name is taken" is
  # the same collapse one level down: a full disk reported as an ownership
  # problem. Ask the filesystem instead — the way the contention
  # check below does, and for the same reason, that errno text is localised — and
  # let mkdir's own message speak for every other cause. Surfaced, never matched on.
  #
  # -e is FALSE for a dangling symlink, which does yield EEXIST, so the entry test
  # has to include -L. Without it, a link planted at the lock root is reported as a
  # full disk, and that is the one branch where the wrong cause points AWAY from an
  # attack.
  [ -e "$1" ] || [ -L "$1" ] \
    || die "cannot create the lock directory $1 — ${err:-unknown error}. Every gang process delivering to a pane must agree on this path, so gang will not quietly pick another: point GANG_LOCK_DIR at somewhere writable by ALL of them."
  # -d, -O and the mode all FOLLOW a symlink, so -L has to answer first or a
  # planted link reads as the healthy case. Every question here is asked about the
  # LINK, not through it.
  [ ! -L "$1" ] \
    || die "the lock directory $1 is a symlink to $(readlink "$1" 2>/dev/null) — refusing to lock through it. A lock taken somewhere other than where the other delivering processes look is not a lock. Remove it, or point GANG_LOCK_DIR at a real directory."
  [ -d "$1" ] \
    || die "the lock path $1 exists and is not a directory — remove it, or point GANG_LOCK_DIR at a directory gang can own."
  [ -O "$1" ] \
    || die "the lock directory $1 is not owned by uid $(id -u) — refusing to take delivery locks in a directory somebody else controls, because they could delete or forge them. Point GANG_LOCK_DIR somewhere you own."
  # Tightened, not refused. Every root that exists today was made by mkdir -p under
  # the caller's umask — 0775, measured, on both of the ones this box had — so
  # refusing anything looser than 0700 would refuse the root every existing user
  # already has and break their first send after upgrade. Repairing a directory we
  # have just established we OWN is not a fallback to somewhere else, and
  # tightening only ever removes access, so there is no window in doing it. Set
  # rather than read: what matters is that it IS 0700, chmod is idempotent, and
  # this keeps stat's incompatible flags out of the delivery path entirely.
  err="$(chmod 700 "$1" 2>&1)" \
    || die "cannot restrict the lock directory $1 to this user — ${err:-unknown error}. Left open to others on a shared /tmp, another user can delete or forge the delivery locks gang relies on."
  # What tightening cannot undo: entries another user planted while it stood open.
  # Those remain, and remain LOUD — a planted lock naming a live pid times out in
  # the wait below and says so, and one naming a dead pid is reclaimed there. gang
  # does not sweep them: a cleanup that guesses which lock is stale is how a tool
  # ends somebody's team.
}

lock_pane() { # $1 = window id; held until lock_release or this process exits
  local base holder t=0 path err tries="${GANG_LOCK_WAIT:-150}"
  require_whole GANG_LOCK_WAIT "$tries" attempts
  base="${GANG_LOCK_DIR:-/tmp/gangline-$(id -u)}"
  lock_base "$base"
  path="$base/$(printf '%s' "$1" | tr -c 'A-Za-z0-9' '_').lock"
  while :; do
    err="$(mkdir "$path" 2>&1)" && break
    # An existing directory is the ONLY failure that means contention. Anything
    # else — a read-only mount, a denied path — is permanent, and retrying it
    # turns a hard failure into a thirty-second wait that then blames a process
    # which does not exist. Measured: a sandbox mounting /run/user/<uid> read
    # only made every send report contention against an empty lock directory,
    # and a permanent failure wearing a transient message makes the caller retry
    # forever. Asked of the filesystem rather than by matching errno text, which
    # is localised and varies between platforms.
    [ -d "$path" ] \
      || die "cannot take the delivery lock at $path — ${err:-unknown error}. Nothing holds this lock; the path cannot be created at all, so retrying will not help. Point GANG_LOCK_DIR at somewhere writable by every gang process that delivers to this pane."
    holder="$(cat "$path/pid" 2>/dev/null)" || holder=""
    if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then
      rm -rf "$path"; continue          # the writer died mid-delivery
    fi
    t=$((t + 1))
    # The wait is stated from the bound actually in force rather than from the
    # default's arithmetic. An operator who moved GANG_LOCK_WAIT was being told
    # about thirty seconds that had nothing to do with how long this waited.
    [ "$t" -lt "$tries" ] \
      || refuse "another gang process has been delivering to $1 for $(( tries / 5 ))s and has not finished — look at it with gang capture before retrying"
    sleep 0.2
  done
  printf '%s' "$$" > "$path/pid"
  LOCK_PATH="$path"
  trap 'on_exit' EXIT
}

composer_settled() { # $1 = window id; nobody is typing into the box right now
  # A static box may hold a draft, ghost text, or nothing, and appending to any
  # of those is safe — inject verifies the change it makes. A box whose contents
  # are MOVING is a human at the keyboard, and a paste into that interleaves
  # mid-word with what they are writing. Two looks, because typing is continuous
  # and a single sample cannot tell a draft from a hand.
  declare -F profile_input >/dev/null || return 0
  local a b
  a="$(profile_input "$1")" || return 0   # no box: other guards own that case
  sleep 0.3
  b="$(profile_input "$1")" || return 0
  [ "$a" = "$b" ]
}

# --- a paste that was never submitted ----------------------------------------
#
# A delivery that fails after the paste has landed leaves its text where the
# paste went: in the target's input box, unsent. That is not a clean failure.
# The next thing that agent types is submitted with somebody else's message
# prepended to it — confirmed in the field, a full envelope sat in an agent's
# prompt waiting for exactly that.
#
# The obvious repair is a trap. Clearing the box means sending a keystroke, and
# the paths that strand text are mostly the paths where a modal owns the box —
# where a keystroke is an ANSWER to the dialog, which is precisely what the
# withheld Enter refused to send. So gang clears only where it can prove both
# halves: the composer is live and settled, and the box still holds exactly what
# gang put there. Everywhere else the paste is RECORDED on the target window,
# read out by status, roster and patrol, and cleared by the first delivery or
# sweep that can see the box again.
#
# The record is a window option, so it is exactly as long-lived as the agent it
# describes and tmux is the one that deletes it (Law 1, Law 6) — and it has a
# deletion path that does not need a modal to lift, because a box that reads back
# empty proves the text is gone whoever removed it.

staged_note() { # $1 = window id -> what gang knows about an unsubmitted paste there
  tmux show-options -wqv -t "$1" @gl_staged
}

stage_record() { # $1 = window id, $2 = the note, $3 = box rendering to match (may be empty)
  # Only for a profile that declares an input box: without one "the box" is the
  # whole pane, nothing about it can be matched or cleared, and a record nobody
  # can act on is noise on every roster from here on.
  declare -F profile_input >/dev/null || return 0
  tmux set-option -w -t "$1" @gl_staged "$2"
  if [ -n "$3" ]; then tmux set-option -w -t "$1" @gl_staged_box "$3"
  else tmux set-option -uw -t "$1" @gl_staged_box 2>/dev/null || true; fi
}

stage_forget() { # $1 = window id
  tmux set-option -uw -t "$1" @gl_staged 2>/dev/null || true
  tmux set-option -uw -t "$1" @gl_staged_box 2>/dev/null || true
}

blocked_record() { # $1 = window id, $2 = the sender whose send was refused
  # REFUSED, never queued. Gang did not take the body, so this records that an
  # attempt happened and who made it and claims nothing about delivery — calling
  # it queued would invent an ownership no part of this system has. Repeats
  # coalesce to a count and the most recent sender, because the fact worth an
  # operator's eye is that this routing point is stalling traffic, not a
  # transcript of who tried.
  local prev n
  prev="$(tmux show-options -wqv -t "$1" @gl_blocked 2>/dev/null)" || prev=""
  n="${prev%% *}"
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  tmux set-option -w -t "$1" @gl_blocked "$(( n + 1 )) $2" 2>/dev/null || true
}

blocked_forget() { tmux set-option -uw -t "$1" @gl_blocked 2>/dev/null || true; }

blocked_line() { # $1 = window id -> one sentence for an operator, or nothing
  local raw n who
  raw="$(tmux show-options -wqv -t "$1" @gl_blocked 2>/dev/null)" || return 0
  [ -n "$raw" ] || return 0
  read -r n who <<<"$raw"
  printf 'INBOUND REFUSED while occupied — %s attempt(s), last from %s; gang kept no copy, the sender still holds it' \
    "$n" "$who"
}

blocked_brief() { # $1 = window id -> the roster's three words, or nothing
  # The roster gets the count; the sentence that explains it is what `gang status`
  # is for. Same split as the staged-paste note it sits beside, and the same
  # reason: a column an operator scans across a whole team has room to say THAT
  # something is wrong, not what.
  local raw
  raw="$(tmux show-options -wqv -t "$1" @gl_blocked 2>/dev/null)" || return 0
  [ -n "$raw" ] || return 0
  printf 'inbound refused ×%s' "${raw%% *}"
}

clear_box() { # $1 = window id; erase the input box, and prove it is erased
  # C-u is the line kill every readline-shaped composer honours, and a hardcoded
  # default whose outcome is verified beats an extension point no profile sets.
  # Sent only where the composer is provably live — into a modal this keystroke
  # is an answer — and the box is read back afterwards, because a harness that
  # ignores it must not be reported as cleared. The day one turns up, the key
  # becomes a profile declaration (Law 4); the read-back is what will say so.
  # ONE PRESS IS NOT ONE BOX. Measured on Claude Code 2.1.220: C-u kills the last
  # VISUAL ROW of the composer and leaves the rows above it — 8 of 8 on a draft
  # wrapped to two rows, 5 of 5 cleared first press on a draft that fit one. Every
  # gang envelope wraps, so the single press this used to send erased the tail of
  # a stranded paste and left its head in the agent's box, which is the failure
  # described above and the one this function exists to prevent.
  #
  # So: press, read back, press again while it is still shrinking. The stop
  # condition is a press that changes NOTHING, which is the honest signal that
  # this composer does not honour the key — the day that harness turns up, this
  # returns failure on the first iteration and the record stands (Law 4 applies
  # then, not before). Bounded because a loop driven by a pane must be.
  #
  # 0.4s per press: the composer repaints in 0.14–0.16s, five samples, so this is
  # better than twice the measured latency and unchanged from what it was.
  declare -F profile_input >/dev/null || return 1
  local before after n=0 presses="${GANG_CLEAR_PRESSES:-40}"
  require_whole GANG_CLEAR_PRESSES "$presses" presses
  while [ "$n" -lt "$presses" ]; do
    input_clear "$1" && return 0
    before="$(profile_input "$1")" || return 1
    tmux send-keys -t "$1" C-u
    sleep 0.4
    after="$(profile_input "$1")" || return 1
    [ "$after" != "$before" ] || return 1
    n=$((n + 1))
  done
  input_clear "$1"
}

stage_clear() { # $1 = window id; drop a recorded paste once it is provably ours and reachable
  local note box want
  note="$(staged_note "$1")"
  [ -n "$note" ] || return 0
  if occupied "$1"; then return 0; fi       # a keystroke here would act on the UI
  composer_settled "$1" || return 0         # somebody is typing: not gang's box to touch
  box="$(landing_zone "$1")" || return 0    # cannot see it: the record stands
  if ! grep -q '[^[:space:]]' <<<"$box"; then
    stage_forget "$1"; return 0             # empty box: whoever cleared it, it is gone
  fi
  want="$(tmux show-options -wqv -t "$1" @gl_staged_box)"
  # Matched, not merely present: by the time the modal lifts the box may hold the
  # operator's own draft, and wiping that to tidy up gang's mess is a worse bug
  # than the one being fixed. A path that never read the box records no rendering
  # and is therefore reported until a human deals with it.
  [ -n "$want" ] && [ "$box" = "$want" ] || return 0
  clear_box "$1" || return 0
  stage_forget "$1"
}

inject() { # $1 = window id, $2 = text, $3 = "head" if the text is only meaningful
           # at the head of an empty box; bracketed-paste, verify in pane, submit. Law 3.
  local buf="gang-$$" frag before after
  # frag is a LABEL, not a probe. It names which message a failure is about, in
  # the eleven human-facing strings below, and nothing here compares it against
  # the pane: delivery is proved by the input box CHANGING across the paste. So
  # the width is chosen for someone reading an error, not for matching, and the
  # question "did the first N units land" is never asked. Anyone restoring a
  # fragment-versus-pane comparison brings back the bug the before/after check
  # replaced — a second identical send verifying against the first one's echo.
  #
  # Sliced by the shell, not by `cut -c`. That option is specified in characters
  # and implemented in BYTES by GNU coreutils while BSD honours the spec, which
  # is the same platform coin-flip that cost this repo two shipped bugs one axis
  # over (awk's substr, 9417312 and 077cdeb). A byte cut through a multibyte
  # first line leaves half a glyph on the end of every message quoting it, and
  # on the record stage_record writes into tmux. Bash slices in this process's
  # own LC_CTYPE, and gang settles that at the top of this file — a UTF-8 locale
  # or vet reporting it could not get one — so the cut lands on a character
  # boundary wherever any marker in this repo matches at all, and a host too
  # bare for that degrades through the mechanism that already announces itself.
  #
  # It also retires a `producer | head -1` on a delivery path. bash's stdout is
  # line-buffered, so printf emits one write per LINE: given a multi-line message
  # head exits at line one while printf still has lines to write, and the SIGPIPE
  # that follows reads as 141 under pipefail — with set -e, the send dies at its
  # own first line. Issue #6's shape, and NOT bounded by payload size; measured
  # at four lines it did not lose the race in 500 runs, but the race is there.
  frag="${2%%$'\n'*}"
  [ "${#frag}" -le 40 ] || frag="${frag:0:40}…"
  # The one delivery no before/after verification can make safe: while a modal
  # owns the input box, keystrokes are ANSWERS. Checked here at the chokepoint —
  # immediately before the paste — so every path in (send, compact, patrol,
  # hitch, resume) hits it, including a modal that painted after the caller's own
  # earlier check.
  # Taken before the gate check, and held past the Enter: everything below reads
  # the pane and then acts on what it read, so another writer between any two of
  # those steps invalidates the rest.
  lock_pane "$1"
  ! occupied "$1" \
    || refuse "refusing to deliver '$frag': $1 is occupied (authority unknown) — a UI owns its input box, so the paste would act on that UI instead of landing (gang attach)"
  composer_settled "$1" \
    || refuse "refusing to deliver '$frag': somebody is typing into $1 right now — the paste would interleave with their draft mid-word (try again in a moment)"
  # Before anything is read or pasted: an earlier delivery that could not be
  # verified may have left its text in this box, and appending to that would
  # submit both as one message. This is the moment the modal that stranded it has
  # demonstrably lifted — the gate check above just passed — so it is also the
  # first moment gang may type into the pane at all.
  stage_clear "$1"
  # Position-sensitive text needs a stricter bar than prose does, and the gap
  # between the two is what shipped a false compaction record. composer_settled
  # asserts STILLNESS, deliberately — a box holding a draft, ghost text or nothing
  # is safe to append to, because inject verifies the change it makes. But a draft
  # the operator has PAUSED on is perfectly still, so the guard passes, the paste
  # appends, and the Enter submits their half-written line with gang's text glued
  # to the end of it.
  #
  # For prose that is recoverable: the message arrives mangled but present, and
  # the sender still has it. For a slash command it is silent and it lies. A
  # slash command is only a command at the head of an EMPTY box; appended to a
  # draft it is literal text, so no compaction runs — and inject still verifies,
  # because the box did change across the paste and Enter did empty it, so
  # compaction_mark records a compaction that will never happen and patrol then
  # holds its nudge on an agent at full context. Observed live.
  #
  # So the bar is EMPTINESS, asked of the profile rather than answered here —
  # input_clear, the same question patrol asks before it nudges.
  #
  # It is asked of every payload, and that was once parked here as a separate call
  # with a real cost: requiring it of ordinary sends would refuse every agent with
  # a draft parked in its box, which on some claude-code profiles included ghost
  # text. The dim-attribute readers retired that cost. A box holding only what the
  # harness suggested now reads EMPTY through profile_input, asserted for both
  # harnesses that paint one — grep 'reads empty' in the suite for the two checks —
  # so what is left to refuse is a draft a human actually typed.
  #
  # The other half of the parked cost was that prose is recoverable, and it was
  # measuring the wrong thing: "mangled but present" describes the MESSAGE, while
  # what the Enter destroys is the operator's line. Measured on the fixed side
  # too — a parked draft survives the refusal intact and unsent, and deliver_held
  # then lands that same send the moment the operator's own line goes, so the
  # refusal costs a wait rather than a message.
  #
  # The refusal says the body was not delivered instead of leaving that to
  # deliver_held's hand-back, which prints only where there WAS a hold: under
  # GANG_SEND_HOLD=0 that line is skipped and this wording is all a sender gets.
  if ! input_clear "$1"; then
    # The agent's NAME, not the window id this function is handed. `gang capture
    # @0` is not a runnable command — win_id matches on the window's name — so the
    # id spent an operator an attempt to find that out. Looked up here rather than
    # beside the other locals so an ordinary delivery does not pay for a string it
    # will never print.
    local tname onlyhead=""
    tname="$(agent_name_of "$1")"
    # Position adds a second failure rather than changing the first: prose loses
    # the operator's line, a slash command loses that AND silently never runs.
    [ "${3:-}" != head ] \
      || onlyhead=", and this text is only a command at the head of an empty one, so appended to a draft it would be literal text and would never run"
    refuse "refusing to deliver '$frag' to $tname: its input box is not provably empty, so the paste would append to a half-written line and the Enter would submit that draft with this message glued to it$onlyhead. Nothing was typed and the body is still the sender's — try again once that box is clear (gang capture $tname to see it)"
  fi
  # Verified = the paste changed the input box, which is where a paste lands.
  # Reading the box asks the profile (Law 4) instead of teaching gang how each
  # TUI draws a collapsed paste, and those renderings agree on nothing: Claude
  # Code writes "[Pasted text #1 +10 lines]", counting lines BEYOND the first,
  # and collapses a long single-line paste to "[Pasted text #2]" with no count
  # at all; Pi writes "[paste #N +13 lines]", counting every line. A short
  # paste stays literal in both. Every one of them is a box that differs from
  # the box before the paste.
  #
  # A CHANGE, not "the box is non-empty": the box may legitimately hold a draft
  # already, and appending to a draft still changes it. Comparing against the
  # box captured BEFORE this paste is also what keeps an identical earlier send
  # sitting in the transcript from vouching for a paste that never landed.
  # The last refusal before the first keystroke, so it exits 3 like the others
  # above it. Everything from the paste down dies on 1 however transient it reads,
  # because by then a retry can submit the same message twice.
  before="$(landing_zone "$1")" \
    || refuse "cannot read the input box of $1 — the harness is not taking input"
  # Buffer name is per-process: patrol runs on cron, and a concurrent send would
  # otherwise overwrite the buffer between load-buffer and paste-buffer.
  printf '%s' "$2" | tmux load-buffer -b "$buf" -
  tmux paste-buffer -p -d -b "$buf" -t "$1"
  sleep 0.4
  # The box went unreadable with the paste already in flight, so where the text
  # ended up is genuinely unknown: in the box behind whatever took the screen, or
  # in that thing's own field. Gang cannot see it, so it cannot clear it — it says
  # what it does not know and leaves a record no rendering can be matched against,
  # which is what keeps this one being reported until a human deals with it.
  after="$(landing_zone "$1")" || {
    stage_record "$1" "'$frag' was pasted into this box and the box could not be read afterwards — it may be sitting there unsent" ""
    die "cannot read the input box of $1 after pasting '$frag' — nothing was submitted, and the paste may be sitting unsent in that box (gang capture $1)"
  }
  [ "$after" != "$before" ] \
    || die "delivery NOT verified: pasting '$frag' left the input box unchanged — nothing was submitted"
  # Enter goes as its own keystroke, and then gets checked, because the failure
  # it guards against is silent and reads exactly like success. Batch the text
  # and the Enter into one send-keys and Claude Code takes the burst for a paste
  # and the trailing newline for part of it: the message stays in the box as an
  # unsent draft that scrollback renders identically to a sent one. Submitting
  # empties the box — or, mid-turn, replaces it with the harness's queued-message
  # hint — so a box still holding what we just pasted was never submitted.
  # Occupancy is checked again here, and this is the check that matters most: the
  # earlier one guards the paste, but Enter is the keystroke that ANSWERS a
  # dialog. A modal can paint in the moment between the paste and this line —
  # that is the whole hazard, an asynchronous dialog against a four-step
  # delivery — and an Enter aimed at a composer that is no longer there selects
  # whatever the dialog has highlighted. Nothing is submitted, and the paste stays
  # in the box behind the modal: not a clean failure, a loaded one. The box was
  # read a line ago, so this is the path that can hand a rendering to the record —
  # the next send or patrol after the modal lifts clears it on that evidence.
  if occupied "$1"; then
    stage_record "$1" "'$frag' is staged unsent in this box — a modal took the screen before the Enter could be sent" "$after"
    die "refusing to submit '$frag': a modal took the screen of $1 while the paste was landing — the Enter that would have answered it was not sent, so the paste is staged unsent in that box (gang attach; gang clears it on the next send or patrol once the modal is gone)"
  fi
  tmux send-keys -t "$1" Enter
  # An unreadable box in the moments after Enter is not a failed submit — it is
  # the submit in flight. opencode's box is only "readable" while the hardware
  # cursor sits in it, and the cursor leaves while the accepted message is
  # repainted into the transcript: the check that confirms submission fails
  # precisely BECAUSE submission is happening. One bad sample is therefore not a
  # verdict, it just buys another look.
  #
  # The two failures stay on separate counters because they are different
  # accusations. A box that reads back unchanged is positive evidence the text
  # never went — it keeps the five looks it has always had, so nothing about
  # that verdict loosens here. Unreadable is an absence of evidence, and only
  # the wider budget running out escalates it to "I could not tell".
  local unchanged=0 looks=0 posted
  while :; do
    sleep 0.4
    if posted="$(landing_zone "$1")"; then
      [ "$posted" = "$after" ] || break
      unchanged=$((unchanged + 1))
      if [ "$unchanged" -ge 5 ]; then
        # The one path where both halves are provable without waiting for
        # anything: the box reads back, which is only true while the composer
        # owns the screen, and it reads back as exactly what gang pasted. So the
        # text goes out the way it came in rather than being left for whatever
        # this agent types next. The clear is verified too — a harness that
        # ignores the keystroke is told about, not reported as tidy.
        if clear_box "$1"; then
          die "submit NOT verified: '$frag' was pasted into the input box of $1 and never sent — the paste has been cleared back out of that box"
        fi
        stage_record "$1" "'$frag' is staged unsent in this box — it was pasted, never sent, and would not clear" "$posted"
        die "submit NOT verified: '$frag' was pasted into the input box of $1, never sent, and would not clear — it is staged there now and has to be cleared by hand (gang attach)"
      fi
    fi
    looks=$((looks + 1))
    if [ "$looks" -ge 15 ]; then
      # Unlike the branch above this is an absence of evidence both ways: the
      # Enter went, and a box that never reads back cannot say whether it took.
      # opencode's box reads this way precisely BECAUSE a submit is happening, so
      # the record is worded as the doubt it is — and it costs nothing when the
      # send did land, because the first sweep that finds the box empty drops it.
      stage_record "$1" "'$frag' was pasted here and Enter sent, but the box never read back — it may be sitting there unsent" ""
      die "cannot read the input box of $1 after Enter — submission unverifiable (15 looks over 6s); if the Enter never took, the paste is sitting unsent in that box (gang capture $1)"
    fi
  done
  lock_release
}

deliver_held() { # $1 = window id, $2 = text, $3 = the target's name; hold a send
                 # behind a hand at the keyboard instead of handing it back
  # The failure: an operator is typing into an agent's box, a teammate's send
  # reaches inject, composer_settled refuses, and the sender is left holding the
  # body. Every sender here is a CLI agent and an agent reads a refusal as
  # terminal, so nobody sends it again — the message is simply lost, and lost
  # BECAUSE somebody was at the keyboard, which is the moment a team most wants
  # its traffic to arrive. resume_after_compaction already argues this for its own
  # path and names the same asymmetry: the likeliest failure there was the one
  # spent as fatal. Ordinary send never got that fix, and this is it.
  #
  # The ordering promised is between the OPERATOR'S TEXT and this send, and it is
  # the whole of what a hold buys: what was in the box first leaves first, and the
  # paste does not jump a half-written line. Ordering between SENDERS is not
  # promised, here or anywhere else in gang — concurrent sends race for the pane
  # lock and land in whichever order they take it, and nothing reads them as a
  # queue.
  #
  # The hold is send's alone. patrol's nudge is ambient and skipping one is
  # correct; hitch and compact have their own shapes; a resume has its own waiter.
  local bound="${GANG_SEND_HOLD:-120}" started="$SECONDS" told=0 rc=0 err=""
  # Its own knob rather than another 300. A foreground send with an agent blocked
  # on it and a background resume waiter sit at opposite ends of one trade, and the
  # reference already warns that the values which coincide at 300 do so by accident
  # and must not be folded together. Checked at the read like every bound in this
  # file: a profile sourced after the default was taken can export it, and an
  # unusable value makes every elapsed-against-bound test here fail rather than
  # fire, which would leave a send that never holds wearing a knob that says it
  # does.
  require_whole GANG_SEND_HOLD "$bound" seconds
  HELD_SECONDS=0
  HELD_OCCUPIED=0
  # Asked before typing rather than read back out of a refusal: the sender learns
  # it is waiting before it stalls instead of afterwards, and what the hold turns
  # on is this predicate rather than a string matched out of an error message.
  # Nothing is locked here — inject takes the pane lock and asks the same question
  # again underneath it, which is what makes this an announcement and not a
  # guarantee. Budget first, so a bound of zero costs not even the look and behaves
  # exactly as this path did before there was a hold.
  while [ $(( SECONDS - started )) -lt "$bound" ] && ! composer_settled "$1"; do
    if [ "$told" -eq 0 ]; then
      told=1
      printf 'gang: queued behind operator typing: somebody is typing into %s, so this send is held for up to %ss rather than handed back to you\n' \
        "$3" "$bound" >&2
    fi
    sleep 2
  done
  while :; do
    rc=0
    # In a subshell so inject's exit does not end this process, and so the pane lock
    # it takes is released with that subshell rather than held across a sleep.
    err="$(inject "$1" "$2" 2>&1)" || rc=$?
    if [ "$rc" -eq 0 ]; then
      [ "$told" -eq 0 ] || HELD_SECONDS=$(( SECONDS - started ))
      return 0
    fi
    # EVERY refusal that typed nothing is held for, not only the typing one. 3 is a
    # property of the code path — inject never reached a keystroke — while "this
    # wording sounds transient" is a guess about prose, and the failure being fixed
    # is a body handed back to a sender that will drop it. 1 stops, because 1 can
    # mean the paste landed.
    [ "$rc" -eq 3 ] || break
    # The one state no amount of waiting ends. It stops the hold rather than riding
    # it out for a second reason: blocked_record's TIMELINESS is a promise of its
    # own — an occupied routing point stalls everyone aimed at it, and delaying the
    # signal that says so by the length of the hold would fix one regression by
    # installing another. The caller records and refuses exactly as it does for an
    # occupancy it finds itself, so the two are one outcome with one status.
    if occupied "$1"; then HELD_OCCUPIED=1; break; fi
    [ $(( SECONDS - started )) -lt "$bound" ] || break
    if [ "$told" -eq 0 ]; then
      told=1
      # "nothing OF IT", not "nothing". The sentence was written when the only way
      # to reach this loop was a refusal about a box gang had not touched, and it
      # means "no part of this message landed". Once an empty-box bar refuses a
      # PARKED DRAFT, the commonest reader of this line is an operator looking
      # straight at their own half-written thought sitting in that box, and
      # "nothing has been typed into retrier" reads to them as a claim about the
      # box rather than about the send — gang contradicting what they can see.
      printf 'gang: holding this send for up to %ss and retrying — nothing of it has been typed into %s\n' \
        "$bound" "$3" >&2
    fi
    sleep 2
  done
  # Said only where there WAS a hold: a send that never waited reports exactly what
  # it reported before this function existed. What the refusal underneath cannot
  # say is that the waiting is over, how long it ran, and that the body never left
  # the sender.
  [ "$told" -eq 0 ] \
    || printf 'gang: held %ss for %s and gave up — NOTHING was delivered, and the message is still yours to send again\n' \
         "$(( SECONDS - started ))" "$3" >&2
  # The last refusal is the state the pane was actually left in, so it goes out
  # whole rather than summarised — except for occupancy, which the caller is about
  # to state in the words an operator already knows from every other occupied send.
  [ -z "$err" ] || [ "$HELD_OCCUPIED" -eq 1 ] || printf '%s\n' "$err" >&2
  # inject's own status, so "3 means nothing was typed" stays true for whatever
  # wraps send.
  return "$rc"
}

resume_after_compaction() { # $1 = window id, $2 = text; deliver where it cannot overtake
  # A resume cannot ride the input queue behind its own compaction. Both are typed
  # from inside a live turn, and a harness does not treat the two alike: a queued
  # slash command waits for the turn to genuinely end, while queued text can be
  # handed straight to the turn already running. The text overtakes the command,
  # gets eaten by the very turn that was about to be compacted, and the agent wakes
  # up afterwards with nothing to pick up. Lived it. So the resume goes in later,
  # delivered by the only thing still around to do it.
  #
  # Later has two moments and the earlier one is better. Once compaction is visibly
  # RUNNING, the turn that could have eaten the resume is over and the turn now in
  # flight reads no input: the message can only wait, which is all it ever needed
  # to do. So it goes in immediately and sits in the queue the compaction drains on
  # its way out — the agent picks it up the instant it has a context to pick it up
  # into, instead of after a waiter has finished convincing itself the screen has
  # stopped moving.
  #
  # A profile that has not had its compaction watched live declares no marker and
  # waits for quiet instead. There the floor matters as much as the streak: between
  # a turn ending and the compact command starting to paint there is a sub-second
  # window where the pane is neither busy nor compacting, and a waiter that fires
  # in it queues the resume AHEAD of the compaction it exists to follow — the same
  # inversion, rebuilt. Three quiet polls plus a screen that stops moving costs six
  # seconds; no compaction finishes that fast and no flush gap lasts that long.
  #
  # The two are a race with no losing branch. A compaction briefer than a poll
  # interval is simply missed, and quiet then means what it has always meant.
  #
  # The settle path alone is weaker than it reads. Its streak resets on
  # busy_painted, which is false for most of a turn, so it is a one-time FLOOR
  # rather than sustained quiet: after about sixteen seconds it fires at the
  # first still frame. Streaming is not the exposure, because streaming moves the
  # screen — SILENCE is, and a test run, a fetch or a large read is exactly that.
  # The resume then rides ahead of the queued compaction and is eaten by the turn
  # it was supposed to follow.
  #
  # So where gang issued the compaction itself it waits for proof instead: the
  # context DROPPING below where it stood when the command was typed. That is
  # later than visibly-running and still safe, because a compaction reads no
  # input, and unlike a still screen it cannot be true of a turn that is merely
  # quiet.
  local t=0 streak=0 timeout="${GANG_RESUME_TIMEOUT:-900}"
  # The one bound in this file whose unchecked failure is corrupting rather than
  # noisy: an unusable value makes the `while` below refuse on its first test,
  # and execution falls straight through to the unconditional inject at the end —
  # the resume delivered with no wait at all, into a turn that may still be
  # running. That is precisely what this function exists to prevent.
  require_whole GANG_RESUME_TIMEOUT "$timeout" seconds
  require_whole GANG_COMPACT_GRACE "$GANG_COMPACT_GRACE" seconds
  local at_issue="" mark ctx tw tokens window
  # Read ONCE, here. compaction_pending CLEARS the mark the moment it sees the
  # drop and patrol polls it too, so whichever poller gets there first takes the
  # value away from the other. This must not depend on the mark still existing
  # when it looks, so it keeps its own copy and polls the context itself.
  mark="$(tmux show-options -wqv -t "$1" @gl_compacting 2>/dev/null)" || mark=""
  case "$mark" in
    *' '*) at_issue="${mark##* }" ;;
  esac
  [[ "$at_issue" =~ ^[0-9]+$ ]] && [ "$at_issue" -gt 0 ] || at_issue=""
  declare -F profile_context >/dev/null || at_issue=""
  while [ "$t" -lt "$timeout" ]; do
    sleep 2; t=$((t + 2))
    if compacting "$1"; then
      break
    fi
    if [ -n "$at_issue" ]; then
      if [ "$t" -ge "$GANG_COMPACT_GRACE" ]; then
        # The drop never came, so the compaction never happened: `/compact` under
        # a harness's own threshold runs and leaves the context exactly where it
        # was (measured). Fall back rather than hold the resume for the whole
        # timeout over a compaction that was never going to occur.
        #
        # The residual is named rather than left for a reader to wonder about,
        # because the settle path's weakness two paragraphs up does not stop
        # applying here: a turn that has been SILENT since the mark was set can
        # still take this resume. Silence is not evidence of a finished turn — a
        # test run, a large fetch or a long build is silent for exactly as long
        # as it takes, and the grace is a clock, not a measurement of one.
        #
        # It is still the better end of the trade, and not because the exposure
        # is small. Without this branch the same message reaches the same silent
        # turn at the timeout anyway, injected with NO checking at all; this path
        # demands three non-busy polls and a still screen first. It moves the
        # moment earlier and makes the attempt better-behaved, and it buys the
        # measured under-threshold case, which otherwise holds for the full
        # fifteen minutes over a compaction that never happened.
        at_issue=""
      else
        if ctx="$(context_now "$1" 2>/dev/null)" \
           && tw="$(ctx_tokens "${ctx%%$'\n'*}")"; then
          read -r tokens window <<<"$tw"
          [ "$tokens" -lt $(( at_issue / 2 )) ] && break
        fi
        continue
      fi
    fi
    [ "$t" -ge 10 ] || continue
    # The pane question: this loop is waiting for a turn to STOP, and it pairs
    # with pane_stable below. Availability is a different thing and not what a
    # resume is allowed to overtake.
    if busy_painted "$1"; then streak=0; continue; fi
    streak=$((streak + 1))
    [ "$streak" -ge 3 ] && pane_stable "$1" && break
  done
  # Out of time still means try, not give up: inject verifies its own delivery, so
  # the attempt either lands or fails, and a failure leaves the agent sitting idle
  # where anyone can see it rather than passing for resumed.
  #
  # But one attempt was never enough, and the reason is that the loop above spends
  # the whole budget choosing an instant and none of it delivering into one. The
  # refusals it runs into are exactly the ones that come back: a composer with text
  # in it, a gate that painted. Both are transient by their own wording — one names
  # retry as the remedy, the other names an operator action after which delivery
  # succeeds — and both were spent as terminal. The probability is backwards, too.
  # The composer is MOST likely to hold text immediately after a compaction, because
  # that is when the operator is back at the keyboard; the likeliest failure on this
  # path was the one it treated as fatal. Lived it: a resume died on "somebody is
  # typing into @0 right now" and the agent woke with nothing to pick up.
  #
  # What makes retrying safe is not the wording but the exit status. `refuse` (3)
  # means inject typed NOTHING, so the pane is exactly as it was and the same text
  # can go again; `die` (1) can mean the paste landed and the submit could not be
  # verified, and re-sending that would deliver twice. So 3 retries and 1 stops.
  #
  # The budget is what is LEFT of GANG_RESUME_TIMEOUT, which is the honest reading
  # of a timeout that was always meant to bound "get this resume delivered" rather
  # than "pick a moment". No new knob, and the existing one now covers the whole
  # job. A wait that used the full budget still gets its one attempt, unchanged.
  # Spent against the CLOCK rather than counted in retries: an attempt is not a
  # fixed cost — a contended pane lock alone can hold one for thirty seconds — so
  # a per-retry counter would run far past the budget it claims to keep.
  local rc=0 err="" started="$SECONDS" left=$(( timeout - t ))
  [ "$left" -ge 0 ] || left=0
  while :; do
    rc=0
    # In a subshell so inject's exit does not end this process — and so the pane
    # lock it takes is released with that subshell, leaving the next attempt to
    # take it cleanly rather than holding one across a sleep.
    err="$(inject "$1" "$2" 2>&1)" || rc=$?
    [ "$rc" -ne 0 ] || return 0
    [ "$rc" -eq 3 ] || break                        # typed something: not ours to repeat
    [ $(( SECONDS - started )) -lt "$left" ] || break
    sleep 2
  done
  # The last refusal is the one worth reporting: it is the state the pane was
  # actually left in, and cmd_compact records it where status, roster and patrol
  # read it out.
  [ -z "$err" ] || printf '%s\n' "$err" >&2
  return "$rc"
}

# ===[ context-fact ]=========================================================
#
# The context predicate's owned tier (ADR-0008), and the only one `gang hook` does
# not write. Nothing in the harness's event vocabulary carries a context figure,
# so there is no harness voice here for the one-verb rule to keep single: the
# writer is statusline/claude-code-context.sh, which is gangline's own code
# running in the harness's statusline callback. That is what the ADR means by
# written DIRECTLY. It keeps painting the beacon byte-identically as it goes,
# because the human reads that line and so does the scrape tier below.
#
# WHAT THIS REPLACES IS A ROUND TRIP. The same script already had the figures; it
# printed them into the pane, and gang captured the pane and parsed them back out.
# Every way that trip goes wrong is the trip's own fault — a capture landing
# mid-paint reads a torn line, a dialog drawn over the statusline hides it
# entirely, and the zero the guards downstream refuse is a beacon caught between
# paints. This tier is the same script's own numbers with the screen taken out of
# the middle.
#
# THE READER NEVER WRITES, which is where this bracket parts company with the
# other three. Their readers clear — a malformed record, a raise the pane has
# retired — because nothing else was ever going to rewrite one. This record is
# rewritten on EVERY repaint, so no clear here can be the thing that repairs it: a
# clear is either overwritten moments later or it deletes a figure the writer was
# about to refresh anyway. Expired, malformed and future-stamped therefore all
# fall through to the scrape and leave the record where it lies — and the record
# that stays is the only evidence an operator has for WHY the fallback is
# answering.
#
# That decision settles the verdict's shape too. The other readers split absent
# from malformed so the malformed arm can clear; with no clear there is nothing
# for the split to decide, so this one answers yes or no (law 5).
CTX_FACT_TOKENS=0
CTX_FACT_WINDOW=0

ctx_fact_read() { # $1 = window id; 0 = a fact this reader believes, sets CTX_FACT_*
  local raw word tokens window at now
  raw="$(tmux show-options -wqv -t "$1" @gl_ctx 2>/dev/null)" || raw=""
  CTX_FACT_TOKENS=0; CTX_FACT_WINDOW=0
  [ -n "$raw" ] || return 1
  # A trailing field this reader has no name for is TOLERATED, where the record's
  # own four are not. The statusline is wired into settings.json by absolute path,
  # so it can be a different checkout from the gang reading it — the skew vet
  # exists to report — and a newer writer's extra field is the survivable half of
  # that. Refusing the whole figure over it turns a skew into a blind spot.
  read -r word tokens window at _ <<<"$raw"
  # Every field before any of them, @gl_turn's rule, and the globals are assigned
  # only once all four have passed. A reader that fills them as it goes leaves a
  # half-parsed record standing behind a refusal, where the next caller to forget
  # the verdict finds a number waiting for it.
  [ "$word" = ctx ] || return 1
  # Zero is refused HERE rather than downstream, because on this tier it is not
  # the beacon-between-paints case at all: the writer prints "ctx -" and writes
  # nothing when it has no usage to report, so a zero in this record is a value
  # gang did not put there. The guards in the two ladder legs keep their own zero
  # check for the tier that really can produce one.
  [[ "$tokens" =~ ^[0-9]+$ ]] && [ "$tokens" -gt 0 ] || return 1
  [[ "$window" =~ ^[0-9]+$ ]] && [ "$window" -gt 0 ] || return 1
  [[ "$at" =~ ^[0-9]+$ ]] || return 1
  require_whole GANG_CONTEXT_FACT_LIMIT "$GANG_CONTEXT_FACT_LIMIT" seconds
  now="$(date +%s)"
  # A future stamp is not believed and not cleared, the turn bracket's rule: a
  # backward clock step makes a live figure read future, and the next repaint
  # will restamp it without anyone's help.
  [ "$at" -le "$now" ] || return 1
  [ $(( now - at )) -lt "$GANG_CONTEXT_FACT_LIMIT" ] || return 1
  CTX_FACT_TOKENS="$tokens"; CTX_FACT_WINDOW="$window"
}

context_now() { # $1 = window id, profile loaded; the readout, best tier first
  # What comes out is the profile-readout data interface — "<used>k/<win>k
  # (<pct>%)" — whichever tier answered, so ctx_measured, ctx_carried and
  # ctx_tokens below are untouched and none of them can tell. That is what a tier
  # is for: it picks the witness, it does not change the vocabulary.
  #
  # The interface is thousands and the fact is exact, so the render throws away
  # under a thousand tokens. Nothing downstream can spend that: the ladder's rungs
  # are set in absolute counts far coarser than a thousand, and the figure an
  # agent is handed is printed in thousands as well.
  if ctx_fact_read "$1"; then
    printf '%sk/%sk (%s%%)\n' \
      "$(( CTX_FACT_TOKENS / 1000 ))" "$(( CTX_FACT_WINDOW / 1000 ))" \
      "$(( 100 * CTX_FACT_TOKENS / CTX_FACT_WINDOW ))"
    return 0
  fi
  # The profile gate stays with the callers rather than moving in here, because
  # each of them has a different thing to say when a profile has no context at all
  # — a die, a dash in a column, a row that says not patrolled. This tier order is
  # all that lives here.
  declare -F profile_context >/dev/null || return 1
  profile_context "$1"
}
# ===[ /context-fact ]========================================================

# --- context bands ----------------------------------------------------------

ctx_tokens() { # $1 = "<used>k/<win>k (<pct>%)" -> "<used> <window>" in tokens
  [[ "$1" =~ ^([0-9]+)k/([0-9]+)k ]] || return 1
  printf '%s %s' "$(( BASH_REMATCH[1] * 1000 ))" "$(( BASH_REMATCH[2] * 1000 ))"
}

# A profile reports "<used>k/<win>k (<pct>%)" because that is what its harness
# paints. What gang REPEATS out of that is a separate decision, and it is made
# here rather than in each profile: the readout is a data interface, and the two
# audiences below want different parts of it.
ctx_measured() { # $1 = profile readout -> the figure an operator reads
  # The percent never survives. A percentage of a harness's advertised window is
  # a claim about headroom, and the position this whole ladder takes is that the
  # usable context is far smaller than the advertised one — rot arrives nowhere
  # near a million tokens, which is why the bands are absolute counts and not
  # fractions. So the percent does not merely fail to inform, it argues against
  # the band printed next to it.
  printf '%s' "${1% (*%)}"
}

ctx_carried() { # $1 = profile readout -> the figure an agent is told it is carrying
  # And on this side the window goes too. An operator scanning a sweep is
  # diagnosing, and the window tells them which profile spoke. An agent reading
  # its own figure has no such use for it and every reason not to be handed a
  # denominator: "124k/1000k" is an invitation to read 876k of headroom at the
  # exact moment the band beside it says there is none.
  local s
  s="$(ctx_measured "$1")"
  printf '%s' "${s%%/*}"
}

# Permille of the span a ladder divides. Fixed, so the ladder has the same shape on
# every harness, and compressing upward so the warnings get closer together as the
# situation gets worse. The widest gap belongs at the bottom, where there is still
# time to act on it.
#
# The interior is what carries that shape. The opening rung is separate because it is
# not part of the shape at all — it is a claim that the start of the span is already
# a hazard, and only an axis whose span starts at an onset has earned it. Context has:
# a context that has reached the floor is rotting, which is the whole reason the floor
# is where it is. Split, so an axis states that claim by taking the opening rung
# rather than by inheriting it from a list that was written for something else.
LADDER_INTERIOR="308 555 783 1000"
LADDER_FRACTIONS="0 $LADDER_INTERIOR"

# Written by an axis's deriver rather than printed, and the rule binds the deriver
# rather than the caller: `die` inside a command substitution ends only that subshell,
# so a deriver that printed its ladder would hand a caller reading it through `$(...)`
# an empty string where a refusal was meant — and an empty ladder reads as a valid one.
LADDER_AUTO=""

context_rungs() { # $1 = window; sets LADDER_AUTO to the derived CSV. Dies on a bad bound.
  # Both bounds are read HERE rather than resolved once at startup, because that is
  # what lets a profile set them for its own harness: load_profile runs before the
  # ladder in both nudge legs, and a value fixed at load time would be read before
  # the profile that meant to change it had been sourced at all.
  local window="$1" ceiling span f t rungs=""
  local floor="${GANG_CONTEXT_FLOOR:-120000}" cap="${GANG_CONTEXT_CAP:-350000}"
  [[ "$floor" =~ ^[0-9]+$ ]] && [ "$floor" -gt 0 ] \
    || die "invalid GANG_CONTEXT_FLOOR '$floor' — the ladder's first rung is an absolute token count"
  [[ "$cap" =~ ^[0-9]+$ ]] && [ "$cap" -gt 0 ] \
    || die "invalid GANG_CONTEXT_CAP '$cap' — the ladder's last rung is an absolute token count"
  [ "$cap" -ge "$floor" ] \
    || die "GANG_CONTEXT_CAP ($cap) is below GANG_CONTEXT_FLOOR ($floor) — the ladder would run backwards"
  # Same refusal as a % rung, for the same reason: a ladder that cannot be PLACED is
  # not a ladder set wrong, and the message has to name what could not be determined
  # rather than send an operator to edit a setting that is correct.
  [[ "$window" =~ ^[0-9]+$ ]] && [ "$window" -gt 0 ] \
    || die "cannot derive the band ladder: no context-window size for this agent (got '$window') — the derived ladder needs the window figure the profile reports, so fix the readout, or set GANG_CONTEXT_BANDS to an explicit ladder"
  # A tenth of the window is exhaustion headroom. A rung sitting at the window is a
  # warning that arrives after the agent is already dead; what is left after the last
  # rung has to be enough to issue a compaction and have it land.
  ceiling=$(( window * 9 / 10 ))
  [ "$ceiling" -le "$cap" ] || ceiling="$cap"
  if [ "$ceiling" -le "$floor" ]; then
    # This window cannot reach rot onset, so the only hazard it can be warned about
    # is exhaustion, and one rung is the whole ladder that applies to it.
    LADDER_AUTO=$(( ceiling / 1000 * 1000 ))
    [ "$LADDER_AUTO" -gt 0 ] \
      || die "cannot derive the band ladder: a ${window}-token window leaves no rung above zero once headroom is taken — set GANG_CONTEXT_BANDS to an explicit ladder if that window is real"
    return
  fi
  span=$(( ceiling - floor ))
  for f in $LADDER_FRACTIONS; do
    # Floored to 1k, the resolution every context readout reports in.
    t=$(( (floor + span * f / 1000) / 1000 * 1000 ))
    rungs="${rungs:+$rungs,}$t"
  done
  LADDER_AUTO="$rungs"
}

time_rungs() { # $1 = the usable span in seconds; sets LADDER_AUTO to the derived CSV.
               # Dies on a span it cannot divide.
  # The interior alone, and the missing opening rung is this axis's argument rather
  # than an omission: a rung at zero claims the start of the span is already a
  # hazard, and the start of a budget is the one moment nothing has been spent
  # (ADR-0009). Context takes that rung because a context at the floor is already
  # rotting; time has no onset to warn about, so a warning at the starting line
  # would warn about nothing.
  #
  # No numeric guard on the span, deliberately, where context_rungs guards its
  # window: a window is a figure scraped off somebody else's screen and arrives
  # missing, while a span is this file's own subtraction and arrives a number or not
  # at all. A guard here could only fire on a bug in the caller, and a guard that
  # cannot fire is one more thing to keep true.
  local span="$1" f t rungs=""
  for f in $LADDER_INTERIOR; do
    t=$(( span * f / 1000 ))
    # Whole seconds, so a span short enough to floor a fraction to zero has no
    # ladder rather than a broken one. Refused here, where the span is known, so
    # that every rung this deriver hands out is a positive whole number and the
    # placement refusals inside `ladder` stay out of this axis's reach — they name
    # the context hatch, which is not this axis's to name.
    [ "$t" -gt 0 ] \
      || die "cannot derive the time ladder: a ${span}-second span is too short to place a rung above zero — declare a longer cutoff, or lower GANG_TIME_RESERVE"
    rungs="${rungs:+$rungs,}$t"
  done
  LADDER_AUTO="$rungs"
}

auto_rungs() { # $1 = axis, $2 = the extent its rungs are derived across -> LADDER_AUTO
  # The axis names which derivation the word `auto` stands for. One name, one deriver,
  # and an axis nobody wrote one for is a mistake in this file rather than a ladder to
  # be guessed at — the caller has already decided what it is measuring by the time it
  # gets here, so there is no sensible fallback to pick.
  case "$1" in
    context) context_rungs "$2" ;;
    time)    time_rungs "$2" ;;
    *)       die "internal: no band ladder is derived for the '$1' axis" ;;
  esac
}

ladder() { # $1 = axis, $2 = position on it, $3 = the extent its rungs are placed across
           #  -> "<bands crossed> <highest> <resolved CSV>"
  # One evaluator, however many legs ask it and whatever they are measuring. Two
  # copies of a ladder is two ladders.
  #
  # The axis decides two things and nothing else: which explicit ladder overrides the
  # derivation, and which derivation is meant by `auto`. Everything past that point is
  # one shape — rung syntax, the placement refusal, and the count of rungs a position
  # is past — because a rung is a rung whatever it measures.
  #
  # For the CONTEXT axis specifically: both ends of its default ladder are absolute and
  # that is load-bearing (ADR-0006). Its explicit CSV is read as written, and the %
  # suffix remains in that syntax as an escape hatch for an unusual window — the one
  # place a fraction is the operator's intent rather than a mistake. It is not a
  # default and must not become one. Every refusal written into this function belongs
  # to that axis and names its hatch outright, because it is the only explicit ladder
  # there is to name; the time axis cannot reach any of them, because a derivation is
  # the whole of its ladder and time_rungs refuses before it hands out a rung that
  # would trip one.
  local axis="$1" position="$2" extent="$3"
  local band=0 crossed=0 part n t resolved="" list
  case "$axis" in
    context) list="$BANDS" ;;
    time)    list=auto ;;
    *)       die "internal: no band ladder is defined for the '$axis' axis" ;;
  esac
  if [ "$list" = auto ]; then
    auto_rungs "$axis" "$extent"
    list="$LADDER_AUTO"
  fi
  for part in ${list//,/ }; do
    case "$part" in
      *%) n="${part%\%}"
          [[ "$n" =~ ^[0-9]+$ ]] || die "invalid GANG_CONTEXT_BANDS '$BANDS' — fix the ladder"
          # A rung that cannot be PLACED is not a rung set wrong. Checked before
          # the arithmetic, because an unknown window floors t to zero and the
          # zero-rung guard would then report a broken ladder — sending an operator
          # to edit a setting that is correct, about a figure the profile failed to
          # report. The refusal has to name what actually could not be determined.
          [[ "$extent" =~ ^[0-9]+$ ]] && [ "$extent" -gt 0 ] \
            || die "cannot place the '$part' band: no context-window size for this agent (got '$extent') — a % rung needs the window figure the profile reports, so fix the readout, not GANG_CONTEXT_BANDS"
          # Floored to 1k, the resolution every context readout reports in.
          t=$(( n * extent / 100000 * 1000 )) ;;
      *)  [[ "$part" =~ ^[0-9]+$ ]] || die "invalid GANG_CONTEXT_BANDS '$BANDS' — fix the ladder"
          t="$part" ;;
    esac
    [ "$t" -gt 0 ] \
      || die "invalid GANG_CONTEXT_BANDS '$BANDS': the '$part' rung lands at 0 tokens, which every context is already past — fix the ladder"
    resolved="${resolved:+$resolved,}$t"
    if [ "$position" -ge "$t" ]; then
      band=$((band + 1))
      [ "$t" -gt "$crossed" ] && crossed="$t"
    fi
  done
  printf '%s %s %s' "$band" "$crossed" "$resolved"
}

ladder_at_top() { # $1 = current band, $2 = resolved CSV; true at or beyond its last rung
  # The caller supplies the RESOLVED ladder rather than assuming the default has
  # five rungs. A one-rung exhaustion ladder, an explicit operator ladder, and the
  # time ladder all reach their own top through the same question. The last of
  # those read "a future wall-clock ladder" until the time axis landed, and the
  # arrival cost this function nothing — which is the claim ADR-0009 makes about
  # this seam, kept true here rather than asserted there alone.
  local total=0 rung
  for rung in ${2//,/ }; do total=$((total + 1)); done
  [ "$1" -ge "$total" ]
}

# The band an agent was last seen in, so a crossing warns once rather than on every
# sweep. A value that is not a plain integer is a THIRD answer, not band zero: no
# warning leg may read an unparseable memory as "never warned" and nudge an agent
# that has already been told.
#
# The option is the CALLER's to name because the memory is per AXIS — @gl_band for
# context, @gl_tband for the team's budget. One memory shared between them would let
# a nudge on either axis answer for a crossing on the other, and the two crossings
# are unrelated: an agent that just compacted is no earlier in the team's day for
# it, and an agent told the budget is nearly spent has been told nothing about how
# full it is. What the axes DO share is this discipline, which is the whole content
# of band_state_read and band_state_write and the reason there is one pair of them
# rather than one pair per axis.
BAND_STATE_BAND=0
band_state_read() { # $1 = window id, $2 = the option that axis keeps its band in;
                    # populate BAND_STATE_BAND; 2 = malformed
  local raw
  raw="$(tmux show-options -wqv -t "$1" "$2" 2>/dev/null)" || raw=""
  if [ -z "$raw" ]; then BAND_STATE_BAND=0; return 0; fi
  [[ "$raw" =~ ^[0-9]+$ ]] || return 2
  BAND_STATE_BAND="$raw"
}

band_state_write() { # $1 target, $2 the option that axis keeps its band in, $3 band
  tmux set-option -w -t "$1" "$2" "$3"
}

band_note() { # $1 readout, $2 threshold, $3 agent, $4 band, $5 ladder, $6 optional repeat
  # The exact command, not "compact soon", because the part an agent gets wrong
  # is the resume — typed in behind the compaction it overtakes it and is eaten
  # by the turn about to be compacted, and the agent wakes with nothing to do.
  #
  # What escalates up the ladder is the ASK, not the volume. A louder note
  # carrying the same deferrable instruction defers exactly as well, and "at the
  # next checkpoint" is deferrable forever because there is always a next
  # checkpoint: four bands can pass on four locally-reasonable deferrals, each
  # one correct under the wording, while the context nearly doubles. So the ask
  # tightens rung by rung — finish this task, then start nothing new, then stop
  # now — and the last rung stops asking altogether and says the note repeats.
  #
  # Every rung also says WHY, in terms of what is happening to THIS context now.
  # An instruction with its reason attached is one an agent can weigh against the
  # work in front of it; a bare instruction loses that comparison every time,
  # because the work is concrete and the cost of deferring was never stated.
  #
  # No rung refers to any other. A count of what is left is arithmetic about the
  # ladder rather than about the context, and it reads as an allowance: three
  # bands left is a licence to spend two. It also cannot be acted on — nothing an
  # agent does with the number changes what it should do — so it is length spent
  # arguing for delay.
  #
  # Every rung is written as an instruction, not as prose about context: action
  # first, one clause per sentence, literal consequences, no metaphor. These
  # notes land in a context that is already degrading, and a sentence an agent
  # has to unpack before it can act is a sentence charged against the thing it is
  # trying to save.
  #
  # The top rung says to compact now rather than at a boundary. A boundary is
  # only ever wanted because it is a moment with something coherent to write
  # down, so writing the handoff IS the boundary, and it is reachable at any
  # moment for the cost of doing it.
  local total remaining tail qname
  local -a rungs
  IFS=',' read -r -a rungs <<<"$5"
  total="${#rungs[@]}"
  remaining=$(( total - $4 ))
  # The name goes into a command the agent is told to RUN, so it is quoted for the
  # shell that will read it rather than pasted raw. valid_name refuses anything
  # exotic at hitch and at adopt, which leaves a manual `tmux rename-window` as the
  # only way a window arrives here with a name worth quoting — this is the
  # fail-loud column rather than the security one (law 2). %q leaves every name
  # that passed valid_name byte-identical, so the suggestion an agent actually
  # reads is unchanged in every case that is not already broken.
  printf -v qname '%q' "$3"
  tail="Write the handoff to a file, then run: gang compact $qname --from $qname --resume-stdin < resume-file — this queues behind the turn you are in, and the resume is delivered once compaction settles."
  if [ "${6:-}" = repeat ]; then
    printf '[context-usage] %s in context — still past the %s-token band. You have not compacted. Do it now, before your next action. Each turn you take instead adds to this context and degrades your recall of it. Anything you have not written down is lost when the context is cut. You will get this note on every turn until you compact. %s' \
      "$1" "$2" "$tail"
    return
  fi
  if [ "$remaining" -le 0 ]; then
    # At or past the top rung — one condition, because a band above the ladder's
    # last is the same situation as its last and wants the same instruction.
    printf '[context-usage] %s in context — past the %s-token band. Stop and compact now, before your next action. This is not optional, and there is no better moment to wait for. Your recall of this conversation is already unreliable, and anything you have not written down is lost when the context is cut. You will get this note on every turn until you compact. %s' \
      "$1" "$2" "$tail"
  elif [ "$remaining" -eq 1 ]; then
    printf '[context-usage] %s in context — past the %s-token band. Start no new work. Close what is open, then compact. Your recall is already degrading: instructions given once earlier in this conversation are dropping out, and you cannot tell which ones. %s' \
      "$1" "$2" "$tail"
  else
    printf '[context-usage] %s in context — past the %s-token band. Finish the task you are on, then compact. Do not start a new task first. Your recall of earlier turns degrades as this context grows, and you cannot see what you have lost from inside it. %s' \
      "$1" "$2" "$tail"
  fi
}

time_note() { # $1 = band number, or `past`; $2 = the span it states; $3 = the ladder
  # ADR-0009 says band_note grows a time voice. This is that voice, and it is a
  # SIBLING rather than a branch inside band_note, which is a decision about what
  # band_note's header argues rather than about line count. Every paragraph of it
  # reasons from a context that degrades AS IT GROWS and from the compaction that
  # fixes it: recall dropping out, a figure that reads as an allowance, a handoff
  # that IS the boundary. A budget running out degrades nothing, and there is no
  # command that gives any of it back. Folding the two would widen all of that
  # reasoning onto an axis it was never made about, which is the class of defect
  # that has to be caught where the claim is written rather than downstream of it.
  # time_rungs sits beside context_rungs for the same reason; this is that shape
  # one layer up.
  #
  # No agent name, and the missing parameter is the difference. band_note takes one
  # because it builds a `gang compact` line the agent is told to RUN, and a name in
  # a command has to be quoted for the shell that will read it. Nothing here is a
  # command: what an agent does about a budget is its own work, in its own words.
  #
  # WHAT CARRIES ACROSS from band_note, unchanged: the ask tightens rung by rung
  # rather than getting louder, because a louder note carrying the same deferrable
  # instruction defers exactly as well; every rung says WHY in terms of what is
  # true NOW, because an instruction with its reason attached can be weighed
  # against the work in front of it and a bare one loses that comparison every
  # time; no rung refers to any other; and every rung is an instruction rather
  # than prose about time.
  #
  # WHAT INVERTS: THE NUMBER IS STATED, on every rung. Context drops its
  # denominator on purpose, so headroom cannot read as an allowance — there is
  # nothing an agent does with "180k left" that it should not have done anyway.
  # Remaining budget is not that: it IS the pacing input, and an agent told only
  # that time is short can neither rebalance what it is doing nor decide what to
  # drop. Do not "fix" this back into symmetry with band_note. The asymmetry is
  # the argument (ADR-0009), and the two axes differ in what the figure is FOR.
  #
  # WHAT IS ABSENT: there is no `repeat` wording for the rung that repeats, and the
  # absence is the argument rather than an omission. band_note needs a second
  # phrasing because its figure barely moves between turns, so the same note twice
  # IS the same sentence, and a sentence that arrives again unchanged is the
  # unchanging nag ADR-0009 refuses to send. Every rung here is built around a
  # number that SHRINKS on every sweep, so a repeat says something the previous one
  # could not have said, without a word of it being written twice. Adding a repeat
  # variant later would be phrasing a distinction the note already makes.
  #
  # The rungs are counted DOWN FROM THE TOP, not matched by number, so an operator
  # ladder with more rungs in it maps onto the same four asks instead of falling
  # off the end of a case statement.
  local total remaining
  local -a rungs
  if [ "$1" = past ]; then
    # Terminal, and it names the OPERATOR rather than telling the agent to clear
    # the cutoff: one team declared one budget, and ending it is not one agent's
    # call. It also keeps the licence to continue explicit, because gang enforces
    # nothing here and a note that reads as `stop` would take a decision this tool
    # does not get to take (ADR-0009).
    printf '[time-budget] Bank your work now — the declared cutoff passed %s ago. Anything that exists only in this pane is already past the moment it was meant to survive. Nothing is enforced and nothing is stopping you: keep going if there is more worth doing. This note repeats on every sweep until the operator clears or moves the cutoff.' \
      "$2"
    return
  fi
  IFS=',' read -r -a rungs <<<"$3"
  total="${#rungs[@]}"
  remaining=$(( total - $1 ))
  if [ "$remaining" -le 0 ]; then
    # LEADS WITH THE IMPERATIVE, and then with the licence to keep working. This
    # is the reserve, so the instruction is durability and the reason it is safe
    # to spend a moment on it is that the reserve was held back for exactly this.
    # A rung that led with the time and closed with the ask would be read as an
    # alarm, and the loudest rung of the ladder reading as `stop` is the decision
    # ADR-0009 reserves for the musher.
    printf '[time-budget] Bank your work now — write results out, commit what works, record where you got to. %s of the declared budget is left, which is the reserve held back for exactly this. Then keep going: improving what is already banked is the best use of what remains, and nothing here is telling you to stop.' \
      "$2"
  elif [ "$remaining" -eq 1 ]; then
    printf '[time-budget] %s of the declared budget is left. Make what you have durable now — write results out, commit what works, record the state. Work that exists only in this pane dies with the budget, and work on disk does not.' \
      "$2"
  elif [ "$remaining" -eq 2 ]; then
    printf '[time-budget] %s of the declared budget is left. Stop widening the work. Close what is open and drive it to something that runs. New investigation now is spent out of what is left to finish with.' \
      "$2"
  else
    printf '[time-budget] %s of the declared budget is left. Check whether your current approach lands inside that, and change it now if it does not. A plan that does not fit is cheapest to change while there is still budget to change it in.' \
      "$2"
  fi
}

# --- the cutoff -------------------------------------------------------------
#
# Operator intent about wall-clock time: one team, one cutoff, declared and never
# measured (ADR-0009). Stored as the PAIR cutoff-epoch and declared-at-epoch,
# because the span a ladder divides is the span that was DECLARED. Keeping only
# the cutoff would leave every reader dividing whatever happened to be left when
# it looked, so a rung would sit at a different moment on every sweep and the
# fractions would describe nothing an operator declared.

# GANG_NOW is a TEST-ONLY clock seam, and this is the only place it is read.
# Without it a case about a band boundary can only reach that boundary by waiting
# for it, so the suite's runtime would scale with the SIZE of the budgets it
# covers rather than with how many of them it covers. Unset — which is every
# production run — now_epoch is `date +%s` and nothing else.
#
# The other `date +%s` reads in this file are deliberately left alone. They stamp
# evidence at the moment it is recorded, while this one computes against a
# declared budget: routing them through here would put a test seam into paths
# that never needed one, and a fixed GANG_NOW would freeze the evidence ages that
# exist precisely in order to advance.
#
# Validated HERE, at the top level, rather than at each read — the deliberate
# exception to the rule the numeric knobs above state for themselves. That rule
# exists because a profile is sourced after startup and can export those; GANG_NOW
# is not a profile's to set, and nothing sources it later. The read itself sits
# inside a command substitution, where `die` ends only that subshell and would
# hand the caller an empty clock to mistake for a valid one.
[ -z "${GANG_NOW:-}" ] || require_whole GANG_NOW "$GANG_NOW" "seconds since the epoch"
now_epoch() {
  if [ -n "${GANG_NOW:-}" ]; then printf '%s' "$GANG_NOW"; else date +%s; fi
}

# Rendering an epoch as a local wall-clock time needs the host's own timezone
# rules, and the two `date` dialects spell that request differently: GNU takes
# `-d @<epoch>`, BSD takes `-r <epoch>`. Probed rather than assumed, and GNU
# FIRST — because on GNU `-r` means "this file's modification time", so a
# BSD-first probe run in a directory holding a file named like an epoch would
# succeed and answer with a plausible wrong time. Asking GNU its own way first
# puts that out of reach: a GNU date answers the GNU probe and never reaches the
# other branch.
DATE_DIALECT=""
date_dialect() { # settle which date this host speaks; dies if it speaks neither
  [ -z "$DATE_DIALECT" ] || return 0
  # 1970-01-02 UTC. Every timezone on earth still calls that moment 1970, so the
  # probe cannot be thrown by the host's own offset.
  if [ "$(date -d '@86400' '+%Y' 2>/dev/null)" = 1970 ]; then DATE_DIALECT=gnu
  elif [ "$(date -r 86400 '+%Y' 2>/dev/null)" = 1970 ]; then DATE_DIALECT=bsd
  else die "cannot render local times on this host: date understands neither -d '@<epoch>' nor -r <epoch>"
  fi
}
date_at() { # $1 = epoch, $2 = strftime format -> that moment, in local time
  # Settles the dialect on its own so a caller cannot reach a wrong answer by
  # forgetting to, but the refusal that matters is the one raised at statement
  # level: this runs inside command substitutions, where `die` ends the subshell
  # and the caller reads an empty string.
  date_dialect
  case "$DATE_DIALECT" in
    gnu) date -d "@$1" "+$2" ;;
    bsd) date -r "$1" "+$2" ;;
  esac
}

# The team's cutoff is the first piece of SESSION-scoped state gang keeps — every
# other @gl_* option is per-window, because everything else gang tracks is a fact
# about one agent. Both halves of the target spelling are load-bearing:
#
#   the `:` is what makes it a session target at all. `set-option -t` takes a
#   TARGET-PANE, and a bare `=name` is not one — tmux answers "no such session".
#
#   the `=` anchors the name, because an unanchored tmux target is a PREFIX
#   match. On a server also running `gangline-staging`, a `gangline` that is not
#   itself running resolves to it, and gang would declare one team's cutoff onto
#   another team's session and read it back as its own.
#
# Law 6 comes free: the pair is session state, so it dies with the session and
# there is no separate deletion path for anyone to forget to run.
cutoff_write() { # $1 = cutoff epoch, $2 = declared-at epoch
  tmux set-option -t "=$SESSION:" @gl_cutoff "$1 $2"
}
cutoff_forget() { tmux set-option -u -t "=$SESSION:" @gl_cutoff 2>/dev/null || true; }

# A stored pair that does not parse is a THIRD answer, not "none declared" — the
# discipline band_state_read keeps, for the same reason. Reading a corrupt value
# as absence answers a direct question with a confident wrong fact, and gang only
# ever writes this option itself, so a value that does not parse is evidence that
# something else has been at it rather than a shape to accommodate.
CUTOFF_AT=0
CUTOFF_DECLARED=0
cutoff_read() { # populate CUTOFF_AT and CUTOFF_DECLARED; 1 = none declared, 2 = malformed
  local raw at declared
  raw="$(tmux show-options -qv -t "=$SESSION:" @gl_cutoff 2>/dev/null)" || raw=""
  [ -n "$raw" ] || return 1
  case "$raw" in *' '*) ;; *) return 2 ;; esac
  at="${raw%% *}"; declared="${raw#* }"
  [[ "$at" =~ ^[0-9]+$ ]] || return 2
  [[ "$declared" =~ ^[0-9]+$ ]] || return 2
  CUTOFF_AT="$at"; CUTOFF_DECLARED="$declared"
}

cutoff_refuse() { # $1 = what the operator typed
  # One wording for every way the word can be wrong. The message names the forms
  # that work, because a refusal an operator cannot act on costs another attempt.
  die "cannot read '$1' as a cutoff — give a duration (90m, 2h, 1h30m) or a clock time (17:30)"
}

# One or more <whole><unit> groups, units h/m/s, each used at most once. Order is
# not policed because it cannot be ambiguous: 30m2h and 2h30m name the same span,
# and a rule that only rejects spellings buys an operator nothing.
#
# Refuses by STATUS rather than by dying, because the things spelled this way are
# refused in different words: a cutoff names the clock form it also takes, a reserve
# names the percentage form it also takes. One parser, and whoever knows which knob
# was wrong is the one that says so. The seconds travel back in a global while the
# status travels in the exit code, so a caller cannot read a refusal as a span.
DURATION_PARSED=0
duration_seconds() { # $1 = a duration word -> DURATION_PARSED; 1 = not a duration
  local rest="$1" digits unit total=0 seen_h=0 seen_m=0 seen_s=0
  while [ -n "$rest" ]; do
    digits="${rest%%[hms]*}"
    # Nothing left to cut on means no unit at all. A bare number is refused rather
    # than guessed at: "gang cutoff 90" is ninety of something, and choosing which
    # for the operator fabricates the intent law 8 refuses.
    [ "$digits" != "$rest" ] || return 1
    case "$digits" in ''|*[!0-9]*) return 1 ;; esac
    rest="${rest#"$digits"}"
    unit="${rest%"${rest#?}"}"
    rest="${rest#?}"
    # 10# on every read, because a leading zero is an ordinary way to write a time
    # and bash reads 08 as a broken octal literal rather than eight.
    case "$unit" in
      h) [ "$seen_h" -eq 0 ] || return 1; seen_h=1; total=$(( total + 10#$digits * 3600 )) ;;
      m) [ "$seen_m" -eq 0 ] || return 1; seen_m=1; total=$(( total + 10#$digits * 60 )) ;;
      s) [ "$seen_s" -eq 0 ] || return 1; seen_s=1; total=$(( total + 10#$digits )) ;;
    esac
  done
  DURATION_PARSED="$total"
}

# Sets a global rather than printing, for LADDER_AUTO's reason: the refusal has to
# be heard. `die` inside a command substitution ends only that subshell, so a
# caller reading a REJECTED duration through `$(...)` would take the empty string
# for a parsed one and go on to store it — turning the loud death this function
# exists to produce into a silently corrupt declaration.
CUTOFF_PARSED=0
cutoff_parse() { # $1 = the operator's word, $2 = now; sets CUTOFF_PARSED, or dies
  local spec="$1" now="$2" hh mm hms nowh nowm nows midnight
  case "$spec" in
    *:*)
      # A clock time is the NEXT occurrence of HH:MM. An operator who types a
      # time already gone today means tomorrow — nobody declares a cutoff in the
      # past — and resolving it backwards would declare a budget that was over
      # before it was announced.
      hh="${spec%%:*}"; mm="${spec#*:}"
      # A third field lands in mm complete with its colon, so HH:MM:SS is refused
      # by the same test that refuses letters rather than needing its own.
      case "$hh" in ''|*[!0-9]*) cutoff_refuse "$spec" ;; esac
      case "$mm" in ''|*[!0-9]*) cutoff_refuse "$spec" ;; esac
      [ "$((10#$hh))" -le 23 ] && [ "$((10#$mm))" -le 59 ] \
        || die "cutoff '$spec' is not a time of day — a clock cutoff is HH:MM on a 24-hour clock"
      hms="$(date_at "$now" '%H %M %S')"
      [ -n "$hms" ] || die "cannot read the local time on this host"
      nowh="${hms%% *}"; hms="${hms#* }"
      nowm="${hms%% *}"; nows="${hms#* }"
      # Midnight is derived from the host's OWN rendering of now, so the offset
      # and its daylight-saving rules are already in it. The rollover below adds
      # a flat day, which is an hour out across a change — a bound worth stating
      # rather than a calendar library worth carrying, since nothing here is
      # enforced and the note it feeds says the time it means.
      midnight=$(( now - (10#$nowh * 3600 + 10#$nowm * 60 + 10#$nows) ))
      CUTOFF_PARSED=$(( midnight + 10#$hh * 3600 + 10#$mm * 60 ))
      [ "$CUTOFF_PARSED" -gt "$now" ] || CUTOFF_PARSED=$(( CUTOFF_PARSED + 86400 ))
      ;;
    *)
      duration_seconds "$spec" || cutoff_refuse "$spec"
      CUTOFF_PARSED=$(( now + DURATION_PARSED ))
      ;;
  esac
}

human_span() { # $1 = whole seconds -> the same span in the units an operator types
  local s="$1" h m
  h=$(( s / 3600 )); m=$(( s % 3600 / 60 ))
  if   [ "$h" -gt 0 ] && [ "$m" -gt 0 ]; then printf '%dh%dm' "$h" "$m"
  elif [ "$h" -gt 0 ];                   then printf '%dh' "$h"
  elif [ "$m" -gt 0 ];                   then printf '%dm' "$m"
  else                                        printf '%ds' "$s"
  fi
}

cutoff_line() { # $1 = now -> "cutoff <local time> — <span> remaining|past"
  local when left
  when="$(date_at "$CUTOFF_AT" '%Y-%m-%d %H:%M')"
  left=$(( CUTOFF_AT - $1 ))
  if [ "$left" -ge 0 ]
  then printf 'cutoff %s — %s remaining' "$when" "$(human_span "$left")"
  else printf 'cutoff %s — %s past' "$when" "$(human_span $(( 0 - left )))"
  fi
}

# --- colour -----------------------------------------------------------------
#
# Colour marks state and outcome, never decoration. A roster is scanned rather
# than read, and the four things the eye is looking for are: which agent needs a
# human (red), which is working (amber), which did the thing you asked (green),
# and which line is detail it can skip (dim). Anything that is not one of those
# four stays plain — a tool that colours everything has told you nothing.
#
# Basic 3-bit codes deliberately: they resolve through the terminal's own palette,
# so gang inherits whatever theme the operator already reads comfortably.
#
# Off unless stdout is a terminal, and off whenever NO_COLOR is set
# (https://no-color.org). Every pipe, capture, and test therefore sees the same
# plain text — including gang's own callers, since an agent greps the roster it
# just asked for.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_OK=$'\033[32m' C_WORK=$'\033[33m' C_BAD=$'\033[31m' C_DIM=$'\033[2m' C_OFF=$'\033[0m'
else
  C_OK="" C_WORK="" C_BAD="" C_DIM="" C_OFF=""
fi

colour() { # $1 = colour, $2 = text — already padded to its column width
  # Pad first, colour second, always. printf's %-18s counts bytes, and an escape
  # sequence is nine of them, so colouring before padding eats nine characters of
  # the field and the roster stops lining up.
  printf '%s%s%s' "$1" "$2" "$C_OFF"
}

# --- what a sweep says about the budget --------------------------------------
#
# The cutoff is the declaration; this is the ladder cut from it (ADR-0009). They are
# kept apart because one is operator intent and the other is arithmetic over it, and
# only the arithmetic changes between one sweep and the next.

TIME_RESERVE=0
time_reserve() { # $1 = the declared budget in seconds -> TIME_RESERVE. Dies on a bad value.
  # Banking room, held back from the END of the budget so the last rung fires where
  # banking has to start rather than where the budget stops. Work that exists only
  # in an agent's head or its pane dies with the cutoff; work on disk survives it,
  # and a warning at the cutoff arrives after the cutoff has already spent it.
  #
  # Both spellings are the operator's to pick, and the absolute one is not a
  # convenience. Writing results out costs roughly the same however much budget is
  # left, so a proportional reserve shrinks below the cost of banking exactly when
  # the budget is short — which is the run where losing the work costs most.
  #
  # Sets a global for LADDER_AUTO's reason: the refusal has to be heard, and `die`
  # inside a command substitution ends only that subshell.
  local spec="${GANG_TIME_RESERVE:-10%}" pct
  case "$spec" in
    *%) pct="${spec%\%}"
        # A reserve of the whole budget is refused with the malformed ones, because
        # what it asks for is not a high reserve but a ladder with nothing to divide.
        [[ "$pct" =~ ^[0-9]+$ ]] && [ "$pct" -lt 100 ] \
          || die "invalid GANG_TIME_RESERVE '$spec' — a proportional reserve is a whole percentage below 100, like 10%"
        TIME_RESERVE=$(( $1 * pct / 100 )) ;;
    *)  duration_seconds "$spec" \
          || die "invalid GANG_TIME_RESERVE '$spec' — give a percentage (10%) or a duration (15m, 1h, 90s)"
        TIME_RESERVE="$DURATION_PARSED" ;;
  esac
}

# What every row of one sweep carries about the budget, settled ONCE at the top of
# it. The figures are the TEAM's rather than any agent's — one cutoff, one clock —
# so two rows of a single sweep reporting different remaining time would be one fact
# contradicting itself. Settling it in one place is also what holds a misconfigured
# reserve to one loud complaint instead of one per agent, which is the reason the
# context ladder is warmed up in the same place.
TIME_SAY=""      # what to report; empty is the whole of "nothing to report"
TIME_COLOUR=""
# What the warning leg reads, and it reads STRUCTURE rather than the sentence beside
# it. Each of these is set in exactly one branch below and left empty everywhere
# else, so the leg asks which of them is set instead of recovering the situation
# from TIME_SAY's wording — a note keyed off that sentence would be a parser for
# gang's own English, kept correct by nobody, and the case it would get wrong is the
# unreadable declaration: a sentence with no ladder behind it, which owes a row and
# must never produce a note.
TIME_BAND=""     # the rung this sweep placed the team on; empty when there is no ladder
TIME_RUNGS=""    # the resolved ladder, so the leg can ask ladder_at_top for itself
TIME_LEFT=""     # what is left of the budget, already in the units an operator types
TIME_OVER=""     # how far past the cutoff the run is; empty until it is passed
time_sweep() { # settle the team's budget for this sweep -> TIME_SAY, TIME_COLOUR,
               # TIME_BAND, TIME_RUNGS, TIME_LEFT, TIME_OVER
  local rc=0 now budget span elapsed rung band rungs
  TIME_SAY=""; TIME_COLOUR=""
  TIME_BAND=""; TIME_RUNGS=""; TIME_LEFT=""; TIME_OVER=""
  cutoff_read || rc=$?
  # An undeclared budget produces silence, and the silence is total: no row, no log
  # line, no phrase of its own (ADR-0009). A phrase of its own would be one line per
  # agent on every sweep for the whole life of a team that never asked for a budget,
  # which is how a log stops being read.
  [ "$rc" -ne 1 ] || return 0
  if [ "$rc" -eq 2 ]; then
    # A stored pair gang cannot read is a third answer rather than absence — the
    # discipline cutoff_read keeps, and the reason it keeps it. Reported instead of
    # skipped, because treating it as "no budget declared" answers a question about
    # the team's budget with a confident wrong fact (law 8). The remedy is named,
    # because a report an operator cannot act on costs another sweep. The context
    # leg is untouched by it: one axis's declaration going unreadable is no reason
    # to stop warning about the other.
    TIME_SAY="THE TEAM'S CUTOFF IS UNREADABLE — not a pair of epochs; 'gang cutoff clear' removes it"
    TIME_COLOUR="$C_BAD"
    return 0
  fi
  now="$(now_epoch)"
  # Past the cutoff there is no ladder left to place anything on, so this is asked
  # before a span the run has already spent is divided into rungs. The sentence
  # changes rather than repeating the last rung's ask: an ask about pacing a budget
  # that no longer exists is noise and is also false, while going quiet would
  # fabricate an all-clear at the moment it is least earned (ADR-0009).
  if [ "$now" -ge "$CUTOFF_AT" ]; then
    TIME_OVER="$(human_span $(( now - CUTOFF_AT )))"
    TIME_SAY="PAST THE CUTOFF — $TIME_OVER past the declared budget"
    TIME_COLOUR="$C_BAD"
    return 0
  fi
  budget=$(( CUTOFF_AT - CUTOFF_DECLARED ))
  elapsed=$(( now - CUTOFF_DECLARED ))
  time_reserve "$budget"
  span=$(( budget - TIME_RESERVE ))
  [ "$span" -gt 0 ] \
    || die "GANG_TIME_RESERVE holds back $(human_span "$TIME_RESERVE") of a $(human_span "$budget") budget, which leaves no span to divide — reserve less than the budget, or declare a longer cutoff"
  # Asked for at statement level before the ladder is read through a command
  # substitution, because `die` inside one ends only that subshell and the caller
  # would read an empty band where a refusal was meant. The context ladder is warmed
  # up for the same reason; it warms up through `ladder` because an explicit CSV puts
  # refusals in there too, while the time axis has no explicit ladder and the whole
  # of its refusal surface is this derivation.
  auto_rungs time "$span"
  # The band and the resolved ladder. The rung's own position is the third field and
  # this leg has no use for it: what a row states is what is LEFT, which is the
  # figure an operator paces against (ADR-0009).
  rung="$(ladder time "$elapsed" "$span")"
  band="${rung%% *}"; rungs="${rung##* }"
  TIME_BAND="$band"; TIME_RUNGS="$rungs"
  TIME_LEFT="$(human_span $(( CUTOFF_AT - now )))"
  if ladder_at_top "$band" "$rungs"; then
    TIME_SAY="INSIDE THE BANKING RESERVE (time band $band) — $TIME_LEFT of budget left"
    TIME_COLOUR="$C_WORK"
  else
    # `steady` is not a mood, it is the word patrol_log drops by name, and a budget
    # that is merely running is the routine a sweep is mostly made of. What the log
    # keeps is what a postmortem asks for: when the run reached its banking reserve,
    # when it went past the cutoff, and when its declaration stopped being readable.
    TIME_SAY="steady (time band $band — $TIME_LEFT of budget left)"
  fi
}

time_nudge() { # $1 = window id, $2 = name; the budget's warning leg, one note per rung
  # Reads the globals time_sweep settled for the whole sweep, so every agent is
  # nudged against ONE budget. Its memory is @gl_tband, beside the context leg's
  # @gl_band and never shared with it: one axis crossing a rung says nothing about
  # the other, and a shared memory would let either nudge answer for both.
  local prev state_rc top_repeat=0
  if [ -n "$TIME_OVER" ]; then
    # Past the cutoff there is no rung to cross, so this note is the one that
    # carries no band and consults no memory. It is restated fresh on every sweep
    # by design (ADR-0009) — going quiet would fabricate an all-clear at the moment
    # it is least earned — and the memory is left exactly as it was, so a cutoff the
    # operator moves forward resumes the ladder from the rung the agent last heard.
    if ! input_clear "$1"; then
      say "$2" "-" "past the cutoff — input box has content, holding note" "$C_WORK"
      return
    fi
    envelope patrol "$(time_note past "$TIME_OVER")"
    inject "$1" "$ENVELOPE"
    say "$2" "-" "NOTED (past the cutoff; repeats every safe patrol until the cutoff moves)" "$C_OK"
    return
  fi
  # Silence when nothing is declared, and silence when the declaration will not
  # parse. The row above has already reported the unreadable case; a note cannot be
  # built on a band that was never computed, and guessing one would be the confident
  # wrong fact the row exists to avoid.
  [ -n "$TIME_BAND" ] || return
  if band_state_read "$1" @gl_tband; then state_rc=0; else state_rc=$?; fi
  if [ "$state_rc" -ne 0 ]; then
    # Rebuilt, never refused — the argument the context leg makes at length about
    # @gl_band, and it is about what this option IS rather than about which axis
    # holds it: a cache of which band an agent was last warned in. Refusing on it
    # spends one uncertainty as a decision to disable this leg for the whole life of
    # the window, because nothing below would ever rewrite the value.
    band_state_write "$1" @gl_tband "$TIME_BAND"
    say "$2" "-" "time-band memory was unreadable — re-established at time band $TIME_BAND, notes resume next sweep" "$C_BAD"
    return
  fi
  prev="$BAND_STATE_BAND"
  # An agent at the top of its own ladder has no crossing left above it to re-arm
  # the warning, so it stays an open question and reaches the same guards below as a
  # fresh crossing. Deciding it here rather than injecting out of the steady branch
  # is what keeps composer safety in force on every repeat.
  if [ "$TIME_BAND" -eq "$prev" ] && ladder_at_top "$TIME_BAND" "$TIME_RUNGS"; then
    top_repeat=1
  fi
  if [ "$TIME_BAND" -lt "$prev" ]; then
    # States the OBSERVATION and claims no cause, exactly as the context leg's
    # re-arm does. Two things reach it and gang cannot tell them apart from here: a
    # longer cutoff re-declared, which re-spans the ladder from the moment it was
    # declared, and a larger GANG_TIME_RESERVE, which moves every rung without
    # moving the clock. Naming either would be a guess.
    band_state_write "$1" @gl_tband "$TIME_BAND"
    say "$2" "-" "re-armed (time band fell)"
    return
  fi
  # Steady below the top rung says nothing, and the silence is not an omission: the
  # time row this sweep already printed for this agent carries the steady verdict for
  # this axis. A second row would double every routine sweep to say it twice.
  [ "$TIME_BAND" -ne "$prev" ] || [ "$top_repeat" -eq 1 ] || return
  # compaction_pending is deliberately NOT asked. That hold is a REDUNDANCY guard
  # and its whole argument is that the agent was already told to do THIS thing —
  # gang typed the compaction and a second note repeats an instruction already in
  # flight. Banking work before a cutoff is a different instruction, so the argument
  # does not transfer, and an agent mid-compaction is if anything the one most
  # likely to lose what it has not written down.
  if ! input_clear "$1"; then
    say "$2" "-" "time band $TIME_BAND — input box has content, holding note" "$C_WORK"
    return
  fi
  envelope patrol "$(time_note "$TIME_BAND" "$TIME_LEFT" "$TIME_RUNGS")"
  inject "$1" "$ENVELOPE"
  if [ "$top_repeat" -eq 1 ]; then
    say "$2" "-" "NOTED (inside the banking reserve; repeats every safe patrol)" "$C_OK"
  else
    band_state_write "$1" @gl_tband "$TIME_BAND"
    say "$2" "-" "NUDGED (crossed into time band $TIME_BAND)" "$C_OK"
  fi
}

# --- commands ---------------------------------------------------------------

cmd_hitch() {
  # Profile defaults so the common case needs no flags; GANG_PROFILE moves it.
  local name="" prof="${GANG_PROFILE:-claude-code}" role="" dir="$PWD" model="" id resume=0
  local cutoff="" cut_now=0
  name="${1:-}"; case "$name" in ''|-*) usage_die ;; esac; shift
  valid_name "$name" \
    || die "hitch: '$name' is not a usable agent name — patrol and hitch are reserved for gang's substrate; other names use letters, digits, dot, dash and underscore only, not starting with a dash or dot. A name is also a tmux target, a JSON string in gang hook's reply, and a word in the compaction command gang suggests"
  while [ $# -gt 0 ]; do case "$1" in
    -p|--profile) [ $# -ge 2 ] || die "hitch: $1 needs a value"; prof="$2"; shift 2 ;;
    -r|--role)    [ $# -ge 2 ] || die "hitch: $1 needs a value"; role="$2"; shift 2 ;;
    -d|--dir)     [ $# -ge 2 ] || die "hitch: $1 needs a value"; dir="$2";  shift 2 ;;
    -m|--model)   [ $# -ge 2 ] || die "hitch: $1 needs a value"; model="$2"; shift 2 ;;
    --resume)     resume=1; shift ;;
    --cutoff)     [ $# -ge 2 ] || die "hitch: $1 needs a value"; cutoff="$2"; shift 2 ;;
    *) die "hitch: unknown argument '$1'" ;;
  esac; done
  # Resolved before anything is hitched: a typo in the role should not leave a
  # live unbriefed agent behind.
  [ -z "$role" ] || role_file "$role" >/dev/null \
    || die "hitch: unknown role '$role' (have: $(list_roles | tr '\n' ' '))"
  # The cutoff is settled here for that same reason. `--cutoff 90` is exactly the
  # plausible typo `gang cutoff 90` is, and a refusal raised after the window
  # opened would leave a live agent behind for a word gang never accepted.
  #
  # Both calls sit at statement level deliberately. Each of them dies, and `die`
  # inside a command substitution ends only that subshell — so a caller reading
  # either through `$(...)` would take the empty string for a settled answer and
  # hitch on it.
  if [ -n "$cutoff" ]; then
    date_dialect
    cut_now="$(now_epoch)"
    cutoff_parse "$cutoff" "$cut_now"
  fi
  [ -d "$dir" ] || die "hitch: no such directory '$dir'"
  ! test_only_profile "$prof" \
    || die "hitch: '$prof' is a stand-in for gangline's own suite, not a harness to run an agent on (GANG_TEST_PROFILES=1 if you are testing gang itself)"
  load_profile "$prof"
  # Before the model option below, because this REPLACES the launch line rather
  # than appending to it, and a resume that ran second would drop the -m the
  # caller asked for.
  #
  # Same rule as -m, for a sharper reason. A profile with no declared resume form
  # refuses instead of launching bare: a bare launch here hands back a blank agent
  # wearing the name of the one whose thread the operator asked for, with nothing
  # on any surface saying the conversation was gone. That is the silent downgrade
  # law 8 forbids (ADR-0007).
  if [ "$resume" -eq 1 ]; then
    [ -n "$GANG_RESUME_LAUNCH" ] \
      || die "hitch: profile '$prof' declares no GANG_RESUME_LAUNCH, so it cannot take --resume. Either its harness has no resume form gang can drive, or its sessions are not scoped to a working directory — resuming there would pick up whichever conversation was last anywhere on this machine, including another agent's (docs/adr/0007-server-death-is-a-relaunch-not-a-restore.md)"
    GANG_LAUNCH="$GANG_RESUME_LAUNCH"
  fi
  # A model is one concept every harness spells differently; the profile owns the
  # spelling (GANG_MODEL_OPT), hitch carries the intent. A profile that declares
  # no spelling refuses rather than guessing a flag the harness may not have.
  if [ -n "$model" ]; then
    [ -n "$GANG_MODEL_OPT" ] || die "hitch: profile '$prof' declares no GANG_MODEL_OPT, so it cannot take -m"
    # GANG_LAUNCH is handed to sh by tmux; anything outside this charset would
    # need quoting there, and a model id never does — refuse instead.
    case "$model" in *[!A-Za-z0-9._:/@-]*) die "hitch: model '$model' has characters gang will not paste into a launch line" ;; esac
    GANG_LAUNCH="$GANG_LAUNCH $GANG_MODEL_OPT $model"
  fi

  if ! session_live; then
    id="$(tmux new-session -d -P -F '#{window_id}' -s "$SESSION" -n "$name" -c "$dir" "$GANG_LAUNCH")" \
      || die "could not start session '$SESSION' for '$name'"
  else
    exists "$name" && die "agent '$name' already exists"
    id="$(tmux new-window -d -P -F '#{window_id}' -t "=$SESSION" -n "$name" -c "$dir" "$GANG_LAUNCH")" \
      || die "could not open a window for '$name' in session '$SESSION'"
  fi
  # The id comes from the command that created the window, not from looking the
  # name up afterwards. A lookup that missed left the window running and
  # unregistered — a live agent nobody could address, reported as a failed
  # hitch — and it missed for names tmux and `read` disagree about, like one
  # with a leading space.
  [ -n "$id" ] || die "'$name' never appeared in session '$SESSION'"
  # Window name IS the identity — the app must not rename it out from under us.
  tmux set-option -w -t "$id" automatic-rename off
  tmux set-option -w -t "$id" allow-rename off
  tmux set-option -w -t "$id" @gl_profile "$prof"
  sleep 0.5
  exists "$name" || die "'$name' died at launch (cmd: $GANG_LAUNCH)"
  # A keyed profile gets its marker on EVERY hitch, role or not: the marker is
  # what makes the agent's context readable, and an unreadable agent is invisible
  # to patrol. Minted after the window exists so a failed launch mints nothing.
  local key="" msg=""
  if [ "${GANG_SESSION_KEY:-}" = 1 ]; then
    key="$(mint_key)"
    tmux set-option -w -t "$id" @gl_key "$key"
  fi
  if [ -n "$role" ]; then
    msg="$(role_brief "$role" "$name")"
    [ -n "$key" ] && msg="$msg $(marker_line "$key")"
  elif [ -n "$key" ]; then
    msg="$(marker_line "$key")"
  fi
  # Stored one statement before it is reported, and the adjacency is the whole of
  # it. Everything above here can still die — the `died at launch` check above is
  # the sharpest of them — and a cutoff written on the way past a hitch that then
  # failed would leave the team on a budget nothing ever announced, which is the
  # fabricated status law 8 refuses. Kept adjacent, gang cannot store a cutoff it
  # did not say it stored.
  #
  # It cannot move earlier either: the pair is session-scoped state, and on a first
  # hitch there is no session to hold it until `tmux new-session` has run.
  #
  # ONE cut_now serves the parse above and the write here, so the pair stored is
  # exactly the pair validated. The under-a-second between them is honest — the
  # declared-at half means the moment the operator declared, not the moment gang
  # got round to writing it down.
  if [ -n "$cutoff" ]; then
    cutoff_write "$CUTOFF_PARSED" "$cut_now"
    CUTOFF_AT="$CUTOFF_PARSED"; CUTOFF_DECLARED="$cut_now"
  fi
  echo "$(colour "$C_OK" "hitched $name") ($prof) in $dir $(colour "$C_DIM" "— watch: gang attach")"
  # Whose cutoff it is, said on the surface that moved it. The operator asked to
  # hitch one dog and has just re-declared everyone's budget; a team-wide fact that
  # changed without a line saying so is the same silent status in the other
  # direction, and the note a rung is cut from would then describe a span nobody
  # was told about.
  [ -z "$cutoff" ] || printf '%s\n' "$(cutoff_line "$cut_now") $(colour "$C_DIM" "— the whole team's, re-spanned from now")"
  # Said here as well as in vet because this is the moment a blind agent is
  # CREATED, and this line is where the operator is already looking. Non-fatal on
  # purpose: an agent with no owned-event tier still works, since every predicate
  # falls back to the pane exactly as it does for a profile that declares no facts
  # at all, and refusing the hitch would trade a degraded agent for no agent.
  #
  # A LOOKUP, NOT A RUN, and the split is deliberate. The present-but-broken
  # python3 belongs to vet: vet is the diagnostic, it is run once when something
  # is already wrong, and it can afford to start an interpreter to tell a stub
  # from the real thing. hitch is on the per-agent path and owes the operator only
  # the loud case, cheaply — `command -v` is a builtin, so this costs nothing.
  command -v python3 >/dev/null 2>&1 \
    || printf '%s\n' "$(colour "$C_BAD" "no python3 on this host: nothing can translate a hook payload or read a context window, so any fact $prof owns through them never arrives and its predicates fall back to the pane — 'gang vet' has the detail")"
  # Readiness is checked whether or not there is a brief to deliver. A role-less
  # hitch used to return right here, reporting success while a first-run dialog
  # owned the screen — and no later surface said so either: a dialog drops the
  # busy hint and the input box, so the agent read idle, sends died on the
  # missing box, and the team stalled on a security prompt nobody was told
  # about. Gang never answers a dialog; what it owes the operator is the loud
  # report that one is up, and the profile's own words for the way past it.
  [ -z "$msg" ] || printf '%s\n' "$(colour "$C_WORK" "waiting for $name to finish booting before briefing it...")"
  # `|| ready=$?` keeps this in a tested context: a bare call would trip errexit
  # on the very return codes the case below exists to report.
  local ready=0 boot="${GANG_BOOT_TIMEOUT:-30}"
  require_whole GANG_BOOT_TIMEOUT "$boot" seconds
  wait_ready "$id" "$boot" || ready=$?
  case "$ready" in
    0) ;;
    2) # Settled screen, no input box: nearly always a dialog only a human may
       # answer. With a brief pending that is a failed hitch — the brief went
       # nowhere. Without one the hitch itself is done, so the same discovery is
       # a warning: the window is real, registered, and waiting on the operator.
       if [ -n "$msg" ]; then
         die "'$name' is up but is showing something other than its input box, so its hitch message was not delivered — most likely a first-run prompt waiting on you. Answer it with 'gang attach', then 'gang drop $name' and hitch again."
       fi
       printf '%s\n' "$(colour "$C_BAD" "hitched, but a dialog owns ${name}'s screen — answer it with 'gang attach'; deliveries are refused until you do")"
       return 0 ;;
    *) if [ -n "$msg" ]; then
         die "'$name' is running but never went quiet, so its hitch message was not delivered — look at it with 'gang attach' or 'gang capture $name'"
       fi
       printf '%s\n' "$(colour "$C_BAD" "hitched, but $name never went quiet — look at it with 'gang capture $name'")"
       return 0 ;;
  esac
  [ -n "$msg" ] || return 0
  envelope hitch "$msg"
  inject "$id" "$ENVELOPE"
  # Delivered is not actionable. A brief tells the agent to DO something — read
  # its role file, look at a directory — and doing it can trip a permission gate
  # the harness raises as a modal. The pane then holds a dialog only the operator
  # can answer, the work never starts, and the caller was told it was briefed.
  # That cost a review team its whole scope once: three agents briefed, three
  # successes reported, no reviews.
  #
  # It is a RACE and not a proof — the agent has to reach the tool call before
  # this looks — so the two directions are not symmetric. An occupied box shortly
  # after briefing is evidence the brief cannot be acted on. An unoccupied one is
  # no evidence that it can, which is why the success line claims delivery and the
  # quiet window, and nothing beyond them.
  local settle="${GANG_BRIEF_GATE_WAIT:-3}"
  require_interval GANG_BRIEF_GATE_WAIT "$settle"
  if [ -n "${GANG_OCCUPIED_REGEX:-}" ] || declare -F profile_input >/dev/null; then
    sleep "$settle"
    if occupied "$id"; then
      # The exit code is the point. A caller scripting a fan-out reads $?, not
      # prose, so however this is worded it must not exit 0.
      printf '%s\n' "$(colour "$C_BAD" "briefed $name, but a dialog owns its screen within ${settle}s — the brief was delivered and cannot be acted on. Answer it with 'gang attach'")" >&2
      return 1
    fi
  fi
  if [ -n "$role" ]; then
    printf '%s\n' "$(colour "$C_OK" "briefed $name as $role") $(colour "$C_DIM" "(delivered; no gate within ${settle}s — not proof it can act on it)")"
  else printf '%s\n' "$(colour "$C_OK" "delivered session marker to $name")"; fi
}

cmd_up() { # bare `gang up` is the whole setup: a briefed lead, and you in it
  local name="lead" id a role_given=0
  case "${1:-}" in ''|-*) ;; *) name="$1"; shift ;; esac
  for a in "$@"; do case "$a" in -r|--role) role_given=1 ;; esac; done
  if [ "$role_given" -eq 1 ]; then
    cmd_hitch "$name" "$@"
  else
    cmd_hitch "$name" -r "${GANG_ROLE:-lead}" "$@"
  fi
  id="$(win_id "$name")" || die "up: '$name' vanished between hitch and attach"
  # Inside tmux, switch the client instead of refusing: needing to detach first
  # is friction for the one command that is supposed to need nothing.
  if [ -n "${TMUX:-}" ]; then
    exec tmux switch-client -t "=$SESSION" \; select-window -t "$id"
  fi
  exec tmux attach -t "=$SESSION" \; select-window -t "$id"
}

send_occupied_die() { # $1 = window id, $2 = the target's name, $3 = the sender
  # The refusal is right and is unchanged. What was missing sat on the TARGET's
  # side: an occupied routing point stalls the agents trying to reach it, and
  # nothing on its own surfaces said so, so the cost of leaving the modal up was
  # invisible to whoever could clear it.
  #
  # One function because a send now meets this state at two moments — before the
  # hold, and inside it when a dialog paints on an agent that was reachable when
  # the send arrived. They are the same condition found at different times, and an
  # operator gets one wording and one status for it either way.
  blocked_record "$1" "$3"
  die "'$2' is occupied (authority unknown) — a UI owns its input box and gang cannot establish who may clear it; a send would act on that UI instead of landing (gang attach)"
}

cmd_send() {
  local name="" from="${GANG_FROM:-}" wait=0 timeout=300 use_stdin=0 body=""
  name="${1:-}"; [ -n "$name" ] || usage_die; shift
  while [ $# -gt 0 ]; do case "$1" in
    --from)    [ $# -ge 2 ] || die "send: $1 needs a value"; from="$2"; shift 2 ;;
    --timeout) [ $# -ge 2 ] || die "send: $1 needs a value"
               # An unchecked value turned the bound into an unbounded loop: the
               # comparison sits inside an && condition, so its "integer
               # expression expected" never trips errexit and the deadline is
               # never reached.
               require_whole "send: --timeout" "$2" seconds
               timeout="$2"; shift 2 ;;
    -w|--wait) wait=1; shift ;;
    --stdin)   [ "$use_stdin" -eq 0 ] || die "send: --stdin may be passed only once"
               use_stdin=1; shift ;;
    *) die "send: inline message argv is not accepted; write the body to a file, then run: gang send $name --from $from --stdin < file" ;;
  esac; done
  [ "$use_stdin" -eq 1 ] \
    || die "send: message body required on stdin; write the body to a file, then run: gang send $name --from $from --stdin < file"
  stdin_body "send"; body="$STDIN_BODY"
  [ -n "$from" ] || die "send: identity required (--from <sender> or GANG_FROM) — unattributed injection is how the last harness died"
  check_sender "$from"
  resolve "$name"

  # Occupancy beats busy: a UI paints mid-turn, and the mid-turn refusal below
  # would point at --wait, which cannot end a state no amount of waiting ends.
  if occupied "$AGENT_ID"; then
    send_occupied_die "$AGENT_ID" "$name" "$from"
  fi

  # Busy is not, by itself, a reason to refuse. The question a send has to answer
  # is "will this message be delivered?", and gang measures that directly, in the
  # pane, before and after — a state guess is a worse answer than a measurement.
  # What busy genuinely decides is where the keystrokes LAND: a harness that takes
  # input during a turn puts the paste in its input box, while one that does not
  # hands it to whatever that turn is running. So the profile declares which it is
  # and only the second case is refused. Refusing the first is what made a busy
  # lead a black hole and made --wait burn a worker's whole turn waiting on one
  # that never went idle.
  local midturn=0 busy_rc=0 activity_expired=0
  busy "$AGENT_ID" || busy_rc=$?
  case "$busy_rc" in
    0) if [ "$wait" -eq 1 ]; then
         wait_idle "$AGENT_ID" "$name" "$timeout"
         # Matched on the STATE WORD, never on the whole phrase. The qualifier in
         # brackets names which evidence ran out and there is more than one, so a
         # reader testing the full string reads a bracket expiry as "not expired"
         # and delivers into a turn gang could not resolve.
         case "$WAIT_STATE" in expired*) activity_expired=1 ;; esac
       elif [ "${GANG_MIDTURN_INPUT:-}" = 1 ]; then
         midturn=1
       else
         die "'$name' is mid-turn and profile '$AGENT_PROFILE' does not declare mid-turn input — the paste would land in whatever it is running (write the body to a file, then run: gang send $name --from $from --wait --stdin < file)"
       fi ;;
    1) if [ "${GANG_MIDTURN_INPUT:-}" = 1 ] && parked "$AGENT_ID"; then
         # Only an ACTS profile can make a parked pane reach this verdict. The
         # pane is still inside a turn even though it can act on the delivery.
         midturn=1
       fi ;;
    2) if [ "$wait" -eq 1 ]; then
         wait_idle "$AGENT_ID" "$name" "$timeout"
         case "$WAIT_STATE" in expired*) activity_expired=1 ;; esac
       else
         activity_expired=1
       fi ;;
    *) die "internal: busy returned unknown verdict $busy_rc" ;;
  esac
  if [ "$activity_expired" -eq 1 ]; then
    # Expired is neither busy nor idle. A declared composer makes delivery safe
    # and inject still verifies it; without one gang cannot know whether the
    # paste would land in the harness or in a live tool, so the third verdict is
    # a refusal rather than a false idle.
    [ "${GANG_MIDTURN_INPUT:-}" = 1 ] \
      || die "'$name' is in a state gang cannot resolve ($BUSY_EXPIRED_WHAT), so gang cannot determine busy/idle; profile '$AGENT_PROFILE' declares no safe mid-turn input"
    midturn=1
  fi
  envelope "$from" "$body"
  local send_rc=0 qualifier=""
  deliver_held "$AGENT_ID" "$ENVELOPE" "$name" || send_rc=$?
  if [ "$send_rc" -ne 0 ]; then
    # An occupancy found INSIDE the hold, on an agent that was reachable when the
    # send arrived. Same record and same wording as the one found up front, since
    # it is the same condition. Every other failure has already said what it needed
    # to on the way out, and restating it here would only bury it.
    [ "$HELD_OCCUPIED" -eq 0 ] || send_occupied_die "$AGENT_ID" "$name" "$from"
    exit "$send_rc"
  fi
  # The deletion path law 6 asks for, and the only one here that is evidence
  # rather than a timer: traffic moved through this agent again, so whatever its
  # occupancy was blocking is over. A delivery verifies or fails, so reaching this
  # line is a delivery and not an attempt.
  blocked_forget "$AGENT_ID"
  if [ "$activity_expired" -eq 1 ]; then
    qualifier="verified in pane; $BUSY_EXPIRED_WHAT, accepted as potentially mid-turn"
  elif [ "$midturn" -eq 1 ]; then
    # "accepted", not "queued": the box shows a queued-message hint either way,
    # but what the harness does next is its own call — Claude Code hands queued
    # text to the turn already running as often as it holds it for the boundary.
    qualifier="verified in pane, accepted mid-turn"
  else
    qualifier="verified in pane, submitted"
  fi
  # Appended rather than made a fourth branch: a send can be held AND land
  # mid-turn, and both facts are worth having. It says how long and not what for —
  # the reason went to stderr the moment the hold began, which is where it was
  # useful, and a hold can begin for any refusal that typed nothing.
  [ "$HELD_SECONDS" -eq 0 ] \
    || qualifier="$qualifier; held ${HELD_SECONDS}s before it could land"
  echo "$(colour "$C_OK" "delivered to $name as [gang:$from]") $(colour "$C_DIM" "($qualifier)")"
}

cmd_compact() { # trigger the harness's own compaction, via its own command
  local name="" from="${GANG_FROM:-}" resume="" resume_stdin=0
  name="${1:-}"; [ -n "$name" ] || usage_die; shift || true
  while [ $# -gt 0 ]; do case "$1" in
    --resume-stdin) [ "$resume_stdin" -eq 0 ] || die "compact: --resume-stdin may be passed only once"
                    resume_stdin=1; shift ;;
    --resume) # Both names go into a command the agent is told to RUN, so they are
              # quoted for the shell that will read it rather than pasted raw. This
              # site is worse placed than the band note's: the die fires BEFORE
              # resolve, so the name is raw argv that never met valid_name, and
              # --from may not have been parsed yet — %q renders an empty one as ''
              # rather than letting the flag collapse into the word after it. The
              # fail-loud column, not the security one (law 2), and a name that
              # passed valid_name comes through %q byte-identical.
              local qname qfrom
              printf -v qname '%q' "$name"; printf -v qfrom '%q' "$from"
              die "compact: inline resume argv is not accepted; write the resume to a file, then run: gang compact $qname --from $qfrom --resume-stdin < file" ;;
    --from)   [ $# -ge 2 ] || die "compact: $1 needs a value"; from="$2";   shift 2 ;;
    *) die "compact: unknown argument '$1'" ;;
  esac; done
  resolve "$name"
  [ -n "${GANG_COMPACT_CMD:-}" ] || die "profile '$AGENT_PROFILE' declares no compact command"
  if [ "$resume_stdin" -eq 1 ] && [ -z "$from" ]; then
    die "compact: --resume-stdin needs identity (--from <sender> or GANG_FROM) — an unattributed message is an error"
  fi
  [ "$resume_stdin" -eq 0 ] || check_sender "$from"
  if [ "$resume_stdin" -eq 1 ]; then
    stdin_body "compact: --resume-stdin"; resume="$STDIN_BODY"
  fi
  ! occupied "$AGENT_ID" \
    || die "'$name' is occupied (authority unknown) — a UI owns its input box and gang cannot establish who may clear it (gang attach)"
  # Busy is refused for a peer and expected for yourself. Cutting somebody else's
  # live turn throws away work they are in the middle of — that refusal is about
  # what compaction MEANS, not about whether keystrokes can be delivered, so it
  # stays. The turn standing in your own way is the one that ends the moment this
  # command returns, and an agent is busy by definition while it is deciding to
  # compact: refusing there closed the only path self-compaction has.
  local self=""
  self="$(self_window)" || self=""
  local mine=0; [ -n "$self" ] && [ "$self" = "$AGENT_ID" ] && mine=1
  if [ "$mine" -ne 1 ]; then
    local busy_rc=0
    busy "$AGENT_ID" || busy_rc=$?
    case "$busy_rc" in
      0) die "'$name' is mid-turn; compacting now would cut a live turn (gang wait $name first)" ;;
      1) ;;
      2) die "'$name' is in a state gang cannot resolve ($BUSY_EXPIRED_WHAT), so gang cannot determine whether a live turn would be cut; refusing compaction" ;;
      *) die "internal: busy returned unknown verdict $busy_rc" ;;
    esac
  fi

  inject "$AGENT_ID" "$GANG_COMPACT_CMD" head
  # Recorded only after the command verified in the pane: a mark for a compaction
  # that was never typed would hold patrol off a working agent for the whole
  # grace window, which is the failure this is supposed to prevent, aimed the
  # wrong way. Typed is the whole of what it claims — the mark says WE ISSUED
  # ONE, and both readers already carry the case where nothing follows, each
  # giving up at GANG_COMPACT_GRACE.
  compaction_mark "$AGENT_ID"
  # What inject just proved is DELIVERY: the paste changed the input box and the
  # Enter emptied it. It did not prove EXECUTION, and on some harnesses those
  # come apart — codex answers a self-issued `/compact` with "'/compact' is
  # disabled while a task is in progress" (watched live, three attempts, 0.145.0)
  # and clears the composer anyway, so a positive refusal leaves exactly the
  # evidence a success does. That is not a codex quirk to key off: NO profile is
  # confirmed here, because this command returns before any harness has had time
  # to act. compacting() is not consulted, the context has not been re-read, and
  # the one proof gang trusts elsewhere — the readout DROPPING — cannot exist yet.
  # So the word "verified" belongs to the submission and nothing else, and the
  # line below says which of the two it earned (law 8). The suite holds a pair
  # that cannot be told apart from here: one fixture's compact command is a shell
  # comment and never compacts, the other's context drops, and this code path
  # produces the same sentence for both.
  local where="issued to $name"
  [ "$mine" -eq 1 ] && where="issued to yourself, queued behind this turn"
  if [ -n "$resume" ]; then
    # The resume is delivered later by a process nobody is watching, and inject
    # can still refuse it: a gate that painted, a window that went away, a paste
    # that would not verify. Both streams went to /dev/null, so that failure was
    # unobservable while the caller had already been told the resume was on its
    # way — an agent woke with nothing to pick up and nothing said why. The
    # verdict is recorded on the window, where status and patrol read it out.
    tmux set-option -uw -t "$AGENT_ID" @gl_resume_failed 2>/dev/null || true
    # Wrapped before the fork rather than inside it: every stream in that subshell
    # is closed, so an envelope that refused in there would take the resume down
    # without a word reaching any terminal.
    envelope "$from" "$resume"
    ( trap '' HUP INT TERM
      err="$(resume_after_compaction "$AGENT_ID" "$ENVELOPE" 2>&1)" \
        || tmux set-option -w -t "$AGENT_ID" @gl_resume_failed "${err##*$'\n'}"
    ) </dev/null >/dev/null 2>&1 &
    disown
    echo "$(colour "$C_OK" "compaction $where") $(colour "$C_DIM" "($GANG_COMPACT_CMD submitted; execution unconfirmed); resume queued as [gang:$from] for when compaction settles — gang status $name says so if it never lands")"
  else
    # Where the check is offered it has to exist: cmd_context dies on a profile
    # with no introspection, so naming it there would answer an unconfirmed
    # compaction with a second failure.
    local how=""
    declare -F profile_context >/dev/null \
      && how=" — gang context $name shows whether it landed"
    echo "$(colour "$C_OK" "compaction $where") $(colour "$C_DIM" "($GANG_COMPACT_CMD submitted; execution unconfirmed$how)")"
  fi
}

state_now() { # $1 = window id, profile loaded -> the state, in words
  # One namer for `status` and the roster column, so the two cannot answer the
  # same question differently — and renaming a state is one edit, not two. $2 is
  # a churn verdict a batch already resolved; the vocabulary stays here either
  # way, so batching changes what it costs to answer and never what it says.
  if occupied "$1"; then
    activity_hold_clear "$1"
    # No shipped profile classifies the UI it found, and ADR-0004 is explicit
    # that an absent classifier yields authority-unknown rather than the stronger
    # operator-only claim. A profile that earns a narrower qualifier changes this
    # line and nothing else.
    echo "occupied (authority unknown)"
    return
  fi
  if parked "$1"; then
    activity_hold_clear "$1"
    if [ -n "$PARKED_WAIT_TARGET" ]; then
      echo "parked (waiting on $PARKED_WAIT_TARGET)"
    else
      echo "parked (gang wait in progress)"
    fi
    return
  fi
  local busy_rc=0
  busy "$1" "${2:-}" || busy_rc=$?
  case "$busy_rc" in
    0) echo "busy (tight tug)" ;;
    1) echo "idle (slack tug)" ;;
    2) echo "expired ($BUSY_EXPIRED_WHAT)" ;;
    *) die "internal: busy returned unknown verdict $busy_rc" ;;
  esac
}

paint_state() { # $1 = a state phrase, padding and all
  # Matches on the phrase state_now just built, so the two live side by side:
  # renaming a state means seeing this. The fallback is idle's green, which makes
  # a missed rename a wrong colour rather than a wrong state.
  case "$1" in
    occupied*) colour "$C_BAD"  "$1" ;;
    expired*) colour "$C_BAD" "$1" ;;
    parked*) colour "$C_WORK" "$1" ;;
    busy*)  colour "$C_WORK" "$1" ;;
    *)      colour "$C_OK"   "$1" ;;
  esac
}

cmd_status() {
  resolve "$1"
  # Named into a variable first, not nested inside the printf argument. A pane gang
  # cannot read makes state_now die, and the exit status of a substitution that sits
  # in an argument list is thrown away — printf would succeed, print a blank line,
  # and report exit 0 for a state nobody ever established. An assignment carries the
  # failure, so errexit still ends the command (law 8).
  local state failed staged blocked
  state="$(state_now "$AGENT_ID")"
  printf '%s\n' "$(paint_state "$state")"
  # A resume that never landed is the one thing about an agent that its screen
  # cannot show: it is the absence of a message. Scripts keep matching the state
  # prefix on line one.
  failed="$(tmux show-options -wqv -t "$AGENT_ID" @gl_resume_failed)"
  [ -z "$failed" ] \
    || printf '%s\n' "$(colour "$C_BAD" "resume NOT delivered after compaction: $failed")"
  # A staged paste IS on the screen, but it reads as a message this agent is
  # about to send rather than one somebody else abandoned in its box, and the
  # damage is done by whoever types next.
  staged="$(staged_note "$AGENT_ID")"
  [ -z "$staged" ] \
    || printf '%s\n' "$(colour "$C_BAD" "undelivered paste in the input box: $staged")"
  # The other thing this agent's screen cannot show: what its own occupancy is
  # costing somebody else. The modal is visible; the peer stalled behind it is not.
  blocked="$(blocked_line "$AGENT_ID")"
  [ -z "$blocked" ] \
    || printf '%s\n' "$(colour "$C_BAD" "$blocked")"
}

cmd_context() { # context-window usage via the profile's own introspection
  local name="${1:-}"; [ -n "$name" ] || usage_die
  resolve "$name"
  declare -F profile_context >/dev/null \
    || die "profile '$AGENT_PROFILE' declares no context introspection"
  context_now "$AGENT_ID"
}

cmd_roster() {
  session_live \
    || { printf '%s\n' "$(colour "$C_DIM" "no team (session '$SESSION' not running)")"; return; }
  local id name wins
  wins="$(tmux list-windows -t "=$SESSION" -F '#{window_id} #W')"
  # One wait for the whole team rather than one per agent. The splitting is the
  # point — a window id is one word, and churn_batch takes them as arguments.
  # shellcheck disable=SC2046
  churn_batch $(printf '%s\n' "$wins" | awk '{print $1}')
  while read -r id name; do
    [ -n "$id" ] || continue
    ( roster_row "$id" "$name" "$(churn_verdict "$id")" ) || true   # one sick agent must not blank the roster
  done <<EOF
$wins
EOF
}

roster_row() { # $1 = window id, $2 = name, $3 = churn verdict if a batch resolved it;
               # subshell — a death here costs one row
  local prof state ctx="-" brief
  prof="$(tmux show-options -wqv -t "$1" @gl_profile)"
  [ -n "$prof" ] || { printf '%-16s %-12s %-18s %s\n' "$2" "-" "-" \
                        "$(colour "$C_DIM" "unadopted")"; return; }
  # A profile gang cannot resolve is reported, never dropped: patrol runs from
  # cron, where the GANG_PROFILES that hitched this agent is not in the
  # environment, and an agent missing from the roster reads as no agent at all.
  profile_file "$prof" >/dev/null \
    || { printf '%-16s %-12s %-18s %s\n' "$2" "$prof" "-" \
           "$(colour "$C_BAD" "profile not found (GANG_PROFILES?)")"; return; }
  load_profile "$prof"
  state="$(state_now "$1" "${3:-}")"
  # context column is best-effort observation; the dedicated command dies loud
  if declare -F profile_context >/dev/null; then
    ctx="$(context_now "$1" 2>/dev/null)" || ctx="-"
  fi
  ctx="${ctx%%$'\n'*}"
  # The roster is the surface a lead scans, so an abandoned paste sitting in
  # somebody's box belongs on it — three words, because the sentence explaining
  # it is what gang status is for.
  [ -z "$(staged_note "$1")" ] || ctx="$ctx $(colour "$C_BAD" "undelivered paste")"
  # The mirror of that note: the paste is what somebody left in this box, this is
  # what this box turned away. Neither fits in the state column, and both are the
  # reason a lead is reading the roster at all — an occupied agent nobody wants is
  # a curiosity, and an occupied agent three peers are stacked behind is the thing
  # to go and clear.
  brief="$(blocked_brief "$1")"
  [ -z "$brief" ] || ctx="$ctx $(colour "$C_BAD" "$brief")"
  # The third thing an agent's own screen cannot show, and the only one that is an
  # ABSENCE: a resume that never arrived looks exactly like an agent with nothing
  # to do. Without this the roster read `lead  claude-code  busy (tight tug)  41k…`
  # with no hint, and the sole surface that reported it was `gang status <name>` —
  # which an operator runs about an agent they already suspect. Same shape as the
  # cost above it: a failure visible only to somebody who has already guessed it.
  [ -z "$(tmux show-options -wqv -t "$1" @gl_resume_failed)" ] \
    || ctx="$ctx $(colour "$C_BAD" "resume lost")"
  printf '%-16s %-12s %s %s\n' "$2" "$prof" \
    "$(paint_state "$(printf '%-18s' "$state")")" "$ctx"
}

say() { # $1 = name, $2 = context readout, $3 = verdict, $4 = colour (default: dim)
  # Dim by default because most of a sweep is "nothing to do here"; a caller with
  # something worth an operator's eye passes the colour that says so.
  printf '%-16s %-18s %s\n' "$1" "$2" "$(colour "${4:-$C_DIM}" "$3")"
  patrol_log "$1" "$2" "$3"
}

patrol_log() { # $1 = name, $2 = readout, $3 = verdict; the record a sweep leaves behind
  [ -n "$GANG_PATROL_LOG" ] || return 0
  # An operator watching a sweep does not also need it written down, and the same
  # test already decides colour, so an interactive `gang patrol` stays a read-only
  # command. Under cron, stdout is not a terminal and the sweep is recorded.
  [ ! -t 1 ] || return 0
  # The ONLY thing dropped, and it is dropped by name rather than by failing to
  # match a list of things worth keeping. A verdict added tomorrow is recorded
  # tomorrow, with no edit here and none to anybody's crontab — which is the
  # property the allowlist this replaces did not have.
  case "$3" in steady*) return 0 ;; esac
  local dir; dir="$(dirname "$GANG_PATROL_LOG")"
  mkdir -p "$dir" 2>/dev/null || return 0
  require_whole GANG_PATROL_LOG_MAX "$GANG_PATROL_LOG_MAX" bytes
  if [ -f "$GANG_PATROL_LOG" ] \
     && [ "$(wc -c < "$GANG_PATROL_LOG")" -gt "$GANG_PATROL_LOG_MAX" ]; then
    mv -f "$GANG_PATROL_LOG" "$GANG_PATROL_LOG.1" 2>/dev/null || true
  fi
  # Never coloured: the escapes would be in the file rather than on a screen. And
  # never allowed to take the sweep down — a log is a record of the work, not the
  # work, so a full disk or an unwritable path costs the line and nothing else.
  printf '%s %-16s %-18s %s\n' "$(date +%Y-%m-%dT%H:%M:%S%z)" "$1" "$2" "$3" \
    >> "$GANG_PATROL_LOG" 2>/dev/null || true
}

cmd_cutoff() { # declare, show, or clear the team's wall-clock cutoff
  local sub="${1:-}" now rc ago
  [ $# -le 1 ] || usage_die
  case "$sub" in -*) usage_die ;; esac
  session_live || die "no session '$SESSION' running"
  # Settled here, at statement level, because this is where its refusal can be
  # heard: every other route to it runs inside a command substitution.
  date_dialect
  now="$(now_epoch)"
  if cutoff_read; then rc=0; else rc=$?; fi
  # A stored value gang cannot read is a third answer rather than absence — but
  # `clear` is the remedy this very refusal names, so it runs in spite of it. A
  # remedy that dies on the state it exists to remove is not one, and refusing it
  # here would leave an unreadable pair with nothing short of the session's end
  # to get rid of it.
  [ "$rc" -ne 2 ] || [ "$sub" = clear ] \
    || die "the stored cutoff for session '$SESSION' is not a pair of epochs — 'gang cutoff clear' removes it"
  case "$sub" in
    "")
      # An explicit query is answered, always. "An undeclared budget produces
      # silence" governs the NOTES a ladder does or does not inject; a question
      # answered with nothing is the fabricated status law 8 refuses, and the
      # operator cannot tell it from a cutoff that failed to store.
      [ "$rc" -eq 0 ] || { printf 'no cutoff declared\n'; return 0; }
      ago=$(( now - CUTOFF_DECLARED ))
      # Only a clock that moved backwards produces a negative age, which is a
      # test moving GANG_NOW rather than anything an operator can do. Reported as
      # fresh rather than as a negative span, since the pair is intact either way.
      [ "$ago" -ge 0 ] || ago=0
      printf '%s (declared %s ago)\n' "$(cutoff_line "$now")" "$(human_span "$ago")"
      ;;
    clear)
      # Only a genuinely absent cutoff is nothing to clear. An unreadable one is
      # something stored, and taking it away is the whole reason to come here.
      [ "$rc" -ne 1 ] || { printf 'no cutoff declared\n'; return 0; }
      cutoff_forget
      printf 'cutoff cleared\n'
      ;;
    *)
      cutoff_parse "$sub" "$now"
      cutoff_write "$CUTOFF_PARSED" "$now"
      # Declaring again re-spans from NOW: last declaration wins, and the pair it
      # writes is the whole of the team's budget from this moment (ADR-0009).
      CUTOFF_AT="$CUTOFF_PARSED"; CUTOFF_DECLARED="$now"
      printf '%s\n' "$(cutoff_line "$now")"
      ;;
  esac
}

cmd_patrol() { # ambient warning leg: nudge past a context band, and past a budget rung
  # gang hook covers harnesses whose hook system can call gang in-turn;
  # patrol covers the rest (Pi's model never sees its own status bar). Both
  # read the same profile readout, run the same context ladder, and share the
  # same @gl_band memory, so whichever notices a crossing first advances the
  # band and the other reports steady — one note per band, never two.
  #
  # That pairing is about the context axis by itself. The budget's warning leg
  # is time_nudge, which patrol carries and gang hook does not, so it keeps its
  # own memory in @gl_tband and answers to nothing the hook does.
  #
  # Band memory is a window option: exactly as long-lived as the agent, so a
  # re-hitched name starts clean and tmux is the one that deletes it (Law 1,
  # Law 6 — no cleanup code, no state outliving its subject). Warn, don't act —
  # compaction timing is the agent's judgment (gang compact exists to force it).
  session_live \
    || { printf '%s\n' "$(colour "$C_DIM" "no team (session '$SESSION' not running)")"; return; }
  ladder context 0 200000 >/dev/null  # one loud complaint about a bad ladder, not one per agent
  time_sweep                          # the team's budget, settled once for every row this prints
  local id name
  while read -r id name; do
    ( patrol_one "$id" "$name" ) || true
  done < <(tmux list-windows -t "=$SESSION" -F '#{window_id} #W')
}

patrol_one() { # $1 = window id, $2 = name; subshell — a death here skips this agent,
               # not the sweep, and advances no state, so the next sweep retries.
  local prof ctx tw tokens window band crossed thresholds prev failed rung now
  local state_rc compaction_rc=0 blocked top_repeat=0
  failed="$(tmux show-options -wqv -t "$1" @gl_resume_failed)"
  [ -z "$failed" ] \
    || say "$2" "-" "RESUME NOT DELIVERED after compaction — $failed" "$C_BAD"
  # Refused inbound belongs with the other things an agent's own screen cannot
  # show, and it belongs ABOVE the occupancy report that returns early: the case
  # ADR-0004 was written from is an occupied routing point with peers stacking up
  # behind it, and reporting the occupancy while withholding what it costs is the
  # half of that story the operator already has. It needs no profile, so a sweep
  # that cannot resolve one still carries it.
  blocked="$(blocked_line "$1")"
  [ -z "$blocked" ] || say "$2" "-" "$blocked" "$C_BAD"
  prof="$(tmux show-options -wqv -t "$1" @gl_profile)"
  [ -n "$prof" ] || { say "$2" "" "unadopted — not patrolled"; return; }
  # The time axis needs no profile and no readout, so its row is produced above every
  # early return that turns on one — the resume-failed and blocked-line reports are
  # the same shape for the same reason. It sits under the adoption check because a
  # window nobody hitched is not an agent and has no budget to be reported against,
  # and over the profile checks because a budget is gang's own arithmetic rather than
  # anything a harness reports. The readout column is a dash for the same reason
  # those two reports use one: there is no context figure in this row.
  [ -z "$TIME_SAY" ] || say "$2" "-" "$TIME_SAY" "$TIME_COLOUR"
  profile_file "$prof" >/dev/null \
    || { say "$2" "" "profile '$prof' not found (GANG_PROFILES?) — not patrolled" "$C_BAD"; return; }
  load_profile "$prof"
  # The sweep is the other half of the staged-paste record: a send may never come
  # for this agent, and patrol is what runs anyway. Clearing is attempted first —
  # it refuses on its own account if the modal is still up — so the report below
  # is about what actually survived, not what was true a second ago.
  if [ -n "$(staged_note "$1")" ]; then
    # Under the delivery lock, because stage_clear reaches clear_box and clear_box
    # TYPES — up to GANG_CLEAR_PRESSES line-kills into a live pane. inject holds the
    # lock across its own stage_clear; this path is the same function on the other
    # caller, and it ran unlocked. That is the exact collision the lock exists for
    # (a patrol nudge merging with a lead's send, lived twice in one afternoon),
    # except it fails in the corrupting direction rather than the noisy one: an
    # unlucky interleave eats text another writer just pasted and both writers are
    # told they succeeded. Patrol runs on cron every two minutes.
    #
    # Released here rather than held to the end of the sweep, because the nudge
    # below goes through inject, which takes this same lock and would otherwise
    # wait thirty seconds on a lock this process is already holding.
    lock_pane "$1"
    stage_clear "$1"
    lock_release
    if [ -n "$(staged_note "$1")" ]; then
      say "$2" "-" "UNDELIVERED PASTE — $(staged_note "$1") (gang attach)" "$C_BAD"
    else
      say "$2" "-" "cleared an undelivered paste out of the input box" "$C_OK"
    fi
  fi
  if occupied "$1"; then
    # Gang cannot establish who clears this UI, so this is a report and not a
    # nudge — and it comes before the context checks so an occupied agent whose
    # readout is missing still reads loud rather than skipped.
    say "$2" "-" "OCCUPIED (authority unknown) — a UI owns the input box and gang cannot establish who may clear it (gang attach)" \
      "$C_BAD"
    return
  fi
  # THE NOTE SITS LOWER THAN THE ROW, and the gap between them is the placement.
  # Reporting a budget needs neither a profile nor a readout, so the row is hoisted
  # over every early return that turns on one. TYPING needs both halves of a profile
  # — occupied() reads the profile's own regex to decide who owns the input box, and
  # input_clear() asks profile_input what counts as content — so the note can come no
  # higher than here, the first point at which the pane is known safe to write to.
  # It stops short of the context leg, which starts at the profile_context check and
  # is about the READOUT the whole way down; the budget is gang's own arithmetic.
  #
  # That gap is the whole point rather than a leftover. An agent whose beacon has
  # gone missing is still inside the team's budget, and time is the axis that
  # advances while an agent sits idle — which is why patrol is this axis's primary
  # leg (ADR-0009). So the sweep that gives up on an agent's context still tells it
  # how much of the day is left. What gets the row and no note is a pane gang cannot
  # type into at all — a profile it cannot resolve or load, and an input box a
  # harness UI owns — and that is correct: the row is arithmetic and the note is
  # keystrokes.
  #
  # The note also STATES ITS NUMBER where the context note refuses to. That is
  # deliberate and argued in time_note — remaining budget is the pacing input, while
  # remaining context is an allowance nobody should spend — so do not straighten the
  # two into agreement.
  time_nudge "$1" "$2"
  declare -F profile_context >/dev/null \
    || { say "$2" "" "profile declares no context readout — not patrolled"; return; }
  ctx="$(context_now "$1" 2>/dev/null)" \
    || { say "$2" "" "no context readout — not patrolled (beacon missing?)" "$C_BAD"; return; }
  ctx="${ctx%%$'\n'*}"
  ctx="$(ctx_measured "$ctx")"
  tw="$(ctx_tokens "$ctx")" \
    || { say "$2" "$ctx" "unparseable readout — not patrolled" "$C_BAD"; return; }
  read -r tokens window <<<"$tw"
  # Zero is not a reading of zero, and it is the FALLBACK TIER'S way of being
  # wrong: the owned fact refuses a zero before it is believed at all, so a zero
  # arriving here has come off the pane by construction. Every live agent carries
  # a system prompt of thousands of tokens, so a zero used-figure is the beacon
  # caught between paints — and the ladder below would spend it as EVIDENCE THAT
  # USAGE DROPPED.
  # An agent sitting at the top rung has its band memory re-armed to the bottom,
  # and its next real warning arrives as the gentle first-rung note, at the point
  # where it least applies. Four rows of `0k/1000k re-armed (usage dropped)` in
  # one day's log. The compaction leg already refuses to believe a drop without a
  # nonzero figure behind it; this is the same rule on the same evidence.
  if [ "$tokens" -eq 0 ]; then
    say "$2" "$ctx" "context readout came back zero — not patrolled, band memory kept" "$C_BAD"
    return
  fi
  # ladder's refusal has to be CARRIED. `die` inside a command substitution ends
  # THAT subshell, not this one, so its message reaches stderr while the caller
  # reads an empty band and walks on into an integer comparison — a refusal that
  # does not refuse, reported as a shell error rather than as the thing it found.
  if rung="$(ladder context "$tokens" "$window")"; then
    read -r band crossed thresholds <<<"$rung"
  else
    return
  fi
  if band_state_read "$1" @gl_band; then state_rc=0; else state_rc=$?; fi
  if [ "$state_rc" -ne 0 ]; then
    # An unreadable memory is grounds to REBUILD the memory, never to stop
    # patrolling the agent. This option is a cache and nothing else — which band
    # an agent was last warned in — and refusing on it spends that one uncertainty
    # as a decision to disable the context warning leg for the whole life of the
    # window, because a `return` here reaches nothing that would rewrite the value.
    # Permanent, and silent: the verdict below is the only trace, and it names no
    # band, so it does not match a log filter written around band phrases.
    #
    # Lived it. A window carried the three-field value an older gang wrote; the
    # reader that understood that shape was deleted along with the apparatus that
    # needed it, and this agent went unpatrolled for five hours with its context
    # climbing the whole time, while a sweep every two minutes said so into a pipe
    # that dropped the line.
    #
    # Re-establishing at the CURRENT band keeps the guarantee the refusal was
    # protecting — an agent already warned is not warned twice — and gives up at
    # most the one crossing already behind us. It heals in a single sweep, which
    # is what makes it a general answer rather than a patch for one format: every
    # future change to this value's shape now costs one skipped nudge instead of a
    # silent agent. And it gives up least where silence costs most, because an
    # agent re-established at its ladder's top is nudged again on the next sweep
    # regardless (ladder_at_top), rather than waiting for a crossing that cannot
    # come.
    band_state_write "$1" @gl_band "$band"
    say "$2" "$ctx" "context-band memory was unreadable — re-established at band $band, warnings resume next sweep" "$C_BAD"
    return
  fi
  prev="$BAND_STATE_BAND"
  now="$(date +%s)"
  # The mark question is independent of the ladder question. Keeping it inside
  # the rising-band elif made its positive drop proof unreachable whenever the
  # post-drop context fell below the first rung: those marks cleared on the clock
  # despite the evidence sitting in this very readout. Ask on every patrol and
  # cache the answer; only a genuinely pending mark participates in the later
  # injection decision.
  compaction_pending "$1" "$tokens" || compaction_rc=$?
  case "$compaction_rc" in
    0|1|2) ;;
    *) die "internal: compaction_pending returned unknown verdict $compaction_rc" ;;
  esac

  # Injecting into a pane that is not quietly idle corrupts it, so every guard
  # below skips rather than risks it — and a skip never burns state.
  # A steady agent normally stops here. The sole exception is one already at its
  # own ladder's last rung: there is no crossing above it to re-arm the warning,
  # so it remains an open question and reaches the SAME guard chain as a fresh
  # nudge. Deciding that exception before the chain, rather than injecting from
  # the steady branch, is what keeps compaction, busy, churn and composer safety
  # in force on every repeat.
  if [ "$band" -eq "$prev" ] && ladder_at_top "$band" "$thresholds"; then
    top_repeat=1
  fi
  if [ "$band" -lt "$prev" ]; then
    band_state_write "$1" @gl_band "$band"
    say "$2" "$ctx" "re-armed (usage dropped)"
  elif [ "$band" -eq "$prev" ] && [ "$top_repeat" -eq 0 ]; then
    say "$2" "$ctx" "steady (band $band)"
  elif [ "$compaction_rc" -eq 0 ]; then
    # A REDUNDANCY guard, not a safety one, and the distinction is what bounds it.
    # This agent was told to compact within the grace window and is presumably
    # acting on that, so a second note carrying the same instruction is noise.
    # GANG_COMPACT_GRACE is the whole of its reach, which is what makes it
    # incapable of the permanent silence the expired case below used to cause.
    #
    # Two tiers reach this branch and they do not hold for the same reason, so the
    # phrase comes from the reader rather than being written out here. A mark says
    # gang typed a command and is waiting on proof; a bracket says the harness is
    # compacting right now and names which kind. Same action, and reporting them
    # under one sentence would be gang telling an operator it issued a compaction
    # the agent started by itself.
    say "$2" "$ctx" "past the ${crossed}-token band — ${COMPACTION_PENDING_WHAT}, holding nudge" "$C_WORK"
  elif [ "$compaction_rc" -eq 2 ]; then
    # The grace ran out and the context never dropped, so gang has no evidence
    # either way about whether a compaction happened. Holding on that spent
    # "could not determine" as "determined", in the one direction with no floor
    # under it: nothing rewrites an expired mark, so the hold outlived every
    # sweep and the agent went unwarned for as long as its window lived.
    #
    # It was reachable by construction, too. compaction_mark records tokens=0
    # when the readout is unavailable, and the drop check that would clear the
    # mark is gated on a NONZERO issue figure — so a zero mark can only ever
    # arrive here, permanently. The readout is least available mid-render, which
    # is exactly when a compaction is running.
    #
    # So: reported once, then repaired. Same shape as an unreadable band memory —
    # name the anomaly, clear the state that cannot be trusted, let the next sweep
    # patrol normally. One sweep of delay, and it cannot recur for this mark
    # because the mark is gone.
    #
    # This was never a safety guard, whatever the wording suggested. Injecting
    # into a compacting pane has not been shown to lose a message: on claude-code,
    # input entered once compaction is UNDERWAY queues and is submitted when it
    # finishes. Nor does gang have to predict it, on that harness or any other,
    # because inject verifies the paste it makes and refuses loudly when it does
    # not land — which is a measurement, where this was a guess.
    compaction_clear "$1"
    say "$2" "$ctx" "past the ${crossed}-token band — compaction gang issued never proved; mark cleared, warnings resume next sweep" "$C_BAD"
  # busy_painted and pane_stable are deliberately NOT asked here. Both were
  # proxies for "this pane might be compacting", and as proxies they fail in both
  # directions at once. Under-inclusive: the compacting claude-code pane they were
  # written for paints no marker and holds a still screen, so it satisfies both and
  # sails through — the branch above says as much, which means the mark is already
  # carrying that case alone. Over-inclusive: every agent doing work churns, and an
  # agent doing work is precisely the one whose context climbs, so the guards
  # excluded exactly the population the warning leg exists to serve. Watched a lead
  # hold at 199k-201k for six consecutive sweeps and get through at 211k only
  # because one sample happened to land on a still frame.
  #
  # And the thing being gated is PROSE. It queues: both shipped harnesses take
  # type-ahead during a turn, so a nag pasted into a busy agent arrives one turn
  # late, which is what a nag is for. Weigh that against a nag that never arrives
  # and the asymmetry is entirely one-sided. Note which way it used to run — the
  # strict bar was on the nag and the weak one on the thing that actually types.
  #
  # What is left is not weaker, it is more exact. The compaction mark above is a
  # signal rather than a scrape. input_clear below keeps gang out of somebody's
  # draft. inject refuses an occupied pane, because a modal owns its input box and
  # keystrokes would answer a dialog instead of landing — real damage, unlike a
  # late message — and refuses a composer in motion. Past that, inject VERIFIES,
  # so a paste that does not land fails loud instead of being guessed at in
  # advance, which is the whole of law 3.
  elif ! input_clear "$1"; then
    # Somebody's unsent text is in the input box and an injection would
    # interleave with it. On a profile that cannot tell typed text from the
    # harness's own suggestions this also holds for ghost text, which costs a
    # sweep and never costs a draft. Holding is the cheap direction either way.
    say "$2" "$ctx" "past the ${crossed}-token band — input box has content, holding nudge" "$C_WORK"
  else
    if [ "$top_repeat" -eq 1 ]; then
      envelope patrol "$(band_note "$(ctx_carried "$ctx")" "$crossed" "$2" "$band" "$thresholds" repeat)"
    else
      envelope patrol "$(band_note "$(ctx_carried "$ctx")" "$crossed" "$2" "$band" "$thresholds")"
    fi
    inject "$1" "$ENVELOPE"
    if [ "$top_repeat" -eq 1 ]; then
      say "$2" "$ctx" "NUDGED (past the last band; repeats every safe patrol until usage drops)" "$C_OK"
    else
      band_state_write "$1" @gl_band "$band"
      say "$2" "$ctx" "NUDGED (crossed the ${crossed}-token band)" "$C_OK"
    fi
  fi
}

# --- the patrol crontab entry -----------------------------------------------
#
# gang derives this entry instead of a README asking somebody to paste one, and
# the reason is the outage recorded beside GANG_PATROL_LOG: the entry was pasted
# once, the tool changed under it, and a crontab is the one part of an install
# that updating never touches. So the canonical line comes from this install,
# `gang cron --install` writes it, install.sh refreshes one that already exists,
# and `gang vet` says when the entry in force stopped matching. Nothing here runs
# on a schedule — cron does that, and gang only ever describes the entry.

cron_quote() { # $1 = value, as /bin/sh and then cron will read it
  # Quoted only when it has to be. A bare path is what an operator writes by
  # hand and vet compares this text against theirs, so quoting everything would
  # report drift on a line that is already right. The % escape goes on last
  # because it belongs to cron's layer rather than the shell's: cron reads an
  # unescaped % as a newline and would cut the command off at it.
  local v="$1"
  case "$v" in
    ''|*[!A-Za-z0-9_./:@+,=-]*) v="'${v//\'/\'\\\'\'}'" ;;
  esac
  printf '%s' "${v//%/\\%}"
}

cron_gang() { # the path a crontab should call, for this install
  # The name on PATH wins when it resolves to THIS tree: that is the path the
  # docs show, and it survives a reinstall into a different directory because
  # install.sh repoints the symlink while the crontab entry stays put. Anything
  # else — no PATH entry at all, or one belonging to a second install — falls
  # back to this tree's own bin, which is unambiguous if less durable.
  local p
  if p="$(command -v gang 2>/dev/null)" && [ -n "$p" ]; then
    case "$p" in
      /*) [ "$(gang_root "$p" 2>/dev/null)" != "$ROOT" ] || { printf '%s\n' "$p"; return; } ;;
    esac
  fi
  printf '%s\n' "$ROOT/bin/gang"
}

cron_line() { # the canonical patrol entry for this install and this environment
  # The carried overrides are an EXCLUSION list, for the reason the patrol log is
  # one: a list of knobs worth carrying cannot carry a knob that did not exist
  # when the list was written, and nobody revisits a crontab entry when the tool
  # changes. So every GANG_* override exported here goes into the line, and the
  # four that are per-invocation or test-only are named. TMUX_TMPDIR joins them
  # because it is the variable tmux reads to find its socket directory, and a
  # sweep that cannot reach the server is the outage by another route;
  # XDG_STATE_HOME because a sweep logging somewhere other than the interactive
  # runs do splits the record in half.
  #
  # Only what is EXPORTED, never a default: gang's own defaults are plain shell
  # variables, and writing them into cron would freeze today's value into a line
  # that outlives the version that chose it.
  local n names out='*/2 * * * * '
  # Sorted so the same environment always produces the same text, because vet
  # compares this against what is in force and bash's own variable order is not a
  # promise. Selected in shell rather than through grep, and the failure is fatal
  # rather than empty: a filter that comes back with nothing to say looks exactly
  # like an environment with nothing to carry, and the entry it would then write —
  # no session, no lock directory — sweeps the wrong team every two minutes and
  # says so nowhere.
  names="$(compgen -e | sort)" \
    || die "cron: could not read the exported environment, so the entry cannot say what a sweep must agree with"
  while IFS= read -r n; do
    case "$n" in
      GANG_FROM|GANG_PROFILE_FILE|GANG_SESSION_KEY|GANG_TEST_PROFILES) continue ;;
      GANG_*|TMUX_TMPDIR|XDG_STATE_HOME) ;;
      *) continue ;;
    esac
    out="$out$n=$(cron_quote "${!n}") "
  done <<EOF
$names
EOF
  printf '%s%s patrol >/dev/null 2>&1\n' "$out" "$(cron_quote "$(cron_gang)")"
}

cron_is_patrol() { # $1 = a crontab line; a live gang patrol entry?
  local t="$1" re="gang['\"]?[[:space:]]+patrol([[:space:]]|\$)"
  t="${t#"${t%%[![:space:]]*}"}"
  # A commented-out entry stays commented. Replacing one would re-enable a sweep
  # the operator turned off, which is the opposite of what either verb promises.
  case "$t" in ''|'#'*) return 1 ;; esac
  [[ "$t" =~ $re ]]
}

cron_line_session() { # $1 = a crontab line; the session its patrol sweeps
  # A patrol sweeps one session, so a two-team host runs two entries and each
  # verb here has to leave the other one alone.
  local s="$1"
  case "$s" in
    *GANG_SESSION=*) s="${s#*GANG_SESSION=}"; s="${s%%[[:space:]]*}"
                     s="${s#[\'\"]}"; s="${s%[\'\"]}" ;;
    *) s="$DEFAULT_SESSION" ;;
  esac
  printf '%s\n' "$s"
}

cron_read() { # the crontab in force, or nothing when there is none
  # `crontab -l` exits nonzero both for "no crontab for this user" and for a real
  # failure, and nothing portable tells them apart. Reading either as empty is
  # safe here for one reason: the only writer is `crontab -`, run as the same
  # user through the same binary, so an environment that cannot list a crontab
  # cannot replace one either — the write fails loud rather than landing a table
  # with the operator's other entries missing.
  crontab -l 2>/dev/null || true
}

cron_installed() { # the patrol entry in force for THIS session, if any
  local line
  while IFS= read -r line; do
    cron_is_patrol "$line" || continue
    [ "$(cron_line_session "$line")" = "$SESSION" ] || continue
    printf '%s\n' "$line"
    return 0
  done <<EOF
$(cron_read)
EOF
  return 1
}

cmd_cron() {
  local mode=print
  while [ $# -gt 0 ]; do
    case "$1" in
      --install) mode=install; shift ;;
      # The installer's verb: it refreshes what the operator already chose and
      # never chooses for them. A `curl | sh` that writes itself into somebody's
      # crontab is a different bug from the one this command exists to fix.
      --refresh) mode=refresh; shift ;;
      *) die "cron: unknown argument '$1'" ;;
    esac
  done
  local want; want="$(cron_line)"
  [ "$mode" != print ] || { printf '%s\n' "$want"; return 0; }

  if ! command -v crontab >/dev/null 2>&1; then
    # Nothing to refresh on a host with no crontab, and nothing this command can
    # do about it either. `gang cron` still prints the line for whatever else
    # schedules jobs here.
    [ "$mode" != refresh ] || return 0
    die "cron: no crontab command on this host — 'gang cron' prints the entry for whatever schedules jobs here"
  fi

  local have; have="$(cron_installed)" || have=""
  if [ "$have" = "$want" ]; then
    printf 'patrol entry for session %s is already current\n' "$SESSION"
    return 0
  fi
  if [ -z "$have" ] && [ "$mode" = refresh ]; then
    printf 'no patrol entry for session %s — crontab left alone (gang cron --install adds one)\n' "$SESSION"
    return 0
  fi

  local cur line out="" found=0
  cur="$(cron_read)"
  if [ -n "$cur" ]; then
    while IFS= read -r line; do
      # Replaced where it sits, so the operator's ordering and their other
      # entries survive a refresh unchanged.
      if [ "$found" -eq 0 ] && cron_is_patrol "$line" \
         && [ "$(cron_line_session "$line")" = "$SESSION" ]; then
        found=1
        out="$out$want"$'\n'
        continue
      fi
      out="$out$line"$'\n'
    done <<EOF
$cur
EOF
  fi
  [ "$found" -eq 1 ] || out="$out$want"$'\n'
  printf '%s' "$out" | crontab - \
    || die "cron: could not write the crontab — the entry in force is unchanged"
  if [ "$found" -eq 1 ]; then
    # The displaced entry is printed because there is no undo for a crontab and
    # this is the only moment it can be shown. An operator who wanted it back has
    # it on screen to paste; one who does not can ignore two lines.
    printf 'patrol entry for session %s replaced.\n  was: %s\n  now: %s\n' "$SESSION" "$have" "$want"
  else
    printf 'patrol entry for session %s added:\n  %s\n' "$SESSION" "$want"
  fi
}

# ===[ hook-ingestion ]=======================================================

cmd_hook() { # the one ingestion verb: a harness fires this from the agent's pane, per event
  # ADR-0008. The harness runs the SAME command for every event it is wired for,
  # this branches on the native event name, and the event-to-fact mapping is
  # gangline's vocabulary rather than the settings file's — so the wiring names
  # claude-code's events and nothing else, and what those MEAN to gang is decided
  # here, in one place, beside the readers that consume them.
  #
  # The binding is $TMUX_PANE to @gl_profile to that window's own options, and it
  # is the only one there is: TMUX_PANE is inherited by everything the harness
  # spawns inside its pane, and no hook payload carries a pane id. No pane means
  # this harness is not a gangline agent and has no fact to record.
  #
  # THIS COMMAND ALWAYS EXITS 0. A translator that can fail its harness's own turn
  # is the self-management loop law 7 forbids wearing a new coat, so there is no
  # decision channel here — no exit 2, no "decision":"block" — and every leg is
  # arranged so the worst it can do is write nothing. Law 8's loudness lives one
  # level up, where a fact that stops arriving surfaces as expiry.
  local payload event prof
  payload="$(cat)" || payload=""
  event="$(printf '%s' "$payload" \
    | python3 -c 'import json,sys; print(json.load(sys.stdin).get("hook_event_name",""))' \
    2>/dev/null)" || exit 0
  [ -n "$event" ] || exit 0
  [ -n "${TMUX_PANE:-}" ] || exit 0
  prof="$(tmux show-options -wqv -t "$TMUX_PANE" @gl_profile 2>/dev/null)" || exit 0
  [ -n "$prof" ] || exit 0

  # The write path, and it is dumb on purpose: distil the payload to the fact
  # vocabulary and store it. Nothing here weighs, compares or decides — that
  # happens at read time, in the verdict functions, at the moment a question is
  # actually asked. It is why nothing processes a stream and nothing needs a
  # daemon.
  #
  # An event with no case is ignored in silence, and that is the wiring rule
  # rather than a gap: only events feeding a declared predicate with a live
  # consumer are wired (law 5), so one arriving here unmapped is either an
  # operator's own hook sharing the command or an event whose consumer has not
  # landed yet. Neither is gang's to act on.
  case "$event" in
    # Both open the bracket, and the difference between them is entirely in
    # turn_mark: the first is a transition and gets a log row, the second lands on
    # a bracket already open and is a heartbeat, which does not.
    UserPromptSubmit|PostToolUse) turn_mark "$TMUX_PANE" open ;;
    Stop)                         turn_mark "$TMUX_PANE" closed ;;
    # The compaction bracket, and it is NOT turn-shaped however alike the two
    # read. No Stop fires for a compaction, so nothing else could close this; the
    # composer is usable a second or two after PostCompact, so the close is the
    # end of the thing rather than the start of a wait; and both events carry a
    # `trigger` the turn events have no equivalent of, which is the only way gang
    # can tell its own /compact from the harness compacting on its own threshold.
    #
    # SILENT, and that is enforced by the allowlist below rather than by this arm.
    # Whatever else changes here, neither name may join that list.
    PreCompact)  compaction_bracket_mark "$TMUX_PANE" open   "$(hook_trigger_of "$payload")" ;;
    PostCompact) compaction_bracket_mark "$TMUX_PANE" closed "$(hook_trigger_of "$payload")" ;;
    # The occupancy raise, and it is a raise rather than a bracket: nothing at all
    # fires when the dialog goes away, so this arm can only ever add the fact and
    # the pane is what retires it.
    #
    # SILENT, and on this event that is not a convention but the entire safety
    # boundary. Its stdout is a DECISION channel — the vendor documents writing an
    # allow verdict to it, and this binary carries both "Permission denied by
    # PermissionRequest hook" and "PermissionRequest hook allowed" — so one byte
    # printed from this arm ANSWERS the permission question the operator is being
    # shown, in whichever direction the bytes happen to parse as. Of every event
    # wired here this is the one that must never join the allowlist below.
    PermissionRequest) occupied_raise_mark "$TMUX_PANE" ;;
    # NEVER ADD SubagentStop HERE. The name reads like the obvious companion to
    # Stop and it is not: on 2.1.220 it fires after Stop on ordinary main-agent
    # turns with no subagent involved at all, watched twice. Mapping it to
    # anything would close brackets on the strength of a false signal.
    #
    # AND IF SessionStart IS EVER WIRED, IT MUST BRANCH ON ITS `source`. A second
    # SessionStart fires at the END of a compaction carrying source:"compact",
    # with the same session_id, in the same second as PostCompact — so a mapping
    # that reads SessionStart as "a fresh harness booted" would treat every
    # mid-session compaction as a new agent and clobber this window's facts. It
    # is unwired today because no predicate consumes it (law 5), which is the
    # only reason the trap is not already live.
  esac

  # The in-turn band warning, and the allowlist below is a SAFETY BOUNDARY rather
  # than a tidy-up. Some of this harness's events are decision hooks — the binary
  # carries "Permission denied by PermissionRequest hook" and "PermissionRequest
  # hook allowed" — so on those events anything at all on stdout is an answer to
  # a real permission dialog, and a context nudge would auto-allow or auto-deny
  # whatever the operator was being asked. This command therefore SPEAKS ONLY on
  # the two events whose reply channel is additionalContext, and every other
  # event, wired today or wired later, writes its fact in silence.
  #
  # Run in a subshell so that a refusal inside the note — an unloadable profile,
  # an unwritable option — ends the note and never this command: the fact above is
  # already written, and a warning leg may not take a turn down with it.
  case "$event" in
    UserPromptSubmit|PostToolUse) ( hook_band_note "$event" "$prof" ) || true ;;
  esac
  exit 0
}

hook_trigger_of() { # $1 = the raw payload; the compaction discriminator, never fatal
  # The only field gang reads out of a payload beyond the event name, and it is
  # read here rather than in the fact writer so the writer stays a store: this is
  # the parse, compaction_trigger_of is the vocabulary, and neither of them
  # decides anything.
  #
  # ABSENCE IS NOT AN ERROR AND MUST NOT BE. A harness that stops carrying the
  # field, a hand-fired hook, a shape change — each leaves this empty, and each
  # still leaves gang holding the fact that has a consumer, which is that a
  # compaction is running. The vocabulary closes an empty one to `unknown`, so a
  # reader is told the discriminator was missing rather than handed the commoner
  # of the two values as though somebody had observed it.
  #
  # A non-string value is spent as absent for the same reason. `trigger: 3` is not
  # a trigger this gang knows, and rendering it into the record would put a value
  # nothing maps into a field two branches read.
  printf '%s' "$1" \
    | python3 -c 'import json,sys
v = json.load(sys.stdin).get("trigger", "")
print(v if isinstance(v, str) else "")' 2>/dev/null || true
}

hook_band_note() { # $1 = event name, $2 = profile; the in-turn warning leg, in a subshell
  # Measures with the same profile readout patrol uses and shares patrol's
  # @gl_band memory, so this leg and patrol's context leg cannot both warn about
  # one crossing. It is the context axis only: patrol's budget leg has no counterpart
  # here, so nothing below reads @gl_tband and nothing below writes it. Emits
  # one additionalContext note per band. Anything it cannot determine is a silent
  # exit 0 — this leg's stdout is the hook's JSON reply, so it has nowhere to say
  # so, and patrol's leg is the one that does the talking.
  local event="$1" prof="$2"
  local agent ctx tw tokens window band crossed thresholds prev rung now
  local state_rc
  agent="$(agent_name_of "$TMUX_PANE")"
  load_profile "$prof"
  declare -F profile_context >/dev/null \
    || exit 0
  ctx="$(context_now "$TMUX_PANE" 2>/dev/null)" \
    || exit 0
  ctx="${ctx%%$'\n'*}"
  tw="$(ctx_tokens "$ctx")" \
    || exit 0
  read -r tokens window <<<"$tw"
  # Zero is the beacon between paints, not a reading, and so it is a guard on the
  # fallback path only — see the same guard, and the same reason, in patrol_one.
  # This leg shares patrol's @gl_band memory, so believing it here would
  # re-arm the agent's ladder to the bottom just as surely, and silently: this
  # command's stdout is the hook's JSON reply, so it has nowhere to say so.
  [ "$tokens" -gt 0 ] || exit 0
  # ladder's refusal has to be CARRIED. `die` inside a command substitution ends
  # THAT subshell, not this one, so its message reaches stderr while the caller
  # reads an empty band and walks on into an integer comparison — a refusal that
  # does not refuse, reported as a shell error rather than as the thing it found.
  if rung="$(ladder context "$tokens" "$window")"; then
    read -r band crossed thresholds <<<"$rung"
  else
    exit 0
  fi
  if band_state_read "$TMUX_PANE" @gl_band; then state_rc=0; else state_rc=$?; fi
  if [ "$state_rc" -ne 0 ]; then
    # Rebuilt, not refused, for the reason patrol's leg gives at length: this
    # value is a cache, and an unreadable cache that switches the leg off for the
    # window's whole life is the expensive way to be careful. Silent because a
    # hook's stdout is JSON the harness parses and there is nowhere here to say
    # it — so the write carries the recovery and patrol's leg does the talking.
    # Both legs share this memory, so healing in either one heals both.
    band_state_write "$TMUX_PANE" @gl_band "$band"
    exit 0
  fi
  prev="$BAND_STATE_BAND"
  now="$(date +%s)"
  if [ "$band" -lt "$prev" ]; then
    band_state_write "$TMUX_PANE" @gl_band "$band"
  elif [ "$band" -gt "$prev" ]; then
    # Preserve the hook's existing dedupe order: state advances before the JSON
    # is printed. The event row itself is appended only after Python actually
    # emitted the reply, so a decision is never logged as a delivery.
    band_state_write "$TMUX_PANE" @gl_band "$band"
  fi
  if [ "$band" -gt "$prev" ]; then
    # Encoded, not interpolated. The note carries an agent name and a context
    # readout, and a printf template that assumes neither ever holds a quote or
    # a backslash emits invalid JSON the moment one does — silently, because the
    # band was advanced above and nothing retries a warning the harness could
    # not parse. python3 is a hard dependency of this command already.
    python3 -c 'import json,sys; print(json.dumps({"hookSpecificOutput":{"hookEventName":sys.argv[1],"additionalContext":sys.argv[2]}}))' \
      "$event" "$(band_note "$(ctx_carried "$ctx")" "$crossed" "$agent" "$band" "$thresholds")"
  fi
  exit 0
}
# ===[ /hook-ingestion ]======================================================

# --- diagnostics ------------------------------------------------------------

version_line() { # $1 = a version command -> its first line of output, or nonzero
  # Captured whole and trimmed by expansion, never piped into `head -1`. head
  # exits at line one; a version command that prints a second line then writes
  # into a closed pipe, and under this file's pipefail that SIGPIPE reads as a
  # command that FAILED — reported as "not installed here" about a harness that
  # is installed, or as a version probe that could not run.
  local out
  # shellcheck disable=SC2086  # a profile declares this as a command STRING
  out="$($1 2>/dev/null)" || return 1
  printf '%s' "${out%%$'\n'*}"
}

version_word() { # $1 = a version line -> the one dotted-numeric word in it, or nonzero
  # Certainty is the whole product here, so this refuses far more than it
  # accepts. A word qualifies only if it is digits and dots, has at least one
  # dot, and has no empty component — `2.1.220` and `0.144.5` qualify, while
  # `codex-cli`, `(Claude`, `v1.2.3`, `1.18.7-rc1` and a bare `220` do not. Two
  # qualifying words in one line is a refusal too: nothing here can say which of
  # them is the version, and a wrong pick orders the wrong number.
  #
  # Every refusal lands the caller on vet's original undifferentiated verdict,
  # which is the direction that stays loud. The failure this shape exists to
  # prevent is the opposite one — concluding "verified on both sides" about a
  # version nobody has ever checked.
  #
  # Walked by parameter expansion rather than `for w in $1`: an unquoted
  # expansion is glob-expanded, so a version line carrying a `*` would be
  # answered by whatever happens to be in the caller's cwd.
  local rest w out=""
  rest="${1//$'\t'/ }"
  while :; do
    while [ "${rest# }" != "$rest" ]; do rest="${rest# }"; done
    [ -n "$rest" ] || break
    w="${rest%% *}"
    rest="${rest#"$w"}"
    case "$w" in
      *[!0-9.]*) continue ;;   # anything that is not a digit or a dot
      *..*|.*|*.) continue ;;  # an empty component is not a number
      *.*) ;;                  # digits and dots, at least one dot: a candidate
      *) continue ;;           # a bare integer names no version this can order
    esac
    [ -z "$out" ] || return 1
    out="$w"
  done
  [ -n "$out" ] || return 1
  printf '%s' "$out"
}

version_cmp() { # $1, $2 = dotted-numeric -> prints 1 if $1 is higher, -1 if lower, 0 if
                # equal; nonzero and SILENT where a component cannot be ordered safely
  # Component-wise, with a missing component read as zero, so 1.18 and 1.18.0
  # compare equal. 10# because a component is a decimal string and `08` is not
  # octal — an arithmetic base error here would be a die inside a diagnostic.
  local a="$1" b="$2" x y
  while [ -n "$a" ] || [ -n "$b" ]; do
    x="${a%%.*}"; y="${b%%.*}"
    [ -n "$x" ] || x=0
    [ -n "$y" ] || y=0
    # Leading zeros go before the width test, so a padded component is measured
    # by the width of its VALUE and not of its spelling.
    while :; do case "$x" in 0?*) x="${x#0}" ;; *) break ;; esac; done
    while :; do case "$y" in 0?*) y="${y#0}" ;; *) break ;; esac; done
    # Bash arithmetic is 64-bit and SIGNED, and it WRAPS rather than erroring:
    # 10#9223372036854775808 evaluates to -9223372036854775808, so an installed
    # 9223372036854775808.0 would be ordered confidently BELOW a pinned 1.0.
    # Eighteen digits is the widest that cannot overflow. Refusing is the whole
    # point rather than a shortcut — the rank above promises that every word it
    # prints is one it is sure of, and a wrapped comparison is the one way this
    # could hand it a certain answer that is wrong. Unorderable is not equal, so
    # it must not fall through to the tie below.
    [ "${#x}" -le 18 ] && [ "${#y}" -le 18 ] || return 1
    if [ "$((10#$x))" -gt "$((10#$y))" ]; then printf '1'; return 0; fi
    if [ "$((10#$x))" -lt "$((10#$y))" ]; then printf -- '-1'; return 0; fi
    case "$a" in *.*) a="${a#*.}" ;; *) a="" ;; esac
    case "$b" in *.*) b="${b#*.}" ;; *) b="" ;; esac
  done
  printf '0'
}

version_rank() { # $1 = installed line, $2 = the pins -> newer|older|between, or nonzero
  # Nonzero means UNKNOWN, and unknown is not a "between". Every way this can
  # fail to be sure — an installed line with no version word or two of them, a
  # pin that does not parse, or a numeric tie the exact-match above already
  # said was not a match — returns nonzero and keeps the loud verdict.
  #
  # A tie is deliberately in that list rather than folded into `between`. Reaching
  # here means the strings differ while the numbers do not (`1.18` pinned against
  # an installed `1.18.0`, or a build suffix), and which of those two the operator
  # has is exactly what this function cannot tell them.
  local inst pin v cmp below=0 above=0
  inst="$(version_word "$1")" || return 1
  for v in $2; do
    pin="$(version_word "$v")" || return 1
    # Named into a variable so the refusal is carried rather than inferred from
    # the text. version_cmp is silent when it cannot order a component, and an
    # empty word would reach the catch-all below and be read as the tie case —
    # the right answer here by luck, from evidence that says something else.
    cmp="$(version_cmp "$inst" "$pin")" || return 1
    case "$cmp" in
      1)  above=$((above + 1)) ;;
      -1) below=$((below + 1)) ;;
      *)  return 1 ;;
    esac
  done
  if [ "$below" -eq 0 ] && [ "$above" -gt 0 ]; then printf 'newer'
  elif [ "$above" -eq 0 ] && [ "$below" -gt 0 ]; then printf 'older'
  elif [ "$above" -gt 0 ] && [ "$below" -gt 0 ]; then printf 'between'
  else return 1
  fi
}

file_issue_once() { # $1 = title, WHICH IS THE DEDUP KEY; $2 = body
  # Everything that varies between two sightings of one fault belongs in the
  # body. A title that carries it files a second issue about the thing this
  # function exists to file once, and each caller below says which of its own
  # fields that rules out.
  command -v gh >/dev/null || die "vet --file-issue: gh CLI not installed"
  # Dedup via the plain list endpoint, not --search: the search index is
  # eventually-consistent and misses issues filed seconds ago (observed live —
  # a rerun filed a duplicate).
  #
  # Captured, then matched off a here-string. Two failures both end in the
  # duplicate this function exists to prevent. `gh` is a forked INCREMENTAL
  # writer and `grep -q` exits at its first match, so under this file's pipefail
  # a title that IS open can leave gh on a SIGPIPE and report the pipeline
  # failed — a hit read as a miss. -L 200 bounds that only while the titles are
  # ASCII, and nothing here makes them ASCII. Separately, a gh that fails
  # outright — unauthenticated, offline, rate-limited — writes nothing, which at
  # the `if` is indistinguishable from "nothing open". Capturing tells the two
  # apart: an error dies, and only a real listing is ever matched against.
  local open_titles
  open_titles="$(cd "$ROOT" && gh issue list --state open -L 200 --json title --jq '.[].title')" \
    || die "vet --file-issue: cannot list open issues — refusing to guess and file a duplicate"
  if grep -qxF -- "$1" <<<"$open_titles"; then
    echo "  issue already open: '$1' — not duplicating"
    return 0
  fi
  # The create carries its own failure rather than leaning on errexit, because
  # errexit is not reliably on when this runs. The tier caller contains this
  # function on the non-final side of a `||`, and bash suppresses -e for every
  # command inside a compound in that position — so an unguarded create that
  # failed would fall straight through to the line below, out of the one function
  # both callers trust to die rather than report a filing that never happened.
  # The two calls are independent: the list can answer and the create still fail,
  # on a rate limit landing between them, a read-scoped token, a read-only repo.
  (cd "$ROOT" && gh issue create --title "$1" --body "$2") \
    || die "vet --file-issue: gh issue create failed — the finding stands unfiled"
  echo "  filed rot issue: '$1'"
}

file_rot_issue() { # $1 = profile, $2 = installed version line, $3 = ordering
  # The ordering is the field kept out of the title: a rerun that ranked the same
  # build differently — a pin appended between runs is enough — would file a
  # second issue about one unchanged fault.
  local ordering
  case "$3" in
    newer)   ordering="newer than every verified version" ;;
    older)   ordering="older than every verified version" ;;
    between) ordering="between two verified versions" ;;
    *)       ordering="unknown — the version strings do not order confidently" ;;
  esac
  file_issue_once "strategy rot: $1 markers unverified against $2" "\
gang vet detected strategy rot.

- profile: \`profiles/$1.sh\`
- installed harness version: \`$2\`
- verified against: \`$GANG_VERIFIED_VERSIONS\`
- ordering: $ordering

The profile's scraped TUI markers (busy regex, context readout, input-box
shape) were verified against the versions listed above, not the installed
one. Re-verify each marker live against the installed TUI, fix what rotted,
and append the new version to GANG_VERIFIED_VERSIONS."
}

file_tier_issue() { # $1 = agent, $2 = profile, $3 = predicate, $4 = the two witnesses
  # THE FIELDS KEPT OUT OF THE TITLE ARE THE AGENT AND THE FIGURES. The rot is in
  # a writer, so two agents running one profile with the same conflict are one
  # bug and must not become two issues; and the figures move every turn, so a
  # title carrying them would file a fresh issue on every sweep of a single fault
  # nobody has fixed yet. Both go in the body, which is a record of a sighting and
  # may hold a number that has already stopped being true.
  #
  # Subshelled, because file_issue_once DIES on any gh it cannot reach, list
  # through, or create through, and every caller has printed its finding and
  # raised its own code before reaching here. Letting that die out would take
  # the finding's code with it — the conflict shown to the operator and then not
  # counted, which is exactly the fabricated status law 8 refuses. Filing is the
  # optional half.
  ( file_issue_once "strategy rot: $2 $3 tiers disagree" "\
gang vet found two fresh witnesses for the same predicate disagreeing.

- agent: \`$1\`
- profile: \`profiles/$2.sh\`
- predicate: $3
$4

ADR-0008 has every reader take the highest tier still fresh, so gang answers
from the first witness above and never consults the second again. That is the
tier order working, and it is also why this fault is invisible from every
surface an operator has: the good witness answers each time it is asked, and
the rotted one is never asked. Two witnesses this fresh and this far apart mean
one of the two writers behind them has stopped keeping up. Open both and find
which — the tiers were not voting, so no answer gang gave was wrong yet.

One agent is named because that is where it was seen. What is filed is about
the writer rather than about that agent." ) \
    || vet_tier_row '' '' "$C_DIM" \
         "the finding above stands — filing it failed, and gh's reason is on stderr"
}

# --- probe: fire the declared markers at a live harness -----------------------

# vet is READ as answering "does gang still see this harness correctly?" and,
# comparing version strings, could only ever answer "has this harness moved".
# Those come apart exactly where it costs: every dead marker this repo has lived
# through was painted — or stopped being painted — at a version already pinned,
# and a pin cannot see a TUI change that ships without a version behind it. The
# probe closes that by driving the thing. Launch the harness on a server of its
# own, give it work, and watch for the marker the profile declares while it does
# the work.
#
# Opt-in, because it spends the operator's tokens and about a minute per harness.
# That is the same reason plain vet now states what it did NOT do: a clean bill
# that quietly implies a marker was fired at a pane is how three dead markers got
# through, and the fix for that is not a louder probe but an honester report.
#
# Scope is the busy marker, the context readout, the asymmetric filesystem
# witness for a declared mid-turn action, and the OWNED FACTS a profile declares
# its wiring writes. The last of those asks a different question from the three
# before it: those watch the SCREEN, and a fact leg watches whether the harness's
# own wiring reached gang at all. A scrape and a fact rot independently — a
# repainted TUI kills the first, a renamed hook event or an unwired settings file
# kills the second — so neither answers for the other and both are fired.
#
# What no leg drives, and why each stays could-not-determine rather than becoming
# a quieter pass: a permission gate needs a real modal, which is the one thing the
# probe refuses to touch (wait_ready already calls a dialog NOT PROBED, and gang
# never answers one), and reaching it would take per-harness choreography that
# rots on its own schedule. Compaction needs a context window filled past the
# harness's own threshold, which a single driven turn cannot reach — under that
# threshold /compact runs and moves nothing, so the probe could not tell a dead
# marker from a session with nothing to compact.
GANG_PROBE_BOOT="${GANG_PROBE_BOOT:-45}"      # seconds to an input box; a cold TUI is slow
GANG_PROBE_TURN="${GANG_PROBE_TURN:-90}"      # seconds of working pane to watch for the marker
GANG_PROBE_SETTLE="${GANG_PROBE_SETTLE:-120}" # seconds for the pane to stop moving afterwards
GANG_PROBE_QUIET="${GANG_PROBE_QUIET:-5}"     # seconds of byte-identical pane that count as stopped
# A MARKED PHASE CAN BE A SMALL FRACTION OF A LIVE TURN, so the window is polled
# and never sampled. Measured on claude-code: of 220 samples with the pane
# demonstrably changing, 19 carried any branch of the declared regex — 8.6% — and
# all 19 were the thinking spinner, which is removed once the answer starts and
# replaced by nothing. Longest unbroken live-but-unmarked run: 64 samples, ~16s.
# A probe that captured one frame while the pane churned would therefore call a
# perfectly healthy claude-code dead about eleven times in twelve, confidently.
# Four samples a second, from the instant the work is sent, and PRESENT means
# seen at least once across the whole window.
GANG_PROBE_RATE="${GANG_PROBE_RATE:-0.25}"
# The prompt lengthens THINKING, not the answer: the marked phase is the thinking
# one and comes first, so answer length buys nothing a probe can see. Plain
# lowercase, no ellipsis, no capitalised word behind a leading glyph — a harness
# echoes whatever it is told into its own transcript, and claude-code declares
# ^[^ ] [A-Z][a-zé]+(…|...), so a careless prompt paints the very marker it is
# here to test for. Overridable because a harness that will not work from this
# needs a different nudge, not a different probe.
GANG_PROBE_PROMPT="${GANG_PROBE_PROMPT:-think carefully before answering: is the number of seconds in a week larger than the number of words in a long novel? reply with one lowercase word and nothing else}"
# GANG_MIDTURN_ACTS is stronger than merely accepting a paste, and a pane cannot
# witness that distinction: a queued next turn can begin between pane polls and
# paint the same frames as the turn already running. The declaration therefore
# gets a second, asymmetric probe on profiles that opt into it. Its boundary is
# the model's own filesystem actions: create START, do one slow action, and make
# A the last action of the turn. An injected ordinary message asks for B. Seeing
# B while A is absent, followed eventually by A, confirms B-before-A. Nothing
# else is evidence against the declaration.
GANG_PROBE_ACTS_WAIT="${GANG_PROBE_ACTS_WAIT:-45}"   # whole filesystem-ordering window
GANG_PROBE_ACTS_DELAY="${GANG_PROBE_ACTS_DELAY:-15}" # slow middle action in the fixture
# Templates are overridable for the same reason GANG_PROBE_PROMPT is: a harness
# that needs a different nudge should not need a different observer. @start@,
# @boundary@, @message@ and @delay@ are expanded immediately before submission.
GANG_PROBE_ACTS_PROMPT="${GANG_PROBE_ACTS_PROMPT:-for this mid-turn declaration probe, follow exactly: using separate shell tool calls, first create the file @start@; second run sleep @delay@; third, as the last action of this turn, create the file @boundary@. do not combine these actions, do not run sleep in the background, and do not create the boundary file until the sleep finishes}"
GANG_PROBE_ACTS_MESSAGE="${GANG_PROBE_ACTS_MESSAGE:-act on this now before continuing: create the file @message@ immediately with a shell tool}"
# A SPECIMEN IS CLEAN WHEN NO MARKER TEXT CAN REACH THE PANE — from the prompt,
# from the directory's contents, or from a brief. Newness is not the property and
# buys nothing on its own; an already-trusted empty directory is a perfectly clean
# specimen and does not trip a first-run trust dialog, which a fresh one does.
# What this must never be pointed at is a checkout of THIS repo, whose every
# marker string is sitting in profiles/ waiting to be read aloud.
GANG_PROBE_DIR="${GANG_PROBE_DIR:-}"

PROBE_L=""     # the -L socket this run owns; empty until a probe starts
PROBE_TMP=""   # shim + throwaway cwd, removed with it
PROBE_PATH=""  # PATH as it was before the shim went on the front of it
PROBE_CWD=""   # the specimen directory every probed harness is launched in
PROBE_ACTS_START=""    # exact probe-owned files, also cleaned on die() and ^C
PROBE_ACTS_BOUNDARY=""
PROBE_ACTS_MESSAGE=""
PROBE_ACTS_CONFIRMED=0
PROBE_ACTS_UNDETERMINED=0
PROBE_FACTS_CONFIRMED=0     # declared facts observed arriving across the driven turn
PROBE_FACTS_UNDETERMINED=0  # declared facts no leg here can drive honestly

probe_teardown() { # reached through on_exit, so it runs on die() and on ^C alike
  # Both halves of that are measured, because the sentence was here for a while
  # asserting an invariant on_exit did not implement — it called lock_release and
  # unpark and nothing else, so every die() inside a probe leaked the server and
  # the temp tree, and the comment vouched for a teardown that never ran. The ^C
  # half was checked the way a terminal actually does it: SIGINT to the whole
  # process group, script dies, EXIT trap still runs.
  #
  # Explicit -L even though the shim would supply one, because this is the call
  # that must be right when nothing else is: a kill-server that resolves to the
  # default socket ends the operator's live team from inside its own diagnostic.
  [ -n "${PROBE_L:-}" ] || return 0
  tmux -L "$PROBE_L" kill-server 2>/dev/null || true
  # kill-server ends the server and leaves its socket FILE behind, so a probe that
  # only killed would drop one dead socket per run into a directory shared with
  # the live team's. Guarded on the name this function itself set: the same
  # directory holds `default`, and an unguarded rm built from a variable is how a
  # cleanup ends a team. The path is rebuilt exactly as tmux resolved it when the
  # server was created, from the same environment.
  case "$PROBE_L" in
    gangvet-*) rm -f "${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)/$PROBE_L" 2>/dev/null || true ;;
  esac
  # The shim must not outlive the probe. It fails safe if it ever does — a leaked
  # shim aims gang at a socket with no server and it reports no team, which is
  # confusing and harmless. The direction that is NOT harmless is the one it
  # exists to prevent: probe operations landing on the live server.
  [ -z "$PROBE_PATH" ] || { PATH="$PROBE_PATH"; hash -r 2>/dev/null || true; }
  [ -z "$PROBE_ACTS_START" ] \
    || rm -f -- "$PROBE_ACTS_START" "$PROBE_ACTS_BOUNDARY" "$PROBE_ACTS_MESSAGE" 2>/dev/null || true
  [ -z "$PROBE_TMP" ] || rm -rf "$PROBE_TMP"
  PROBE_L=""; PROBE_TMP=""; PROBE_PATH=""
  PROBE_ACTS_START=""; PROBE_ACTS_BOUNDARY=""; PROBE_ACTS_MESSAGE=""
}

probe_start() { # stand up the private server this run owns and the shim that keeps it private
  # TMUX_TMPDIR does not isolate anything from inside a pane. Given neither -S nor
  # -L, tmux takes its socket from $TMUX and drives the server this process is
  # RUNNING IN, so the isolation has to be -L and nothing else.
  #
  # The shim is not belt-and-braces on that. Profile code calls bare `tmux` —
  # profile_input and profile_context both do, and they are half the surface under
  # test — so -L on gang's own calls cannot reach them. First on PATH, execing the
  # real binary with -L, it covers everything the probe runs. It also inverts the
  # footgun rather than dodging it: with the shim in place a bare `tmux
  # kill-server` from anywhere in here hits the probe server.
  local real
  real="$(command -v tmux)" || die "vet --probe: no tmux on PATH"
  PROBE_TMP="$(mktemp -d "${TMPDIR:-/tmp}/gangvet-$$-XXXXXX")" \
    || die "vet --probe: cannot create a working directory"
  PROBE_L="gangvet-$$"
  mkdir -p "$PROBE_TMP/bin" "$PROBE_TMP/cwd"
  PROBE_CWD="$PROBE_TMP/cwd"
  if [ -n "$GANG_PROBE_DIR" ]; then
    [ -d "$GANG_PROBE_DIR" ] || die "vet --probe: GANG_PROBE_DIR is not a directory: $GANG_PROBE_DIR"
    PROBE_CWD="$GANG_PROBE_DIR"
  fi
  printf '#!/bin/sh\nexec "%s" -L "%s" "$@"\n' "$real" "$PROBE_L" > "$PROBE_TMP/bin/tmux"
  chmod +x "$PROBE_TMP/bin/tmux"
  PROBE_PATH="$PATH"
  PATH="$PROBE_TMP/bin:$PATH"
  hash -r 2>/dev/null || true
  # One EXIT trap in this file and on_exit is it; a second `trap ... EXIT` here
  # would silently replace the pane lock's. Measured, not assumed: an EXIT trap
  # does not fire in a command-substitution subshell, so profile_context's own
  # die() cannot tear this down mid-probe.
  trap 'on_exit' EXIT
  tmux new-session -d -s gangvet -n holder "sleep 3600" 2>/dev/null \
    || die "vet --probe: cannot start a tmux server on socket $PROBE_L"
}

probe_row() { # $1 = name, $2 = version, $3 = colour, $4 = text
  printf '%-12s %-26s %s\n' "$1" "$2" "$(colour "$3" "$4")"
}

probe_note() { # $1 = profile, $2 = what it is waiting on, $3 = the bound in seconds
  # A probe spends minutes inside three poll loops that print nothing, and a
  # bounded wait and a hang are indistinguishable from outside. This says which
  # loop is running and when it gives up, so the question "is it stuck" has an
  # answer without a second terminal.
  #
  # Ephemeral, so stderr and only to a terminal — the same line `colour` already
  # draws at [ -t 2 ]. The durable record is the row each profile prints to
  # stdout; a per-phase trace in a captured artifact or a cron log is noise, and
  # every caller that reads probe output reads stdout.
  #
  # THE WORDING IS A CONSTRAINT, NOT A STYLE, and it is why this is a sentence and
  # not a spinner. gang's own output lands in the panes gang scrapes, and
  # busy_painted() and occupied() read the WHOLE pane — the narrow read at
  # capture_status exists because this repo has already had compacting() report
  # true for three minutes off a reviewer's own grep output. A frame shaped like a
  # harness spinner would be read as one: claude-code's busy regex is a glyph, a
  # capitalised word and an ellipsis, so `⠋ Probing…` on the pane of whoever ran
  # the probe leaves that agent reading BUSY while idle — every send refused,
  # every wait timed out, for as long as the line stays on screen. So: no leading
  # glyph, no ellipsis, no bar glyphs, no "Working...", no interrupt hint. The
  # suite holds every shipped GANG_BUSY_REGEX against a real pane that has run
  # this, which is the check that keeps a future prettier version honest.
  [ -t 2 ] || return 0
  printf '  probing %s: %s, up to %ss\n' "$1" "$2" "$3" >&2
}

probe_evidence() { # $1 = profile, $2 = the pane the verdict was reached on
  # A verdict about a screen that then throws the screen away asks to be taken on
  # trust, and this one is about to tell somebody their profile is broken. Kept
  # outside the probe's own temp dir so it survives teardown, and named in the row
  # so the next question — "what did it actually look like?" — has an answer that
  # is not "run it again and hope".
  #
  # THE DUMP IS GANG QUOTING, NOT GANG SPEAKING, which is why it keeps the marker
  # raw where the rows above deliberately do not. A capture with the marker taken
  # out of it is no longer a capture, and in the MARKER STUCK case the marker's
  # presence IS the finding — replacing it would hand the reader an assertion where
  # they asked for the screen. So the file stays verbatim and the row says what the
  # file is, which is the part an operator needs before they cat it into a pane
  # gang scrapes and re-create the failure the rows are worded to avoid.
  local f="${TMPDIR:-/tmp}/gang-probe-$1-$$.txt"
  printf '%s\n' "$2" > "$f" 2>/dev/null || return 0
  printf '%-12s %-26s %s\n' '' '' "$(colour "$C_DIM" "pane it judged, verbatim and still holding the marker — open the file, do not echo it into a pane gang scrapes: $f")"
}

probe_acts_expand() { # $1 = template, $2 = START, $3 = A, $4 = B
  local text="$1"
  text="${text//@start@/$2}"
  text="${text//@boundary@/$3}"
  text="${text//@message@/$4}"
  text="${text//@delay@/$GANG_PROBE_ACTS_DELAY}"
  printf '%s' "$text"
}

probe_submit() { # $1 = pane, $2 = ordinary text; same paste/Enter discipline as the marker turn
  local box_before="" box_now="" deadline
  if declare -F profile_input >/dev/null; then
    box_before="$(profile_input "$1" 2>/dev/null)" || box_before=""
  fi
  tmux send-keys -t "$1" "$2" 2>/dev/null || return 1
  if declare -F profile_input >/dev/null; then
    deadline=$(( $(date +%s) + GANG_PROBE_BOOT ))
    while [ "$(date +%s)" -lt "$deadline" ]; do
      if box_now="$(profile_input "$1" 2>/dev/null)" && [ "$box_now" != "$box_before" ]; then
        break
      fi
      sleep "$GANG_PROBE_RATE"
    done
  fi
  tmux send-keys -t "$1" Enter 2>/dev/null
}

probe_acts_cleanup() { # remove only the unique files this probe named
  [ -z "$PROBE_ACTS_START" ] \
    || rm -f -- "$PROBE_ACTS_START" "$PROBE_ACTS_BOUNDARY" "$PROBE_ACTS_MESSAGE" 2>/dev/null || true
  PROBE_ACTS_START=""; PROBE_ACTS_BOUNDARY=""; PROBE_ACTS_MESSAGE=""
}

probe_acts_not_probed() { # $1 = profile, $2 = version, $3 = precise reason
  PROBE_ACTS_UNDETERMINED=$((PROBE_ACTS_UNDETERMINED + 1))
  probe_row "$1" "$2" "$C_DIM" "mid-turn acts NOT PROBED — could not determine: $3. Only observed B-before-A confirms; every other outcome leaves the declaration unrefuted"
  return 2
}

probe_acts_confirmed() { # $1 = profile, $2 = version
  PROBE_ACTS_CONFIRMED=$((PROBE_ACTS_CONFIRMED + 1))
  probe_row "$1" "$2" "$C_OK" "mid-turn acts CONFIRMED — observed message file B while boundary file A was absent, then observed A. This B-before-A ordering confirms only that the running turn consumed the message"
  return 0
}

probe_acts() { # $1 = profile, $2 = pane, $3 = version; called only for a declaration of 1
  local prof="$1" id="$2" installed="$3" tag start_name boundary_name message_name
  local start_path boundary_path message_path prompt msg deadline ready=0
  local started=0 injected=0 b_before_a=0 a_seen=0 b_seen=0

  tag="${PROBE_TMP##*/}-$prof"
  start_name="./.gang-$tag-start"
  boundary_name="./.gang-$tag-a"
  message_name="./.gang-$tag-b"
  start_path="$PROBE_CWD/${start_name#./}"
  boundary_path="$PROBE_CWD/${boundary_name#./}"
  message_path="$PROBE_CWD/${message_name#./}"

  # A user-supplied trusted directory is still their directory. A collision is
  # contamination, not permission to delete it and manufacture a clean start.
  if [ -e "$start_path" ] || [ -e "$boundary_path" ] || [ -e "$message_path" ]; then
    probe_acts_not_probed "$prof" "$installed" "the fixture paths were not absent before the turn began"
    return 2
  fi
  PROBE_ACTS_START="$start_path"
  PROBE_ACTS_BOUNDARY="$boundary_path"
  PROBE_ACTS_MESSAGE="$message_path"

  probe_note "$prof" "waiting for an input box for the mid-turn fixture" "$GANG_PROBE_BOOT"
  wait_ready "$id" "$GANG_PROBE_BOOT" || ready=$?
  case "$ready" in
    0) ;;
    2) probe_acts_not_probed "$prof" "$installed" "a dialog owned the screen before the fixture could start"; return 2 ;;
    *) probe_acts_not_probed "$prof" "$installed" "no input box accepted the fixture within ${GANG_PROBE_BOOT}s"; return 2 ;;
  esac

  prompt="$(probe_acts_expand "$GANG_PROBE_ACTS_PROMPT" "$start_name" "$boundary_name" "$message_name")"
  msg="$(probe_acts_expand "$GANG_PROBE_ACTS_MESSAGE" "$start_name" "$boundary_name" "$message_name")"
  if ! probe_submit "$id" "$prompt"; then
    probe_acts_not_probed "$prof" "$installed" "the fixture prompt could not be submitted"
    return 2
  fi

  # START-without-A is the independent proof that the model began the fixture
  # and has not reached its declared last action. Pane text is deliberately not
  # read in this phase: it cannot distinguish the running turn from a next turn
  # that began between captures, which is the question under test.
  probe_note "$prof" "watching the filesystem mid-turn ordering" "$GANG_PROBE_ACTS_WAIT"
  deadline=$(( $(date +%s) + GANG_PROBE_ACTS_WAIT ))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    [ ! -e "$start_path" ] || started=1
    a_seen=0; b_seen=0
    [ ! -e "$boundary_path" ] || a_seen=1
    [ ! -e "$message_path" ] || b_seen=1

    if [ "$injected" -eq 0 ]; then
      if [ "$a_seen" -eq 1 ]; then
        if [ "$started" -eq 1 ]; then
          probe_acts_not_probed "$prof" "$installed" "boundary file A appeared before the mid-turn message could be injected"
        else
          probe_acts_not_probed "$prof" "$installed" "the fixture did not start before boundary file A appeared"
        fi
        return 2
      fi
      if [ "$started" -eq 1 ]; then
        if ! probe_submit "$id" "$msg"; then
          probe_acts_not_probed "$prof" "$installed" "the mid-turn message could not be submitted"
          return 2
        fi
        injected=1
        # Re-observe instead of assigning an order from events that may have
        # happened while submission waited for the composer to ingest the text.
        continue
      fi
    else
      [ "$b_seen" -eq 0 ] || [ "$a_seen" -eq 1 ] || b_before_a=1
      if [ "$a_seen" -eq 1 ]; then
        if [ "$b_before_a" -eq 1 ]; then
          probe_acts_confirmed "$prof" "$installed"
          return 0
        fi
        if [ "$b_seen" -eq 1 ]; then
          probe_acts_not_probed "$prof" "$installed" "A and B first appeared together between filesystem polls"
        else
          probe_acts_not_probed "$prof" "$installed" "boundary file A appeared before message file B"
        fi
        return 2
      fi
    fi
    sleep "$GANG_PROBE_RATE"
  done

  # One final observation belongs to the bounded window. It can confirm only if
  # an earlier sample already saw B alone; timestamps are intentionally ignored,
  # because two files that arrive between polls do not identify a turn boundary.
  [ ! -e "$start_path" ] || started=1
  a_seen=0; b_seen=0
  [ ! -e "$boundary_path" ] || a_seen=1
  [ ! -e "$message_path" ] || b_seen=1
  [ "$b_seen" -eq 0 ] || [ "$a_seen" -eq 1 ] || b_before_a=1
  if [ "$b_before_a" -eq 1 ] && [ "$a_seen" -eq 1 ]; then
    probe_acts_confirmed "$prof" "$installed"
    return 0
  fi
  if [ "$started" -eq 0 ]; then
    probe_acts_not_probed "$prof" "$installed" "the fixture did not start; its start file never appeared"
  elif [ "$a_seen" -eq 1 ] && [ "$b_seen" -eq 1 ]; then
    probe_acts_not_probed "$prof" "$installed" "A and B first appeared together between filesystem polls"
  elif [ "$a_seen" -eq 1 ]; then
    probe_acts_not_probed "$prof" "$installed" "boundary file A appeared before message file B"
  elif [ "$b_seen" -eq 1 ]; then
    probe_acts_not_probed "$prof" "$installed" "boundary file A never appeared"
  else
    probe_acts_not_probed "$prof" "$installed" "neither boundary file A nor message file B appeared after the fixture started"
  fi
  return 2
}

probe_facts_confirmed() { # $1 = profile, $2 = version, $3 = fact, $4 = what was observed
  PROBE_FACTS_CONFIRMED=$((PROBE_FACTS_CONFIRMED + 1))
  probe_row "$1" "$2" "$C_OK" "fact '$3' CONFIRMED — $4"
}

probe_facts_not_probed() { # $1 = profile, $2 = version, $3 = fact, $4 = precise reason
  PROBE_FACTS_UNDETERMINED=$((PROBE_FACTS_UNDETERMINED + 1))
  probe_row "$1" "$2" "$C_DIM" "fact '$3' NOT PROBED — $4"
}

probe_facts_absent() { # $1 = profile, $2 = version, $3 = fact, $4 = what was found instead
  probe_row "$1" "$2" "$C_BAD" "fact '$3' DECLARED AND MISSING — $4"
}

probe_facts() { # $1 = profile, $2 = window, $3 = version; 0 = every declared fact arrived, 1 = one did not
  # A SECOND QUESTION, NOT A BETTER ANSWER TO THE FIRST. The rows above watch the
  # SCREEN; these watch whether the harness's own wiring reached gang at all. The
  # two rot independently and neither can stand in for the other: a repainted TUI
  # kills a scrape while every hook still fires, and a renamed event or a settings
  # file nobody wired kills the facts while the pane paints exactly as it always
  # did. So the beacon row keeps its own question and these land beside it.
  #
  # DRIFT HERE, WHERE mid-turn acts IS ONLY EVER could-not-determine, and the
  # difference is in the observation rather than in how much either is trusted.
  # The acts leg cannot separate the running turn from a queued next one, so its
  # negative is genuinely unreadable. This one has no such ambiguity: the record is
  # on the window or it is not, and gang put it there or nothing did. A declared
  # fact absent after a full driven turn means every reader of that predicate is
  # silently falling to the tier below with nothing saying so, which is the exact
  # blindness vet exists to report.
  local prof="$1" id="$2" installed="$3" fact raw rc=0 trc=0
  [ -n "$GANG_PROBE_FACTS" ] || return 0
  for fact in $GANG_PROBE_FACTS; do
    case "$fact" in
      turn)
        trc=0; turn_state_read "$id" || trc=$?
        case "$trc" in
          0) case "$TURN_STATE" in
               closed) probe_facts_confirmed "$prof" "$installed" turn \
                         "the harness opened the bracket on its own events and closed it, and gang read back what it wrote" ;;
               *) probe_facts_absent "$prof" "$installed" turn \
                    "the bracket opened and never closed — it still reads '$TURN_STATE' with the pane long quiet, so every send to this harness would be refused as busy until the bound expires"
                  rc=1 ;;
             esac ;;
          2) probe_facts_absent "$prof" "$installed" turn \
               "a bracket gang wrote and gang cannot read back, so the fact tier is worth nothing to any reader of busy or idle"
             rc=1 ;;
          *) probe_facts_absent "$prof" "$installed" turn \
               "no bracket on the window after a full driven turn — no event this harness fired reached gang, so busy and idle fall to the scrape with nothing saying so"
             rc=1 ;;
        esac ;;
      ctx)
        raw="$(tmux show-options -wqv -t "$id" @gl_ctx 2>/dev/null)" || raw=""
        if [ -z "$raw" ]; then
          # The one that catches a skew of gangline against ITSELF. An older
          # checkout of the statusline still paints the beacon, so the row above
          # passes and this is the only thing that notices the record stopped.
          probe_facts_absent "$prof" "$installed" ctx \
            "the beacon is on the screen and no record is on the window — whatever is wired here paints but does not write, so every band and every context column falls to the scrape"
          rc=1
        elif ctx_fact_read "$id"; then
          probe_facts_confirmed "$prof" "$installed" ctx \
            "a record arrived and gang's own reader believes it: $CTX_FACT_TOKENS of $CTX_FACT_WINDOW tokens"
        else
          probe_facts_absent "$prof" "$installed" ctx \
            "a record arrived and gang's own reader refused it, which is worth exactly as much as none at all: $raw"
          rc=1
        fi ;;
      # The two the ADR names, and they keep saying this until something can drive
      # them honestly. A quieter row here would be a clean bill for a marker
      # nobody fired — the failure the whole probe exists to have stopped.
      occupied)
        probe_facts_not_probed "$prof" "$installed" occupied \
          "the raise needs a real permission dialog, and gang never answers one — a probe that provoked a modal would strand itself at the screen wait_ready already refuses to touch" ;;
      compaction)
        probe_facts_not_probed "$prof" "$installed" compaction \
          "the bracket needs a compaction, which needs a context window filled past the harness's own threshold; under it /compact runs and moves nothing, so a driven turn cannot tell a dead marker from a session with nothing to compact" ;;
      *)
        probe_facts_not_probed "$prof" "$installed" "$fact" \
          "this profile declares a fact no leg in here knows how to drive" ;;
    esac
  done
  return "$rc"
}

probe_one() { # $1 = profile; 0 = marker confirmed, 1 = drift, 2 = not probed
  local prof="$1" id ready out ctx key msg installed="-"
  local marked=0 churned=0 settled=0 deadline rc=0

  # Checked before a window is opened rather than at each use below, because a
  # probe that dies halfway has already launched a harness into a tmux server it
  # then leaks. Every one of these reaches a comparison or a sleep further down.
  require_whole GANG_PROBE_BOOT "$GANG_PROBE_BOOT" seconds
  require_whole GANG_PROBE_TURN "$GANG_PROBE_TURN" seconds
  require_whole GANG_PROBE_SETTLE "$GANG_PROBE_SETTLE" seconds
  require_whole GANG_PROBE_QUIET "$GANG_PROBE_QUIET" seconds
  require_interval GANG_PROBE_RATE "$GANG_PROBE_RATE"

  load_profile "$prof"

  # Profile code can override either setting, so validate after sourcing it and
  # before opening a harness window. Undeclared profiles never read these knobs.
  if [ "${GANG_MIDTURN_ACTS:-}" = 1 ]; then
    require_whole GANG_PROBE_ACTS_WAIT "$GANG_PROBE_ACTS_WAIT" seconds
    require_interval GANG_PROBE_ACTS_DELAY "$GANG_PROBE_ACTS_DELAY"
  fi

  # Nothing declared is nothing to fire, and it is not a pass. bash declares no
  # busy marker on purpose — it is gangline's own stand-in and is never busy — so
  # a green row here would be a clean bill for a harness nobody touched.
  if [ -z "$GANG_BUSY_REGEX" ]; then
    probe_row "$prof" "-" "$C_DIM" "not probed — no busy marker declared"
    return 2
  fi
  if [ -n "$GANG_VERSION_CMD" ]; then
    if ! installed="$(version_line "$GANG_VERSION_CMD")" || [ -z "$installed" ]; then
      probe_row "$prof" "-" "$C_DIM" "not probed — not installed here ($GANG_VERSION_CMD)"
      return 2
    fi
  fi

  id="$(tmux new-window -d -P -F '#{window_id}' -t '=gangvet' -n "$prof" \
        -c "$PROBE_CWD" "$GANG_LAUNCH" 2>/dev/null)" || {
    probe_row "$prof" "$installed" "$C_BAD" "not probed — launch failed: $GANG_LAUNCH"
    return 2
  }
  # THE SPECIMEN HAS TO BE ONE, and without this it is not. cmd_hook's only binding
  # is $TMUX_PANE to that window's @gl_profile, so on an unmarked window every hook
  # the harness fires walks in, finds nothing, and exits 0 — the wiring would look
  # dead to the probe while working perfectly for every hitched agent. This is the
  # same option hitch sets and it is true of this window: it is running that
  # profile. Set before the harness can reach an event that maps to a fact, which
  # is any turn event, and the first of those cannot fire before a prompt is
  # submitted far below.
  tmux set-option -w -t "$id" @gl_profile "$prof" 2>/dev/null || true

  ready=0
  probe_note "$prof" "waiting for an input box" "$GANG_PROBE_BOOT"
  wait_ready "$id" "$GANG_PROBE_BOOT" || ready=$?
  case "$ready" in
    2) # A first-run trust dialog is what a throwaway directory buys, and it is
       # the price of the directory being clean. Not a failure of the marker and
       # not a pass: gang never answers a dialog, and neither does its probe.
       probe_row "$prof" "$installed" "$C_BAD" "not probed — a dialog owns the screen; answer it once, or point GANG_PROBE_DIR at an EMPTY directory this harness already trusts"
       probe_evidence "$prof" "$(capture_joined "$id")"
       tmux kill-window -t "$id" 2>/dev/null || true
       return 2 ;;
    1) probe_row "$prof" "$installed" "$C_BAD" "not probed — no input box after ${GANG_PROBE_BOOT}s"
       probe_evidence "$prof" "$(capture_joined "$id")"
       tmux kill-window -t "$id" 2>/dev/null || true
       return 2 ;;
  esac

  # THE BASELINE, and it is the point of the whole design. Every measurement this
  # repo has taken looked for an ABSENCE, where a stray match only ever adds a
  # false alarm and the absence still counts. This one looks for a PRESENCE, so
  # the same contamination lands the other way up: a pane that has merely SEEN the
  # string makes a stone-dead marker look alive. Requiring the marker to be gone
  # before any work is sent is what turns a presence into a transition, and only
  # the transition is evidence. It also catches a rot mode a presence check calls
  # healthy — chrome that matches the regex permanently, which reads busy forever.
  if busy_painted "$id"; then
    probe_row "$prof" "$installed" "$C_BAD" "VOID — the marker was already on screen before any work was sent: contamination, or it is permanent chrome"
    probe_evidence "$prof" "$(capture_joined "$id")"
    tmux kill-window -t "$id" 2>/dev/null || true
    return 1
  fi

  # Launched the way hitch launches it, marker and all. A probe that starts the
  # harness differently is probing a path no agent ever runs — and codex's context
  # readout is keyed off exactly this marker, so without it that half is dead on
  # arrival for reasons that have nothing to do with the harness.
  msg="$GANG_PROBE_PROMPT"
  if [ "${GANG_SESSION_KEY:-}" = 1 ]; then
    key="$(mint_key)"
    tmux set-option -w -t "$id" @gl_key "$key"
    msg="$msg $(marker_line "$key")"
  fi
  # The box is READ between the text and the Enter, which is gang's own delivery
  # discipline rather than caution about it. An Enter that arrives before the
  # composer has ingested the paste submits nothing, and the failure is silent and
  # reads exactly like a harness that would not work: codex took the prompt into
  # its composer and sat there for a whole 90s window while the probe reported
  # "never got busy" — true, and useless.
  #
  # What is waited on is a CHANGE from the box as it was a moment ago, not a box
  # with something in it. Those come apart whenever the box was ALREADY occupied
  # — a draft the agent left there, or, on a profile that cannot tell typed text
  # from the harness's own suggestions, its ghost text — and then a
  # box-has-content test is satisfied before a key is sent and the wait it looks
  # like never happens. Same trap as busy_painted OR churn: a condition already
  # true cannot witness anything. before/after is what cmd_send compares, for this
  # reason. An unreadable box takes another look rather than counting as the
  # change, since a capture that failed is not evidence the paste landed.
  #
  # Bounded, because a harness that never shows the text is its own finding rather
  # than a reason to hang; skipped where no box is declared, since there is then
  # nothing to read and no claim to make.
  local box_before="" box_now=""
  if declare -F profile_input >/dev/null; then
    box_before="$(profile_input "$id" 2>/dev/null)" || box_before=""
  fi
  tmux send-keys -t "$id" "$msg" 2>/dev/null || true
  if declare -F profile_input >/dev/null; then
    deadline=$(( $(date +%s) + 15 ))
    while [ "$(date +%s)" -lt "$deadline" ]; do
      if box_now="$(profile_input "$id" 2>/dev/null)" && [ "$box_now" != "$box_before" ]; then
        break
      fi
      sleep 0.25
    done
  fi
  tmux send-keys -t "$id" Enter 2>/dev/null || true

  # The declared regex, never busy(). busy() is busy_painted OR churn, so asking it
  # here would pass with a stone-dead marker because churn covers for it — a test
  # that cannot fail. Churn is in this loop, but only ever as the PRECONDITION: it
  # decides whether the marker question is meaningful, never whether the marker is
  # alive. Churning with no marker anywhere in the window is a real finding.
  # Nothing churning at all means the harness never got busy, the probe learned
  # nothing, and that is a third outcome said out loud rather than folded into
  # either of the first two.
  #
  # One capture answers both questions, which is why this does not call
  # busy_painted: the same frame is grepped for the marker and compared with the
  # previous frame for motion, so the sample rate is not halved to buy the
  # precondition. Polling starts the instant the keys are sent — the marked phase
  # is thinking, and thinking is FIRST.
  local prev="" pane=""
  probe_note "$prof" "watching for the busy marker" "$GANG_PROBE_TURN"
  deadline=$(( $(date +%s) + GANG_PROBE_TURN ))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    pane="$(capture_joined "$id")" || die "vet --probe: cannot read $prof's pane — refusing to call a marker dead off a failed capture"
    if re_match GANG_BUSY_REGEX "$pane"; then marked=1; break; fi
    [ -z "$prev" ] || [ "$pane" = "$prev" ] || churned=1
    prev="$pane"
    sleep "$GANG_PROBE_RATE"
  done

  if [ "$marked" -eq 0 ]; then
    if [ "$churned" -eq 0 ]; then
      probe_row "$prof" "$installed" "$C_BAD" "not probed — the harness never got busy: nothing moved on screen in ${GANG_PROBE_TURN}s"
      probe_evidence "$prof" "$pane"
      rc=2
    else
      probe_row "$prof" "$installed" "$C_BAD" "MARKER DEAD — the pane was working and never painted $(marker_named "$prof")"
      probe_evidence "$prof" "$pane"
      rc=1
    fi
    tmux kill-window -t "$id" 2>/dev/null || true
    return "$rc"
  fi

  # The other half of the transition, and the gate is CHURN STOPPING rather than
  # the marker going away. On claude-code the marker goes away the moment thinking
  # ends and streaming starts — measured, 91.4% of a live turn carries no marker
  # at all — so marker-gone fires mid-answer, and this would be asserting the rest
  # state of a pane that is still working. A still screen is the only signal here
  # that the turn is actually over.
  # QUIET IS A DURATION, NOT A STREAK, and that distinction cost a false verdict.
  # Two identical frames a second apart was the first gate, and it reported
  # opencode MARKER STUCK on a marker that was demonstrably healthy — watched
  # separately, it appears two seconds in and clears by ten. A TUI does not repaint
  # on a schedule: mid-turn still runs measured 0.5s on a quiet server and stretch
  # under contention, and the failing run had three TUIs on one server at load 28.
  # Post-turn stillness measured 15.75s in the same window, so the two are cleanly
  # separable by DURATION and not at all by consecutive-sample count.
  #
  # Erring long is the safe direction and the reason to prefer it is not caution:
  # a threshold too short yields a false MARKER STUCK, which is a false alarm on a
  # healthy harness, while too long only costs seconds and can never produce a
  # pass. The residual is stated rather than closed — a turn that pauses longer
  # than this mid-flight is called finished, and that too fails toward alarm.
  local quiet_since=0 now=0
  prev=""
  probe_note "$prof" "waiting for the pane to go quiet" "$GANG_PROBE_SETTLE"
  deadline=$(( $(date +%s) + GANG_PROBE_SETTLE ))
  while :; do
    now="$(date +%s)"
    [ "$now" -lt "$deadline" ] || break
    pane="$(capture_joined "$id")" || die "vet --probe: cannot read $prof's pane while waiting for its turn to end"
    if [ -n "$prev" ] && [ "$pane" = "$prev" ]; then
      [ "$quiet_since" -ne 0 ] || quiet_since="$now"
      [ $(( now - quiet_since )) -ge "$GANG_PROBE_QUIET" ] && { settled=1; break; }
    else
      quiet_since=0
    fi
    prev="$pane"
    sleep "$GANG_PROBE_RATE"
  done
  if [ "$settled" -eq 0 ]; then
    probe_row "$prof" "$installed" "$C_BAD" "not probed — the pane never stopped moving in ${GANG_PROBE_SETTLE}s, so there is no rest state to hold the marker against"
    probe_evidence "$prof" "$pane"
    tmux kill-window -t "$id" 2>/dev/null || true
    return 2
  fi
  # A marker that never clears fails as hard as one that never arrives, and it
  # fails quietly: chrome matching the regex permanently reads busy forever, so
  # every send is refused, every wait times out, and every agent looks stuck.
  #
  # This is also what carries the one contamination the baseline cannot. Text the
  # MODEL emits mid-turn arrives after the baseline has passed and while the probe
  # is looking, so the baseline is no protection at all there — but that text stays
  # in the transcript once the turn ends, so it lands here instead. Both cases run
  # the same way: marker dead and the model happens to emit a matching string is
  # caught here rather than above, and marker alive with the same accident is a
  # false alarm on a healthy harness. The residual runs toward false alarm and
  # never toward false pass.
  if re_match GANG_BUSY_REGEX "$pane"; then
    probe_row "$prof" "$installed" "$C_BAD" "MARKER STUCK — $(marker_named "$prof") painted, and was still painted once the pane went quiet"
    probe_evidence "$prof" "$pane"
    tmux kill-window -t "$id" 2>/dev/null || true
    return 1
  fi

  # THE SCRAPE, DELIBERATELY, AND NOT context_now. Every other reader wants the
  # best answer available; this one is asking whether the beacon is on the screen,
  # which is the question the whole probe exists to answer. Reaching for the owned
  # fact here would let a wired statusline vouch for a readout gang can no longer
  # find in the pane — a probe that passes on the strength of the tier that made
  # the scrape less load-bearing, exactly where the scrape is the subject.
  if declare -F profile_context >/dev/null; then
    if out="$(profile_context "$id" 2>&1)" && [ -n "$out" ]; then
      ctx="$out"
    else
      probe_row "$prof" "$installed" "$C_BAD" "busy marker fired and cleared, but the context readout did not: ${out:-no output}"
      tmux kill-window -t "$id" 2>/dev/null || true
      return 1
    fi
    probe_row "$prof" "$installed" "$C_OK" "busy marker fired and cleared; context $ctx"
  else
    probe_row "$prof" "$installed" "$C_OK" "busy marker fired and cleared; no context readout declared"
  fi
  # Beside the scrape, never instead of it, and read here because the pane has
  # only just gone quiet: the harness was repainting seconds ago, so a record
  # missing now is missing, not merely old.
  probe_facts "$prof" "$id" "$installed" || rc=1
  # This is a second turn, after the marker/context probe has reached exactly the
  # same verdict it always did. It runs only for the stronger declaration and
  # its result cannot turn a confirmed marker into drift: failure to observe the
  # one proving order is explicitly not probed, never a refutation.
  if [ "${GANG_MIDTURN_ACTS:-}" = 1 ]; then
    probe_acts "$prof" "$id" "$installed" || true
  fi
  # End the specimen before removing its files. In an A-before-B outcome the
  # submitted message may still be waiting to run; deleting A first would leave
  # a race where that next turn creates B after cleanup and strands it in a
  # caller-supplied probe directory.
  tmux kill-window -t "$id" 2>/dev/null || true
  probe_acts_cleanup
  # Carries the fact legs' verdict and nothing else: every other outcome above
  # returned where it was decided, and the acts leg is barred from reaching this.
  return "$rc"
}

cmd_probe() { # $1 = optional profile name; drives every installed harness
  local prof probed=0 skipped=0 drift=0 rc
  PROBE_ACTS_CONFIRMED=0
  PROBE_ACTS_UNDETERMINED=0
  PROBE_FACTS_CONFIRMED=0
  PROBE_FACTS_UNDETERMINED=0
  probe_start
  printf '%s\n' "$(colour "$C_WORK" "probing — each installed harness is launched on socket $PROBE_L and given a turn's work")"
  while read -r prof <&3; do
    [ -n "$prof" ] || continue
    [ -z "${1:-}" ] || [ "$prof" = "$1" ] || continue
    rc=0; probe_one "$prof" || rc=$?
    case "$rc" in
      0) probed=$((probed + 1)) ;;
      1) probed=$((probed + 1)); drift=1 ;;
      *) skipped=$((skipped + 1)) ;;
    esac
  done 3<<EOF
$(all_profiles)
EOF
  probe_teardown
  # Said even when nothing failed, because "not probed" must never be read off an
  # exit code as "confirmed". A harness that is not installed, or that stopped at
  # a dialog, produced no evidence either way — and an exit status has no room to
  # say so.
  printf '%s\n' "$(colour "$C_DIM" "$probed profile(s) driven, $skipped not probed (reasons above). A zero exit means every marker that WAS fired arrived and cleared; it says nothing about the ones that were not.")"
  if [ $((PROBE_FACTS_CONFIRMED + PROBE_FACTS_UNDETERMINED)) -gt 0 ]; then
    printf '%s\n' "$(colour "$C_DIM" "Owned facts: $PROBE_FACTS_CONFIRMED confirmed, $PROBE_FACTS_UNDETERMINED not probed. A confirmed fact means the harness's own wiring reached gang across this turn; a not-probed one is a fact no leg here can drive honestly, and it is not a pass.")"
  fi
  if [ $((PROBE_ACTS_CONFIRMED + PROBE_ACTS_UNDETERMINED)) -gt 0 ]; then
    printf '%s\n' "$(colour "$C_DIM" "Mid-turn declarations: $PROBE_ACTS_CONFIRMED confirmed, $PROBE_ACTS_UNDETERMINED not probed. Only an observed B-before-A filesystem ordering confirms; every other outcome is could-not-determine and cannot refute the declaration.")"
  fi
  return "$drift"
}

vet_tier_row() { # $1 = agent, $2 = profile, $3 = colour, $4 = text
  printf '%-12s %-26s %s\n' "$1" "$2" "$(colour "$3" "$4")"
}

vet_tiers_agent() { # $1 = window id, $2 = name, $3 = --file-issue; 2 = the witnesses disagree
  # TIERS PICK WITNESSES, THEY DO NOT VOTE (ADR-0008), and this changes no
  # answer. gang still replies from the highest fresh tier for every predicate
  # below; what is reported here is that the tier UNDER it, freshly read, says
  # something else. Two witnesses that were both written seconds ago and do not
  # match is a fact about gang rather than about the agent — one of the two
  # writers behind them has rotted — and it is invisible from every surface an
  # operator has, precisely because the tier order works: the good witness
  # answers and the rotted one is never consulted again.
  #
  # NOT FRESH IS NOT A FINDING. A tier that has expired, or that this profile
  # never had, leaves one witness answering alone — which is the tier order doing
  # its job, not a disagreement. Only both-fresh-and-apart is reported, and every
  # arm below is written so that a missing witness falls out silently.
  #
  # Defaulted rather than required, and the direction is the whole reason. Under
  # this file's `set -u` a caller that stopped passing it would die inside the
  # subshell around this function, where the rc is read as "could not read this
  # agent" — every real finding turned into a dim row and a clean exit. Defaulted,
  # the same mistake costs the filing and leaves the finding standing. What proves
  # the wiring is a check that files, not this line.
  local prof rc=0 turn_rc=0 beacon used fact_k fissue="${3:-0}"
  prof="$(tmux show-options -wqv -t "$1" @gl_profile 2>/dev/null)" || prof=""
  # An unadopted window is somebody's shell, not an agent, and it declares no
  # tiers at all. The roster is where an operator learns it is there.
  [ -n "$prof" ] || return 0
  # A gate rather than a value: the busy rows below name this path through
  # marker_named instead of reproducing the pattern it holds, for the reason argued
  # there. What is asked here is only whether there is a file to name at all.
  profile_file "$prof" >/dev/null 2>&1 || {
    vet_tier_row "$2" "$prof" "$C_DIM" "profile not found (GANG_PROFILES?) — no second witness to hold the first against"
    return 0
  }
  load_profile "$prof"

  # THE CONTEXT PREDICATE, COMPARED AT THE BEACON'S OWN GRANULARITY. The record
  # carries an exact count and the beacon is rounded to thousands, so holding the
  # raw figures against each other reports every healthy agent on the team as a
  # conflict, every sweep. The fact is rendered down to what the pane can express
  # — the same integer division context_now already prints with — so the two are
  # things that CAN be equal, and an inequality means they genuinely differ.
  #
  # Both dies are contained by command substitution: profile_context dies rather
  # than return an empty readout, and a profile with no context at all has no
  # function to call.
  if ctx_fact_read "$1" && declare -F profile_context >/dev/null; then
    beacon="$(profile_context "$1" 2>/dev/null)" || beacon=""
    used="${beacon%%k/*}"
    # A readout this reader cannot parse is a could-not-compare, never a finding.
    # profile_context is the profile's own code (law 4) and vet is the command an
    # operator runs when a profile is already suspect — reading junk as a
    # disagreement would report the rot in the wrong place.
    if [ -n "$beacon" ] && [[ "$used" =~ ^[0-9]+$ ]]; then
      fact_k=$(( CTX_FACT_TOKENS / 1000 ))
      if [ "$fact_k" -ne "$used" ]; then
        vet_tier_row "$2" "$prof" "$C_BAD" \
          "ROT RISK — the context tiers disagree: the owned record on @gl_ctx says ${fact_k}k and the beacon on the pane says ${used}k. gang answers from the record; two witnesses this fresh and this far apart mean one of the two writers behind them has stopped keeping up."
        rc=2
        [ "$fissue" -eq 1 ] && file_tier_issue "$2" "$prof" context "\
- owned record (@gl_ctx): ${fact_k}k
- beacon scraped from the pane: ${used}k"
      fi
    fi
  fi

  # THE BUSY PREDICATE, IN ONE DIRECTION ONLY. A closed bracket under a painted
  # marker is the disagreement: an event tier saying idle while the pane still
  # paints a spinner means the scrape regex has almost certainly rotted.
  #
  # The reverse — an OPEN bracket over a pane painting nothing — is the ordinary
  # case and firing on it would bury the report. A harness paints its marker on a
  # small minority of the frames it draws during a live turn, so most reads of a
  # genuinely busy agent find the bracket open and the pane blank. That is the
  # asymmetry the tier order is built on rather than a fault in it.
  #
  # The read-path half of this rule is turn_vets_paint, which files a row in the
  # patrol log the moment a sweep detects it. This is the same rule asked at a
  # different moment and for a different reader: the log witnesses when it
  # happened, and an operator running vet is asking what is true now. Change one
  # and the other needs the same thought.
  turn_witness "$1" || turn_rc=$?
  # busy_painted dies rather than guess when a pane cannot be read, and this is a
  # report over a whole team — the capture is proven first so one window that went
  # away mid-loop does not take the rest of the section with it.
  if [ "$turn_rc" -eq 1 ] && capture_joined "$1" >/dev/null 2>&1 && busy_painted "$1"; then
    if compaction_explains_paint "$1"; then
      # THE SAME EXEMPTION THE READ PATH APPLIES, at the other moment and for the
      # other reader: turn_vets_paint witnesses WHEN this happened, and vet
      # answers what is true NOW. A rule that held on only one of them would let
      # a postmortem and a report describe different systems.
      #
      # DIM AND NOT ABSENT, and rc is untouched so this neither moves the exit
      # code nor files. This section's whole subject is what an operator cannot
      # see from any other surface, so an agent that silently stops appearing in
      # it is the failure the section exists to prevent. The row says the tiers
      # disagree, says what accounts for it, and declines to call it rot — which
      # is more than either a finding or a silence would say.
      vet_tier_row "$2" "$prof" "$C_DIM" \
        "the busy tiers disagree and a compaction explains it: @gl_compact_bracket is open and fresh ($COMPACT_TRIGGER), and a compaction paints $(marker_named "$prof") while opening no turn. Not rot, and not filed as rot."
    else
      # THE FILE, NOT THE PATTERN — the argument is at marker_named, and this row is
      # the site where it stops being a preference and becomes a live failure. It is
      # printed by an ordinary `gang vet`, and the thing an operator most often runs
      # `gang vet` from is an agent's own pane, so the row lands on a screen gang
      # scrapes with no step in between. The pattern still travels in the filed
      # issue below, which is read somewhere other than a pane and is the durable
      # record this row is only a sighting of.
      vet_tier_row "$2" "$prof" "$C_BAD" \
        "ROT RISK — the busy tiers disagree: the turn bracket on @gl_turn says the turn closed and the pane is still painting $(marker_named "$prof"). gang answers idle from the bracket; a marker painted under a closed bracket means the scrape regex has almost certainly rotted."
      rc=2
      [ "$fissue" -eq 1 ] && file_tier_issue "$2" "$prof" busy "\
- owned bracket (@gl_turn): the turn closed
- scraped from the pane: still painting the busy marker \`$GANG_BUSY_REGEX\`"
    fi
  fi
  return "$rc"
}

vet_tiers() { # $1 = --file-issue; the live team's witnesses held against each other, 1 = apart
  local id name wins rc=0 seen=0 frc
  if ! session_live; then
    # Named rather than skipped. This section asks a question ABOUT AGENTS, and a
    # silent absence would read as the question having been asked and answered.
    vet_tier_row 'live team' '-' "$C_DIM" \
      "no session '$SESSION' running — no agent's witnesses could be held against each other"
    return 0
  fi
  wins="$(tmux list-windows -t "=$SESSION" -F '#{window_id} #W' 2>/dev/null)" || wins=""
  while read -r id name; do
    [ -n "$id" ] || continue
    seen=$((seen + 1))
    # Subshelled, so a profile that dies on this agent costs one row instead of
    # the section — and given its own code for a finding, because die exits 1 and
    # an agent gang could not read must never be counted as one it read and found
    # wrong (law 8).
    frc=0; ( vet_tiers_agent "$id" "$name" "${1:-0}" ) || frc=$?
    case "$frc" in
      0) ;;
      2) rc=1 ;;
      *) vet_tier_row "$name" '?' "$C_DIM" "could not read this agent's witnesses" ;;
    esac
  done <<EOF
$wins
EOF
  [ "$rc" -eq 0 ] || return 1
  vet_tier_row 'live team' "$seen agent(s)" "$C_DIM" \
    "every predicate whose two tiers were both fresh had them agree"
}

cmd_vet() { # strategy-rot check: installed harness version vs each profile's pins
  # Scraped TUI markers rot silently when a harness updates (lived it: a
  # Claude Code build stopped painting 'esc to interrupt' and busy() false-
  # negatived). Each profile pins the versions its markers were verified
  # against; vet compares and exits nonzero on drift. This is a reactive
  # diagnostic, not a cron job: agents run it when scraping misbehaves
  # (false busy/idle, missing beacon, failed injection verify).
  local file_issue=0 probe=0 only=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --file-issue) file_issue=1; shift ;;
      # The name is optional and positional after --probe, because probing one
      # harness is what an operator does when one harness is misbehaving — which
      # is when vet gets run at all.
      --probe) probe=1; shift
               case "${1:-}" in ''|-*) ;; *) only="$1"; shift ;; esac ;;
      *) die "vet: unknown argument '$1'" ;;
    esac
  done
  local f prof installed v match out drift=0
  # Every profile installed, not just the shipped ones. A profile in GANG_PROFILES
  # is the one whose pins are LEAST likely to be maintained — nobody ships it, so
  # nobody bumps it when a harness updates — and walking $ROOT/profiles alone meant
  # a user's own harness was the single file never checked. Where a name exists in
  # both dirs it appears once and the loaded file is theirs, which is what has been
  # vetted all along: this loop only ever took the NAME from the path, and
  # load_profile has always re-resolved.
  #
  # Deliberately all_profiles and not list_profiles, which hides the test-only
  # stand-ins: that list answers "what may an operator pick", and vet asks "what is
  # installed here that can rot". Routing it through the offered list would have
  # silently stopped vetting bash — a guard lost with nothing printed to say so.
  # Read on fd 3 so a version command or a profile_vet that touches stdin cannot
  # eat the rest of the list.
  # A named profile narrows the WHOLE report, not just the probe half. Two
  # reasons, and the second is the one that matters: `gang vet --probe codex` is
  # asked when codex is misbehaving, so a page of other harnesses is noise — and
  # an exit code covering profiles nobody named cannot be read as a verdict on the
  # one they did. A typo dies rather than printing an empty clean bill, which is
  # the same failure as a clean bill that overstates its scope, just emptier.
  if [ -n "$only" ]; then
    # The list goes in the message, not just the refusal. "No profile 'x'" leaves
    # two very different faults looking identical — a typo, and a GANG_PROFILES
    # pointing somewhere that has nothing in it — and the second is the one a
    # caller cannot see from outside.
    local installed_names
    installed_names="$(all_profiles)"
    grep -qxF -- "$only" <<<"$installed_names" \
      || die "vet: no profile '$only' is installed. Installed: $(printf '%s' "$installed_names" | tr '\n' ' ')(GANG_PROFILES=${GANG_PROFILES:-unset})"
  fi
  while read -r prof <&3; do
    [ -n "$prof" ] || continue
    [ -z "$only" ] || [ "$prof" = "$only" ] || continue
    load_profile "$prof"
    if [ "$GANG_VERIFIED_VERSIONS" = "any" ]; then
      printf '%-12s %-26s %s\n' "$prof" "-" \
        "$(colour "$C_DIM" "version-independent (no scraped markers)")"
    elif [ -z "$GANG_VERSION_CMD" ] || [ -z "$GANG_VERIFIED_VERSIONS" ]; then
      printf '%-12s %-26s %s\n' "$prof" "?" \
        "$(colour "$C_BAD" "UNPINNED — declare GANG_VERSION_CMD + GANG_VERIFIED_VERSIONS")"
      drift=1
    elif ! installed="$(version_line "$GANG_VERSION_CMD")" || [ -z "$installed" ]; then
      printf '%-12s %-26s %s\n' "$prof" "?" \
        "$(colour "$C_BAD" "version command failed: $GANG_VERSION_CMD")"
      drift=1
    else
      # Matched as a whole word anywhere in the line, not as a prefix: harnesses
      # do not agree on where the number goes. Claude Code leads with it ("2.1.220
      # (Claude Code)"), Codex trails it ("codex-cli 0.144.5"), and a pin cannot
      # carry the name to make a prefix work — GANG_VERIFIED_VERSIONS is
      # space-separated so it can list several. Word boundaries also make the
      # comparison stricter than the prefix it replaces: 0.144.5 no longer matches
      # a hypothetical 0.144.50, and a build suffix has to be pinned to pass.
      match=0
      for v in $GANG_VERIFIED_VERSIONS; do
        case " $installed " in *" $v "*) match=1 ;; esac
      done
      if [ "$match" -eq 1 ]; then
        printf '%-12s %-26s %s\n' "$prof" "$installed" \
          "$(colour "$C_OK" "OK (verified: $GANG_VERIFIED_VERSIONS)")"
      else
        # One verdict covered three situations that call for different urgency:
        # a build NEWER than anything verified is the rot case, where markers may
        # have moved and nobody has looked; one OLDER is a different failure,
        # where a declared marker can be absent because it postdates the build
        # rather than because it rotted; and one BETWEEN two pins was confirmed
        # either side of where it sits. The operator could not tell which they
        # had, so the line could not say whether to re-verify now or later.
        #
        # Differentiated in the WORDING and the colour, and nowhere else. drift
        # still rises for all four, the issue is still filed for all four, and
        # the words ROT RISK still lead every one of them — the exit code and
        # that token are what agents and scripts key on (roles/_common.md tells
        # an agent to report ROT RISK to the operator), and quietly narrowing
        # either would trade a verdict an operator has to read for one nothing
        # reads at all. This makes the loud verdict specific, not quieter.
        local rank note hue="$C_BAD"
        rank="$(version_rank "$installed" "$GANG_VERIFIED_VERSIONS")" || rank="unknown"
        case "$rank" in
          newer) note="ROT RISK — NEWER than every verified version ($GANG_VERIFIED_VERSIONS): markers may have moved and nobody has looked" ;;
          older) note="ROT RISK — OLDER than every verified version ($GANG_VERIFIED_VERSIONS): a declared marker may be absent because it postdates this build" ;;
          between) note="ROT RISK — between verified versions ($GANG_VERIFIED_VERSIONS): confirmed either side of this build, never on it"
                   hue="$C_WORK" ;;
          # Unparseable, ambiguous, or a numeric tie the exact match already
          # rejected. Byte for byte the verdict this command has always printed,
          # because an unknown ordering is the case with the least evidence
          # behind it and must not read as the case with the most.
          *) note="ROT RISK — markers verified against: $GANG_VERIFIED_VERSIONS" ;;
        esac
        printf '%-12s %-26s %s\n' "$prof" "$installed" "$(colour "$hue" "$note")"
        drift=1
        [ "$file_issue" -eq 1 ] && file_rot_issue "$prof" "$installed" "$rank"
      fi
    fi
    # Which file answered, but only when it is not the obvious one, so the common
    # report does not grow a column of paths that are all the same. vet is what you
    # run when scraping misbehaves, and its own clean-bill hint tells you to shadow
    # the profile via GANG_PROFILES and re-verify — advice you cannot act on if the
    # report will not say whether your shadow was the file it read.
    f="$(profile_file "$prof")"
    if [ "$f" != "$ROOT/profiles/$prof.sh" ]; then
      if [ -f "$ROOT/profiles/$prof.sh" ]; then
        printf '%-12s %-26s %s\n' '' '' "$(colour "$C_DIM" "from $f (shadowing the shipped profile)")"
      else
        printf '%-12s %-26s %s\n' '' '' "$(colour "$C_DIM" "from $f")"
      fi
    fi
    # A profile that depends on harness FILES instead of the screen rots on a
    # schema change, not a TUI change — same disease, different tissue. Two
    # tissues, in fact, which is why the label is the general one: files the
    # harness WRITES and a profile parses (codex rollouts, opencode's model
    # catalog), and files the operator OWNS that a reader needs to say the right
    # thing (claude-code's context beacon rides its launch line, so what the
    # operator's settings.json still decides is whether an ADOPTED window — one
    # gang did not launch, and which therefore carries no inline settings — paints
    # a beacon at all). The profile owns the check (law 4);
    # vet just runs it and counts a failure as drift.
    # Unconditionally: the version probe and the file gate are independent
    # diagnostics, and a host without the harness binary can still hold session
    # files worth gating (lived it: CI has no codex, and the gate silently never
    # ran there).
    if declare -F profile_vet >/dev/null; then
      if out="$(profile_vet 2>&1)"; then
        printf '%-12s %-26s %s\n' '' '' "$(colour "$C_DIM" "harness files: $out")"
      else
        printf '%-12s %-26s %s\n' '' '' "$(colour "$C_BAD" "harness files: DRIFT — $out")"
        drift=1
      fi
    fi
  done 3<<EOF
$(all_profiles)
EOF
  # Markers are glyphs, and glyphs only match in a UTF-8 locale. gang selects one
  # at startup; a host that offers none scrapes in byte semantics, where a
  # spinner or a progress bar silently stops matching. That is strategy rot with
  # no version change behind it, so it belongs in the same report.
  if ! utf8_locale; then
    printf '%-12s %-26s %s\n' 'locale' "${LC_ALL:-${LC_CTYPE:-${LANG:-C}}}" \
      "$(colour "$C_BAD" "no UTF-8 locale available — multibyte markers cannot match")"
    drift=1
  fi
  # python3 is a hard requirement and install.sh already says so — but it says so
  # ONCE, and every way a host loses it happens afterwards: an OS upgrade that
  # renames the binary, a venv or a shim landing earlier on PATH, an image rebuilt
  # from a slimmer base, or an install that never ran install.sh at all, since a
  # clone plus a symlink is a supported way to get here and config management does
  # exactly that. Same tissue as the two rows around it — a host fact a gang
  # behaviour needs — and the same lesson as the patrol line: an install-time gate
  # states a requirement, it does not keep it true.
  #
  # WHY THIS RUNS THE READER INSTEAD OF LOOKING IT UP. `command -v python3`
  # answers a question that is not the one that costs. The expensive failure is a
  # python3 that EXISTS and cannot do the one job gang gives it: a stub or wrapper
  # on PATH, a shim pointing at an interpreter that was removed under it, a
  # stripped image whose stdlib has no json. Every one of those passes a lookup
  # and fails the work, so this runs the exact line cmd_hook runs, on the smallest
  # payload that has a right answer, and requires the answer back.
  #
  # WHAT STOPS is the whole owned-event tier at once. cmd_hook translates every
  # payload through that one line, so with it broken the turn bracket, the
  # compaction bracket and the occupancy fact are never written, the context fact
  # and its band note are never parsed, and the beacon prints nothing — every
  # predicate in ADR-0008 drops to its scrape tier. SILENTLY, and that is the
  # whole reason this row has to exist: law 7 forbids a translator failing its
  # harness's turn, so cmd_hook is built to exit 0 having written nothing and said
  # nothing. That is correct there and it is why the loudness has to be here.
  # The row is printed on the healthy path too, unlike the locale row above,
  # because WHICH python3 gang resolves is itself the diagnostic — an operator
  # chasing a shadowed interpreter needs to see the one gang got even on a run
  # where it works.
  # EVERY leg here is in a tested context, and that is not defensive habit — the
  # first cut of this row killed `gang vet` outright on exactly the host it exists
  # to diagnose. This file runs under pipefail, so `python3 -V | sed` fails as a
  # PIPELINE when python3 is a stub that exits nonzero, and an untested failure
  # there ends the run before the row it was collecting for can print. A check for
  # a broken interpreter must survive the broken interpreter.
  local pyver pypath pyout pywhy
  pypath="$(command -v python3 2>/dev/null)" || pypath=""
  pyver="$(python3 -V 2>/dev/null | sed -n 's/^Python //p')" || pyver=""
  pyout="$(printf '{"hook_event_name":"Stop"}' \
    | python3 -c 'import json,sys; print(json.load(sys.stdin).get("hook_event_name",""))' \
    2>/dev/null)" || pyout=""
  if [ "$pyout" = Stop ]; then
    printf '%-12s %-26s %s\n' 'python3' "${pyver:-?}" "$(colour "$C_OK" "OK ($pypath)")"
  else
    if [ -n "$pypath" ]; then
      pywhy="on PATH at $pypath and cannot run gang's hook translator — a shim, a wrapper, or an interpreter with no json module answers a lookup and still fails the work"
    else
      pywhy="not on PATH — gang's hook translator cannot run at all (macOS ships no python3 by default)"
    fi
    printf '%-12s %-26s %s\n' 'python3' "${pyver:--}" "$(colour "$C_BAD" "$pywhy")"
    printf '%-12s %-26s %s\n' '' '' "$(colour "$C_DIM" "every owned-event fact stops being written and says nothing: turn bracket, compaction bracket, occupancy, context fact and its band note. Every predicate falls back to the pane")"
    drift=1
  fi
  # A crontab entry is the one part of an install that updating never touches,
  # which is how a patrol line went on sweeping with the wrong flags for days
  # while every pin above read OK. Same tissue as the beacon gate: a file the
  # OPERATOR owns that a gang behaviour needs, so it belongs in the report that
  # already covers those.
  #
  # Absence is not drift. Plenty of installs want no ambient patrol, and a
  # diagnostic that goes red for a choice can never go green again — the operator
  # would learn to ignore the colour, which costs more than the row is worth.
  # An entry that no longer matches what this install would write IS drift: the
  # operator asked for patrol, and what they are getting is not it.
  if command -v crontab >/dev/null 2>&1; then
    local want have
    want="$(cron_line)"
    have="$(cron_installed)" || have=""
    if [ -z "$have" ]; then
      printf '%-12s %-26s %s\n' 'patrol cron' '-' \
        "$(colour "$C_DIM" "no entry sweeps session $SESSION — gang cron --install adds one")"
    elif [ "$have" = "$want" ]; then
      printf '%-12s %-26s %s\n' 'patrol cron' "$SESSION" \
        "$(colour "$C_OK" "OK (matches this install)")"
    else
      printf '%-12s %-26s %s\n' 'patrol cron' "$SESSION" \
        "$(colour "$C_BAD" "STALE — the entry sweeping this session is not the one this install would write; gang cron --install replaces it")"
      printf '%-12s %-26s %s\n' '' '' "$(colour "$C_DIM" "in force:     $have")"
      printf '%-12s %-26s %s\n' '' '' "$(colour "$C_DIM" "this install: $want")"
      drift=1
    fi
  fi
  # The one part of this report that reads the TEAM rather than the install, and
  # it is on the plain run rather than behind --probe: it fires nothing, drives
  # nothing and costs a handful of tmux reads per agent. It is also the only rot
  # this command can see WITHOUT a version having moved — the case every pin above
  # is blind to by construction.
  # --file-issue reaches here for the same reason it reaches the version rows: a
  # ROT RISK finding that evaporates with the window it was seen in is the one
  # class an operator cannot act on later, and this class names a writer to go
  # open exactly like a version pin does. Leaving the newest class as the only one
  # that does not survive the run would be the wrong asymmetry.
  vet_tiers "$file_issue" || drift=1
  # Only on a clean bill, because that is when it is the remaining hypothesis:
  # vet is run when scraping already misbehaves, and pins watch harness
  # versions, which UI mods never move — a theme, a replacement statusline, or a
  # TUI-drawing extension relocates a marker with every row above reading OK.
  if [ "$probe" -eq 1 ]; then
    printf '\n'
    cmd_probe "$only" || drift=1
  else
    # Printed on every plain run, drift or not, and it is the whole of finding F:
    # a clean bill that leaves the reader to assume a marker was fired at a pane
    # is what let three dead markers through, and the fix for that is a report
    # that states its own scope, not a louder guard.
    printf '%s\n' "$(colour "$C_DIM" "compared version strings, and read the live team's own witnesses against each other — but no marker was fired at any pane. gang vet --probe launches each installed harness and watches its declared markers across a real turn.")"
    [ "$drift" -ne 0 ] \
      || printf '%s\n' "$(colour "$C_DIM" "all pins verified — but pins watch harness versions, which UI mods never move. Scraping misbehaving anyway? A theme, statusline, or TUI extension may have moved a marker with every row above reading OK: gang vet --probe fires the markers at a live harness, and shadowing the profile via GANG_PROFILES is how you re-verify one against the TUI as you actually run it (README: Strategy rot).")"
  fi
  return "$drift"
}

cmd_capture() { # trailing blank pane rows are dead space, not content
  local id
  id="$(win_id "$1")" || die "no window '$1' in session '$SESSION'"
  capture "$id" | awk 'NF{last=NR} {line[NR]=$0} END{for(i=1;i<=last;i++) print line[i]}' | tail -n "${2:-40}"
}

cmd_adopt() { # register an EXISTING tmux window as a gang agent
  local name="" prof="" id
  name="${1:-}"; case "$name" in ''|-*) usage_die ;; esac; shift
  valid_name "$name" \
    || die "adopt: '$name' is not a usable agent name — patrol and hitch are reserved for gang's substrate; other names use letters, digits, dot, dash and underscore only. Rename the window first (tmux rename-window)"
  while [ $# -gt 0 ]; do case "$1" in
    -p|--profile) [ $# -ge 2 ] || die "adopt: $1 needs a value"; prof="$2"; shift 2 ;;
    *) die "adopt: unknown argument '$1'" ;;
  esac; done
  [ -n "$prof" ] || die "adopt: -p <profile> is required"
  ! test_only_profile "$prof" \
    || die "adopt: '$prof' is a stand-in for gangline's own suite, not a harness to run an agent on (GANG_TEST_PROFILES=1 if you are testing gang itself)"
  load_profile "$prof"
  id="$(win_id "$name")" || die "no window '$name' in session '$SESSION' to adopt"
  tmux set-option -w -t "$id" automatic-rename off
  tmux set-option -w -t "$id" allow-rename off
  tmux set-option -w -t "$id" @gl_profile "$prof"
  printf '%s\n' "$(colour "$C_OK" "adopted $name as a $prof agent")"
}

cmd_drop() {
  local id
  id="$(win_id "$1")" || die "no agent '$1'"
  tmux kill-window -t "$id"
  printf '%s\n' "$(colour "$C_OK" "dropped $1")"
}

cmd_down() { # inverse of up: end the whole team's session
  # Every piece of gang's state is a window option, so tmux deletes all of it with
  # the windows it belongs to and there is nothing here to sweep (law 6).
  session_live || die "no session '$SESSION' running"
  echo "$(colour "$C_OK" "ending '$SESSION':") $(colour "$C_DIM" "$(tmux list-windows -t "=$SESSION" -F '#W' | tr '\n' ' ')")"
  tmux kill-session -t "=$SESSION"
}

cmd_attach() { exec tmux attach -t "=$SESSION"; }

cmd_profiles() { list_profiles; }

# --- dispatch ---------------------------------------------------------------

cmd="${1:-}"; [ -n "$cmd" ] || usage_die; shift || true
case "$cmd" in
  up)       cmd_up "$@" ;;
  hitch|spawn) cmd_hitch "$@" ;;
  adopt)    cmd_adopt "$@" ;;
  send)     cmd_send "$@" ;;
  compact)  cmd_compact "$@" ;;
  status)   [ $# -ge 1 ] || usage_die; cmd_status "$1" ;;
  context)  cmd_context "$@" ;;
  hook)     cmd_hook ;;
  wait)     [ $# -ge 1 ] || usage_die
            case "${2:-300}" in ''|*[!0-9]*) die "wait: timeout takes whole seconds, got '${2:-}'" ;; esac
            resolve "$1"; wait_idle "$AGENT_ID" "$1" "${2:-300}"
            echo "$WAIT_STATE"
            case "$WAIT_STATE" in expired*) exit 2 ;; esac ;;
  capture)  [ $# -ge 1 ] || usage_die; cmd_capture "$@" ;;
  roster)   cmd_roster ;;
  cutoff)   cmd_cutoff "$@" ;;
  patrol)   cmd_patrol ;;
  cron)     cmd_cron "$@" ;;
  vet|doctor) cmd_vet "$@" ;;
  attach)   cmd_attach ;;
  drop)     [ $# -ge 1 ] || usage_die; cmd_drop "$1" ;;
  down)     cmd_down ;;
  profiles) cmd_profiles ;;
  roles)    list_roles ;;
  -h|--help|help) usage ;;
  *) die "unknown command '$cmd' (gang --help for usage)" ;;
esac
