#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail

utf8_locale() {
  case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
    *[Uu][Tt][Ff]8*|*[Uu][Tt][Ff]-8*) return 0 ;;
  esac
  local avail l
  avail="$(locale -a 2>/dev/null)" || return 1
  for l in C.UTF-8 C.utf8 en_US.UTF-8 en_US.utf8; do
    case "$avail" in *"$l"*) export LC_ALL="$l"; return 0 ;; esac
  done
  return 1
}
utf8_locale || {
  printf 'gang: could not establish a UTF-8 locale\n' >&2
  exit 1
}

die() { fail 1 "$@"; }

refuse() { fail 3 "$@"; }

# THE THIRD ANSWER A DELIVERY CAN GIVE. `refuse` means nothing was typed and the
# body is still the sender's, so it can be parked; `die` means gang could not do
# what it was asked. Between them sits the case that has no honest home in
# either: Enter WAS pressed against a composer holding this body, and the screen
# then stopped answering, so whether it entered the session is unknown. Parked,
# it becomes a second copy of a message that may already have arrived. Called a
# failure, it invites the sender to send it again, which is the same harm. It is
# its own status so that every surface downstream can say the one true thing —
# it may have been delivered, and gang will not send it twice.
unverified() { fail 5 "$@"; }

# OPERATOR BYTES REACH HERE, from twenty-odd argument parsers that interpolate
# what they were handed into the refusal that names it. Sanitizing at the one
# place they all print through is the check none of them can forget, and it is
# the only shape of this that a new parser inherits for free. Newlines survive:
# a captured diagnostic carries its own layout and flattening it would lose
# what it was laid out to say. They cost nothing here because every line gets
# the prefix, so a pasted newline cannot forge a line that reads as gang's —
# an injected "gang: all fine" arrives as "gang: gang: all fine".
fail() { # $1 = exit status, rest = message
  local code="$1" prefix='gang:' line rest; shift
  [ ! -t 2 ] || [ -n "${NO_COLOR:-}" ] || prefix=$'\033[31mgang:\033[0m'
  # BUILT-INS ONLY. Half of what this function exists to report is a missing
  # dependency, and gang's own refusal for one names the tool it could not
  # find — so a sanitizer that shelled out to tr would be silent in exactly
  # the case where the diagnostic is the whole product.
  #
  # KEPT BY WHAT IT IS, NOT DROPPED BY WHAT IT LOOKS LIKE. A [[:cntrl:]] denylist
  # asks the locale to name every byte a terminal obeys, and under a UTF-8 one it
  # names only what decodes to a control CHARACTER: an operator-supplied raw 0x9b
  # is CSI on its own to a terminal and an undecodable byte to the class, so it
  # passed through and painted. [![:print:]] inverts the question — anything that
  # is not a printable character is replaced, which covers the controls the old
  # class caught, the raw C1 bytes it did not, and any future byte nobody has
  # thought of. A tab goes with them, and losing its column is the right trade
  # for a class with no holes.
  #
  # WHAT IT COSTS: on a line that decodes cleanly, legitimate multibyte text is
  # printable and survives verbatim — é, Ā and 中 all come through. On a line
  # that also carries an undecodable byte, Bash matches the whole line bytewise
  # and the multibyte characters are replaced too, even ones that appear before
  # the bad byte. That is a readability loss on an already-corrupt line, in the
  # safe direction: the class never passes a byte through by mistake, it only
  # ever replaces more than it strictly had to.
  rest="$*"
  while :; do
    line="${rest%%$'\n'*}"
    printf '%s %s\n' "$prefix" "${line//[![:print:]]/?}" >&2
    [ "$rest" != "$line" ] || break
    rest="${rest#*$'\n'}"
  done
  exit "$code"
}

GANG_CONFIG_KEYS='GANG_COLLAR GANG_SESSION GANG_COLLARS GANG_LOCK_DIR GANG_ARCHIVE_DIR GANG_CONTEXT_LIGHTS GANG_USAGE_LIGHTS GANG_AUTO_RESUME GANG_SCOPE GANG_TMUX_GUARD GANG_BOOT_TIMEOUT GANG_GATE_LOOKS GANG_CHURN_WAIT GANG_ACTIVITY_WINDOW GANG_TURN_LIMIT'
GANG_COLLAR_KEYS='GANG_LAUNCH GANG_RESUME_LAUNCH GANG_MODEL_OPT GANG_MODEL_ALIASES GANG_EFFORT_OPT GANG_EFFORT_CMD GANG_ROLE_PROMPT_OPT GANG_HARNESS_PROMPT GANG_BUSY_REGEX GANG_OCCUPIED_REGEX GANG_QUEUED_REGEX GANG_QUEUE_RECALL_KEY GANG_INTERRUPT_KEY GANG_STOP_HOOK GANG_STALL_TYPES GANG_QUIET_AT_REST GANG_MIDTURN_INPUT GANG_COMPACT_CMD GANG_SELF_COMPACT GANG_USAGE_LIGHT_INTERVAL GANG_USAGE_LIMIT_MAX_AGE'
CONFIG_DIR="" CONFIG_FILE="" CONFIG_ORIGINS="" CONFIG_SEEN=""

config_record() { # $1 key, $2 env|config, optional $3 config line
  local record
  printf -v record '%s\t%s' "$1" "$2"
  [ $# -lt 3 ] || printf -v record '%s\t%s\t%s' "$1" "$2" "$3"
  CONFIG_ORIGINS="${CONFIG_ORIGINS:+$CONFIG_ORIGINS
}$record"
}

config_seen_line() { # $1 key -> its first line, or nonzero
  local key line
  while IFS=$'\t' read -r key line; do
    [ "$key" = "$1" ] && { printf '%s' "$line"; return 0; }
  done <<<"$CONFIG_SEEN"
  return 1
}

config_path() { # $1 path -> operator-facing path with HOME collapsed
  local home="${HOME:-}"
  [ -n "$home" ] || { printf '%s' "$1"; return; }
  case "$1" in
    "$home") printf '~' ;;
    "$home"/*) printf '%s/%s' '~' "${1#"$home"/}" ;;
    *) printf '%s' "$1" ;;
  esac
}

config_origin() { # $1 key -> tab-separated origin record, or nonzero
  local key origin line
  while IFS=$'\t' read -r key origin line; do
    [ "$key" = "$1" ] || continue
    printf '%s\t%s' "$key" "$origin"
    [ -z "$line" ] || printf '\t%s' "$line"
    return 0
  done <<<"$CONFIG_ORIGINS"
  return 1
}

config_origin_note() { # $1 key -> a validation-error suffix
  local record key origin line file
  record="$(config_origin "$1")" || return 0
  IFS=$'\t' read -r key origin line <<<"$record"
  [ "$line" != - ] || line=""
  case "$origin" in
    env) printf ' (from the environment)' ;;
    config)
      file="$(config_path "$CONFIG_FILE")"
      printf ' (from %s line %s)' "$file" "$line"
      ;;
  esac
}

config_env_origins() { # record environment keys the file did not also name
  local k envset
  for k in $GANG_CONFIG_KEYS; do
    config_origin "$k" >/dev/null 2>&1 && continue
    envset=""
    eval "envset=\${$k+set}"
    [ "$envset" != set ] || config_record "$k" env ""
  done
  return 0
}

config_load() {
  local root_source file raw marked sentinel=$'\034' probe bytes without_nul rc
  local line n=0 k value previous envset
  if [ "${GANG_CONFIG_DIR+x}" = x ]; then
    CONFIG_DIR="$GANG_CONFIG_DIR" root_source=GANG_CONFIG_DIR
  elif [ -n "${XDG_CONFIG_HOME:-}" ]; then
    CONFIG_DIR="$XDG_CONFIG_HOME/gangline" root_source=XDG_CONFIG_HOME
  else
    CONFIG_DIR="${HOME:-}/.config/gangline" root_source=HOME
  fi
  case "$CONFIG_DIR" in
    /*) ;;
    *) die "$root_source must resolve Gangline's config root to an absolute path, got '$CONFIG_DIR'" ;;
  esac

  CONFIG_FILE="$CONFIG_DIR/config"
  file="$CONFIG_FILE"
  if [ ! -e "$file" ] && [ ! -L "$file" ]; then
    config_env_origins
    return 0
  fi
  [ -f "$file" ] && [ -r "$file" ] \
    || die "Gangline config $file exists but is not a readable regular file"

  bytes="$(wc -c < "$file")" \
    || die "cannot read Gangline config $file"
  without_nul="$(LC_ALL=C tr -d '\000' < "$file" | wc -c)" \
    || die "cannot read Gangline config $file"
  [ "$bytes" = "$without_nul" ] \
    || die "Gangline config $file contains a NUL byte"

  marked="$(cat "$file" || { rc=$?; exit "$rc"; }; printf '\034')" \
    || die "cannot read Gangline config $file"
  case "$marked" in
    *"$sentinel") raw="${marked%"$sentinel"}" ;;
    *) die "internal: the config sentinel was lost while reading $file" ;;
  esac
  probe="$(printf '%s' "$raw" | tr -d '\11\12')"
  case "$probe" in
    *[[:cntrl:]]*) die "Gangline config $file contains control characters other than tab and newline" ;;
  esac

  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    while [[ "$line" == ' '* || "$line" == $'\t'* ]]; do line="${line#?}"; done
    case "$line" in ''|'#'*) continue ;; esac
    case "$line" in
      *=*) k="${line%%=*}"; value="${line#*=}" ;;
      *) die "Gangline config $file line $n is not NAME=VALUE" ;;
    esac
    case "$k" in
      ''|*[[:blank:]]*) die "Gangline config $file line $n has blanks in key '$k'" ;;
    esac
    while [[ "$value" == *' ' || "$value" == *$'\t' ]]; do value="${value%?}"; done
    [ -n "$value" ] \
      || die "Gangline config $file line $n sets $k to an empty value; delete the line to take the default"
    previous="$(config_seen_line "$k")" || previous=""
    [ -z "$previous" ] \
      || die "Gangline config $file duplicates $k on lines $previous and $n"
    CONFIG_SEEN="${CONFIG_SEEN:+$CONFIG_SEEN
}$k"$'\t'"$n"
    case " $GANG_CONFIG_KEYS " in
      *" $k "*) ;;
      *)
        case " $GANG_COLLAR_KEYS " in
          *" $k "*) die "Gangline config $file line $n: $k is a collar declaration, not operator configuration — load_collar clears it before sourcing the collar, so a value here would be discarded. Put it in a custom collar and point GANG_COLLARS at its directory." ;;
        esac
        case "$k" in
          GANG_TEST_COLLARS) die "Gangline config $file line $n: $k is a per-invocation switch for Gangline's own suite and cannot be persisted" ;;
          GANG_CONFIG_DIR) die "Gangline config $file line $n: GANG_CONFIG_DIR bootstraps the config file being read and cannot be set inside it" ;;
          GANG_MODEL|GANG_COLLAR_FILE) die "Gangline config $file line $n: $k is internal to Gangline and cannot be configured" ;;
          *) die "Gangline config $file line $n has unknown key $k (settable: $GANG_CONFIG_KEYS)" ;;
        esac
        ;;
    esac
    envset=""
    eval "envset=\${$k+set}"
    if [ "$envset" = set ]; then
      config_record "$k" env "$n"
    else
      eval "$k=\$value"
      config_record "$k" config "$n"
    fi
  done < "$file"
  config_env_origins
}

config_load

DEFAULT_SESSION=gangline
SESSION="${GANG_SESSION:-$DEFAULT_SESSION}"

require_whole() { # $1 = name to blame, $2 = value, $3 = the unit for the message
  case "$2" in
    ''|*[!0-9]*) die "$1 must be a whole number of $3, got '$2'$(config_origin_note "$1")" ;;
  esac
}
require_interval() { # $1 = name to blame, $2 = value; reaches sleep, so fractions are fine
  case "$2" in
    ''|.|*[!0-9.]*|*.*.*) die "$1 must be a non-negative number of seconds, got '$2'$(config_origin_note "$1")" ;;
  esac
}

require_python3() {
  command -v python3 >/dev/null 2>&1 \
    || die "python3 is required for native hook payloads, wait deadlines, context lights, operator doctrine validation, and curfew clock times"
}

shell_quote() { # one POSIX-shell word
  local value marked sentinel=$'\034'
  marked="$(printf '%s\034' "$1" | sed "s/'/'\\\\''/g")"
  case "$marked" in
    *"$sentinel") value="${marked%"$sentinel"}" ;;
    *) die "internal: the shell-quote sentinel was lost" ;;
  esac
  printf "'%s'" "$value"
}

gang_root() { # $1 = path to this script; the install tree it lives in
  local src="$1" dir
  while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")/.." && pwd
}
ROOT="$(gang_root "${BASH_SOURCE[0]}")"
[ -d "$ROOT/collars" ] \
  || die "no collars/ beside $ROOT — this is not a gangline tree. Reinstall, or run bin/gang from a checkout."

binary_id() { # executable content witness, or an explicit unavailable value
  local output checksum size
  output="$(cksum "$ROOT/bin/gang" 2>/dev/null)" \
    || { printf 'unavailable'; return; }
  read -r checksum size _ <<<"$output"
  if [[ "$checksum" =~ ^[0-9]+$ ]] && [[ "$size" =~ ^[0-9]+$ ]]; then
    printf 'cksum:%s:%s' "$checksum" "$size"
  else
    printf 'unavailable'
  fi
}

dirty_execution_warn() { # a checkout executable that differs from HEAD is live evidence
  local top rel head rc=0
  top="$(git -C "$ROOT" rev-parse --show-toplevel 2>/dev/null)" || return 0
  case "$ROOT/bin/gang" in "$top"/*) ;; *) return 0 ;; esac
  rel="${ROOT#"$top"/}/bin/gang"
  head="$(git -C "$top" rev-parse HEAD 2>/dev/null)" || return 0
  git -C "$top" diff --quiet HEAD -- "$rel" 2>/dev/null || rc=$?
  case "$rc" in 0) return 0 ;; 1) ;; *) return 0 ;; esac
  printf 'gang: WARNING: executing dirty %s; its bytes diverge from HEAD %s\n' \
    "$ROOT/bin/gang" "$head" >&2
}
GANG_CHURN_WAIT="${GANG_CHURN_WAIT:-0.5}"
GANG_ACTIVITY_WINDOW="${GANG_ACTIVITY_WINDOW:-5}"
GANG_ACTIVITY_LIMIT="${GANG_ACTIVITY_LIMIT:-300}"
GANG_TURN_LIMIT="${GANG_TURN_LIMIT:-300}"
GANG_CONTEXT_LIGHTS="${GANG_CONTEXT_LIGHTS:-collar}"
GANG_USAGE_LIGHTS="${GANG_USAGE_LIGHTS:-off}"
GANG_AUTO_RESUME="${GANG_AUTO_RESUME:-off}"
GANG_SCOPE="${GANG_SCOPE:-off}"
case "$GANG_SCOPE" in
  on|off) ;;
  *) die "GANG_SCOPE must be on or off, got '$GANG_SCOPE'$(config_origin_note GANG_SCOPE)" ;;
esac
GANG_TMUX_GUARD="${GANG_TMUX_GUARD:-on}"
case "$GANG_TMUX_GUARD" in
  on|off) ;;
  *) die "GANG_TMUX_GUARD must be on or off, got '$GANG_TMUX_GUARD'$(config_origin_note GANG_TMUX_GUARD)" ;;
esac
GANG_STALL_REPEAT=600

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_OK="$(printf "\033[32m")" C_WORK="$(printf "\033[33m")" C_BAD="$(printf "\033[31m")" C_DIM="$(printf "\033[2m")" C_OFF="$(printf "\033[0m")"
else
  C_OK="" C_WORK="" C_BAD="" C_DIM="" C_OFF=""
fi
colour() { printf "%s%s%s" "$1" "$2" "$C_OFF"; }

cmd_help() { # $1 = command; empty prints the command inventory
  case "${1:-}" in
    # THE PAGE A FRESHLY HITCHED AGENT LANDS ON. `gang` with no arguments used
    # to print the whole inventory to stderr and exit 1, which told an agent
    # reading it that it had done something wrong. Onboarding is now `run gang`:
    # what you are, how to say something, how to read what was said to you, and
    # what a refusal is. The inventory is one command further on.
    welcome) cat <<'EOF'
gang — a team of CLI agents in tmux

Every agent is a real CLI harness in its own
tmux window. Gang carries messages between
them and reports what each is doing. It does
not plan or supervise their work. Run this
from inside one of those windows and you are
one of them; gang whoami says which.

find yourself
    gang whoami    who this window is
    gang roster    the team and its state

say something
    printf '%s\n' "..." |
      gang send --to NAME --stdin
  Delivery is verified in the target's own
  input box, and never interrupts a turn. A
  If the teammate cannot take it now, the
  message stays in its spool and is delivered
  at the next turn boundary its harness
  reports. Where no spool is available, exit
  3 says it was not accepted and the message
  is still yours to send.

read what was sent to you
    gang mail
  Reading your OWN queue consumes it. Read
  it whole: whatever you pipe away is gone.

watch a teammate
    gang status NAME   what it is doing
    gang explain NAME  why that state
    gang wait NAME --until idle|done

what an exit code means
    0  it happened
    3  refusal: it did NOT happen, and
       stderr says why
    1  error, which is NOT proof that
       nothing happened — read stderr
       before retrying anything

then
    gang help            every command
    gang <cmd> --help    one whole page
    gang collars         harnesses to hitch
    gang roles           briefs to hitch
EOF
      ;;
    '') cat <<'EOF'
gang — drive native CLI agents in tmux

Every agent is a real CLI harness running in
its own tmux window. gang collars lists the
harnesses it can drive. Gang launches them,
carries verified messages between them, and
reports what each is doing. It does not plan
or supervise their work.

Agents coordinate by message. This is the one
line you cannot work without:

    printf '%s\n' "..." |
      gang send --to NAME --stdin

Exit 0 is success. Exit 3 is a refused
command: what you asked for was not done, and
stderr says why. Exit 1 is an error, and an
error is not proof that nothing happened —
read stderr before retrying anything. A
refused DELIVERY is a different thing: send
parks it and exits 0, because the message was
accepted.

start and end a team
  up        start a team and join it
  hitch     add an agent
  adopt     register an existing window
  rename    change an agent's registered name
  drop      remove one agent
  down      end the team

talk to agents
  send      deliver a message to an agent
  at        deliver a message at a time
  mail      read an agent's waiting queue
  flush     recover a harness-queued message
  interrupt stop an agent's current turn
  compact   ask an agent to compact context

watch agents
  roster    list the team and its state
  status    inspect one agent's state
  tick      run one cooperative retry pass
  explain   show why a state was classified
  wait      wait for an agent boundary
  capture   read an agent's pane
  composer  read an agent's input box
  context   read an agent's context
  limits    read provider usage limits
  wait-limit resume at a provider reset
  whoami    read this pane's identity
  attach    join the team in tmux
  teams     list teams and their sockets

settings and discovery
  notify    set or show the stall-note target
  curfew    set or show the team curfew
  collars   list available harness collars
  models    list a collar's native model ids
  roles     list available role briefs
  config    show effective configuration

installation
  upgrade   install or check the latest release

gang <command> --help is the whole page for
one command: every flag, what it means, and
when to reach for it. gang with no arguments
is the getting-started page for an agent.
The exhaustive reference is docs/reference.md
in the Gangline checkout.
EOF
      ;;
    up) cat <<'EOF'
gang up
  Start a team and join it. Hitches one lead
  agent, then attaches this terminal to its
  window.

  gang up [name]
    [hitch flags]

  This is the whole setup for a new team. Add
  teammates with gang hitch, message them
  with gang send, watch them with gang roster.

  [name]  window name for the lead
          (default: lead)

  Every gang hitch flag is accepted here and
  passed through unchanged, including -r,
  which defaults to the lead role.
  gang hitch --help is the whole list.
EOF
      ;;
    hitch) cat <<'EOF'
gang hitch
  Add one agent to the team. Launches a
  harness in a new tmux window called <name>
  and delivers a startup contract, so the
  agent knows who it is and how to reach its
  teammates.

  gang hitch <name>
    [-c <harness>]
    [-d <dir>]
    [-m <model>]
    [-e <effort>]
    [-r <role>]
    [-l <lights>]
    [--resume [session-id]]

  <name>  how teammates address it. Letters,
          digits, dot, dash and underscore;
          no leading dot or dash; unique in
          the team. hitch and gangline are
          reserved.

  -c, --collar <harness>
      which harness to run. gang collars
      lists them; GANG_COLLAR is the default.
  -d, --dir <dir>
      directory the harness starts in
      (default: this one).
  -m, --model <model>
      model name, validated by the collar and
      handed to the harness as its own option.
      Discover ids with gang models
      -c <harness>.
  -e, --effort <level>
      reasoning-effort level, from that
      harness's own vocabulary; checked
      before a window opens.
  -r, --role <role>
      role brief for this agent, on top of
      the contract every agent gets. gang
      roles lists them; there is no default.
  -l, --lights <lights>
      context lights for this agent alone:
      collar to take the collar's own default
      for the chosen model, off for none, or
      yellow,red tokens or yellow%,red%.
      Overrides GANG_CONTEXT_LIGHTS, whose
      own default is collar.
  --resume [session-id]
      relaunch onto a harness session that
      already exists. Pass the id gang drop
      printed; the bare form reads it off a
      dead but still registered window, so it
      does not survive that window's removal.

  Omitting -m or -e where the harness takes
  them warns: the harness then falls back to
  a default nobody chose. Hitching a collar
  that witnesses no session id warns too:
  gang learns no id to resume it with.

  A native first-run prompt is answered by a
  person, never by gang. Hitch parks the
  contract, says so, and keeps observing;
  after GANG_GATE_LOOKS observations of an
  unanswered prompt it stops waiting and
  exits 4, leaving the agent alive and the
  contract in its spool. Answer the prompt,
  then drop and hitch again.
EOF
      ;;
    adopt) cat <<'EOF'
gang adopt
  Register a tmux window you started yourself
  as a gang agent, so gang can address it
  like a hitched one.

  gang adopt <name>
    -c <harness>

  Reach for it when the harness is already
  running in a window of this team. That
  window must already carry the name
  (tmux rename-window), spelled the way
  gang hitch requires.

  -c, --collar <harness>
      which harness is running in there.
      Required; gang never guesses one.

  No startup contract is delivered and no
  native hooks are installed, so the agent
  has not read the contract, and anything
  that needs hooks — context readings, spool
  drains at a turn boundary — may be
  unavailable.
EOF
      ;;
    rename) cat <<'EOF'
gang rename
  Change the name the team uses to address one
  registered agent.

  gang rename <old> <new>

  <new> follows the same rules as a hitch name
  and must not already be in use. The old name
  stops resolving immediately. The window's
  spool identity does not change, so messages
  already waiting for it remain reachable.
EOF
      ;;
    send) cat <<'EOF'
gang send
  Deliver a message to one agent, verified in
  that agent's own input box.

  gang send --to <name> --stdin
    [--from <sender>]
    [--live-only]
    [--supersede]

  The body is read from stdin:

    printf '%s\n' "ready?" |
      gang send --to lead --stdin

  --to <name>   who receives it
  --stdin       read the body from stdin.
                Required, and the only way
                to pass a body. An empty
                body is an error.
  --from <who>  who it is from. Required
                from outside the team; an
                error inside it, where the
                calling window is the
                identity.
  --live-only   report a refusal instead of
                parking the message — an
                availability probe. Not
                combinable with --supersede.
  --supersede   retire this sender's older
                waiting messages for this
                target once this one is
                accepted, parked or live.
                Scoped to the sender, not
                to a subject: unrelated
                messages of yours go too.

  A refused delivery parks by default and
  enters the session when the target next
  finishes a turn; nothing further is needed
  from the sender. gang roster shows it
  waiting, gang mail reads it. Where no spool
  is available it cannot park: that exits 3
  saying NOT parked, and the message is still
  yours to send.

  On exit 1, do not simply send again. The
  body may have been typed, left staged, or
  already delivered; read stderr, then read
  the target with gang status.
EOF
      ;;
    at) cat <<'EOF'
gang at
  Park an attributed message now and deliver
  it when the clock passes. The clock is a
  sender, not a scheduler: when the time
  arrives the message joins that agent's
  ordinary queue and enters the session at the
  next delivery opportunity, verified like any
  other send.

  gang at <duration|HH:MM> --to <name> --stdin
    [--from <sender>]
  gang at --to <name> --clear

  The body is read from stdin:

    printf '%s\n' "push window is open" |
      gang at 17:00 --to lead --stdin

  <time>        90m, 2h30m, or a local clock
                time like 17:00, which means
                its next occurrence.
  --to <name>   who receives it
  --stdin       read the body from stdin.
                Required, and the only way to
                pass a body.
  --from <who>  who it is from. Required from
                outside the team; an error
                inside it. Attribution is
                taken NOW, while the sending
                window can still be seen.
  --clear       cancel every timed send parked
                for that target.

  Until it is due, 'gang status <name>' names
  it. If the agent is dropped first, the
  message is archived with the rest of its
  mail rather than vanishing.
EOF
      ;;
    flush) cat <<'EOF'
gang flush
  Recover a message the harness parked in its
  own input queue instead of taking it.

  gang flush [name]

  Reach for it only when a send says the
  harness parked the message in its own queue
  and names gang flush. An ordinary "queued
  for <name>" is gang's own spool instead, and
  needs nothing: it enters the session at the
  next turn boundary.

  Gang presses the collar's recall key, reads
  the loaded body back against the one it
  watched get parked, and presses Enter only
  on an exact match.

  [name]  agent to recover for (default:
          this window)
EOF
      ;;
    mail) cat <<'EOF'
gang mail
  Read the messages waiting in an agent's
  queue, oldest first, each with its sender
  and its body.

  gang mail [name]

  [name]  whose queue to read (default: this
          window)

  Reading somebody else's queue inspects it
  and changes nothing. An agent reading its
  own queue is destructive: every waiting
  message it prints is consumed, never
  delivered again, and moved into a readable
  archive whose path is printed on stderr.
  Never pipe your own read through head or
  tail — the part you cut is already out of
  the queue. Held entries are printed too and
  are never consumed.
EOF
      ;;
    interrupt) cat <<'EOF'
gang interrupt
  Stop an agent's current turn, by sending
  the stop key its harness declares.

  gang interrupt [name]
    [-m "reason"]
    [--from <sender>]

  [name]         agent to stop. Omit it and
                 gang stops this window's own
                 turn, with or without a
                 reason.
  -m "reason"    deliver this message once
                 the turn has stopped and
                 the input box is back. It
                 is never parked: a queued
                 stop would arrive after the
                 work it meant to stop. If
                 it cannot be delivered, the
                 reason is printed back so
                 it is not lost.
  --from <who>   who the reason is from, as
                 in gang send. Only with -m.

  Whether the harness stops is the harness's
  verdict; gang reports only that the key was
  sent. Read the outcome with gang status.
EOF
      ;;
    compact) cat <<'EOF'
gang compact
  Ask an agent to compact its context, using
  its harness's own compaction command.

  gang compact [name]
    [--resume "<turn to take after>"]

  Reach for it when an agent is close to
  filling its context window; gang context
  reads how full that is.

  [name]     agent to compact (default: this
             window)
  --resume   the turn to take once the
             compaction finishes. One always
             follows, so the agent never
             lands idle behind a compaction;
             this replaces the default turn.

  An agent compacting itself is scheduled for
  the end of its current turn. gang status
  reports a self-compaction still pending.

  A boundary where the composer is somebody
  else's — an operator mid-reply, a dialog on
  the screen — defers it rather than dropping
  it: the request stands, gang retries when
  the next turn ends, and the agent is told
  its context was not compacted.
EOF
      ;;
    context) cat <<'EOF'
gang context
  Read how full an agent's context window is.

  gang context [name]

  [name]  agent to read (default: this
          window)

  Prints the harness's own reading, unparsed,
  in its used/window (percent) form. Reach
  for it before deciding whether to
  gang compact. Where a harness offers no
  readable source this fails loudly instead
  of inventing a number.
EOF
      ;;
    limits) cat <<'EOF'
gang limits
  Read provider usage limits without driving
  an agent's composer.

  gang limits [name]

  [name]  agent whose provider limits to read
          (default: this window)

  The collar owns a machine-readable or
  headless source. Output names each native
  window, percent used, reset time, and sample
  age. A collar with no such source fails
  loudly; gang never substitutes a pane scrape.
EOF
      ;;
    wait-limit) cat <<'EOF'
gang wait-limit
  Go idle until a provider usage window resets.

  gang wait-limit [name]
    [--resume "next turn"]
  gang wait-limit [name] --clear

  [name]    agent to resume (default: this
            window)
  --resume  turn delivered after the reset;
            the default only says the reset
            happened and asks the agent to
            re-read its assignment.
  --clear   cancel this agent's pending wake.

  Gang reads the collar's non-interactive
  limit source, chooses the most-used window
  (the later reset breaks a tie), and creates
  one transient systemd user timer. No watcher
  or Gangline daemon remains running.

  --clear stops that timer and the service it
  may already have started, and removes the
  declaration either way. A unit still running
  afterwards is reported with the systemctl
  command that stops it.
EOF
      ;;
    wait) cat <<'EOF'
gang wait
  Block on one agent's native turn boundary.

  gang wait <name> --until idle|done
            [--timeout <seconds>]

  idle  return when a live state read is idle
  done  return at the next Stop boundary

  An already-idle agent returns immediately.
  Otherwise the target collar must supply its
  native Stop hook and carry readable native
  turn evidence. This is a caller-chosen
  barrier, not a watcher: gang starts no daemon
  and records no wait option or file.

  done does not track turns. If the agent is
  already working, that active turn's Stop may
  satisfy it. idle re-reads after each Stop and
  waits again while positive busy or occupied
  evidence remains.

  Unknown state, a vanished or replaced window,
  or a changed active pane fails loudly instead
  of hanging or transferring the wait. Use gang
  drop/down for teardown; raw tmux kill commands
  bypass Gangline's release boundary. A boundary
  that does not arrive before the timeout also
  fails loudly; the default is GANG_TURN_LIMIT.
EOF
      ;;
    notify) cat <<'EOF'
gang notify
  Set, show, or clear the agent that receives
  stall notes.

  gang notify
  gang notify <name>
  gang notify clear

  When a harness reports it is waiting on
  input — a permission prompt, a question —
  gang sends one attributed note to this
  target, so somebody hears about a stuck
  agent. With none declared, nothing is sent;
  gang starts no timer and runs no patrol.

  <name>   agent to receive the notes. It
           need not exist yet.
  clear    remove the declaration.
  (bare)   print the current target.

  Repeated notes of the same kind are
  collapsed into one. The declaration dies
  with the team session.
EOF
      ;;
    curfew) cat <<'EOF'
gang curfew
  Set, show, or clear one wall-clock deadline
  for the whole team.

  gang curfew
  gang curfew <duration|HH:MM>
  gang curfew clear

  A declared curfew gives hook-enabled agents
  two advisory edges — yellow halfway through
  the span, red after four fifths — each
  surfaced once, so they can land work before
  time runs out. Gang itself does nothing at
  the deadline.

  <duration>  90m, 2h, 1h30m. Units are
              required; a bare number is an
              error.
  HH:MM       the next occurrence of that
              local 24-hour clock time.
  clear       remove the declaration.
  (bare)      print the current curfew.

  Declaring again replaces and restarts it.
EOF
      ;;
    status) cat <<'EOF'
gang status
  Report what one agent is doing right now,
  from live evidence and the last native Stop.

  gang status [name]

  [name]  agent to inspect (default: this
          window)

  One state line: -busy-, ~wait~, ~idle~,
  !occupied!
  where a native UI owns the input box,
  !bricked! where fatal turn evidence says no
  turn can succeed, or ?unknown? where the
  evidence cannot settle it. Then anything else
  worth knowing —
  input gang could not deliver and what is in
  that box now, messages waiting or held,
  a self-compaction pending or failed, a
  stall note not accepted, a harness session
  identity mismatch, and skew between this
  gang binary and the one that hitched the
  agent.
EOF
      ;;
    tick) cat <<'EOF'
gang tick
  Run one synchronous cooperative retry pass
  across every hitched agent in the team.

  Ordinary gang commands launch this same pass
  detached after their own result is settled.
  Use the explicit command for deterministic
  diagnostics and tests. It takes no arguments.

  The pass retries parked delivery and deferred
  self-compaction only through their existing
  turn-boundary safety gates. A singleton lock
  folds concurrent candidates into one dirty
  rerun, and a hard deadline kills the one-shot
  worker rather than leaving a resident process.
EOF
      ;;
    explain) cat <<'EOF'
gang explain
  Show how one live state read was classified.

  gang explain <name>

  Prints the agent, active pane, collar and
  resulting state, then the collar-owned fatal
  reader and the GANG_OCCUPIED_REGEX and
  GANG_BUSY_REGEX rules: whether that same read
  used them, the fatal cause, or the exact regex
  and first captured pane line it matched.

  A rule can be matched, not matched, not
  declared, or not evaluated because stronger
  native evidence already settled that part of
  the state. The pane is captured only by the
  ordinary state read; it does not recapture and
  accidentally diagnose a different screen.

  Use it when a harness update makes busy, idle
  or occupied look wrong. It writes no
  diagnostic record of its own; the ordinary
  state read it runs may still refresh the
  window glyph and the evidence status keeps.
EOF
      ;;
    roster) cat <<'EOF'
gang roster
  List every window in the team with its
  collar and current state.

  gang roster
  gang roster --porcelain

  Reach for it first when something looks
  wrong: every row is computed live, unlike
  the state glyph in a window's tmux name.
  Unadopted windows are listed but are not
  agents.

  --porcelain  one unpadded, uncoloured TSV
               row per window, for scripts:
               name, collar, state, spooled,
               oldest_age_s, session_id.

  Every agent is listed. A row whose state
  gang could not READ carries ?unknown? in
  place of one, the reading it could not take
  is printed on stderr just above it, and
  roster exits nonzero. A reading that was
  taken and did not settle is an ordinary
  ?unknown? row and exits 0, as status does.
  Either way the row is the answer, not the
  exit status.

  With no team running, the plain form says
  so and --porcelain prints no rows; both
  exit successfully.
EOF
      ;;
    capture) cat <<'EOF'
gang capture
  Print the tail of an agent's terminal, as
  it looks on screen.

  gang capture [name] [lines]

  [name]   agent to read (default: this
           window)
  [lines]  how many lines up from the bottom
           (default: 40)

  A count alone reads as an agent name, so
  pass both or neither. Trailing blank rows
  are trimmed. This is the raw pane, where a
  harness's dim placeholder text looks just
  like a real draft — gang composer is the
  reading that settles the input box.
EOF
      ;;
    composer) cat <<'EOF'
gang composer
  Print what is actually typed into an
  agent's input box.

  gang composer [name]

  [name]  agent to read (default: this
          window)

  The collar's styled reading, so a dim
  suggested-prompt placeholder never appears
  as text. No output means the box is empty.
  Reach for it before deciding somebody is
  mid-draft, and when a send refused because
  the box was not empty.
EOF
      ;;
    whoami) cat <<'EOF'
gang whoami
  Read this pane's Gangline identity.

  gang whoami

  Takes no arguments, and answers only from
  inside an agent window. Prints the name
  teammates address, the pane, the collar
  driving it, the harness session id gang
  would resume, the newest id seen in a
  native hook, the team session, and any
  recorded mismatch between those two ids.
  Reach for it when a send from this pane
  was refused on identity grounds.
EOF
      ;;
    attach) cat <<'EOF'
gang attach
  Join the team in tmux.

  gang attach

  Takes no arguments. Attaches this terminal
  to the team session, one window per agent,
  so you can watch one work or type into it
  yourself. Leave with tmux's own detach
  (prefix then d); the team keeps running.
EOF
      ;;
    teams) cat <<'EOF'
gang teams
  List the teams gang has written down and
  the tmux socket each is reachable on.

  gang teams

  Takes no arguments. tmux clients find the
  default socket; a private TMUX_TMPDIR moves
  it, so a live team can be unreachable from
  a shell that lost that environment. Hitch
  records the socket of every team it opens,
  and this reads those records back, asking
  each server whether the session is still
  there rather than trusting the file.

  gang attach uses the same records: when the
  team is not on this shell's socket it
  attaches on the recorded one.
EOF
      ;;
    drop) cat <<'EOF'
gang drop
  Remove one agent: kill exactly that agent's
  window.

  gang drop <name>

  <name>  agent to remove. Required — drop
          never takes a target by omission.

  Prints the stamped harness session id and
  the exact gang hitch --resume line that
  reopens that session, so a drop is
  recoverable. That line carries the session
  only: pass the harness, directory, model,
  effort and role again yourself. An agent
  whose collar supplied no id prints no
  relaunch line at all.

  Messages still waiting for it are archived
  before the window dies. Whatever exists
  only on that screen goes with it; gang
  capture first if it matters.
EOF
      ;;
    down) cat <<'EOF'
gang down
  End the team: kill the team session and
  every agent in it.

  gang down <session>

  <session>  the team to end. Required, and
             it must match the team this
             shell is pointed at — gang ends
             only the team you name.

  This ends work you may not have started;
  gang roster first. Waiting messages are
  archived. Refused from a pane inside the
  session, with no override: an agent must
  not end the team it is running in. Detach
  and run it from a shell outside tmux.
EOF
      ;;
    collars) cat <<'EOF'
gang collars
  List the harness collars available to
  hitch.

  gang collars

  Takes no arguments. A collar is the file
  that teaches gang one harness: how to
  launch it, read its input box, stop a turn,
  compact, and read its context. Pass a
  listed name to gang hitch -c. Your own
  collars, from GANG_COLLARS, win over the
  shipped ones by name.

  Two tab-separated columns: the name, and
  what an agent on it can be resumed onto.
  resume: the collar witnesses its harness's
  own session id and can relaunch onto it.
  resume-id-only: it can relaunch onto an id
  you supply, but gang never learns one, so
  drop prints none. no-resume: it declares no
  resume launch at all.
EOF
      ;;
    models) cat <<'EOF'
gang models
  List the model ids a harness can enumerate.

  gang models [-c <harness>]

  -c, --collar <harness>
      harness to ask (default: GANG_COLLAR).

  Output is sorted TSV: model id, then an
  optional comma-separated effort vocabulary.
  A collar with aliases but no complete native
  catalog prints those aliases and says on
  stderr that full names cannot be enumerated.

  Hitch validates -m against a complete catalog.
  A collar may instead declare a native model
  recognition check, which cannot prove account
  access.
EOF
      ;;
    roles) cat <<'EOF'
gang roles
  List the role briefs available to hitch.

  gang roles

  Takes no arguments. A role brief is prose
  attached to one agent at hitch, on top of
  the contract every agent gets. Three
  tab-separated columns: the name, where the
  file came from, and whether it is usable.
  Only a usable name works with
  gang hitch -r; an unusable file stays
  listed with its defect named.
EOF
      ;;
    config) cat <<'EOF'
gang config
  Show the settings gang is actually using,
  and where each value came from.

  gang config

  Takes no arguments and needs no running
  team. Reach for it when a setting is not
  what you expected: the origin says what is
  winning. One line per setting: its
  effective value, then that origin — a
  built-in default, the config file and line,
  or the environment. Then whether the operator
  doctrine file and roles directory are
  present, with the path to each slot.
EOF
      ;;
    upgrade) cat <<'EOF'
gang upgrade
  Install the latest stable Gangline release
  over the tree this command is running from.

  gang upgrade
  gang upgrade --check

  Both forms explicitly contact the configured
  source to read gangline-v* release tags.
  Ordinary gang commands make no update check
  and no network call.

  --check  report whether a newer release is
           available without changing files.

  A custom install keeps using GANGLINE_REPO
  when that variable is present. The install
  directory and command link are derived from
  this running command, so the release lands
  over the current install.
EOF
      ;;
    *) die "no help for unknown command '$1'" ;;
  esac
}

usage() { cmd_help; }

usage_die() { usage >&2; exit 1; }

TEST_ONLY_COLLARS="bash"

test_only_collar() { # $1 = collar name; exit 0 if it is a stand-in, not a harness
  [ "${GANG_TEST_COLLARS:-}" = 1 ] && return 1
  case " $TEST_ONLY_COLLARS " in *" $1 "*) ;; *) return 1 ;; esac
  [ "$(collar_file "$1" 2>/dev/null)" = "$ROOT/collars/$1.sh" ]
}

all_collars() {
  local d p
  for d in ${GANG_COLLARS:+"$GANG_COLLARS"} "$ROOT/collars"; do
    [ -d "$d" ] || continue
    for p in "$d"/*.sh; do
      [ -f "$p" ] || continue
      p="${p##*/}"
      printf '%s\n' "${p%.sh}"
    done
  done | sort -u
}

list_collars() { # what an operator may pick from
  local n out=""
  while read -r n; do
    [ -n "$n" ] || continue
    test_only_collar "$n" && continue
    out="$out$n
"
  done <<EOF
$(all_collars)
EOF
  printf '%s' "$out"
}

role_status() { # $1 path, $2 basename stem; populate ROLE_STATUS and PROSE
  local file="$1" name="$2" display
  if ! valid_role_name "$name"; then
    ROLE_STATUS="role name must use only letters, digits, dot, dash and underscore, and must not start with dash or dot"
    return 1
  fi
  display="$(config_path "$file" | config_sanitize)"
  if ! prose_check "$file" "role brief" "$display"; then
    ROLE_STATUS="$PROSE_ERROR"
    return 1
  fi
  if [ ! -s "$file" ]; then
    ROLE_STATUS="role brief $display is empty"
    return 1
  fi
  ROLE_STATUS=ok
}

role_rows_in() { # $1 directory, $2 operator|shipped; print resolved rows
  local dir="$1" origin_kind="$2" file base name winning origin status
  [ -d "$dir" ] || return 0
  for file in "$dir"/*.md "$dir"/.*.md; do
    [ -e "$file" ] || [ -L "$file" ] || continue
    base="${file##*/}"
    name="${base%.md}"
    if [ "$origin_kind" = shipped ]; then
      winning="$CONFIG_DIR/roles/$base"
      [ ! -e "$winning" ] && [ ! -L "$winning" ] || continue
      origin=shipped
    else
      origin="$(config_path "$file" | config_sanitize)"
    fi
    role_status "$file" "$name" || true
    name="$(printf '%s' "$name" | config_sanitize)"
    status="$(printf '%s' "$ROLE_STATUS" | config_sanitize)"
    printf '%s\t%s\t%s\n' "$name" "$origin" "$status"
  done
}

role_rows() {
  role_rows_in "$CONFIG_DIR/roles" operator
  role_rows_in "$ROOT/roles" shipped
}

list_usable_roles() {
  role_rows | awk -F '\t' '$3 == "ok" { print $1 }'
}

cmd_roles() {
  [ $# -eq 0 ] || die "roles: takes no arguments"
  role_rows
}

collar_file() { # $1 = collar name -> path on stdout; yours wins over the shipped one
  local d
  for d in ${GANG_COLLARS:+"$GANG_COLLARS"} "$ROOT/collars"; do
    [ -f "$d/$1.sh" ] && { printf '%s' "$d/$1.sh"; return 0; }
  done
  return 1
}

load_collar() { # $1 = collar name; sets the GANG_* strategy surface
  local f resume_tail
  f="$(collar_file "$1")" \
    || die "unknown collar '$1' (have: $(list_collars | tr '\n' ' '))"
  GANG_LAUNCH="" GANG_RESUME_LAUNCH="" GANG_BUSY_REGEX=""
  GANG_OCCUPIED_REGEX="" GANG_QUEUED_REGEX="" GANG_COMPACT_CMD="" GANG_SELF_COMPACT=""
  GANG_MIDTURN_INPUT="" GANG_QUEUE_RECALL_KEY=""
  GANG_INTERRUPT_KEY="" GANG_STOP_HOOK=""
  GANG_STALL_TYPES=""
  GANG_USAGE_LIGHT_INTERVAL=0 GANG_USAGE_LIMIT_MAX_AGE=0
  GANG_QUIET_AT_REST="" GANG_MODEL_OPT="" GANG_MODEL_ALIASES=""
  GANG_EFFORT_OPT="" GANG_EFFORT_CMD=""
  GANG_ROLE_PROMPT_OPT="" GANG_HARNESS_PROMPT=""
  GANG_COLLAR_FILE="$f"
  # EVERY OPTIONAL COLLAR FUNCTION, because the whole point of this list is that
  # a collar which declares none of them is read as declaring none of them.
  # A name missing here is one a previously loaded collar keeps answering for
  # the next, and `declare -F` is how each of them is asked whether it exists.
  unset -f collar_context collar_context_lights collar_input collar_overlay \
    collar_session_id collar_live_session_id collar_models collar_model_check collar_bricked collar_waiting \
    collar_last_action collar_usage_limits collar_usage_limits_error \
    collar_auto_resume_record collar_auto_resume_prompt 2>/dev/null || true
  # shellcheck source=/dev/null
  . "$f"
  case "$GANG_USAGE_LIGHT_INTERVAL" in
    ''|*[!0-9]*) die "collar '$1' has an invalid GANG_USAGE_LIGHT_INTERVAL declaration" ;;
  esac
  case "$GANG_USAGE_LIMIT_MAX_AGE" in
    ''|*[!0-9]*) die "collar '$1' has an invalid GANG_USAGE_LIMIT_MAX_AGE declaration" ;;
  esac
  [ -n "$GANG_LAUNCH" ] || die "collar '$1' sets no GANG_LAUNCH"
  [ -z "$GANG_HARNESS_PROMPT" ] || [ -n "$GANG_ROLE_PROMPT_OPT" ] \
    || die "collar '$1' declares GANG_HARNESS_PROMPT but no GANG_ROLE_PROMPT_OPT, so gang has no system-prompt option that can carry it"
  if [ -n "$GANG_RESUME_LAUNCH" ]; then
    case "$GANG_RESUME_LAUNCH" in
      *'{{session_id}}'*) ;;
      *) die "collar '$1' declares GANG_RESUME_LAUNCH without the required {{session_id}} slot — recency is not identity" ;;
    esac
    resume_tail="${GANG_RESUME_LAUNCH#*'{{session_id}}'}"
    case "$resume_tail" in
      *'{{session_id}}'*) die "collar '$1' declares GANG_RESUME_LAUNCH with more than one {{session_id}} slot" ;;
    esac
  fi
  case "$GANG_SELF_COMPACT" in
    ''|deferred) ;;
    *) die "collar '$1' sets unknown GANG_SELF_COMPACT '$GANG_SELF_COMPACT' (expected deferred or unset)" ;;
  esac
  case "$GANG_STOP_HOOK" in
    ''|1) ;;
    *) die "collar '$1' sets unknown GANG_STOP_HOOK '$GANG_STOP_HOOK' (expected 1 or unset)" ;;
  esac
  case "$GANG_MIDTURN_INPUT" in
    ''|1|park|steer) ;;
    *) die "collar '$1' sets unknown GANG_MIDTURN_INPUT '$GANG_MIDTURN_INPUT' (expected 1, park, steer, or unset)" ;;
  esac
  # A key gang sends by NAME, never as literal text: tmux resolves Up, Escape
  # and C-c from this word, and anything outside the key-name alphabet would
  # arrive in the composer as characters instead of as the keystroke the
  # collar meant.
  local declared key
  for declared in GANG_QUEUE_RECALL_KEY GANG_INTERRUPT_KEY; do
    key="${!declared}"
    case "$key" in
      ''|*[!A-Za-z0-9-]*) [ -z "$key" ] \
        || die "collar '$1' declares $declared '$key', which is not a tmux key name — gang refuses to send it, because tmux would deliver the letters instead of the key" ;;
    esac
  done
}

valid_name() { # $1 = a name; usable as identity, tmux target, shell word, JSON string
  case "$1" in
    hitch|gangline) return 1 ;;
    ''|-*|.*) return 1 ;;
    *[!A-Za-z0-9._-]*) return 1 ;;
  esac
}

valid_role_name() { # $1 = a role filename stem; no identity-only reservations
  case "$1" in
    ''|-*|.*) return 1 ;;
    *[!A-Za-z0-9._-]*) return 1 ;;
  esac
}

role_file() { # $1 = role name -> winning path on stdout, operator first
  local file="$CONFIG_DIR/roles/$1.md"
  if [ -e "$file" ] || [ -L "$file" ]; then
    printf '%s' "$file"
    return 0
  fi
  file="$ROOT/roles/$1.md"
  if [ -e "$file" ] || [ -L "$file" ]; then
    printf '%s' "$file"
    return 0
  fi
  return 1
}

mint_nonce() { od -An -N4 -tx1 /dev/urandom | tr -d ' \n'; }

ENVELOPE=""
envelope() { # $1 = sender, $2 = body; the message as it goes on the wire, into ENVELOPE
  local nonce body marked sentinel=$'\034'
  nonce="$(mint_nonce)"
  marked="$(printf '%s\034' "$2" \
    | sed -E 's,(\[|［|〔|【)([[:space:]]*/?[[:space:]]*)([Gg][Aa][Nn][Gg])([[:space:]]*:),(\2\3\4,g')"
  case "$marked" in
    *"$sentinel") body="${marked%"$sentinel"}" ;;
    *) die "internal: the envelope sentinel was lost while neutralising tag-shaped text" ;;
  esac
  ENVELOPE="[gang:$1#$nonce] $body [/gang:$1#$nonce]"
}

STDIN_BODY=""
stdin_body() { # $1 = command/option label; read all text from stdin into STDIN_BODY
  local marked sentinel=$'\034' rc
  if marked="$(
    cat || { rc=$?; exit "$rc"; }
    printf '\034'
  )"; then
    :
  else
    die "$1: cannot read the body from stdin"
  fi
  case "$marked" in
    *"$sentinel") STDIN_BODY="${marked%"$sentinel"}" ;;
    *) die "internal: $1 stdin sentinel was lost while reading the body" ;;
  esac
  [ -n "$STDIN_BODY" ] || die "$1: empty body on stdin"
}

# OBSERVED IDENTITY AND A CLAIM ABOUT ONE ARE DIFFERENT FACTS, and the envelope
# is where the difference has to land, because the envelope is all the receiver
# gets. Gangline reads a sender off the calling window where it can see one and
# refuses a claimed name there; where it cannot see one the name stands as
# claimed, which is law 2 and is not changing. What was missing is that the two
# arrived looking identical. Any process that can reach the socket and the
# executable can name itself anything — a harness's sandboxed command surface
# strips the tmux environment, so `--from` becomes mandatory there and the
# result was indistinguishable from a pane Gangline had actually watched.
#
# This is a LABEL, not a check. Nothing here proves who is calling and nothing
# here should: authentication is banned in this repo, and the honest repair is
# to stop presenting a claim as an observation. The prefix is carried in the
# sender field of both tags, is legible without knowing this rule, and cannot
# collide with an observed sender because `:` is not a usable agent name.
GANG_DECLARED_PREFIX="self-declared:"

SEND_FROM="" SEND_WINDOW="" SEND_WIRE=""
send_sender() { # $1 = optional outside identity; derive identity inside the team
  local claimed="$1" label="${2:-send}" self
  SEND_FROM="" SEND_WINDOW="" SEND_WIRE=""
  if self="$(self_window)"; then
    [ -z "$claimed" ] \
      || die "$label: --from is only for calls outside session '$SESSION'; this window already has a Gangline identity (inspect it with gang whoami)"
    SEND_WINDOW="$self"
    SEND_FROM="$(agent_name_of "$self")" \
      || die "$label: cannot read this Gangline window's identity"
  else
    [ -n "$claimed" ] \
      || die "$label: calls outside session '$SESSION' must name their identity with --from <sender>"
    SEND_FROM="$claimed"
  fi
  valid_name "$SEND_FROM" \
    || die "sender '$SEND_FROM' is not a usable identity — use letters, digits, dot, dash and underscore; do not start with dash or dot; hitch and gangline are reserved"
  # The identity as it goes on the wire. Derived here and only here, so every
  # command that attributes a message gets the same answer and none of them
  # decides for itself which kind of attribution it is holding.
  if [ -n "$SEND_WINDOW" ]; then SEND_WIRE="$SEND_FROM"
  else SEND_WIRE="$GANG_DECLARED_PREFIX$SEND_FROM"; fi
}

registered_identity_guard() { # $1 window, $2 requested name, $3 action, optional $4 requested collar
  local registered collar stamped
  registered="$(tmux show-options -wqv -t "$1" @gl_agent 2>/dev/null)" || registered=""
  collar="$(collar_read "$1")" || exit 1
  stamped="$(tmux show-options -wqv -t "$1" @gl_session_id 2>/dev/null)" || stamped=""
  if [ -n "$registered" ] && [ "$registered" != "$2" ]; then
    die "$3: window '$2' is registered to Gangline agent '$registered'; refusing to replace that identity with '$2'"
  fi
  if [ -z "$registered" ] && { [ -n "$collar" ] || [ -n "$stamped" ]; }; then
    if [ "$3" = adopt ]; then
      [ -z "$collar" ] || [ "$collar" = "${4:-}" ] \
        || die "adopt: window '$2' carries collar residue '$collar', not requested collar '${4:-}'; refusing to rewrite its collar identity"
      return 0
    fi
    die "$3: window '$2' carries Gangline collar/session residue but no attributable @gl_agent identity; refusing to claim it as '$2' (inspect it before clearing the residue)"
  fi
}

identity_mismatch_read() { # $1 window; print the recorded mismatch, or nonzero
  local mismatch
  mismatch="$(tmux show-options -wqv -t "$1" @gl_session_mismatch 2>/dev/null)" || mismatch=""
  [ -n "$mismatch" ] || return 1
  printf '%s' "$mismatch"
}

session_identity_record() { # $1 window, $2 exact live native id
  local live="$2" stamped registered name
  tmux set-option -w -t "$1" @gl_session_live_id "$live" 2>/dev/null || return 1
  name="$(agent_name_of "$1")"
  registered="$(tmux show-options -wqv -t "$1" @gl_agent 2>/dev/null)" || registered=""
  if [ -z "$registered" ]; then
    tmux set-option -w -t "$1" @gl_agent "$name" 2>/dev/null || return 1
  elif [ "$registered" != "$name" ]; then
    tmux set-option -w -t "$1" @gl_session_mismatch \
      "agent '$registered' != window '$name'" 2>/dev/null || true
    return 2
  fi
  stamped="$(tmux show-options -wqv -t "$1" @gl_session_id 2>/dev/null)" || stamped=""
  if [ -z "$stamped" ]; then
    tmux set-option -w -t "$1" @gl_session_id "$live" 2>/dev/null || return 1
    tmux set-option -uw -t "$1" @gl_session_mismatch 2>/dev/null || true
  elif [ "$stamped" != "$live" ]; then
    tmux set-option -w -t "$1" @gl_session_mismatch \
      "stamped '$stamped' != live '$live'" 2>/dev/null || true
    return 2
  else
    tmux set-option -uw -t "$1" @gl_session_mismatch 2>/dev/null || true
  fi
  return 0
}

send_identity_guard() { # a pane with a contradicted native identity may not speak
  local label="${1:-send}" mismatch registered collar
  [ -n "$SEND_WINDOW" ] || return 0
  registered="$(tmux show-options -wqv -t "$SEND_WINDOW" @gl_agent 2>/dev/null)" || registered=""
  collar="$(collar_read "$SEND_WINDOW")" || exit 1
  [ -n "$registered" ] && [ -n "$collar" ] \
    || refuse "$label: this pane has no registered Gangline agent/collar identity; a window name alone cannot attribute a message (gang whoami; then gang adopt <window-name> -c <collar>)"
  [ "$registered" = "$SEND_FROM" ] \
    || refuse "$label: this pane is registered as '$registered' but its window is named '$SEND_FROM'; refusing misattributed delivery (gang whoami)"
  mismatch="$(identity_mismatch_read "$SEND_WINDOW")" || return 0
  refuse "$label: this pane has a harness session identity mismatch ($mismatch); nothing from it can be attributed safely until that is resolved (gang whoami)"
}

PROSE="" PROSE_ERROR=""
prose_check() { # $1 path, $2 label, optional display path; populate PROSE or PROSE_ERROR
  local file="$1" label="$2" display="${3:-$1}" bytes without_nul marked sentinel=$'\034' probe rc
  PROSE="" PROSE_ERROR=""
  if ! { [ -f "$file" ] && [ -r "$file" ]; }; then
    PROSE_ERROR="$label $display exists but is not a readable regular file"
    return 1
  fi
  bytes="$(wc -c < "$file")" || {
    PROSE_ERROR="cannot read $label $display"
    return 1
  }
  without_nul="$(LC_ALL=C tr -d '\000' < "$file" | wc -c)" || {
    PROSE_ERROR="cannot read $label $display"
    return 1
  }
  if [ "$bytes" != "$without_nul" ]; then
    PROSE_ERROR="$label $display contains a NUL byte"
    return 1
  fi
  marked="$(cat "$file" || { rc=$?; exit "$rc"; }; printf '\034')" || {
    PROSE_ERROR="cannot read $label $display"
    return 1
  }
  case "$marked" in
    *"$sentinel") PROSE="${marked%"$sentinel"}" ;;
    *) PROSE_ERROR="internal: the prose sentinel was lost while reading $display"; return 1 ;;
  esac
  if ! python3 -c 'import sys; sys.stdin.buffer.read().decode("utf-8")' < "$file"; then
    PROSE_ERROR="$label $display is not valid UTF-8"
    return 1
  fi
  probe="$(printf '%s' "$PROSE" | tr -d '\11\12')"
  case "$probe" in
    *[[:cntrl:]]*)
      PROSE_ERROR="$label $display contains control characters other than tab and newline"
      return 1
      ;;
  esac
}

prose_read() { # $1 path, $2 label, optional display path; populate PROSE or fail
  prose_check "$1" "$2" "${3:-$1}" || die "$PROSE_ERROR"
}

DOCTRINE=""
doctrine_read() { # populate DOCTRINE from the ambient operator prose slot
  local file="$CONFIG_DIR/DOCTRINE.md"
  DOCTRINE=""
  [ -e "$file" ] || [ -L "$file" ] || return 0
  prose_read "$file" "operator doctrine"
  DOCTRINE="$PROSE"
}

CONTRACT_FILE="" CONTRACT_BODY="" CONTRACT_SYSTEM=0
contract_file() { # -> winning contract path on stdout, operator first
  local file="$CONFIG_DIR/CONTRACT.md"
  if [ -e "$file" ] || [ -L "$file" ]; then
    printf '%s' "$file"
    return 0
  fi
  printf '%s' "$ROOT/CONTRACT.md"
}

# Never pasted into a composer: the contract rides the collar's system-prompt
# option where one is declared, and is pointed at as a file where none is.
# Either way hitch proves the file present and prose. See docs/DECISIONS.md
# "The contract rides the system prompt where a collar has one".
contract_read() { # vet the contract slot, into CONTRACT_FILE and CONTRACT_BODY
  local display
  CONTRACT_FILE="$(contract_file)"
  display="$(config_path "$CONTRACT_FILE" | config_sanitize)"
  [ -e "$CONTRACT_FILE" ] || [ -L "$CONTRACT_FILE" ] \
    || die "the Gangline contract $display is missing, so a hitch has nothing to deliver; restore the shipped file or supply $CONFIG_DIR/CONTRACT.md"
  prose_read "$CONTRACT_FILE" "Gangline contract" "$display"
  [ -s "$CONTRACT_FILE" ] || die "the Gangline contract $display is empty"
  CONTRACT_BODY="$PROSE"
  CONTRACT_SYSTEM=0
  [ -z "$GANG_ROLE_PROMPT_OPT" ] || CONTRACT_SYSTEM=1
}

ROLE_NAME="" ROLE_FILE="" ROLE_BODY=""
SYSTEM_PROMPT=""

# One option carries both attachments rather than one option per attachment: a
# collar declares a single spelling, and passing it twice would be a guess about
# whether that harness concatenates or keeps the last one.
system_prompt_build() { # populate the system-prompt-level composite byte-exact
  local role path contract harness
  contract="$(config_path "$CONTRACT_FILE" | config_sanitize)"
  printf -v SYSTEM_PROMPT '%s\n%s\n%s\n%s\n%s\n%s\n%s\n\n--- Gangline contract (%s) ---\n%s' \
    'You are running inside a Gangline team. What follows was attached by' \
    'Gangline when this session launched: the contract every agent on this' \
    'team is held to, optional guidance from its harness collar, and a role brief' \
    'where this hitch named one. Operator doctrine, where the operator has any,' \
    'reaches you as part of your first' \
    'message; where that doctrine and anything below disagree, the doctrine' \
    'governs and this attachment yields to it. Nothing below overrides it.' \
    "$contract" "$CONTRACT_BODY"
  if [ -n "$GANG_HARNESS_PROMPT" ]; then
    harness="$(config_path "$GANG_COLLAR_FILE" | config_sanitize)"
    printf -v SYSTEM_PROMPT '%s\n--- harness guidance (%s) ---\n%s\n' \
      "$SYSTEM_PROMPT" "$harness" "$GANG_HARNESS_PROMPT"
  fi
  [ -n "$ROLE_NAME" ] || return 0
  role="$(printf '%s' "$ROLE_NAME" | config_sanitize)"
  path="$(config_path "$ROLE_FILE" | config_sanitize)"
  printf -v SYSTEM_PROMPT '%s\n--- role brief: %s (%s) ---\n%s' \
    "$SYSTEM_PROMPT" "$role" "$path" "$ROLE_BODY"
}

startup_brief() { # $1 = agent name, $2 = doctrine body or empty
  local role path contract
  contract="$(config_path "$CONTRACT_FILE" | config_sanitize)"
  if [ -n "$ROLE_NAME" ]; then
    role="$(printf '%s' "$ROLE_NAME" | config_sanitize)"
    path="$(config_path "$ROLE_FILE" | config_sanitize)"
  fi
  if [ "$CONTRACT_SYSTEM" -eq 1 ]; then
    # Gangline cannot verify that the launch option reached the model, so
    # name the recovery path if the attachment is absent.
    if [ -n "$ROLE_NAME" ]; then
      printf 'You are %s in Gangline. Your contract and your %s role brief are in your system prompt. If they are not, read %s and report that rather than improvising.' \
        "$1" "$role" "$contract"
    else
      printf 'You are %s in Gangline. Your contract is in your system prompt. If it is not, read %s and report that rather than improvising.' \
        "$1" "$contract"
    fi
  else
    printf 'You are %s in Gangline. Read %s now, before anything else: it is the standing contract for this team, Gangline checked it at hitch time, and reading it again is how you recover it after a compaction. If you cannot read that file, say so and stop rather than improvising the contract.' \
      "$1" "$contract"
    if [ -n "$ROLE_NAME" ]; then
      printf '\n\nYour role in this team is %s. Its brief follows; operator doctrine,\nwhere present, outranks it.\n\nRole brief (%s):\n\n%s' "$role" "$path" "$ROLE_BODY"
    fi
  fi
  if [ -n "$2" ]; then
    printf '\n\nOperator doctrine (%s):\n\n%s\n\nEnd this turn.' \
      "$(config_path "$CONFIG_DIR/DOCTRINE.md")" "$2"
  elif [ -n "$ROLE_NAME" ]; then
    printf '\n\nEnd this turn.'
  else
    printf ' End this turn.'
  fi
}

bare_name() { # $1 = a window name -> the bare agent name
  local n="$1" first last
  [ "${#n}" -ge 3 ] || { printf '%s' "$n"; return; }
  first="${n:0:1}"; last="${n: -1}"
  case "$first" in
    -|'~'|'!'|'?') [ "$first" = "$last" ] && n="${n:1:${#n}-2}" ;;
  esac
  printf '%s' "$n"
}

collar_read() { # $1 window id
  tmux show-options -wqv -t "$1" @gl_collar 2>/dev/null || true
}

# THE REGISTRATION IS THE IDENTITY; THE TITLE IS DECORATION. @gl_agent is what
# hitch and adopt wrote and nothing else changes. #W is a display name: tmux
# renames it on request from anyone with access to the server, and glyph_write
# rewrites it from @gl_agent on every state reading. A resolver that matched on
# #W could therefore be aimed at another lane's harness by a rename alone, and
# would paste, submit, verify and report success against it.
#
# So: a window answers to a name when its registration IS that name. A window
# with no registration at all still answers to its title, because that is the
# only thing adopt can address before it registers one. A title that
# contradicts a registration answers to nobody, and saying so is the whole
# point — silence there would leave 'no agent x' standing over a window that is
# somebody, which is the reading a person acts on next.
win_id() { # $1 = agent name -> @id; 1 absent, 2 ambiguous, 3 title of another identity
  local id name bare registered count=0 match="" raw_a="" raw_b="" claimed="" shown
  # SANITIZED WHERE IT IS PRINTED, NOT WHERE IT ARRIVES. Every resolution goes
  # through here, and the sanitizing pipeline is a subprocess: paying for it up
  # front charged the common path — a name that resolved — for a rendering only
  # the two refusals below ever use. Matching still happens against the raw
  # name, so what an agent registered is what it is addressed by.
  while read -r id name; do   # `read id name` keeps spaces in the name
    bare="$(bare_name "$name")"
    registered="$(tmux show-options -wqv -t "$id" @gl_agent 2>/dev/null)" || registered=""
    if [ -n "$registered" ]; then
      if [ "$registered" != "$1" ]; then
        [ "$bare" != "$1" ] || claimed="$registered"
        continue
      fi
    elif [ "$bare" != "$1" ]; then
      continue
    fi
    count=$((count + 1))
    [ "$count" -ne 1 ] || { match="$id"; raw_a="$name"; }
    [ "$count" -ne 2 ] || raw_b="$name"
  done < <(tmux list-windows -t "=$SESSION" -F '#{window_id} #W' 2>/dev/null)
  case "$count" in
    0) [ -n "$claimed" ] || return 1
       shown="$(printf '%s' "$1" | config_sanitize)"
       claimed="$(printf '%s' "$claimed" | config_sanitize)"
       printf "window '%s' is registered to Gangline agent '%s' in session '%s'; gang addresses an agent by the identity it registered, never by a window title, and will not act on '%s' through a window that is somebody else (gang roster).\n" \
         "$shown" "$claimed" "$SESSION" "$shown" >&2
       return 3 ;;
    1) printf '%s' "$match" ;;
    *) shown="$(printf '%s' "$1" | config_sanitize)"
       raw_a="$(printf '%s' "$raw_a" | config_sanitize)"
       raw_b="$(printf '%s' "$raw_b" | config_sanitize)"
       printf "'%s' is ambiguous in session '%s': windows %s and %s both address it. Rename one with gang rename.\n" \
         "$shown" "$SESSION" "$raw_a" "$raw_b" >&2
       return 2 ;;
  esac
}

win_id_missing() { # $1 = win_id status, $2 = not-found message
  # Only status 1 is absence. Everything above it is a reading gang could not
  # interpret, and win_id has already said which one on stderr.
  [ "$1" -eq 1 ] || exit 1
  die "$2"
}

exists() { win_id "$1" >/dev/null; return $?; }

self_window() { # -> the window id this process is running in; nonzero if not in one
  [ -n "${TMUX_PANE:-}" ] || return 1
  local pid wid
  while read -r pid wid; do
    [ "$pid" = "$TMUX_PANE" ] && { printf '%s' "$wid"; return 0; }
  done < <(tmux list-panes -s -t "=$SESSION" -F '#{pane_id} #{window_id}' 2>/dev/null)
  return 1
}

self_name() { # -> this window's agent name; nonzero outside a Gangline window
  local id
  id="$(self_window)" || return 1
  agent_name_of "$id"
}

AGENT_ID="" AGENT_COLLAR=""

resolve() { # $1 = agent name; sets AGENT_ID + AGENT_COLLAR and loads the collar
  local rc=0 registered
  AGENT_ID="$(win_id "$1")" || { rc=$?; win_id_missing "$rc" "no agent '$1' (see: gang roster)"; }
  registered="$(tmux show-options -wqv -t "$AGENT_ID" @gl_agent 2>/dev/null)" \
    || registered=""
  [ "$registered" = "$1" ] \
    || die "window '$1' exists but is not a registered Gangline agent (gang adopt $1 -c <collar>)"
  AGENT_COLLAR="$(collar_read "$AGENT_ID")" || exit 1
  [ -n "$AGENT_COLLAR" ] \
    || die "window '$1' exists but is not a gang agent (gang adopt $1 -c <collar>)"
  load_collar "$AGENT_COLLAR"
}

session_live() { # exit 0 if the team's session is running
  local err
  err="$(tmux has-session -t "=$SESSION" 2>&1)" && return 0
  case "$err" in
    ""|*"can't find session"*|*"session not found"*|*"no such session"*) return 1 ;;
    *"no server running"*) return 1 ;;
    *"error connecting to"*"No such file or directory"*) return 1 ;;
    *) die "cannot reach the tmux server — $err" ;;
  esac
}

CURFEW_AT=0 CURFEW_DECLARED=0
curfew_read() { # populate the team declaration; 1 = absent, 2 = unreadable
  local raw
  raw="$(tmux show-options -qv -t "=$SESSION:" @gl_curfew 2>/dev/null)" || raw=""
  CURFEW_AT=0 CURFEW_DECLARED=0
  [ -n "$raw" ] || return 1
  read -r CURFEW_AT CURFEW_DECLARED _ <<<"$raw"
  [[ "$CURFEW_AT" =~ ^[0-9]+$ && "$CURFEW_DECLARED" =~ ^[0-9]+$ ]] \
    && [ "$CURFEW_AT" -gt "$CURFEW_DECLARED" ] || return 2
}

CURFEW_PARSED=0
curfew_clock_epoch() { # $1 = HH:MM, $2 = now; print the next local occurrence
  python3 - "$1" "$2" <<'PY'
from datetime import date, timedelta
import sys
import time

hour, minute = map(int, sys.argv[1].split(":"))
now = int(sys.argv[2])
today = date.fromtimestamp(now)
for offset in (0, 1):
    day = today + timedelta(days=offset)
    target = int(time.mktime((day.year, day.month, day.day, hour, minute, 0, -1, -1, -1)))
    if target > now:
        print(target)
        break
PY
}

curfew_format_epoch() { # $1 = epoch; print it in local time
  python3 - "$1" <<'PY'
from datetime import datetime
import sys

print(datetime.fromtimestamp(int(sys.argv[1])).astimezone().strftime("%Y-%m-%d %H:%M %Z"))
PY
}

curfew_parse() { # $1 = duration or HH:MM, $2 = now; populate CURFEW_PARSED
  local spec="$1" now="$2" rest n unit seconds=0 target
  CURFEW_PARSED=0
  if [[ "$spec" =~ ^[0-9]{2}:[0-9]{2}$ ]]; then
    [[ "$spec" =~ ^([0-9]{2}):([0-9]{2})$ ]] || return 1
    [ "$((10#${BASH_REMATCH[1]}))" -lt 24 ] \
      && [ "$((10#${BASH_REMATCH[2]}))" -lt 60 ] || return 1
    target="$(curfew_clock_epoch "$spec" "$now")" || return 1
    [ -n "$target" ] || return 1
    CURFEW_PARSED="$target"
    return 0
  fi
  rest="$spec"
  while [[ "$rest" =~ ^([0-9]+)([hms])(.*)$ ]]; do
    n="$((10#${BASH_REMATCH[1]}))" unit="${BASH_REMATCH[2]}" rest="${BASH_REMATCH[3]}"
    case "$unit" in h) seconds=$(( seconds + n * 3600 )) ;;
      m) seconds=$(( seconds + n * 60 )) ;;
      s) seconds=$(( seconds + n )) ;;
    esac
  done
  [ -z "$rest" ] && [ "$seconds" -gt 0 ] || return 1
  CURFEW_PARSED=$(( now + seconds ))
}

human_seconds() { # $1 = non-negative seconds
  local left="$1" h m s out=""
  h=$(( left / 3600 )); m=$(( left % 3600 / 60 )); s=$(( left % 60 ))
  [ "$h" -eq 0 ] || out="${h}h"
  [ "$m" -eq 0 ] || out="${out:+$out }${m}m"
  [ "$s" -eq 0 ] && [ -n "$out" ] || out="${out:+$out }${s}s"
  printf '%s' "$out"
}

curfew_summary() { # $1 = now
  local left=$(( CURFEW_AT - $1 )) when
  when="$(curfew_format_epoch "$CURFEW_AT")"
  if [ "$left" -ge 0 ]; then
    printf 'curfew %s — %s remaining' "$when" "$(human_seconds "$left")"
  else
    printf 'curfew %s — %s past' "$when" "$(human_seconds $(( 0 - left )))"
  fi
}

capture() { tmux capture-pane -p -t "$1"; }

capture_joined() { tmux capture-pane -pJ -t "$1"; }

EXPLAINING=0
EXPLAIN_BUSY_RESULT=""
EXPLAIN_BUSY_FRAGMENT=""
EXPLAIN_OCCUPIED_RESULT=""
EXPLAIN_OCCUPIED_FRAGMENT=""
EXPLAIN_BRICKED_RESULT=""
EXPLAIN_BRICKED_CAUSE=""

explain_match_record() { # $1 collar variable, $2 grep verdict, $3 first matching line
  local variable="$1" verdict="$2" fragment="$3" result
  if [ "$verdict" -eq 0 ]; then result=matched; else result="did not match"; fi
  case "$variable" in
    GANG_BUSY_REGEX)
      # A match is final evidence. A later evaluation of the same rule may read
      # a different capture inside the same classification, but it must not
      # erase the fragment that actually established the positive predicate.
      [ "$EXPLAIN_BUSY_RESULT" != matched ] || return 0
      EXPLAIN_BUSY_RESULT="$result"
      [ "$verdict" -ne 0 ] || EXPLAIN_BUSY_FRAGMENT="$fragment"
      ;;
    GANG_OCCUPIED_REGEX)
      [ "$EXPLAIN_OCCUPIED_RESULT" != matched ] || return 0
      EXPLAIN_OCCUPIED_RESULT="$result"
      [ "$verdict" -ne 0 ] || EXPLAIN_OCCUPIED_FRAGMENT="$fragment"
      ;;
  esac
}

re_match() { # $1 = the collar variable NAME holding an ERE, $2 = text; 0 hit, 1 miss
  local re="${!1:-}" rc=0 fragment=""
  if [ "$EXPLAINING" -eq 1 ]; then
    fragment="$(grep -m1 -E -- "$re" <<<"$2")" || rc=$?
  else
    grep -qE -- "$re" <<<"$2" || rc=$?
  fi
  [ "$rc" -le 1 ] \
    || die "$1 in ${GANG_COLLAR_FILE:-<no collar loaded>} is not an ERE this grep can evaluate (grep exit $rc): '$re' — refusing to read an unevaluable marker as an absent one"
  [ "$EXPLAINING" -ne 1 ] || explain_match_record "$1" "$rc" "$fragment"
  return "$rc"
}

# THE ONE PLACE A COMPOSER READING IS CLASSIFIED, so that no caller has to
# remember the distinction on its own. A collar answers "there is no box here"
# and "I could not look" from the same failing capture, and every predicate
# downstream spends the answer as evidence: an absent box means idle, empty,
# unoccupied, settled — all of them positive findings about a pane nobody read.
#
# Status 3 is the collar contract's word for a refused read, and REPORTING IT IS
# THE COLLAR'S OBLIGATION, not something this function can perform on a collar's
# behalf. Where a collar answers 1 the pane is asked directly, and that probe
# says exactly one thing: a transport still refusing turns the absence back into
# an unknown. It cannot do the converse. A pane that answers here proves the
# transport is up NOW; the collar never parsed that reading, so it is no evidence
# about the read that already happened, and a refusal that healed in between is
# still reported as an absent box.
#
# WHAT THAT LEAVES, said plainly rather than papered over: with a collar that
# cannot report a refused read, a refusal that heals before this probe reaches
# the pane is spent as absence by the single-read predicates — occupancy, and
# the composer command. The predicate that spends absence as PERMISSION to type
# does not rest on it: composer_settled takes two looks and compares their
# statuses, so no one absence is enough there whoever wrote the collar.
input_read() { # $1 = window id; 0 box (printed), 1 no box,
               # 2 box clipped by the pane, 3 the pane could not be read,
               # 4 a composer that is drawn but is not this agent's to type in
  local box rc=0
  box="$(collar_input "$1")" || rc=$?
  # A COLLAR STATUS THAT MEANS SOMETHING IS NOT "NO BOX". 4 says the harness
  # drew a composer belonging to a selected in-process subagent: keys sent
  # there reach the child, so it refuses like an unreadable pane, but the
  # reason survives to the operator instead of being flattened into absence.
  case "$rc" in
    0) printf '%s' "$box"; return 0 ;;
    2|3|4) return "$rc" ;;
  esac
  capture "$1" >/dev/null 2>&1 || return 3
  return 1
}

composer_live() { # $1 = window id; 0 = the harness's own input box is on screen
                  # NOW, 1 = it is not, 3 = the pane could not be read
  declare -F collar_input >/dev/null || return 1
  local rc=0
  input_read "$1" >/dev/null || rc=$?
  case "$rc" in
    0) return 0 ;;
    3) return 3 ;;
    *) return 1 ;;
  esac
}

busy_painted() { # $1 = window id, collar loaded; exit 0 if a turn is visibly in flight
  [ -n "$GANG_BUSY_REGEX" ] || return 1
  local pane
  pane="$(capture_joined "$1")" || die "cannot read pane $1 — refusing to guess busy/idle"
  re_match GANG_BUSY_REGEX "$pane"
}

activity_hold_clear() { # $1 = window id; end any activity-only busy episode
  tmux set-option -uw -t "$1" @gl_activity_only_since 2>/dev/null \
    || die "cannot clear the activity-only bound on pane $1 — refusing to fabricate its state"
}

activity_stamp() { # $1 = window id; tmux's own clock of the last write to that pty
  local stamped
  stamped="$(tmux display-message -p -t "$1" '#{window_activity}' 2>/dev/null)" \
    || die "cannot read pty activity for pane $1 — refusing to consume unknown as inactive"
  case "$stamped" in
    ''|*[!0-9]*) die "tmux returned an unreadable activity stamp for pane $1: '$stamped'" ;;
  esac
  printf '%s' "$stamped"
}

# The stamp the last quiet verdict was actually MEASURED against, or empty when
# no measurement was taken. A collar that does not declare quiet-at-rest gets
# verdict 1 from a harness that writes constantly at rest, so that tier is
# abstaining, not reporting quiet — and nothing may spend an abstention as the
# positive evidence a decay requires.
ACTIVITY_AT=""

recently_active() { # $1 = window id; 0 = active, 1 = inactive, 2 = hold expired
  ACTIVITY_AT=""
  if [ "${GANG_QUIET_AT_REST:-}" != 1 ]; then
    activity_hold_clear "$1"
    return 1
  fi
  require_whole GANG_ACTIVITY_WINDOW "$GANG_ACTIVITY_WINDOW" seconds
  require_whole GANG_ACTIVITY_LIMIT "$GANG_ACTIVITY_LIMIT" seconds
  local stamped now since
  stamped="$(activity_stamp "$1")"
  now="$(date +%s)"
  [ "$stamped" -le "$now" ] \
    || die "tmux returned a future activity stamp for pane $1: $stamped > $now"
  ACTIVITY_AT="$stamped"
  if [ $(( now - stamped )) -ge "$GANG_ACTIVITY_WINDOW" ]; then
    activity_hold_clear "$1"
    return 1
  fi

  since="$(tmux show-options -wqv -t "$1" @gl_activity_only_since 2>/dev/null)" \
    || die "cannot read the activity-only bound for pane $1 — refusing to guess"
  case "$since" in
    ''|*[!0-9]*) since="" ;;
    *) [ "$since" -le "$now" ] || since="" ;;
  esac
  if [ -z "$since" ]; then
    tmux set-option -w -t "$1" @gl_activity_only_since "$now" 2>/dev/null \
      || die "cannot record the activity-only bound for pane $1 — refusing an unbounded busy state"
    since="$now"
  fi
  [ $(( now - since )) -lt "$GANG_ACTIVITY_LIMIT" ] && return 0
  return 2
}

TURN_STATE=""
TURN_AT=0
turn_state_read() { # $1 = window id; populate TURN_STATE/TURN_AT; 1 = absent, 2 = malformed
  local raw
  raw="$(tmux show-options -wqv -t "$1" @gl_turn 2>/dev/null)" || raw=""
  TURN_STATE=""; TURN_AT=0
  [ -n "$raw" ] || return 1
  read -r TURN_STATE TURN_AT _ <<<"$raw"
  case "$TURN_STATE" in
    open|closed) ;;
    *) TURN_STATE=""; return 2 ;;
  esac
  [[ "$TURN_AT" =~ ^[0-9]+$ ]] || { TURN_STATE=""; return 2; }
}

turn_state_write() { # $1 = window id, $2 = open|closed; the fact, stamped now
  tmux set-option -w -t "$1" @gl_turn "$2 $(date +%s)" 2>/dev/null || true
}

# Dropping the fact is a WRITER's edit, and `gang interrupt` is the only caller:
# it is what ended the turn, so it is entitled to say the bracket no longer
# describes anything. This was deleted once, for the right reason — a reader
# path was using it to repair a malformed value it had merely read, and a fresh
# hook stamp landing between that read and the unset would be erased. That
# reasoning binds readers, not the command holding the keystroke.
turn_state_clear() { tmux set-option -uw -t "$1" @gl_turn 2>/dev/null || true; }

# COMPACTION IS A BRACKET, FOR THE SAME REASON A TURN IS. A harness that is
# compacting will not accept input — it queues it — and gang used to learn that
# only by inference, because @gl_turn is closed throughout and the witness that
# reads it outranks the pane. Where a collar wires the native pair, the harness
# declares the state instead: PreCompact opens, PostCompact closes, and closing
# drains the spool exactly as Stop does. Collars that wire nothing keep the
# fallthrough behaviour and lose nothing.
compaction_state_write() { # $1 = window id, $2 = open|closed
  tmux set-option -w -t "$1" @gl_compaction "$2 $(date +%s)" 2>/dev/null || true
}

# A REFUSED COMPACTION RAISES PreCompact AND NEVER PostCompact, so the opening
# event cannot be trusted to be paired. claude-code declines a short session with
# "Not enough messages to compact" and pi with "Nothing to compact"; the bracket
# then stays open over an idle agent until it ages out, and every reader above it
# reports busy for that whole window.
#
# A turn event settles it, because taking a turn and compacting are mutually
# exclusive. Input typed into a compaction is PARKED, and the park raises nothing:
# driven on claude-code 2.1.227, an Enter 0.8s into a compaction produced
# UserPromptSubmit 38.6s later, immediately after PostCompact. So a turn event
# witnesses a harness that is not compacting, whether or not the compaction it
# followed ever finished.
compaction_state_settle() { # $1 = window id; a turn event proves nothing is compacting
  case "$(tmux show-options -wqv -t "$1" @gl_compaction 2>/dev/null)" in
    open*) compaction_state_write "$1" closed ;;
  esac
}

compaction_witness() { # $1 = window id; 0 compacting, 1 not, 2 bracket unusable
  local raw state at now
  raw="$(tmux show-options -wqv -t "$1" @gl_compaction 2>/dev/null)" || raw=""
  [ -n "$raw" ] || return 1
  read -r state at _ <<<"$raw"
  [ "$state" = open ] || return 1
  [[ "$at" =~ ^[0-9]+$ ]] || return 2
  now="$(date +%s)"
  # An open bracket whose close never arrived must not wedge the agent busy
  # forever, so it ages out on the same bound a turn does and hands the verdict
  # back to the tiers below. Degrading to today's behaviour is the safe
  # direction; staying busy on a stale fact is not.
  [ $(( now - at )) -lt "$GANG_TURN_LIMIT" ] || return 2
  return 0
}

agent_name_of() { # $1 = window id; its registered name, or its title if it has none
  # Same rule as win_id, read from the other end: the registration answers for
  # a window that has one. A window without one has only its title to give.
  #
  # SANITIZED, BECAUSE A REGISTRATION IS RAW BYTES. tmux escapes control
  # characters out of a window title — #W hands back \033 as six literal
  # characters — so the title was never a way to paint somebody's terminal.
  # An option value comes back exactly as written, so reading identity from
  # @gl_agent opened that door for every caller that prints one: whoami, the
  # delivery-lock refusals, mail, down's refusal, a stall body. Sanitizing at
  # the one function they all read through closes it in one place instead of
  # at each print, and leaves the next one safe too. Matching is unaffected:
  # win_id compares the option's bytes and never comes through here, so a
  # forged registration stays droppable and archivable under the name it
  # actually holds. What it loses is being addressable BY that name, which is
  # true of it already — nobody can type it.
  local registered name
  registered="$(tmux show-options -wqv -t "$1" @gl_agent 2>/dev/null)" || registered=""
  [ -z "$registered" ] || { printf '%s' "$registered" | config_sanitize; return; }
  name="$(tmux display-message -p -t "$1" '#W' 2>/dev/null)" \
    || { printf 'COULD-NOT-DETERMINE'; return; }
  bare_name "$name"
}

turn_pane_still_writing() { # $1 = window id; 0 = the pty is being written to now
  [ "${GANG_QUIET_AT_REST:-}" = 1 ] || return 1
  require_whole GANG_ACTIVITY_WINDOW "$GANG_ACTIVITY_WINDOW" seconds
  local stamped now
  stamped="$(tmux display-message -p -t "$1" '#{window_activity}' 2>/dev/null)" \
    || die "cannot read pty activity for pane $1 — refusing to consume unknown as a quiet pane"
  case "$stamped" in
    ''|*[!0-9]*) die "tmux returned an unreadable activity stamp for pane $1: '$stamped'" ;;
  esac
  now="$(date +%s)"
  [ "$stamped" -le "$now" ] || die "tmux returned a future activity stamp for pane $1: $stamped > $now"
  [ $(( now - stamped )) -lt "$GANG_ACTIVITY_WINDOW" ]
}

TURN_ABANDONED=0

turn_witness() { # $1 = window id; 0 busy, 1 idle, 2 could-not-determine, 3 no event tier
  local rc=0 now
  # Set only where a READABLE open bracket reached its bound: the one expiry
  # that says a turn began and its owner never spoke again. An unreadable
  # value, a future stamp, or a closed bracket under a written-to pane are all
  # could-not-determine for reasons that do not describe an abandoned turn, and
  # nothing may read them as one.
  TURN_ABANDONED=0
  turn_state_read "$1" || rc=$?
  case "$rc" in
    0) ;;
    1) return 3 ;;
    2) # Reported, never repaired: readers do not write @gl_turn. Clearing here
       # looked like hygiene and was a race one call deep — cmd_send reaches
       # this branch through busy(), native hooks write the bracket lock-free,
       # and an unset landing after a fresh hook stamp erases live evidence.
       # The unreadable verdict simply persists until the owner rewrites it.
       BUSY_EXPIRED_WHAT="turn-bracket value unreadable"
       return 2 ;;
    *) die "internal: turn_state_read returned unknown verdict $rc" ;;
  esac
  require_whole GANG_TURN_LIMIT "$GANG_TURN_LIMIT" seconds
  now="$(date +%s)"
  if [ "$TURN_STATE" != open ]; then
    [ $(( now - TURN_AT )) -ge "$GANG_TURN_LIMIT" ] || return 1
    turn_pane_still_writing "$1" || return 1
    BUSY_EXPIRED_WHAT="turn-bracket closed while the pane kept being written to"
    return 2
  fi
  [ "$TURN_AT" -le "$now" ] \
    || { BUSY_EXPIRED_WHAT="turn-bracket stamped in the future"; return 2; }
  [ $(( now - TURN_AT )) -lt "$GANG_TURN_LIMIT" ] \
    || { BUSY_EXPIRED_WHAT="turn-bracket bound reached"; TURN_ABANDONED=1; return 2; }
  return 0
}

BUSY_EXPIRED_WHAT="pty activity bound reached"

# Set when a decay was refused because the pane was being written to during the
# decision, and read by delivery, which may not spend that as ordinary
# could-not-determine.
BUSY_MOVED=0

decay_moved_note() {
  [ "$DECAY_MOVED" -eq 1 ] || return 0
  BUSY_MOVED=1
  BUSY_EXPIRED_WHAT="the pane was written to while gang was deciding"
}

composer_ready() { # $1 = window id; the harness's own box is on screen and empty
  composer_live "$1" && input_clear "$1"
}

# A decay reads several tiers one after another, and each read is a separate
# moment. Between them the harness may write — a turn that was merely quiet
# resuming — and the decay would then be assembled out of readings no single
# instant ever held, discarding a still-open native turn witness on the
# strength of it. Both witnesses here are immediate: tmux's own clock of the
# last write to that pty, and the bytes on screen. Taken before the tier reads
# and again after the last one, an unchanged pair is the positive evidence that
# nothing moved while gang was deciding. The clock's resolution is whole
# seconds, so the screen carries the sub-second half; the pty stamp a quiet
# verdict rests on is at least `GANG_ACTIVITY_WINDOW` old, which is why a write
# during the decision moves it at all.
#
# BOTH READS ARE CHECKED, AND NEITHER IS ASSEMBLED INSIDE THE ARGUMENTS OF A
# PRINTF. A substitution that fails there leaves the printf succeeding, and the
# witness comes out as an empty stamp beside the checksum of nothing — and two
# of those compare equal, so a pane nobody read certifies itself unmoved and a
# still-open turn decays to idle on the strength of it. Every caller is itself
# a command substitution, where die would exit only the subshell, so the
# refusal is reported upward and the callers are the ones that name it.
decay_witness() { # $1 = window id; 1 = a witness could not be taken
  local stamp sum
  stamp="$(activity_stamp "$1")" || return 1
  sum="$(capture_joined "$1" | cksum)" || return 1
  printf '%s %s' "$stamp" "$sum"
}

DECAY_MOVED=0

decay_allowed() { # $1 = window id, $2 = the witness pair taken before the tier reads
  DECAY_MOVED=0
  [ -n "$ACTIVITY_AT" ] || return 1   # the quiet was abstained, not measured
  local now
  now="$(decay_witness "$1")" \
    || die "cannot read pane $1 — refusing to witness a decay against a reading that was never taken"
  [ "$now" = "$2" ] && return 0
  # WHY this one failed has to survive. Every other road to
  # could-not-determine is an absence — a witness too old, a tier that never
  # answered — and absence is what the delivery fall-through exists to see
  # past. This is the opposite: gang watched the pane being written to while it
  # was deciding. That is presence, and nothing may spend it as absence.
  DECAY_MOVED=1
  return 1
}

busy() { # $1 = window id; 0 = busy, 1 = not busy, 2 = could not determine
  local turn_rc=0 undetermined=0 stale_turn=0 compaction_rc=0
  BUSY_EXPIRED_WHAT="pty activity bound reached"
  BUSY_MOVED=0
  # Asked FIRST, because it answers the question delivery actually has. An open
  # turn and an open compaction both mean "will not accept input now"; only the
  # second is invisible to @gl_turn, which stays closed for the whole of it.
  compaction_witness "$1" || compaction_rc=$?
  if [ "$compaction_rc" -eq 0 ]; then activity_hold_clear "$1"; return 0; fi
  turn_witness "$1" || turn_rc=$?
  case "$turn_rc" in
    0) activity_hold_clear "$1"; return 0 ;;
    1) activity_hold_clear "$1"; return 1 ;;
    2) undetermined=1; stale_turn="$TURN_ABANDONED" ;;
    3) ;;
    *) die "internal: turn_witness returned unknown verdict $turn_rc" ;;
  esac
  if busy_painted "$1"; then
    # A busy marker on the pane witnesses a live turn only while something
    # keeps it alive: a real turn repaints — spinners pulse, timers count.
    # When the turn bracket has EXPIRED, a matching line can be a fossil: an
    # Escape-interrupted turn leaves "Retrying in Ns" in the transcript
    # forever, and treating it as busy makes one interrupted turn a
    # permanently unreachable agent (issue #102). Demote to
    # could-not-determine only on the full conjunction — expired bracket, no
    # recent pty activity, byte-stable pane — so an animated or streaming
    # turn keeps its busy verdict. Snapshot readers keep the immediate
    # painted verdict: stability cannot be probed without the churn wait.
    if [ "$undetermined" -eq 1 ] && [ "${2:-}" != snapshot ]; then
      local fossil_rc=0
      recently_active "$1" || fossil_rc=$?
      if [ "$fossil_rc" -eq 1 ] && pane_stable "$1"; then
        BUSY_EXPIRED_WHAT="busy paint frozen on a static pane after $BUSY_EXPIRED_WHAT"
        return 2
      fi
    fi
    activity_hold_clear "$1"
    return 0
  fi
  local activity_rc=0 moved=""
  # BEFORE the activity tier, not after it. The quiet stamp recently_active
  # reads is itself one of the readings a decay is assembled from, so it has to
  # sit INSIDE the guarded interval: a write landing between that read and this
  # capture would otherwise be present in both witnesses, agree with itself, and
  # pass as if nothing had moved — the pty observed quiet at the instant it was
  # not.
  [ "$undetermined" -eq 0 ] \
    || moved="$(decay_witness "$1")" \
    || die "cannot read pane $1 — refusing to witness a decay against a reading that was never taken"
  recently_active "$1" || activity_rc=$?
  case "$activity_rc" in
    0) return 0 ;;
    1) ;;
    2) undetermined=1 ;;
    *) die "internal: recently_active returned unknown verdict $activity_rc" ;;
  esac
  # Abandoned-turn decay needs every leg: the bracket readable, open, and past
  # its bound (TURN_ABANDONED: an unreadable or future-stamped one is unknown,
  # not abandoned); nothing painting a turn; the pty past its quiet window
  # (measured, never assumed: only verdict 1 counts, an unknown one does not);
  # a byte-stable pane where the snapshot can afford the churn wait to look;
  # the harness's own input box on screen and provably empty; and — the leg
  # every path gets, including the snapshot that cannot afford the churn wait —
  # nothing having moved on the pty or the screen across the whole decision.
  # A decay refused because the pane MOVED is reported as its own thing,
  # because delivery has to treat it as its own thing: see BUSY_MOVED.
  case "${2:-}" in
    snapshot)
      local live_rc=0
      composer_live "$1" || live_rc=$?
      [ "$live_rc" -ne 3 ] \
        || die "cannot read the composer in pane $1 — refusing to guess busy/idle"
      if [ "$live_rc" -eq 0 ]; then
        if [ "$undetermined" -eq 1 ]; then
          if [ "$stale_turn" -eq 1 ] && [ "$activity_rc" -eq 1 ] && input_clear "$1"; then
            decay_allowed "$1" "$moved" && return 1
            decay_moved_note
          fi
          return 2
        fi
        return 1
      fi
      BUSY_EXPIRED_WHAT="no current busy witness or composer"
      return 2 ;;
  esac
  if pane_stable "$1"; then
    if [ "$undetermined" -eq 1 ]; then
      if [ "$stale_turn" -eq 1 ] && [ "$activity_rc" -eq 1 ] && composer_ready "$1"; then
        decay_allowed "$1" "$moved" && return 1
        decay_moved_note
      fi
      return 2
    fi
    return 1
  fi
  activity_hold_clear "$1"
  return 0
}

self_compact_after_stop() { # $1 window id, $2 collar
  local ready=0 boot="${GANG_BOOT_TIMEOUT:-30}" resume
  load_collar "$2"
  [ "$GANG_SELF_COMPACT" = deferred ] \
    || die "collar '$2' no longer declares deferred self-compaction"
  [ -n "$GANG_COMPACT_CMD" ] \
    || die "collar '$2' declares no compact command"
  require_whole GANG_BOOT_TIMEOUT "$boot" seconds
  wait_ready "$1" "$boot" || ready=$?
  # NOT AT THIS BOUNDARY, rather than not at all: a dialog on the screen and a
  # composer that has not come back are both states the next boundary may not
  # be in, so they refuse (status 3) and leave the request standing, exactly as
  # spool_drain_after_event leaves its messages spooled. Only a collar that has
  # stopped declaring this path is fatal, because no later boundary repairs it.
  case "$ready" in
    0) ;;
    2) refuse "a dialog owns the screen after the turn ended" ;;
    *) refuse "the input box did not become ready after the turn ended" ;;
  esac
  resume="$(tmux show-options -wqv -t "$1" @gl_self_compact_resume 2>/dev/null)" \
    || resume=""
  # One lock across both, so nothing lands between the compaction and the turn
  # that follows it.
  lock_pane "$1"
  inject "$1" "$(compact_command)" head locked
  compact_continue "$1" "$resume"
  lock_release
  tmux set-option -uw -t "$1" @gl_self_compact_resume 2>/dev/null || true
}

compact_continue() { # $1 window id, $2 the agent's continuation or empty; caller holds the lock
  envelope gangline "$(compact_resume "$2")"
  inject "$1" "$ENVELOPE" '' locked queued
}

# WHAT A COMPACTION IS TOLD TO KEEP. A summary chosen without instruction keeps
# what reads as important, which is not the same as what a lane needs to
# continue: the brief, the durable state already written down, and what is
# still outstanding. Driven on claude-code 2.1.226 — a summary instructed to
# keep a lane name and a build number kept both, and dropped the one fact it
# was told to omit while retaining an unrelated one, so instructions are
# honoured rather than merely carried.
#
# Nothing here tells the agent to act — after a compaction the
# harness leaves it idle with an empty composer, and no instruction to the
# SUMMARISER can change that. What to do next is the agent's, and CONTRACT.md
# is where it is told.
#
# Only a collar that declares the slot gets this. claude-code's /compact takes
# instructions; codex's has not been driven, so codex declares a bare command
# and gang appends nothing to it rather than typing text at a harness that may
# not read it.
GANG_COMPACT_KEEP='Keep the brief you were given, the durable state you have already written down, and what is still outstanding in your lane, including anything you were asked to report.'

compact_command() { # the collar's compact command with its instruction slot filled
  case "$GANG_COMPACT_CMD" in
    *'{{instructions}}'*)
      printf '%s' "${GANG_COMPACT_CMD//'{{instructions}}'/$GANG_COMPACT_KEEP}" ;;
    *) printf '%s' "$GANG_COMPACT_CMD" ;;
  esac
}

# THE TURN A COMPACTION LANDS ON. Typed behind the compaction command: a
# compacting harness parks it and submits it when the compaction ends, and a
# harness that refused the compaction takes it now. Orientation, never direction —
# "continue working" would make a finished agent invent work.
GANG_COMPACT_RESUME='Your context was just compacted. Re-read your brief and the durable state you wrote. Then either resume your lane or report it complete.'

compact_resume() { # $1 = the agent's own continuation, if it supplied one
  printf '%s' "${1:-$GANG_COMPACT_RESUME}"
}

# THE AGENT ASKED, SO THE AGENT IS TOLD. cmd_compact prints a promise into the
# agent's own context, and a failure recorded only in a tmux option answers the
# operator's roster and never the agent — which ends its turn and goes idle
# believing it compacted. An idle agent raises no boundary of its own, so a
# retry alone cannot reach it. The spool is the channel that does: it is where
# an undeliverable peer message already waits, and it carries this one to the
# same next boundary.
#
# SELF_COMPACT_STANDING is the suffix marking a recorded failure as one the
# dispatcher still owns. The request token recorded in @gl_self_compact_noted
# is the episode identity; wording is not state.
SELF_COMPACT_STANDING='(still scheduled; gang retries at the next turn boundary)'

self_compact_failed_pending_write() { # $1 window, $2 token, $3 reason
  tmux set-option -w -t "$1" @gl_self_compact_failed \
    "[request:$2] $3 $SELF_COMPACT_STANDING" 2>/dev/null || true
}

self_compact_failed_read() { # $1 window -> only a failure current for its state
  local failed token pending
  failed="$(tmux show-options -wqv -t "$1" @gl_self_compact_failed 2>/dev/null)" \
    || failed=""
  case "$failed" in
    '[request:'*'] '*"$SELF_COMPACT_STANDING")
      token="${failed#\[request:}"
      token="${token%%]*}"
      case "$token" in ''|*[!A-Za-z0-9._:-]*) printf '%s' "$failed"; return ;; esac
      pending="$(tmux show-options -wqv -t "$1" @gl_self_compact_requested 2>/dev/null)" \
        || pending=""
      [ -n "$pending" ] \
        || pending="$(tmux show-options -wqv -t "$1" @gl_self_compact_dispatching 2>/dev/null)"
      [ "$pending" = "$token" ] || return 0 ;;
  esac
  printf '%s' "$failed"
}

self_compact_note() { # $1 window id, $2 the attempt's last line, $3 rescheduled|dropped
  local name body
  name="$(agent_name_of "$1")"
  spool_available "$1" "$name" || return 1
  # WORDED FOR AN ARRIVAL LATER THAN ITS CAUSE. A spooled note waits for a turn
  # boundary, and a boundary is also where a retry succeeds — so a note that
  # said "your context was NOT compacted" could be read by an agent whose
  # context had since been compacted, which is the same lie in the other
  # direction. Each of these reports only what was true at the boundary it
  # names, and sends the agent to the state rather than asserting it.
  case "$3" in
    rescheduled) body="A self-compaction you scheduled did not run at a turn boundary: $2 It was put back rather than dropped, so gang retries it on a later cooperative tick or native boundary. Run gang status to see whether it is still pending." ;;
    *) body="A self-compaction you scheduled did not run and was NOT put back: $2 Your context was not compacted at that boundary and nothing will retry it. Run gang status, then gang compact again." ;;
  esac
  envelope gangline "$body"
  spool_write "$1" gangline "$ENVELOPE" "self-compaction did not run"
}

self_compact_claim_failed() { # $1 window, $2 request token, $3 claim diagnostic
  local why="$3"
  [ -n "$why" ] || why="the claim mechanism returned no diagnostic"
  # WITHOUT A CLAIM, MUTATE NO REQUEST STATE. Compare-then-unset is not a
  # transaction: a delayed failure worker could read its old token, a new
  # request could replace it, and that worker would then delete the successor.
  # The exact failed token in this record makes the history truthful while the
  # standing request remains retryable after the lock fault is repaired.
  why="could not establish the self-compaction claim: $why No compaction command was submitted at this boundary."
  self_compact_failed_pending_write "$1" "$2" "$why"
  tmux wait-for -S "gang-self-compact-$2" 2>/dev/null || true
}

# POSSIBLY REDUNDANT WITH THE COMPACTION BRACKET, AND DELIBERATELY STILL HERE.
# This flag exists because gang had no other way to know a self-compaction was
# in flight. Where a collar wires PreCompact/PostCompact it now does — and
# deferred self-compaction was watched raising both — so on those collars this
# path may cover nothing the bracket does not. It stays until something
# demonstrates that rather than argues it: the two overlap on a collar that
# declares the pair and NOT on one that does not, so removing it would quietly
# change behaviour for every harness declaring less. Answer it by driving a
# deferred self-compaction with the bracket wired and watching what each one
# contributes, not by reading this comment and agreeing with it.
self_compact_run() ( # $1 window, $2 collar, $3 exact request token
  local win="$1" request="$3"
  # The compaction delivers, and delivery serializes on the WINDOW's lock, for
  # the same reason spool_event receives the resolved window before draining:
  # a lock named after the firing pane would not exclude an ordinary send
  # holding the one named after its window. The spool this falls back to is
  # keyed by window as well.
  [ -n "$win" ] || return 0
  [ -n "$request" ] || return 0
  trap '' HUP INT TERM
    # A REQUEST TOKEN IS THE EPISODE IDENTITY. Two Stop hooks can cross before
    # either clears the option, and tmux offers no compare-and-set. Claiming the
    # token in the worker makes one process own the read-decide-write sequence;
    # a later boundary can retry the same token after this claim is released,
    # while a concurrent worker can neither compact twice nor restore a request
    # after its peer already completed it.
    # This worker belongs to the token its Stop observed above. It must never
    # substitute a successor request that appeared while the detached worker
    # was waiting to run.
    [ "$(tmux show-options -wqv -t "$win" @gl_self_compact_requested 2>/dev/null)" = "$request" ] \
      || exit 0
    local claim_state=establishing claim_rc=0
    # lock_self_pid can itself terminate while establishing a claim. Until the
    # claim primitive has classified its result, make even that path record the
    # failed boundary while leaving the request scheduled rather than silent.
    trap 'if [ "$claim_state" = establishing ]; then
            trap - EXIT
            self_compact_claim_failed "$win" "$request" "${EVENT_CLAIM_ERROR:-the worker exited while establishing its process identity}"
          fi' EXIT
    event_claim self-compact "$win" "$request" || claim_rc=$?
    case "$claim_rc" in
      0) claim_state=claimed ;;
      1) claim_state=contended; trap - EXIT; exit 0 ;;
      *) claim_state=reported; trap - EXIT
         self_compact_claim_failed "$win" "$request" "$EVENT_CLAIM_ERROR"
         exit 0 ;;
    esac
    # The request may have been consumed between the optimistic read above and
    # this claim. Only the exact token still standing belongs to this worker.
    [ "$(tmux show-options -wqv -t "$win" @gl_self_compact_requested 2>/dev/null)" = "$request" ] \
      || { event_claim_release; exit 0; }
    # THE CLEANUP RUNS EVEN WHEN THIS WORKER DOES NOT REACH ITS END. The script
    # runs under set -e and the request is consumed below, so any
    # command here that exits non-zero — loading the collar, naming the agent,
    # establishing a spool — would otherwise leave @gl_self_compact_dispatching
    # standing with nothing left to clear it. Every later self-compaction would
    # then refuse as already waiting, for a turn boundary that can no longer act
    # on it, and the barrier's waiter would never be released.
    trap 'tmux set-option -uw -t "$win" @gl_self_compact_dispatching 2>/dev/null || true
          event_claim_release
          tmux wait-for -S "gang-self-compact-$request" 2>/dev/null || true' EXIT
    tmux set-option -w -t "$win" @gl_self_compact_dispatching "$request" 2>/dev/null \
      || exit 0
    tmux set-option -uw -t "$win" @gl_self_compact_requested 2>/dev/null || true
    local err="" rc=0 noted=""
    load_collar "$2" || true
    err="$(self_compact_after_stop "$win" "$2" 2>&1)" || rc=$?
    err="${err##*$'\n'}"
    case "$rc" in
      0) tmux set-option -uw -t "$win" @gl_self_compact_failed 2>/dev/null || true
         tmux set-option -uw -t "$win" @gl_self_compact_noted 2>/dev/null || true ;;
      # A REFUSAL IS "NOT AT THIS BOUNDARY", NEVER "NOT AT ALL" — the same
      # reading spool_drain_dispatch already gives status 3. The composer
      # belonged to somebody else for the moment gang looked at it, and an
      # operator mid-reply is the ordinary case at a Stop, which is exactly
      # when a deferred compaction fires: the window where it is most needed
      # is the window where it is most likely to be refused. Consuming the
      # request there dropped the work permanently and told no one.
      3) tmux set-option -w -t "$win" @gl_self_compact_requested "$request" 2>/dev/null \
           || true
         [ -n "$err" ] || err="the composer was not gang's to type into."
         # ONE NOTE PER EPISODE, NOT ONE PER BOUNDARY. The note itself becomes
         # a message that drains at the next boundary, and draining it is a
         # delivery this dispatcher can lose the lock to — so notifying on
         # every deferral would spool a fresh note for the boundary the last
         # note created, without bound. The transition into the deferred state
         # is what the agent needs; the retries after it are gang's business.
         noted="$(tmux show-options -wqv -t "$win" @gl_self_compact_noted 2>/dev/null)" \
           || noted=""
         self_compact_failed_pending_write "$win" "$request" "$err"
         if [ "$noted" != "$request" ] \
            && self_compact_note "$win" "$err" rescheduled; then
           tmux set-option -w -t "$win" @gl_self_compact_noted "$request" 2>/dev/null || true
         fi ;;
      *) [ -n "$err" ] || err="self-compaction dispatcher failed"
         tmux set-option -w -t "$win" @gl_self_compact_failed "$err" 2>/dev/null || true
         tmux set-option -uw -t "$win" @gl_self_compact_noted 2>/dev/null || true
         self_compact_note "$win" "$err" dropped || true ;;
    esac
)

self_compact_dispatch() { # $1 window, $2 collar, optional $3 = sync
  local win="$1" request
  [ -n "$win" ] || return 0
  request="$(tmux show-options -wqv -t "$win" @gl_self_compact_requested 2>/dev/null)" \
    || request=""
  [ -n "$request" ] || return 0
  if [ "${3:-}" = sync ]; then
    self_compact_run "$win" "$2" "$request" </dev/null >/dev/null 2>&1
    return 0
  fi
  ( self_compact_run "$win" "$2" "$request" ) </dev/null >/dev/null 2>&1 &
  disown
}

self_compact_request() { # $1 window id -> request token
  local request dispatch token
  request="$(tmux show-options -wqv -t "$1" @gl_self_compact_requested 2>/dev/null)" \
    || request=""
  dispatch="$(tmux show-options -wqv -t "$1" @gl_self_compact_dispatching 2>/dev/null)" \
    || dispatch=""
  [ -z "$request$dispatch" ] \
    || die "self-compaction is already waiting for this turn to end"
  token="$(mint_nonce)"
  tmux set-option -uw -t "$1" @gl_self_compact_failed 2>/dev/null || true
  tmux set-option -uw -t "$1" @gl_self_compact_noted 2>/dev/null || true
  tmux set-option -w -t "$1" @gl_self_compact_requested "$token" \
    || die "could not record the self-compaction request"
  printf '%s' "$token"
}

OCCUPY_STATE=""
OCCUPY_AT=0

occupied_raise_read() { # $1 = window id; sets OCCUPY_*; 1 = absent, 2 = malformed
  local raw extra
  raw="$(tmux show-options -wqv -t "$1" @gl_occupied 2>/dev/null)" || raw=""
  OCCUPY_STATE=""; OCCUPY_AT=0
  [ -n "$raw" ] || return 1
  read -r OCCUPY_STATE OCCUPY_AT extra <<<"$raw"
  [ "$OCCUPY_STATE" = open ] || { OCCUPY_STATE=""; return 2; }
  [[ "$OCCUPY_AT" =~ ^[0-9]+$ ]] || { OCCUPY_STATE=""; OCCUPY_AT=0; return 2; }
  [ -z "$extra" ] || { OCCUPY_STATE=""; OCCUPY_AT=0; return 2; }
}

occupied_raise_write() { # $1 = window id; never fatal (law 7)
  tmux set-option -w -t "$1" @gl_occupied "open $(date +%s)" 2>/dev/null || true
}

occupied_raise_clear() { tmux set-option -uw -t "$1" @gl_occupied 2>/dev/null || true; }

occupied_witness() { # $1 = window id; 0 = the event tier answers occupied
  local rc=0 live_rc=0
  occupied_raise_read "$1" || rc=$?
  case "$rc" in
    0) ;;
    1) return 1 ;;
    2) die "$(agent_name_of "$1") carries malformed @gl_occupied evidence — inspect it, then clear with: tmux set-option -uw -t '$1' @gl_occupied" ;;
    *) die "internal: occupied_raise_read returned unknown verdict $rc" ;;
  esac
  # THE RAISE IS RETIRED BY THE BOX COMING BACK, so a pane that cannot be read
  # retires nothing — and equally proves nothing about the UI that raised it.
  # Reporting occupied here would spend a refused read as the evidence that a
  # dialog is still up, which is the same invention as reporting idle.
  composer_live "$1" || live_rc=$?
  [ "$live_rc" -ne 3 ] \
    || die "cannot read the composer in pane $1 — refusing to guess whether the UI that took it is still there"
  if [ "$live_rc" -eq 0 ]; then
    occupied_raise_clear "$1"
    return 1
  fi
  return 0
}

occupied() { # $1 = window id, collar loaded; exit 0 if a UI owns the input box
  if occupied_witness "$1"; then return 0; fi
  local pane live_rc=0 painted_rc=0 turn_rc=0
  # PermissionRequest remains stronger above. During a cooperative retry, a
  # readable closed turn from a hook-enabled collar outranks old transcript
  # paint that happens to match the occupied-menu regex. Ordinary state reads
  # retain the screen classification; only the retry pass spends this fact.
  if [ "${TICK_PASS:-0}" = 1 ] && [ "${GANG_STOP_HOOK:-}" = 1 ]; then
    turn_witness "$1" || turn_rc=$?
    [ "$turn_rc" -ne 1 ] || return 1
  fi
  if [ -n "${GANG_OCCUPIED_REGEX:-}" ]; then
    pane="$(capture_joined "$1")" || die "cannot read pane $1 — refusing to guess occupancy"
    if re_match GANG_OCCUPIED_REGEX "$pane"; then
      composer_live "$1" || live_rc=$?
      [ "$live_rc" -ne 3 ] \
        || die "cannot read the composer in pane $1 — refusing to guess occupancy"
      [ "$live_rc" -eq 0 ] || return 0
    fi
  fi
  # AN UNREADABLE BOX IS NOT AN ABSENT ONE, and absence is what this line
  # spends: no box drawn falls through to the busy tier, where a collar that
  # declares no busy marker answers "not busy" without reading anything and
  # the negation turns that into a UI owning the screen. On a live, healthy
  # agent that is a state gang invented out of a read it never took.
  input_painted "$1" || painted_rc=$?
  [ "$painted_rc" -ne 3 ] \
    || die "cannot read the composer in pane $1 — refusing to guess occupancy"
  [ "$painted_rc" -ne 0 ] || return 1
  ! busy_painted "$1"
}

# WHAT OWNS THE SCREEN, BY NAME. A native dialog painted over a live composer
# swallows delivery, and until now the loudest thing gang could say was that the
# box read back unchanged — accurate, and no help: that a dialog was there at
# all, and that answering it is the repair, was discoverable only by experiment.
# A collar that can recognise its harness chrome supplies the title, and the
# refusal quotes it.
#
# IT DECIDES NOTHING. Occupancy and readability are already settled by the time
# this is asked, so a collar that declares no reader, a pane that cannot be read
# and a frame nothing recognises all cost one sentence rather than a delivery.
# That is also why an unreadable pane returns quietly here while the same read
# elsewhere refuses: this is the naming pass, not the deciding one.
overlay_title() { # $1 = window id, collar loaded; print an overlay dialog's
                  # visible title, 1 = none to name
  local out rc=0
  declare -F collar_overlay >/dev/null || return 1
  out="$(collar_overlay "$1")" || rc=$?
  case "$rc" in
    0) out="$(printf '%s' "$out" | config_sanitize)"
       [ -n "$out" ] \
         || die "collar_overlay in $GANG_COLLAR_FILE reported an overlay dialog without naming it"
       printf '%s' "$out" ;;
    1|3) return 1 ;;
    *) die "collar_overlay in $GANG_COLLAR_FILE returned unknown verdict $rc" ;;
  esac
}

overlay_note() { # $1 = window id, collar loaded -> a clause naming the dialog, or nothing
  local title
  title="$(overlay_title "$1")" || return 0
  printf " A native dialog titled '%s' is on that screen and owns its input, so answer it first: 'gang attach' and reply to it, or 'gang interrupt' to send the harness's own cancel key — which answers whatever is up, so read it before spending it." "$title"
}

BRICKED_WHAT="fatal-turn cause unavailable"

bricked() { # $1 window, collar loaded; 0 fatal, 1 absent, 2 unknown
  local output="" rc=0
  BRICKED_WHAT="fatal-turn cause unavailable"
  declare -F collar_bricked >/dev/null || return 1
  output="$(collar_bricked "$1")" || rc=$?
  output="$(printf '%s' "$output" | config_sanitize)"
  case "$rc" in
    0)
      [ -n "$output" ] \
        || die "collar_bricked in $GANG_COLLAR_FILE reported a fatal turn without a cause"
      BRICKED_WHAT="$output"
      if [ "$EXPLAINING" -eq 1 ]; then
        EXPLAIN_BRICKED_RESULT=matched
        EXPLAIN_BRICKED_CAUSE="$output"
      fi
      return 0 ;;
    1)
      [ -z "$output" ] \
        || die "collar_bricked in $GANG_COLLAR_FILE printed a cause while reporting no fatal turn"
      [ "$EXPLAINING" -ne 1 ] || EXPLAIN_BRICKED_RESULT="did not match"
      return 1 ;;
    2)
      [ -n "$output" ] \
        || die "collar_bricked in $GANG_COLLAR_FILE reported unknown without a cause"
      BRICKED_WHAT="$output"
      if [ "$EXPLAINING" -eq 1 ]; then
        EXPLAIN_BRICKED_RESULT="could not determine"
        EXPLAIN_BRICKED_CAUSE="$output"
      fi
      return 2 ;;
    *) die "collar_bricked in $GANG_COLLAR_FILE returned unknown verdict $rc" ;;
  esac
}

WAITING_WHAT="background-work witness unavailable"

waiting_read() { # $1 window -> 0 waiting, 1 absent, 2 unknown; sets WAITING_WHAT
  local record kind what
  WAITING_WHAT="background-work witness unavailable"
  record="$(tmux show-options -wqv -t "$1" @gl_waiting 2>/dev/null)" || record=""
  [ -n "$record" ] || return 1
  IFS=$'\t' read -r kind what <<<"$record"
  case "$kind" in
    waiting)
      [ -n "$what" ] || { WAITING_WHAT="the stored waiting witness is empty"; return 2; }
      WAITING_WHAT="$what"
      return 0 ;;
    unknown)
      [ -n "$what" ] || what="the stored waiting probe failure has no cause"
      WAITING_WHAT="$what"
      return 2 ;;
    *) WAITING_WHAT="the stored waiting witness has an unknown verdict"; return 2 ;;
  esac
}

waiting_clear() { # $1 window; a new native event retires the old Stop witness
  tmux set-option -uw -t "$1" @gl_waiting 2>/dev/null || true
}

waiting_refresh() { # $1 window, $2 collar, $3 Stop payload; cache one bounded probe
  local raw="" header="" output="" rc=0 source="collar '$2'"
  # CONTAIN THE OPTIONAL RELOAD. Stop's universal turn boundary has always
  # survived a collar removed after hitch; a derived-state reader cannot make
  # that boundary depend on the file still existing. Capturing stderr also
  # keeps a malformed load distinct from a clean absent verdict below.
  raw="$( {
    load_collar "$2"
    if declare -F collar_waiting >/dev/null; then
      printf 'declared:'
      collar_waiting "$1" "$3"
    else
      printf 'absent:'
    fi
  } 2>&1)" || rc=$?
  header="${raw%%:*}"
  if [ "$header" = absent ] && [ "$rc" -eq 0 ]; then
    waiting_clear "$1"
    return 0
  fi
  if [ "$header" = declared ]; then
    output="${raw#*:}"
  else
    output="$raw"
    rc=2
  fi
  output="$(printf '%s' "$output" | config_sanitize)"
  case "$rc" in
    0)
      if [ -n "$output" ]; then
        tmux set-option -w -t "$1" @gl_waiting "waiting"$'\t'"$output" 2>/dev/null || true
      else
        tmux set-option -w -t "$1" @gl_waiting \
          "unknown"$'\t'"collar_waiting in $source reported held background work without naming its witness" \
          2>/dev/null || true
      fi ;;
    1)
      if [ -n "$output" ]; then
        tmux set-option -w -t "$1" @gl_waiting \
          "unknown"$'\t'"collar_waiting in $source printed a witness while reporting no held background work" \
          2>/dev/null || true
      else
        waiting_clear "$1"
      fi ;;
    2)
      [ -n "$output" ] || output="collar_waiting in $source reported unknown without a cause"
      tmux set-option -w -t "$1" @gl_waiting "unknown"$'\t'"$output" 2>/dev/null || true ;;
    *) tmux set-option -w -t "$1" @gl_waiting \
         "unknown"$'\t'"collar_waiting in $source returned unknown verdict $rc" \
         2>/dev/null || true ;;
  esac
}

# WHAT AN AGENT HAS ACTUALLY DONE, AS TWO AGES AND NO VERDICT. A delivery can be
# verified into a pane and a turn can open and close without the recipient ever
# running a command; roster read healthy through three hours of exactly that.
# The two facts that separate a working agent from a talking one are when it
# last ran a tool and when its terminal last moved, and neither is a health
# state: a long build and a wedge both go quiet, so gang prints the ages and
# leaves the judgement to the reader. What gang will not do is let a source it
# could not read pass as an agent that has done nothing.
ACTION_KIND=""   # at | before | none | unknown
ACTION_AGE=""    # seconds, when ACTION_KIND is at or before
ACTION_WHAT=""   # the collar's reason, when ACTION_KIND is unknown

last_action_read() { # $1 window, collar loaded; ACTION_* set, never fatal
  local output="" rc=0 kind stamp now
  ACTION_KIND=unknown ACTION_AGE="" ACTION_WHAT="this collar declares no tool-call source"
  declare -F collar_last_action >/dev/null || return 0
  output="$(collar_last_action "$1")" || rc=$?
  output="$(printf '%s' "$output" | config_sanitize)"
  case "$rc" in
    0) ;;
    1) ACTION_KIND=none ACTION_WHAT=""
       [ -z "$output" ] \
         || die "collar_last_action in $GANG_COLLAR_FILE printed '$output' while reporting no tool call"
       return 0 ;;
    2) ACTION_KIND=unknown
       [ -n "$output" ] \
         || die "collar_last_action in $GANG_COLLAR_FILE reported unknown without a reason"
       ACTION_WHAT="$output"
       return 0 ;;
    *) die "collar_last_action in $GANG_COLLAR_FILE returned unknown verdict $rc" ;;
  esac
  read -r kind stamp <<<"$output"
  case "$kind" in
    at|before) ;;
    *) die "collar_last_action in $GANG_COLLAR_FILE answered '$output', which names neither 'at' nor 'before'" ;;
  esac
  case "$stamp" in
    ''|*[!0-9]*) die "collar_last_action in $GANG_COLLAR_FILE answered '$output', whose time is not a whole number of seconds" ;;
  esac
  now="$(date +%s)"
  # A SOURCE STAMPED IN THE FUTURE IS NOT AN AGENT THAT ACTED A MOMENT AGO. The
  # clock disagreement is the finding; consuming it as a fresh tool call would
  # report the healthiest possible reading from the least trustworthy evidence.
  [ "$stamp" -le "$now" ] || {
    ACTION_KIND=unknown
    ACTION_WHAT="the collar timed the last tool call $(( stamp - now ))s in the future"
    return 0
  }
  ACTION_KIND="$kind"
  ACTION_AGE=$(( now - stamp ))
}

pane_write_age() { # $1 = window id; seconds since the pty last moved; 1 = unreadable
  local stamped now
  stamped="$(tmux display-message -p -t "$1" '#{window_activity}' 2>/dev/null)" || return 1
  case "$stamped" in ''|*[!0-9]*) return 1 ;; esac
  now="$(date +%s)"
  [ "$stamped" -le "$now" ] || return 1
  printf '%s' $(( now - stamped ))
}

compact_seconds() { # $1 = seconds -> the same reading with no spaces in it
  local out
  out="$(human_seconds "$1")"
  printf '%s' "${out// /}"
}

action_detail() { # $1 = window, collar loaded -> roster tokens for its evidence
  local age
  last_action_read "$1"
  case "$ACTION_KIND" in
    at) printf 'last-tool=%s' "$(compact_seconds "$ACTION_AGE")" ;;
    before) printf 'last-tool>%s' "$(compact_seconds "$ACTION_AGE")" ;;
    none) printf 'last-tool=none' ;;
    # THE PANE CLOCK ONLY WHERE IT IS THE LAST EVIDENCE LEFT. tmux's activity
    # stamp moves for a spinner as readily as for work, so it is not shown
    # beside a tool-call age it would only dilute. Where the collar could not
    # answer, it is the whole of what gang has.
    *) age="$(pane_write_age "$1")" \
         && printf 'last-tool=? last-write=%s' "$(compact_seconds "$age")" \
         || printf 'last-tool=? last-write=?' ;;
  esac
}

pane_stable() { # $1 = window id; screen byte-identical across two captures ≈ quietly idle
  local a b
  require_interval GANG_CHURN_WAIT "$GANG_CHURN_WAIT"
  a="$(capture "$1")" || die "cannot read pane $1"
  sleep "$GANG_CHURN_WAIT"
  b="$(capture "$1")" || die "cannot read pane $1"
  [ "$a" = "$b" ]
}

boot_prompt_visible() { # $1 = window; positive evidence that a non-composer owns it
  local pane
  [ -n "${GANG_OCCUPIED_REGEX:-}" ] || return 1
  pane="$(capture_joined "$1")" || die "cannot read pane $1"
  grep -q '[^[:space:]]' <<<"$pane" || return 1
  re_match GANG_OCCUPIED_REGEX "$pane"
}

input_painted() { # $1 = window id; 0 = the harness has drawn an input box,
                  # 3 = the pane could not be read; other non-zero = no box
  declare -F collar_input >/dev/null || return 0
  local rc=0
  input_read "$1" >/dev/null || rc=$?
  return "$rc"
}

input_clear() { # $1 = window id; 0 = nothing a person typed is sitting in that
                # box, 3 = the pane could not be read, other non-zero = not clear
  declare -F collar_input >/dev/null || return 0
  local box rc=0
  box="$(input_read "$1")" || rc=$?
  [ "$rc" -eq 0 ] || return "$rc"
  ! grep -q '[^[:space:]]' <<<"$box"
}

launch_dead() { # $1 = window id; 0 when nothing is running in that window any more
  local reading line live=0
  # A VANISHED WINDOW IS THE COMMON SHAPE OF THIS: tmux destroys a window whose
  # pane exits unless remain-on-exit holds the corpse, and only the corpse can
  # answer pane_dead.
  #
  # EVERY PANE, NOT THE ACTIVE ONE. A window target answers this question for
  # its active pane alone, so an operator who split an agent's window and left
  # a held corpse in front would have a live shell classified as nothing —
  # and the repair this refusal names, gang drop, kills the whole window.
  # list-panes also fails on a window that is gone, where display-message
  # expands an unresolvable target to nothing and still exits 0; the window id
  # is read back alongside each pane so a reading about some other window
  # cannot pass for an answer about this one.
  reading="$(tmux list-panes -t "$1" -F '#{window_id}:#{pane_dead}' 2>/dev/null)" \
    || return 0
  [ -n "$reading" ] || return 0
  while IFS= read -r line; do
    case "$line" in
      "$1:0") live=1 ;;
      "$1:1") ;;
      # A tmux that stopped answering this cannot be read as a healthy launch:
      # that reading is the whole difference between an agent booting slowly and
      # one that is not there.
      *) die "cannot tell whether anything is still running in window $1 — tmux answered '$line'" ;;
    esac
  done <<<"$reading"
  [ "$live" -eq 0 ]
}

launch_death_note() { # $1 = agent name, $2 = window id, $3 = the launch line
  local reading dead status="" last=""
  reading="$(tmux display-message -p -t "$2" '#{pane_dead}:#{pane_dead_status}' 2>/dev/null)" \
    || reading=""
  dead="${reading%%:*}"
  status="${reading#*:}"
  [ "$dead" = 1 ] || status=""
  if [ "$dead" != 1 ]; then
    printf "'%s' died at launch: its window is already gone, so nothing is running to take its startup contract. cmd: %s" \
      "$1" "$3"
    return 0
  fi
  # THE LAST THING THE COMMAND SAID IS USUALLY THE WHOLE DIAGNOSIS — a missing
  # binary, a bus that could not be reached. tmux writes its own banner into a
  # held corpse below that output, so the banner is stepped over by the one
  # anchor it has always started with; a tmux that reworded it costs the operator
  # the banner in this line rather than a wrong answer.
  last="$(capture_joined "$2" 2>/dev/null | grep '[^[:space:]]' \
    | grep -v '^Pane is dead' | tail -n 1 | sed 's/[[:space:]]*$//')" || last=""
  printf "'%s' died at launch: its pane exited%s before its input box appeared, so nothing is running to take its startup contract. cmd: %s" \
    "$1" "${status:+ (status $status)}" "$3"
  [ -z "$last" ] || printf '\nlast line in its pane: %s' "$last"
}

wait_ready() { # $1 window, $2 timeout; optional $3 hitch, $4 quiet
  local t=0
  while [ "$t" -lt "$2" ]; do
    # A LAUNCH THAT DIED IS NOT A SLOW BOOT. Every reading below asks what the
    # pane is showing and none of them asks whether anything is still running to
    # show it, so a launch that died spent the whole budget here and was then
    # reported as an agent that is up. Verdict 6 is the caller's to name, since
    # only the caller holds the command that died.
    launch_dead "$1" && return 6
    # ONLY THIS CALLER KNOWS A DEATH EXPLAINS A FAILED READ, so only this caller
    # silences one. A window that went with its launch is named by tmux on its
    # own stderr, and that would reach the operator ahead of the death note the
    # next pass of this loop produces, describing an id they never saw. The
    # predicate itself stays loud: `occupied` asks it about a live agent, where
    # a refused read is a fault and not a death.
    if input_painted "$1" 2>/dev/null; then
      pane_stable "$1" && return 0
    elif [ -n "${3:-}" ] && boot_prompt_visible "$1"; then
      [ "${4:-}" = quiet ] \
        || printf '%s\n' "$(colour "$C_WORK" "'$3' is waiting on a first-run prompt — answer it with 'gang attach'; hitch keeps observing until its input box appears or its gate budget runs out")" >&2
      return 5
    fi
    sleep 1; t=$((t + 1))
  done
  launch_dead "$1" && return 6
  pane_stable "$1" && return 2
  return 1
}

stamp_binary_id() { # $1 = window id, optional $2 = agent name being hitched
  local current refusal
  current="$(binary_id)"
  # Caught for the same reason hitch_register catches it: tmux names a window
  # the operator never saw, and it would arrive ahead of the reading below.
  refusal="$(tmux set-option -w -t "$1" @gl_binary_id "$current" 2>&1)" && return 0
  # Named at hitch, where this write is one of a run of window registrations and
  # a launch that died under any of them is the same reading for all of them.
  [ -z "${2:-}" ] || ! launch_dead "$1" \
    || die "$(launch_death_note "$2" "$1" "$GANG_LAUNCH")"
  die "could not stamp Gangline binary identity on window $1${refusal:+ — $refusal}"
}

binary_skew_note() { # $1 = window, $2 = current id; print an identity warning
  local stamped current="$2"
  stamped="$(tmux show-options -wqv -t "$1" @gl_binary_id)"
  if [ "$current" = unavailable ] || [ "$stamped" = unavailable ]; then
    printf 'binary-identity unavailable (window %s; current %s)' \
      "${stamped:-unstamped}" "$current"
  elif [ -z "$stamped" ]; then
    printf 'binary-skew (window unstamped; current %s)' "$current"
  elif [ "$stamped" != "$current" ]; then
    printf 'binary-skew (%s != current %s)' "$stamped" "$current"
  else
    return 1
  fi
}

# HOOK TRUST KEYS ON THE COMMAND STRING, and the command a collar composes
# embeds the path of the gang that composed it. Two copies of gangline that
# behave identically therefore install hooks the harness treats as new: codex
# meets its trust menu again, and the hitch stalls behind an approval nothing
# here may answer. The path each live agent's hooks were composed from is the
# fact that predicts it, so hitch records it and reads it back. A window with
# no record is one gang did not compose a launch for — `adopt`, or an older
# gang — and that is said as its own thing rather than counted as agreement.
gang_path_skew_warn() { # print at hitch, before a launch commits to this path
  local id root name differ="" unknown=""
  session_live || return 0
  while read -r id; do
    [ -n "$id" ] || continue
    root="$(tmux show-options -wqv -t "$id" @gl_root 2>/dev/null)" || root=""
    name="$(agent_name_of "$id")"
    if [ -z "$root" ]; then
      unknown="$unknown $name"
    elif [ "$root" != "$ROOT" ]; then
      differ="$differ $name($root/bin/gang)"
    fi
  done < <(tmux list-windows -t "=$SESSION" -F '#{window_id}')
  [ -z "$differ" ] \
    || printf 'gang: WARNING: this gang is %s/bin/gang and live agents in '"'"'%s'"'"' were hitched from another one:%s. Native hook trust keys on the command string, and that string embeds the gang path, so hooks composed here are new to the harness even where both copies behave the same — expect a trust prompt this hitch cannot answer. Run the gang the team already uses, or approve the hooks in the pane.\n' \
      "$ROOT" "$SESSION" "$differ" >&2
  [ -z "$unknown" ] \
    || printf 'gang: note: no gang path is recorded for:%s, so gang cannot compare theirs with this one. A window carries no record when gang composed no launch for it (adopt) or when the gang that hitched it did not record one.\n' \
      "$unknown" >&2
}

HITCH_UP_MODE=0
HITCH_ATTACH_PID=""
HITCH_ATTACH_STATE=""
HITCH_SWITCHED=0
hitch_up_state_clear() {
  [ -n "$HITCH_ATTACH_STATE" ] || return 0
  rm -f -- "$HITCH_ATTACH_STATE/client" "$HITCH_ATTACH_STATE/exit"
  rmdir -- "$HITCH_ATTACH_STATE" 2>/dev/null || true
  HITCH_ATTACH_STATE=""
}

hitch_up_abort() { # detach only the external client this invocation created
  local client=""
  if [ -n "$HITCH_ATTACH_STATE" ] && [ -s "$HITCH_ATTACH_STATE/client" ]; then
    client="$(cat "$HITCH_ATTACH_STATE/client")"
    [ -z "$client" ] || tmux detach-client -t "$client" 2>/dev/null || true
  fi
  if [ -n "$HITCH_ATTACH_PID" ]; then
    wait "$HITCH_ATTACH_PID" 2>/dev/null || true
    HITCH_ATTACH_PID=""
  fi
  hitch_up_state_clear
}

on_exit() {
  local rc=$?
  set +e
  spool_retire_abort
  lock_release
  tick_lock_release
  hitch_up_abort
  wait_hook_cleanup
  tick_launch
  return "$rc"
}

landing_zone() { # $1 = window id; the input box, or the whole pane if none is
                 # declared; 3 = the pane could not be read at all
  if declare -F collar_input >/dev/null; then input_read "$1"
  else capture_joined "$1"; fi
}

pane_mode_free() { # $1 = window id; 0 only when tmux will route keys to the pty
  local mode
  mode="$(tmux display-message -p -t "$1" '#{pane_in_mode}' 2>/dev/null)" \
    || die "cannot read tmux mode state for pane $1 — refusing to send a key whose recipient is unknown"
  case "$mode" in
    0) return 0 ;;
    1) return 1 ;;
    *) die "tmux returned unreadable pane_in_mode state '$mode' for pane $1 — refusing to send a key whose recipient is unknown" ;;
  esac
}

# A harness may accept the Enter and PARK the message in its own input queue:
# claude's queue strand (observed on 2.1.223) renders the parked body in the
# transcript styled exactly like a submitted prompt and empties the composer,
# so "the box changed" cannot distinguish entered-the-session from
# queued-as-preview. What the strand does leave behind is composer evidence —
# the box itself reads as the queue hint — and the collar owns that spelling.
# Matched against the BOX reading only, never the whole pane, so a delivered
# body that merely quotes the hint can never trip it.
box_queued() { # $1 = a landing-zone reading; 0 = the harness parked input in a queue
  [ -n "$GANG_QUEUED_REGEX" ] || return 1
  re_match GANG_QUEUED_REGEX "$1"
}

LOCK_PATH=""
lock_release() { [ -z "$LOCK_PATH" ] || rm -f -- "$LOCK_PATH"; LOCK_PATH=""; }

lock_base() { # $1 = the lock root; returns with it established as ours, or refuses
  local err
  mkdir -p "$(dirname "$1")" 2>/dev/null || :
  err="$(mkdir -m 700 "$1" 2>&1)" && return 0
  [ -e "$1" ] || [ -L "$1" ] \
    || die "cannot create the lock directory $1 — ${err:-unknown error}. Every gang process delivering to a pane must agree on this path, so gang will not quietly pick another: point GANG_LOCK_DIR at somewhere writable by ALL of them."
  [ ! -L "$1" ] \
    || die "the lock directory $1 is a symlink to $(readlink "$1" 2>/dev/null) — refusing to lock through it. A lock taken somewhere other than where the other delivering processes look is not a lock. Remove it, or point GANG_LOCK_DIR at a real directory."
  [ -d "$1" ] \
    || die "the lock path $1 exists and is not a directory — remove it, or point GANG_LOCK_DIR at a directory gang can own."
  [ -O "$1" ] \
    || die "the lock directory $1 is not owned by uid $(id -u) — refusing to take delivery locks in a directory somebody else controls, because they could delete or forge them. Point GANG_LOCK_DIR somewhere you own."
  err="$(chmod 700 "$1" 2>&1)" \
    || die "cannot restrict the lock directory $1 to this user — ${err:-unknown error}. Left open to others on a shared /tmp, another user can delete or forge the delivery locks gang relies on."
}

LOCK_SELF_PID=""
lock_self_pid() { # sets LOCK_SELF_PID to the pid that will actually hold a claim
  # SETS, never prints. $BASHPID read through a command substitution would be
  # the substitution's own fork, which dies the moment the caller returns — a
  # claim that is stale by construction — so this has to run in the calling
  # shell, which a function call does and $( ) does not. macOS still ships Bash
  # 3.2, which has no BASHPID: there a process-substitution child asks ps for
  # its wrapper's parent (this shell), and read keeps the answer here rather
  # than in another fork.
  if [ -n "${BASHPID:-}" ]; then
    LOCK_SELF_PID="$BASHPID"
    return 0
  fi
  read -r LOCK_SELF_PID < <(sh -c 'ps -o ppid= -p "$PPID"') || LOCK_SELF_PID=""
  case "$LOCK_SELF_PID" in
    ''|*[!0-9]*) die "cannot identify the Bash process holding a Gangline claim — ps returned '${LOCK_SELF_PID:-nothing}'" ;;
  esac
}

lock_pane() { # $1 = window id; held until lock_release or this process exits
  local base holder name path err me
  lock_self_pid
  me="$LOCK_SELF_PID"
  base="${GANG_LOCK_DIR:-/tmp/gangline-$(id -u)}"
  lock_base "$base"
  name="$(agent_name_of "$1")"
  path="$base/$(printf '%s' "$1" | tr -c 'A-Za-z0-9' '_').lock"
  # BASHPID, NOT $$. The lock's whole staleness protocol is "is the holder still
  # alive", and $$ keeps the ORIGINAL shell's pid inside a subshell — so a
  # delivery running in a backgrounded worker or a command substitution would
  # write down a pid that dies while the lock is still held, and the next
  # process would read the lock as stale, delete it, and paste into the same
  # composer concurrently. BASHPID is the process that actually holds it.
  err="$(ln -s "$me" "$path" 2>&1)" \
    && { LOCK_PATH="$path"; trap 'on_exit' EXIT; return; }
  [ -L "$path" ] \
    || die "cannot take the delivery lock at $path — ${err:-unknown error}. Nothing holds this lock; the path cannot be created atomically, so retrying will not help. Remove any lock left by an older Gangline, or point GANG_LOCK_DIR at somewhere writable by every Gangline process that delivers to this pane."
  holder="$(readlink "$path" 2>/dev/null)" || holder=""
  case "$holder" in
    ''|*[!0-9]*) die "delivery lock $path has an unreadable owner '$holder' — refusing to delete state Gangline cannot identify" ;;
  esac
  kill -0 "$holder" 2>/dev/null \
    && refuse "another Gangline process is delivering to $name — inspect it with gang capture $name before retrying"
  rm -f -- "$path"
  err="$(ln -s "$me" "$path" 2>&1)" \
    || refuse "the stale delivery lock for $name was cleared, but another sender took it first — inspect with gang capture $name before retrying"
  LOCK_PATH="$path"
  trap 'on_exit' EXIT
}

# THE SPOOL. A refused delivery is a live target that cannot take input YET:
# every refusal on the delivery path happens before a single keystroke, so
# nothing was typed and the body is still the sender's. `send` parks that exact
# nonce-bound envelope beside the delivery locks by default, and the target's
# own native boundary carries it through the same verified path. Ordinary mail
# drains at Stop; hitch remains foreground to drain a startup contract once the
# first composer appears.
#
# The spool is not a resident retry manager. Native boundaries remain immediate
# opportunities, and every later Gangline invocation supplies one bounded
# cooperative tick across the whole team. The pre-turn exception remains inside
# the foreground hitch command that already observes boot; no watcher survives
# either path. A collar with no Stop hook therefore still parks a pre-keystroke
# refusal for the next tick, but cannot supply hook-owned turn facts.
#
# Entries are named by a fixed-width nanosecond stamp, so the glob that reads
# them is already oldest-first. They live under a token minted into the target's
# own window options, so a directory nothing points at can never be adopted by a
# later window that reuses a tmux id, and they die with the window: `drop` and
# `down` delete them.
# A TEAM IS ONLY AS FINDABLE AS ITS SOCKET. tmux clients discover the default
# socket; a private TMUX_TMPDIR moves it, and nothing outside that environment
# can then name the server. A live team looked exactly like a vanished one, and
# a second was started over the top of it. So the socket a team is reachable on
# is written down where a later shell can read it back without inheriting the
# environment that created it.
#
# UNDER THE LOCK ROOT, beside the spools, because that is already the directory
# every gang process talking to this team agrees on. A record is a fact about
# reachability, never authority: `teams` re-asks the server itself rather than
# believing the file.
team_root_of() { printf '%s/teams' "${GANG_LOCK_DIR:-/tmp/gangline-$(id -u)}"; }

team_record_name() { # $1 = session; 0 with the record's basename, 1 = unusable
  case "$1" in
    ''|.|..) return 1 ;;
    */*) return 1 ;;
  esac
  printf '%s' "$1"
}

team_socket_record() { # $1 = session; note the socket it is reachable on
  local root file socket name
  name="$(team_record_name "$1")" || {
    printf "gang: WARNING: session '%s' cannot be written down as a team record because its name is not usable as a filename, so 'gang teams' will not find it after a disconnect. The team itself is unaffected.\n" \
      "$1" >&2
    return 0
  }
  socket="$(tmux display-message -p -t "=$1" '#{socket_path}' 2>/dev/null)" || socket=""
  # NOTHING RECORDED RATHER THAN SOMETHING GUESSED. A socket path gang could
  # not read from the server is not one an attach may be pointed at later.
  [ -n "$socket" ] || return 0
  root="$(team_root_of)"
  lock_base "$root"
  file="$root/$name"
  printf '%s\n' "$socket" > "$file.new" 2>/dev/null || return 0
  mv -f -- "$file.new" "$file" 2>/dev/null || rm -f -- "$file.new"
}

team_socket_forget() { # $1 = session; the record dies with the team it names
  local name
  name="$(team_record_name "$1")" || return 0
  rm -f -- "$(team_root_of)/$name" 2>/dev/null || true
}

team_socket_read() { # $1 = session -> the socket recorded for it; 1 = no record
  local name file socket
  name="$(team_record_name "$1")" || return 1
  file="$(team_root_of)/$name"
  [ -f "$file" ] || return 1
  IFS= read -r socket < "$file" || return 1
  [ -n "$socket" ] || return 1
  printf '%s' "$socket"
}

team_live_on() { # $1 socket, $2 session; 0 live, 1 not there, 2 no server answers
  tmux -S "$1" list-sessions -F '#{session_name}' >/dev/null 2>&1 || return 2
  tmux -S "$1" has-session -t "=$2" 2>/dev/null || return 1
}

cmd_teams() { # every team gang wrote down, and whether its server still answers
  local root file name socket rc rows=0
  [ $# -eq 0 ] || die "teams: takes no arguments"
  root="$(team_root_of)"
  if [ ! -d "$root" ]; then
    printf '%s\n' "$(colour "$C_DIM" "no teams recorded under $root")"
    return 0
  fi
  for file in "$root"/*; do
    [ -f "$file" ] || continue
    name="${file##*/}"
    IFS= read -r socket < "$file" || socket=""
    rows=$((rows + 1))
    if [ -z "$socket" ]; then
      printf '%-16s %-9s %s\n' "$name" "unknown" \
        "$(colour "$C_DIM" "the record at $file names no socket")"
      continue
    fi
    rc=0
    team_live_on "$socket" "$name" || rc=$?
    case "$rc" in
      0) printf '%-16s %-9s %s\n' "$name" "$(colour "$C_OK" live)" "$socket" ;;
      1) printf '%-16s %-9s %s\n' "$name" "$(colour "$C_DIM" gone)" \
           "$socket $(colour "$C_DIM" "(a server answers, this session is not on it)")" ;;
      2) printf '%-16s %-9s %s\n' "$name" "$(colour "$C_DIM" gone)" \
           "$socket $(colour "$C_DIM" "(no server answers)")" ;;
    esac
  done
  [ "$rows" -ne 0 ] \
    || printf '%s\n' "$(colour "$C_DIM" "no teams recorded under $root")"
}

# THE COOPERATIVE TICK. Every ordinary invocation launches one detached,
# one-shot candidate after its own result is settled. Candidates serialize on
# one pid-bearing symlink per team. A contender touches the dirty marker and
# exits immediately; the holder consumes that marker with another complete
# pass before it releases the lock. There is no resident process: the deadline
# controller and its worker exist only to finish this invocation's bounded pass.
TICK_DIR="" TICK_HEALTH="" TICK_LOG=""
TICK_LOCK_PATH="" TICK_DIRTY_PATH="" TICK_LOCK_PID=""

tick_state_root() {
  printf '%s' "${XDG_STATE_HOME:-$HOME/.local/state}/gangline/tick"
}

tick_session_live() { # cleanup/epilogue probe: no diagnostic may replace caller result
  tmux has-session -t "=$SESSION" >/dev/null 2>&1
}

tick_paths_set() { # resolve the current team to its health/log directory
  local socket digest
  TICK_DIR="" TICK_HEALTH="" TICK_LOG=""
  socket="$(tmux display-message -p -t "=$SESSION" '#{socket_path}' 2>/dev/null)" \
    || return 1
  [ -n "$socket" ] || return 1
  digest="$(python3 -c 'import hashlib,sys; print(hashlib.sha256((sys.argv[1]+"\0"+sys.argv[2]).encode()).hexdigest()[:24])' "$socket" "$SESSION")" \
    || return 1
  TICK_DIR="$(tick_state_root)/$digest"
  TICK_HEALTH="$TICK_DIR/health"
  TICK_LOG="$TICK_DIR/tick.log"
}

tick_state_prepare() {
  local root
  root="$(tick_state_root)"
  lock_base "$root"
  lock_base "$TICK_DIR"
}

tick_health_read() { # print state, epoch, message; 1 absent or unreadable
  local line state at note extra
  tick_paths_set || return 1
  [ -f "$TICK_HEALTH" ] && [ -r "$TICK_HEALTH" ] || return 1
  IFS= read -r line < "$TICK_HEALTH" || return 1
  IFS=$'\t' read -r state at note extra <<<"$line"
  case "$state" in ok|failed) ;; *) return 1 ;; esac
  case "$at" in ''|*[!0-9]*) return 1 ;; esac
  [ -z "$extra" ] || return 1
  printf '%s\t%s\t%s' "$state" "$at" "$note"
}

tick_health_store() { # $1 ok|failed, $2 message
  local state="$1" note="$2" tmp
  tick_paths_set || return 1
  tick_state_prepare
  note="$(printf '%s' "$note" | config_sanitize)"
  tmp="$TICK_HEALTH.new.${BASHPID:-$$}"
  printf '%s\t%s\t%s\n' "$state" "$(date +%s)" "$note" > "$tmp" \
    || return 1
  mv -f -- "$tmp" "$TICK_HEALTH" || { rm -f -- "$tmp"; return 1; }
}

tick_health_ok() {
  tick_paths_set || return 1
  tick_state_prepare
  printf 'ok\t%s\ttick completed for %s\n' "$(date +%s)" "$SESSION" > "$TICK_LOG" \
    || return 1
  tick_health_store ok ""
}

tick_alert_window() { # refresh the non-resident alerts window from TICK_LOG
  local id="" marked name command channel
  while read -r id marked; do
    [ "$marked" = 1 ] && break
    id=""
  done <<<"$(tmux list-windows -t "=$SESSION" -F '#{window_id} #{@gl_tick_alerts}' 2>/dev/null || :)"
  command="$(shell_quote "$ROOT/statusline/gang-tick-alert.sh") $(shell_quote "$TICK_LOG")"
  if [ -n "$id" ]; then
    tmux respawn-pane -k -t "$id" "$command" 2>/dev/null || true
    return 0
  fi
  channel="gang-tick-alert-$(mint_nonce)"
  name=gangline-alerts
  command="$(shell_quote "$(command -v tmux)") wait-for $(shell_quote "$channel"); exec $command"
  id="$(tmux new-window -d -P -F '#{window_id}' -t "=$SESSION" -n "$name" "$command" 2>/dev/null)" \
    || return 0
  tmux set-option -w -t "$id" @gl_tick_alerts 1 2>/dev/null || true
  tmux set-option -w -t "$id" remain-on-exit on 2>/dev/null || true
  tmux set-option -w -t "$id" monitor-activity on 2>/dev/null || true
  tmux set-option -w -t "$id" monitor-bell on 2>/dev/null || true
  tmux wait-for -S "$channel" 2>/dev/null || true
}

tick_failure_surface() { # $1 sanitized failure summary; never affects a caller
  local note="$1"
  tmux display-message -t "=$SESSION:" "gang: last tick failed: $note" 2>/dev/null || true
  tick_alert_window || true
}

tick_health_fail() { # $1 complete worker diagnostic
  local note="$1"
  [ -n "$note" ] || note="the tick worker failed without a diagnostic"
  note="${note##*$'\n'}"
  tick_paths_set || return 1
  tick_state_prepare
  printf 'FAILED\t%s\t%s\n' "$(date +%s)" "$(printf '%s' "$1" | config_sanitize)" > "$TICK_LOG" \
    || return 1
  tick_health_store failed "$note" || return 1
  tick_failure_surface "$(printf '%s' "$note" | config_sanitize)"
}

tick_health_warn() { # the next invocation carries the last failure on stderr
  local record state at note
  tick_session_live || return 0
  record="$(tick_health_read)" || return 0
  IFS=$'\t' read -r state at note <<<"$record"
  [ "$state" = failed ] || return 0
  printf 'gang: last tick failed: %s\n' "$note" >&2
}

tick_health_report() {
  local record state at note
  record="$(tick_health_read)" || return 0
  IFS=$'\t' read -r state at note <<<"$record"
  [ "$state" = failed ] || return 0
  printf '%s\n' "$(colour "$C_BAD" "last tick failed: $note")"
}

tick_state_forget() { # health is team-scoped and dies with that team
  tick_paths_set || return 0
  rm -f -- "$TICK_HEALTH" "$TICK_LOG" 2>/dev/null || true
  rmdir -- "$TICK_DIR" 2>/dev/null || true
}

tick_ui_ensure() { # install the silent-until-failed status-right segment
  local right segment
  tick_paths_set || return 1
  right="$(tmux show-options -qv -t "=$SESSION:" status-right 2>/dev/null)" || return 1
  case "$right" in *gang-tick-health.sh*) return 0 ;; esac
  segment="#($(shell_quote "$ROOT/statusline/gang-tick-health.sh") $(shell_quote "$TICK_HEALTH"))"
  right="${right:+$right }$segment"
  tmux set-option -t "=$SESSION:" status-right "$right" >/dev/null
}

tick_lock_paths_set() {
  local socket digest base
  socket="$(tmux display-message -p -t "=$SESSION" '#{socket_path}' 2>/dev/null)" \
    || return 1
  digest="$(python3 -c 'import hashlib,sys; print(hashlib.sha256((sys.argv[1]+"\0"+sys.argv[2]).encode()).hexdigest()[:24])' "$socket" "$SESSION")" \
    || return 1
  base="${GANG_LOCK_DIR:-/tmp/gangline-$(id -u)}/tick"
  lock_base "$base"
  TICK_LOCK_PATH="$base/$digest.lock"
  TICK_DIRTY_PATH="$base/$digest.dirty"
}

tick_lock_release() {
  local holder=""
  [ -n "$TICK_LOCK_PATH" ] || return 0
  holder="$(readlink "$TICK_LOCK_PATH" 2>/dev/null)" || holder=""
  [ "$holder" != "$TICK_LOCK_PID" ] || rm -f -- "$TICK_LOCK_PATH"
  TICK_LOCK_PATH="" TICK_DIRTY_PATH="" TICK_LOCK_PID=""
}

tick_lock_acquire() { # 0 owner, 75 live owner was marked dirty, other = fault
  local holder="" again="" err=""
  tick_lock_paths_set || return 1
  lock_self_pid
  TICK_LOCK_PID="$LOCK_SELF_PID"
  while :; do
    err=""
    if err="$(ln -s "$TICK_LOCK_PID" "$TICK_LOCK_PATH" 2>&1)"; then
      return 0
    fi
    [ -L "$TICK_LOCK_PATH" ] \
      || { printf 'tick lock %s cannot be created: %s\n' "$TICK_LOCK_PATH" "${err:-unknown error}" >&2; return 1; }
    holder="$(readlink "$TICK_LOCK_PATH" 2>/dev/null)" || holder=""
    case "$holder" in
      ''|*[!0-9]*) printf "tick lock %s has an unreadable pid '%s'\n" "$TICK_LOCK_PATH" "$holder" >&2; return 1 ;;
    esac
    if kill -0 "$holder" 2>/dev/null; then
      touch -- "$TICK_DIRTY_PATH" || { printf 'cannot mark the running tick dirty at %s\n' "$TICK_DIRTY_PATH" >&2; return 1; }
      again="$(readlink "$TICK_LOCK_PATH" 2>/dev/null)" || again=""
      if [ "$again" = "$holder" ] && kill -0 "$holder" 2>/dev/null; then
        TICK_LOCK_PATH="" TICK_DIRTY_PATH="" TICK_LOCK_PID=""
        return 75
      fi
      continue
    fi
    rm -f -- "$TICK_LOCK_PATH" \
      || { printf 'cannot clear stale tick lock %s held by dead pid %s\n' "$TICK_LOCK_PATH" "$holder" >&2; return 1; }
  done
}

tick_identity_verify() { # $1 window, $2 collar; 0 match, 1 unavailable, 2 lost
  local live="" rc=0
  declare -F collar_live_session_id >/dev/null || return 0
  live="$(collar_live_session_id "$1")" || rc=$?
  if [ "$rc" -ne 0 ]; then
    tmux set-option -w -t "$1" @gl_session_probe_failed \
      "live harness session id could not be read" 2>/dev/null || true
    return 1
  fi
  tmux set-option -uw -t "$1" @gl_session_probe_failed 2>/dev/null || true
  session_identity_record "$1" "$live" || rc=$?
  return "$rc"
}

tick_delivery_active() { # $1 window; 0 = a live tick owns delivery sequencing
  local holder=""
  holder="$(tmux show-options -wqv -t "$1" @gl_tick_delivery 2>/dev/null)" \
    || holder=""
  case "$holder" in
    ''|*[!0-9]*) [ -z "$holder" ] \
                   || tmux set-option -uw -t "$1" @gl_tick_delivery 2>/dev/null || true
                 return 1 ;;
  esac
  kill -0 "$holder" 2>/dev/null && return 0
  tmux set-option -uw -t "$1" @gl_tick_delivery 2>/dev/null || true
  return 1
}

tick_delivery_release() { # $1 window; clear only this worker's marker
  local holder=""
  holder="$(tmux show-options -wqv -t "$1" @gl_tick_delivery 2>/dev/null)" \
    || holder=""
  [ "$holder" != "$$" ] \
    || tmux set-option -uw -t "$1" @gl_tick_delivery 2>/dev/null || true
}

tick_full_pass_once() {
  local id agent collar special wins rc=0 pass_rc=0 err="" pending="" busy_rc=0
  local TICK_PASS=1
  tick_ui_ensure || { printf 'tick could not install the status-right health segment\n' >&2; rc=1; }
  wins="$(tmux list-windows -t "=$SESSION" \
    -F '#{window_id} #{@gl_agent} #{@gl_collar} #{@gl_tick_alerts}')" \
    || { printf "tick could not list windows in session '%s'\n" "$SESSION" >&2; return 1; }
  while read -r id agent collar special; do
    [ -n "$id" ] || continue
    [ "$special" != 1 ] || continue
    [ -n "$agent" ] && [ -n "$collar" ] || continue
    if ! load_collar "$collar"; then
      printf "tick could not load collar '%s' for %s\n" "$collar" "$agent" >&2
      rc=1
      continue
    fi
    pass_rc=0
    tick_identity_verify "$id" "$collar" || pass_rc=$?
    if [ "$pass_rc" -eq 2 ]; then
      err="$(identity_mismatch_read "$id" 2>/dev/null || printf 'live identity contradicted the registered session')"
      printf 'session-lost: %s: %s\n' "$agent" "$err" >&2
      glyph_write "$id" "!session-lost! ($err)"
      rc=1
      continue
    fi
    if [ "$(spool_count "$id")" -gt 0 ]; then
      pass_rc=0 err=""
      if ! tmux set-option -w -t "$id" @gl_tick_delivery "$$" 2>/dev/null; then
        printf 'tick could not mark delivery ownership for %s\n' "$agent" >&2
        rc=1
        continue
      fi
      err="$(spool_drain "$id" 2>&1)" || pass_rc=$?
      tick_delivery_release "$id"
      case "$pass_rc" in
        0) tmux set-option -uw -t "$id" @gl_spool_failed 2>/dev/null || true ;;
        3|4) ;;
        *) [ -n "$err" ] || err="the global spool retry failed"
           tmux set-option -w -t "$id" @gl_spool_failed "${err##*$'\n'}" 2>/dev/null || true
           printf 'tick spool failure for %s: %s\n' "$agent" "$err" >&2
           rc=1 ;;
      esac
    fi
    pending="$(tmux show-options -wqv -t "$id" @gl_self_compact_requested 2>/dev/null)" || pending=""
    if [ -n "$pending" ] && [ "$(spool_count "$id")" -eq 0 ]; then
      busy_rc=0
      busy "$id" || busy_rc=$?
      if [ "$busy_rc" -eq 1 ]; then
        self_compact_dispatch "$id" "$collar" sync
        pending="$(tmux show-options -wqv -t "$id" @gl_self_compact_requested 2>/dev/null)" || pending=""
        if [ -z "$pending" ] && self_compact_failed_read "$id" | grep -q .; then
          printf 'tick self-compaction failure for %s: %s\n' "$agent" "$(self_compact_failed_read "$id")" >&2
          rc=1
        fi
      fi
    fi
  done <<<"$wins"
  return "$rc"
}

cmd_tick_worker() { # internal lock/dirty owner; status 75 means another owns it
  local rc=0 lock_rc=0 pass=0
  [ $# -eq 0 ] || die "internal tick worker takes no arguments"
  session_live || return 0
  tick_lock_acquire || lock_rc=$?
  [ "$lock_rc" -eq 0 ] || return "$lock_rc"
  while :; do
    rm -f -- "$TICK_DIRTY_PATH"
    pass=$((pass + 1))
    if [ "${GANG_TEST_COLLARS:-}" = 1 ] && [ -n "${GANG_TEST_TICK_LEDGER:-}" ]; then
      printf '%s\n' "$pass" >> "$GANG_TEST_TICK_LEDGER"
    fi
    if [ "${GANG_TEST_COLLARS:-}" = 1 ] && [ "$pass" -eq 1 ] \
       && [ -n "${GANG_TEST_TICK_READY_FIFO:-}" ] \
       && [ -n "${GANG_TEST_TICK_RELEASE_FIFO:-}" ]; then
      printf x > "$GANG_TEST_TICK_READY_FIFO"
      IFS= read -r _ < "$GANG_TEST_TICK_RELEASE_FIFO" || true
    fi
    rc=0
    tick_full_pass_once || rc=$?
    [ -e "$TICK_DIRTY_PATH" ] && continue
    tick_lock_release
    if [ -e "$TICK_DIRTY_PATH" ]; then
      lock_rc=0
      tick_lock_acquire || lock_rc=$?
      case "$lock_rc" in 0) continue ;; 75) return 75 ;; *) return "$lock_rc" ;; esac
    fi
    return "$rc"
  done
}

cmd_tick() { # public synchronous seam; its worker is always self-deadlined
  local out="" rc=0
  [ $# -eq 0 ] || die "tick: takes no arguments"
  session_live || return 0
  out="$(GANG_TICK_INTERNAL=1 "$ROOT/libexec/gang-tick-deadline" \
    "$ROOT/bin/gang" __tick-worker 2>&1)" || rc=$?
  case "$rc" in
    0) tick_health_ok \
         || { tick_health_fail "the tick completed but its health file could not be written" || true; return 1; } ;;
    75) return 0 ;;
    *) [ -z "$out" ] || printf '%s\n' "$out" >&2
       tick_health_fail "$out" || true
       return 1 ;;
  esac
}

tick_launch() { # isolate a post-command candidate from the command's own result
  [ -z "${GANG_TICK_INTERNAL:-}" ] || return 0
  case "${cmd:-}" in tick|__tick-worker) return 0 ;; esac
  tick_session_live || return 0
  case "${GANG_TEST_TICK_MODE:-}" in
    manual) [ "${GANG_TEST_COLLARS:-}" = 1 ] && return 0 ;;
    sync) if [ "${GANG_TEST_COLLARS:-}" = 1 ]; then
            ( trap - EXIT HUP INT TERM
              GANG_TICK_INTERNAL=1 "$ROOT/bin/gang" tick </dev/null >/dev/null 2>&1 )
            return 0
          fi ;;
  esac
  ( trap - EXIT HUP INT TERM
    GANG_TICK_INTERNAL=1 "$ROOT/bin/gang" tick </dev/null >/dev/null 2>&1 ) &
  disown
  return 0
}

spool_root_of() { printf '%s/spool' "${GANG_LOCK_DIR:-/tmp/gangline-$(id -u)}"; }

spool_root_prepare() { # establish the shared roots before a window depends on them
  local base="${GANG_LOCK_DIR:-/tmp/gangline-$(id -u)}"
  lock_base "$base"
  lock_base "$base/spool"
}

archive_root() { # where a message goes when its window dies
  printf '%s' "${GANG_ARCHIVE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/gangline/archive}"
}

SPOOL_DIR=""
spool_existing() { # $1 = window id; SPOOL_DIR = its spool; 1 = it has never had one
  local token
  SPOOL_DIR=""
  token="$(tmux show-options -wqv -t "$1" @gl_spool 2>/dev/null)" || token=""
  [ -n "$token" ] || return 1
  case "$token" in
    *[!a-f0-9]*) die "the spool token recorded on pane $1 is '$token', which is not one gang minted — refusing to read or delete a directory it cannot account for" ;;
  esac
  SPOOL_DIR="$(spool_root_of)/$token"
}

SPOOL_UNAVAILABLE_WHY=""
spool_available() { # $1 = window id, $2 = target name; 0 = a parked message would drain
  SPOOL_UNAVAILABLE_WHY=""
  if ! spool_existing "$1"; then
    SPOOL_UNAVAILABLE_WHY="the window of '$2' carries no spool identity — it is minted at hitch and adopt, so re-hitch or re-adopt '$2' before a refused message can park"
    return 1
  fi
  return 0
}

SPOOL_TOKEN_HOLDERS=""
spool_token_holders() { # $1 token, optional $2 = a window id that may hold it
  # THE TMUX SERVER IS THE REGISTER OF PUBLISHED SPOOL IDENTITIES. Nothing on
  # disk records which window a reservation was taken for, so "is this name
  # somebody else's" can only be answered by asking the windows. Reported as a
  # list rather than a yes/no because the refusals that use it have to name who
  # is holding it for an operator to be able to act.
  local me="" wid wtok
  SPOOL_TOKEN_HOLDERS=""
  [ -n "$1" ] || return 0
  if [ -n "${2:-}" ]; then
    me="$(tmux display-message -p -t "$2" '#{window_id}' 2>/dev/null)" || me="$2"
  fi
  while read -r wid wtok; do
    [ -n "$wtok" ] || continue
    [ "$wtok" = "$1" ] || continue
    [ -z "$me" ] || [ "$wid" != "$me" ] || continue
    SPOOL_TOKEN_HOLDERS="$SPOOL_TOKEN_HOLDERS $wid"
  done <<< "$(tmux list-windows -a -F '#{window_id} #{@gl_spool}' 2>/dev/null || :)"
}

spool_mint() { # $1 = window id; the spool identity, minted where nothing races it
  # AT HITCH AND ADOPT, never at send. Two refused sends arriving
  # together would each see no token, mint their own, and overwrite the window
  # option: only the last one stays reachable, so the other sender is told its
  # message is waiting while it sits in a directory nothing points at and no
  # drop or down will ever delete. Minting it once, before the window can have
  # a second writer, removes the race rather than narrowing it.
  # A DIRECTORY OUTLIVES THE WINDOW THAT NAMED IT. Only drop and down remove a
  # spool, so any other death — an external kill-window, a tmux server that
  # goes away — strands its directory under the spool root forever. spool_
  # establish creates or ADOPTS the directory its token names, so a token
  # minted onto one of those strays would hand a new agent the dead one's
  # waiting mail to drain.
  #
  # SO THE DIRECTORY IS THE RESERVATION, TAKEN HERE. Looking is not enough, and
  # not because two mints might race: a window hitched and never sent anything
  # carries a published token and NOTHING on disk, because the directory used to
  # wait for the first parked message. A mint an hour later draws that same name,
  # looks, sees nothing, and publishes it too — and the two windows share one
  # spool the moment either of them first parks mail, with only per-window pane
  # locks between them. mkdir is the look and the claim in one operation, so the
  # name a window holds is a name no later mint can be handed. An empty
  # directory costs nothing downstream: spool_drain_dispatch returns on a count
  # of zero before it spawns a worker, so no native boundary is sent through the
  # pane lock for a queue that has never held anything.
  local token root live spool_refusal nl=$'\n'
  token="$(tmux show-options -wqv -t "$1" @gl_spool 2>/dev/null)" || token=""
  root="$(spool_root_of)"
  spool_root_prepare
  if [ -n "$token" ]; then
    # A TOKEN PUBLISHED BEFORE THIS RULE EXISTED HAS NO RESERVATION. gang is a
    # script read from disk, so an upgrade reaches a running team between one
    # command and the next: every window already up carries a name nothing on
    # disk is holding. Repairing it whenever a mint touches the window is the
    # cheap half of closing that; the walk below is the half that matters,
    # because nothing ever calls mint on those windows again.
    #
    # WHAT IS ALREADY ON THE WINDOW IS NOT EVIDENCE THAT GANG PUT IT THERE. This
    # is a tmux option and gang is not the only writer a tmux server has, so it
    # is validated exactly where spool_existing validates it — before it becomes
    # a path. A value carrying a separator or a parent reference would otherwise
    # make this mkdir claim a directory outside the spool root entirely.
    case "$token" in
      *[!a-f0-9]*) die "the spool identity recorded on this window is '$token', which is not one gang minted — refusing to reserve a directory it cannot account for. Clear @gl_spool on the window and hitch or adopt it again" ;;
    esac
    # AND A WELL-FORMED TOKEN CAN STILL BELONG TO SOMEBODY ELSE. Nothing in the
    # registration guards covers @gl_spool, so an unregistered window can be set
    # to a live agent's identity and adopted; the mkdir below would then find the
    # existing directory, and returning on that would enrol two windows on one
    # spool, each draining the other's mail. That is the same harm as a repeated
    # mint, reached without needing a nonce collision, so it is refused here.
    spool_token_holders "$token" "$1"
    [ -z "$SPOOL_TOKEN_HOLDERS" ] \
      || die "this window's spool identity '$token' is already held by$SPOOL_TOKEN_HOLDERS — refusing to enrol two windows on one spool, where each would drain mail addressed to the other. Clear @gl_spool on this window, then adopt it again to be given one of its own"
    mkdir -m 700 "$root/$token" 2>/dev/null && return 0
    # EEXIST is the repair succeeding on a reservation that is already there. Any
    # other reason it could not be taken is a spool this window cannot be said to
    # own, and saying so beats returning as though the identity were reserved.
    # NOT THROUGH A LINK: -d and -O both follow one, so a token path pointing at
    # some other owned directory would read as repaired here and then be refused
    # by lock_base when the first message tried to land. A reservation that is
    # somewhere other than where the delivering processes look is not one, which
    # is the same rule lock_base already keeps.
    [ ! -L "$root/$token" ] && [ -d "$root/$token" ] && [ -O "$root/$token" ] \
      || die "cannot reserve the spool identity '$token' this window already carries: $root/$token is not a directory this user owns — every gang process delivering to this window has to find the spool at that exact path, and gang will not treat a link or a foreign directory as a reservation"
    return 0
  fi
  # WHAT A LIVE WINDOW HAS PUBLISHED IS TAKEN, RESERVED OR NOT. Until every
  # window predating the reservation rule has been dropped, a published token
  # with no directory is exactly the name this loop would otherwise consider
  # free — mkdir would succeed on it and two windows would share one spool. The
  # tmux server is the register of those names, so it is read here and the draw
  # avoids them. A window minting its own identity is not in this list yet, so
  # this cannot make a mint avoid itself.
  live="$(tmux list-windows -a -F '#{@gl_spool}' 2>/dev/null)" || live=""
  while :; do
    token="$(mint_nonce)"
    [ -n "$token" ] || die "cannot mint a spool identity for this window"
    case "$nl$live$nl" in
      *"$nl$token$nl"*) continue ;;
    esac
    mkdir -m 700 "$root/$token" 2>/dev/null && break
    [ -e "$root/$token" ] \
      || die "cannot reserve a spool identity under $root — every gang process delivering to this window has to agree on that path, so gang will not quietly pick another: point GANG_LOCK_DIR at somewhere writable."
  done
  # PUBLISHED SECOND. The reservation is what makes the name unrepeatable, so a
  # failure to publish must not leave one behind that nothing will ever release.
  spool_refusal="$(tmux set-option -w -t "$1" @gl_spool "$token" 2>&1)" \
    || { rmdir -- "$root/$token" 2>/dev/null || :
         die "cannot record the spool identity for this window${spool_refusal:+ — $spool_refusal}"; }
}

spool_establish() { # $1 = window id; SPOOL_DIR = its spool, created and owned by us
  local base
  spool_existing "$1" \
    || die "this window has no spool identity, and gang will not mint one on the way to parking a message. It is minted at hitch and adopt — re-hitch or re-adopt this agent"
  base="${GANG_LOCK_DIR:-/tmp/gangline-$(id -u)}"
  lock_base "$base"
  lock_base "$base/spool"
  lock_base "$SPOOL_DIR"
}

spool_stamp() { # fixed width, so the entry glob reads oldest-first with no sort
  python3 -c 'import time; print("%020d" % time.time_ns())' 2>/dev/null
}

spool_count() { # $1 = window id -> how many entries are waiting
  local e n=0
  if spool_existing "$1"; then
    for e in "$SPOOL_DIR"/[0-9]*; do
      [ -f "$e" ] && n=$((n + 1))
    done
  fi
  printf '%s' "$n"
}

spool_oldest_age() { # $1 = window id -> seconds the oldest waiting entry has waited
  local e stamp now
  spool_existing "$1" || return 1
  for e in "$SPOOL_DIR"/[0-9]*; do
    [ -f "$e" ] || continue
    stamp="${e##*/}"
    stamp="${stamp%%-*}"
    # spool_stamp is printf %020d of a nanosecond count: fixed-width twenty
    # digits, zero-padded. Validate the full width, drop the nine nanosecond
    # digits, and force base 10 — the pad zero otherwise reads as octal, and
    # the eleven digits that remain fit where twenty would not.
    [ "${#stamp}" -eq 20 ] || return 1
    case "$stamp" in *[!0-9]*) return 1 ;; esac
    stamp="${stamp%?????????}"
    stamp="$((10#$stamp))"
    now="$(date +%s)"
    case "$now" in ''|*[!0-9]*) return 1 ;; esac
    [ "$now" -ge "$stamp" ] || return 1
    printf '%s' "$(( now - stamp ))"
    return 0
  done
  return 1
}

# A TIMED SEND IS AN ORDINARY SPOOL ENTRY THAT IS NOT WAITING YET. It is written
# into the target's own spool, in the same three-line shape as every other
# entry, under a name beginning with a dot — and every path that drains, counts,
# ages or supersedes the queue globs `[0-9]*`, so none of them can see it. That
# is the whole mechanism: no new delivery semantics, no second store, and no
# predicate anywhere had to learn about time.
#
# The dot is also why the rest falls out for free. `spool_dir_archive` archives
# EVERY child of a spool and strips leading dots on the way, so an agent dropped
# before its time arrives leaves this message in the archive under a readable
# name rather than vanishing; `spool_sweep_orphans` carries the same entry out
# of a spool no window claims. Its deletion path is the spool's, unchanged.
#
# What the clock does is promote: rename the entry into the namespace a drain
# reads, then ask for a delivery. Nothing waits, nothing polls, and a promotion
# that never happens leaves the entry exactly where a person can still find it.
timed_stamp() { # $1 = due epoch -> the fixed-width field a glob reads soonest-first
  printf '%010d' "$1"
}

timed_entries() { # $1 = window id; print each pending timed entry path, soonest first
  local e
  spool_existing "$1" || return 0
  for e in "$SPOOL_DIR"/.timed-[0-9]*; do
    [ -f "$e" ] && printf '%s\n' "$e"
  done
}

timed_due_of() { # $1 = a timed entry path -> its due epoch; 1 = the name is unusable
  local base due
  base="${1##*/}"
  due="${base#.timed-}"
  due="${due%%-*}"
  case "$due" in ''|*[!0-9]*) return 1 ;; esac
  [ "${#due}" -eq 10 ] || return 1
  printf '%s' "$((10#$due))"
}

timed_count() { # $1 = window id -> how many timed sends are parked against it
  local e n=0
  while read -r e; do [ -z "$e" ] || n=$((n + 1)); done <<<"$(timed_entries "$1")"
  printf '%s' "$n"
}

# THE UNIT NAME IS DERIVED FROM THE ENTRY, not remembered beside it. The entry
# file is the declaration — it outlives this process, the arming shell, and any
# tmux option — so the callback's only test is the name it was armed under, and
# that name has to be reconstructible from the entry alone.
timed_unit() { # $1 = window id, $2 = entry basename -> a safe transient unit basename
  local sum
  sum="$(printf '%s:%s:%s\n' "$SESSION" "$1" "$2" | cksum)" \
    || die "at: cannot derive a transient unit name"
  printf 'gangline-at-%s-%s' "$(id -u)" "${sum%% *}"
}

spool_dir_of() { # $1 = window id -> its spool directory on stdout, nothing if it has none
  # PRINTED, not left in SPOOL_DIR. Every caller that wants this from a command
  # substitution is a subshell, and a global set there dies with it — which is
  # how the held-message report came to name an empty directory.
  spool_existing "$1" && printf '%s' "$SPOOL_DIR"
}

spool_held() { # $1 = window id -> entries a drain claimed and never retired
  # Claimed but not delivered-and-removed: a drain that died mid-flight, or one
  # whose delivery could not be verified. Counted and reported because nothing
  # will ever pick them up again — an entry gang has stopped acting on and does
  # not name is a message lost quietly.
  local e n=0
  if spool_existing "$1"; then
    for e in "$SPOOL_DIR"/sending-* "$SPOOL_DIR"/failed-* "$SPOOL_DIR"/unverified-*; do
      [ -f "$e" ] && n=$((n + 1))
    done
    for e in "$SPOOL_DIR"/.writing-*; do
      spool_abandoned "$e" && n=$((n + 1))
    done
  fi
  printf '%s' "$n"
}

spool_abandoned() { # $1 = a .writing- fragment; 0 = the sender that wrote it is gone
  # A STAGED BODY IS A MESSAGE THAT WAS NEVER PARKED. spool_stage writes it
  # under a name no drain reads and spool_commit renames it into the deliverable
  # namespace; a sender that dies between the two leaves the body on disk where
  # spool_count does not see it, spool_held did not see it, and mail does not
  # print it. Only the teardown archive ever met it again — so a send whose
  # sender was killed mid-park was a message with no surface at all, which is
  # the one thing the spool exists not to do.
  #
  # ASKED OF THE PID IN THE NAME, not of a clock. spool_stage stamps the writing
  # process into the filename, and a fragment whose writer is still running is
  # an ordinary send a few microseconds old rather than a casualty. This is the
  # same evidence the delivery lock already trusts about its own holder: a
  # recorded pid that no longer answers is a dead owner.
  local base rest pid
  [ -f "$1" ] || return 1
  base="${1##*/}"
  rest="${base#.writing-}"
  pid="${rest%%-*}"
  case "$pid" in ''|*[!0-9]*) return 0 ;; esac
  ! kill -0 "$pid" 2>/dev/null
}

spool_held_report() { # $1 = window id; one truthful line per held entry
  # ONE LINE PER ENTRY, AND THE LINE SAYS WHICH KIND. An `unverified-` entry
  # was typed into the recipient's composer and Enter was pressed against it;
  # a `failed-` or `sending-` one was not, or gang could not see that it was.
  # Summing them under one word is what made a sender chase a phantom held
  # message for a body its recipient had already acted on.
  local e
  spool_existing "$1" || return 0
  for e in "$SPOOL_DIR"/.writing-*; do
    spool_abandoned "$e" || continue
    # READ LENIENTLY. A fragment is by definition a body that may be
    # half-written, so the strict reader would die on exactly the artifact this
    # line exists to name. Where it cannot be parsed the path is still the
    # truth worth printing.
    if spool_read_try "$e"; then
      printf 'written but never parked — its sender died before committing it, so nothing ever delivered it and nothing ever will: %s\n' "$SPOOL_FRAG"
    else
      printf 'written but never parked, and it cannot be read back — its sender died mid-write; the bytes are at %s\n' "$e"
    fi
  done
  for e in "$SPOOL_DIR"/unverified-*; do
    [ -f "$e" ] || continue
    spool_read "$e"
    printf 'typed into the composer, submission NOT verified — it may already have been delivered, and gang will not send it again: %s\n' \
      "$SPOOL_FRAG"
  done
  for e in "$SPOOL_DIR"/sending-* "$SPOOL_DIR"/failed-*; do
    [ -f "$e" ] || continue
    spool_read "$e"
    printf 'held (delivery NOT verified — it may still have arrived): %s\n' \
      "$SPOOL_FRAG"
  done
}

SPOOL_SENDER="" SPOOL_FRAG="" SPOOL_BODY="" SPOOL_READ_ERROR=""
spool_read_try() { # $1 = entry path; 0 loaded, 1 with SPOOL_READ_ERROR
  SPOOL_SENDER=""; SPOOL_FRAG=""; SPOOL_BODY=""
  SPOOL_READ_ERROR=""
  if ! { read -r SPOOL_SENDER; read -r SPOOL_FRAG; SPOOL_BODY="$(cat)"; } < "$1"; then
    SPOOL_READ_ERROR="cannot read the spooled message $1 — refusing to guess at a message body"
    return 1
  fi
  if [ -z "$SPOOL_BODY" ]; then
    SPOOL_READ_ERROR="the spooled message $1 has no body — refusing to send an envelope gang cannot reconstruct"
    return 1
  fi
  return 0
}

spool_read() { # $1 = entry path; its sender, fragment, and envelope as it goes on the wire
  spool_read_try "$1" || die "$SPOOL_READ_ERROR"
}

SPOOL_SUPERSEDE_ERROR=""
spool_supersede_try() { # $1 window, $2 sender; retire that sender's waiting entries
  # WHY THIS HAS A NON-DYING FORM, like spool_read above it. cmd_send calls it
  # between staging the replacement and parking it, and what it has to report
  # there is about the pair — the body it wrote and the predecessor it could not
  # retire — so the failure has to come back as a value this caller can still act
  # on. Recovering the message by wrapping the dying form in a command
  # substitution would mean parsing a captured diagnostic to decide control flow;
  # setting a variable beside it is the same shape spool_read_try already has and
  # needs no parsing. (An earlier note here claimed the substitution would fire
  # this caller's EXIT trap and drop its pane lock. That is not so — a command
  # substitution's subshell resets caught traps, which is exactly what the note
  # at send_live says. The shape is right; that was not the reason.)
  #
  # AND WHY IT RETIRES IN TWO STEPS. Unlinking as the walk goes made the ORDER
  # of the entries decide what a refusal costs: a sweep that removed a real
  # predecessor and then met an unreadable entry returned failure with that
  # predecessor already destroyed and — since the replacement is not parked on a
  # failure — nothing at all in its place. That is the loss this whole issue is
  # about, moved from before the write to the middle of the sweep. So the walk
  # only moves entries OUT of the [0-9]* namespace, where no drain reads them
  # and nothing has yet been destroyed; if any step fails, every one it moved
  # goes back. Nothing is unlinked until the caller has the replacement safely
  # parked and calls spool_retire_commit.
  local e base held="" nl=$'\n'
  SPOOL_SUPERSEDE_ERROR=""; SPOOL_RETIRED=""
  spool_existing "$1" || return 0
  [ -d "$SPOOL_DIR" ] || return 0
  # NO ENTRY TO EXCLUDE. The sweep used to be handed the replacement's own name
  # to skip, because the replacement was already parked in this namespace when
  # the sweep ran. It is not any more — cmd_send stages it and parks it after —
  # so every [0-9]* entry from this sender here is genuinely an older one.
  for e in "$SPOOL_DIR"/[0-9]*; do
    [ -f "$e" ] || continue
    spool_read_try "$e" || { SPOOL_SUPERSEDE_ERROR="$SPOOL_READ_ERROR"; break; }
    [ "$SPOOL_SENDER" = "$2" ] || continue
    base="${e##*/}"
    mv -- "$e" "$SPOOL_DIR/.retiring-$base" \
      || { SPOOL_SUPERSEDE_ERROR="cannot supersede the spooled message $e"; break; }
    held="$held$base$nl"
  done
  SPOOL_RETIRED="$held"
  if [ -n "$SPOOL_SUPERSEDE_ERROR" ]; then
    spool_retire_rollback \
      || SPOOL_SUPERSEDE_ERROR="$SPOOL_SUPERSEDE_ERROR ($SPOOL_ROLLBACK_ERROR)"
    return 1
  fi
  return 0
}

SPOOL_RETIRED="" SPOOL_ROLLBACK_ERROR=""
spool_retire_rollback() { # put every set-aside predecessor back where a drain reads
  # THE RETIREMENT IS NOT FINAL UNTIL THE REPLACEMENT IS. Anything that goes
  # wrong between the two — an entry the sweep cannot read, a park that fails —
  # has to leave the sender's older mail exactly as deliverable as it found it,
  # because on those paths nothing is parked to supersede it. A restore that
  # itself fails leaves the body on disk under a name teardown archives, so it
  # is still not lost; it is no longer deliverable, and saying so is the
  # difference between a reported partial state and a silent one.
  local back failed=""
  SPOOL_ROLLBACK_ERROR=""
  [ -n "$SPOOL_RETIRED" ] || return 0
  while IFS= read -r back; do
    [ -n "$back" ] || continue
    mv -- "$SPOOL_DIR/.retiring-$back" "$SPOOL_DIR/$back" 2>/dev/null \
      || failed="$failed $SPOOL_DIR/.retiring-$back"
  done <<< "$SPOOL_RETIRED"
  SPOOL_RETIRED=""
  [ -z "$failed" ] || {
    SPOOL_ROLLBACK_ERROR="and these messages could not be put back where a drain would claim them, so they are on disk but no longer deliverable:$failed"
    return 1
  }
  return 0
}

spool_retire_commit() { # unlink what spool_supersede_try moved aside; 1 = some remain
  local t left=""
  [ -n "$SPOOL_RETIRED" ] || return 0
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    rm -f -- "$SPOOL_DIR/.retiring-$t" || left="$left $SPOOL_DIR/.retiring-$t"
  done <<< "$SPOOL_RETIRED"
  SPOOL_RETIRED=""
  [ -z "$left" ] || { SPOOL_SUPERSEDE_ERROR="superseded messages were retired but could not be removed; they are inert where they are and teardown will archive them:$left"; return 1; }
  return 0
}

spool_retire_abort() { # an open retirement must not outlive the command that opened it
  # ANY EXIT, not the ones a caller can see coming. Between the sweep and the
  # finalize there are several dying paths — an unstampable entry, a failed
  # write, a die deeper in delivery — and on every one of them the sender's older
  # mail is sitting outside the namespace a drain reads, retired for a message
  # that was never accepted. Putting it back from the exit trap covers all of
  # them at once, including the ones nobody has enumerated, and costs nothing
  # when no retirement is open. It runs before the pane lock is dropped, so the
  # restore happens inside the same critical section that moved them.
  [ -n "$SPOOL_RETIRED" ] || return 0
  spool_retire_rollback || printf '%s\n' "gang: $SPOOL_ROLLBACK_ERROR" >&2
}

SPOOL_ENTRY="" SPOOL_STAGED=""
# WRITING AND PARKING ARE TWO STEPS BECAUSE --supersede NEEDS TO STAND BETWEEN
# THEM. spool_stage puts the whole body on disk under a name no drain reads;
# spool_commit renames it into the [0-9]* namespace, which is the act that makes
# it deliverable. Everything that is not superseding calls spool_write and sees
# one operation.
spool_stage() { # $1 window, $2 sender, $3 envelope, $4 fragment; sets SPOOL_STAGED
  local stamp tmp
  spool_establish "$1"
  # THE EMPTY ARM BELOW IS ONLY REACHABLE BECAUSE OF THIS `|| stamp=""`. An
  # assignment from a command substitution carries the substitution's status,
  # and `set -e` ends the process on it — so a python3 that cannot run killed
  # gang here with status 1 and nothing on stderr, and the refusal written for
  # exactly that case never printed.
  stamp="$(spool_stamp)" || stamp=""
  case "$stamp" in
    ''|*[!0-9]*) die "cannot stamp a spool entry — python3 has to run for gang to order a spool oldest-first, and a message it could not then deliver in order will not be parked" ;;
  esac
  tmp="$SPOOL_DIR/.writing-$$-$stamp"
  printf '%s\n%s\n%s\n' "$2" "$4" "$3" > "$tmp" \
    || die "cannot write a spooled message into $SPOOL_DIR"
  SPOOL_STAGED="$tmp"
  SPOOL_ENTRY="$SPOOL_DIR/$stamp-$(mint_nonce)"
}

SPOOL_COMMIT_ERROR=""
spool_commit_try() { # park the staged body under the name spool_stage reserved for it
  SPOOL_COMMIT_ERROR=""
  [ -n "$SPOOL_STAGED" ] || die "internal: spool_commit called with nothing staged"
  # Committed by rename, so a drain can never read a half-written entry.
  # NON-DYING, because --supersede has a retirement standing open across it: if
  # this rename fails the caller has to put the predecessors back before it
  # reports anything, and a die here would end the process with them set aside.
  if ! mv -- "$SPOOL_STAGED" "$SPOOL_ENTRY"; then
    SPOOL_COMMIT_ERROR="cannot commit a spooled message into $SPOOL_DIR"
    return 1
  fi
  SPOOL_STAGED=""
  return 0
}

spool_commit() { spool_commit_try || die "$SPOOL_COMMIT_ERROR"; }

spool_write() { # $1 window, $2 sender, $3 envelope, $4 fragment; sets SPOOL_ENTRY
  spool_stage "$@"
  spool_commit
}

ARCHIVE_DIR=""
archive_establish() { # $1 = an archive-operation label; ARCHIVE_DIR = its directory
  local root
  [ -z "$ARCHIVE_DIR" ] || return 0
  root="$(archive_root)"
  mkdir -p "$root" || die "cannot create the message archive at $root — set GANG_ARCHIVE_DIR somewhere writable; refusing the operation while the mail has nowhere to go"
  ARCHIVE_DIR="$root/$1-$(date +%Y%m%dT%H%M%S)-$(mint_nonce)"
  mkdir "$ARCHIVE_DIR" || die "cannot claim the archive directory $ARCHIVE_DIR — refusing to write into one gang did not create"
}

SPOOL_PREFLIGHT_ERROR=""
spool_dir_preflight() { # $1 = a spool directory; 0 archivable, 1 with the reason
  # NON-DYING, because the same eligibility question is asked from two places
  # that owe different answers. A teardown must stop: its agent is still alive
  # and its mail must not be half-moved. A sweep of directories nobody owns
  # must NOT stop — one unaccountable stray would otherwise take every other
  # orphan's mail down with it, and refuse the `up` that went looking.
  local e
  SPOOL_PREFLIGHT_ERROR=""
  # ELIGIBILITY BEFORE THE FIRST MOVE. The archive can carry regular files
  # (including links to them), but spool_forget refuses to remove a directory
  # that holds anything else. Discovering such a child only after the files
  # moved left a refused drop with its agent alive and its previously waiting
  # mail outside the queue a later boundary would drain.
  for e in "$1"/* "$1"/.[!.]* "$1"/..?*; do
    [ -e "$e" ] || [ -L "$e" ] || continue
    [ -f "$e" ] && continue
    SPOOL_PREFLIGHT_ERROR="the spool directory $1 holds something gang cannot archive"
    return 1
  done
  return 0
}

spool_archive_preflight() { # $1 = window id; refuse before any teardown mutates mail
  spool_existing "$1" || return 0
  [ -d "$SPOOL_DIR" ] || return 0
  spool_dir_preflight "$SPOOL_DIR" \
    || die "$SPOOL_PREFLIGHT_ERROR; none of this spool's pending messages has been moved, and its agent has not been ended — read what is in it, then remove it by hand"
}

spool_archive() { # $1 = window id; move every entry somewhere a person can read it
  local name waiting held spool_archive_held
  spool_archive_preflight "$1"
  [ -n "$SPOOL_DIR" ] && [ -d "$SPOOL_DIR" ] || return 0
  # SAID BEFORE THE MOVE, AND SAID SEPARATELY. The count printed after the
  # archive is one number over two populations that mean opposite things to
  # whoever reads it: a WAITING entry was never typed at anyone and its sender
  # can send it again, while a HELD one may already have arrived and must not
  # be sent twice. An operator ending an agent is deciding exactly that, so the
  # two are named here rather than summed into "undelivered".
  waiting="$(spool_count "$1")"
  [ "$waiting" -eq 0 ] \
    || printf '%s\n' "$(colour "$C_WORK" "$waiting message(s) were still waiting for a delivery opportunity and will not get one; they are archived below, and their senders may send them again")"
  held="$(spool_held "$1")"
  if [ "$held" -ne 0 ]; then
    printf '%s\n' "$(colour "$C_BAD" "$held message(s) are held here — gang could not verify delivery and will not send them again:")"
    spool_held_report "$1" | while IFS= read -r spool_archive_held; do
      printf '%s\n' "$(colour "$C_BAD" "  $spool_archive_held")"
    done
  fi
  # A NAME BECOMES A PATH COMPONENT HERE, so this is where it has to be a
  # name. hitch and adopt both validate what they register, but the option
  # is a tmux value and gang is not the only writer a tmux server has; a
  # value carrying a separator or a parent reference would move pending
  # mail out of the archive root on an ordinary drop. Validating at the
  # join is the check no reader of the identity can route around, and the
  # window id is a destination gang always owns.
  name="$(agent_name_of "$1" 2>/dev/null)" || name=""
  valid_name "$name" || name="${1#@}"
  spool_dir_archive "$SPOOL_DIR" "$name"
}

spool_dir_archive() { # $1 = a spool directory, $2 = the name it archives under
  local e entry dest dest_base dest_name dest_n moved=0
  [ -d "$1" ] || return 0
  # EVERY CHILD, not the names gang expects. A whitelist here turns "this is
  # not something I recognise" into "there was nothing here", because what it
  # skips spool_forget then removes. The reachable stray is a .writing-
  # fragment left by a spool_write that died between its temporary file and
  # the commit rename — a partially written message, which is exactly the
  # artifact someone investigating a failed park comes looking for.
  for e in "$1"/* "$1"/.[!.]* "$1"/..?*; do
    [ -f "$e" ] || continue
    if [ "$moved" -eq 0 ]; then
      archive_establish "$SESSION"
      dest="$ARCHIVE_DIR/$2"
      mkdir -p "$dest" || die "cannot create $dest for the pending messages of this window"
    fi
    # IT ARRIVES VISIBLE. The archive is a directory a person reads with ls,
    # so a .writing- fragment carried over verbatim would be saved and hidden
    # by the same move — the count below would say it was kept and the
    # directory would look empty to whoever went to read it.
    #
    # AND UNDER A NAME NOTHING ELSE HERE HOLDS. Making a name visible is a
    # many-to-one map: `.foo` and `foo` are two children of one spool and both
    # want to be `foo`, and plain mv answers that by destroying the first with
    # the second. The spool then empties, the rmdir below succeeds, and teardown
    # reports a clean archive with a message gone — the exact silent loss the
    # archive-every-child rule above exists to stop, reintroduced by the rename
    # that carries it out. So the visible name is a request, and a taken one is
    # answered with a suffix instead of a casualty. Nothing else writes into
    # this directory — archive_establish minted it under a nonce and only this
    # loop has been in it — so looking before moving is enough to settle it.
    entry="${e##*/}"
    dest_base="$entry"
    # EVERY leading dot, not one. `..foo` is a child the ..?* glob above brings
    # in, and stripping a single dot leaves it hidden in the archive — visible
    # is the property, so it has to be stripped down to one.
    while [ "${dest_base#.}" != "$dest_base" ]; do dest_base="${dest_base#.}"; done
    # A name of nothing but dots strips down to nothing, and an empty base is
    # not a visible name: the suffix loop below would hand it `.2`, which is
    # hidden again, and a bare `$dest/` would make mv keep the basename it was
    # trying to leave behind. So it gets a name of its own instead.
    [ -n "$dest_base" ] || dest_base="dotted"
    dest_name="$dest_base"
    dest_n=1
    # -L AS WELL AS -e. A child of the spool may be a symlink, and a relative one
    # stops resolving the moment it is moved here — after which -e alone calls
    # its name free and the next child is moved straight over it. A name is taken
    # if anything answers to it, resolvable or not; lock_base checks the same way.
    while [ -e "$dest/$dest_name" ] || [ -L "$dest/$dest_name" ]; do
      dest_n=$((dest_n + 1))
      dest_name="$dest_base.$dest_n"
    done
    mv -- "$e" "$dest/$dest_name" \
      || die "cannot archive the pending message $e to $dest — nothing further has been ended, and the message is still where it was"
    moved=$((moved + 1))
  done
  [ "$moved" -eq 0 ] \
    || printf '%s\n' "$(colour "$C_WORK" "archived $moved undelivered message(s) to $dest")"
}

spool_forget() { # $1 = window id; the spool dies with the window it belongs to
  # rmdir, NOT rm -rf: the archive above has just emptied this directory of
  # everything it could move, so anything still in it is something gang could
  # not account for. Refusing on a non-empty directory leaves that where a
  # person can read it and says so, where a recursive delete would destroy it
  # and report the teardown clean.
  spool_existing "$1" || return 0
  [ ! -d "$SPOOL_DIR" ] \
    || rmdir -- "$SPOOL_DIR" \
    || die "the spool directory $SPOOL_DIR still holds something gang could not archive, so it has not been deleted and nothing further has been ended — read what is in it, then remove it by hand"
  tmux set-option -uw -t "$1" @gl_spool 2>/dev/null || true
}

# ORPHANS. A spool directory outlives the window that named it whenever the
# window did not die through `drop` or `down` — an external kill-window, or a
# tmux server that goes away and takes every window's options with it. The
# directory is then unreachable by every command gang has, because all of them
# resolve a spool through @gl_spool on a live window. Only the filesystem still
# knows it is there, and any mail in it is invisible rather than lost.
SPOOL_ORPHANS="" SPOOL_FOREIGN=""
spool_orphans() { # every spool directory no live window claims; 1 = cannot tell
  # WINDOWS ARE THE ONLY REGISTER OF A LIVE SPOOL IDENTITY, which is the same
  # thing spool_mint says: nothing on disk records which window a reservation
  # was taken for. So "nobody holds this" is a claim about ONE reading of the
  # tmux server, and a reading that failed is not an empty one. Answering a
  # failed read as "no window holds anything" would call every live agent's
  # spool an orphan, so the failure comes back to the caller to act on.
  local root e token live nl=$'\n'
  SPOOL_ORPHANS=""; SPOOL_FOREIGN=""
  root="$(spool_root_of)"
  [ -d "$root" ] || return 0
  live="$(tmux list-windows -a -F '#{@gl_spool}' 2>/dev/null)" || return 1
  for e in "$root"/* "$root"/.[!.]* "$root"/..?*; do
    [ -e "$e" ] || [ -L "$e" ] || continue
    token="${e##*/}"
    # NOT A DIRECTORY GANG MINTED IS NOT A DIRECTORY GANG SWEEPS. A token is
    # twenty-odd hex characters under a directory this user owns; anything else
    # under the spool root was put there by something that is not gang, and the
    # same rule spool_existing keeps — refusing to act on a path it cannot
    # account for — applies with more force to a path no window even points at.
    # Reported rather than skipped: a stray nobody names is a stray nobody
    # removes, and the root then grows residue that looks like gang's.
    if [ -L "$e" ] || [ ! -d "$e" ] || [ ! -O "$e" ]; then
      SPOOL_FOREIGN="$SPOOL_FOREIGN$token$nl"; continue
    fi
    case "$token" in *[!a-f0-9]*|'') SPOOL_FOREIGN="$SPOOL_FOREIGN$token$nl"; continue ;; esac
    case "$nl$live$nl" in *"$nl$token$nl"*) continue ;; esac
    SPOOL_ORPHANS="$SPOOL_ORPHANS$token$nl"
  done
  return 0
}

spool_orphan_report() { # one line naming what is under the spool root and unowned
  # NAMED, NOT COUNTED. The whole defect this answers is that a person had to
  # list the spool root by hand to find held mail, so a number would reproduce
  # it: what is needed is the path to read.
  local root token entries n line
  root="$(spool_root_of)"
  spool_orphans || {
    printf '%s\n' "$(colour "$C_BAD" "orphaned spools: UNKNOWN — gang could not read the tmux server's window list, so it cannot tell a dead session's spool from a live agent's (read $root by hand)")"
    return 0
  }
  while IFS= read -r token; do
    [ -n "$token" ] || continue
    n=0
    for entries in "$root/$token"/* "$root/$token"/.[!.]* "$root/$token"/..?*; do
      { [ -e "$entries" ] || [ -L "$entries" ]; } && n=$((n + 1))
    done
    line="orphaned spool $root/$token — no live window claims it"
    [ "$n" -eq 0 ] || line="$line; $n child(ren) in it"
    printf '%s\n' "$(colour "$C_BAD" "$line")"
  done <<EOF
$SPOOL_ORPHANS
EOF
  while IFS= read -r token; do
    [ -n "$token" ] || continue
    printf '%s\n' "$(colour "$C_BAD" "under the spool root and not gang's: $root/$token — gang did not mint it and will not read, archive or remove it")"
  done <<EOF
$SPOOL_FOREIGN
EOF
}

spool_sweep_orphans() { # archive and retire every spool no live window claims
  # RUN WHERE THE ANSWER IS CHEAPEST AND SAFEST: immediately after a session is
  # created, when the server this reads is one gang has just proved it can talk
  # to and the only spool gang owns is the one it has just minted. Every other
  # directory under the root belonged to a window that is gone.
  local root token dir swept=0
  root="$(spool_root_of)"
  spool_orphans || {
    printf '%s\n' "$(colour "$C_BAD" "orphaned spools were NOT swept: gang could not read the tmux server's window list, so it cannot tell a dead session's spool from a live agent's — read $root by hand")" >&2
    return 0
  }
  while IFS= read -r token; do
    [ -n "$token" ] || continue
    dir="$root/$token"
    # THE SWEEP NEVER STOPS THE SESSION IT RUNS IN. A stray this cannot archive
    # is reported and left exactly where it is; dying here would make one
    # unaccountable directory refuse every `up` until a person removed it, and
    # the mail in every OTHER orphan would stay invisible in the meantime.
    if ! spool_dir_preflight "$dir"; then
      printf '%s\n' "$(colour "$C_BAD" "$SPOOL_PREFLIGHT_ERROR, so it was left alone — nothing in it has been moved. Read it, then remove it by hand")" >&2
      continue
    fi
    spool_dir_archive "$dir" "orphan-$token"
    rmdir -- "$dir" 2>/dev/null \
      || { printf '%s\n' "$(colour "$C_BAD" "the orphaned spool $dir was emptied into the archive but could not be removed — remove it by hand")" >&2
           continue; }
    swept=$((swept + 1))
  done <<EOF
$SPOOL_ORPHANS
EOF
  [ "$swept" -eq 0 ] \
    || printf '%s\n' "$(colour "$C_WORK" "swept $swept orphaned spool director(ies) from $root — they belonged to windows that are gone")"
  while IFS= read -r token; do
    [ -n "$token" ] || continue
    printf '%s\n' "$(colour "$C_BAD" "under the spool root and not gang's: $root/$token — gang did not mint it and will not read, archive or remove it")" >&2
  done <<EOF
$SPOOL_FOREIGN
EOF
}

spool_drain() { # $1 window id; whole queue oldest-first; optional $2 = locked
  local e claim rc err failed unver busy_rc=0 compaction_rc=0 witness="" keep_lock=0 mismatch=""
  local bundle="" frags="" claims="" n=0 nl=$'\n'
  spool_existing "$1" || return 4
  [ -d "$SPOOL_DIR" ] || return 4
  # LOCK BEFORE THE FIRST CLAIM. The queue is one oldest-first submission, so
  # two native edges must not split its files into two bundles before inject
  # serializes only their pastes. Every ordinary sender uses this same lock.
  case "${2:-}" in
    '') lock_pane "$1" ;;
    locked) [ -n "$LOCK_PATH" ] || die "internal: spool_drain called locked without a pane lock"
            keep_lock=1 ;;
    *) die "internal: spool_drain received unknown lock mode '$2'" ;;
  esac
  mismatch="$(identity_mismatch_read "$1")" || mismatch=""
  if [ -n "$mismatch" ]; then
    printf 'spool drain stopped before claiming: session-lost (%s); the spool remains waiting\n' "$mismatch" >&2
    [ "$keep_lock" -eq 1 ] || lock_release
    return 3
  fi
  # Copy-mode and its cousins are operator-owned tmux UI, not the target pty.
  # Refuse before the first claim: no entry leaves the live queue, no paste or
  # Enter is interpreted as a mode command, and scroll/selection is preserved.
  if ! pane_mode_free "$1"; then
    printf 'spool drain stopped before claiming: tmux mode owns the target pane; the spool remains waiting\n' >&2
    [ "$keep_lock" -eq 1 ] || lock_release
    return 3
  fi
  # READ UNDER THE SAME HOLD AS THE CLAIM. A sender can finish between a
  # boundary's readiness check and this worker taking the lock; treating that
  # moving target as idle would recreate the mid-turn composer handoff this
  # spool exists to avoid. Foreground startup drains use this function too, so
  # the invariant cannot drift between the two paths.
  # An open compaction has its own attributed continuation path. Peer steering
  # must wait for PostCompact: accepting arbitrary mail into that native queue
  # would widen the one compaction exception beyond the message that owns it.
  compaction_witness "$1" || compaction_rc=$?
  busy "$1" || busy_rc=$?
  case "$busy_rc" in
    1) ;;
    0|2)
       if [ "${GANG_MIDTURN_INPUT:-}" = steer ] \
          && [ "$compaction_rc" -eq 1 ] \
          && ! occupied "$1" && composer_settled "$1" && input_clear "$1"; then
         # The collar declares that Enter against this free mid-turn composer
         # is native steering. Attribution still landed first, under this lock.
         witness=steer
       else
         if [ "$busy_rc" -eq 0 ]; then
           if [ "$compaction_rc" -eq 0 ]; then
             printf 'spool drain stopped before claiming: the target is compacting, so peer input waits for PostCompact; the spool remains waiting\n' >&2
           else
             printf 'spool drain stopped before claiming: the target still has a live turn and no free collar-declared steering composer; the spool remains waiting\n' >&2
           fi
         else
           printf 'spool drain stopped before claiming: the target is not provably idle and has no free collar-declared steering composer; the spool remains waiting\n' >&2
         fi
         [ "$keep_lock" -eq 1 ] || lock_release
         return 3
       fi ;;
    *) die "internal: busy returned unknown verdict $busy_rc" ;;
  esac
  for e in "$SPOOL_DIR"/[0-9]*; do
    [ -f "$e" ] || continue
    claim="$SPOOL_DIR/sending-${e##*/}"
    mv -- "$e" "$claim" 2>/dev/null || continue
    spool_read "$claim"
    bundle="${bundle:+$bundle$nl$nl}$SPOOL_BODY"
    frags="${frags:+$frags, }$SPOOL_FRAG"
    claims="${claims:+$claims$nl}$claim"
    n=$((n + 1))
  done
  if [ "$n" -eq 0 ]; then
    [ "$keep_lock" -eq 1 ] || lock_release
    return 4
  fi
  rc=0
  # The nested shell captures inject's diagnostic. It must not inherit the
  # parent's EXIT trap: this worker owns the lock until claims are retired or
  # returned, and inject's `locked` mode deliberately leaves it in place.
  err="$(trap - EXIT; inject "$1" "$bundle" "" locked "$witness" 2>&1)" || rc=$?
  case "$rc" in
    0) while IFS= read -r claim; do
         [ -n "$claim" ] || continue
         rm -f -- "$claim" \
           || die "delivered $n spooled message(s) and could not remove $claim — it stays claimed rather than live, so nothing will deliver it twice, but the file has to go by hand"
       done <<EOF
$claims
EOF
       ;;
    3) # Refused, so nothing was typed: every body is still its sender's and
       # every entry goes back in line under its own stamp, in its own order.
       while IFS= read -r claim; do
         [ -n "$claim" ] || continue
         e="$SPOOL_DIR/${claim##*/sending-}"
         mv -- "$claim" "$e" 2>/dev/null \
           || printf 'a refused spooled message could not be returned to the spool and is held at %s\n' "$claim" >&2
       done <<EOF
$claims
EOF
       printf 'spool drain stopped with %s message(s) still waiting: %s\n' \
         "$n" "${err##*$'\n'}" >&2
       [ "$keep_lock" -eq 1 ] || lock_release
       return 3 ;;
    5) # TYPED, AND THE OUTCOME UNREADABLE — which is not the arm below. There
       # gang watched and saw nothing enter the session; here it watched the
       # keys go in and then lost the screen, so the bundle may already be in
       # front of its recipient. Both are "gang will not send this again", and
       # only one of them is "your message did not arrive". They are named
       # apart on disk so every later reader of this directory — status,
       # roster, mail, the teardown archive — can tell them apart too.
       while IFS= read -r claim; do
         [ -n "$claim" ] || continue
         unver="$SPOOL_DIR/unverified-${claim##*/sending-}"
         mv -- "$claim" "$unver" || unver="$claim"
       done <<EOF
$claims
EOF
       printf "a bundle of %s spooled message(s) was typed into the composer and its submission could not be verified — it may already have been delivered, so gang will not send it again; it is recorded in %s (%s): %s\n" \
         "$n" "$SPOOL_DIR" "$frags" "${err##*$'\n'}" >&2
       [ "$keep_lock" -eq 1 ] || lock_release
       return 5 ;;
    *) # Unverified: the bundle may or may not have landed, so every entry in it
       # is held where a person can read it rather than sent again.
       while IFS= read -r claim; do
         [ -n "$claim" ] || continue
         failed="$SPOOL_DIR/failed-${claim##*/sending-}"
         mv -- "$claim" "$failed" || failed="$claim"
       done <<EOF
$claims
EOF
       printf "a bundle of %s spooled message(s) was not verified and is held in %s (%s): %s\n" \
         "$n" "$SPOOL_DIR" "$frags" "${err##*$'\n'}" >&2
       [ "$keep_lock" -eq 1 ] || lock_release
       return 1 ;;
  esac
  [ "$keep_lock" -eq 1 ] || lock_release
}

spool_drain_after_event() { # $1 window id, $2 collar, optional $3 = midturn
  local ready=0 box_rc=0 boot="${GANG_BOOT_TIMEOUT:-30}"
  load_collar "$2"
  if [ "${3:-}" = midturn ]; then
    [ "$GANG_MIDTURN_INPUT" = steer ] \
      || die "collar '$2' no longer declares steering input for its mid-turn drain"
    spool_drain "$1"
    return
  fi
  require_whole GANG_BOOT_TIMEOUT "$boot" seconds
  wait_ready "$1" "$boot" || ready=$?
  if [ "$ready" -ne 0 ]; then
    # A readable obstruction is an ordinary refusal: nothing was typed, and a
    # later boundary may expose the same composer empty. An unreadable pane is
    # different. The harness announced that its turn ended and the drain still
    # cannot establish a landing zone, so silently treating that as another
    # healthy retry strands the queue behind every later boundary. Keep every
    # entry live and unclaimed, but leave a failure fact status can expose.
    if ! declare -F collar_input >/dev/null; then
      printf "collar '%s' declares no collar_input; the native delivery boundary exposed no composer Gangline can address, so no delivery was attempted and the spool remains waiting\n" \
        "$2" >&2
      return 1
    fi
    input_read "$1" >/dev/null || box_rc=$?
    [ "$box_rc" -ne 0 ] \
      || return 3
    if [ "$box_rc" -eq 4 ]; then
      printf 'the native delivery boundary exposed a composer belonging to a selected in-process subagent, where a delivery would reach the child rather than this agent; no delivery was attempted and the spool remains waiting\n' >&2
      return 1
    fi
    printf 'the native delivery boundary did not expose a readable composer (composer reading status %s); no delivery was attempted and the spool remains waiting\n' \
      "$box_rc" >&2
    return 1
  fi
  spool_drain "$1"
}

spool_drain_dispatch() { # $1 window id, $2 collar, optional $3 = midturn
  # No in-progress flag. The pane lock is taken before any claim, so a crossed
  # worker refuses without touching the queue. A flag would add a state that
  # outlives a killed worker and wedges the spool silently.
  [ "$(spool_count "$1")" -gt 0 ] || return 0
  (
    trap '' HUP INT TERM
    local err="" rc=0
    err="$(spool_drain_after_event "$1" "$2" "${3:-}" 2>&1)" || rc=$?
    case "$rc" in
      0) tmux set-option -uw -t "$1" @gl_spool_failed 2>/dev/null || true ;;
      3) ;;
      4) ;;
      *) err="${err##*$'\n'}"
         [ -n "$err" ] || err="the spool drain failed"
         tmux set-option -w -t "$1" @gl_spool_failed "$err" 2>/dev/null || true ;;
    esac
    tmux wait-for -S "gang-spool-drain-$1" 2>/dev/null || true
  ) </dev/null >/dev/null 2>&1 &
  disown
}

spool_event() { # $1 window a native opportunity fired in, $2 collar, optional $3
  # The drain serializes on the WINDOW's lock. A lock named after the firing
  # pane would not exclude an ordinary send holding the window-named one.
  [ -n "$1" ] || return 0
  spool_drain_dispatch "$1" "$2" "${3:-}"
}

stall_failed_write() { # $1 = raising window, rest = reason; a hook never dies for it
  local win="$1"; shift
  tmux set-option -w -t "$win" @gl_stall_failed "$*" 2>/dev/null || true
}

stall_deliver() { # $1 target id, $2 target name, $3 raising name, $4 body
  local rc=0 err="" frag
  AGENT_ID="$1"
  AGENT_COLLAR="$(collar_read "$AGENT_ID")" || exit 1
  [ -n "$AGENT_COLLAR" ] \
    || die "window '$2' exists but is not a gang agent (gang adopt $2 -c <collar>)"
  load_collar "$AGENT_COLLAR"
  envelope "$3" "$4"
  err="$(send_live "$2" 2>&1)" || rc=$?
  case "$rc" in
    0) return 0 ;;
    3) if spool_available "$AGENT_ID" "$2"; then
         frag="${4%%$'\n'*}"
         [ "${#frag}" -le 40 ] || frag="${frag:0:40}…"
         spool_write "$AGENT_ID" "$3" "$ENVELOPE" "$frag"
         return 0
       fi
       [ -z "$err" ] || printf '%s\n' "$err" >&2
       printf '%s\n' "$SPOOL_UNAVAILABLE_WHY" >&2
       return 3 ;;
    *) [ -z "$err" ] || printf '%s\n' "$err" >&2
       return "$rc" ;;
  esac
}

# READ, DECIDE, ACT, STAMP IS ONE CRITICAL SECTION. Concurrent native witnesses
# can read the same standing option before either changes it: two stall events
# then deliver the same note, while two Stops can dispatch one compaction twice.
# tmux options offer no compare-and-set, so the claim is the same shape the
# drain uses for exactly this problem: an atomic filesystem operation that
# confers ownership, with the holder's pid recorded so a claim left by a killed
# process is recognised as stale rather than wedging every later event.
#
# The loser returns without acting. The key is window AND the event's identity:
# a stall kind, an auto-resume reset, or a self-compaction request token.
EVENT_CLAIM=""
EVENT_CLAIM_ERROR=""
event_claim() { # $1 family, $2 window, $3 key; 0 = this process owns the decision
  local family="$1" base path holder err=""
  EVENT_CLAIM=""
  EVENT_CLAIM_ERROR=""
  case "$family" in
    stall|auto-resume|self-compact) ;;
    *) EVENT_CLAIM_ERROR="unknown event-claim family '$family'"
       printf '%s\n' "$EVENT_CLAIM_ERROR" >&2
       return 2 ;;
  esac
  base="${GANG_LOCK_DIR:-/tmp/gangline-$(id -u)}"
  if ! err="$(lock_base "$base" 2>&1)"; then
    EVENT_CLAIM_ERROR="${err##*$'\n'}"
    [ -n "$EVENT_CLAIM_ERROR" ] || EVENT_CLAIM_ERROR="cannot establish the event-claim directory $base"
    printf '%s\n' "$EVENT_CLAIM_ERROR" >&2
    return 2
  fi
  lock_self_pid
  path="$base/$family-$(printf '%s' "$2-$3" | tr -c 'A-Za-z0-9' '_').claim"
  err="$(ln -s "$LOCK_SELF_PID" "$path" 2>&1)" \
    && { EVENT_CLAIM="$path"; return 0; }
  # A peer can release after our failed ln but before we inspect its symlink.
  # One immediate atomic retry distinguishes that crossed release from a
  # persistent inability to create claims. Owning this confirmation is still
  # evidence that another worker won this boundary, so release it without
  # acting and leave the request for a later Stop.
  if [ ! -e "$path" ] && [ ! -L "$path" ]; then
    if err="$(ln -s "$LOCK_SELF_PID" "$path" 2>&1)"; then
      if rm -f -- "$path"; then return 1; fi
      EVENT_CLAIM_ERROR="cannot release confirmation event claim $path"
      printf '%s\n' "$EVENT_CLAIM_ERROR" >&2
      return 2
    fi
  fi
  if [ ! -L "$path" ]; then
    EVENT_CLAIM_ERROR="cannot create event claim $path — ${err:-unknown error}"
    printf '%s\n' "$EVENT_CLAIM_ERROR" >&2
    return 2
  fi
  holder="$(readlink "$path" 2>/dev/null)" || return 1
  case "$holder" in
    ''|*[!0-9]*) EVENT_CLAIM_ERROR="event claim $path records an unreadable holder '$holder'"
                   printf '%s\n' "$EVENT_CLAIM_ERROR" >&2
                   return 2 ;;
    *[1-9]*) ;;
    *) EVENT_CLAIM_ERROR="event claim $path records invalid process id '$holder'"
       printf '%s\n' "$EVENT_CLAIM_ERROR" >&2
       return 2 ;;
  esac
  ! kill -0 "$holder" 2>/dev/null || return 1   # a live note of this kind is in flight
  if ! err="$(rm -f -- "$path" 2>&1)"; then
    EVENT_CLAIM_ERROR="cannot remove stale event claim $path — ${err:-unknown error}"
    printf '%s\n' "$EVENT_CLAIM_ERROR" >&2
    return 2
  fi
  err="$(ln -s "$LOCK_SELF_PID" "$path" 2>&1)" \
    && { EVENT_CLAIM="$path"; return 0; }
  # Another process can win after the stale holder is removed. That is ordinary
  # contention only when the replacement is itself a readable live claim.
  holder="$(readlink "$path" 2>/dev/null)" || {
    [ -e "$path" ] || [ -L "$path" ] || return 1
    holder=""
  }
  case "$holder" in
    ''|*[!0-9]*) ;;
    *[1-9]*) kill -0 "$holder" 2>/dev/null && return 1 ;;
  esac
  EVENT_CLAIM_ERROR="cannot replace stale event claim $path — ${err:-unknown error}"
  printf '%s\n' "$EVENT_CLAIM_ERROR" >&2
  return 2
}

event_claim_release() { [ -z "$EVENT_CLAIM" ] || rm -f -- "$EVENT_CLAIM"; EVENT_CLAIM=""; }

stall_note() { # $1 = raising pane/window target, $2 = kind; never fatal
  local raising="$1" raising_win="" kind="$2" notify target
  local rc=0 claim_rc=0
  notify="$(tmux show-options -qv -t "=$SESSION:" @gl_notify 2>/dev/null)" || notify=""
  [ -n "$notify" ] || return 0
  raising_win="$(tmux display-message -p -t "$raising" '#{window_id}' 2>/dev/null)" || raising_win=""
  [ -n "$raising_win" ] || return 0
  target="$(win_id "$notify" 2>/dev/null)" || {
    rc=$?
    case "$rc" in
      1) stall_failed_write "$raising_win" "notify target '$notify' does not exist" ;;
      3) stall_failed_write "$raising_win" \
           "notify target '$notify' is the window title of another registered agent" ;;
      *) stall_failed_write "$raising_win" "notify target '$notify' is ambiguous" ;;
    esac
    return 0
  }
  [ "$target" != "$raising_win" ] || return 0
  event_claim stall "$raising_win" "$kind" || claim_rc=$?
  case "$claim_rc" in
    0) ;;
    1) return 0 ;;
    *) stall_failed_write "$raising_win" \
         "could not establish the stall-note claim: ${EVENT_CLAIM_ERROR:-the claim mechanism returned no diagnostic}"
       return 0 ;;
  esac
  stall_note_claimed "$raising" "$raising_win" "$kind" "$notify" "$target" || true
  event_claim_release
  return 0
}

stall_note_claimed() { # the debounce decision and its delivery, under the claim
  local raising="$1" raising_win="$2" kind="$3" notify="$4" target="$5"
  local recorded_kind="" recorded_epoch="" extra="" now rc=0 err="" raw=""
  local raising_name body

  raw="$(tmux show-options -wqv -t "$raising_win" @gl_stall 2>/dev/null)" || raw=""
  read -r recorded_kind recorded_epoch extra <<<"$raw"
  now="$(date +%s)"
  if [ "$recorded_kind" = "$kind" ] && [ -z "$extra" ] \
     && [[ "$recorded_epoch" =~ ^[0-9]+$ ]] \
     && [ "$recorded_epoch" -le "$now" ] \
     && [ $(( now - recorded_epoch )) -lt "$GANG_STALL_REPEAT" ]; then
    return 0
  fi

  raising_name="$(agent_name_of "$raising")"
  body="stall: $raising_name is awaiting input ($kind) — inspect with gang capture $raising_name"
  err="$(stall_deliver "$target" "$notify" "$raising_name" "$body" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ]; then
    tmux set-option -w -t "$raising_win" @gl_stall "$kind $now" 2>/dev/null || true
    tmux set-option -uw -t "$raising_win" @gl_stall_failed 2>/dev/null || true
    return 0
  fi
  err="${err##*$'\n'}"
  [ -n "$err" ] || err="stall note delivery failed"
  stall_failed_write "$raising_win" "$err"
  return 0
}

stall_clear() { tmux set-option -uw -t "$1" @gl_stall 2>/dev/null || true; }

# SETTLED IS TWO SUCCESSFUL READINGS THAT AGREE, and nothing weaker. A box that
# was never read is not a box nobody is typing into: settled is a positive
# finding, and a caller spends it by pasting into that composer and pressing
# Enter. So absence is not evidence here, whether it turns up in one look or in
# both — a collar that cannot report a refused read answers a refusal with the
# same status it uses for a pane carrying no composer, so two refusals arrive as
# two absences that agree with each other perfectly. Comparing what the looks
# FOUND accepts that pair. Requiring both to have PARSED A BOX does not, and no
# wording of the first comparison reaches the second.
#
# WHAT THE STRICTNESS COSTS, because it is not free. Every caller that can spend
# this verdict as permission asks `occupied` first, and that gate usually passes
# only a pane whose box was read — but not always. With no box drawn and a
# matching busy marker, its last tier answers not-occupied without reading one.
# A composer absent for both looks here and drawn again by the time the emptiness
# guard reads it is therefore a real sequence, and this refuses a delivery there
# that comparing contents alone would have made. The refusal is fail-closed and
# nothing is typed: where the collar declares a native turn boundary the body
# parks and drains at the next one, and where it declares none the sender is told
# to send again once the target is idle. The cost is a delivery deferred against
# a screen that was moving while gang was deciding, which is the trade this
# guard exists to make.
composer_settled() { # $1 = window id; 0 = nobody is typing into the box right
                     # now, 1 = somebody is, 3 = the pane could not be read,
                     # 4 = no settled reading of the box
  declare -F collar_input >/dev/null || return 0
  local a b a_rc=0 b_rc=0
  a="$(input_read "$1")" || a_rc=$?
  [ "$a_rc" -ne 3 ] || return 3
  sleep 0.3
  b="$(input_read "$1")" || b_rc=$?
  [ "$b_rc" -ne 3 ] || return 3
  [ "$a_rc" -eq 0 ] && [ "$b_rc" -eq 0 ] || return 4
  [ "$a" = "$b" ]
}

box_class() { # $1 = window id, $2 = the reading refused on, $3 = target name,
              # $4 = that reading's status (non-zero = the box could not be read)
  # What is in that box, in one word, with the look that settles it. `gang
  # capture` hands back the raw pane, where a harness's dim suggested-prompt
  # placeholder reads exactly like a half-written line — that misreading has
  # been made in public. `gang composer` prints the collar's styled reading:
  # what a human typed and nothing else. A placeholder never reaches a refusal
  # at all, because that same reading strips it before delivery ever looks.
  if ! declare -F collar_input >/dev/null; then
    printf 'whole-pane: collar %s declares no input reader, so this is the pane, not a box (gang capture %s)' \
      "${AGENT_COLLAR:-loaded}" "$3"
    return
  fi
  # A box taller than its pane is drawn and is taking input; what it lacks is
  # room to render. Reporting that as a harness refusing input sends the reader
  # after the wrong thing — the window is short, not stuck.
  if [ "${4:-0}" -eq 2 ]; then
    printf 'clipped: the composer is taller than the pane, so its box runs past the bottom and cannot be read (make the window taller, then gang composer %s)' "$3"
    return
  fi
  if [ "${4:-0}" -eq 3 ]; then
    printf 'unread: the pane itself could not be read, so whether a box is drawn there is unknown (gang capture %s)' "$3"
    return
  fi
  # A DRAWN BOX THAT BELONGS TO SOMEBODY ELSE. Reporting this as a harness
  # refusing input sends the reader after a stuck agent; the agent is fine and
  # its screen is showing a child it launched.
  if [ "${4:-0}" -eq 4 ]; then
    printf 'subagent: the composer on screen belongs to a selected in-process subagent, so typing there would reach the child (gang capture %s)' "$3"
    return
  fi
  if [ "${4:-0}" -ne 0 ]; then
    printf 'unreadable: the harness is not taking input (gang capture %s)' "$3"
    return
  fi
  # A successful read of an empty box. The classification look is taken after
  # the decision it names, so it can catch the obstruction leaving between the
  # two — an operator's C-u, a queue draining. Reporting that as a box gang
  # could not read would diagnose a healthy harness as a broken one on the
  # strength of it having become reachable.
  if [ -z "$2" ]; then
    printf 'cleared: empty when gang looked again, so the obstruction has gone (gang status %s)' "$3"
    return
  fi
  if box_queued "$2"; then
    printf 'parked: the harness queued earlier input (gang flush %s)' "$3"
    return
  fi
  local want
  want="$(tmux show-options -wqv -t "$1" @gl_staged_box)"
  if [ -n "$want" ] && [ "$want" = "$2" ]; then
    printf "staged: gang's own undelivered body (gang composer %s)" "$3"
    return
  fi
  # Human authorship is not the leftover case. The legs that record a paste
  # whose fate gang never saw — the box unreadable after the paste, unreadable
  # after the Enter, the harness parking it — deliberately record no rendering
  # to match, because there was none to read. A staged note beside a box gang
  # cannot match is gang's own text as plausibly as anybody's, and naming it a
  # human draft is the invented-provenance mistake this whole classification
  # exists to stop making. The note says what gang put there; status prints it.
  if [ -n "$(tmux show-options -wqv -t "$1" @gl_staged)" ]; then
    printf 'unattributed: gang recorded an undelivered paste here and cannot match it to this box (gang status %s)' "$3"
    return
  fi
  printf 'draft: a human line gang did not write (gang composer %s)' "$3"
}

staged_note() { # $1 = window id -> what gang knows about an unsubmitted paste there
  tmux show-options -wqv -t "$1" @gl_staged
}

staged_current() { # $1 = window id -> the record, freshness-checked at read time
  local note box
  note="$(staged_note "$1")"
  [ -n "$note" ] || return 0
  # The record is state; the box is fresher evidence. Staged input can flush
  # outside gang's sight — an operator's Enter, a queue draining at a turn
  # boundary — and a claim the box refutes must not be reported as current.
  # An empty box gets the verdict stage_clear renders at delivery time,
  # "whoever cleared it, it is gone", here rendered at reporting time; an
  # unreadable box cannot refute the record, so the record stands.
  if box="$(landing_zone "$1")" && ! grep -q '[^[:space:]]' <<<"$box"; then
    stage_forget "$1"
    return 0
  fi
  printf '%s\n' "$note"
}

# THE THIRD STATE IS CLOSED BY A LATER READ, never by a watcher. Gang records
# that the harness parked a body; the composer is fresher evidence than that
# record, and any command that reports on this window re-reads it here. A hint
# that is gone means the harness drained its queue, so the record retires and
# leaves the same mark stage_forget leaves — the absence of a record has two
# causes, and "it drained" must not read as "there was never one".
#
# Keyed on the declared hint rather than on emptiness: an unreadable box refutes
# nothing, so the record stands and the state stays reported.
parked_current() { # $1 = window id -> the parked body, freshness-checked at read time
  local rec box
  declare -F collar_input >/dev/null || return 0
  rec="$(tmux show-options -wqv -t "$1" @gl_parked 2>/dev/null)" || rec=""
  [ -n "$rec" ] || return 0
  if box="$(landing_zone "$1")" && ! box_queued "$box"; then
    tmux set-option -uw -t "$1" @gl_parked 2>/dev/null || true
    tmux set-option -uw -t "$1" @gl_parked_body 2>/dev/null || true
    tmux set-option -w -t "$1" @gl_parked_drained 1 2>/dev/null || true
    return 0
  fi
  printf '%s' "$rec"
}

stage_record() { # $1 = window id, $2 = the note, $3 = box rendering to match (may be empty)
  declare -F collar_input >/dev/null || return 0
  tmux set-option -w -t "$1" @gl_staged "$2"
  if [ -n "$3" ]; then tmux set-option -w -t "$1" @gl_staged_box "$3"
  else tmux set-option -uw -t "$1" @gl_staged_box 2>/dev/null || true; fi
}

stage_forget() { # $1 = window id
  tmux set-option -uw -t "$1" @gl_staged 2>/dev/null || true
  tmux set-option -uw -t "$1" @gl_staged_box 2>/dev/null || true
  # The parked-message record belongs to the same obstruction: once there is
  # nothing staged here, there is nothing for `flush` to read a composer back
  # against either.
  #
  # Retiring it leaves a mark, because the ABSENCE of a record has two causes
  # an operator must not confuse: gang never watched a park here, or it did and
  # the queue has since drained on its own — which is what a harness does when
  # a compaction ends. Both reach flush as an empty @gl_parked, and reaching
  # for flush a moment too late is how an operator gets told "no record" about
  # a message that was delivered.
  if [ -n "$(tmux show-options -wqv -t "$1" @gl_parked 2>/dev/null)" ]; then
    tmux set-option -w -t "$1" @gl_parked_drained 1 2>/dev/null || true
  fi
  tmux set-option -uw -t "$1" @gl_parked 2>/dev/null || true
  tmux set-option -uw -t "$1" @gl_parked_body 2>/dev/null || true
}

clear_box() { # $1 = window id, $2 = the box its caller just read (optional second
  declare -F collar_input >/dev/null || return 1
  local before after n=0 presses="${GANG_CLEAR_PRESSES:-40}"
  require_whole GANG_CLEAR_PRESSES "$presses" presses
  if [ -n "${2:-}" ] && grep -q '[^[:space:]]' <<<"$2" && input_clear "$1"; then
    return 1
  fi
  # A BOX GANG COULD NOT READ IS A BOX GANG DID NOT CLEAR, and that is the only
  # answer this function has room for: there is no third thing to do with a
  # keystroke here. The refused read leaves as an ordinary failure, and the
  # callers that need the distinction take it from their own reading.
  while [ "$n" -lt "$presses" ]; do
    input_clear "$1" && return 0
    before="$(input_read "$1")" || return 1
    pane_mode_free "$1" || return 1
    tmux send-keys -t "$1" C-u
    sleep 0.4
    after="$(input_read "$1")" || return 1
    [ "$after" != "$before" ] || return 1
    n=$((n + 1))
  done
  input_clear "$1"
}

stage_clear() { # $1 = window id; drop a recorded paste once it is provably ours and reachable
  local note box want
  note="$(staged_note "$1")"
  [ -n "$note" ] || return 0
  if occupied "$1"; then return 0; fi       # a keystroke here would act on the UI
  composer_settled "$1" || return 0         # somebody is typing: not gang's box to touch
  box="$(landing_zone "$1")" || return 0    # cannot see it: the record stands
  if ! grep -q '[^[:space:]]' <<<"$box"; then
    stage_forget "$1"; return 0             # empty box: whoever cleared it, it is gone
  fi
  want="$(tmux show-options -wqv -t "$1" @gl_staged_box)"
  [ -n "$want" ] && [ "$box" = "$want" ] || return 0
  clear_box "$1" "$box" || return 0
  stage_forget "$1"
}

inject() { # $1 window, $2 text, $3 head, $4 locked,
           # $5 witness: queued for compaction, steer for attributed mid-turn input
  local buf="gang-$$" frag before before_rc=0 after after_rc=0 paste_looks=0
  local tname keep_lock=0 mismatch=""
  frag="${2%%$'\n'*}"
  [ "${#frag}" -le 40 ] || frag="${frag:0:40}…"
  tname="$(agent_name_of "$1")"
  case "${4:-}" in
    '') lock_pane "$1" ;;
    locked) [ -n "$LOCK_PATH" ] || die "internal: inject called locked without a pane lock"; keep_lock=1 ;;
    *) die "internal: inject received unknown lock mode '$4'" ;;
  esac
  mismatch="$(identity_mismatch_read "$1")" || mismatch=""
  [ -z "$mismatch" ] \
    || refuse "refusing to deliver '$frag': $tname is session-lost ($mismatch). Nothing was typed; restart or re-hitch the intended native session before delivering to this pane"
  pane_mode_free "$1" \
    || refuse "refusing to deliver '$frag': tmux mode owns the pane of $tname, so paste and Enter would act on operator-owned mode state instead of the composer. Nothing was typed and the body is still the sender's — leave copy-mode, then try again"
  ! occupied "$1" \
    || refuse "refusing to deliver '$frag': $tname is occupied (authority unknown) — a UI owns its input box, so the paste would act on that UI instead of landing (gang attach).$(overlay_note "$1")"
  local settled_rc=0
  composer_settled "$1" || settled_rc=$?
  [ "$settled_rc" -ne 3 ] \
    || refuse "refusing to deliver '$frag': the input box of $tname cannot be read, so whether somebody is typing into it is unknown — the paste would land on top of whatever is there. Nothing was typed and the body is still the sender's (gang capture $tname)"
  [ "$settled_rc" -ne 4 ] \
    || refuse "refusing to deliver '$frag': gang got no settled reading of the input box of $tname — the two looks it takes did not both come back with a box it could parse, so whether somebody is typing into it is unknown. Either its harness is drawing or dropping the composer, or its collar is answering a refused read as an absent box. Nothing was typed and the body is still the sender's (gang capture $tname)"
  [ "$settled_rc" -eq 0 ] \
    || refuse "refusing to deliver '$frag': somebody is typing into $tname right now — the paste would interleave with their draft mid-word (try again in a moment)"
  stage_clear "$1"
  # A parked queue means the composer's Enter is queueing, not submitting:
  # nothing pasted now can enter the session, and an earlier message is
  # already waiting. Named for what it is rather than left to the emptiness
  # guard below, which would blame a half-written draft.
  local preflight
  if preflight="$(landing_zone "$1")" && box_queued "$preflight"; then
    refuse "refusing to deliver '$frag': the harness of $tname has parked earlier input in its own queue — its Enter is queueing rather than submitting, so nothing gang sends can enter the session until the queue is recovered (gang flush $tname; or by hand: gang attach, press Up to load the parked message, then Enter; if even that re-queues, gang drop $tname and hitch --resume). Nothing was typed and the body is still the sender's"
  fi
  if ! input_clear "$1"; then
    local onlyhead="" seen seen_rc=0
    [ "${3:-}" != head ] \
      || onlyhead=", and this text is only a command at the head of an empty one, so appended to a draft it would be literal text and would never run"
    # A second look, taken only to name what was refused. It decides nothing:
    # the refusal is already settled by the read above. Its status is carried
    # separately, because a read that fails and a read that succeeds on an
    # emptied box are opposite findings and only one of them is a sick harness.
    seen="$(landing_zone "$1")" || seen_rc=$?
    refuse "refusing to deliver '$frag' to $tname: its input box is not provably empty [$(box_class "$1" "$seen" "$tname" "$seen_rc")], so the paste would append to a half-written line and the Enter would submit that draft with this message glued to it$onlyhead. Nothing was typed and the body is still the sender's — try again once that box is clear"
  fi
  before="$(landing_zone "$1")" || before_rc=$?
  [ "$before_rc" -eq 0 ] \
    || refuse "refusing to deliver '$frag' to $tname: its input box cannot be read [$(box_class "$1" "" "$tname" "$before_rc")]. Nothing was typed and the body is still the sender's"
  printf '%s' "$2" | tmux load-buffer -b "$buf" -
  tmux paste-buffer -p -d -b "$buf" -t "$1"
  # Claude Code redraws a large multi-line composer in more than one frame.
  # A missing frame or the old empty one is not yet evidence that the paste
  # failed. Bound the rereads exactly as submission verification is bounded;
  # only the final unresolved state opens @gl_staged and fails closed.
  while [ "$paste_looks" -lt 15 ]; do
    sleep 0.4
    after_rc=0
    after="$(landing_zone "$1")" || after_rc=$?
    [ "$after_rc" -ne 0 ] || [ "$after" = "$before" ] || break
    paste_looks=$((paste_looks + 1))
  done
  if [ "$after_rc" -ne 0 ]; then
    stage_record "$1" "'$frag' was pasted into this box and the box could not be read afterwards — it may be sitting there unsent" ""
    die "cannot read the input box of $tname after pasting '$frag' — nothing was submitted, and the paste may be sitting unsent in that box (gang capture $tname)"
  fi
  if [ "$after" = "$before" ]; then
    # WHAT THE READINGS ALREADY PROVE, rather than a line picked off the pane.
    # Reaching here means the box read back and read back IDENTICAL, so the
    # composer is drawn and gang's own paste is not in it — and that pair is the
    # finding. The collar's occupied pattern cannot sharpen it: a transcript line
    # matching that pattern is not a UI on screen, which is why `occupied` asks
    # the composer a second question before spending a match, and here the
    # composer is drawn by construction. Quoting the first matching line named
    # whichever line matched first, usually an old one, and let pane prose into a
    # refusal as though gang had written it.
    stage_record "$1" "'$frag' was pasted into this box and it read back unchanged — either nothing landed or this box cannot be read reliably, so it may be sitting there unsent" ""
    die "delivery NOT verified: pasting '$frag' left the input box of $tname unchanged — that box is drawn and readable, and gang's own paste is not in it, so either the keys never reached the pane or something other than that composer is taking them. A native dialog painted over a live composer does exactly this.$(overlay_note "$1") Nothing was submitted and the body is still the sender's: read the screen with 'gang capture $tname', answer whatever owns it with 'gang attach', then send again"
  fi
  if occupied "$1"; then
    stage_record "$1" "'$frag' is staged unsent in this box — a modal took the screen before the Enter could be sent" "$after"
    die "refusing to submit '$frag': a modal took the screen of $tname while the paste was landing — the Enter that would have answered it was not sent, so the paste is staged unsent in that box (gang attach; gang clears it on the next safe delivery once the modal is gone)"
  fi
  pane_mode_free "$1" || {
    stage_record "$1" "'$frag' is staged unsent in this box — tmux mode took the pane before Enter could be sent" "$after"
    die "refusing to submit '$frag': tmux mode took the pane of $tname after the paste landed. Enter was NOT sent into operator-owned mode state; the paste is staged in the composer underneath (leave copy-mode, then gang attach)"
  }
  case "${5:-}" in
    # A continuation is typed at a harness that is compacting, so the harness's
    # own queue is where it is meant to wait. Parking is the landing here, not a
    # failed delivery.
    queued) submit_verify "$1" "$after" "$frag" paste park_ok "$2" ;;
    # A peer envelope entered only after its attributed spool was claimed.
    # The collar declares that Enter during a turn is accepted as native
    # steering, whether the next box frame is empty or shows its queue hint.
    steer) submit_verify "$1" "$after" "$frag" paste park_record "$2" ;;
    # Ordinary delivery accepts only a verified submission. A harness queue is
    # recovery state, not a landing: busy `park` collars spool before reaching
    # this function, so a queued reading here is unexpected and fails closed.
    '') submit_verify "$1" "$after" "$frag" paste '' "$2" ;;
    *) die "internal: inject received unknown witness mode '$5'" ;;
  esac
  [ "$keep_lock" -eq 1 ] || lock_release
}

# THE POST-ENTER HALF OF A VERIFIED SUBMISSION, shared by the paste path and by
# the parked-queue recovery `flush` performs. Both press one Enter against a box
# they have just read, and both owe the same proof afterwards, so there is one
# copy of it: two would drift, and the half that drifted would report a
# submission nobody saw.
#
# The callers differ in exactly one thing — what may be done with a box that
# never changed. Gang may clear back out its OWN paste; a body recalled from the
# harness's queue is the harness's, and clearing it would delete the very
# message being recovered.
submit_verify() { # $1 window id, $2 the box the Enter goes against, $3 fragment,
                  # $4 paste|recall, $5 park_ok|park_record accepted landing,
                  # $6 the body gang composed, recorded if the harness parks it
  local tname verb noun stuck mayclear unchanged=0 looks=0 posted
  tname="$(agent_name_of "$1")"
  case "$4" in
    paste)  verb="pasted" noun="paste" stuck=", and would not clear" mayclear=1 ;;
    recall) verb="recalled out of the harness's queue" noun="recalled message"
            stuck="" mayclear=0 ;;
    *) die "internal: submit_verify was given mode '$4'" ;;
  esac
  pane_mode_free "$1" || {
    stage_record "$1" "'$3' is staged unsent in this box — tmux mode took the pane before Enter could be sent" "$2"
    die "submit NOT performed: tmux mode owns the pane of $tname, so Enter was NOT sent; the $noun is staged in the composer underneath (leave copy-mode, then gang attach)"
  }
  # This Enter is Gangline's own positive turn edge. Stamp it before the key so
  # a native UserPromptSubmit/Stop pair can overwrite it even when a tiny turn
  # opens and closes before submission verification returns. A collar without
  # Stop cannot close the bracket, and a compaction continuation is meant to
  # remain queued, so neither acquires this event fact.
  [ "${TICK_PASS:-0}" != 1 ] || [ "${GANG_STOP_HOOK:-}" != 1 ] || [ -n "${5:-}" ] \
    || turn_state_write "$1" open
  tmux send-keys -t "$1" Enter
  while :; do
    sleep 0.4
    if posted="$(landing_zone "$1")"; then
      [ "$posted" = "$2" ] || break
      unchanged=$((unchanged + 1))
      if [ "$unchanged" -ge 5 ]; then
        if [ "$mayclear" -eq 1 ] && clear_box "$1"; then
          die "submit NOT verified: '$3' was $verb into the input box of $tname and never sent — the $noun has been cleared back out of that box"
        fi
        stage_record "$1" "'$3' is staged unsent in this box — it was $verb, never sent$stuck" "$posted"
        die "submit NOT verified: '$3' was $verb into the input box of $tname, never sent$stuck — it is staged there now and has to be cleared by hand (gang attach)"
      fi
    else
      # Counted only where the read FAILED, because an unreadable box is what
      # this bound reports. Counted on every pass it was a cap on the whole
      # loop, so a box that read back perfectly and had simply not changed yet
      # could die claiming it could not be read — the one diagnosis the
      # operator disproves by looking at the pane, pointing at the wrong
      # repair. The unchanged bound above is what answers that case.
      looks=$((looks + 1))
      if [ "$looks" -ge 15 ]; then
        stage_record "$1" "'$3' was $verb here and Enter sent, but the box never read back — it may be sitting there unsent" ""
        unverified "submission unverifiable, and NOT ruled out: '$3' was $verb into the input box of $tname, Enter was pressed against it, and the box never read back afterwards — so whether it entered the session or is sitting there unsent is unknown. Gang will not send it again on a guess; read the screen with 'gang capture $tname' and re-send only if it is not there"
      fi
    fi
  done
  # The box changing is not yet proof of ENTRY. Where the collar declares
  # queue evidence, the reading that broke the loop — and two more, because
  # the hint can paint a beat after the box empties — must not be the
  # harness's own parked-input hint. A parked message renders in the
  # transcript exactly like a submitted one, so this composer reading is the
  # one place the two states differ.
  if [ -n "$GANG_QUEUED_REGEX" ] && [ "${5:-}" != park_ok ]; then
    local qlooks=0
    while :; do
      if box_queued "$posted"; then
        case "${5:-}" in
          park_record)
            # Peer steering entered only from an attributed spool. Preserve
            # the exact native-queue landing for status and flush even after
            # the claim retires.
            stage_forget "$1"
            parked_record "$1" "$2" "${6:-}"
            return 0 ;;
          '') submit_parked "$1" "$3" "$4" "$2" "${6:-}" ;;
          *) die "internal: submit_verify received unknown park mode '$5'" ;;
        esac
      fi
      qlooks=$((qlooks + 1))
      [ "$qlooks" -lt 3 ] || break
      sleep 0.4
      # An unreadable reread is AMBIGUITY, not proof of submission: once the
      # collar declares queue evidence, gang has promised to tell entered
      # from parked, and a capture it cannot read answers neither. Fail
      # closed with the uncertainty named, never fall through to success.
      posted="$(landing_zone "$1")" || {
        stage_record "$1" "'$3' was $verb and Enter sent, but the box stopped reading back while gang was checking for parked input — whether it entered the session or sits in the harness's queue is unknown" ""
        unverified "submission unverifiable, and NOT ruled out: '$3' was $verb into the input box of $tname and Enter was pressed, the box changed, and it then stopped reading back before gang could tell an entered message from a parked one — so whether it entered the session or sits in the harness's queue is unknown. Gang will not send it again on a guess; read the screen with 'gang capture $tname', and if it is parked recover it with 'gang flush $tname'"
      }
    done
  fi
  # A verified submission retires any prior staged record for THIS window. Not
  # redundant with the head-of-delivery clearing: each guard above re-reads
  # the box, and an obstruction can drain between stage_clear's read and
  # input_clear's — a queue emptying at a turn boundary mid-send — leaving a
  # retained record beside a delivery that then verified. The clearing
  # evidence is the gone obstruction this verified path just walked through,
  # never retroactive proof the RECORDED body was delivered.
  stage_forget "$1"
}

parked_record() { # $1 window id, $2 whole composer reading before the parked Enter,
                  # $3 the body gang composed and pasted
  [ -z "$2" ] || tmux set-option -w -t "$1" @gl_parked "$2" 2>/dev/null || true
  # THE BODY, BESIDE THE RENDERING OF IT. The reading above says what the
  # composer looked like with this message in it, which is what later reads
  # test for freshness; it is not what the message IS. A harness may render a
  # pasted body as a placeholder that carries none of its text, so the reading
  # cannot be what a recovery reads a recalled composer back against.
  [ -z "$2" ] || tmux set-option -w -t "$1" @gl_parked_body "${3:-}" 2>/dev/null || true
  # A fresh park replaces the history: whatever drained before this one is no
  # longer the answer to "where did my message go".
  [ -z "$2" ] || tmux set-option -uw -t "$1" @gl_parked_drained 2>/dev/null || true
}

submit_parked() { # $1 window id, $2 fragment, $3 paste|recall, $4 the box the Enter went against,
                  # $5 the body gang composed
  local tname
  tname="$(agent_name_of "$1")"
  if [ "$3" = paste ]; then
    # What `flush` will read the composer back against, and it is the WHOLE
    # body rather than its first line: a record that stops at the first line
    # can be satisfied by a recalled message whose remainder was truncated,
    # altered or extended, and flush would submit that while reporting the
    # readback verified. The composer reading is recorded beside it, for the
    # freshness reads that ask whether this park is still the state of the
    # window — never as the artifact a recovery compares against.
    #
    # Recorded HERE and only here: this is the one moment gang knows both that
    # the harness parked something and exactly which body it parked.
    parked_record "$1" "$4" "${5:-}"
    stage_record "$1" "'$2' was pasted and Enter sent, but the harness parked it in its own input queue — it never entered the session; recover it with gang flush $tname" ""
    die "submit NOT verified: '$2' entered the composer of $tname but the harness parked it in its own input queue instead of the session. The Enter queued rather than submitted; recover it with gang flush $tname. If even that re-queues, the queue is hard-stuck: gang drop $tname and hitch --resume, then re-send — parked messages do not survive the harness"
  fi
  stage_record "$1" "'$2' was recalled out of the harness's queue and Enter sent, and the harness parked it again — it never entered the session" ""
  die "flush NOT verified: '$2' was loaded back into the composer of $tname and the Enter parked it in the harness's queue again. The queue is not draining, so no keystroke gang can send will submit it: gang drop $tname and hitch --resume, then re-send — parked messages do not survive the harness"
}

context_now() { # $1 = window id, collar loaded; read the native source
  declare -F collar_context >/dev/null || return 1
  collar_context "$1"
}

ctx_tokens() { # $1 = <used>k/<window>k (...) -> used and window in tokens
  [[ "$1" =~ ^([0-9]+)k/([0-9]+)k ]] || return 1
  printf '%s %s' "$(( BASH_REMATCH[1] * 1000 ))" "$(( BASH_REMATCH[2] * 1000 ))"
}

LIGHT_YELLOW=0
LIGHT_RED=0
LIGHT_RELATIVE=0
# A REFUSAL NAMES WHERE THE SPEC CAME FROM. The same grammar now arrives from
# three places — the operator's config, one agent's `--lights`, and a collar's
# own per-model default — and a malformed collar default reported as the
# operator's GANG_CONTEXT_LIGHTS sends them to edit a setting they never wrote.
# The origin note is looked up only for the unnamed caller, so the per-hook read
# below never pays for a config lookup it would not print.
context_lights_parse() { # $1 = off or yellow,red thresholds; $2 = subject for refusals
  local yellow red subject="${2:-}" note=""
  if [ -z "$subject" ]; then
    subject=GANG_CONTEXT_LIGHTS
    note="$(config_origin_note GANG_CONTEXT_LIGHTS)"
  fi
  LIGHT_YELLOW=0
  LIGHT_RED=0
  LIGHT_RELATIVE=0
  case "$1" in
    off|'') return 1 ;;
    *,*)
      yellow="${1%%,*}"
      red="${1##*,}"
      case "$yellow:$red" in
        *%:*%) LIGHT_RELATIVE=1; yellow="${yellow%\%}"; red="${red%\%}" ;;
        *%*)
          die "$subject must use the same unit for both thresholds: yellow,red tokens or yellow%,red%$note" ;;
      esac
      LIGHT_YELLOW="$yellow"
      LIGHT_RED="$red"
      case "$LIGHT_YELLOW:$LIGHT_RED" in
        *[!0-9:]*|:*|*:)
          die "$subject must be off or two thresholds: yellow,red tokens or yellow%,red%$note" ;;
      esac
      [ "$LIGHT_YELLOW" -gt 0 ] && [ "$LIGHT_RED" -gt "$LIGHT_YELLOW" ] \
        || die "$subject must increase from yellow to red, got '$1'$note"
      [ "$LIGHT_RELATIVE" -eq 0 ] || [ "$LIGHT_RED" -lt 100 ] \
        || die "$subject percentage thresholds must both be below 100%, got '$1'$note"
      return 0 ;;
    *) die "$subject must be off or two thresholds: yellow,red tokens or yellow%,red%$note" ;;
  esac
}

# WHICH THRESHOLDS SUIT AN AGENT IS A PER-MODEL QUESTION, and only the collar
# can answer it: one harness runs models whose native windows differ by more
# than fourfold, so a fraction leaving useful headroom in the larger one fires
# far too late in the smaller, and an absolute pair sized for the larger cannot
# fire in the smaller at all. `collar` asks the collar for the hitched model;
# an explicit spec from the operator overrides that answer for the whole team
# or for one agent.
#
# THE ANSWER IS A GLOBAL RATHER THAN STDOUT because a bad collar default is
# refused here: `die` inside $(...) ends only that subshell and the caller reads
# the empty string as a pass.
CONTEXT_LIGHTS_SPEC=""
CONTEXT_LIGHTS_SUBJECT=""
context_lights_resolve() { # $1 collar name, collar loaded; $2 model, $3 spec, $4 subject
  local answer="" rc=0
  CONTEXT_LIGHTS_SPEC="$3"
  CONTEXT_LIGHTS_SUBJECT="$4"
  [ "$3" = collar ] || return 0
  # A COLLAR THAT DECLARES NO DEFAULT LEAVES THE LIGHTS OFF, which is the same
  # answer it gave before defaults existed. Silence is not an error here.
  CONTEXT_LIGHTS_SPEC=off
  CONTEXT_LIGHTS_SUBJECT="collar '$1' context-light default for model '${2:-(none)}'"
  # A DEFAULT NEVER ARMS A LIGHT ITS OWN COLLAR CANNOT READ. Without a native
  # context source every hook would report the reading it could not take, on
  # every agent, for a light nobody asked for. An operator who names thresholds
  # explicitly still gets that report, because they asked for the light.
  declare -F collar_context >/dev/null || return 0
  declare -F collar_context_lights >/dev/null || return 0
  answer="$(collar_context_lights "$2")" || rc=$?
  case "$rc" in
    0) CONTEXT_LIGHTS_SPEC="$(printf '%s' "$answer" | config_sanitize)" ;;
    1) ;;
    *) die "hitch: collar '$1' returned unknown context-light-default status $rc for model '${2:-(none)}'" ;;
  esac
  [ -n "$CONTEXT_LIGHTS_SPEC" ] || CONTEXT_LIGHTS_SPEC=off
}

context_lights_for() { # $1 = window; load its hitch-time setting
  local spec
  spec="$(tmux show-options -wqv -t "$1" @gl_context_lights 2>/dev/null)" || spec=""
  context_lights_parse "${spec:-off}" "the context lights registered on this window"
}

CONTEXT_LIGHT=""
CONTEXT_LIGHT_ERROR=""
context_light_read() { # $1 = window, collar loaded; yellow|red, or 1 below
  local ctx pair used window yellow red rc=0
  CONTEXT_LIGHT=""
  CONTEXT_LIGHT_ERROR=""
  context_lights_for "$1" || return 1
  ctx="$(context_now "$1" 2>/dev/null)" || {
    rc=$?
    # Status 2 is the collar contract's readable-frame miss. Every other
    # failure says the source could not be read or interpreted at all.
    [ "$rc" -eq 2 ] && return 2
    return 4
  }
  pair="$(ctx_tokens "${ctx%%$'\n'*}")" || return 4
  read -r used window <<<"$pair"
  if [ "$window" -eq 0 ]; then
    CONTEXT_LIGHT_ERROR="Context lights invalid: this harness's native context source reported a zero-token window."
    return 3
  fi
  yellow="$LIGHT_YELLOW" red="$LIGHT_RED"
  if [ "$LIGHT_RELATIVE" -eq 1 ]; then
    yellow="$(( (window * yellow + 99) / 100 ))"
    red="$(( (window * red + 99) / 100 ))"
  elif [ "$red" -gt "$window" ]; then
    CONTEXT_LIGHT_ERROR="Context lights invalid: configured red threshold $red cannot fire in this harness's $window-token window. Re-hitch with reachable token thresholds or percentages."
    return 3
  fi
  if [ "$used" -ge "$red" ]; then
    CONTEXT_LIGHT=red
  elif [ "$used" -ge "$yellow" ]; then
    CONTEXT_LIGHT=yellow
  else
    return 1
  fi
}

ADVISORY_NOTE=""
context_light_note() { # $1 collar; append an edge to ADVISORY_NOTE
  local previous="" agent note="" ready="" miss="" notified="" rc=0
  load_collar "$1"
  context_light_read "$TMUX_PANE" || rc=$?
  previous="$(tmux show-options -wqv -t "$TMUX_PANE" @gl_context_light 2>/dev/null)" \
    || previous=""
  if [ "$rc" -eq 1 ]; then
    if [ "$previous" = unavailable ]; then
      tmux set-option -uw -t "$TMUX_PANE" @gl_context_miss \; \
        set-option -uw -t "$TMUX_PANE" @gl_context_miss_notified \; \
        set-option -uw -t "$TMUX_PANE" @gl_context_light 2>/dev/null || true
    else
      tmux set-option -uw -t "$TMUX_PANE" @gl_context_miss \; \
        set-option -uw -t "$TMUX_PANE" @gl_context_light 2>/dev/null || true
    fi
    return 0
  fi
  if [ "$rc" -eq 2 ] || [ "$rc" -eq 4 ]; then
    ready="$(tmux show-options -wqv -t "$TMUX_PANE" @gl_context_ready 2>/dev/null)" \
      || ready=""
    [ "$ready" = 1 ] || return 0
  fi
  if [ "$rc" -eq 2 ]; then
    [ "$previous" != unavailable ] || return 0
    miss="$(tmux show-options -wqv -t "$TMUX_PANE" @gl_context_miss 2>/dev/null)" \
      || miss=""
    case "$miss" in
      1) ;;
      2) return 0 ;;
      *)
        tmux set-option -w -t "$TMUX_PANE" @gl_context_miss 1 2>/dev/null \
          || return 0
        notified="$(tmux show-options -wqv -t "$TMUX_PANE" \
          @gl_context_miss_notified 2>/dev/null)" || notified=""
        [ "$notified" != 1 ] || return 0
        tmux set-option -w -t "$TMUX_PANE" @gl_context_miss_notified 1 \
          2>/dev/null || return 0
        note="Context beacon missed once: Gangline could read the pane, but this frame did not show the native context beacon. The last context light is unchanged; Gangline will check again."
        ADVISORY_NOTE="${ADVISORY_NOTE:+$ADVISORY_NOTE
}$note"
        return 0 ;;
    esac
    CONTEXT_LIGHT=unavailable
    note="Context beacon absent on consecutive checks: context lights are unavailable. Inspect the harness directly."
  elif [ "$rc" -eq 3 ]; then
    CONTEXT_LIGHT=invalid
    note="$CONTEXT_LIGHT_ERROR"
  elif [ "$rc" -eq 4 ]; then
    if [ "$previous" = unavailable ]; then
      tmux set-option -uw -t "$TMUX_PANE" @gl_context_miss 2>/dev/null || true
      return 0
    fi
    CONTEXT_LIGHT=unavailable
    note="Context lights unavailable: Gangline cannot read or interpret this harness's native context source. Inspect the harness directly."
  else
    [ "$rc" -eq 0 ] || return 0
  fi
  [ "$rc" -eq 2 ] \
    || tmux set-option -uw -t "$TMUX_PANE" @gl_context_miss 2>/dev/null \
    || true
  if [ "$previous" = unavailable ] || [ "$rc" -eq 3 ]; then
    tmux set-option -uw -t "$TMUX_PANE" @gl_context_miss_notified \
      2>/dev/null || true
  fi
  [ "$CONTEXT_LIGHT" != "$previous" ] || return 0
  if [ "$previous" = red ]; then
    case "$CONTEXT_LIGHT" in unavailable|invalid) ;; *) return 0 ;; esac
  fi
  if [ "$rc" -eq 2 ]; then
    tmux set-option -w -t "$TMUX_PANE" @gl_context_miss 2 \; \
      set-option -w -t "$TMUX_PANE" @gl_context_miss_notified 1 \; \
      set-option -w -t "$TMUX_PANE" @gl_context_light "$CONTEXT_LIGHT" \
      2>/dev/null || return 0
  elif [ "$rc" -eq 4 ]; then
    tmux set-option -w -t "$TMUX_PANE" @gl_context_miss_notified 1 \; \
      set-option -w -t "$TMUX_PANE" @gl_context_light "$CONTEXT_LIGHT" \
      2>/dev/null || return 0
  else
    tmux set-option -w -t "$TMUX_PANE" @gl_context_light "$CONTEXT_LIGHT" \
      2>/dev/null || return 0
  fi
  if [ -z "$note" ]; then
    agent="$(agent_name_of "$TMUX_PANE")"
    case "$CONTEXT_LIGHT" in
      yellow) note="Yellow context light: compact at the next natural checkpoint with gang compact $agent." ;;
      red) note="Red context light: finish the current arc and compact now with gang compact $agent." ;;
    esac
  fi
  ADVISORY_NOTE="${ADVISORY_NOTE:+$ADVISORY_NOTE
}$note"
}

USAGE_YELLOW=0
USAGE_RED=0
usage_lights_parse() { # $1 = off or yellow%,red% provider-use thresholds
  local yellow red
  USAGE_YELLOW=0 USAGE_RED=0
  case "$1" in
    off|'') return 1 ;;
    *%,*%)
      yellow="${1%%%,*}" red="${1##*,}" red="${red%\%}"
      case "$yellow:$red" in
        *[!0-9:]*|:*|*:)
          die "GANG_USAGE_LIGHTS must be off or two percentages, for example 90%,95%$(config_origin_note GANG_USAGE_LIGHTS)" ;;
      esac
      [ "$yellow" -gt 0 ] && [ "$red" -gt "$yellow" ] && [ "$red" -le 100 ] \
        || die "GANG_USAGE_LIGHTS must increase from yellow to red at or below 100%, got '$1'$(config_origin_note GANG_USAGE_LIGHTS)"
      USAGE_YELLOW="$yellow" USAGE_RED="$red"
      return 0 ;;
    *) die "GANG_USAGE_LIGHTS must be off or two percentages, for example 90%,95%$(config_origin_note GANG_USAGE_LIGHTS)" ;;
  esac
}

usage_lights_for() { # $1 = window; load its hitch-time setting
  local spec
  spec="$(tmux show-options -wqv -t "$1" @gl_usage_lights 2>/dev/null)" || spec=""
  usage_lights_parse "${spec:-off}"
}

# AUTO-RESUME IS ONE THRESHOLD, DECLARED SEPARATELY FROM THE LIGHTS. Warning an
# agent and arming its return are different decisions taken at different
# percentages: an operator may want a checkpoint reminder well before the point
# where committing to a wake at the reported reset is worth it. Coupling them
# would force one number to mean both.
AUTO_RESUME_AT=0
auto_resume_parse() { # $1 = off or one provider-used percentage
  local at
  AUTO_RESUME_AT=0
  case "$1" in
    off|'') return 1 ;;
    *%)
      at="${1%\%}"
      case "$at" in
        ''|*[!0-9]*)
          die "GANG_AUTO_RESUME must be off or one percentage, for example 97%$(config_origin_note GANG_AUTO_RESUME)" ;;
      esac
      [ "$at" -gt 0 ] && [ "$at" -le 100 ] \
        || die "GANG_AUTO_RESUME must be a percentage from 1 to 100, got '$1'$(config_origin_note GANG_AUTO_RESUME)"
      AUTO_RESUME_AT="$at"
      return 0 ;;
    *) die "GANG_AUTO_RESUME must be off or one percentage, for example 97%$(config_origin_note GANG_AUTO_RESUME)" ;;
  esac
}

auto_resume_for() { # $1 = window; load its hitch-time setting
  local spec
  spec="$(tmux show-options -wqv -t "$1" @gl_auto_resume 2>/dev/null)" || spec=""
  auto_resume_parse "${spec:-off}"
}

auto_resume_failed_write() { # $1 window, rest = operator-facing failure
  local win="$1"; shift
  local note
  note="$(printf '%s' "$*" | config_sanitize)"
  tmux set-option -w -t "$win" @gl_auto_resume_failed "$note" 2>/dev/null || true
}

auto_resume_prompt_witness() { # $1 pane, $2 collar, $3 UserPromptSubmit payload
  local pending submitted="" rc=0
  auto_resume_for "$1" || return 0
  pending="$(tmux show-options -wqv -t "$1" @gl_auto_resume_prompt 2>/dev/null)" \
    || pending=""
  if [ -z "$pending" ]; then
    # A prompt with no Gangline-owned marker starts a new operator/agent turn.
    # It opens a fresh one-hop episode, but it does not erase a refusal the
    # operator has not necessarily seen yet. A later positively owned automatic
    # turn clears that record; dropping the window retires all of its state.
    tmux set-option -uw -t "$1" @gl_auto_resume_own_turn 2>/dev/null || true
    return 0
  fi
  load_collar "$2"
  if ! declare -F collar_auto_resume_prompt >/dev/null; then
    rc=2
  else
    submitted="$(collar_auto_resume_prompt "$1" "$3")" || rc=$?
  fi
  tmux set-option -uw -t "$1" @gl_auto_resume_prompt 2>/dev/null || true
  if [ "$rc" -eq 0 ] && [ "$submitted" = "$pending" ]; then
    tmux set-option -w -t "$1" @gl_auto_resume_own_turn 1 2>/dev/null || true
    tmux set-option -uw -t "$1" @gl_auto_resume_failed 2>/dev/null || true
    return 0
  fi
  # FAIL CLOSED FOR THIS TURN. A missing/changed prompt field makes "Gangline's
  # continuation" and "somebody else's prompt" indistinguishable. Treating it
  # as somebody else's is the branch that can create an unattended retry chain.
  tmux set-option -w -t "$1" @gl_auto_resume_own_turn unknown 2>/dev/null || true
  auto_resume_failed_write "$1" \
    "the native prompt event could not be matched byte-for-byte to Gangline's marked continuation; this turn will not be auto-resumed if it fails"
}

auto_resume_stream_note() { # $1 pane, $2 collar, $3 Notification kind; 0 = resumed
  local pane="$1" collar="$2" kind="$3" record="" record_rc=0 window="" handled=""
  local own="" pending="" name body err="" rc=0 claim_rc=0
  auto_resume_for "$pane" || return 1
  load_collar "$collar"
  declare -F collar_auto_resume_record >/dev/null || return 1
  record="$(collar_auto_resume_record "$pane" "$kind")" || record_rc=$?
  case "$record_rc" in
    0) ;;
    1) return 1 ;; # ordinary idle: the newest top-level assistant record succeeded
    2) auto_resume_failed_write "$pane" \
         "the idle notification's native transcript could not be read structurally, so Gangline cannot determine whether the turn failed and will not auto-resume it"
       return 1 ;;
    *) auto_resume_failed_write "$pane" \
         "the collar returned an unknown failed-turn verdict ($record_rc), so Gangline will not auto-resume it"
       return 1 ;;
  esac
  case "$record" in ''|*[!A-Za-z0-9._:-]*)
    auto_resume_failed_write "$pane" \
      "the collar returned an unreadable failed-turn identity, so Gangline will not auto-resume it"
    return 1 ;;
  esac
  window="$(tmux display-message -p -t "$pane" '#{window_id}' 2>/dev/null)" || window=""
  [ -n "$window" ] || return 1
  event_claim auto-resume "$window" "stream-$record" || claim_rc=$?
  case "$claim_rc" in
    0) ;;
    1) return 1 ;;
    *) auto_resume_failed_write "$window" \
         "could not establish the failed-turn claim for record $record: ${EVENT_CLAIM_ERROR:-the claim mechanism returned no diagnostic}; Gangline left that native identity unhandled so a later idle notification may retry it"
       return 1 ;;
  esac
  handled="$(tmux show-options -wqv -t "$window" @gl_auto_resume_error 2>/dev/null)" \
    || handled=""
  if [ "$handled" = "$record" ]; then event_claim_release; return 1; fi
  # THE ERROR RECORD PLUS IDLE NOTIFICATION IS THE MISSING TURN BOUNDARY. Claude
  # emits no Stop for this path, so the old open bracket would make ordinary
  # verified delivery refuse the very composer the harness has declared idle.
  # Close only after the record claim and duplicate check: a repeated old
  # notification must not close the automatic continuation now in flight.
  turn_state_write "$window" closed
  glyph_write "$window" "~idle~"
  own="$(tmux show-options -wqv -t "$window" @gl_auto_resume_own_turn 2>/dev/null)" \
    || own=""
  pending="$(tmux show-options -wqv -t "$window" @gl_auto_resume_prompt 2>/dev/null)" \
    || pending=""
  if [ "$own" = 1 ]; then
    tmux set-option -w -t "$window" @gl_auto_resume_error "$record" 2>/dev/null || true
    tmux set-option -uw -t "$window" @gl_auto_resume_own_turn 2>/dev/null || true
    tmux set-option -uw -t "$window" @gl_auto_resume_prompt 2>/dev/null || true
    auto_resume_failed_write "$window" \
      "Gangline's one automatic continuation also ended in a provider API error; the one-hop guard refused another continuation for record $record"
    event_claim_release
    return 1
  fi
  if [ -n "$pending" ] || [ -n "$own" ]; then
    tmux set-option -w -t "$window" @gl_auto_resume_error "$record" 2>/dev/null || true
    tmux set-option -uw -t "$window" @gl_auto_resume_own_turn 2>/dev/null || true
    tmux set-option -uw -t "$window" @gl_auto_resume_prompt 2>/dev/null || true
    auto_resume_failed_write "$window" \
      "Gangline could not positively determine whether failed record $record belongs to its own continuation; the fail-closed one-hop guard refused another continuation"
    event_claim_release
    return 1
  fi

  name="$(agent_name_of "$window")"
  body="A provider stream failure ended the previous turn. Re-read your assignment and continue only if work remains. Treat any action whose result you did not observe as unknown before repeating it."
  AGENT_ID="$window" AGENT_COLLAR="$collar"
  envelope auto-resume "$body"
  # THE ENVELOPE IS THE OWNED MARKER. It is the exact attributed continuation
  # Gangline submits and is already visible to the receiving agent; keeping it
  # on the window until UserPromptSubmit compares the native prompt avoids
  # inferring ownership from event timing or prose.
  tmux set-option -w -t "$window" @gl_auto_resume_prompt "$ENVELOPE" 2>/dev/null || {
    auto_resume_failed_write "$window" \
      "Gangline could not record its continuation marker, so the fail-closed one-hop guard refused to submit record $record"
    event_claim_release
    return 1
  }
  err="$(send_live "$name" "" live-only 2>&1)" || rc=$?
  err="${err##*$'\n'}"
  case "$rc" in
    0)
      tmux set-option -w -t "$window" @gl_auto_resume_error "$record" 2>/dev/null || true
      own="$(tmux show-options -wqv -t "$window" @gl_auto_resume_own_turn 2>/dev/null)" \
        || own=""
      # Submission and the native UserPromptSubmit hook are separate processes.
      # Pending is expected here and already makes a later failure fail closed;
      # calling it a refusal races the witness and can leave a false alarm after
      # the witness succeeded. Only positive ownership retires an older alarm.
      if [ "$own" = 1 ]; then
        tmux set-option -uw -t "$window" @gl_auto_resume_failed 2>/dev/null || true
      fi
      event_claim_release
      return 0 ;;
    3)
      tmux set-option -uw -t "$window" @gl_auto_resume_prompt 2>/dev/null || true
      auto_resume_failed_write "$window" \
        "the continuation for failed record $record was not submitted: ${err:-the composer was not safely reachable}; a later idle notification may retry it"
      event_claim_release
      return 1 ;;
    *)
      # Something may have been typed. Close this record rather than risk a
      # duplicate, and leave ownership unknown so a resulting failure cannot
      # open the second hop.
      tmux set-option -w -t "$window" @gl_auto_resume_error "$record" 2>/dev/null || true
      tmux set-option -w -t "$window" @gl_auto_resume_own_turn unknown 2>/dev/null || true
      auto_resume_failed_write "$window" \
        "the continuation for failed record $record was not verified after submission began: ${err:-delivery failed}; Gangline will not send it again"
      event_claim_release
      return 1 ;;
  esac
}

USAGE_LIMIT_LABEL="" USAGE_LIMIT_USED=0 USAGE_LIMIT_RESET=0 USAGE_LIMIT_OBSERVED=0 USAGE_LIMIT_ROWS=""
USAGE_LIMIT_READER_STATUS=0
usage_limits_read() { # $1 window, collar loaded; select the most constrained row
  local rows line label used reset observed fields clean_rows="" best_used=-1 best_reset=-1 found=0 now
  USAGE_LIMIT_LABEL="" USAGE_LIMIT_USED=0 USAGE_LIMIT_RESET=0 USAGE_LIMIT_OBSERVED=0 USAGE_LIMIT_ROWS=""
  USAGE_LIMIT_READER_STATUS=0
  declare -F collar_usage_limits >/dev/null || return 4
  rows="$(collar_usage_limits "$1")" \
    || { USAGE_LIMIT_READER_STATUS=$?; return 2; }
  [ -n "$rows" ] || return 2
  now="$(date +%s)"
  while IFS= read -r line || [ -n "$line" ]; do
    fields="${line//$'\t'/}"
    [ $(( ${#line} - ${#fields} )) -eq 3 ] || return 3
    IFS=$'\t' read -r label used reset observed <<<"$line"
    case "$label" in ''|*$'\n'*|*$'\r'*) return 3 ;; esac
    case "$used" in ''|*[!0-9]*) return 3 ;; esac
    case "$reset" in ''|*[!0-9]*) return 3 ;; esac
    case "$observed" in ''|*[!0-9]*) return 3 ;; esac
    [ "$used" -le 100 ] && [ "$reset" -gt 0 ] && [ "$observed" -gt 0 ] \
      && [ "$observed" -le "$now" ] \
      || return 3
    label="$(printf '%s' "$label" | config_sanitize)"
    [ -n "$label" ] || return 3
    clean_rows="${clean_rows:+$clean_rows
}$label"$'\t'"$used"$'\t'"$reset"$'\t'"$observed"
    found=1
    if [ "$used" -gt "$best_used" ] \
      || { [ "$used" -eq "$best_used" ] && [ "$reset" -gt "$best_reset" ]; }; then
      USAGE_LIMIT_LABEL="$label" USAGE_LIMIT_USED="$used"
      USAGE_LIMIT_RESET="$reset" USAGE_LIMIT_OBSERVED="$observed"
      best_used="$used" best_reset="$reset"
    fi
  done <<<"$rows"
  [ "$found" -eq 1 ] || return 2
  USAGE_LIMIT_ROWS="$clean_rows"
}

usage_limit_stale() { # $1 observation, $2 now; collar declares zero for no age cap
  [ "$GANG_USAGE_LIMIT_MAX_AGE" -gt 0 ] \
    && [ $(( $2 - $1 )) -gt "$GANG_USAGE_LIMIT_MAX_AGE" ]
}

usage_limit_state() { # selected row + thresholds -> below|yellow|red
  if [ "$USAGE_LIMIT_USED" -ge "$USAGE_RED" ]; then
    printf red
  elif [ "$USAGE_LIMIT_USED" -ge "$USAGE_YELLOW" ]; then
    printf yellow
  else
    printf below
  fi
}

usage_limit_record() { # $1 window, $2 state; store one validated native reading
  local label
  label="$(printf '%s' "$USAGE_LIMIT_LABEL" | config_sanitize)"
  tmux set-option -w -t "$1" @gl_usage_limit \
    "$2 $USAGE_LIMIT_USED $USAGE_LIMIT_RESET $USAGE_LIMIT_OBSERVED $label" 2>/dev/null \
    || return 1
  tmux set-option -uw -t "$1" @gl_usage_failed 2>/dev/null || true
}

usage_limit_fail_record() { # $1 window, $2 operator-facing failure
  local note
  note="$(printf '%s' "$2" | config_sanitize)"
  tmux set-option -w -t "$1" @gl_usage_failed "$note" 2>/dev/null || true
}

USAGE_WAKE_REPLACED_CUSTOM=0
usage_wake_existing_authoritative() { # $1 window; 0 preserve, 1 replace
  local record reset unit now state body
  USAGE_WAKE_REPLACED_CUSTOM=0
  record="$(usage_wake_read "$1")" || return 1
  IFS=$'\t' read -r reset unit _ <<<"$record"
  now="$(date +%s)"

  # A FUTURE DECLARATION IS PRESERVED UNLESS ITS TIMER IS PROVABLY DEAD.
  # The user manager can disappear under the tmux server, leaving a shaped
  # declaration whose inactive/failed timer cannot deliver it. That residue is
  # not a wake and must not disable automatic arming for every later provider
  # window. Conversely, an unreadable manager is not permission to cancel a
  # possibly-live operator wake and discard its --resume body.
  if [ "$reset" -gt "$now" ]; then
    command -v systemctl >/dev/null 2>&1 || return 0
    state="$(systemctl --user is-active "$unit.timer" 2>/dev/null)" || true
    case "$state" in inactive|failed) ;; *) return 0 ;; esac
  fi
  body="$(tmux show-options -wqv -t "$1" @gl_usage_wake_body 2>/dev/null)" \
    || body=""
  [ -z "$body" ] || USAGE_WAKE_REPLACED_CUSTOM=1
  return 1
}

auto_resume_arm() { # $1 window, $2 the sampled reset -> the turn's note
  # THE SAMPLED RESET GOES THROUGH THE ONE ARMING TRANSACTION. Re-reading here
  # can cross a provider rollover: the threshold decision then belongs to reset
  # A while wait-limit arms B, and a marker for A permits B to be armed again.
  # usage_wake_arm is also the manual command's implementation, so preserving
  # one reading does not create a second copy of its ordering discipline.
  #
  # THE MARKER CHECK AND ARM ARE ONE CLAIM. Native hooks can overlap, and tmux
  # options have no compare-and-set; without this claim both processes can read
  # the old marker and arm the same reset. A killed holder is reclaimed by the
  # next hook, so no in-progress bit can wedge the window.
  local armed name out rc=0 claim_rc=0
  event_claim auto-resume "$1" usage-wake || claim_rc=$?
  case "$claim_rc" in
    0) ;;
    1) return 1 ;;
    *) out="auto-resume could not establish its event claim: ${EVENT_CLAIM_ERROR:-the claim mechanism returned no diagnostic}"
       tmux set-option -uw -t "$1" @gl_usage_wake_failed_unit 2>/dev/null || true
       tmux set-option -w -t "$1" @gl_usage_wake_failed "$out" 2>/dev/null || true
       printf 'Auto-resume could NOT establish its event claim: %s. Nothing is scheduled; a later provider sample may retry this reset.' \
         "${EVENT_CLAIM_ERROR:-the claim mechanism returned no diagnostic}"
       return 2 ;;
  esac
  armed="$(tmux show-options -wqv -t "$1" @gl_auto_resume_armed 2>/dev/null)" || armed=""
  if [ "$armed" = "$2" ]; then event_claim_release; return 1; fi
  name="$(agent_name_of "$1")"
  if usage_wake_existing_authoritative "$1"; then
    # Re-entering the shared arm transaction would first cancel this future
    # wake and could silently discard --resume's body. Mark this provider
    # window handled without touching the declaration, its transient unit, or
    # its continuation. Dead and overdue residue does not take this branch.
    tmux set-option -w -t "$1" @gl_auto_resume_armed "$2" 2>/dev/null || true
    event_claim_release
    printf 'Auto-resume left the existing future provider-reset wake for %s unchanged at %s%% used; automatic arming will not override that wake.' \
      "$name" "$AUTO_RESUME_AT"
    return 0
  fi
  out="$(usage_wake_arm "$1" "$name" "" 2>&1)" || rc=$?
  # BOTH TERMINAL OUTCOMES CLOSE THE WINDOW. A refusal that left no marker would
  # relaunch a headless provider read at every sample for as long as the agent
  # stayed above the threshold, and would repeat itself into every turn. It is
  # loud once, on the window and in this turn, and the operator arms by hand.
  # A cleared wake keeps its marker on purpose: `--clear` is a decision, and
  # re-arming over it would answer the operator by overruling them.
  tmux set-option -w -t "$1" @gl_auto_resume_armed "$2" 2>/dev/null || true
  out="$(printf '%s' "$out" | config_sanitize)"
  if [ "$rc" -eq 0 ]; then
    event_claim_release
    printf 'Auto-resume armed at %s%% used: %s' "$AUTO_RESUME_AT" "$out"
    [ "$USAGE_WAKE_REPLACED_CUSTOM" -ne 1 ] \
      || printf " Auto-resume replaced a dead provider-reset wake and discarded its custom --resume turn."
    return 0
  fi
  tmux set-option -uw -t "$1" @gl_usage_wake_failed_unit 2>/dev/null || true
  tmux set-option -w -t "$1" @gl_usage_wake_failed \
    "auto-resume could not arm a wake: $out" 2>/dev/null || true
  event_claim_release
  printf 'Auto-resume could NOT arm a provider-reset wake: %s. Nothing is scheduled; arm it by hand with gang wait-limit %s.' \
    "$out" "$name"
  return 2
}

usage_light_note() { # $1 collar; sample provider use, then light and arm from it
  local rc=0 state previous note cause agent now checked lights=0 arm=0 subject arm_note arm_rc=0
  if usage_lights_for "$TMUX_PANE"; then lights=1; fi
  if auto_resume_for "$TMUX_PANE"; then arm=1; fi
  [ "$lights" -eq 1 ] || [ "$arm" -eq 1 ] || return 0
  # THE SUBJECT IS WHICHEVER CONSUMER ASKED FOR THE READING. An operator running
  # auto-resume with the lights off must not be told that lights are unavailable.
  if [ "$lights" -eq 1 ]; then subject="Usage lights"; else subject="Auto-resume"; fi
  load_collar "$1"
  if [ "$GANG_USAGE_LIGHT_INTERVAL" -gt 0 ]; then
    now="$(date +%s)"
    checked="$(tmux show-options -wqv -t "$TMUX_PANE" @gl_usage_checked 2>/dev/null)" \
      || checked=""
    case "$checked" in
      ''|*[!0-9]*) ;;
      *) [ "$checked" -gt "$now" ] \
           || [ $(( now - checked )) -ge "$GANG_USAGE_LIGHT_INTERVAL" ] \
           || return 0 ;;
    esac
    tmux set-option -w -t "$TMUX_PANE" @gl_usage_checked "$now" 2>/dev/null \
      || return 0
  fi
  usage_limits_read "$TMUX_PANE" || rc=$?
  if [ "$rc" -eq 0 ]; then
    now="$(date +%s)"
    usage_limit_stale "$USAGE_LIMIT_OBSERVED" "$now" && rc=5
  fi
  previous="$(tmux show-options -wqv -t "$TMUX_PANE" @gl_usage_notified 2>/dev/null)" \
    || previous=""
  case "$rc" in
    0)
      if [ "$lights" -eq 1 ]; then state="$(usage_limit_state)"; else state=sampled; fi
      usage_limit_record "$TMUX_PANE" "$state" || return 0
      # ARMING IS DECIDED BEFORE THE LIGHT EDGES. A light returns early for every
      # state it has nothing new to say about — below its yellow, or an edge it
      # already reported — and an auto-resume threshold the operator set anywhere
      # under those states would never be reached through them.
      if [ "$arm" -eq 1 ] && [ "$USAGE_LIMIT_USED" -ge "$AUTO_RESUME_AT" ] \
        && [ "$USAGE_LIMIT_RESET" -gt "$now" ]; then
        arm_note="$(auto_resume_arm "$TMUX_PANE" "$USAGE_LIMIT_RESET")" || arm_rc=$?
        if [ "$arm_rc" -ne 1 ] && [ -n "$arm_note" ]; then
          ADVISORY_NOTE="${ADVISORY_NOTE:+$ADVISORY_NOTE
}$arm_note"
        fi
      fi
      if [ "$lights" -ne 1 ]; then
        # A good auto-resume-only sample ends the previous reader-failure epoch.
        # Without this state transition, the next recurrence is suppressed as
        # a duplicate even though a successful reading intervened.
        tmux set-option -w -t "$TMUX_PANE" @gl_usage_notified sampled 2>/dev/null || true
        return 0
      fi
      if [ "$state" = below ]; then
        tmux set-option -uw -t "$TMUX_PANE" @gl_usage_notified 2>/dev/null || true
        return 0
      fi
      [ "$state" != "$previous" ] || return 0
      if [ "$previous" = red ]; then return 0; fi
      agent="$(agent_name_of "$TMUX_PANE")"
      case "$state" in
        yellow) note="Yellow usage light: $USAGE_LIMIT_LABEL is ${USAGE_LIMIT_USED}% used. Finish at the next natural checkpoint; inspect with gang limits $agent." ;;
        red) note="Red usage light: $USAGE_LIMIT_LABEL is ${USAGE_LIMIT_USED}% used. Finish the current arc and stop before the provider limit; inspect or schedule its reset with gang limits $agent and gang wait-limit $agent." ;;
      esac
      ;;
    2) state=unavailable
       cause="$(usage_limits_error "$1" "$rc")"
       note="$subject unavailable: $cause. Inspect with gang limits $(agent_name_of "$TMUX_PANE")." ;;
    3) state=invalid; note="$subject unavailable: the collar returned a provider-limit record Gangline cannot interpret. Inspect with gang limits $(agent_name_of "$TMUX_PANE")." ;;
    4) state=unavailable; note="$subject unavailable: this collar declares no non-interactive provider-limit source; Gangline will not substitute a composer scrape." ;;
    5) state=stale; note="$subject unavailable: the collar's newest provider-limit reading is too old to act on. Refresh the harness with an API turn, then inspect with gang limits $(agent_name_of "$TMUX_PANE")." ;;
    *) return 0 ;;
  esac
  if [ "$rc" -ne 0 ]; then
    usage_limit_fail_record "$TMUX_PANE" "$note"
    [ "$state" != "$previous" ] || return 0
  fi
  tmux set-option -w -t "$TMUX_PANE" @gl_usage_notified "$state" 2>/dev/null \
    || return 0
  ADVISORY_NOTE="${ADVISORY_NOTE:+$ADVISORY_NOTE
}$note"
}

time_light_note() { # append the team curfew edge, if any, to ADVISORY_NOTE
  local rc=0 now span spent light previous key left note
  curfew_read || rc=$?
  [ "$rc" -ne 1 ] || return 0
  previous="$(tmux show-options -wqv -t "$TMUX_PANE" @gl_time_light 2>/dev/null)" \
    || previous=""
  if [ "$rc" -eq 2 ]; then
    key=unavailable
    [ "$previous" = "$key" ] && return 0
    note="Time lights unavailable: Gangline cannot read the team's curfew declaration. Run gang curfew clear and declare it again."
  else
    now="$(date +%s)"
    if [ "$now" -lt "$CURFEW_DECLARED" ]; then
      key=unavailable
      [ "$previous" = "$key" ] && return 0
      note="Time lights unavailable: the team's curfew declaration is stamped in the future. Run gang curfew clear and declare it again."
    else
      span=$(( CURFEW_AT - CURFEW_DECLARED ))
      spent=$(( now - CURFEW_DECLARED ))
      if [ $(( spent * 5 )) -ge $(( span * 4 )) ]; then
        light=red
      elif [ $(( spent * 2 )) -ge "$span" ]; then
        light=yellow
      else
        return 0
      fi
      key="$CURFEW_DECLARED:$CURFEW_AT:$light"
      [ "$previous" = "$key" ] && return 0
      left=$(( CURFEW_AT - now ))
      if [ "$left" -ge 0 ]; then
        case "$light" in
          yellow) note="Yellow time light: half the team budget is spent; $(human_seconds "$left") remain." ;;
          red) note="Red time light: four-fifths of the team budget is spent; $(human_seconds "$left") remain." ;;
        esac
      else
        note="Red time light: the team curfew passed $(human_seconds $(( 0 - left ))) ago."
      fi
    fi
  fi
  tmux set-option -w -t "$TMUX_PANE" @gl_time_light "$key" 2>/dev/null || return 0
  ADVISORY_NOTE="${ADVISORY_NOTE:+$ADVISORY_NOTE
}$note"
}

advisory_reply() { # $1 event, $2 collar; emit at most one native hook payload
  ADVISORY_NOTE=""
  context_light_note "$2"
  usage_light_note "$2"
  time_light_note
  [ -n "$ADVISORY_NOTE" ] || return 0
  python3 -c 'import json,sys; print(json.dumps({"hookSpecificOutput":{"hookEventName":sys.argv[1],"additionalContext":sys.argv[2]}}))' \
    "$1" "$ADVISORY_NOTE"
}

# A MODEL CATALOG IS A COMPLETE NATIVE VOCABULARY, not a remembered list.
# `collar_models` prints one model id per line and may add a tab-separated,
# comma-delimited effort vocabulary. Core validates that narrow interchange
# before either showing it or spending it as a hitch refusal. A collar whose
# harness cannot enumerate may instead declare aliases for discovery and a
# three-way `collar_model_check`: 0 recognized, 1 unrecognized, 2 unknown.
# Recognition is deliberately not availability; only the provider can answer
# whether this account may use a recognized full model name.
model_rows_normalize() { # $1 raw rows -> sorted, validated rows; 1 = malformed
  local raw="$1" line id details normalized="" seen=$'\n' number=0
  [ -n "$raw" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    number=$(( number + 1 ))
    case "$line" in
      ''|*$'\r'*|*$'\t'*$'\t'*)
        printf 'gang: model catalog row %s is not one or two nonempty TSV fields\n' \
          "$number" >&2
        return 1 ;;
    esac
    if [[ "$line" == *$'\t'* ]]; then
      id="${line%%$'\t'*}"
      details="${line#*$'\t'}"
      [ -n "$details" ] || {
        printf 'gang: model catalog row %s has an empty effort field\n' \
          "$number" >&2
        return 1
      }
    else
      id="$line" details=""
    fi
    case "$id" in
      ''|*[!A-Za-z0-9._:/@-]*)
        printf "gang: model catalog row %s has unusable id '%s'\n" \
          "$number" "$(printf '%s' "$id" | config_sanitize)" >&2
        return 1 ;;
    esac
    case "$details" in
      *[!A-Za-z0-9._:/@,-]*)
        printf 'gang: model catalog row %s has an unusable effort field\n' \
          "$number" >&2
        return 1 ;;
      *) ;;
    esac
    case "$details" in ,*|*,|*,,*)
      printf 'gang: model catalog row %s has an empty effort name\n' \
        "$number" >&2
      return 1 ;;
    esac
    case "$seen" in
      *$'\n'"$id"$'\n'*)
        printf "gang: model catalog repeats id '%s'\n" "$id" >&2
        return 1 ;;
    esac
    seen="$seen$id"$'\n'
    normalized="$normalized$id${details:+$'\t'$details}"$'\n'
  done <<<"$raw"
  printf '%s' "$normalized" | LC_ALL=C sort
}

models_read() { # collar loaded -> complete normalized catalog; 2 producer, 3 empty, 5 malformed
  local raw="" rc=0
  declare -F collar_models >/dev/null || return 4
  raw="$(collar_models)" || rc=$?
  if [ "$rc" -ne 0 ]; then
    printf 'gang: collar model enumerator failed (status %s)\n' "$rc" >&2
    return 2
  fi
  if [ -z "$raw" ]; then
    printf 'gang: collar model enumerator produced no model ids\n' >&2
    return 3
  fi
  model_rows_normalize "$raw" || return 5
}

models_read_error() { # $1 collar, $2 models_read status -> operator phrase
  case "$2" in
    2) printf "collar '%s' model enumeration failed" "$1" ;;
    3) printf "collar '%s' model enumeration produced no ids" "$1" ;;
    4) printf "collar '%s' declares no complete model enumerator" "$1" ;;
    5) printf "collar '%s' returned a model catalog Gangline cannot interpret" "$1" ;;
    *) printf "collar '%s' model enumeration failed with unknown status %s" "$1" "$2" ;;
  esac
}

model_catalog_has() { # $1 exact id, $2 normalized catalog
  local wanted="$1" row
  while IFS= read -r row; do
    [ "${row%%$'\t'*}" = "$wanted" ] && return 0
  done <<<"$2"
  return 1
}

validate_model_choice() { # $1 collar name, $2 model; collar loaded
  local prof="$1" model="$2" catalog="" output="" rc=0 reason
  if declare -F collar_models >/dev/null; then
    catalog="$(models_read)" || rc=$?
    [ "$rc" -eq 0 ] \
      || die "hitch: $(models_read_error "$prof" "$rc"), so gang cannot validate model '$model'"
    model_catalog_has "$model" "$catalog" \
      || die "hitch: '$model' is not a model collar '$prof' enumerates (gang models -c $prof)"
    return 0
  fi
  if declare -F collar_model_check >/dev/null; then
    output="$(collar_model_check "$model")" || rc=$?
    reason="$(printf '%s' "$output" | config_sanitize)"
    case "$rc" in
      0) return 0 ;;
      1) die "hitch: model '$model' is not recognized by collar '$prof'${reason:+ — $reason}" ;;
      2) die "hitch: collar '$prof' could not determine whether model '$model' is recognized${reason:+ — $reason}" ;;
      *) die "hitch: collar '$prof' returned unknown model-check status $rc for '$model'" ;;
    esac
  fi
  die "hitch: collar '$prof' declares GANG_MODEL_OPT but neither collar_models nor collar_model_check, so gang cannot validate model '$model'"
}

# A reasoning effort is one concept every harness spells differently and values
# differently, so the collar owns BOTH: the option, and the command that says
# which levels exist. Core holds neither vocabulary, because codex's is
# model-specific and claude's may not be, and neither harness can be right about
# the other.
#
# WHY A COMMAND THAT PRINTS THE LEVELS RATHER THAN ONE THAT JUDGES ONE. A checker
# answering by exit status has two outcomes for three states, and the state it
# cannot distinguish is the one that matters: "this level is not a level" and
# "the check could not run at all" arrive as the same non-zero, so a harness that
# is merely absent refuses every level while claiming the operator typed a bad
# one. Printing the vocabulary separates them — nothing printed is
# could-not-determine, and it is refused UNDER ITS OWN NAME rather than borrowed
# from the other.
#
# Validation must run at STATEMENT LEVEL, never inside $(...): die in a command
# substitution ends only that subshell, and the caller reads the empty string as
# a pass. That is why this returns levels and the refusals live at the call
# site, where the child's status is CAUGHT rather than absorbed: a checker that
# exits nonzero is a broken declaration even when it printed something, because
# output from a failed checker is not a vocabulary. Empty output with status 0
# is the other failure channel — could-not-determine that the collar itself
# established. Both are named as the declaration's fault, never the operator's.
effort_levels() { # print the levels the collar says this harness takes
  [ -n "$GANG_EFFORT_CMD" ] || return 0
  # The model reaches the command because a vocabulary can depend on it; the
  # collar decides whether to use it. Exported for the child only.
  GANG_MODEL="$1" sh -c "$GANG_EFFORT_CMD" 2>/dev/null
}

hitch_up_attach() { # $1 = startup-gated window; let `up` expose its prompt
  local channel notify attach_rc=0
  [ "$HITCH_UP_MODE" -eq 1 ] || return 0
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "=$SESSION" \; select-window -t "$1" \
      || die "up: could not switch to the startup prompt"
    HITCH_SWITCHED=1
  else
    HITCH_ATTACH_STATE="$(mktemp -d "${TMPDIR:-/tmp}/gang-up-attach.XXXXXX")" \
      || die "up: cannot create transient state for its tmux client"
    channel="gang-up-attach-$(mint_nonce)"
    notify="printf '%s\\n' '#{client_name}' > '$HITCH_ATTACH_STATE/client'; tmux wait-for -S '$channel'"
    (
      local rc=0
      tmux attach -t "=$SESSION" \; select-window -t "$1" \; run-shell "$notify" \
        || rc=$?
      printf '%s\n' "$rc" > "$HITCH_ATTACH_STATE/exit"
      tmux wait-for -S "$channel" 2>/dev/null || true
      exit "$rc"
    ) &
    HITCH_ATTACH_PID=$!
    tmux wait-for "$channel"
    if [ ! -s "$HITCH_ATTACH_STATE/client" ]; then
      [ ! -s "$HITCH_ATTACH_STATE/exit" ] \
        || attach_rc="$(cat "$HITCH_ATTACH_STATE/exit")"
      hitch_up_abort
      die "up: tmux could not attach a client to the startup prompt (status $attach_rc)"
    fi
    trap 'on_exit' EXIT
  fi
}

# One agent per killable cgroup. A tmux server inherits the cgroup of whatever
# started it, so by default every hitched harness shares the login session's
# scope and systemd-oomd — which kills the descendant LEAF cgroup holding the
# most swap — takes the whole team in one message. A transient user scope per
# harness makes each agent its own leaf, so the same policy costs one agent.
# Accounting is stated rather than inherited: a scope without it reports no
# swap, is never selected, and the mechanism would fail silently.
SCOPE_PREFIX=""
SCOPE_ARGV=()
scope_prefix_for() { # $1 = unit name, $2 = what the scope holds, in a refusal,
                     # $3 = what a name still held says outlived what;
                     # SCOPE_PREFIX / SCOPE_ARGV = the wrapper, empty when off
  local manager_user systemctl_recover='systemctl --user'
  local -a scope_systemctl=(systemctl --user)
  SCOPE_PREFIX=""; SCOPE_ARGV=()
  [ "$GANG_SCOPE" = on ] || return 0
  case "$SESSION" in *[!A-Za-z0-9._-]*)
    die "GANG_SCOPE=on cannot name a systemd unit after session '$SESSION' — use letters, digits, dot, dash and underscore$(config_origin_note GANG_SESSION)" ;;
  esac
  command -v systemd-run >/dev/null 2>&1 \
    || die "GANG_SCOPE=on cannot give $2 its own cgroup: this host has no systemd-run$(config_origin_note GANG_SCOPE)"
  # A sandbox may expose the host's system bus while its PID namespace makes
  # the direct user bus unusable. systemd's local-host machine transport reaches
  # the same user manager without weakening that sandbox. Prefer the ordinary
  # path; the fallback is only the preflight/control client, while systemd-run
  # below still executes with the harness in tmux's host context.
  if ! "${scope_systemctl[@]}" show --property=Version --value >/dev/null 2>&1; then
    manager_user="$(id -un 2>/dev/null)" || manager_user=""
    [ -n "$manager_user" ] || die "GANG_SCOPE=on cannot give $2 its own cgroup: could not name the current user for the systemd user manager$(config_origin_note GANG_SCOPE)"
    scope_systemctl+=(--machine="$manager_user@.host")
    systemctl_recover="systemctl --user --machine=$(shell_quote "$manager_user@.host")"
    "${scope_systemctl[@]}" show --property=Version --value >/dev/null 2>&1 \
      || die "GANG_SCOPE=on cannot give $2 its own cgroup: 'systemctl --user' reaches no systemd user manager directly or through the local host$(config_origin_note GANG_SCOPE)"
  fi
  [ "${#1}" -le 255 ] \
    || die "GANG_SCOPE=on cannot give $2 its own cgroup: '$1' is longer than a systemd unit name may be"
  # A scope outlives what it held when a detached child was left behind, and the
  # name is stable, so a relaunch would meet its own predecessor. systemd-run's
  # failure would land inside tmux as a window that died at launch; the operator
  # gets the unit and the remedy here instead.
  if "${scope_systemctl[@]}" is-active --quiet -- "$1" 2>/dev/null; then
    die "GANG_SCOPE=on cannot give $2 its own cgroup: $1 is still running, so $3. Inspect it with '$systemctl_recover status $1' and release the name with '$systemctl_recover stop $1'"
  fi
  SCOPE_ARGV=(systemd-run --user --scope --quiet --collect --unit="$1" -p MemoryAccounting=yes)
  SCOPE_PREFIX="systemd-run --user --scope --quiet --collect --unit=$(shell_quote "$1") -p MemoryAccounting=yes"
}

tmux_guard_dir() { printf '%s/libexec/gang-tmux-guard' "$ROOT"; }

# AT THE FRONT OF THE AGENT'S PATH, so every shell that agent opens is covered
# and nothing pays for it until a tmux is actually run. It is left for the shell
# tmux runs the launch line with to expand, because the PATH being extended is
# the pane's and gang cannot see that from here.
#
# EXPORTED AS ITS OWN COMMAND, not written as an assignment prefix. A prefix
# applies to exactly one simple command, so a collar whose launch line is a list
# would have covered its first command and left the harness itself — and every
# shell under it — on the original PATH. That reads as a guard that is installed
# and is not.
tmux_guard_wrap() {
  local dir
  [ "$GANG_TMUX_GUARD" = on ] || return 0
  dir="$(tmux_guard_dir)"
  [ -x "$dir/tmux" ] || {
    printf 'gang: WARNING: GANG_TMUX_GUARD=on but %s/tmux is missing or not executable, so this agent launches without the guard against ending its own team'"'"'s tmux server. Reinstall gangline, or set GANG_TMUX_GUARD=off to stop asking for it.\n' \
      "$dir" >&2
    return 0
  }
  GANG_LAUNCH="export PATH=$(shell_quote "$dir"):\$PATH; $GANG_LAUNCH"
}

scope_launch_wrap() { # $1 = agent name; prefix GANG_LAUNCH with its own scope
  scope_prefix_for "gangline-$SESSION-$1.scope" "'$1'" \
    "something from an earlier '$1' outlived its window"
  [ -z "$SCOPE_PREFIX" ] || GANG_LAUNCH="$SCOPE_PREFIX $GANG_LAUNCH"
}

server_running() { # 0 = a tmux server is already answering on this socket
  # A tmux server with no sessions exits by itself, so "list-sessions answers"
  # is the same question as "is there a server" — asked without reading its
  # refusal text, which is prose that changes between tmux versions.
  tmux list-sessions >/dev/null 2>&1
}

# THE SERVER THAT HOLDS THE TEAM IS THE ONE PROCESS WHOSE DEATH ENDS ALL OF IT,
# and until this it was the only one gangline owned no account of. Each agent is
# launched into `gangline-<session>-<agent>.scope`; the server was started by
# whatever ran `gang up` and inherited that shell's cgroup — an ssh login scope
# whose number means nothing here. So a whole team could vanish and leave
# journald nothing but "session-NNNN.scope: Deactivated successfully", which
# reads identically whether the server was killed, crashed, or simply lost the
# login session underneath it.
#
# ONLY WHERE GANG IS THE ONE STARTING IT. `tmux new-session` against a server
# that is already up does not fork a new one, so the scope would hold nothing
# but the client that exits a moment later — a unit that stops immediately and
# an accounting claim that is false. The pre-existing case is said out loud
# instead, because a silently unowned server is exactly the state this exists
# to end.
scope_server_wrap() { # SCOPE_ARGV = the wrapper for the tmux that forks a server
  SCOPE_PREFIX=""; SCOPE_ARGV=()
  [ "$GANG_SCOPE" = on ] || return 0
  if server_running; then
    printf "gang: WARNING: the tmux server that will hold '%s' is already running, so gangline does not own a unit for it: its death will be an anonymous process exit rather than a named unit stopping, and it stays outside the accounting its agents get. To put it inside, end the other sessions on this socket and start the team on a server gang opens.\n" \
      "$SESSION" >&2
    return 0
  fi
  scope_prefix_for "gangline-$SESSION.scope" "the tmux server holding '$SESSION'" \
    "something from an earlier tmux server for '$SESSION' outlived it"
}

hitch_register() { # $1 window, $2 agent name, $3 option, $4 value
  local refusal
  # TMUX ANSWERS FIRST, AND ON ITS OWN STDERR, so the refusal is caught rather
  # than let through. A window that went away under this write prints `no such
  # window` naming an id the operator never saw, which would reach them ahead of
  # the death note below and describe nothing gang had tried to run.
  refusal="$(tmux set-option -w -t "$1" "$3" "$4" 2>&1)" && return 0
  # THE WINDOW GOING AWAY UNDER A REGISTRATION IS A DEAD LAUNCH, not a tmux
  # fault, and the two are told apart by asking rather than by guessing which
  # one this was.
  ! launch_dead "$1" || die "$(launch_death_note "$2" "$1" "$GANG_LAUNCH")"
  # A REFUSAL THAT IS NOT A DEATH KEEPS TMUX'S REASON, which is the only thing
  # that explains it.
  die "could not register '$2' in window $1: tmux refused the window option $3${refusal:+ — $refusal}"
}

cmd_hitch() {
  local name="" prof="${GANG_COLLAR:-claude-code}" dir="$PWD" model="" effort="" missing="" role="" role_path="" id="" resume=0 resume_id="" resume_stamped="" launch_env collar_arg=0 pane_dead lookup_rc=0 opened_session=0
  local lights="" lights_arg="" lights_given=0 lights_subject="" boot="${GANG_BOOT_TIMEOUT:-30}" gate_looks="${GANG_GATE_LOOKS:-60}"
  name="${1:-}"; case "$name" in ''|-*) usage_die ;; esac; shift
  valid_name "$name" \
    || die "hitch: '$name' is not usable — use letters, digits, dot, dash and underscore; do not start with dash or dot; hitch and gangline are reserved"
  while [ $# -gt 0 ]; do case "$1" in
    -c|--collar) [ $# -ge 2 ] || die "hitch: $1 needs a value"
                  prof="$2"; collar_arg=1; shift 2 ;;
    -d|--dir)     [ $# -ge 2 ] || die "hitch: $1 needs a value"; dir="$2";  shift 2 ;;
    -m|--model)   [ $# -ge 2 ] || die "hitch: $1 needs a value"; model="$2"; shift 2 ;;
    -e|--effort)  [ $# -ge 2 ] || die "hitch: $1 needs a value"; effort="$2"; shift 2 ;;
    -r|--role)    [ $# -ge 2 ] || die "hitch: $1 needs a value"; role="$2"; shift 2 ;;
    -l|--lights)  [ $# -ge 2 ] || die "hitch: $1 needs a value"
                  lights_arg="$2"; lights_given=1; shift 2 ;;
    --resume)     resume=1; shift
                  if [ $# -gt 0 ] && [[ "$1" != -* ]]; then resume_id="$1"; shift; fi ;;
    *) die "hitch: unknown argument '$1'" ;;
  esac; done
  usage_lights_parse "$GANG_USAGE_LIGHTS" >/dev/null || true
  auto_resume_parse "$GANG_AUTO_RESUME" >/dev/null || true
  # These settings can refuse a hitch, so validate them before its first tmux
  # mutation. Checking them only at the read site leaves a registered agent
  # behind after reporting that the hitch failed.
  require_whole GANG_BOOT_TIMEOUT "$boot" seconds
  require_whole GANG_GATE_LOOKS "$gate_looks" observations
  [ -d "$dir" ] || die "hitch: no such directory '$dir'"
  ! test_only_collar "$prof" \
    || die "hitch: '$prof' is a stand-in for gangline's own suite, not a harness to run an agent on (GANG_TEST_COLLARS=1 if you are testing gang itself)"
  if [ "$collar_arg" -eq 0 ]; then
    collar_file "$prof" >/dev/null \
      || die "unknown collar '$prof' (have: $(list_collars | tr '\n' ' '))$(config_origin_note GANG_COLLAR)"
  fi
  # THE COLLAR IS SOURCED SEEING THIS AGENT'S REQUEST, not the team's. A collar
  # may wire its native context source at source time — claude-code paints the
  # beacon its own `collar_context` reads — so a per-agent `--lights` the collar
  # could not see would arm lights over a source nobody painted, and every hook
  # would report a miss on a window the operator had just asked to watch. The
  # model travels with it for the same reason: a collar's default is a per-model
  # answer, and it must reach the same one gang resolves below.
  if [ "$lights_given" -eq 1 ]; then
    GANG_CONTEXT_LIGHTS="$lights_arg"
    lights_subject="hitch --lights"
  fi
  # shellcheck disable=SC2034  # read by the collar sourced on the next line
  GANG_MODEL="$model"
  load_collar "$prof"
  ROLE_NAME="" ROLE_FILE="" ROLE_BODY="" SYSTEM_PROMPT=""
  if [ -n "$role" ]; then
    valid_role_name "$role" \
      || die "hitch: role '$role' is not usable — use only letters, digits, dot, dash and underscore; do not start with dash or dot"
    ROLE_FILE="$(role_file "$role")" \
      || die "hitch: no role '$role' (usable roles: $(list_usable_roles | tr '\n' ' '))"
    role_path="$(config_path "$ROLE_FILE" | config_sanitize)"
    prose_read "$ROLE_FILE" "role brief" "$role_path"
    [ -s "$ROLE_FILE" ] || die "role brief $role_path is empty"
    ROLE_NAME="$role"
    ROLE_BODY="$PROSE"
  fi
  if session_live; then
    id="$(win_id "$name")" || {
      lookup_rc=$?
      [ "$lookup_rc" -eq 1 ] || win_id_missing "$lookup_rc" "no agent '$name'"
      id=""
    }
  fi
  if [ "$resume" -eq 1 ]; then
    [ -n "$GANG_RESUME_LAUNCH" ] \
      || die "hitch: collar '$prof' declares no GANG_RESUME_LAUNCH, so it cannot take --resume; inspect the target identity with gang whoami"
    if [ -n "$id" ]; then
      registered_identity_guard "$id" "$name" hitch
    elif [ -z "$resume_id" ]; then
      die "hitch: bare --resume for '$name' has no still-existing registered window whose @gl_session_id can be read. Use the exact 'gang hitch $name --resume <session-id>' line printed by gang drop, or inspect a surviving pane with gang whoami"
    fi
    if [ -z "$resume_id" ]; then
      resume_id="$(tmux show-options -wqv -t "$id" @gl_session_id 2>/dev/null)" || resume_id=""
      [ -n "$resume_id" ] \
        || die "hitch: '$name' has no @gl_session_id; use the exact explicit-id relaunch line printed by gang drop, or inspect the surviving pane with gang whoami"
    elif [ -n "$id" ]; then
      resume_stamped="$(tmux show-options -wqv -t "$id" @gl_session_id 2>/dev/null)" || resume_stamped=""
      [ -z "$resume_stamped" ] || [ "$resume_stamped" = "$resume_id" ] \
        || die "hitch: window '$name' is stamped for harness session '$resume_stamped', not requested session '$resume_id'; refusing to replace its registered native identity"
    fi
    case "$resume_id" in ''|*[!A-Za-z0-9._:-]*) die "hitch: session id '$resume_id' has characters Gangline will not place in a launch command" ;; esac
    GANG_LAUNCH="${GANG_RESUME_LAUNCH//'{{session_id}}'/$resume_id}"
  elif [ -n "$id" ]; then
    registered_identity_guard "$id" "$name" hitch
    # A HELD CORPSE IS WHAT A LAUNCH THAT DIED LEAVES BEHIND where the operator
    # keeps remain-on-exit, so this refusal sits on the way out of one. "Already
    # exists" alone reads as a working agent and names no repair.
    ! launch_dead "$id" \
      || die "agent '$name' already exists and nothing is running in its window: clear it with 'gang drop $name', or relaunch the harness session it is stamped for with 'gang hitch $name --resume'"
    die "agent '$name' already exists"
  fi
  if [ -n "$GANG_MODEL_OPT" ] && [ -z "$model" ]; then missing="-m"; fi
  if [ -n "$GANG_EFFORT_OPT" ] && [ -z "$effort" ]; then
    if [ -n "$missing" ]; then missing="$missing and -e"; else missing="-e"; fi
  fi
  [ -z "$missing" ] \
    || printf "gang: WARNING: hitching '%s' without %s; the collar will choose any missing default. Pass every supported choice deliberately.\n" \
      "$name" "$missing" >&2
  # SAID WHERE THE HARNESS IS CHOSEN, and the two halves fail differently. Drop
  # is where either used to be discovered, and by then the choice it should have
  # informed is spent. One warning covering both said something false about each:
  # a collar with no resume launch can still WITNESS an id, and a collar with no
  # witness can still be relaunched onto an id the operator holds.
  if [ -z "$GANG_RESUME_LAUNCH" ]; then
    printf "gang: WARNING: collar '%s' declares no resume launch, so nothing relaunches '%s' onto its harness session: --resume is refused for this collar, and any session id it witnesses is a record of that session rather than a way back into it. 'gang collars' marks what each collar resumes.\n" \
      "$prof" "$name" >&2
  elif ! declare -F collar_session_id >/dev/null; then
    printf "gang: WARNING: collar '%s' witnesses no harness session identity, so Gangline will never learn '%s''s session id: gang drop can print none, and --resume relaunches only onto an id you hold yourself. 'gang collars' marks what each collar resumes.\n" \
      "$prof" "$name" >&2
  fi
  if [ -n "$model" ]; then
    [ -n "$GANG_MODEL_OPT" ] || die "hitch: collar '$prof' declares no GANG_MODEL_OPT, so it cannot take -m"
    case "$model" in *[!A-Za-z0-9._:/@-]*) die "hitch: model '$model' has characters gang will not paste into a launch line" ;; esac
    validate_model_choice "$prof" "$model"
    GANG_LAUNCH="$GANG_LAUNCH $GANG_MODEL_OPT $model"
  fi
  # Effort rides the model's path, and the POSITION is the argument rather than
  # the append: the resume swap above has already chosen which launch line this
  # is, so the plain and resume forms both carry the flag by construction
  # instead of by a second branch kept in step with this one. A flag surviving
  # hitch and lost on the other form would be a renewal that quietly changed
  # the agent.
  #
  # No space in the join. Where a model's flag and value are separate words, an
  # effort's separator belongs to the harness's own spelling — `--effort=` and
  # `-c model_reasoning_effort=` are each one word — so the collar declares
  # the whole thing and word-splitting does the rest.
  if [ -n "$effort" ]; then
    [ -n "$GANG_EFFORT_OPT" ] || die "hitch: collar '$prof' declares no GANG_EFFORT_OPT, so it cannot take -e"
    case "$effort" in *[!A-Za-z0-9._:/@-]*) die "hitch: effort '$effort' has characters gang will not paste into a launch line" ;; esac
    # REFUSED WHERE NO VALIDATION IS DECLARED, rather than accepted unchecked.
    # The harness will not catch it: claude warns about an unknown level, exits
    # 0 and runs at its default, and codex opens a window whose first turn the
    # PROVIDER refuses — so the operator gets a live agent at an effort nobody
    # chose, or one that dies as soon as it is briefed. Hitch is the last place
    # this is cheap.
    [ -n "$GANG_EFFORT_CMD" ] \
      || die "hitch: collar '$prof' declares GANG_EFFORT_OPT but no GANG_EFFORT_CMD, so gang cannot tell whether '$effort' is a level this harness has. An unchecked effort is not refused by the harness either — it runs at a level nobody chose — so it is refused here"
    local levels="" flat="" levels_rc=0
    levels="$(effort_levels "$model")" || levels_rc=$?
    [ "$levels_rc" -eq 0 ] \
      || die "hitch: collar '$prof' declares GANG_EFFORT_CMD and running it failed (status $levels_rc), so gang could not determine whether '$effort' is a level. That is a broken declaration rather than a bad value"
    [ -n "$levels" ] \
      || die "hitch: collar '$prof' declares GANG_EFFORT_CMD and running it produced no levels, so gang could not determine whether '$effort' is one. That is a broken declaration rather than a bad value"
    # Padded on both sides and matched whole, so a level cannot be satisfied by
    # sitting inside another one — `high` must not be answered by `xhigh`.
    flat=" $(printf '%s' "$levels" | tr '[:space:]' ' ') "
    case "$flat" in
      *" $effort "*) ;;
      *) die "hitch: '$effort' is not an effort collar '$prof' takes (have:$flat)" ;;
    esac
    GANG_LAUNCH="$GANG_LAUNCH $GANG_EFFORT_OPT$effort"
  fi

  # AFTER THE MODEL IS SETTLED, because the collar's default is a per-model
  # answer and an unvalidated model is not one to ask about. Still before the
  # first tmux mutation, so a spec this refuses leaves no registered agent
  # behind.
  context_lights_resolve "$prof" "$model" "$GANG_CONTEXT_LIGHTS" "$lights_subject"
  if context_lights_parse "$CONTEXT_LIGHTS_SPEC" "$CONTEXT_LIGHTS_SUBJECT"; then
    lights="$CONTEXT_LIGHTS_SPEC"
  fi

  require_python3
  contract_read
  doctrine_read

  if [ "$CONTRACT_SYSTEM" -eq 1 ]; then
    system_prompt_build
    GANG_LAUNCH="$GANG_LAUNCH $GANG_ROLE_PROMPT_OPT $(shell_quote "$SYSTEM_PROMPT")"
  fi

  launch_env="GANG_SESSION=$(shell_quote "$SESSION")"
  launch_env="$launch_env GANG_CONFIG_DIR=$(shell_quote "$CONFIG_DIR")"
  [ -z "${GANG_COLLARS:-}" ] \
    || launch_env="$launch_env GANG_COLLARS=$(shell_quote "$GANG_COLLARS")"
  [ -z "${GANG_LOCK_DIR:-}" ] \
    || launch_env="$launch_env GANG_LOCK_DIR=$(shell_quote "$GANG_LOCK_DIR")"
  GANG_LAUNCH="env $launch_env $GANG_LAUNCH"
  scope_launch_wrap "$name"
  tmux_guard_wrap

  # Every hitch publishes a spool identity after launch. A bad operator root
  # is already fully knowable here; discovering it only in spool_mint reports
  # failure after leaving a registered, running agent behind.
  spool_root_prepare

  gang_path_skew_warn

  if ! session_live; then
    # WRAPPED HERE, NOT AROUND THE CLIENT THAT ATTACHES LATER. This is the one
    # call in gang that can fork a tmux server, so it is the one place the
    # server can be born inside a unit gangline names. The forked server
    # inherits this scope's cgroup and keeps it after the client returns.
    scope_server_wrap
    id="$(${SCOPE_ARGV[@]+"${SCOPE_ARGV[@]}"} \
          tmux new-session -d -P -F '#{window_id}' -s "$SESSION" -n "$name" -c "$dir" "$GANG_LAUNCH")" \
      || die "could not start session '$SESSION' for '$name'"
    opened_session=1
  elif [ -n "$id" ]; then
    pane_dead="$(tmux display-message -p -t "$id" '#{pane_dead}' 2>/dev/null)" || pane_dead=""
    [ "$resume" -eq 1 ] && [ "$pane_dead" = 1 ] \
      || die "agent '$name' already exists and its pane is live; refusing to replace it with a resumed harness"
    tmux respawn-window -k -t "$id" -c "$dir" "$GANG_LAUNCH" \
      || die "could not resume '$name' in its registered window"
  else
    id="$(tmux new-window -d -P -F '#{window_id}' -t "=$SESSION" -n "$name" -c "$dir" "$GANG_LAUNCH")" \
      || die "could not open a window for '$name' in session '$SESSION'"
  fi
  [ -n "$id" ] || die "'$name' never appeared in session '$SESSION'"
  # A LAUNCH THAT DIES TAKES ITS WINDOW WITH IT, and every registration below
  # then fails on a window id the operator never saw — a raw `no such window`
  # naming nothing gang had tried to run. Read the death here, where the launch
  # line is still in hand to name, and read it again from each registration,
  # because a launch can die at any point in this stretch and not only before it.
  ! launch_dead "$id" || die "$(launch_death_note "$name" "$id" "$GANG_LAUNCH")"
  hitch_register "$id" "$name" automatic-rename off
  hitch_register "$id" "$name" allow-rename off
  hitch_register "$id" "$name" @gl_agent "$name"
  hitch_register "$id" "$name" @gl_collar "$prof"
  # Window options survive a resume respawn. A held resource belonged to the
  # old native process; only the new launch's own Stop may witness another.
  waiting_clear "$id"
  hitch_register "$id" "$name" @gl_root "$ROOT"
  stamp_binary_id "$id" "$name"
  spool_mint "$id"
  # AFTER THIS SESSION HAS A SPOOL OF ITS OWN, and only for the hitch that
  # opened the session. A spool under the root that no live window claims
  # belonged to a window that is gone, and the only route out of gangline for
  # its mail is the archive — `drop` and `down` never ran for it. Sweeping on
  # every hitch would ask the same question again for every later agent; asking
  # it once, where a team starts, is where the answer can have changed.
  [ "$opened_session" -eq 0 ] || spool_sweep_orphans
  team_socket_record "$SESSION"
  # WRITTEN ON EVERY HITCH, INCLUDING THE EMPTY ONE. A `--resume` respawns the
  # window it is registered to, and window options outlive a respawn — so a
  # stamp left from an earlier launch would keep lights armed over a launch that
  # wired no native source for them to read, and every hook would report the
  # reading it could not take. The lights an agent has are the ones its own
  # launch resolved; an empty value is off, exactly as an absent one is.
  hitch_register "$id" "$name" @gl_context_lights "$lights"
  if [ "$GANG_USAGE_LIGHTS" != off ]; then
    hitch_register "$id" "$name" @gl_usage_lights "$GANG_USAGE_LIGHTS"
  fi
  if [ "$GANG_AUTO_RESUME" != off ]; then
    hitch_register "$id" "$name" @gl_auto_resume "$GANG_AUTO_RESUME"
  fi
  exists "$name" || {
    lookup_rc=$?
    win_id_missing "$lookup_rc" "'$name' died at launch (cmd: $GANG_LAUNCH)"
  }
  local msg delivery_err="" delivery_rc=0
  msg="$(startup_brief "$name" "$DOCTRINE")"
  echo "$(colour "$C_OK" "hitched $name") ($prof) in $dir$(colour "$C_DIM" "${lights:+ — context lights $lights} — watch: gang attach")"
  printf '%s\n' "$(colour "$C_WORK" "waiting for $name to finish booting...")"
  local ready=0 recovery
  wait_ready "$id" "$boot" "$name" || ready=$?
  recovery="most likely a first-run prompt gang does not recognize. Answer it with 'gang attach'; once the input box appears the agent is healthy — deliver its contract with 'gang send --to $name' rather than dropping it. Drop and re-hitch only if the box never appears."
  case "$ready" in
    0) ;;
    1) die "'$name' is running but its input box did not become ready, so its startup message was not delivered — $recovery" ;;
    2) die "'$name' is up but is showing something other than its input box, so its startup message was not delivered — $recovery" ;;
    6) die "$(launch_death_note "$name" "$id" "$GANG_LAUNCH")" ;;
    5)
         # COMMIT BEFORE REPORTING ACCEPTANCE. Hitch remains the foreground
         # owner of this startup: it keeps observing through the same universal
         # tty surface until the composer appears, so delivery does not depend
         # on a hook the operator may decline at the native security gate. If
         # hitch is interrupted, the attributed envelope remains inspectable in
         # the ordinary spool instead of being dropped.
         envelope hitch "$msg"
         spool_write "$id" hitch "$ENVELOPE" "startup contract"
         local startup_entry="$SPOOL_ENTRY" startup_dir="$SPOOL_DIR" startup_base
         startup_base="${startup_entry##*/}"
         local startup_action="answer the observed native startup prompt with 'gang attach'"
         [ "$HITCH_UP_MODE" -eq 0 ] \
           || startup_action="answer the observed native startup prompt in the tmux client this up invocation opens"
         printf '%s\n%s\n' \
           "$(colour "$C_OK" "queued startup contract for $name — accepted, not yet in the session")" \
           "$(colour "$C_DIM" "($(spool_count "$id") waiting) $startup_action; this hitch will deliver the contract when the composer appears, and nothing further is needed from you. Until then 'gang roster' shows it queued.")"
         hitch_up_attach "$id"
         local follow_boot="$boot"
         [ "$follow_boot" -gt 0 ] || follow_boot=1
         # A GATE IS ANSWERED BY A PERSON, and this budget is how long gang
         # holds its caller's terminal waiting for one. Unbounded, a prompt
         # nobody is there to answer stalls the hitch for as long as the team
         # runs, and the caller — often another agent, which cannot answer a
         # native prompt at all — is stalled with it: one gated boot becomes two
         # stopped agents. Bounded, the agent is still alive and its contract
         # still parked; what ends is gang's claim on the terminal.
         #
         # LOOKS, NOT SECONDS. Every wait_ready pass that sees the gate returns
         # on its first reading, so this counts observations of an unanswered
         # prompt rather than a duration — and a duration would be spent
         # instantly under a stopped clock, where the give-up path could then
         # never be driven. Sixty is comfortably more than a person already
         # looking at the window needs to read a menu and answer it, and small
         # enough that a caller who CANNOT answer is released instead of held
         # for the rest of the run. Raise it where a gate is expected to sit
         # unanswered for a while and the terminal is free to wait.
         local gate_seen=0
         while :; do
           ready=1
           while [ "$ready" -ne 0 ]; do
             ready=0
             wait_ready "$id" "$follow_boot" "$name" quiet || ready=$?
             # The one verdict this loop must not absorb is the one that will
             # never change on its own.
             [ "$ready" -ne 6 ] || die "$(launch_death_note "$name" "$id" "$GANG_LAUNCH")"
             if [ "$ready" -eq 5 ]; then
               gate_seen=$((gate_seen + 1))
               # NOT `up`. The budget releases a caller who cannot answer the
               # prompt, and `up` has already put its caller in a tmux client
               # looking straight at it — giving up there would detach the one
               # client that can answer, taking the answer away to report that
               # nobody had given it.
               [ "$HITCH_UP_MODE" -eq 1 ] || [ "$gate_seen" -lt "$gate_looks" ] \
                 || hitch_gate_unanswered "$name" "$id" "$gate_seen"
               sleep 1
             fi
           done
           delivery_rc=0
           delivery_err="$(spool_drain "$id" 2>&1)" || delivery_rc=$?
           case "$delivery_rc" in
             0) break ;;
             3) continue ;;
             4) if ! spool_existing "$id" || [ "$SPOOL_DIR" != "$startup_dir" ] \
                   || [ ! -d "$startup_dir" ]; then
                  fail 1 "startup contract to '$name' cannot be accounted for after its composer appeared: its original spool is no longer attached to the window"
                fi
                if [ -e "$startup_entry" ] || [ -e "$startup_dir/sending-$startup_base" ] \
                  || [ -e "$startup_dir/failed-$startup_base" ] \
                  || [ -e "$startup_dir/unverified-$startup_base" ]; then
                  fail 1 "startup contract to '$name' is still held in its spool after another delivery worker crossed this hitch"
                fi
                break ;;
             5) delivery_err="${delivery_err#gang: }"
                fail 5 "startup contract to '$name' was typed into its composer and its submission could not be verified — it may already have been delivered, so gang will not send it again: ${delivery_err:-delivery could not be confirmed}" ;;
             *) delivery_err="${delivery_err#gang: }"
                fail "$delivery_rc" "startup contract to '$name' remains in spool state after its composer appeared: ${delivery_err:-delivery failed without an error}" ;;
           esac
         done
         glyph_write "$id" "-busy-"
         [ "$HITCH_UP_MODE" -eq 1 ] \
           || printf '%s\n' "$(colour "$C_OK" "delivered queued startup contract to $name")"
         return 0 ;;
    *) die "internal: wait_ready returned unknown verdict $ready" ;;
  esac
  envelope hitch "$msg"
  delivery_err="$(inject "$id" "$ENVELOPE" 2>&1)" || delivery_rc=$?
  if [ "$delivery_rc" -ne 0 ]; then
    delivery_err="${delivery_err#gang: }"
    fail "$delivery_rc" "startup contract to '$name' was not delivered: ${delivery_err:-delivery failed without an error}"
  fi
  glyph_write "$id" "-busy-"
  printf '%s\n' "$(colour "$C_OK" "delivered startup contract to $name")"
}

# THE END OF GANG'S WAIT, NOT THE END OF THE AGENT. Everything hitch built is
# still standing: the window is live, the harness is running behind its own
# prompt, and the attributed contract is committed to the ordinary spool where
# `gang mail` reads it and `gang roster` shows it waiting. What this refusal
# reports is that gang stopped watching, and it exits 4 so a caller can tell
# this apart from a hitch that failed and from one that delivered.
#
# NOTHING DRAINS THAT ENTRY ON ITS OWN. A spool is claimed at a native turn
# boundary, and an agent still behind its first-run prompt has taken no turn and
# will take none until a person answers — so the recovery named here is the one
# that works rather than the one that sounds least disruptive. Answering is a
# native, persisted choice: the next hitch on that harness boots past it.
hitch_gate_unanswered() { # $1 name, $2 window, $3 observations spent
  fail 4 "'$1' is still showing a native first-run prompt after $3 observations, so its startup contract was NOT delivered and gang has stopped waiting for the prompt to be answered. The agent is alive and the contract is parked in its spool ('gang mail $1' reads it, 'gang roster' shows it waiting), but nothing claims a spool before that agent takes a turn, and it cannot take one from behind the prompt. Answer the prompt with 'gang attach', then 'gang drop $1' and hitch again. Raise GANG_GATE_LOOKS where a terminal is free to keep waiting."
}

cmd_up() { # bare `gang up` is the whole setup: one agent, and you in it
  local name="lead" id rc=0 attach_rc=0
  case "${1:-}" in ''|-*) ;; *) name="$1"; shift ;; esac
  HITCH_UP_MODE=1
  HITCH_ATTACH_PID=""
  HITCH_ATTACH_STATE=""
  HITCH_SWITCHED=0
  cmd_hitch "$name" -r lead "$@"
  if [ -n "$HITCH_ATTACH_PID" ]; then
    wait "$HITCH_ATTACH_PID" || attach_rc=$?
    HITCH_ATTACH_PID=""
    hitch_up_state_clear
    return "$attach_rc"
  fi
  [ "$HITCH_SWITCHED" -eq 0 ] || return 0
  id="$(win_id "$name")" || { rc=$?; win_id_missing "$rc" "up: '$name' vanished between hitch and attach"; }
  if [ -n "${TMUX:-}" ]; then
    tick_launch || true
    exec tmux switch-client -t "=$SESSION" \; select-window -t "$id"
  fi
  tick_launch || true
  exec tmux attach -t "=$SESSION" \; select-window -t "$id"
}

send_live() { # $1 target, $2 locked if caller holds lock, $3 live-only probe;
              # AGENT_ID and ENVELOPE set.
              # 3 = refused, nothing typed
  local busy_rc=0 box="" keep_lock=0
  # THE CALLER MAY OWN THE LOCK. Where the queue choice and the claim have to be
  # one critical section, the lock is taken before this function and outlives
  # it: a command substitution's exit does not fire the EXIT trap that would
  # release it, so the decision and the commit stay under one hold.
  case "${2:-}" in
    '') lock_pane "$AGENT_ID" ;;
    locked) [ -n "$LOCK_PATH" ] || die "internal: send_live called locked without a pane lock"
            keep_lock=1 ;;
    *) die "internal: send_live received unknown lock mode '$2'" ;;
  esac
  # A UI owning the composer is the same condition inject refuses with, and it
  # carries the same verdict: nothing was typed, the body is still the sender's,
  # and later is a different answer from never. Where these two disagreed, the
  # disagreement decided whether the default parked a message or dropped it.
  ! occupied "$AGENT_ID" \
    || refuse "'$1' is occupied (authority unknown) — a UI owns its input box; inspect it with gang attach"
  busy "$AGENT_ID" || busy_rc=$?
  case "$busy_rc" in
    0) # States the fact and stops there. The instruction that used to live here
       # — wait for it to become idle — is advice for the SENDER, and it is
       # wrong on the path that follows: an accepted message is queued and the
       # sender has nothing left to do. The one caller where waiting IS the
       # answer is --live-only, and that path prints its own "NOT parked" line
       # saying so, because there the message really was not taken.
       case "${GANG_MIDTURN_INPUT:-}" in
         1) ;;
         steer) [ "${3:-}" != live-only ] \
                  || refuse "'$1' is mid-turn; --live-only cannot use the attributed spool that makes steering safe"
                refuse "'$1' is mid-turn; collar-declared steering starts only after the envelope commits to its attributed Gangline spool" ;;
         park) [ "${3:-}" != live-only ] \
                 || refuse "'$1' is not safely reachable mid-turn; --live-only did not park it"
               refuse "'$1' is mid-turn; its attributed Gangline spool is the only landing that requires no composer keystroke" ;;
         *) refuse "'$1' is not safely reachable mid-turn" ;;
       esac ;;
    2) # Could-not-determine is not busy. An expired witness is stale owned
       # state, and it must not veto a delivery that fresh box evidence can
       # prove safe — the same inversion the staged-record read-repair fixed
       # for status. A provably empty composer proceeds into inject, whose
       # own guards and post-Enter queue verification carry the residual
       # risk truthfully; anything less than provably empty refuses, naming
       # BOTH the expired witness and the box state instead of claiming
       # mid-turn work nobody witnessed.
       if [ "${GANG_MIDTURN_INPUT:-}" != 1 ]; then
         # NOT every could-not-determine is an absence. The fall-through below
         # exists because stale evidence must not veto what a fresh reading can
         # prove safe — but when the verdict is could-not-determine BECAUSE
         # gang watched the pane being written to during the decision, the box
         # is not a settled reading of a quiet screen. It is one frame of a
         # screen in motion, and a harness can paint a whole turn's first
         # moments with its composer still empty. Typing there is typing into
         # work that started while gang was making up its mind.
         [ "$BUSY_MOVED" -eq 0 ] \
           || refuse "'$1' has no usable busy witness ($BUSY_EXPIRED_WHAT) — an empty input box read out of a moving screen does not prove no turn is running, and gang will not type into one; wait for it to settle, or inspect it with gang capture $1"
         # An unreadable box is normally refused upstream by the occupancy
         # guard; this read is the backstop for one that vanishes between
         # those two looks.
         box="$(landing_zone "$AGENT_ID")" \
           || refuse "'$1' has no usable busy witness ($BUSY_EXPIRED_WHAT) and its input box cannot be read — neither work nor idleness is provable; inspect with gang capture $1"
         if grep -q '[^[:space:]]' <<<"$box"; then
           refuse "'$1' has no usable busy witness ($BUSY_EXPIRED_WHAT) and its input box is not provably empty [$(box_class "$AGENT_ID" "$box" "$1")] — gang cannot tell a stale bracket from live work with that sitting there"
         fi
       fi ;;
    1) ;;
    *) die "internal: busy returned unknown verdict $busy_rc" ;;
  esac
  inject "$AGENT_ID" "$ENVELOPE" "" locked
  [ "$keep_lock" -eq 1 ] || lock_release
  # No @gl_turn write exists anywhere on this path — not here, and not in the
  # witnesses it consults (turn_witness reports a malformed value without
  # repairing it). Native hooks write the bracket lock-free, tmux offers no
  # atomic compare-and-delete, and a fresh UserPromptSubmit stamp landing
  # between any read gang takes and any unset it issues would be erased.
  # `gang interrupt` is the one command outside them that edits the bracket,
  # and it drops the fact rather than closing it, because it saw a keystroke
  # leave and not a turn end.
}

cmd_send() {
  local name="" from="" use_stdin=0 body="" live_only=0 supersede=0 rc=0 err="" frag
  local drain_rc=0 drain_err="" commit_err="" next_opportunity="next completes a turn"
  while [ $# -gt 0 ]; do case "$1" in
    --to) [ $# -ge 2 ] || die "send: --to needs a value"
          [ -z "$name" ] || die "send: --to may be passed only once"
          name="$2"; shift 2 ;;
    --from) [ $# -ge 2 ] || die "send: --from needs a value"; from="$2"; shift 2 ;;
    --stdin) [ "$use_stdin" -eq 0 ] || die "send: --stdin may be passed only once"
             use_stdin=1; shift ;;
    --live-only) live_only=1; shift ;;
    --supersede) supersede=1; shift ;;
    # A BODY IS THE LIKELY MISTAKE, so the refusal that catches it names the
    # remedy. Anything not shaped like a flag is what someone typed where the
    # body goes, and the whole body then comes back at them as "unknown
    # argument" with nothing saying where it should have gone instead.
    -*) die "send: unknown argument '$1'" ;;
    *) die "send: unknown argument '$1' — a message body is not an argument; gang reads it from stdin: gang send --to <name> --stdin" ;;
  esac; done
  [ -n "$name" ] || die "send: target required (--to <name>)"
  [ "$use_stdin" -eq 1 ] || die "send: message body required on stdin"
  [ "$supersede" -eq 0 ] || [ "$live_only" -eq 0 ] \
    || die "send: --supersede replaces an older message in the spool, and --live-only never parks one"
  send_sender "$from"
  send_identity_guard
  stdin_body "send"
  body="$STDIN_BODY"
  resolve "$name"
  [ -z "$SEND_WINDOW" ] || [ "$SEND_WINDOW" != "$AGENT_ID" ] \
    || refuse "send: '$name' resolves to this sending pane; a message that returns to its author is never intended"
  envelope "$SEND_WIRE" "$body"
  if [ "$live_only" -eq 1 ]; then
    send_live "$name" "" live-only
    printf '%s\n' "$(colour "$C_OK" "delivered to $name as [gang:$SEND_WIRE]") $(colour "$C_DIM" "(verified in pane, submitted)")"
    return 0
  fi
  # ONE CRITICAL SECTION. The pane lock is taken HERE rather than inside
  # send_live, because everything from here to the end of this send is one
  # transaction over one window: the retirement is prepared, delivery is
  # attempted live, a refusal falls back to staging and committing a spool entry,
  # the retirement is made final, and a steering collar may drain the queue — and
  # a second sender interleaving with any of that could type ahead of an entry
  # this one is about to commit, or read a queue mid-move. Taking the lock inside
  # send_live covered only the delivery attempt and left the rest outside it. A
  # command substitution's exit does not fire the EXIT trap, so the lock taken
  # here survives the call and covers the whole sequence.
  lock_pane "$AGENT_ID"
  # THE RETIREMENT IS PREPARED BEFORE ANYTHING IS DELIVERED, and it has to be,
  # because the live path has no second chance. Retiring AFTER send_live meant a
  # sweep that met an unreadable entry rolled back and refused with the new body
  # already typed and submitted: every predecessor still queued to arrive after
  # it, the supersession silently not honoured, and a refusal printed for a
  # message that had in fact been delivered — which invites the sender to send it
  # again. Preparing first makes the whole thing one decision: the predecessors
  # move out of the drainable namespace here, and if that cannot be done nothing
  # is typed at all. send_live does not read the spool, so moving them changes
  # nothing about the delivery it chooses.
  if [ "$supersede" -ne 0 ] && ! spool_supersede_try "$AGENT_ID" "$SEND_FROM"; then
    lock_release
    die "$SPOOL_SUPERSEDE_ERROR — so nothing was sent: --supersede promised the recipient would see this message INSTEAD of your older waiting ones, and it cannot be delivered without retiring them. Nothing was typed and nothing was retired. Read what could not be retired, then send again"
  fi
  # Only a REFUSAL is spoolable. Every refusal on this path happens before a
  # keystroke, so the body is provably still the sender's; a hard failure means
  # something was already typed and its fate is unknown, and parking that would
  # queue a second copy of a message that may already have landed.
  err="$(send_live "$name" locked 2>&1)" || rc=$?
  case "$rc" in
    0) # Delivered. The retirement it was conditional on is now final.
       [ "$supersede" -eq 0 ] || spool_retire_commit \
         || printf '%s\n' "gang: $SPOOL_SUPERSEDE_ERROR" >&2
       lock_release
       [ -z "$err" ] || printf '%s\n' "$err" >&2
       printf '%s\n' "$(colour "$C_OK" "delivered to $name as [gang:$SEND_WIRE]") $(colour "$C_DIM" "(verified in pane, submitted)")"
       return 0 ;;
    3) ;;
    5) # KEYSTROKES LANDED AND THEIR OUTCOME IS UNKNOWN, so this send is neither
       # delivered nor parkable. Parking it would put a second copy in front of
       # a recipient who may already have the first; calling it a failure would
       # invite the sender to do the same thing by hand. The predecessors a
       # --supersede set aside go back, because the replacement that was to
       # stand in for them cannot be said to have arrived.
       [ "$supersede" -eq 0 ] || spool_retire_rollback \
         || printf '%s\n' "gang: $SPOOL_ROLLBACK_ERROR" >&2
       lock_release
       [ -z "$err" ] || printf '%s\n' "$err" >&2
       printf '%s\n%s\n' \
         "$(colour "$C_BAD" "delivered but UNVERIFIED to $name as [gang:$SEND_WIRE]")" \
         "$(colour "$C_DIM" "nothing is waiting in the spool for this message and nothing will send it again — it was typed into $name's composer and gang lost the screen before it could confirm. Read '$name' (gang capture $name) and send again only if it is not there.")"
       exit 5 ;;
    *) # A ROLLBACK THAT FAILS IS NEWS. spool_retire_rollback clears the record of
       # what it moved whether or not it got everything back, so the exit trap
       # cannot report what this arm swallows: discarding its diagnostic would
       # leave the sender's older mail under .retiring-, undeliverable and unnamed,
       # on a path that already knows something went wrong.
       [ "$supersede" -eq 0 ] || spool_retire_rollback \
         || printf '%s\n' "gang: $SPOOL_ROLLBACK_ERROR" >&2
       lock_release
       [ -z "$err" ] || printf '%s\n' "$err" >&2
       exit "$rc" ;;
  esac
  if ! spool_available "$AGENT_ID" "$name"; then
    [ "$supersede" -eq 0 ] || spool_retire_rollback \
      || printf '%s\n' "gang: $SPOOL_ROLLBACK_ERROR" >&2
    lock_release
    [ -z "$err" ] || printf '%s\n' "$err" >&2
    printf 'send: NOT parked — %s. Send again when '\''%s'\'' is idle.\n' \
      "$SPOOL_UNAVAILABLE_WHY" "$name" >&2
    exit 3
  fi
  frag="${body%%$'\n'*}"
  [ "${#frag}" -le 40 ] || frag="${frag:0:40}…"
  # THE PARK IS THE LAST STEP OF A TRANSACTION THAT IS ALREADY OPEN. The sweep
  # above has moved this sender's older bodies out of the [0-9]* namespace, so
  # nothing can drain them and nothing has been destroyed; what remains is to put
  # this body where a drain WILL claim it, and only then make the retirement
  # final.
  #
  # The order matters in both directions, and what has to come last is the
  # DESTRUCTIVE step. Unlinking the predecessors before the body exists loses
  # mail: every way the write can die — an unusable stamp, the temporary write,
  # the commit rename — would leave the sender's older messages already gone with
  # nothing in their place. Moving them aside first is safe precisely because it
  # destroys nothing and every failure path puts them back. Parking before the
  # retirement is final delivers BOTH:
  # predecessor and replacement side by side, where the very next native boundary
  # claims the whole queue as one bundle and delivers the superseded body too —
  # the failed supersession arriving as a successful one. Staging the body, then
  # committing it, then unlinking what was set aside is the single ordering that
  # is safe against both.
  spool_stage "$AGENT_ID" "$SEND_FROM" "$ENVELOPE" "$frag"
  if ! spool_commit_try; then
    commit_err="$SPOOL_COMMIT_ERROR"
    [ "$supersede" -eq 0 ] || spool_retire_rollback \
      || commit_err="$commit_err — $SPOOL_ROLLBACK_ERROR"
    die "$commit_err — this send was NOT parked and your body is still written at $SPOOL_STAGED. Nothing it would have superseded was retired"
  fi
  [ "$supersede" -eq 0 ] || spool_retire_commit \
    || printf '%s\n' "gang: $SPOOL_SUPERSEDE_ERROR" >&2
  # Steering-capable collars still land without a keystroke: the committed
  # spool entry is now the ordering authority. While this same pane lock is
  # held, try the whole queue. A free composer drains it now; copy-mode, a
  # draft, or any other pre-keystroke refusal leaves every entry live.
  if [ "$GANG_MIDTURN_INPUT" = steer ]; then
    next_opportunity="next exposes a free composer at a native delivery opportunity"
    drain_err="$(trap - EXIT; spool_drain "$AGENT_ID" locked 2>&1)" || drain_rc=$?
    case "$drain_rc" in
      0) lock_release
         [ -z "$drain_err" ] || printf '%s\n' "$drain_err" >&2
         printf '%s\n' "$(colour "$C_OK" "delivered to $name as [gang:$SEND_WIRE]") $(colour "$C_DIM" "(verified from its attributed spool into collar-declared mid-turn input)")"
         return 0 ;;
      3|4) err="$drain_err" ;;
      5) lock_release
         [ -z "$drain_err" ] || printf '%s\n' "$drain_err" >&2
         printf '%s\n%s\n' \
           "$(colour "$C_BAD" "delivered but UNVERIFIED to $name as [gang:$SEND_WIRE]")" \
           "$(colour "$C_DIM" "it was typed into $name's composer from its attributed spool and gang lost the screen before it could confirm. Nothing will send it again; its record is in the spool and 'gang status $name' names it. Read '$name' (gang capture $name) and send again only if it is not there.")"
         exit 5 ;;
      *) lock_release
         [ -z "$drain_err" ] || printf '%s\n' "$drain_err" >&2
         exit "$drain_rc" ;;
    esac
  fi
  # The commit is done; the decision it was made against cannot change now.
  lock_release
  # Exit 0 must not say "refused" — the message was accepted; the word
  # survives only on the NOT-parked path above, which exits 3. And the drain
  # promise stays conditional on a later turn: an agent that never takes
  # another one never drains.
  printf '%s\n%s\n' \
    "$(colour "$C_OK" "queued for $name as [gang:$SEND_WIRE] — accepted, not yet in the session")" \
    "$(colour "$C_DIM" "($(spool_count "$AGENT_ID") waiting) ${err##*$'\n'} — it enters the session when '$name' $next_opportunity, and nothing further is needed from you. Until then 'gang roster' shows it queued.")"
}

TIMED_ENTRY=""
timed_write() { # $1 window, $2 sender, $3 envelope, $4 fragment, $5 due; sets TIMED_ENTRY
  local tmp
  spool_establish "$1"
  TIMED_ENTRY="$SPOOL_DIR/.timed-$(timed_stamp "$5")-$(mint_nonce)"
  # Staged then renamed, like every other entry: a reader that meets this
  # directory mid-write must never find a half-written message under a name
  # that means "ready". The `.writing-` prefix is the one spool_abandoned
  # already knows how to ask about and spool_dir_archive already carries out.
  tmp="$SPOOL_DIR/.writing-$$-at-$(timed_stamp "$5")"
  printf '%s\n%s\n%s\n' "$2" "$4" "$3" > "$tmp" \
    || die "at: cannot write a timed message into $SPOOL_DIR"
  mv -- "$tmp" "$TIMED_ENTRY" \
    || { rm -f -- "$tmp"
         die "at: cannot commit a timed message into $SPOOL_DIR — nothing was parked"; }
}

timed_arm() { # $1 window, $2 name, $3 entry path, $4 due; the clock that promotes it
  local base unit out rc=0
  base="${3##*/}"
  unit="$(timed_unit "$1" "$base")"
  local -a timer=(systemd-run --user --collect --unit="$unit"
    --on-calendar="@$4" --timer-property=AccuracySec=1s
    --property=Type=oneshot --setenv="GANG_SESSION=$SESSION"
    --setenv="GANG_CONFIG_DIR=$CONFIG_DIR" --setenv="PATH=$PATH")
  [ -z "${TMUX:-}" ] || timer+=(--setenv="TMUX=$TMUX")
  [ -z "${TMUX_TMPDIR:-}" ] || timer+=(--setenv="TMUX_TMPDIR=$TMUX_TMPDIR")
  [ -z "${GANG_COLLARS:-}" ] || timer+=(--setenv="GANG_COLLARS=$GANG_COLLARS")
  [ -z "${GANG_LOCK_DIR:-}" ] || timer+=(--setenv="GANG_LOCK_DIR=$GANG_LOCK_DIR")
  [ -z "${GANG_ARCHIVE_DIR:-}" ] || timer+=(--setenv="GANG_ARCHIVE_DIR=$GANG_ARCHIVE_DIR")
  timer+=("$ROOT/bin/gang" at --fire "$base" --to "$2" --unit "$unit")
  out="$("${timer[@]}" 2>&1)" || rc=$?
  [ "$rc" -eq 0 ] || return 1
  [ -z "$out" ] || printf '%s\n' "$out" >&2
  return 0
}

# THE ENTRY IS THE DECLARATION, so a callback that cannot match it does nothing
# and says nothing. Every early return here is a timer that outlived what it was
# armed for — a promoted entry, a cancelled one, a recreated team — and none of
# them may promote a message this timer was not armed to promote.
timed_fire() { # $1 name, $2 entry basename, $3 the unit systemd is running
  local name="$1" base="$2" fired="$3" id rc=0 entry due now err=""
  id="$(win_id "$name")" || rc=$?
  [ "$rc" -eq 0 ] || return 0    # a removed or replaced team makes this stale
  spool_existing "$id" || return 0
  entry="$SPOOL_DIR/$base"
  [ -f "$entry" ] || return 0    # promoted, cancelled, or never this window's
  [ "$(timed_unit "$id" "$base")" = "$fired" ] || return 0
  due="$(timed_due_of "$entry")" || return 0
  now="$(date +%s)"
  case "$now" in ''|*[!0-9]*) return 1 ;; esac
  [ "$due" -le "$now" ] || return 0   # an internal callback cannot deliver early
  resolve "$name"
  # PROMOTED BEFORE IT IS DELIVERED, and the rename is the whole promotion: the
  # entry stops being invisible to the drain and becomes an ordinary waiting
  # message, counted, aged, archived and superseded like any other. A drain that
  # then refuses leaves it waiting for the next native boundary, which is the
  # landing this verb promised — not a failure to be retried by anything here.
  mv -- "$entry" "$SPOOL_DIR/$(spool_stamp)-$(mint_nonce)" \
    || die "at: the timed message for $name came due and could not be moved into its queue; it is still at $entry"
  err="$(spool_drain "$id" 2>&1)" || rc=$?
  [ -z "$err" ] || printf '%s\n' "$err" >&2
  return 0
}

# THE MESSAGE AND THE CLOCK THAT PROMOTES IT CAN OUTLIVE EACH OTHER, and the
# entry alone then reports a delivery nothing will make. So the unit is read
# too, and "gone" is kept apart from "could not be read": one is a message that
# needs rescheduling and the other is a question this host could not answer.
timed_unit_state() { # $1 = unit basename -> live | gone | unreadable
  local state
  command -v systemctl >/dev/null 2>&1 || { printf 'unreadable'; return; }
  state="$(systemctl --user is-active "$1.timer" 2>/dev/null)" || true
  case "$state" in
    active|activating|reloading) printf 'live' ;;
    inactive|failed|deactivating) printf 'gone' ;;
    ''|unknown) printf 'unreadable' ;;
    *) printf 'unreadable' ;;
  esac
}

timed_report() { # $1 window id, $2 name; one truthful line per pending timed send
  local e due now unit state
  now="$(date +%s)"
  case "$now" in ''|*[!0-9]*) return 0 ;; esac
  while read -r e; do
    [ -n "$e" ] || continue
    if ! due="$(timed_due_of "$e")"; then
      printf '%s\n' "timed send: an entry at $e carries no readable due time, so when it would be delivered is unknown; read it and remove it by hand"
      continue
    fi
    unit="$(timed_unit "$1" "${e##*/}")"
    state="$(timed_unit_state "$unit")"
    if [ "$due" -gt "$now" ]; then
      case "$state" in
        live) printf '%s\n' "timed send: 1 message due $(curfew_format_epoch "$due") (in $(human_seconds "$(( due - now ))")), not waiting in the queue until then" ;;
        gone) printf '%s\n' "timed send: 1 message due $(curfew_format_epoch "$due"), and the timer that would deliver it is GONE — nothing will promote it; re-park it with gang at, or read it at $e" ;;
        *) printf '%s\n' "timed send: 1 message due $(curfew_format_epoch "$due"), and whether its timer still exists could not be read on this host; check with: systemctl --user list-units --all '$unit*'" ;;
      esac
    else
      printf '%s\n' "timed send: 1 message came due $(human_seconds "$(( now - due ))") ago and is still parked, so its timer did not run — nothing will promote it; re-park it with gang at, or read it at $e"
    fi
  done <<<"$(timed_entries "$1")"
}

# THE TIMER GOES FIRST AND THE MESSAGE SECOND. A removed entry beside a live
# timer is a callback that finds nothing and says nothing, which is harmless; a
# stopped timer beside a live entry is a message nothing will ever promote,
# reported as pending forever. Only one of those two orders can strand mail.
timed_cancel_one() { # $1 window id, $2 entry path; 0 = the message is provably gone
  local base unit
  base="${2##*/}"
  unit="$(timed_unit "$1" "$base")"
  usage_unit_stop "$unit" \
    || die "at: $USAGE_UNIT_TROUBLE, so the message it would deliver was left parked; recover with: $USAGE_UNIT_RECOVER"
  rm -f -- "$2" || die "at: cannot remove the timed message $2"
}

cmd_at() { # park an attributed envelope now, deliver it when the clock passes
  local when="" name="" from="" use_stdin=0 clear=0 fire="" fired_unit=""
  local now due frag entry n=0 e
  case "${1:-}" in ''|-*) ;; *) when="$1"; shift ;; esac
  while [ $# -gt 0 ]; do case "$1" in
    --to) [ $# -ge 2 ] || die "at: --to needs a value"
          [ -z "$name" ] || die "at: --to may be passed only once"
          name="$2"; shift 2 ;;
    --from) [ $# -ge 2 ] || die "at: --from needs a value"; from="$2"; shift 2 ;;
    --stdin) [ "$use_stdin" -eq 0 ] || die "at: --stdin may be passed only once"
             use_stdin=1; shift ;;
    --clear) clear=1; shift ;;
    --fire) [ $# -ge 2 ] || die "at: --fire needs an entry name"; fire="$2"; shift 2 ;;
    --unit) [ $# -ge 2 ] || die "at: --unit needs a transient unit name"
            fired_unit="$2"; shift 2 ;;
    -*) die "at: unknown argument '$1'" ;;
    *) die "at: unknown argument '$1' — a message body is not an argument; gang reads it from stdin: gang at <time> --to <name> --stdin" ;;
  esac; done
  if [ -n "$fire" ]; then
    [ -z "$when" ] && [ "$clear" -eq 0 ] && [ "$use_stdin" -eq 0 ] && [ -z "$from" ] \
      || die "at: --fire is internal and takes only an entry name, a target and a unit"
    [ -n "$name" ] || die "at: --fire needs the target it was armed for"
    [ -n "$fired_unit" ] \
      || die "at: --fire requires the --unit that armed it, so a stale timer cannot promote another message"
    case "$fire" in
      .timed-[0-9]*) ;;
      *) die "at: --fire was given '$fire', which is not the name of a timed entry" ;;
    esac
    case "$fire" in */*) die "at: --fire takes an entry name, not a path" ;; esac
    timed_fire "$name" "$fire" "$fired_unit"
    return
  fi
  [ -z "$fired_unit" ] || die "at: --unit belongs to the internal --fire callback"
  [ -n "$name" ] || die "at: target required (--to <name>)"
  if [ "$clear" -eq 1 ]; then
    [ -z "$when" ] && [ "$use_stdin" -eq 0 ] && [ -z "$from" ] \
      || die "at: --clear cancels every timed send parked for a target and takes nothing else"
    resolve "$name"
    while read -r e; do
      [ -n "$e" ] || continue
      timed_cancel_one "$AGENT_ID" "$e"
      n=$((n + 1))
    done <<<"$(timed_entries "$AGENT_ID")"
    [ "$n" -ne 0 ] || { printf 'no timed send parked for %s\n' "$name"; return; }
    printf 'cancelled %s timed send(s) parked for %s\n' "$n" "$name"
    return
  fi
  [ -n "$when" ] || die "at: a time is required: gang at <duration|HH:MM> --to <name> --stdin"
  [ "$use_stdin" -eq 1 ] || die "at: message body required on stdin"
  command -v systemd-run >/dev/null 2>&1 \
    || die "at: systemd-run is required for the transient user timer that delivers a timed send; nothing was parked"
  now="$(date +%s)"
  curfew_parse "$when" "$now" \
    || die "at: '$when' is not a time — use a duration like 90m or 2h30m, or a local clock time like 17:00"
  due="$CURFEW_PARSED"
  send_sender "$from" at
  send_identity_guard at
  stdin_body "at"
  resolve "$name"
  [ -z "$SEND_WINDOW" ] || [ "$SEND_WINDOW" != "$AGENT_ID" ] \
    || refuse "at: '$name' resolves to this sending pane; a message that returns to its author is never intended"
  envelope "$SEND_WIRE" "$STDIN_BODY"
  frag="${STDIN_BODY%%$'\n'*}"
  [ "${#frag}" -le 40 ] || frag="${frag:0:40}…"
  # ATTRIBUTED NOW, DELIVERED LATER. The envelope is minted here, where the
  # sender's pane can still be observed; re-attributing it in the callback would
  # downgrade an identity Gangline watched to one it was merely told, because
  # the clock has no pane of its own.
  lock_pane "$AGENT_ID"
  timed_write "$AGENT_ID" "$SEND_FROM" "$ENVELOPE" "$frag" "$due"
  entry="$TIMED_ENTRY"
  if ! timed_arm "$AGENT_ID" "$name" "$entry" "$due"; then
    rm -f -- "$entry"
    lock_release
    die "at: the transient timer could not be created, so nothing will deliver this message and it was NOT parked"
  fi
  lock_release
  printf '%s\n%s\n' \
    "$(colour "$C_OK" "parked for $name as [gang:$SEND_WIRE] — due $(curfew_format_epoch "$due")")" \
    "$(colour "$C_DIM" "(in $(human_seconds "$(( due - now ))")) it joins '$name's queue when the time passes and enters the session at the next delivery opportunity. 'gang status $name' names it until then; 'gang at --to $name --clear' cancels it.")"
}

# WHAT A PANE CAPTURE CAN CARRY, and nothing finer. One side of flush's
# comparison is now the body Gangline itself composed, and the other is a
# terminal capture of a composer holding it — so the two cannot be compared
# byte for byte, and the reason is the instrument rather than the rule. A
# capture pads every row to the pane width, gives continuation rows the
# composer's own gutter, and re-flows a body line too long for the box across
# several rows, where the break is indistinguishable from one the body wrote.
# Collapsing every run of blank space to one space is what survives all three.
#
# What that costs is stated rather than hidden: two bodies differing only in
# blank space — a trailing space, a line break where the other has a space,
# doubled spaces inside a line — canonicalise alike, and flush cannot tell them
# apart. No comparison against a capture ever could; the padding erases the
# first, the re-flow the second. Every difference in the body's actual text
# still refuses, which is what the readback exists to catch. A body whose long
# line re-flows mid-token gains a space the body never had and refuses: a false
# refusal, which is the safe direction and leaves the manual recovery where it
# always was.
flush_canon() { # $1 = text -> its content with every blank-space run collapsed
  local canon
  canon="$(printf '%s' "$1" | tr -s '[:space:]' ' ')"
  canon="${canon# }"
  printf '%s' "${canon% }"
}

# THE ACCOUNT A REFUSAL AFTER A RECALL OWES. Loading the parked body into the
# composer changes the world, so a refusal that lands after it cannot simply
# name what failed and stop: the body is somewhere, and only the caller can act
# on it. Gang says which part it can see and which part it never read, because
# the missing half is what makes handing the draft back dangerous — if the
# recall dequeued the message, submitting it by hand is the recovery, and if it
# did not, that is a second copy. Gang did not read the harness's queue and
# will not claim the draft drains on its own either; four tool-batch boundaries
# and about seventy seconds without entry were measured, which settles neither.
flush_stranded() { # $1 = target name
  printf 'What the recall loaded is visible and unsent in the composer of %s, and the Enter was NOT pressed. Whether a copy of it is also still waiting in that harness'"'"'s own queue was never read, so submitting the visible draft by hand may deliver it twice — and gang does not promise it will drain on its own. Read the screen with '"'"'gang capture %s'"'"' before deciding' \
    "$1" "$1"
}

# The recovery gang already diagnoses, performed as a verified operation rather
# than described in a refusal. Everything it needs is evidence it already owns:
# the collar's queue hint says the composer is parked, the collar's own recall
# key loads the parked body, and the record written when gang watched the
# harness park it says WHICH body must come back. No record, no hint, or a
# readback that does not match, and no Enter is pressed.
cmd_flush() {
  local name="${1:-}" parked body frag box loaded
  [ $# -le 1 ] || die "flush: unexpected argument '$2'"
  if [ -z "$name" ]; then
    name="$(self_name)" || {
      cmd_help flush
      printf '(no target given, and this shell is not a Gangline agent window)\n'
      exit 1
    }
  fi
  resolve "$name"
  [ -n "$GANG_QUEUED_REGEX" ] \
    || die "flush: collar '$AGENT_COLLAR' declares no GANG_QUEUED_REGEX, so gang cannot tell a parked queue from an ordinary composer and has nothing here it could verify (gang attach)"
  [ -n "$GANG_QUEUE_RECALL_KEY" ] \
    || die "flush: collar '$AGENT_COLLAR' declares no GANG_QUEUE_RECALL_KEY, so gang does not know the keystroke that loads this harness's parked message (gang attach)"
  parked="$(tmux show-options -wqv -t "$AGENT_ID" @gl_parked)"
  if [ -z "$parked" ]; then
    [ -z "$(tmux show-options -wqv -t "$AGENT_ID" @gl_parked_drained)" ] \
      || refuse "flush: the message gang watched the harness park in '$name' is NOT parked any more — its composer came back empty, so the queue drained itself (a harness does this when a compaction ends) or somebody submitted it by hand. There is nothing left here to recover, and this is not the same as never having been parked: look for it in the transcript before sending it again (gang capture $name)"
    refuse "flush: gang has no record of a message parked in the queue of '$name'. It recovers only a body it watched the harness park, because that record is what the loaded composer gets read back against — without it, $GANG_QUEUE_RECALL_KEY would submit whatever happened to be there (gang attach)"
  fi
  # THE BODY IS THE RECORD THAT MATTERS, and a park recorded without one is a
  # park gang cannot verify a recovery against — a message parked by an older
  # gang that recorded only the rendering. Saying so is the whole answer here:
  # falling back to the rendering is what this fix removed, and guessing which
  # of the two a composer should match is how a recovery submits a substitution.
  body="$(tmux show-options -wqv -t "$AGENT_ID" @gl_parked_body)"
  [ -n "$body" ] \
    || die "flush: gang recorded a parked message in '$name' but not the body it parked, so there is nothing authoritative to read the recalled composer back against and $GANG_QUEUE_RECALL_KEY was NOT pressed. A record from before gang kept the body cannot be verified; recover it by hand (gang attach, press Up to load the parked message, then Enter)"
  frag="${body%%$'\n'*}"
  [ "${#frag}" -le 40 ] || frag="${frag:0:40}…"
  lock_pane "$AGENT_ID"
  # A PARK UNDER A RUNNING TURN IS THE HARNESS WORKING. Every precondition
  # below this one describes the input box, and a busy target passes all of
  # them — so flush recalled the body, pressed Enter, the harness parked it
  # again because a turn was running, and submit_verify read that second park
  # as a queue nothing can drain. Its verdict is to drop the agent and hitch
  # --resume, which ends a live turn and loses the parked body; in the run this
  # was measured on, the same queue drained by itself thirteen seconds later.
  # The verdict is right about a target at rest that re-parks, so the refusal
  # goes here instead: before the recall key, where nothing has been typed.
  turn_state_read "$AGENT_ID" || TURN_STATE=""
  [ "$TURN_STATE" != open ] \
    || refuse "flush: the turn of '$name' is still running, so its harness is parking what it is handed — which is the harness working, not a queue that cannot drain. Pressing $GANG_QUEUE_RECALL_KEY here would park the message again and prove nothing. The queue may drain at a native boundary while the turn continues; if it has not, flush once '$name' is at rest (gang status $name)"
  ! occupied "$AGENT_ID" \
    || refuse "flush: '$name' is occupied (authority unknown) — a UI owns its input box, so $GANG_QUEUE_RECALL_KEY would answer that UI instead of loading the parked message (gang attach)"
  local settled_rc=0
  composer_settled "$AGENT_ID" || settled_rc=$?
  [ "$settled_rc" -ne 3 ] \
    || die "flush: cannot read the input box of '$name', so whether somebody is typing into it is unknown — $GANG_QUEUE_RECALL_KEY was not pressed (gang capture $name)"
  [ "$settled_rc" -ne 4 ] \
    || die "flush: gang got no settled reading of the input box of '$name' — the two looks it takes did not both come back with a box it could parse, so whether somebody is typing into it is unknown and $GANG_QUEUE_RECALL_KEY was not pressed (gang capture $name)"
  [ "$settled_rc" -eq 0 ] \
    || refuse "flush: somebody is typing into '$name' right now — recovering its queue underneath a live draft would submit their line (try again in a moment)"
  box="$(landing_zone "$AGENT_ID")" \
    || die "flush: cannot read the input box of $name — the harness is not taking input (gang capture $name)"
  box_queued "$box" \
    || refuse "flush: the composer of '$name' shows none of the parked-queue evidence its collar declares, so there is nothing to recover and gang will not press $GANG_QUEUE_RECALL_KEY blindly (gang capture $name)"
  pane_mode_free "$AGENT_ID" \
    || refuse "flush: tmux mode owns the pane of '$name', so $GANG_QUEUE_RECALL_KEY would act on operator-owned mode state instead of recalling the parked message; leave copy-mode, then retry"
  tmux send-keys -t "$AGENT_ID" "$GANG_QUEUE_RECALL_KEY"
  # The recall key has to visibly load something before there is anything to
  # read back. A composer that never changed is not a mismatch and not a
  # recovery: it is a key that did nothing, and no Enter follows it.
  local looks=0
  while :; do
    sleep 0.4
    loaded="$(landing_zone "$AGENT_ID")" \
      || die "flush: the input box of $name stopped reading back after $GANG_QUEUE_RECALL_KEY, so gang cannot tell what that key loaded. $(flush_stranded "$name")"
    [ "$loaded" = "$box" ] || break
    looks=$((looks + 1))
    [ "$looks" -lt 5 ] \
      || die "flush NOT performed: $GANG_QUEUE_RECALL_KEY left the composer of $name unchanged, so nothing was loaded for gang to read back and the Enter was NOT pressed (gang capture $name)"
  done
  # WHOLE, AND AGAINST THE BODY. Containment would accept a recalled body that
  # merely starts with the recorded one, so a truncated, altered or appended
  # remainder would be submitted as verified. What the whole is compared to is
  # the body gang composed and pasted — never a second reading of the composer.
  # Two readings taken at different moments are two renderings of one body, and
  # a harness that renders a pasted body as `[Pasted text #N +M lines]` and
  # expands it on recall makes them differ in kind, so that comparison could
  # never succeed for a body of more than one line. flush_canon above says
  # exactly what a capture of the second rendering can still carry.
  [ "$(flush_canon "$loaded")" = "$(flush_canon "$body")" ] \
    || { stage_record "$AGENT_ID" "'$frag' was recalled out of the harness's queue into this box and read back as something other than the message gang recorded as parked — it is sitting there unsent" "$loaded"
         die "flush NOT performed: $GANG_QUEUE_RECALL_KEY loaded something other than the message gang parked into the composer of $name — gang submits a recalled body only when the whole of it reads back as the body it watched the harness park. $(flush_stranded "$name")"; }
  submit_verify "$AGENT_ID" "$loaded" "$frag" recall '' "$body"
  lock_release
  printf '%s %s\n' \
    "$(colour "$C_OK" "flushed the parked message of $name")" \
    "$(colour "$C_DIM" "(recalled with $GANG_QUEUE_RECALL_KEY, read back against gang's record, submitted and verified)")"
}

cmd_interrupt() {
  local name="" reason="" from="" have_m=0 ready=0 rc=0 err=""
  # A LEADING FLAG IS NOT A BAD AGENT NAME. Reading it as one made a reasoned
  # stop the single self target an agent could not reach without knowing its
  # own name: bare `gang interrupt` already stops this window's turn, and
  # `gang interrupt -m "reason"` is that same stop carrying the note that says
  # why. An unknown flag is refused by name in the loop below, where the old
  # top-level synopsis dump said nothing about which argument was wrong.
  case "${1:-}" in
    ''|-*) ;;
    *) name="$1"; shift ;;
  esac
  # ARGUMENTS ARE DIAGNOSED BEFORE THE ENVIRONMENT IS. Resolving the omitted
  # target first made a malformed option print the synopsis and the not-an-agent
  # line from outside a Gangline window, naming everything except the argument
  # that was wrong. What the caller typed is knowable without a pane; where they
  # are standing is not.
  while [ $# -gt 0 ]; do case "$1" in
    -m) [ "$have_m" -eq 0 ] || die "interrupt: -m may be passed only once"
        [ $# -ge 2 ] || die "interrupt: -m needs a value"
        [ -n "$2" ] || die "interrupt: -m needs a non-empty message"
        reason="$2"; have_m=1; shift 2 ;;
    --from) [ $# -ge 2 ] || die "interrupt: --from needs a value"
        from="$2"; shift 2 ;;
    *) die "interrupt: unexpected argument '$1'" ;;
  esac; done
  [ "$have_m" -eq 1 ] || [ -z "$from" ] \
    || die "interrupt: --from names the author of a message; pass -m or drop it"
  if [ -z "$name" ]; then
    name="$(self_name)" || {
      cmd_help interrupt
      printf '(no target given, and this shell is not a Gangline agent window)\n'
      exit 1
    }
  fi
  if [ "$have_m" -eq 1 ]; then
    send_sender "$from" interrupt
    send_identity_guard interrupt
  fi
  resolve "$name"
  [ -n "$GANG_INTERRUPT_KEY" ] \
    || die "interrupt: collar '$AGENT_COLLAR' declares no GANG_INTERRUPT_KEY, so gang does not know the keystroke that stops a turn in this harness (gang attach)"
  if [ "$have_m" -eq 1 ]; then
    # A REASON THAT RETURNS TO ITS AUTHOR IS THE POINT HERE, where on send it
    # is an accident. The reason for a stop is written to be read after the
    # turn it ended, so an agent stopping itself is leaving exactly that note,
    # and refusing it would make a self target the one interrupt that has to
    # be spelled without its reason. What gang cannot promise is the delivery:
    # the caller runs inside the turn it is stopping, so a harness that ends
    # that turn by killing the tool call takes this process with it before the
    # reason is typed. That is the same verdict the stop itself is.
    envelope "$SEND_WIRE" "$reason"
  fi
  lock_pane "$AGENT_ID"
  # Occupancy is not authority here either: the stop key is very often the key
  # a native dialog reads as an answer, and gang does not answer dialogs.
  ! occupied "$AGENT_ID" \
    || refuse "interrupt: '$name' is occupied (authority unknown) — a UI owns its input box, so $GANG_INTERRUPT_KEY would answer that UI rather than stop a turn (gang attach)"
  pane_mode_free "$AGENT_ID" \
    || refuse "interrupt: tmux mode owns the pane of '$name', so $GANG_INTERRUPT_KEY would act on operator-owned mode state instead of the harness; leave copy-mode, then retry"
  tmux send-keys -t "$AGENT_ID" "$GANG_INTERRUPT_KEY" \
    || die "interrupt: could not send $GANG_INTERRUPT_KEY to $name"
  # CLEARED, NOT CLOSED. The interrupted turn is one the harness will never
  # close for itself, so leaving the bracket open strands a busy nothing will
  # end — but WRITING a closed one is worse, because turn_witness reads a fresh
  # closed bracket as definitive idle and returns before it ever looks at busy
  # paint or pane activity. A harness that ignored or has not yet acted on the
  # keystroke would then read idle, and the next send would enter mid-turn on
  # gang's own say-so. Gang saw a keystroke leave; it did not see a turn end.
  # Removing the fact is the only honest edit: the paint and activity tiers
  # answer from what the harness is actually doing, so a stopped turn goes idle
  # and one still running stays busy.
  #
  # THE SEAM: how an interrupt is RECORDED is gl-state's to design. There is no
  # truthful place to hang it in today's two-valued turn fact, and inventing a
  # third value here would be redesigning the state this arc was told not to.
  turn_state_clear "$AGENT_ID"
  if [ "$have_m" -eq 1 ]; then
    wait_ready "$AGENT_ID" "${GANG_BOOT_TIMEOUT:-30}" || ready=$?
    [ "$ready" -eq 0 ] \
      || { printf '%s\n' "$reason" >&2
           die "interrupt: $GANG_INTERRUPT_KEY was sent to '$name' and its input box did not come back, so the message was NOT delivered and was NOT parked — it is printed above so it is not lost. Read the pane with gang capture $name"; }
    err="$(inject "$AGENT_ID" "$ENVELOPE" "" locked 2>&1)" || rc=$?
    if [ "$rc" -ne 0 ]; then
      printf '%s\n' "$reason" >&2
      [ -z "$err" ] || printf '%s\n' "$err" >&2
      exit "$rc"
    fi
  fi
  lock_release
  printf '%s %s\n' \
    "$(colour "$C_OK" "interrupted $name with $GANG_INTERRUPT_KEY")" \
    "$(colour "$C_DIM" "(the turn bracket is dropped; whether the turn ended is now the pane's evidence to answer, and the stop remains the harness's verdict)")"
}

cmd_compact() {
  local name="" self="" mine=0 busy_rc=0 resume=""
  while [ $# -gt 0 ]; do case "$1" in
    --resume) [ $# -ge 2 ] || die "compact: --resume needs the turn to take after the compaction"
              [ -z "$resume" ] || die "compact: --resume may be passed only once"
              resume="$2"; shift 2 ;;
    -*) die "compact: unknown argument '$1'" ;;
    *) [ -z "$name" ] || die "compact: unexpected argument '$1'"
       name="$1"; shift ;;
  esac; done
  case "$resume" in
    *[![:space:]]*|'') ;;
    *) die "compact: --resume was given only whitespace; omit it to use the default continuation" ;;
  esac
  if [ -z "$name" ]; then
    name="$(self_name)" || {
      cmd_help compact
      printf '(no target given, and this shell is not a Gangline agent window)\n'
      exit 1
    }
  fi
  resolve "$name"
  [ -n "${GANG_COMPACT_CMD:-}" ] \
    || die "collar '$AGENT_COLLAR' declares no compact command"
  ! occupied "$AGENT_ID" \
    || die "'$name' is occupied (authority unknown) — inspect it with gang attach"
  self="$(self_window)" || self=""
  [ -n "$self" ] && [ "$self" = "$AGENT_ID" ] && mine=1
  if [ "$mine" -eq 1 ] && [ "$GANG_SELF_COMPACT" = deferred ]; then
    # CLAIM FIRST. self_compact_request is what refuses a request that already
    # stands, so anything written before it is written on the way to a refusal:
    # a bare compact erased the continuation an earlier --resume supplied, a
    # second --resume replaced it, and both then exited saying nothing had
    # happened. A refused boundary now puts its request back and retries at a
    # later one, so a standing request is an ordinary state and a second
    # compact an ordinary thing to try.
    self_compact_request "$AGENT_ID" >/dev/null
    if [ -n "$resume" ]; then
      tmux set-option -w -t "$AGENT_ID" @gl_self_compact_resume "$resume" \
        || { tmux set-option -uw -t "$AGENT_ID" @gl_self_compact_requested 2>/dev/null || true
             die "could not record the continuation for this compaction"; }
    else
      tmux set-option -uw -t "$AGENT_ID" @gl_self_compact_resume 2>/dev/null || true
    fi
    printf '%s\n' "$(colour "$C_OK" "self-compaction scheduled for the end of this turn") $(colour "$C_DIM" "(finish this turn now; a continuation turn follows the compaction)")"
    return 0
  fi
  if [ "$mine" -ne 1 ]; then
    busy "$AGENT_ID" || busy_rc=$?
    case "$busy_rc" in
      0) die "'$name' is mid-turn; compact it when idle" ;;
      1) ;;
      2) die "cannot determine whether '$name' is mid-turn; refusing compaction" ;;
    esac
  fi
  lock_pane "$AGENT_ID"
  inject "$AGENT_ID" "$(compact_command)" head locked
  compact_continue "$AGENT_ID" "$resume"
  lock_release
  tmux set-option -uw -t "$AGENT_ID" @gl_self_compact_failed 2>/dev/null || true
  printf '%s\n' "$(colour "$C_OK" "native compaction submitted to $name, with a continuation turn behind it") $(colour "$C_DIM" "(execution remains the harness's verdict)")"
}

cmd_curfew() { # declare, show, or clear one optional team curfew
  local spec="${1:-}" now rc=0
  [ $# -le 1 ] || die "curfew: unexpected argument '$2'; gang curfew takes one duration, HH:MM clock time, or clear"
  session_live || die "no team (session '$SESSION' not running)"
  if [ -z "$spec" ]; then
    curfew_read || rc=$?
    case "$rc" in
      0) require_python3; curfew_summary "$(date +%s)"; printf '\n' ;;
      1) printf 'no curfew declared\n' ;;
      2) die "the stored curfew is unreadable — gang curfew clear removes it" ;;
    esac
    return 0
  fi
  if [ "$spec" = clear ]; then
    tmux set-option -u -t "=$SESSION:" @gl_curfew 2>/dev/null || true
    printf 'curfew cleared\n'
    return 0
  fi
  require_python3
  now="$(date +%s)"
  curfew_parse "$spec" "$now" \
    || die "curfew: '$spec' is not a positive duration (90m, 2h, 1h30m) or 24-hour HH:MM clock time"
  if ! tmux set-option -t "=$SESSION:" @gl_curfew "$CURFEW_PARSED $now"; then
    die "curfew: could not store the declaration for session '$SESSION'"
  fi
  CURFEW_AT="$CURFEW_PARSED" CURFEW_DECLARED="$now"
  curfew_summary "$now"; printf '\n'
}

cmd_notify() { # declare, show, or clear one optional stall-note target
  local name="${1:-}" current
  [ $# -le 1 ] || die "notify: unexpected argument '$2'; gang notify takes one agent name or clear"
  session_live || die "no team (session '$SESSION' not running)"
  if [ -z "$name" ]; then
    current="$(tmux show-options -qv -t "=$SESSION:" @gl_notify 2>/dev/null)" || current=""
    [ -n "$current" ] \
      && printf 'notify target: %s\n' "$current" \
      || printf 'no notify target declared\n'
    return 0
  fi
  if [ "$name" = clear ]; then
    tmux set-option -u -t "=$SESSION:" @gl_notify 2>/dev/null || true
    printf 'notify target cleared\n'
    return 0
  fi
  valid_name "$name" || die "notify: '$name' is not a valid agent name"
  tmux set-option -t "=$SESSION:" @gl_notify "$name" \
    || die "notify: could not store the declaration for session '$SESSION'"
  printf 'notify target: %s\n' "$name"
}

cmd_context() { # print the collar's native context reading, unparsed
  local name="${1:-}"
  [ $# -le 1 ] || die "context: unexpected argument '$2'"
  if [ -z "$name" ]; then
    name="$(self_name)" || {
      cmd_help context
      printf '(no target given, and this shell is not a Gangline agent window)\n'
      exit 1
    }
  fi
  resolve "$name"
  declare -F collar_context >/dev/null \
    || die "context: collar '$AGENT_COLLAR' declares no collar_context, so gang cannot read context for '$name'"
  context_now "$AGENT_ID"
}

usage_limits_error() { # $1 collar, $2 read status -> operator-facing cause
  local detail=""
  if [ "$2" -eq 2 ] && declare -F collar_usage_limits_error >/dev/null; then
    detail="$(collar_usage_limits_error "$USAGE_LIMIT_READER_STATUS")" || detail=""
    detail="$(printf '%s' "$detail" | config_sanitize)"
    if [ -n "$detail" ]; then printf '%s' "$detail"; return; fi
  fi
  case "$2" in
    2) printf "collar '%s' could not read its native provider-limit source" "$1" ;;
    3) printf "collar '%s' returned a provider-limit record Gangline cannot interpret" "$1" ;;
    4) printf "collar '%s' declares no non-interactive provider-limit source" "$1" ;;
    5) printf "collar '%s' has only a stale provider-limit reading; refresh it with an API turn before acting" "$1" ;;
    *) printf "collar '%s' failed to read provider limits (status %s)" "$1" "$2" ;;
  esac
}

usage_limit_format_epoch() { # $1 epoch
  curfew_format_epoch "$1"
}

usage_limit_age() { # $1 observed epoch, $2 now
  if [ "$1" -le "$2" ]; then
    printf '%s ago' "$(human_seconds $(( $2 - $1 )))"
  else
    printf 'in %s (clock skew)' "$(human_seconds $(( $1 - $2 )))"
  fi
}

cmd_limits() { # sample the collar's correctness source, never its usage UI
  local name="${1:-}" rc=0 cause state now line label used reset observed age when
  [ $# -le 1 ] || die "limits: unexpected argument '$2'"
  if [ -z "$name" ]; then
    name="$(self_name)" || {
      cmd_help limits
      printf '(no target given, and this shell is not in a Gangline agent window)\n'
      exit 1
    }
  fi
  resolve "$name"
  usage_limits_read "$AGENT_ID" || rc=$?
  if [ "$rc" -ne 0 ]; then
    cause="$(usage_limits_error "$AGENT_COLLAR" "$rc")"
    usage_limit_fail_record "$AGENT_ID" "$cause"
    die "limits: $cause"
  fi
  if usage_lights_for "$AGENT_ID"; then state="$(usage_limit_state)"; else state=sampled; fi
  usage_limit_record "$AGENT_ID" "$state" || die "limits: could not record the native reading on '$name'"
  now="$(date +%s)"
  while IFS= read -r line || [ -n "$line" ]; do
    IFS=$'\t' read -r label used reset observed <<<"$line"
    when="$(usage_limit_format_epoch "$reset")"
    age="$(usage_limit_age "$observed" "$now")"
    printf '%s: %s%% used — resets %s — sampled %s\n' \
      "$label" "$used" "$when" "$age"
  done <<<"$USAGE_LIMIT_ROWS"
}

usage_wake_read() { # $1 window -> reset<TAB>unit<TAB>label; 1 absent, 2 invalid
  local raw reset unit label
  raw="$(tmux show-options -wqv -t "$1" @gl_usage_wake 2>/dev/null)" || raw=""
  [ -n "$raw" ] || return 1
  IFS=$'\t' read -r reset unit label <<<"$raw"
  case "$reset" in ''|*[!0-9]*) return 2 ;; esac
  case "$unit" in gangline-usage-wake-[0-9]*-[0-9]*-[0-9]*) ;; *) return 2 ;; esac
  [ -n "$label" ] || return 2
  printf '%s\t%s\t%s' "$reset" "$unit" "$label"
}

USAGE_UNIT_TROUBLE="" # what usage_unit_stop could not put beyond doubt
USAGE_UNIT_RECOVER="" # the command that shows or ends what it left behind

usage_unit_stop() { # $1 = transient unit basename; 0 only when provably gone
  local u state still="" unreadable=""
  USAGE_UNIT_TROUBLE="" USAGE_UNIT_RECOVER=""
  if ! command -v systemctl >/dev/null 2>&1; then
    USAGE_UNIT_TROUBLE="systemctl is not available, so $1.timer can be neither stopped nor read"
    USAGE_UNIT_RECOVER="remove the transient unit by hand"
    return 1
  fi
  # BOTH HALVES OF A TRANSIENT TIMER. Stopping only `$1.timer` leaves the
  # `$1.service` it has already triggered running, and that callback goes on
  # holding the name this unit is about to be reused under.
  #
  # A failed stop is not a failure by itself: a unit that already fired and was
  # collected is not loaded, and `systemctl stop` reports that as an error
  # while reporting exactly the state the caller asked for.
  for u in "$1.timer" "$1.service"; do
    systemctl --user stop "$u" >/dev/null 2>&1 && continue
    # THE STATE WORD, NOT THE EXIT STATUS. `is-active` exits nonzero for a unit
    # that is gone AND for a query that could not run at all — no user bus, a
    # manager that is not answering, a systemctl that is not the one this
    # session talks to. Reading only the status turns the second into "gone",
    # and answers "cleared" in exactly the case where the timer is most likely
    # still armed.
    #
    # Only `inactive` and `failed` are gone. `unknown` is not: systemd printed
    # it for a failed property query as well as for a unit it had never heard
    # of, and Gangline states no minimum systemd version, so it is reported
    # rather than trusted. An unrecognised word is quoted back, because a state
    # this reader has not been taught is a different problem from no answer.
    state="$(systemctl --user is-active "$u" 2>/dev/null)" || true
    case "$state" in
      active|activating|deactivating|reloading|maintenance|refreshing)
        still="${still:+$still }$u" ;;
      inactive|failed) ;;
      *) unreadable="${unreadable:+$unreadable }$u${state:+ (reported '$state')}" ;;
    esac
  done
  if [ -n "$still" ]; then
    USAGE_UNIT_TROUBLE="$still is still running and will fire once"
    USAGE_UNIT_RECOVER="systemctl --user stop $still"
  fi
  if [ -n "$unreadable" ]; then
    USAGE_UNIT_TROUBLE="${USAGE_UNIT_TROUBLE:+$USAGE_UNIT_TROUBLE, and }the state of $unreadable could not be read, so it may still be armed"
    USAGE_UNIT_RECOVER="${USAGE_UNIT_RECOVER:+$USAGE_UNIT_RECOVER; }systemctl --user list-units --all '$1*'"
  fi
  [ -n "$USAGE_UNIT_TROUBLE" ] || return 0
  return 1
}

usage_wake_cancel() { # $1 window, $2 loud|quiet
  local record rc=0 gone=0 reset unit label trouble="" recover=""
  record="$(usage_wake_read "$1")" || rc=$?
  [ "$rc" -ne 1 ] || return 0
  if [ "$rc" -eq 2 ]; then
    [ "$2" = quiet ] && return 0
    die "wait-limit: the stored wake declaration is unreadable; inspect @gl_usage_wake on $(agent_name_of "$1")"
  fi
  IFS=$'\t' read -r reset unit label <<<"$record"
  usage_unit_stop "$unit" || gone=1
  # THE DECLARATION IS CLEARED EITHER WAY. `--clear` is a request to stop
  # promising a wake, and status, roster and the next wait-limit all read this
  # option: leaving it behind because a stop failed reports a wake nothing is
  # going to deliver.
  tmux set-option -uw -t "$1" @gl_usage_wake 2>/dev/null || true
  tmux set-option -uw -t "$1" @gl_usage_wake_body 2>/dev/null || true
  tmux set-option -uw -t "$1" @gl_usage_wake_failed 2>/dev/null || true
  tmux set-option -uw -t "$1" @gl_usage_wake_failed_unit 2>/dev/null || true
  [ "$gone" -eq 1 ] || return 0
  trouble="$USAGE_UNIT_TROUBLE" recover="$USAGE_UNIT_RECOVER"
  [ "$2" = quiet ] \
    || die "wait-limit: the wake declaration for $label was cleared, but $trouble; recover with: $recover"
  printf 'gang: WARNING: the usage wake declaration for %s was cleared, but %s (%s)\n' \
    "$label" "$trouble" "$recover" >&2
}

usage_wake_unit() { # $1 window, $2 reset -> a safe transient unit basename
  local sum
  sum="$(printf '%s:%s:%s\n' "$SESSION" "$1" "$2" | cksum)" \
    || die "wait-limit: cannot derive a transient unit name"
  printf 'gangline-usage-wake-%s-%s-%s' "$(id -u)" "${sum%% *}" "$2"
}

usage_wake_fire() { # $1 name, $2 exact reset, $3 the unit systemd is running
  local name="$1" reset="$2" fired="$3" id rc=0 record stored_reset unit label body err="" now
  id="$(win_id "$name")" || rc=$?
  [ "$rc" -eq 0 ] || return 0 # a removed/replaced team makes the timer stale
  record="$(usage_wake_read "$id")" || return 0
  IFS=$'\t' read -r stored_reset unit label <<<"$record"
  [ "$stored_reset" = "$reset" ] || return 0
  # THE DECLARATION NAMES THE TIMER THAT ARMED IT, and until now this callback
  # read that name and ignored it. This NARROWS the stale-callback case rather
  # than closing it: the unit name is derived from the session, the window id
  # and the reset, all three of which a recreated team can reissue, so a timer
  # that outlived its tmux server can still match a declaration it never armed.
  # What it does close is every case where any one of those differs. No new
  # state is introduced: both halves already existed and are now compared.
  [ "$unit" = "$fired" ] || return 0
  now="$(date +%s)"
  [ "$reset" -le "$now" ] || return 0 # an internal callback cannot resume early
  body="$(tmux show-options -wqv -t "$id" @gl_usage_wake_body 2>/dev/null)" || body=""
  [ -n "$body" ] || body="Provider usage window '$label' reset. Re-read your assignment and continue only if work remains."
  if err="$(printf '%s\n' "$body" | env -u TMUX_PANE "$ROOT/bin/gang" send \
      --to "$name" --from usage-wake --stdin 2>&1)"; then
    tmux set-option -uw -t "$id" @gl_usage_wake 2>/dev/null || true
    tmux set-option -uw -t "$id" @gl_usage_wake_body 2>/dev/null || true
    tmux set-option -uw -t "$id" @gl_usage_wake_failed 2>/dev/null || true
    tmux set-option -uw -t "$id" @gl_usage_wake_failed_unit 2>/dev/null || true
    printf '%s\n' "$err"
    return 0
  fi
  err="$(printf '%s' "$err" | config_sanitize)"
  tmux set-option -w -t "$id" @gl_usage_wake_failed \
    "reset arrived but the resume turn was NOT accepted: $err" 2>/dev/null || true
  tmux set-option -w -t "$id" @gl_usage_wake_failed_unit "$unit" 2>/dev/null || true
  printf 'gang: wait-limit fire failed for %s: %s\n' "$name" "$err" >&2
  return 1
}

usage_wake_arm() { # $1 window, $2 name, $3 optional body; selected usage globals set
  local id="$1" name="$2" resume="$3" now unit record reset state wake_rc=0 rc=0 fired=0 failure_unit
  now="$(date +%s)"
  [ "$USAGE_LIMIT_RESET" -gt "$now" ] \
    || die "wait-limit: the most constrained native reading ($USAGE_LIMIT_LABEL at ${USAGE_LIMIT_USED}% used) reset already passed; wait for the harness to publish a fresh provider-limit event"
  command -v systemd-run >/dev/null 2>&1 \
    || die "wait-limit: systemd-run is required for a transient user timer; no timer was created"
  usage_wake_cancel "$id" loud
  unit="$(usage_wake_unit "$id" "$USAGE_LIMIT_RESET")"
  # THE UNIT NAME IS DERIVED, NOT REMEMBERED. usage_wake_cancel above stopped
  # whatever the STORED declaration named; this is the name the new timer will
  # take, and a previous arming of this window at this reset derived exactly it.
  # If that one lost its declaration — cleared by hand, or a fired callback that
  # could not deliver — nothing above has seen it, and it can still run a
  # callback under this name. It has to be gone before a declaration naming it
  # exists, because the callback's only test is that name.
  usage_unit_stop "$unit" \
    || die "wait-limit: $USAGE_UNIT_TROUBLE, so no wake was scheduled under that name; recover with: $USAGE_UNIT_RECOVER"
  # THE DECLARATION IS WRITTEN BEFORE THE TIMER IS ARMED, body first.
  # `systemd-run` returns when the start job is queued, not while the calendar
  # time is still in the future: a reset that arrives during arming runs the
  # callback before this function returns. A callback that finds no declaration
  # consumes nothing and says nothing, and the declaration written after it
  # would then promise a wake that has already been thrown away. Writing first
  # makes that callback deliver the wake it was armed for.
  #
  # Body first so a callback can never find a declaration whose resume turn has
  # not been stored yet, and take the default instead of the one the caller
  # asked for.
  if [ -n "$resume" ]; then
    tmux set-option -w -t "$id" @gl_usage_wake_body "$resume" || wake_rc=$?
    [ "$wake_rc" -eq 0 ] \
      || die "wait-limit: the resume turn could not be stored on $name (tmux set-option exited $wake_rc); no wake was scheduled"
  else
    tmux set-option -uw -t "$id" @gl_usage_wake_body 2>/dev/null || true
  fi
  tmux set-option -w -t "$id" @gl_usage_wake \
    "$USAGE_LIMIT_RESET"$'\t'"$unit"$'\t'"$USAGE_LIMIT_LABEL" || wake_rc=$?
  if [ "$wake_rc" -ne 0 ]; then
    tmux set-option -uw -t "$id" @gl_usage_wake_body 2>/dev/null || true
    die "wait-limit: the wake declaration could not be stored on $name (tmux set-option exited $wake_rc); no wake was scheduled"
  fi
  local -a timer=(systemd-run --user --collect --unit="$unit"
    --on-calendar="@$USAGE_LIMIT_RESET" --timer-property=AccuracySec=1s
    --property=Type=oneshot --setenv="GANG_SESSION=$SESSION"
    --setenv="GANG_CONFIG_DIR=$CONFIG_DIR" --setenv="PATH=$PATH")
  [ -z "${TMUX:-}" ] || timer+=(--setenv="TMUX=$TMUX")
  [ -z "${TMUX_TMPDIR:-}" ] || timer+=(--setenv="TMUX_TMPDIR=$TMUX_TMPDIR")
  [ -z "${GANG_COLLARS:-}" ] || timer+=(--setenv="GANG_COLLARS=$GANG_COLLARS")
  [ -z "${GANG_LOCK_DIR:-}" ] || timer+=(--setenv="GANG_LOCK_DIR=$GANG_LOCK_DIR")
  [ -z "${GANG_ARCHIVE_DIR:-}" ] || timer+=(--setenv="GANG_ARCHIVE_DIR=$GANG_ARCHIVE_DIR")
  timer+=("$ROOT/bin/gang" wait-limit "$name" --fire "$USAGE_LIMIT_RESET" --unit "$unit")
  if ! "${timer[@]}" >/dev/null; then
    # NOTHING IS ARMED, SO NOTHING MAY STILL BE PROMISED. The declaration exists
    # at this point by design; arming refused, so it goes.
    tmux set-option -uw -t "$id" @gl_usage_wake 2>/dev/null || true
    tmux set-option -uw -t "$id" @gl_usage_wake_body 2>/dev/null || true
    die "wait-limit: systemd-run did not accept the transient timer; no wake is scheduled"
  fi
  # A FAILED CALLBACK FROM THIS UNIT IS CURRENT, NOT THE STALE FAILURE THIS ARM
  # supersedes. The callback stamps its unit beside the prose, so an accepted
  # later arm can clear an old alarm without racing a reset that arrived inside
  # systemd-run and failed to deliver.
  failure_unit="$(tmux show-options -wqv -t "$id" @gl_usage_wake_failed_unit 2>/dev/null)" || failure_unit=""
  if [ "$failure_unit" != "$unit" ]; then
    tmux set-option -uw -t "$id" @gl_usage_wake_failed 2>/dev/null || true
    tmux set-option -uw -t "$id" @gl_usage_wake_failed_unit 2>/dev/null || true
  fi
  # A RESET THAT ARRIVED DURING ARMING HAS ALREADY BEEN ANSWERED. The callback
  # ran against the declaration written above and consumed it, so calling this
  # a scheduled wake would name a timer that has already fired.
  usage_wake_read "$id" >/dev/null 2>&1 || rc=$?
  [ "$rc" -ne 1 ] || fired=1
  if usage_lights_for "$id"; then state="$(usage_limit_state)"; else state=sampled; fi
  usage_limit_record "$id" "$state" || true
  reset="$(usage_limit_format_epoch "$USAGE_LIMIT_RESET")"
  if [ "$fired" -eq 1 ]; then
    printf "%s reset at %s while the timer was being armed; the resume turn was delivered to %s rather than scheduled\n" \
      "$USAGE_LIMIT_LABEL" "$reset" "$name"
    return
  fi
  printf "provider-reset wake scheduled for %s at %s (%s, %s%% used)\n" \
    "$name" "$reset" "$USAGE_LIMIT_LABEL" "$USAGE_LIMIT_USED"
}

cmd_wait_limit() { # schedule, clear, or internally fire one provider-reset wake
  local name="" resume="" clear=0 fire="" fired_unit="" rc=0 cause record legacy_id
  case "${1:-}" in ''|-*) ;; *) name="$1"; shift ;; esac
  while [ $# -gt 0 ]; do case "$1" in
    --resume) [ $# -ge 2 ] || die "wait-limit: --resume needs a value"
              [ -z "$resume" ] || die "wait-limit: --resume may be passed once"
              resume="$2"; shift 2 ;;
    --clear) clear=1; shift ;;
    --fire) [ $# -ge 2 ] || die "wait-limit: --fire needs a reset epoch"
            fire="$2"; shift 2 ;;
    --unit) [ $# -ge 2 ] || die "wait-limit: --unit needs a transient unit name"
            fired_unit="$2"; shift 2 ;;
    *) die "wait-limit: unknown argument '$1'" ;;
  esac; done
  [ -n "$name" ] || name="$(self_name)" || {
    cmd_help wait-limit
    printf '(no target given, and this shell is not in a Gangline agent window)\n'
    exit 1
  }
  if [ -n "$fire" ]; then
    [ "$clear" -eq 0 ] && [ -z "$resume" ] \
      || die "wait-limit: --fire is internal and takes only a target, reset epoch and unit"
    case "$fire" in ''|*[!0-9]*) die "wait-limit: invalid fire epoch '$fire'" ;; esac
    if [ -z "$fired_unit" ]; then
      # A TIMER ARMED BEFORE 2.0 CALLS BACK WITHOUT --unit, and refusing it in
      # silence is the same overdue wake the operator was told was scheduled:
      # the callback's stderr goes to the journal, and the declaration it could
      # not consume still reads as pending. Record the refusal where status and
      # roster already look before refusing.
      legacy_id="$(win_id "$name")" || legacy_id=""
      [ -z "$legacy_id" ] || tmux set-option -w -t "$legacy_id" @gl_usage_wake_failed \
        "reset arrived, but the timer predates 2.0 and named no unit, so the wake was refused; reschedule it with: gang wait-limit $name" 2>/dev/null || true
      [ -z "$legacy_id" ] || tmux set-option -uw -t "$legacy_id" @gl_usage_wake_failed_unit 2>/dev/null || true
      die "wait-limit: --fire requires the --unit that armed it, so a stale timer cannot consume another declaration"
    fi
    usage_wake_fire "$name" "$fire" "$fired_unit"
    return
  fi
  [ -z "$fired_unit" ] || die "wait-limit: --unit belongs to the internal --fire callback"
  resolve "$name"
  if [ "$clear" -eq 1 ]; then
    [ -z "$resume" ] || die "wait-limit: --clear and --resume cannot be combined"
    record="$(usage_wake_read "$AGENT_ID")" || rc=$?
    if [ "$rc" -eq 1 ]; then printf 'no provider-reset wake scheduled for %s\n' "$name"; return; fi
    usage_wake_cancel "$AGENT_ID" loud
    printf 'provider-reset wake cleared for %s\n' "$name"
    return
  fi
  usage_limits_read "$AGENT_ID" || rc=$?
  if [ "$rc" -ne 0 ]; then
    cause="$(usage_limits_error "$AGENT_COLLAR" "$rc")"
    usage_limit_fail_record "$AGENT_ID" "$cause"
    die "wait-limit: $cause"
  fi
  usage_wake_arm "$AGENT_ID" "$name" "$resume"
}

glyph_write() { # $1 = window id, $2 = state phrase
  local id="$1" state="$2" glyph="" bare current target
  case "$state" in
    -busy-*) glyph=- ;;
    '~wait~'*|'~idle~'*) glyph='~' ;;
    '!occupied!'*) glyph='!' ;;
    '!bricked!'*) glyph='!' ;;
    '!session-lost!'*) glyph='!' ;;
    '?unknown?'*) glyph='?' ;;
    *) return 0 ;;
  esac
  bare="$(tmux show-options -wqv -t "$id" @gl_agent 2>/dev/null)" || bare=""
  [ -n "$bare" ] || return 0
  current="$(tmux display-message -p -t "$id" '#W' 2>/dev/null)" || return 0
  target="$glyph$bare$glyph"
  [ "$current" = "$target" ] && return 0
  tmux rename-window -t "$id" -- "$target" 2>/dev/null || true
}

STATE_NOW_RESULT=""

# A BRACKET THAT REACHED ITS BOUND IS A BOUNDARY NOBODY RAISED. Every other
# drain hangs off an event the harness announces. Measured on claude-code
# 2.1.241: a turn a person ends by declining a permission dialog announces
# NOTHING — not Stop, not StopFailure, not PermissionDenied, and no late
# Notification — so an agent left in that state holds its mail until something
# else happens to it, which for an agent nobody writes to again is never. The
# expiry is gang's OWN fact and it is already what licenses an idle verdict, so
# the first time gang forms it the window is offered the delivery opportunity
# its owner never raised.
#
# THE BRACKET IS NOT REWRITTEN HERE. Stamping it closed would turn a
# could-not-determine verdict into a confident idle one, and a tool call longer
# than GANG_TURN_LIMIT is exactly the turn that would then be typed into. What
# expiry buys is the attempt; spool_drain's own busy witness, the collar's
# mid-turn declaration and the composer guards decide what happens next,
# exactly as they decide it for an ordinary send against the same window.
turn_abandoned_event() { # $1 = window id, $2 = the fact turn_witness recorded
  local collar
  [ "${2:-0}" -eq 1 ] || return 0
  collar="$(collar_read "$1" 2>/dev/null)" || return 0
  [ -n "$collar" ] || return 0
  spool_drain_dispatch "$1" "$collar"
}

state_now() { # $1 = window id, collar loaded -> the state, in words
  local state busy_rc=0 bricked_rc=0 waiting_rc=1 abandoned=0 mismatch=""
  STATE_NOW_RESULT=""
  mismatch="$(identity_mismatch_read "$1")" || mismatch=""
  if [ -n "$mismatch" ]; then
    activity_hold_clear "$1"
    state="!session-lost! ($mismatch)"
    glyph_write "$1" "$state"
    STATE_NOW_RESULT="$state"
    printf '%s\n' "$state"
    return 0
  fi
  if occupied "$1"; then
    activity_hold_clear "$1"
    state="!occupied! (authority unknown)"
    glyph_write "$1" "$state"
    STATE_NOW_RESULT="$state"
    printf '%s\n' "$state"
    return 0
  fi
  bricked "$1" || bricked_rc=$?
  case "$bricked_rc" in
    0)
      activity_hold_clear "$1"
      state="!bricked! ($BRICKED_WHAT)"
      glyph_write "$1" "$state"
      STATE_NOW_RESULT="$state"
      printf '%s\n' "$state"
      return 0 ;;
    1) ;;
    2)
      state="?unknown? ($BRICKED_WHAT)"
      glyph_write "$1" "$state"
      STATE_NOW_RESULT="$state"
      printf '%s\n' "$state"
      return 0 ;;
    *) die "internal: bricked returned unknown verdict $bricked_rc" ;;
  esac
  busy "$1" "${2:-}" || busy_rc=$?
  # READ BEFORE ANYTHING ELSE CAN OVERWRITE IT. turn_witness clears the fact on
  # every call, and the verdict this expiry needs is not one verdict: a stale
  # bracket over a free composer decays to idle, and that is precisely the
  # window a waiting message can be delivered to.
  abandoned="$TURN_ABANDONED"
  case "$busy_rc" in
    0) state="-busy-" ;;
    1) waiting_rc=0
       waiting_read "$1" || waiting_rc=$?
       case "$waiting_rc" in
         0) state="~wait~ ($WAITING_WHAT)" ;;
         1) state="~idle~" ;;
         2) state="?unknown? ($WAITING_WHAT)" ;;
         *) die "internal: waiting_read returned unknown verdict $waiting_rc" ;;
       esac ;;
    2) state="?unknown? ($BUSY_EXPIRED_WHAT)" ;;
    *) die "internal: busy returned unknown verdict $busy_rc" ;;
  esac
  glyph_write "$1" "$state"
  turn_abandoned_event "$1" "$abandoned"
  STATE_NOW_RESULT="$state"
  printf '%s\n' "$state"
}

explain_rule_report() { # $1 variable, $2 result, $3 matching fragment
  local variable="$1" result="$2" fragment="$3" regex="${!1:-}"
  printf '%s: %s\n' "$variable" "$result"
  [ -z "$regex" ] || printf '  rule: %s\n' "$regex"
  if [ "$result" = matched ]; then
    [ -n "$fragment" ] || fragment="<empty line>"
    printf '  fragment: %s\n' "$fragment"
  fi
}

explain_bricked_report() {
  printf 'collar_bricked: %s\n' "$EXPLAIN_BRICKED_RESULT"
  [ -z "$EXPLAIN_BRICKED_CAUSE" ] \
    || printf '  cause: %s\n' "$EXPLAIN_BRICKED_CAUSE"
}

cmd_explain() {
  local name="${1:-}" pane
  [ $# -le 1 ] || die "explain: unexpected argument '$2'"
  case "$name" in ''|-*) cmd_help explain; exit 1 ;; esac
  resolve "$name"
  pane="$(wait_active_pane "$AGENT_ID")" \
    || die "explain: cannot identify the active pane in '$name'"
  EXPLAINING=1
  if [ -n "${GANG_BUSY_REGEX:-}" ]; then
    EXPLAIN_BUSY_RESULT="not evaluated"
  else
    EXPLAIN_BUSY_RESULT="not declared"
  fi
  EXPLAIN_BUSY_FRAGMENT=""
  if [ -n "${GANG_OCCUPIED_REGEX:-}" ]; then
    EXPLAIN_OCCUPIED_RESULT="not evaluated"
  else
    EXPLAIN_OCCUPIED_RESULT="not declared"
  fi
  EXPLAIN_OCCUPIED_FRAGMENT=""
  if declare -F collar_bricked >/dev/null; then
    EXPLAIN_BRICKED_RESULT="not evaluated"
  else
    EXPLAIN_BRICKED_RESULT="not declared"
  fi
  EXPLAIN_BRICKED_CAUSE=""
  # Pass the pinned pane rather than the window id. Current Gangline state
  # normally follows a window's active pane; a diagnostic must not explain a
  # different pane merely because selection changed between its two regexes.
  state_now "$pane" >/dev/null
  EXPLAINING=0
  printf 'agent: %s\npane: %s\ncollar: %s\nstate: %s\n' \
    "$name" "$pane" "$AGENT_COLLAR" "$STATE_NOW_RESULT"
  explain_rule_report GANG_OCCUPIED_REGEX \
    "$EXPLAIN_OCCUPIED_RESULT" "$EXPLAIN_OCCUPIED_FRAGMENT"
  explain_bricked_report
  explain_rule_report GANG_BUSY_REGEX \
    "$EXPLAIN_BUSY_RESULT" "$EXPLAIN_BUSY_FRAGMENT"
}

# A WAIT IS A TEMPORARY TMUX BARRIER, NOT TEAM STATE. Each caller owns one
# unique wait-for channel and one sparse pane-exited hook. Stop signals every
# channel registered for the firing pane; pane exit signals its own hook
# directly. Sparse caller-owned keys avoid tmux's lowest-free array-slot reuse:
# cleanup never removes a key unless its current command still names this
# caller's channel.
WAIT_CHANNEL=""
WAIT_HOOK_KEY=""

wait_hook_owned() { # $1 hook key, $2 channel
  local line
  line="$(tmux show-hooks -g "$1" 2>/dev/null)" || return 1
  case "$line" in
    *"wait-for -S $2 "*) return 0 ;;
    *) return 1 ;;
  esac
}

wait_hook_cleanup() {
  local channel="$WAIT_CHANNEL" key="$WAIT_HOOK_KEY"
  if [ -n "$key" ] && wait_hook_owned "$key" "$channel"; then
    tmux set-hook -ug "$key" 2>/dev/null || true
  fi
  WAIT_CHANNEL=""
  WAIT_HOOK_KEY=""
}

wait_hook_arm() { # $1 window id, $2 pane id
  local id="$1" pane="$2" nonce index key line command attempts=0
  while [ "$attempts" -lt 8 ]; do
    nonce="$(mint_nonce)"
    # tmux accepts sparse numeric hook indexes. Seven hex digits stay within a
    # portable positive integer range; the full nonce remains in the channel.
    index=$(( 16#${nonce:0:7} + 1 ))
    key="pane-exited[$index]"
    line="$(tmux show-hooks -g "$key" 2>/dev/null)" || line=""
    # show-hooks represents an unset array element as its key plus a blank
    # command and still exits zero. Only a nonblank command owns the slot.
    if [ -z "${line#* }" ]; then
      WAIT_CHANNEL="gang-wait-${id#@}-${pane#%}-$nonce"
      WAIT_HOOK_KEY="$key"
      break
    fi
    attempts=$((attempts + 1))
  done
  [ -n "$WAIT_HOOK_KEY" ] \
    || die "wait: could not reserve a temporary pane-exit registration for $pane"
  # tmux parses the quoted if-shell arm as a command list when the hook fires.
  # Signal first, then remove this exact sparse element. The readback proves
  # tmux stored this caller's channel before state is examined.
  command="if-shell -F '#{==:#{hook_pane},$pane}' 'wait-for -S $WAIT_CHANNEL ; set-hook -ug $WAIT_HOOK_KEY'"
  tmux set-hook -g "$WAIT_HOOK_KEY" "$command" || {
    wait_hook_cleanup
    die "wait: could not arm the pane-exit boundary for $pane"
  }
  wait_hook_owned "$WAIT_HOOK_KEY" "$WAIT_CHANNEL" || {
    wait_hook_cleanup
    die "wait: tmux did not retain the pane-exit boundary for $pane — refusing an unreachable wait"
  }
}

wait_signal_registered() { # $1 window id, optional $2 pane id; Stop/drop deletion path
  local id="$1" pane="${2:-}" line key channel
  while IFS= read -r line; do
    [[ "$line" =~ wait-for[[:space:]]-S[[:space:]](gang-wait-[0-9]+-[0-9]+-[0-9a-f]{8}) ]] \
      || continue
    channel="${BASH_REMATCH[1]}"
    case "$channel" in
      "gang-wait-${id#@}-"*) ;;
      *) continue ;;
    esac
    if [ -n "$pane" ]; then
      case "$channel" in
        "gang-wait-${id#@}-${pane#%}-"*) ;;
        *) continue ;;
      esac
    fi
    key="${line%% *}"
    wait_hook_owned "$key" "$channel" || continue
    tmux wait-for -S "$channel" 2>/dev/null || true
    if wait_hook_owned "$key" "$channel"; then
      tmux set-hook -ug "$key" 2>/dev/null || true
    fi
  done < <(tmux show-hooks -g pane-exited 2>/dev/null || true)
}

wait_active_pane() { # $1 window id -> its one active pane
  local pane
  pane="$(tmux list-panes -t "$1" -f '#{pane_active}' -F '#{pane_id}' 2>/dev/null)" \
    || return 1
  case "$pane" in
    %*) [[ "${pane#%}" =~ ^[0-9]+$ ]] || return 1; printf '%s' "$pane" ;;
    *) return 1 ;;
  esac
}

wait_target_validate() { # $1 name, $2 pinned window, $3 pinned pane
  local name="$1" pinned_id="$2" pinned_pane="$3" id pane rc=0 collar
  id="$(win_id "$name")" || rc=$?
  case "$rc" in
    0) ;;
    1) die "wait: '$name' vanished while the barrier was armed" ;;
    2) die "wait: '$name' became ambiguous while the barrier was armed" ;;
    3) die "wait: '$name' no longer names its registered agent while the barrier was armed" ;;
    *) die "wait: could not resolve '$name' after the barrier fired" ;;
  esac
  [ "$id" = "$pinned_id" ] \
    || die "wait: '$name' was replaced ($pinned_id became $id) while the barrier was armed"
  pane="$(wait_active_pane "$id")" \
    || die "wait: cannot identify the active pane in '$name' after the barrier fired"
  [ "$pane" = "$pinned_pane" ] \
    || die "wait: '$name' changed active pane ($pinned_pane became $pane) while the barrier was armed"
  collar="$(collar_read "$id" 2>/dev/null)" \
    || die "wait: '$name' lost its collar while the barrier was armed"
  [ -n "$collar" ] || die "wait: '$name' lost its collar while the barrier was armed"
  load_collar "$collar"
  AGENT_ID="$id"
  AGENT_COLLAR="$collar"
}

wait_boundary() { # $1 channel, $2 timeout seconds, $3 target name
  local rc=0
  # Python is already a Gangline dependency. Its one-shot alarm gives this
  # exact tmux client a portable deadline without GNU timeout or a resident
  # watcher. The client gets a new process group so every deadline or forwarded
  # foreground signal can kill and reap both the fresh Bash and tmux, while the
  # Bash preserves the BASH_ENV seam used to drive native boundaries in tests.
  python3 - "$2" "$1" <<'PY' || rc=$?
import os
import signal
import subprocess
import sys

seconds = int(sys.argv[1], 10)
channel = sys.argv[2]
child = None
received = [None]


def kill_child():
    if child is None:
        return
    try:
        os.killpg(child.pid, signal.SIGKILL)
    except OSError:
        pass


def stop(signum, _frame):
    if received[0] is None:
        received[0] = signum
    kill_child()


for caught in (signal.SIGALRM, signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
    signal.signal(caught, stop)

# Start the bound before process creation. If it fires in that small window,
# stop records it and the post-spawn check kills the new group immediately.
signal.alarm(seconds)
status = 1
try:
    child = subprocess.Popen(
        ["bash", "-c", 'tmux wait-for "$1"', "_", channel],
        start_new_session=True,
    )
    if received[0] is not None:
        kill_child()
    status = child.wait()
finally:
    signal.alarm(0)
    if child is not None and child.poll() is None:
        kill_child()
        child.wait()

# Once wait() has captured a successful native release, a signal handled just
# after that release cannot truthfully turn it into a missing boundary.
if status == 0:
    sys.exit(0)
if received[0] == signal.SIGALRM:
    sys.exit(124)
if received[0] is not None:
    signal.signal(received[0], signal.SIG_DFL)
    os.kill(os.getpid(), received[0])
if status < 0:
    sys.exit(128 - status)
sys.exit(status)
PY
  case "$rc" in
    0) return 0 ;;
    124) die "wait: no native boundary from '$3' within $2 seconds — its turn may still be running, the target may have vanished outside gang drop/down, or its Stop hook may not be firing" ;;
    *) die "wait: tmux stopped waiting for '$3' before its boundary fired (status $rc)" ;;
  esac
}

cmd_wait() {
  local name="${1:-}" until="" bound="$GANG_TURN_LIMIT" bound_given=0 pane state self="" turn_rc=0
  case "$name" in ''|-*) cmd_help wait; exit 1 ;; esac
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --until)
        [ $# -ge 2 ] || die "wait: --until needs idle or done"
        [ -z "$until" ] || die "wait: --until was given more than once"
        until="$2"; shift 2 ;;
      --timeout)
        [ $# -ge 2 ] || die "wait: --timeout needs a positive whole number of seconds"
        [ "$bound_given" -eq 0 ] || die "wait: --timeout was given more than once"
        bound_given=1
        bound="$2"; shift 2 ;;
      *) die "wait: unexpected argument '$1'" ;;
    esac
  done
  case "$until" in
    idle|done) ;;
    '') die "wait: --until idle|done is required" ;;
    *) die "wait: --until must be idle or done, got '$until'" ;;
  esac
  case "$bound" in
    ''|*[!0-9]*) die "wait: --timeout must be a positive whole number of seconds, got '$bound'" ;;
  esac
  case "$bound" in
    *[1-9]*) ;;
    *) die "wait: --timeout must be a positive whole number of seconds, got '$bound'" ;;
  esac
  require_python3
  resolve "$name"
  pane="$(wait_active_pane "$AGENT_ID")" \
    || die "wait: cannot identify the active pane in '$name'"
  self="$(self_window)" || self=""
  [ -z "$self" ] || [ "$self" != "$AGENT_ID" ] \
    || refuse "wait: '$name' is this agent's own window — its native Stop cannot fire while this turn is blocked inside gang wait"
  state="$(state_now "$AGENT_ID")"
  case "$state" in
    '~idle~'*) return 0 ;;
    '!bricked!'*) die "wait: '$name' is $state — a fatal turn cannot reach the requested boundary" ;;
    '?unknown?'*) die "wait: '$name' is $state — refusing to hang on evidence Gangline cannot settle" ;;
  esac
  [ "${GANG_STOP_HOOK:-}" = 1 ] \
    || die "wait: collar '$AGENT_COLLAR' declares no GANG_STOP_HOOK for '$name' — no native boundary can release this barrier"
  turn_state_read "$AGENT_ID" || turn_rc=$?
  case "$turn_rc" in
    0) ;;
    1) die "wait: '$name' has no native turn evidence — a collar declaration alone cannot prove its Stop hook is installed; refusing an unbounded barrier" ;;
    *) die "wait: '$name' has unreadable native turn evidence — refusing an unbounded barrier" ;;
  esac
  trap 'on_exit' EXIT
  while :; do
    wait_hook_arm "$AGENT_ID" "$pane"
    wait_target_validate "$name" "$AGENT_ID" "$pane"
    state="$(state_now "$AGENT_ID")"
    case "$state" in
      '~idle~'*) wait_hook_cleanup; return 0 ;;
      '!bricked!'*) die "wait: '$name' is $state — a fatal turn cannot reach the requested boundary" ;;
      '?unknown?'*) die "wait: '$name' is $state — refusing to hang on evidence Gangline cannot settle" ;;
    esac
    wait_boundary "$WAIT_CHANNEL" "$bound" "$name"
    wait_hook_cleanup
    wait_target_validate "$name" "$AGENT_ID" "$pane"
    state="$(state_now "$AGENT_ID")"
    case "$state" in
      '!bricked!'*) die "wait: '$name' is $state after its boundary — the turn ended fatally" ;;
      '?unknown?'*) die "wait: '$name' is $state after its boundary — refusing to consume unknown as completion" ;;
    esac
    if [ "$until" = "done" ]; then return 0; fi
    case "$state" in
      '~idle~'*) return 0 ;;
    esac
  done
}

action_status_report() { # $1 window, collar loaded; both ages, in full, with reasons
  local write
  last_action_read "$1"
  case "$ACTION_KIND" in
    at) printf '%s\n' "$(colour "$C_DIM" "last tool call: $(human_seconds "$ACTION_AGE") ago")" ;;
    before) printf '%s\n' "$(colour "$C_DIM" "last tool call: more than $(human_seconds "$ACTION_AGE") ago (older than the records gang read back)")" ;;
    none) printf '%s\n' "$(colour "$C_WORK" "last tool call: none — this agent has not run a tool in the source gang can read")" ;;
    *) printf '%s\n' "$(colour "$C_BAD" "last tool call: UNKNOWN — $ACTION_WHAT")" ;;
  esac
  if write="$(pane_write_age "$1")"; then
    printf '%s\n' "$(colour "$C_DIM" "last pane write: $(human_seconds "$write") ago")"
  else
    printf '%s\n' "$(colour "$C_BAD" "last pane write: UNKNOWN — tmux gave no usable activity stamp for this pane")"
  fi
  # NEITHER AGE IS A HEALTH VERDICT, and saying so here is cheaper than an
  # operator inferring one. A tool a long time ago is a wedge or a long build;
  # only the reader knows which.
  printf '%s\n' "$(colour "$C_DIM" "  (evidence of action, not of health: a long-running tool and a stalled agent both go quiet)")"
}

paint_state() { # $1 = a state phrase, padding and all
  case "$1" in
    '!occupied!'*) colour "$C_BAD" "$1" ;;
    '!bricked!'*) colour "$C_BAD" "$1" ;;
    '!session-lost!'*) colour "$C_BAD" "$1" ;;
    '?unknown?'*) colour "$C_BAD" "$1" ;;
    '-busy-'*) colour "$C_WORK" "$1" ;;
    *)      colour "$C_OK"   "$1" ;;
  esac
}

usage_limit_record_read() { # $1 window -> state used reset observed label; 1 absent, 2 invalid
  local raw state used reset observed label
  raw="$(tmux show-options -wqv -t "$1" @gl_usage_limit 2>/dev/null)" || raw=""
  [ -n "$raw" ] || return 1
  read -r state used reset observed label <<<"$raw"
  case "$state" in sampled|below|yellow|red) ;; *) return 2 ;; esac
  case "$used" in ''|*[!0-9]*) return 2 ;; esac
  case "$reset" in ''|*[!0-9]*) return 2 ;; esac
  case "$observed" in ''|*[!0-9]*) return 2 ;; esac
  [ "$used" -le 100 ] && [ "$reset" -gt 0 ] && [ "$observed" -gt 0 ] && [ -n "$label" ] \
    || return 2
  printf '%s %s %s %s %s' "$state" "$used" "$reset" "$observed" "$label"
}

usage_limit_status_report() { # $1 window
  local record rc=0 state used reset observed label now age when tone="$C_DIM" failed
  record="$(usage_limit_record_read "$1")" || rc=$?
  if [ "$rc" -eq 2 ]; then
    printf '%s\n' "$(colour "$C_BAD" "provider usage reading UNREADABLE: inspect @gl_usage_limit")"
  elif [ "$rc" -eq 0 ]; then
    read -r state used reset observed label <<<"$record"
    now="$(date +%s)" age="$(usage_limit_age "$observed" "$now")"
    when="$(usage_limit_format_epoch "$reset")"
    case "$state" in yellow) tone="$C_WORK" ;; red) tone="$C_BAD" ;; esac
    if [ "$reset" -le "$now" ]; then
      printf '%s\n' "$(colour "$C_BAD" "provider usage STALE: $label was ${used}% used; its reset passed at $when; sampled $age")"
    elif usage_limit_stale "$observed" "$now"; then
      printf '%s\n' "$(colour "$C_BAD" "provider usage STALE: $label was ${used}% used; resets $when; sampled $age")"
    else
      printf '%s\n' "$(colour "$tone" "provider usage: $label is ${used}% used; resets $when; sampled $age${state:+; state=$state}")"
    fi
  fi
  failed="$(tmux show-options -wqv -t "$1" @gl_usage_failed 2>/dev/null)" || failed=""
  [ -z "$failed" ] \
    || printf '%s\n' "$(colour "$C_BAD" "provider usage unavailable: $failed")"
}

usage_wake_status_report() { # $1 window
  local record rc=0 reset unit label now when left failed unit_state
  record="$(usage_wake_read "$1")" || rc=$?
  if [ "$rc" -eq 2 ]; then
    printf '%s\n' "$(colour "$C_BAD" "provider-reset wake UNREADABLE: inspect @gl_usage_wake")"
  elif [ "$rc" -eq 0 ]; then
    IFS=$'\t' read -r reset unit label <<<"$record"
    now="$(date +%s)" when="$(usage_limit_format_epoch "$reset")"
    if [ "$reset" -gt "$now" ]; then left="$(human_seconds $(( reset - now ))) remaining"; else left="OVERDUE"; fi
    printf '%s\n' "$(colour "$C_WORK" "provider-reset wake: $label at $when — $left; transient unit $unit.timer")"
    # A DECLARATION IS NOT A TIMER. The declaration lives on the tmux window and
    # the timer lives in the user manager, and the manager can be restarted
    # under a tmux server that survives it. Reporting the declaration alone then
    # promises a wake that nothing will deliver. Only a still-future reset is
    # checked: a passed one is expected to have fired and been collected.
    #
    # THE STATE WORD, NOT THE EXIT STATUS, for the reason usage_unit_stop gives:
    # `is-active` exits nonzero both for a unit that is gone and for a query
    # that could not run, and reading the status alone reports "gone" in exactly
    # the case where the timer is most likely still armed.
    if [ "$reset" -gt "$now" ]; then
      if ! command -v systemctl >/dev/null 2>&1; then
        printf '%s\n' "$(colour "$C_BAD" "provider-reset wake UNVERIFIED: systemctl is not available, so $unit.timer cannot be read")"
      else
        unit_state="$(systemctl --user is-active "$unit.timer" 2>/dev/null)" || true
        case "$unit_state" in
          active|activating|reloading|refreshing) ;;
          inactive|failed)
            printf '%s\n' "$(colour "$C_BAD" "provider-reset wake ARMED NOWHERE: $unit.timer is $unit_state, so the declared wake will not fire; reschedule with gang wait-limit $(agent_name_of "$1")")" ;;
          *)
            printf '%s\n' "$(colour "$C_BAD" "provider-reset wake UNVERIFIED: $unit.timer reported '${unit_state:-no state}', so whether it is still armed could not be read")" ;;
        esac
      fi
    fi
  fi
  failed="$(tmux show-options -wqv -t "$1" @gl_usage_wake_failed 2>/dev/null)" || failed=""
  [ -z "$failed" ] \
    || printf '%s\n' "$(colour "$C_BAD" "provider-reset wake failed: $failed")"
}

cmd_status() {
  local state self_failed self_pending staged staged_box staged_box_rc parked spooled age held held_dir spool_failed stall_failed auto_failed hook_failed mismatch probe_failed skew="" current
  local timed_line
  local name="${1:-}"
  [ $# -le 1 ] || die "status: unexpected argument '$2'"
  if [ -z "$name" ]; then
    name="$(self_name)" || {
      cmd_help status
      printf '(no target given, and this shell is not a Gangline agent window)\n'
      exit 1
    }
  fi
  resolve "$name"
  state="$(state_now "$AGENT_ID")"
  printf '%s\n' "$(paint_state "$state")"
  tick_health_report
  action_status_report "$AGENT_ID"
  self_failed="$(self_compact_failed_read "$AGENT_ID")"
  [ -z "$self_failed" ] \
    || printf '%s\n' "$(colour "$C_BAD" "self-compaction NOT submitted after Stop: $self_failed")"
  self_pending="$(tmux show-options -wqv -t "$AGENT_ID" @gl_self_compact_requested)"
  [ -n "$self_pending" ] \
    || self_pending="$(tmux show-options -wqv -t "$AGENT_ID" @gl_self_compact_dispatching)"
  [ -z "$self_pending" ] \
    || printf '%s\n' "$(colour "$C_WORK" "self-compaction requested; waiting for the turn boundary")"
  staged="$(staged_current "$AGENT_ID")"
  # "on record", not "in the input box": the body may sit in the box, in the
  # harness's own queue, or in a state gang could not read — the note carries
  # what is actually known, and its later clearing means the obstruction is
  # gone, never that the recorded body was retroactively delivered.
  if [ -n "$staged" ]; then
    printf '%s\n' "$(colour "$C_BAD" "undelivered input on record: $staged")"
    # The record says what gang did; this says what is in that box now, so the
    # operator is not left to read a raw capture and guess.
    staged_box_rc=0
    staged_box="$(landing_zone "$AGENT_ID")" || staged_box_rc=$?
    printf '%s\n' "$(colour "$C_BAD" "box: $(box_class "$AGENT_ID" "$staged_box" "$name" "$staged_box_rc")")"
  fi
  parked="$(parked_current "$AGENT_ID")"
  [ -z "$parked" ] \
    || printf '%s\n' "$(colour "$C_WORK" "parked native input: the harness queue holds a body Gangline recorded; recover it with gang flush $name")"
  spooled="$(spool_count "$AGENT_ID")"
  if [ "$spooled" -ne 0 ]; then
    if age="$(spool_oldest_age "$AGENT_ID")"; then
      printf '%s\n' "$(colour "$C_WORK" "spooled: $spooled waiting for the next verified delivery opportunity; the oldest has waited $(human_seconds "$age")")"
    else
      printf '%s\n' "$(colour "$C_WORK" "spooled: $spooled waiting for the next verified delivery opportunity")"
    fi
  fi
  timed_report "$AGENT_ID" "$name" | while IFS= read -r timed_line; do
    printf '%s\n' "$(colour "$C_WORK" "$timed_line")"
  done
  held="$(spool_held "$AGENT_ID")"
  if [ "$held" -ne 0 ]; then
    held_dir="$(spool_dir_of "$AGENT_ID")"
    # The whole promise of holding rather than re-sending is that a person can
    # go and read the body, so the place has to be in the report or the report
    # is worse than silence: it says the message was kept and does not say where.
    [ -n "$held_dir" ] \
      || die "$held message(s) are held for '$name' and gang cannot name where: this window's spool identity is gone, so the directory holding them can no longer be resolved. Look for them under $(spool_root_of)"
    spool_held_report "$AGENT_ID" | while IFS= read -r held_line; do
      printf '%s\n' "$(colour "$C_BAD" "$held_line")"
    done
    printf '%s\n' "$(colour "$C_BAD" "spool: $held message(s) gang has stopped acting on; it will not send them again; read them under $held_dir")"
  fi
  spool_failed="$(tmux show-options -wqv -t "$AGENT_ID" @gl_spool_failed)"
  [ -z "$spool_failed" ] \
    || printf '%s\n' "$(colour "$C_BAD" "spool drain NOT verified: $spool_failed")"
  stall_failed="$(tmux show-options -wqv -t "$AGENT_ID" @gl_stall_failed)"
  [ -z "$stall_failed" ] \
    || printf '%s\n' "$(colour "$C_BAD" "stall note NOT accepted: $stall_failed")"
  auto_failed="$(tmux show-options -wqv -t "$AGENT_ID" @gl_auto_resume_failed)"
  [ -z "$auto_failed" ] \
    || printf '%s\n' "$(colour "$C_BAD" "automatic resume refused: $auto_failed")"
  hook_failed="$(tmux show-options -wqv -t "$AGENT_ID" @gl_hook_failed)"
  [ -z "$hook_failed" ] \
    || printf '%s\n' "$(colour "$C_BAD" "native event NOT interpreted: $hook_failed")"
  usage_limit_status_report "$AGENT_ID"
  usage_wake_status_report "$AGENT_ID"
  mismatch="$(identity_mismatch_read "$AGENT_ID")" || mismatch=""
  [ -z "$mismatch" ] \
    || printf '%s\n' "$(colour "$C_BAD" "harness session identity MISMATCH: $mismatch")"
  probe_failed="$(tmux show-options -wqv -t "$AGENT_ID" @gl_session_probe_failed 2>/dev/null)" || probe_failed=""
  [ -z "$probe_failed" ] \
    || printf '%s\n' "$(colour "$C_BAD" "harness session identity UNVERIFIED: $probe_failed")"
  current="$(binary_id)"
  skew="$(binary_skew_note "$AGENT_ID" "$current")" || skew=""
  [ -z "$skew" ] || printf '%s\n' "$(colour "$C_BAD" "$skew")"
}

# READING YOUR OWN QUEUE IS ITS DELIVERY. A body the addressee has already read
# is delivered again at the next turn boundary — the same message twice, once by
# hand and once by the spool — so a read by the agent whose queue it is retires
# what it printed. A read by anyone else is an inspection and touches nothing.
cmd_mail() { # read a queue; its own agent's read archives what it consumes
  local name="${1:-}" id rc=0 dir e n=0 held=0
  local self="" mine=0 claim label heading=waiting mail_archive="" archived_name=""
  [ $# -le 1 ] || die "mail: unexpected argument '$2'"
  if [ -z "$name" ]; then
    name="$(self_name)" || {
      cmd_help mail
      printf '(no target given, and this shell is not a Gangline agent window)\n'
      exit 1
    }
  fi
  id="$(win_id "$name")" || { rc=$?; win_id_missing "$rc" "no agent '$name' (see: gang roster)"; }
  # WHOSE QUEUE IS THIS? The window answers it, not the name: the calling pane
  # either IS the target window or it is somebody else looking. No name is
  # compared, so nothing here can be talked into consuming another agent's mail.
  self="$(self_window)" || self=""
  [ -n "$self" ] && [ "$self" = "$id" ] && mine=1
  [ "$mine" -eq 0 ] || heading="read"
  dir="$(spool_dir_of "$id")"
  if [ -z "$dir" ] || [ ! -d "$dir" ]; then
    printf '%s\n' "$(colour "$C_DIM" "no mail waiting for $name")"
    return 0
  fi
  # The glob is taken once, so an entry that lands mid-read is not one this read
  # printed and nothing here retires it.
  for e in "$dir"/[0-9]*; do
    [ -f "$e" ] || continue
    label="${e##*/}"
    if [ "$mine" -eq 1 ]; then
      # Prove the archive path before claiming anything. A bad archive setting
      # must leave a waiting message waiting, never turn it into a held entry
      # whose delivery fate is then misreported as unknown.
      if [ -z "$mail_archive" ]; then
        archive_establish "$SESSION-read"
        archived_name="$(agent_name_of "$id" 2>/dev/null)" || archived_name=""
        valid_name "$archived_name" || archived_name="${id#@}"
        mail_archive="$ARCHIVE_DIR/$archived_name"
        mkdir -p "$mail_archive" \
          || die "cannot create $mail_archive for messages consumed by this read — the spool is untouched"
      fi
      # The drain's own claim rename, for the reason the drain has one: the
      # rename is what makes ownership atomic. A drain at this turn's boundary
      # and this read cannot both take the same entry, and the loser never
      # prints a body it did not get.
      claim="$dir/sending-$label"
      mv -- "$e" "$claim" 2>/dev/null || continue
      e="$claim"
    fi
    if ! spool_read_try "$e"; then
      if [ "$mine" -eq 1 ]; then
        mv -- "$e" "$dir/$label" 2>/dev/null \
          || die "$SPOOL_READ_ERROR; its claim also could not be returned — it remains readable at $e"
        die "$SPOOL_READ_ERROR — the entry was returned to the waiting spool"
      fi
      die "$SPOOL_READ_ERROR"
    fi
    if [ "$mine" -eq 1 ]; then
      if ! mv -- "$e" "$mail_archive/$label"; then
        mv -- "$e" "$dir/$label" 2>/dev/null \
          || die "cannot archive the spooled message $label before printing it, and cannot return its claim — it remains readable at $e"
        die "cannot archive the spooled message $label before printing it — it was returned to the waiting spool"
      fi
      [ "$n" -ne 0 ] \
        || printf 'self-mail is destructive; consumed entries from this read are archived under %s\ndelete this read archive after recovery with: rm -rf -- %q\n' \
          "$ARCHIVE_DIR" "$ARCHIVE_DIR" >&2
    fi
    n=$((n + 1))
    printf '%s\n' "$(colour "$C_WORK" "$heading #$n from $SPOOL_SENDER — $label")"
    printf '%s\n\n' "$SPOOL_BODY"
  done
  # KEPT, NEVER CONSUMED, AND NAMED FOR WHICH KIND IT IS. A held entry is not
  # this read's to retire — nothing will deliver it, so a read that removed it
  # would be the last chance anyone had to see it. An `unverified-` one carries
  # the extra warning the reader actually needs: it may be the second time they
  # are seeing this body, because it was typed into their composer already.
  for e in "$dir"/.writing-*; do
    spool_abandoned "$e" || continue
    held=$((held + 1))
    if spool_read_try "$e"; then
      printf '%s\n' "$(colour "$C_BAD" "written but never parked — its sender died before committing it, from $SPOOL_SENDER — ${e##*/}")"
      printf '%s\n\n' "$SPOOL_BODY"
    else
      printf '%s\n' "$(colour "$C_BAD" "written but never parked and unreadable — its sender died mid-write — $e")"
    fi
  done
  for e in "$dir"/unverified-*; do
    [ -f "$e" ] || continue
    spool_read "$e"
    held=$((held + 1))
    printf '%s\n' "$(colour "$C_BAD" "typed into this composer, submission NOT verified — you may have seen this already, from $SPOOL_SENDER — ${e##*/}")"
    printf '%s\n\n' "$SPOOL_BODY"
  done
  for e in "$dir"/sending-* "$dir"/failed-*; do
    [ -f "$e" ] || continue
    spool_read "$e"
    held=$((held + 1))
    printf '%s\n' "$(colour "$C_BAD" "held (delivery NOT verified — it may still have arrived) from $SPOOL_SENDER — ${e##*/}")"
    printf '%s\n\n' "$SPOOL_BODY"
  done
  if [ "$n" -eq 0 ] && [ -n "$mail_archive" ]; then
    rmdir -- "$mail_archive" "$ARCHIVE_DIR" 2>/dev/null || true
    mail_archive="" ARCHIVE_DIR=""
  fi
  if [ "$n" -eq 0 ] && [ "$held" -eq 0 ]; then
    printf '%s\n' "$(colour "$C_DIM" "no mail waiting for $name")"
    return 0
  fi
  if [ "$mine" -eq 1 ]; then
    printf '%s\n' "$(colour "$C_DIM" "$n consumed by this read and archived at ${mail_archive:-<none>}, $held held (kept), in $dir")"
    [ -z "$mail_archive" ] \
      || printf 'self-mail archived %s consumed message(s) at %s\n' "$n" "$mail_archive" >&2
  else
    printf '%s\n' "$(colour "$C_DIM" "$n waiting, $held held, in $dir")"
  fi
}

cmd_whoami() {
  local id name collar stamped live mismatch
  [ $# -eq 0 ] || die "whoami: takes no arguments"
  id="$(self_window)" || {
    cmd_help whoami
    printf "(this shell is not in a Gangline agent window of team '%s')\n" "$SESSION"
    exit 1
  }
  name="$(agent_name_of "$id")"
  collar="$(collar_read "$id")" || exit 1
  stamped="$(tmux show-options -wqv -t "$id" @gl_session_id 2>/dev/null)" || stamped=""
  live="$(tmux show-options -wqv -t "$id" @gl_session_live_id 2>/dev/null)" || live=""
  mismatch="$(identity_mismatch_read "$id")" || mismatch=""
  printf 'agent: %s\npane: %s\ncollar: %s\nharness session id: %s\nlive payload id: %s\nteam session: %s\nmismatch: %s\n' \
    "$name" "${TMUX_PANE:-COULD-NOT-DETERMINE}" "${collar:-UNSTAMPED}" \
    "${stamped:-UNSTAMPED}" "${live:-NOT-IN-A-HOOK-YET}" "$SESSION" "${mismatch:-none}"
}

# THE LISTING IS THE PRODUCT, and a row is not the listing. Roster is the check
# run before `gang down` or `gang drop`, so a run that stops at the first agent
# whose pane will not answer prints the agents before it, prints nothing about
# the agents after it, and looks from the outside exactly like a smaller team.
# The reading that could not be taken is a fact about ONE agent, and that is
# where it stays: its row carries the unknown, every other row is still read and
# printed, and the command still ends nonzero so nothing reads the listing as an
# all-clear.
#
# Each row's own stderr is left alone rather than captured. The refusal it
# printed names the collar and the reading, it reaches the operator verbatim and
# in order, immediately above the row it explains, and a listing whose rows are
# all readable still writes nothing there.
cmd_roster() {
  local porcelain=0 id name bare special wins current unread="" rc
  if [ $# -eq 1 ] && [ "$1" = --porcelain ]; then
    porcelain=1
  elif [ $# -ne 0 ]; then
    die "roster: expected no arguments or --porcelain"
  fi
  if ! session_live; then
    [ "$porcelain" -eq 1 ] \
      || printf '%s\n' "$(colour "$C_DIM" "no team (session '$SESSION' not running)")"
    return
  fi
  [ "$porcelain" -eq 1 ] || tick_health_report
  current="$(binary_id)"
  wins="$(tmux list-windows -t "=$SESSION" -F '#{window_id} #W #{@gl_tick_alerts}')"
  while read -r id name special; do
    [ -n "$id" ] || continue
    [ "$special" != 1 ] || continue
    bare="$(bare_name "$name")"
    rc=0
    if [ "$porcelain" -eq 1 ]; then
      ( roster_row_porcelain "$id" "$bare" ) || rc=$?
    else
      ( roster_row "$id" "$bare" "$current" ) || rc=$?
    fi
    case "$rc" in
      0) ;;
      # Status 4 is the row saying it printed itself with an unknown state in
      # place of one it could not read. Anything else is a row that did not
      # print at all, and the agent still gets a line of its own: a name and a
      # collar are readable without touching the pane, and the rest of that row
      # is exactly what gang does not know.
      4) unread="$unread $bare" ;;
      *) roster_row_unread "$id" "$bare" "$porcelain"
         unread="$unread $bare" ;;
    esac
  done <<EOF
$wins
EOF
  # A ROW IS A LIVE WINDOW, so a spool whose window is gone can never have one.
  # Naming it under the rows is the surface that difference needs: every other
  # command resolves a spool through @gl_spool and therefore cannot see it at
  # all. Not in --porcelain, whose columns are per-agent and whose consumers
  # parse a fixed shape.
  [ "$porcelain" -eq 1 ] || spool_orphan_report
  [ -z "$unread" ] \
    || die "roster: could not read the state of:$unread — every agent in the team is listed above, and the rows gang could not read carry an unknown state rather than a state nobody looked at"
}

roster_row_unread() { # $1 window, $2 name, $3 porcelain; the row for a row that died
  local prof
  prof="$(collar_read "$1")"
  [ -n "$prof" ] || prof="-"
  if [ "$3" -eq 1 ]; then
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$2" "$prof" unknown - - -
  else
    printf '%-16s %-12s %s\n' "$2" "$prof" \
      "$(paint_state "$(printf '%-18s' '?unknown?')")"
  fi
}

roster_state_word() { # $1 decorated state -> one stable porcelain word
  case "$1" in
    -busy-*) printf busy ;;
    '~wait~'*) printf waiting ;;
    '~idle~'*) printf idle ;;
    '!occupied!'*) printf occupied ;;
    '!bricked!'*) printf bricked ;;
    '!session-lost!'*) printf session-lost ;;
    '?unknown?'*) printf unknown ;;
    *) die "internal: no porcelain word for state '$1'" ;;
  esac
}

roster_row_porcelain() { # name, collar, state, spooled, age seconds, session id;
                        # exit 4 = the row printed with a state it could not read
  local prof state spooled age="-" stamped unread=0
  prof="$(collar_read "$1")" || exit 1
  if [ -z "$prof" ]; then
    prof="-" state=unadopted
  elif ! collar_file "$prof" >/dev/null; then
    state="collar-missing"
  else
    load_collar "$prof"
    # READ, THEN WORDED. Nested, a refusal from the inner reading reaches
    # roster_state_word as an empty state and dies there instead — an internal
    # complaint about a word that was never produced, in place of the reading
    # that could not be taken.
    if state="$(state_now "$1" snapshot)"; then
      state="$(roster_state_word "$state")"
    else
      state=unknown unread=1
    fi
  fi
  spooled="$(spool_count "$1")"
  if [ "$spooled" -ne 0 ]; then
    age="$(spool_oldest_age "$1")" || age="-"
  fi
  stamped="$(tmux show-options -wqv -t "$1" @gl_session_id 2>/dev/null)" \
    || stamped=""
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$2" "$prof" "$state" "$spooled" "$age" "${stamped:-UNSTAMPED}"
  [ "$unread" -eq 0 ] || exit 4
}

roster_row() { # $1 window, $2 name, $3 current binary id;
               # exit 4 = the row printed with a state it could not read
  local prof state detail="" spooled timed age held skew="" mismatch probe_failed usage_record usage_rc=0 usage_state usage_observed wake_record wake_rc=0 wake_reset now unread=0
  prof="$(collar_read "$1")" || exit 1
  [ -n "$prof" ] \
    || { printf '%-16s %-12s %s\n' "$2" "-" "$(colour "$C_DIM" "unadopted")"; return; }
  collar_file "$prof" >/dev/null \
    || { printf '%-16s %-12s %s\n' "$2" "$prof" "$(colour "$C_BAD" "collar not found")"; return; }
  load_collar "$prof"
  state="$(state_now "$1" snapshot)" || { state="?unknown?" unread=1; }
  [ -z "$(staged_current "$1")" ] || detail=" undelivered-input"
  # A BOOLEAN, never a count. The harness's hint says something is parked and
  # never how many, so a number here would be gang's invention rather than the
  # harness's answer. staged_current above has already re-read the box, so a
  # queue that drained since is no longer reported as waiting.
  [ -z "$(parked_current "$1")" ] || detail="$detail parked"
  [ -z "$(self_compact_failed_read "$1")" ] \
    || detail="$detail self-compact-failed"
  detail="$detail $(action_detail "$1")"
  spooled="$(spool_count "$1")"
  if [ "$spooled" -ne 0 ]; then
    detail="$detail spooled=$spooled"
    age="$(spool_oldest_age "$1")" && detail="$detail oldest=$(human_seconds "$age")"
  fi
  timed="$(timed_count "$1")"
  [ "$timed" -eq 0 ] || detail="$detail timed=$timed"
  held="$(spool_held "$1")"
  [ "$held" -eq 0 ] || detail="$detail spool-held=$held"
  [ -z "$(tmux show-options -wqv -t "$1" @gl_stall_failed)" ] \
    || detail="$detail stall-note-failed"
  [ -z "$(tmux show-options -wqv -t "$1" @gl_auto_resume_failed)" ] \
    || detail="$detail auto-resume-failed"
  [ -z "$(tmux show-options -wqv -t "$1" @gl_hook_failed)" ] \
    || detail="$detail hook-failed"
  usage_record="$(usage_limit_record_read "$1")" || usage_rc=$?
  if [ "$usage_rc" -eq 0 ]; then
    read -r usage_state _ _ usage_observed _ <<<"$usage_record"
    now="$(date +%s)"
    if usage_limit_stale "$usage_observed" "$now"; then
      detail="$detail usage-stale"
    else
      case "$usage_state" in yellow|red) detail="$detail usage=$usage_state" ;; esac
    fi
  elif [ "$usage_rc" -eq 2 ]; then
    detail="$detail usage-unreadable"
  fi
  [ -z "$(tmux show-options -wqv -t "$1" @gl_usage_failed 2>/dev/null)" ] \
    || detail="$detail usage-unavailable"
  wake_record="$(usage_wake_read "$1")" || wake_rc=$?
  if [ "$wake_rc" -eq 0 ]; then
    IFS=$'\t' read -r wake_reset _ _ <<<"$wake_record"
    now="$(date +%s)"
    if [ "$wake_reset" -gt "$now" ]; then
      detail="$detail usage-wake=$(human_seconds $(( wake_reset - now )))"
    else
      detail="$detail usage-wake=overdue"
    fi
  elif [ "$wake_rc" -eq 2 ]; then
    detail="$detail usage-wake-unreadable"
  fi
  [ -z "$(tmux show-options -wqv -t "$1" @gl_usage_wake_failed 2>/dev/null)" ] \
    || detail="$detail usage-wake-failed"
  mismatch="$(identity_mismatch_read "$1")" || mismatch=""
  [ -z "$mismatch" ] || detail="$detail identity-mismatch=[$mismatch]"
  probe_failed="$(tmux show-options -wqv -t "$1" @gl_session_probe_failed 2>/dev/null)" || probe_failed=""
  [ -z "$probe_failed" ] || detail="$detail identity-unverified=[$probe_failed]"
  skew="$(binary_skew_note "$1" "$3")" || skew=""
  [ -z "$skew" ] || detail="$detail $skew"
  # WHICH unknown this is. A state gang determined it could not settle names its
  # own witness in the state phrase; a state gang could not READ has no phrase to
  # carry, so the row says which of the two it met.
  [ "$unread" -eq 0 ] || detail="$detail state-unreadable"
  printf '%-16s %-12s %s%s\n' "$2" "$prof" \
    "$(paint_state "$(printf '%-18s' "$state")")" "$detail"
  [ "$unread" -eq 0 ] || exit 4
}

hook_identity_assert() { # $1 pane, $2 collar, $3 native payload; never kills a harness
  local live
  live="$(
    {
      load_collar "$2"
      declare -F collar_session_id >/dev/null || exit 1
      collar_session_id "$1" "$3"
    } 2>/dev/null
  )" || return 0
  case "$live" in ''|*[!A-Za-z0-9._:-]*) return 0 ;; esac
  session_identity_record "$1" "$live" >/dev/null 2>&1 || true
}

# A SHAPE GANG CANNOT INTERPRET IS A FAILURE, NOT A NO-OP. Swallowing the parse
# and exiting 0 tells the harness the hook worked while Gangline records
# nothing: a lost Stop leaves the turn bracket open, dispatches no deferred
# self-compaction and drains no spool, and lost occupancy evidence suppresses
# stall reporting — all of it invisible. CONSTITUTION and AGENTS.md both require
# the opposite: fail loudly when a native shape can no longer be interpreted.
#
# WHERE THE LOUDNESS GOES is the part that needs deciding rather than
# reflexing. A nonzero exit is the harness's own turn to break, and breaking an
# agent's turn over an event that concerns only Gangline trades a silent gap for
# a loud one in the wrong place — so this is not that. A malformed CONFIG still
# exits nonzero, because that is a whole-installation fault and every command
# fails on it alike; a single uninterpretable event is neither. What it gets is
# stderr for whoever is watching the harness, and a fact on the window that
# `gang status` and `gang roster` both carry until an event gang CAN read
# retires it, so an operator finds it without reading a hook log.
hook_uninterpretable() { # $1 = firing pane (may be empty), rest = what failed
  local win="$1"; shift
  local note="could not interpret the native event: $*"
  printf 'gang hook: %s\n' "$note" >&2
  [ -n "$win" ] || return 0
  tmux set-option -w -t "$win" @gl_hook_failed "$note" 2>/dev/null || true
}

cmd_hook() { # native harness events; facts are silent unless a light crosses
  local payload event collar kind="" window="" waiting_rc=1
  # THE EVENT IS THE PAYLOAD, SO ARGV IS AN INVOCATION GANG CANNOT READ. Every
  # other command answers unconsumed arity by dying; this one must not, because
  # its caller is a harness configuration and law 7 keeps hooks non-fatal. It
  # takes the same route a malformed payload takes instead: recorded on the
  # window where status and roster surface it, and not acted on — half-honouring
  # a request gang could not read is the outcome that would be silent. Reading
  # stdin first would consume the event on the way to declining it.
  if [ $# -gt 0 ]; then
    hook_uninterpretable "${TMUX_PANE:-}" \
      "the invocation carries an argument gang hook does not take ('$1'); the event is the payload on standard input"
    exit 0
  fi
  payload="$(cat)" || payload=""
  event="$(printf '%s' "$payload" \
    | python3 -c 'import json,sys; print(json.load(sys.stdin).get("hook_event_name",""))' \
      2>/dev/null)" || {
    hook_uninterpretable "${TMUX_PANE:-}" "the payload is not readable JSON"
    exit 0
  }
  [ -n "$event" ] || {
    hook_uninterpretable "${TMUX_PANE:-}" "the payload carries no hook_event_name"
    exit 0
  }
  # The consumed set is gang's own, not the collar's: these are the arms below.
  # A name outside it means the harness renamed an event Gangline installed,
  # which is exactly the reading that must not pass as a successful no-op.
  case "$event" in
    UserPromptSubmit|PostToolUse|Stop|PermissionRequest|Notification) ;;
    PreCompact|PostCompact) ;;
    *) hook_uninterpretable "${TMUX_PANE:-}" \
         "unknown hook_event_name '$event' — this Gangline consumes UserPromptSubmit, PostToolUse, Stop, PermissionRequest, Notification, PreCompact and PostCompact"
       exit 0 ;;
  esac
  [ -n "${TMUX_PANE:-}" ] || exit 0
  collar="$(collar_read "$TMUX_PANE" 2>/dev/null)" || exit 0
  [ -n "$collar" ] || exit 0
  hook_identity_assert "$TMUX_PANE" "$collar" "$payload"
  if [ "$event" = UserPromptSubmit ]; then
    ( auto_resume_prompt_witness "$TMUX_PANE" "$collar" "$payload" ) || true
  fi
  if [ "$event" = Notification ]; then
    kind="$(printf '%s' "$payload" \
      | python3 -c 'import json,sys; print(json.load(sys.stdin).get("notification_type",""))' \
        2>/dev/null)" || kind=""
    # A kind gang cannot read is not a kind outside the collar's declaration:
    # the second is an interpreted event this collar does not act on, and the
    # first is a Notification whose meaning is unavailable.
    [ -n "$kind" ] || {
      hook_uninterpretable "$TMUX_PANE" \
        "a Notification with no readable notification_type"
      exit 0
    }
  fi
  tmux set-option -uw -t "$TMUX_PANE" @gl_hook_failed 2>/dev/null || true
  [ "$event" = Stop ] || waiting_clear "$TMUX_PANE"
  case "$event" in
    Stop|PostCompact)
      window="$(tmux display-message -p -t "$TMUX_PANE" '#{window_id}' 2>/dev/null)" \
        || window=""
      [ -n "$window" ] || exit 0 ;;
  esac
  case "$event" in
    UserPromptSubmit|PostToolUse) stall_clear "$TMUX_PANE"
                                  turn_state_write "$TMUX_PANE" open
                                  compaction_state_settle "$TMUX_PANE"
                                  glyph_write "$TMUX_PANE" "-busy-"
                                  if [ "$event" = PostToolUse ]; then
                                    window="$(tmux display-message -p -t "$TMUX_PANE" '#{window_id}' 2>/dev/null)" \
                                      || window=""
                                    [ -z "$window" ] \
                                      || ( load_collar "$collar"
                                           [ "$GANG_MIDTURN_INPUT" != steer ] \
                                             || spool_event "$window" "$collar" midturn
                                         ) || true
                                  fi ;;
    Stop) turn_state_write "$TMUX_PANE" closed
          compaction_state_settle "$TMUX_PANE"
          stall_clear "$TMUX_PANE"
          waiting_refresh "$TMUX_PANE" "$collar" "$payload"
          waiting_rc=0
          waiting_read "$TMUX_PANE" || waiting_rc=$?
          case "$waiting_rc" in
            0) glyph_write "$TMUX_PANE" "~wait~" ;;
            1) glyph_write "$TMUX_PANE" "~idle~" ;;
            2) glyph_write "$TMUX_PANE" "?unknown?" ;;
          esac
          wait_signal_registered "$window" "$TMUX_PANE"
          tmux set-option -w -t "$TMUX_PANE" @gl_context_ready 1 2>/dev/null || true
          # One native boundary starts one delivery action. Mail already
          # waiting gets this opportunity and leaves a self-compaction request
          # standing for a later Stop; otherwise the compaction owns it. This
          # keeps the two workers from racing for the same pane lock and makes
          # the choice from the queue state that existed at the boundary.
          # A tick that caused this Stop still owns the pane lock and will
          # sequence the remaining spool and self-compaction work itself. The
          # native facts above are kept; only the duplicate dispatcher is
          # suppressed. A killed tick leaves a pid that the next hook clears.
          if tick_delivery_active "$window"; then
            :
          elif [ "$(spool_count "$window")" -gt 0 ]; then
            spool_event "$window" "$collar"
          else
            self_compact_dispatch "$window" "$collar"
          fi ;;
    PreCompact) compaction_state_write "$TMUX_PANE" open
                # The harness names its own cause in the payload, so gang never
                # has to infer the origin from how the compaction was started.
                # Recorded rather than acted on: every trigger observed so far
                # reads "manual", and the value is what will identify an "auto"
                # the first time a real session produces one.
                kind="$(printf '%s' "$payload" \
                  | python3 -c 'import json,sys; print(json.load(sys.stdin).get("trigger",""))' \
                    2>/dev/null)" || kind=""
                [ -z "$kind" ] \
                  || tmux set-option -w -t "$TMUX_PANE" @gl_compaction_trigger "$kind" 2>/dev/null || true
                glyph_write "$TMUX_PANE" "-busy-" ;;
    PostCompact) compaction_state_write "$TMUX_PANE" closed
                 # Closing this bracket drains, exactly as closing a turn does.
                 # A compaction produces no Stop, so without this the spool a
                 # correctly-refused delivery just filled would wait for an
                 # unrelated turn boundary that may never come.
                 spool_event "$window" "$collar" ;;
    PermissionRequest) occupied_raise_write "$TMUX_PANE"
                       glyph_write "$TMUX_PANE" "!occupied!"
                       stall_note "$TMUX_PANE" permission_prompt ;;
    Notification) ( load_collar "$collar"
                    resumed=0
                    auto_resume_stream_note "$TMUX_PANE" "$collar" "$kind" \
                      && resumed=1
                    if [ "$resumed" -eq 0 ]; then
                      case " $GANG_STALL_TYPES " in
                        *" $kind "*) stall_note "$TMUX_PANE" "$kind" ;;
                      esac
                    fi
                  ) || true ;;
  esac
  case "$event" in
    UserPromptSubmit|PostToolUse)
      ( set +e; advisory_reply "$event" "$collar"; exit 0 ) ;;
  esac
  exit 0
}

cmd_capture() { # trailing blank pane rows are dead space, not content
  local id name="${1:-}" rc=0
  [ $# -le 2 ] || die "capture: unexpected argument '$3'"
  if [ -z "$name" ]; then
    name="$(self_name)" || {
      cmd_help capture
      printf '(no target given, and this shell is not a Gangline agent window)\n'
      exit 1
    }
  fi
  id="$(win_id "$name")" || { rc=$?; win_id_missing "$rc" "no window '$name' in session '$SESSION'"; }
  # A CAPTURE THAT FAILED IS NOT AN EMPTY PANE. Piping it straight out would
  # print nothing and exit non-zero, which reads as a pane with nothing in it.
  local text capture_rc=0
  text="$(capture "$id")" || capture_rc=$?
  [ "$capture_rc" -eq 0 ] \
    || die "cannot read the pane behind '$name': tmux refused the capture, so what it is showing is unknown rather than empty"
  printf '%s\n' "$text" \
    | awk 'NF{last=NR} {line[NR]=$0} END{for(i=1;i<=last;i++) print line[i]}' | tail -n "${2:-40}"
}

cmd_composer() { # what a human actually typed — capture shows the raw pane,
  # where a harness's dim suggested-prompt placeholder is indistinguishable from
  # a real draft; the collar's reading strips styling, so placeholders vanish
  local name="${1:-}"
  [ $# -le 1 ] || die "composer: unexpected argument '$2'"
  if [ -z "$name" ]; then
    name="$(self_name)" || {
      cmd_help composer
      printf '(no target given, and this shell is not a Gangline agent window)\n'
      exit 1
    }
  fi
  resolve "$name"
  declare -F collar_input >/dev/null \
    || die "collar '$AGENT_COLLAR' declares no collar_input, so '$name' has no readable composer"
  local box box_rc=0
  box="$(input_read "$AGENT_ID")" || box_rc=$?
  [ "$box_rc" -ne 2 ] \
    || die "the composer in '$name' is taller than its pane, so its box runs past the bottom of the window and cannot be read — make the window taller (gang capture $name)"
  # AN UNREADABLE PANE IS NOT A PANE WITH NO COMPOSER, and the reading above is
  # the one place that difference is settled, so absence is only ever reported
  # about a pane that answered.
  [ "$box_rc" -ne 3 ] \
    || die "cannot read the pane behind '$name', so whether it is showing a composer is unknown rather than settled (gang capture $name)"
  [ "$box_rc" -ne 4 ] \
    || die "the composer on screen in '$name' belongs to a selected in-process subagent, so it is not this agent's input and typing there would reach the child (gang capture $name)"
  [ "$box_rc" -eq 0 ] \
    || die "no composer on screen in '$name' — the harness has not drawn its input box (gang capture $name)"
  grep -q '[^[:space:]]' <<<"$box" || return 0  # prompt padding only: empty, input_clear's rule
  printf '%s\n' "$box"
}

cmd_adopt() { # register an EXISTING tmux window as a gang agent
  local name="" collar="" id rc=0
  name="${1:-}"; case "$name" in ''|-*) usage_die ;; esac; shift
  valid_name "$name" \
    || die "adopt: '$name' is not a usable agent name — hitch and gangline are reserved for Gangline; other names use letters, digits, dot, dash and underscore only. Rename the window first (tmux rename-window)"
  while [ $# -gt 0 ]; do case "$1" in
    -c|--collar) [ $# -ge 2 ] || die "adopt: $1 needs a value"
                  collar="$2"; shift 2 ;;
    *) die "adopt: unknown argument '$1'" ;;
  esac; done
  [ -n "$collar" ] || die "adopt: -c <collar> is required"
  ! test_only_collar "$collar" \
    || die "adopt: '$collar' is a stand-in for gangline's own suite, not a harness to run an agent on (GANG_TEST_COLLARS=1 if you are testing gang itself)"
  load_collar "$collar"
  id="$(win_id "$name")" || { rc=$?; win_id_missing "$rc" "no window '$name' in session '$SESSION' to adopt"; }
  launch_dead "$id" \
    && die "adopt: nothing is running in window '$name', so there is no harness to adopt. Restart the harness there and retry, or if tmux is holding the dead window remove it with: tmux kill-window -t '$id'"
  registered_identity_guard "$id" "$name" adopt "$collar"
  usage_lights_parse "$GANG_USAGE_LIGHTS" >/dev/null || true
  auto_resume_parse "$GANG_AUTO_RESUME" >/dev/null || true
  # A WINDOW-SUPPLIED SPOOL IDENTITY CAN REFUSE. Settle that residue before
  # registration, so a failed adoption does not leave an agent/collar behind.
  spool_mint "$id"
  tmux set-option -w -t "$id" automatic-rename off
  tmux set-option -w -t "$id" allow-rename off
  tmux set-option -w -t "$id" @gl_agent "$name"
  tmux set-option -w -t "$id" @gl_collar "$collar"
  waiting_clear "$id"
  stamp_binary_id "$id"
  if [ "$GANG_USAGE_LIGHTS" != off ]; then
    tmux set-option -w -t "$id" @gl_usage_lights "$GANG_USAGE_LIGHTS"
  fi
  if [ "$GANG_AUTO_RESUME" != off ]; then
    tmux set-option -w -t "$id" @gl_auto_resume "$GANG_AUTO_RESUME"
  fi
  # Adoption establishes identity; state is observed only by commands and
  # hooks whose result consumes it. Mark the unwitnessed initial state honestly.
  glyph_write "$id" "?unknown?"
  printf '%s\n' "$(colour "$C_OK" "adopted $name as a $collar agent")"
}

cmd_rename() { # change one registered identity without changing its spool
  local old new shown_old id rc=0 collision_rc=0 registered
  [ $# -ge 2 ] || { cmd_help rename; exit 1; }
  [ $# -le 2 ] || die "rename: unexpected argument '$3'"
  old="$1" new="$2"
  shown_old="$(printf '%s' "$old" | config_sanitize)"

  # Resolve the OLD name first. A title is decoration and must neither redirect
  # this mutation nor make an unregistered window renameable as an agent. A
  # collar is launch/observation strategy, not identity, so renaming does not
  # load it or depend on its file still being present.
  id="$(win_id "$old")" \
    || { rc=$?; win_id_missing "$rc" "no agent '$shown_old' (see: gang roster)"; }
  registered="$(tmux show-options -wqv -t "$id" @gl_agent 2>/dev/null)" \
    || registered=""
  [ "$registered" = "$old" ] \
    || die "window '$shown_old' is not a registered Gangline agent"
  valid_name "$new" \
    || die "rename: '$new' is not a usable agent name — hitch and gangline are reserved for Gangline; other names use letters, digits, dot, dash and underscore only"

  # Status 0 is either a registered identity or an unregistered window whose
  # title would make resolution ambiguous after the rename. Status 2 is already
  # ambiguous. A contradicted title (3) is safe: its registration belongs to a
  # different name, and titles never claim identity.
  win_id "$new" >/dev/null 2>&1 || collision_rc=$?
  case "$collision_rc" in
    0|2) die "rename: '$new' is already in use by another window in session '$SESSION'" ;;
    1|3) ;;
    *) die "rename: could not determine whether '$new' is already in use" ;;
  esac

  tmux set-option -w -t "$id" @gl_agent "$new" \
    || die "rename: could not change the registered identity '$shown_old'"
  if ! tmux rename-window -t "$id" -- "$new"; then
    registered="$(tmux show-options -wqv -t "$id" @gl_agent 2>/dev/null)" \
      || registered=""
    [ "$registered" != "$new" ] \
      || die "rename: the registered identity is now '$new', but its window title could not be rewritten"
    die "rename: could not rewrite the window title, and whether the registered identity changed is unknown"
  fi
  printf '%s\n' "$(colour "$C_OK" "renamed $shown_old to $new")"
}

# WHAT A RELAUNCH WOULD NEED, PRINTED WHILE THE WINDOW STILL EXISTS. A teardown
# is the last moment the stamp is readable, so this is where it gets quoted —
# and a stamp the hook-time assertion contradicted is not something to quote.
# Sends from such a pane already fail closed; a relaunch line pointing at a
# conversation the window is not running is the same claim, printed where an
# operator will act on it.
parting_lines() { # $1 = window id, $2 = the name a relaunch would take
  local mismatch stamped prof
  if mismatch="$(identity_mismatch_read "$1")"; then
    printf 'session id: MISMATCH (%s) — refusing to quote a relaunch for an identity this harness contradicted\n' \
      "$mismatch"
    return 0
  fi
  stamped="$(tmux show-options -wqv -t "$1" @gl_session_id 2>/dev/null)" || stamped=""
  [ -n "$stamped" ] \
    || { printf 'session id: UNSTAMPED — this collar has not supplied an identity Gangline can resume\n'
         return 0; }
  # A STAMP IS AN IDENTITY, NOT A WAY BACK. Only `hook_identity_assert` writes
  # one, and only through a collar that witnesses its harness's id — which is a
  # different declaration from the launch line --resume needs. A collar with the
  # witness and no launch stamps, and the relaunch quoted here for it was a
  # command hitch then refuses: the operator's one recorded way back, printed at
  # the moment the agent ends, not runnable.
  #
  # Read from the collar rather than the loaded globals: `down` walks the team's
  # windows without loading each collar, so whatever was loaded last would
  # answer for all of them.
  prof="$(collar_read "$1")"
  if [ -z "$prof" ]; then
    printf 'session id: %s\nrelaunch: UNKNOWN — this window records no collar, so whether hitch takes --resume for it cannot be determined\n' \
      "$stamped"
    return 0
  fi
  case "$(collar_resume_word "$prof")" in
    resume|resume-id-only)
      printf 'session id: %s\nrelaunch: gang hitch %s --resume %s\n' \
        "$stamped" "$2" "$stamped" ;;
    no-resume)
      printf 'session id: %s\nrelaunch: none — collar %s declares no resume launch, so hitch takes no --resume for it. The id above is a record of the harness session, not a way back into it\n' \
        "$stamped" "$prof" ;;
    *)
      printf 'session id: %s\nrelaunch: UNKNOWN — collar %s would not load, so whether hitch takes --resume for it cannot be determined\n' \
        "$stamped" "$prof" ;;
  esac
}

cmd_drop() {
  local id shown rc=0
  [ $# -le 1 ] || die "drop: unexpected argument '$2'"
  # The argument reaches the terminal, and drop is the one command an operator
  # runs with a name they read off a hostile registration. It is not validated
  # here on purpose: valid_name would leave a window whose own registration is
  # forged undroppable by any name gang accepts, and tmux kill-window is then
  # the only way out — which skips the archive and destroys the pending mail.
  # Droppable, contained, and printed safely is the combination that holds.
  shown="$(printf '%s' "$1" | config_sanitize)"
  id="$(win_id "$1")" || { rc=$?; win_id_missing "$rc" "no agent '$shown'"; }
  parting_lines "$id" "$shown"
  # A spool would outlive its window on disk, which is not a design: this is
  # its deletion path — but a composed message is archived out of it first.
  usage_wake_cancel "$id" quiet
  spool_archive "$id"
  spool_forget "$id"
  tmux kill-window -t "$id"
  # kill-window does not promise pane-exited on every supported tmux. Any
  # registration its native hook did not already consume is released here,
  # after the identity is gone so the waiter cannot mistake teardown for done.
  wait_signal_registered "$id"
  printf '%s\n' "$(colour "$C_OK" "dropped $shown")"
}

cmd_down() { # inverse of up: end the whole team's session
  local named="${1:-}" id raw special shown names="" self="" wait_ids="" ids=""
  [ $# -le 1 ] || die "down: unexpected argument '$2'"
  [ "$named" = "$SESSION" ] \
    || die "down: this shell's team is '$SESSION' and you named '$named' — refusing to end a session you did not name. Gang ends exactly the team it is pointed at (gang roster; GANG_SESSION selects another)"
  session_live || die "no session '$SESSION' running"
  if self="$(self_window)"; then
    refuse "down: this pane is agent '$(agent_name_of "$self")' inside '$SESSION' — a window cannot end the session it is running in, and Gangline offers no override for it. Detach (prefix-d, or run this from a shell outside tmux) and end the team from there"
  fi
  if [ -z "${TMUX_PANE:-}" ] && [ -n "${TMUX:-}" ] \
     && [ "${TMUX%%,*}" = "$(tmux display-message -p '#{socket_path}' 2>/dev/null)" ]; then
    refuse "down: this shell is inside the tmux server that holds '$SESSION' and does not name a pane, so Gangline cannot tell whether it is running inside the team it would end. Run it from a shell outside tmux"
  fi
  while read -r raw special; do
    [ "$special" != 1 ] || continue
    names="$names$(bare_name "$raw") "
  done < <(tmux list-windows -t "=$SESSION" -F '#W #{@gl_tick_alerts}')
  while read -r id special; do
    [ "$special" != 1 ] || continue
    ids="${ids:+$ids$'\n'}$id"
  done < <(tmux list-windows -t "=$SESSION" -F '#{window_id} #{@gl_tick_alerts}')
  # WHOLE-TEAM PREFLIGHT. Each window's archive is internally all-or-nothing,
  # but down used to archive and detach the spools of earlier windows before a
  # later unarchiveable child refused the teardown. The session stayed live
  # with those earlier messages no longer deliverable. Settle every spool
  # before cancelling a wake or moving the first entry anywhere.
  while read -r id; do
    [ -n "$id" ] || continue
    spool_archive_preflight "$id"
  done <<<"$ids"
  echo "$(colour "$C_OK" "ending '$SESSION':") $(colour "$C_DIM" "$names")"
  while read -r id; do
    [ -n "$id" ] || continue
    wait_ids="$wait_ids $id"
    # BEFORE THE ARCHIVE, because down is exactly the situation the parting
    # line exists for and the operator was left with no ids to relaunch from.
    # Printing first also means a teardown that refuses further down has
    # already said what each agent would need to come back.
    shown="$(agent_name_of "$id")"
    printf '%s\n' "$(colour "$C_DIM" "$shown")"
    parting_lines "$id" "$shown"
    usage_wake_cancel "$id" quiet
    spool_archive "$id"
    spool_forget "$id"
  done <<<"$ids"
  tick_state_forget
  tmux kill-session -t "=$SESSION"
  team_socket_forget "$SESSION"
  for id in $wait_ids; do wait_signal_registered "$id"; done
}

cmd_attach() {
  local socket rc=0
  [ $# -eq 0 ] || die "attach: takes no arguments"
  # THE SOCKET THIS SHELL CAN SEE IS ASKED FIRST, so an ordinary attach is
  # exactly what it always was. Only when the team is not on it does the
  # written-down socket matter, and that is the disconnect this exists for: the
  # server is alive on a private TMUX_TMPDIR that this shell no longer carries.
  if session_live; then
    tick_launch || true
    exec tmux attach -t "=$SESSION"
  fi
  socket="$(team_socket_read "$SESSION")" \
    || die "no session '$SESSION' running, and no socket is recorded for it (gang teams lists what gang wrote down)"
  team_live_on "$socket" "$SESSION" || rc=$?
  case "$rc" in
    0) printf '%s\n' "$(colour "$C_DIM" "'$SESSION' is not on this shell's tmux socket; attaching on the one gang recorded for it: $socket")" >&2
       exec tmux -S "$socket" attach -t "=$SESSION" ;;
    1) die "no session '$SESSION' running: a tmux server answers on the socket gang recorded for it ($socket) and that session is not on it" ;;
    *) die "no session '$SESSION' running: nothing answers on the socket gang recorded for it ($socket), so the team it named is gone" ;;
  esac
}

# WHAT A COLLAR CAN BE RESUMED ONTO is a property an operator needs at the
# moment they pick one, not at the moment they drop the agent. The two halves —
# a launch line with a session slot, and a collar that witnesses the native id
# to put in it — are separate declarations, and each is missing differently. No
# launch and nothing relaunches at all, whatever is witnessed. No witness and
# the launch still runs, on an id the operator supplies. That is a harness
# choice, so it is answered here, where the choice is made.
#
# Loaded in a subshell so a listing cannot inherit one collar's declarations
# into the next, and so a collar that will not load leaves the listing standing
# with its own capability unknown rather than ending it.
collar_resume_word() { # $1 -> resume | resume-id-only | no-resume | unknown
  # The fallback is OUTSIDE the subshell because a collar that will not load
  # refuses from inside it: `die` exits the subshell then and there, so a rescue
  # written as its last statement would never run and the field would go out
  # empty — a capability claim of nothing, in a column read as an answer.
  local word=""
  word="$(
    load_collar "$1" >/dev/null 2>&1
    if [ -z "$GANG_RESUME_LAUNCH" ]; then
      printf no-resume
    elif declare -F collar_session_id >/dev/null; then
      printf resume
    else
      # THE HALF THAT STILL WORKS. hitch consults collar_session_id only for the
      # bare form; an explicit id relaunches on GANG_RESUME_LAUNCH alone. Folding
      # this into no-resume told an operator a session was lost for good when a
      # session id they hold themselves would have relaunched it.
      printf resume-id-only
    fi
  )" || word=""
  [ -n "$word" ] || word=unknown
  printf '%s' "$word"
}

cmd_collars() {
  [ $# -eq 0 ] || die "collars: takes no arguments"
  local n word names
  names="$(list_collars)"
  while read -r n; do
    [ -n "$n" ] || continue
    word="$(collar_resume_word "$n")"
    printf '%s\t%s\n' "$n" "$word"
  done <<EOF
$names
EOF
}

cmd_models() {
  local prof="${GANG_COLLAR:-claude-code}" collar_arg=0 catalog="" rc=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -c|--collar)
        [ $# -ge 2 ] || die "models: $1 needs a value"
        [ "$collar_arg" -eq 0 ] || die "models: -c may be passed only once"
        prof="$2" collar_arg=1; shift 2 ;;
      *) die "models: unexpected argument '$1'" ;;
    esac
  done
  if [ "$collar_arg" -eq 0 ]; then
    collar_file "$prof" >/dev/null \
      || die "unknown collar '$prof' (have: $(list_collars | tr '\n' ' '))$(config_origin_note GANG_COLLAR)"
  fi
  load_collar "$prof"
  [ -n "$GANG_MODEL_OPT" ] \
    || die "models: collar '$prof' declares no model choice"
  if declare -F collar_models >/dev/null; then
    catalog="$(models_read)" || rc=$?
    [ "$rc" -eq 0 ] || die "models: $(models_read_error "$prof" "$rc")"
    printf '%s\n' "$catalog"
    return 0
  fi
  if [ -n "$GANG_MODEL_ALIASES" ]; then
    catalog="$(model_rows_normalize "$GANG_MODEL_ALIASES")" || rc=$?
    [ "$rc" -eq 0 ] \
      || die "models: collar '$prof' returned aliases Gangline cannot interpret"
    printf '%s\n' "$catalog"
    printf "gang: NOTE: collar '%s' cannot enumerate full model names; listed documented aliases only.\n" \
      "$prof" >&2
    if declare -F collar_model_check >/dev/null; then
      printf 'gang: NOTE: hitch validates native model recognition, not availability to this account.\n' >&2
    fi
    return 0
  fi
  die "models: collar '$prof' cannot enumerate model ids and declares no documented aliases"
}

config_sanitize() { # stdin -> terminal-safe, single-line text
  LC_ALL=C tr '\000-\010\012-\037\177' '?' | tr '\011' ' '
}

config_effective() { # $1 settable key -> the value its consumers read
  case "$1" in
    GANG_COLLAR) printf '%s' "${GANG_COLLAR:-claude-code}" ;;
    GANG_SESSION) printf '%s' "$SESSION" ;;
    GANG_COLLARS) printf '%s' "${GANG_COLLARS:-}" ;;
    GANG_LOCK_DIR) printf '%s' "${GANG_LOCK_DIR:-/tmp/gangline-$(id -u)}" ;;
    GANG_TMUX_GUARD) printf '%s' "$GANG_TMUX_GUARD" ;;
    GANG_ARCHIVE_DIR) printf '%s' "$(archive_root)" ;;
    GANG_CONTEXT_LIGHTS) printf '%s' "$GANG_CONTEXT_LIGHTS" ;;
    GANG_USAGE_LIGHTS) printf '%s' "$GANG_USAGE_LIGHTS" ;;
    GANG_AUTO_RESUME) printf '%s' "$GANG_AUTO_RESUME" ;;
    GANG_SCOPE) printf '%s' "$GANG_SCOPE" ;;
    GANG_BOOT_TIMEOUT) printf '%s' "${GANG_BOOT_TIMEOUT:-30}" ;;
    GANG_GATE_LOOKS) printf '%s' "${GANG_GATE_LOOKS:-60}" ;;
    GANG_CHURN_WAIT) printf '%s' "$GANG_CHURN_WAIT" ;;
    GANG_ACTIVITY_WINDOW) printf '%s' "$GANG_ACTIVITY_WINDOW" ;;
    GANG_TURN_LIMIT) printf '%s' "$GANG_TURN_LIMIT" ;;
    *) die "internal: no effective config value for $1" ;;
  esac
}

cmd_config() {
  local k value record key origin line source file doctrine roles state
  [ $# -eq 0 ] || die "config: takes no arguments"
  for k in $GANG_CONFIG_KEYS; do
    value="$(config_effective "$k" | config_sanitize)"
    if record="$(config_origin "$k")"; then
      IFS=$'\t' read -r key origin line <<<"$record"
      [ "$line" != - ] || line=""
      case "$origin" in
        env)
          if [ -n "$line" ]; then
            source="environment (overriding config line $line)"
          else
            source="environment"
          fi
          ;;
        config)
          file="$(config_path "$CONFIG_FILE" | config_sanitize)"
          source="$file line $line"
          ;;
      esac
    else
      source="default"
    fi
    source="$(printf '%s' "$source" | config_sanitize)"
    printf '%s=%s\t%s\n' "$k" "$value" "$source"
  done
  doctrine="$CONFIG_DIR/DOCTRINE.md"
  if [ -e "$doctrine" ] || [ -L "$doctrine" ]; then state=present; else state=absent; fi
  doctrine="$(config_path "$doctrine" | config_sanitize)"
  printf 'doctrine\t%s\t%s\n' "$doctrine" "$state"
  roles="$CONFIG_DIR/roles"
  if [ -e "$roles" ] || [ -L "$roles" ]; then state=present; else state=absent; fi
  roles="$(config_path "$roles" | config_sanitize)"
  printf 'roles\t%s\t%s\n' "$roles" "$state"
}

cmd_upgrade() {
  local mode="" tmp rc=0 invoked invoked_bin_dir
  case "$#:${1:-}" in
    0:) ;;
    1:--check) mode=--check ;;
    1:*) die "upgrade: unexpected argument '$1'" ;;
    *) die "upgrade: unexpected argument '$2'" ;;
  esac
  [ -r "$ROOT/install.sh" ] \
    || die "upgrade: cannot read the installer at $ROOT/install.sh"
  invoked="${BASH_SOURCE[0]}"
  case "$invoked" in
    /*) ;;
    */*) invoked="$PWD/$invoked" ;;
    *) invoked="$(command -v -- "$invoked")" \
         || die "upgrade: cannot resolve the invoked gang path"
       case "$invoked" in /*) ;; *) invoked="$PWD/$invoked" ;; esac ;;
  esac
  invoked_bin_dir="$(cd -P "$(dirname "$invoked")" && pwd)" \
    || die "upgrade: cannot resolve the command directory containing $invoked"
  tmp="$(mktemp "${TMPDIR:-/tmp}/gangline-upgrade.XXXXXX")" \
    || die "upgrade: could not create a temporary installer"
  cp "$ROOT/install.sh" "$tmp" || {
    rm -f -- "$tmp"
    die "upgrade: could not copy the installer before replacing $ROOT"
  }
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'rm -f -- "$tmp"' EXIT
  GANGLINE_UPGRADE=1 GANGLINE_HOME="$ROOT" GANGLINE_BIN="$invoked_bin_dir" \
    sh "$tmp" ${mode:+"$mode"} || rc=$?
  rm -f -- "$tmp"
  trap 'on_exit' EXIT
  trap - HUP INT TERM
  return "$rc"
}

cmd="${1:-}"
trap 'on_exit' EXIT
[ -n "${GANG_TICK_INTERNAL:-}" ] || tick_health_warn
[ "$cmd" = hook ] || dirty_execution_warn
# NO ARGUMENTS IS NOT A MISTAKE. An agent told to "run gang" is asking where it
# is, and answering with the inventory on stderr at exit 1 tells it that asking
# was an error. The inventory is still one command away, at gang help. The skew
# warning above is deliberately upstream of this: the first command an agent
# runs is where an executable diverging from HEAD is most worth hearing about.
[ -n "$cmd" ] || { cmd_help welcome; exit 0; }
shift || true
if [ "${1:-}" = --help ] && [ $# -eq 1 ]; then
  cmd_help "$cmd"
  exit 0
fi
# A bare call to a command that names one agent is answered by the command
# itself, which falls back to the calling window. These are the ones with no
# such fallback by decision: an implicit self target on drop or down is a
# footgun, a message needs a stated recipient whether it leaves now or when the
# clock passes, and hitch, adopt and rename name a window that is not this one.
if [ $# -eq 0 ]; then
  case "$cmd" in
    hitch|adopt|rename|send|at|wait|explain|drop|down)
      cmd_help "$cmd"
      exit 1
      ;;
  esac
fi
case "$cmd" in
  up)       cmd_up "$@" ;;
  hitch)    cmd_hitch "$@" ;;
  adopt)    cmd_adopt "$@" ;;
  rename)   cmd_rename "$@" ;;
  send)     cmd_send "$@" ;;
  at)       cmd_at "$@" ;;
  flush)    cmd_flush "$@" ;;
  mail)     cmd_mail "$@" ;;
  interrupt) cmd_interrupt "$@" ;;
  compact)  cmd_compact "$@" ;;
  context)  cmd_context "$@" ;;
  usage)    die "usage was retired in 2.0: it drove the harness's own usage page through the composer. 'gang limits' reads the same quota from the collar's non-interactive source." ;;
  limits)   cmd_limits "$@" ;;
  wait-limit) cmd_wait_limit "$@" ;;
  wait)     cmd_wait "$@" ;;
  notify)   cmd_notify "$@" ;;
  curfew)   cmd_curfew "$@" ;;
  status)   cmd_status "$@" ;;
  explain)  cmd_explain "$@" ;;
  hook)     cmd_hook "$@" ;;
  capture)  cmd_capture "$@" ;;
  composer) cmd_composer "$@" ;;
  whoami)   cmd_whoami "$@" ;;
  roster)   cmd_roster "$@" ;;
  attach)   cmd_attach "$@" ;;
  teams)    cmd_teams "$@" ;;
  tick)     cmd_tick "$@" ;;
  __tick-worker)
            [ "${GANG_TICK_INTERNAL:-}" = 1 ] \
              || die "__tick-worker is internal; run gang tick"
            cmd_tick_worker "$@" ;;
  drop)     cmd_drop "$@" ;;
  down)     cmd_down "$@" ;;
  collars)  cmd_collars "$@" ;;
  models)   cmd_models "$@" ;;
  roles)    cmd_roles "$@" ;;
  config)   cmd_config "$@" ;;
  upgrade)  cmd_upgrade "$@" ;;
  -h|--help|help)
            [ $# -le 1 ] || die "help: unexpected argument '$2'"
            cmd_help "${1:-}" ;;
  *) die "unknown command '$cmd' (gang --help for usage)" ;;
esac
