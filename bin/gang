#!/usr/bin/env bash
# gang — gangline: drive a team of CLI agents as tmux windows.
# Laws: CONSTITUTION.md. Transport decision: docs/adr/0001-tmux-is-the-substrate.md
set -euo pipefail

SESSION="${GANG_SESSION:-gangline}"
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

die() { echo "gang: $*" >&2; exit 1; }

usage() {
  cat <<'EOF'
gang — drive a team of CLI agents as tmux windows

  gang up [name] -p <profile> [-d <dir>]      fresh start: spawn (name: manager) + attach
  gang spawn <name> -p <profile> [-d <dir>]   start an agent (window name = identity)
  gang adopt <name> -p <profile>              register an existing window as an agent
  gang send  <name> --from <sender> <msg...>  verified send; refuses if busy (--wait to block)
  gang compact <name>                         trigger the harness's own context compaction
  gang status <name>                          busy | idle
  gang context <name>                         context-window usage (profile-declared readout)
  gang wait  <name> [timeout_s]               block until idle (default 300)
  gang capture <name> [lines]                 tail of the agent's pane (default 40)
  gang roster                                 all agents with profile, state, context
  gang attach                                 attach to the team session
  gang kill  <name>                           kill the agent's window
  gang profiles                               list available profiles
  gang context-hook                           Claude Code hook mode: stdin payload ->
                                              band-crossing note (see README)

Env: GANG_FROM (sender identity for send), GANG_SESSION (default: gangline),
     GANG_CONTEXT_BANDS (warning ladder for context-hook; tokens or %, default
     120000,180000,250000,90%), GANG_CONTEXT_WINDOW (window-size override)
EOF
  exit 1
}

# --- profiles ---------------------------------------------------------------

list_profiles() { local p; for p in "$ROOT"/profiles/*.sh; do basename "$p" .sh; done; }

load_profile() { # $1 = profile name; sets GANG_LAUNCH, GANG_BUSY_REGEX, GANG_COMPACT_CMD
  local f="$ROOT/profiles/$1.sh"
  [ -f "$f" ] || die "unknown profile '$1' (have: $(list_profiles | tr '\n' ' '))"
  GANG_LAUNCH="" GANG_BUSY_REGEX="" GANG_COMPACT_CMD=""
  unset -f profile_context 2>/dev/null || true  # no stale functions across profiles
  # shellcheck source=/dev/null
  . "$f"
  [ -n "$GANG_LAUNCH" ] || die "profile '$1' sets no GANG_LAUNCH"
}

# --- window plumbing --------------------------------------------------------

target() { printf '%s:%s' "$SESSION" "$1"; }

exists() { tmux list-windows -t "$SESSION" -F '#W' 2>/dev/null | grep -qxF "$1"; }

win_profile() { # $1 = name; fails loud on unadopted windows
  exists "$1" || die "no agent '$1' (see: gang roster)"
  local p; p="$(tmux show-options -wqv -t "$(target "$1")" @gl_profile)"
  [ -n "$p" ] || die "window '$1' exists but is not a gang agent (gang adopt $1 -p <profile>)"
  printf '%s' "$p"
}

capture() { tmux capture-pane -p -t "$(target "$1")"; }

# -J joins pane-width-wrapped lines so matching never breaks on a wrap boundary.
capture_joined() { tmux capture-pane -pJ -t "$(target "$1")"; }

busy() { # $1 = name; exit 0 if busy
  local prof
  prof="$(win_profile "$1")"
  load_profile "$prof"
  [ -n "$GANG_BUSY_REGEX" ] && capture_joined "$1" | grep -qE -- "$GANG_BUSY_REGEX"
}

wait_idle() { # $1 = name, $2 = timeout seconds
  # Idle must hold for two consecutive polls: a just-submitted turn shows no
  # busy marker for a beat, and a single-shot check falls through that gap
  # (observed live — a send landed mid-turn and got queued).
  local t=0 timeout="${2:-300}" streak=0
  while :; do
    if busy "$1"; then streak=0; else
      streak=$((streak + 1)); [ "$streak" -ge 2 ] && return 0
    fi
    [ "$t" -ge "$timeout" ] && die "'$1' still busy after ${timeout}s"
    sleep 2; t=$((t + 2))
  done
}

# --- commands ---------------------------------------------------------------

cmd_spawn() {
  local name="" prof="" dir="$PWD"
  name="${1:-}"; [ -n "$name" ] || usage; shift
  while [ $# -gt 0 ]; do case "$1" in
    -p|--profile) prof="$2"; shift 2 ;;
    -d|--dir)     dir="$2";  shift 2 ;;
    *) die "spawn: unknown argument '$1'" ;;
  esac; done
  [ -n "$prof" ] || die "spawn: -p <profile> is required"
  [ -d "$dir" ] || die "spawn: no such directory '$dir'"
  load_profile "$prof"

  if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    tmux new-session -d -s "$SESSION" -n "$name" -c "$dir" "$GANG_LAUNCH"
  else
    exists "$name" && die "agent '$name' already exists"
    tmux new-window -d -t "$SESSION" -n "$name" -c "$dir" "$GANG_LAUNCH"
  fi
  # Window name IS the identity — the app must not rename it out from under us.
  tmux set-option -w -t "$(target "$name")" automatic-rename off
  tmux set-option -w -t "$(target "$name")" allow-rename off
  tmux set-option -w -t "$(target "$name")" @gl_profile "$prof"
  sleep 0.5
  exists "$name" || die "'$name' died at launch (cmd: $GANG_LAUNCH)"
  echo "spawned $name ($prof) in $dir — watch: gang attach"
}

cmd_up() { # fresh-session bootstrap: spawn (creates the session) then attach
  [ -z "${TMUX:-}" ] || die "up: already inside tmux — use gang spawn / gang adopt"
  local name="manager"
  case "${1:-}" in ''|-*) ;; *) name="$1"; shift ;; esac
  cmd_spawn "$name" "$@"
  exec tmux attach -t "$SESSION" \; select-window -t "$(target "$name")"
}

inject() { # $1 = name, $2 = text; bracketed-paste, verify in pane, submit. Law 3.
  printf '%s' "$2" | tmux load-buffer -b gangsend -
  tmux paste-buffer -p -d -b gangsend -t "$(target "$1")"
  sleep 0.4
  # Verified = the literal text is visible, OR the TUI collapsed the paste into a
  # placeholder whose count matches what we sent — Pi renders single-line pastes
  # as "[paste #N 1081 chars]" and multi-line pastes as "[paste #N +13 lines]"
  # (count = total lines in the paste). An exact count match is delivery
  # evidence; a mismatched count is not.
  local frag len nl; frag="$(printf '%s' "$2" | head -1 | cut -c1-40)"; len=${#2}
  nl="$(printf '%s\n' "$2" | wc -l)"
  capture_joined "$1" | grep -qF -- "$frag" \
    || capture_joined "$1" | grep -qE "\[paste #[0-9]+ (${len} chars|\+${nl} lines)\]" \
    || die "delivery NOT verified: neither '$frag' nor a matching paste placeholder (${len} chars / +${nl} lines) appeared in $1's pane — nothing was submitted"
  tmux send-keys -t "$(target "$1")" Enter
}

cmd_send() {
  local name="" from="${GANG_FROM:-}" wait=0 timeout=300
  name="${1:-}"; [ -n "$name" ] || usage; shift
  while [ $# -gt 0 ]; do case "$1" in
    --from) from="$2"; shift 2 ;;
    -w|--wait) wait=1; shift ;;
    --timeout) timeout="$2"; shift 2 ;;
    *) break ;;
  esac; done
  [ $# -gt 0 ] || die "send: empty message"
  [ -n "$from" ] || die "send: identity required (--from <sender> or GANG_FROM) — unattributed injection is how the last harness died"
  exists "$name" || die "no agent '$name' (see: gang roster)"

  if busy "$name"; then
    [ "$wait" -eq 1 ] || die "'$name' is mid-turn; refusing to inject (gang send $name --wait ... to block until idle)"
    wait_idle "$name" "$timeout"
  fi
  inject "$name" "[gang:$from] $*"
  echo "delivered to $name as [gang:$from] (verified in pane, submitted)"
}

cmd_compact() { # trigger the harness's own compaction, via its own command
  local name="${1:-}"; [ -n "$name" ] || usage
  local prof; prof="$(win_profile "$name")"
  load_profile "$prof"
  [ -n "${GANG_COMPACT_CMD:-}" ] || die "profile '$prof' declares no compact command"
  busy "$name" && die "'$name' is mid-turn; compacting now would cut a live turn (gang wait $name first)"
  inject "$name" "$GANG_COMPACT_CMD"
  echo "compaction triggered on $name ($GANG_COMPACT_CMD, verified, submitted)"
}

cmd_status() { if busy "$1"; then echo busy; else echo idle; fi; }

cmd_context() { # context-window usage via the profile's own introspection
  local name="${1:-}"; [ -n "$name" ] || usage
  local prof; prof="$(win_profile "$name")"
  load_profile "$prof"
  declare -F profile_context >/dev/null \
    || die "profile '$prof' declares no context introspection"
  profile_context "$(target "$name")"
}

cmd_roster() {
  tmux has-session -t "$SESSION" 2>/dev/null || { echo "no team (session '$SESSION' not running)"; return; }
  local w prof state ctx
  while read -r w; do
    prof="$(tmux show-options -wqv -t "$(target "$w")" @gl_profile)"
    if [ -z "$prof" ]; then
      printf '%-16s %-12s %-6s %s\n' "$w" "-" "-" "unadopted"
      continue
    fi
    if busy "$w" 2>/dev/null; then state=busy; else state=idle; fi
    # context column is best-effort observation; the dedicated command dies loud
    ctx="$(cmd_context "$w" 2>/dev/null | head -1)" || true
    printf '%-16s %-12s %-6s %s\n' "$w" "$prof" "$state" "${ctx:--}"
  done < <(tmux list-windows -t "$SESSION" -F '#W')
}

cmd_context_hook() { # Claude Code hook mode: stdin payload -> band-crossing note
  # Wire in hooks config as: {"type": "command", "command": "gang context-hook"}
  # on UserPromptSubmit and PostToolUse. Reads the session transcript's own
  # usage records (prompt-side tokens at the last call = current window) and
  # emits one additionalContext note per crossed GANG_CONTEXT_BANDS threshold;
  # a usage drop (compaction) re-arms the ladder. Never blocks a turn.
  HOOK_PAYLOAD="$(cat)" python3 - <<'PYEOF'
import json
import os
import re
import sys
from pathlib import Path

try:
    payload = json.loads(os.environ.get("HOOK_PAYLOAD", ""))
except json.JSONDecodeError:
    sys.exit(0)
transcript = payload.get("transcript_path")
session_id = payload.get("session_id")
if not transcript or not session_id or not Path(transcript).is_file():
    sys.exit(0)

with open(transcript, "rb") as f:
    f.seek(0, os.SEEK_END)
    f.seek(max(0, f.tell() - 262144))
    tail = f.read().decode("utf-8", errors="replace")

usage, model = None, ""
for line in tail.splitlines():
    try:
        rec = json.loads(line)
    except json.JSONDecodeError:
        continue
    msg = rec.get("message") or {}
    u = msg.get("usage")
    if u and "input_tokens" in u:
        usage, model = u, msg.get("model", model)
if usage is None:
    sys.exit(0)

tokens = (
    usage.get("input_tokens", 0)
    + usage.get("cache_creation_input_tokens", 0)
    + usage.get("cache_read_input_tokens", 0)
)
if os.environ.get("GANG_CONTEXT_WINDOW"):
    window = int(os.environ["GANG_CONTEXT_WINDOW"])
elif re.match(r"claude-(fable|opus|sonnet)-5", model):
    window = 1_000_000
else:
    window = 200_000
pct = 100 * tokens // window


def emit(note: str) -> None:
    print(
        json.dumps(
            {
                "hookSpecificOutput": {
                    "hookEventName": payload.get("hook_event_name", "PostToolUse"),
                    "additionalContext": note,
                }
            }
        )
    )


raw_bands = os.environ.get("GANG_CONTEXT_BANDS", "120000,180000,250000,90%")
try:
    thresholds = sorted(
        int(part[:-1].strip()) * window // 100 if part.strip().endswith("%") else int(part)
        for part in raw_bands.split(",")
        if part.strip()
    )
    if not thresholds or any(t <= 0 for t in thresholds):
        raise ValueError(raw_bands)
except ValueError:
    emit(f"[context-usage] invalid GANG_CONTEXT_BANDS {raw_bands!r} — fix the ladder")
    sys.exit(0)

band = sum(1 for t in thresholds if tokens >= t)

state = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / f"gang-context-band-{session_id}"
try:
    prev = int(state.read_text())
except (FileNotFoundError, ValueError):
    prev = 0

if band != prev:
    state.write_text(str(band))
if band > prev:
    emit(
        f"[context-usage] {tokens:,} tokens in context (~{pct}% of ~{window:,}) — "
        f"crossed the {thresholds[band - 1]:,}-token band. Plan /compact at the "
        f"next natural seam (arc boundary), before auto-compact picks the seam "
        f"for you."
    )
PYEOF
  exit 0
}

cmd_capture() { # trailing blank pane rows are dead space, not content
  capture "$1" | awk 'NF{last=NR} {line[NR]=$0} END{for(i=1;i<=last;i++) print line[i]}' | tail -n "${2:-40}"
}

cmd_adopt() { # register an EXISTING tmux window as a gang agent
  local name="" prof=""
  name="${1:-}"; [ -n "$name" ] || usage; shift
  while [ $# -gt 0 ]; do case "$1" in
    -p|--profile) prof="$2"; shift 2 ;;
    *) die "adopt: unknown argument '$1'" ;;
  esac; done
  [ -n "$prof" ] || die "adopt: -p <profile> is required"
  load_profile "$prof"
  exists "$name" || die "no window '$name' in session '$SESSION' to adopt"
  tmux set-option -w -t "$(target "$name")" automatic-rename off
  tmux set-option -w -t "$(target "$name")" allow-rename off
  tmux set-option -w -t "$(target "$name")" @gl_profile "$prof"
  echo "adopted $name as a $prof agent"
}

cmd_kill() {
  exists "$1" || die "no agent '$1'"
  tmux kill-window -t "$(target "$1")"
  echo "killed $1"
}

cmd_attach() { exec tmux attach -t "$SESSION"; }

cmd_profiles() { list_profiles; }

# --- dispatch ---------------------------------------------------------------

cmd="${1:-}"; [ -n "$cmd" ] || usage; shift || true
case "$cmd" in
  up)       cmd_up "$@" ;;
  spawn)    cmd_spawn "$@" ;;
  adopt)    cmd_adopt "$@" ;;
  send)     cmd_send "$@" ;;
  compact)  cmd_compact "$@" ;;
  status)   [ $# -ge 1 ] || usage; cmd_status "$1" ;;
  context)  cmd_context "$@" ;;
  context-hook) cmd_context_hook ;;
  wait)     [ $# -ge 1 ] || usage; wait_idle "$1" "${2:-300}"; echo idle ;;
  capture)  [ $# -ge 1 ] || usage; cmd_capture "$@" ;;
  roster)   cmd_roster ;;
  attach)   cmd_attach ;;
  kill)     [ $# -ge 1 ] || usage; cmd_kill "$1" ;;
  profiles) cmd_profiles ;;
  *) die "unknown command '$cmd' (gang with no args for usage)" ;;
esac
